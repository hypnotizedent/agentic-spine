#!/usr/bin/env bash
# Main dispatcher for ops governance helpers
set -eo pipefail

# Resolve symlinks to get actual script directory
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

COMMAND="${1:-help}"
shift || true

trap 'echo "ops: command \"$COMMAND\" failed (exit $?)" >&2' ERR

case "$COMMAND" in
  verify)
    source "$SCRIPT_DIR/../ops/commands/verify.sh" "$@"
    ;;
  pr)
    source "$SCRIPT_DIR/../ops/commands/pr.sh" "$@"
    ;;
  cap)
    source "$SCRIPT_DIR/../ops/commands/cap.sh" "$@"
    ;;
  mcp)
    subcommand="${1:-help}"
    shift || true
    case "$subcommand" in
      serve)
        exec "$SCRIPT_DIR/../ops/plugins/infra/mcp-gateway/bin/spine-mcp-serve" "$@"
        ;;
      help|-h|--help|"")
        cat <<'EOF'
ops mcp <subcommand>

Subcommands:
  serve    Start unified spine MCP gateway (stdio transport)
EOF
        ;;
      *)
        echo "Unknown mcp subcommand: $subcommand" >&2
        exit 1
        ;;
    esac
    ;;
  hooks)
    source "$SCRIPT_DIR/../ops/commands/hooks.sh" "$@"
    ;;
  status)
    source "$SCRIPT_DIR/../ops/commands/status.sh" "$@"
    ;;
  terminal)
    source "$SCRIPT_DIR/../ops/commands/terminal.sh" "$@"
    ;;
  wave)
    source "$SCRIPT_DIR/../ops/commands/wave.sh" "$@"
    ;;
  loops)
    source "$SCRIPT_DIR/../ops/commands/loops.sh" "$@"
    ;;
  *)
    if [[ "$COMMAND" != "help" && "$COMMAND" != "-h" && "$COMMAND" != "--help" ]]; then
      echo "Unknown command: $COMMAND" >&2
      echo
    fi

    echo "ops - governance-aware operations helper"
    echo
    echo "Operator front door:"
    echo "  ops terminal launch              Entry — governed terminal birth (admission + identity)"
    echo "  ops status                       State — public work, risk, automation, health, attention"
    echo "  ops cap run verify.engine.run    Foundational engine proof"
    echo "  ops cap run spine.verify         Foundational spine truth"
    echo "  ops cap run <capability>         Execute governed capability from the current surface"
    echo
    echo "Drilldown / expert:"
    echo "  ops status --expert            Raw workflow and telemetry detail"
    echo "  ops verify                     Compatibility health wrapper"
    echo "  ops cap <cmd>                  Capability registry helper"
    echo "  ops mcp serve                  Start unified spine MCP gateway (stdio)"
    echo
    echo "Advanced (use <command> --help for details):"
    echo "  expert: ops wave, ops loops, ops hooks, ops pr"
    if [[ "$COMMAND" == "help" || "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
      exit 0
    fi
    exit 1
    ;;
esac
