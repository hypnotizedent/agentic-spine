#!/usr/bin/env bash
# Main dispatcher for ops governance helpers
set -eo pipefail

# Resolve symlinks to get actual script directory
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

COMMAND="${1:-help}"
shift || true

trap 'echo "ops: command \"$COMMAND\" failed (exit $?)" >&2' ERR

case "$COMMAND" in
  verify)
    source "$SCRIPT_DIR/../ops/commands/verify.sh" "$@"
    ;;
  pr)
    source "$SCRIPT_DIR/../ops/commands/pr.sh" "$@"
    ;;
  run)
    source "$SCRIPT_DIR/../ops/commands/run.sh" "$@"
    ;;
  cap)
    source "$SCRIPT_DIR/../ops/commands/cap.sh" "$@"
    ;;
  hooks)
    source "$SCRIPT_DIR/../ops/commands/hooks.sh" "$@"
    ;;
  status)
    source "$SCRIPT_DIR/../ops/commands/status.sh" "$@"
    ;;
  ready)
    source "$SCRIPT_DIR/../ops/commands/ready.sh" "$@"
    ;;
  terminal)
    source "$SCRIPT_DIR/../ops/commands/terminal.sh" "$@"
    ;;
  context)
    source "$SCRIPT_DIR/../ops/commands/context.sh" "$@"
    ;;
  *)
    if [[ "$COMMAND" != "help" && "$COMMAND" != "-h" && "$COMMAND" != "--help" ]]; then
      echo "Unknown command: $COMMAND" >&2
      echo
    fi

    echo "ops - governance-aware operations helper"
    echo
    echo "Usage:"
    echo "  ops run [opts]       Enqueue work into mailroom (--file, --fixture, --inline)"
    echo "  ops cap <cmd>        Execute governed capabilities (list, run, show)"
    echo "  ops hooks <cmd>      Git hooks helper (status, install)"
    echo "  ops status           Unified work status (loops + gaps + inbox + anomalies)"
    echo "  ops verify           Health-check services declared in SERVICE_REGISTRY.yaml"
    echo "  ops ready            Run spine gates + secrets checks (API work preflight)"
    echo "  ops context          Show L1 runtime context (read-only, from joined-state)"
    echo "  ops terminal launch  Open governed terminal window (Hammerspoon picker target)"
    echo "  ops pr [...args]     Stage/commit/push changes and open a PR for issue"
    echo
    echo "Current directory resolved to: $SCRIPT_DIR"
    if [[ "$COMMAND" == "help" || "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
      exit 0
    fi
    exit 1
    ;;
esac
