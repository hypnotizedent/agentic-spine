#!/usr/bin/env bash
set -euo pipefail

# Spine pre-push hook (versioned)
#
# Lightweight guard: origin/main remains the governed operational push path.
# GitHub is publication-only and is blocked by default unless an explicit
# publication override is supplied.
#
# Multi-agent coordinator metadata (7 env vars) removed — governance ceremony
# overhead reduction. See: LOOP-session-git-workflow-simplification

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${ROOT:-}" ]] || exit 0
cd "$ROOT"

REMOTE_NAME="${1:-unknown-remote}"
REMOTE_URL="${2:-unknown-url}"

bool_true() {
  local raw="${1:-}"
  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  [[ "$raw" == "1" || "$raw" == "true" || "$raw" == "yes" ]]
}

targets_main=0
while IFS=' ' read -r _local_ref _local_sha remote_ref _remote_sha; do
  [[ -n "${remote_ref:-}" ]] || continue
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    targets_main=1
    break
  fi
done

if [[ "$REMOTE_NAME" == "github" ]]; then
  if bool_true "${OPS_GITHUB_PUBLICATION_OVERRIDE:-}"; then
    echo "NOTICE: GitHub publication push allowed (remote=$REMOTE_NAME)." >&2
    echo "NOTICE: GitHub is publication-only; origin remains canonical operational truth." >&2
    exit 0
  fi

  echo "BLOCKED: pushes to GitHub require explicit publication override." >&2
  echo "remote: $REMOTE_NAME ($REMOTE_URL)" >&2
  echo "" >&2
  echo "GitHub is publication-only. It is not canonical operational truth." >&2
  echo "Operational pushes belong on origin (Gitea)." >&2
  echo "Drift between origin and github is acceptable outside explicit publication." >&2
  echo "" >&2
  echo "Remediation:" >&2
  echo "  OPS_GITHUB_PUBLICATION_OVERRIDE=1 git push $REMOTE_NAME <ref>" >&2
  echo "  git push origin <ref>    # normal operational flow" >&2
  exit 1
fi

[[ "$targets_main" -eq 1 ]] || exit 0

if [[ "$REMOTE_NAME" == "origin" ]] && bool_true "${OPS_GOVERNED_MAIN_OVERRIDE:-}"; then
  echo "NOTICE: governed push to main allowed (remote=$REMOTE_NAME)." >&2
  exit 0
fi

echo "BLOCKED: operational pushes to main must target origin with governed override." >&2
echo "remote: $REMOTE_NAME ($REMOTE_URL)" >&2
echo "" >&2
echo "origin (Gitea) is canonical operational truth." >&2
echo "GitHub is publication-only and is not part of normal spine operational flow." >&2
echo "" >&2
echo "Remediation:" >&2
echo "  OPS_GOVERNED_MAIN_OVERRIDE=1 git push origin main" >&2
exit 1
