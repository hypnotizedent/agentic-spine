#!/usr/bin/env bash
set -euo pipefail

# Spine pre-commit hook (versioned)
#
# Guards:
# 0. Main branch protection (OPS_GOVERNED_MAIN_OVERRIDE=1 to commit on main)
# 5. Hook-fast AOF hygiene checks (staged only)
# 6. Gate registry projection advisory (gate.registry.yaml staged)
#
# Guards 1-4,7-8 removed — governance ceremony overhead reduction.
# Guard 0 simplified to single-var override (matching pre-push).
# See: LOOP-session-git-workflow-simplification

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${ROOT:-}" ]]; then
  exit 0
fi

cd "$ROOT"

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

current_branch="$(git branch --show-current 2>/dev/null || echo detached)"

staged="$(git diff --cached --name-only --diff-filter=ACMRT 2>/dev/null || true)"

# ─── Guard 0: Main branch protection ──────────────────────
# Single-var governed override — prevents accidental main commits from agents.
# Same pattern as pre-push hook: OPS_GOVERNED_MAIN_OVERRIDE=1 to proceed.
if [[ -n "${staged:-}" && ("$current_branch" == "main" || "$current_branch" == "master") ]]; then
  OVERRIDE="${OPS_GOVERNED_MAIN_OVERRIDE:-}"
  OVERRIDE_LC="$(printf '%s' "$OVERRIDE" | tr '[:upper:]' '[:lower:]')"

  if [[ "$OVERRIDE_LC" == "1" || "$OVERRIDE_LC" == "true" || "$OVERRIDE_LC" == "yes" ]]; then
    echo "NOTICE: main commit override accepted." >&2
  else
    echo "BLOCKED: direct commits on '$current_branch' are fail-closed by default." >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  OPS_GOVERNED_MAIN_OVERRIDE=1 git commit ..." >&2
    exit 1
  fi
fi

# ─── Guard 5: Hook-fast AOF hygiene checks (staged only) ───
# Keep pre-commit lightweight while catching common AOF drift early.

if echo "$staged" | rg -q '^ops/bindings/.*\.ya?ml$'; then
  schema_audit="ops/plugins/core/verify/bin/schema-conventions-audit"
  if [[ ! -x "$schema_audit" ]]; then
    echo "STOP: missing schema audit runner: $schema_audit" >&2
    exit 1
  fi
  "$schema_audit" --mode staged
fi

# ─── Guard 5a: Repo-local mailroom runtime drift ──────────────────────────
# mailroom runtime is externalized under .runtime/spine. Keep only stub/doc surfaces in repo.
mailroom_drift="$(printf '%s\n' "$staged" | rg '^mailroom/' || true)"
if [[ -n "${mailroom_drift:-}" ]]; then
  disallowed_mailroom=()
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    case "$path" in
      mailroom/.keep|mailroom/README.md|mailroom/templates|mailroom/templates/*) ;;
      *) disallowed_mailroom+=("$path") ;;
    esac
  done <<<"$mailroom_drift"

  if (( ${#disallowed_mailroom[@]} > 0 )); then
    echo "BLOCKED: repo-local mailroom runtime artifacts are forbidden." >&2
    printf '  - %s\n' "${disallowed_mailroom[@]}" >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  move runtime mailroom content under ~/.runtime/spine/mailroom via the path resolver" >&2
    exit 1
  fi
fi

# ─── Guard 5b: New shell scripts must use canonical path resolver ───────
added_scripts="$(git diff --cached --name-only --diff-filter=A 2>/dev/null | rg '^(ops/plugins|ops/runtime)/.*\.sh$' || true)"
if [[ -n "${added_scripts:-}" ]]; then
  missing_paths=()
  while IFS= read -r script_path; do
    [[ -n "$script_path" ]] || continue
    staged_content="$(git show ":$script_path" 2>/dev/null || true)"
    if ! printf '%s\n' "$staged_content" | rg -q 'ops/lib/spine-paths\.sh'; then
      missing_paths+=("$script_path")
    fi
  done <<<"$added_scripts"

  if (( ${#missing_paths[@]} > 0 )); then
    echo "BLOCKED: new shell scripts must source ops/lib/spine-paths.sh" >&2
    printf '  - %s\n' "${missing_paths[@]}" >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  source \"\${SPINE_ROOT}/ops/lib/spine-paths.sh\"" >&2
    echo "  spine_paths_init" >&2
    exit 1
  fi
fi

# ─── Guard 6: Gate registry projection advisory (read-only) ──
# Do not mutate files or run policy-gated capabilities inside pre-commit.
# Projection/autofix runs are explicit commands outside hook execution.

if echo "$staged" | grep -qx 'ops/bindings/gate.registry.yaml'; then
  echo "NOTICE: gate.registry.yaml staged." >&2
  echo "NOTICE: projection sync is explicit (not run by pre-commit)." >&2
  echo "NOTICE: run './ops/plugins/core/docs/bin/docs-projection-sync' and stage projection files before push." >&2
fi

# ─── Guard 7: D411 terminal-worker projection convergence ──
# Any staged D411 authority, wrapper, or generated projection surface must be
# checked in the same commit. This blocks silent landing of stale projections.
D411_SURFACES="ops/capabilities.yaml
ops/bindings/capability_map.yaml
ops/bindings/agents.registry.yaml
ops/bindings/terminal.role.contract.yaml
ops/bindings/gate.domain.profiles.yaml
ops/bindings/gate.agent.profiles.yaml
ops/bindings/service.endpoint.catalog.yaml
ops/bindings/terminal.worker.projection.contract.yaml
ops/bindings/terminal.worker.catalog.yaml
ops/bindings/routing.dispatch.yaml
ops/bindings/terminal.launcher.view.yaml
ops/plugins/core/ops/bin/gen-terminal-worker-runtime-v2.py
ops/plugins/core/ops/bin/gen-worker-catalog.sh
ops/plugins/core/ops/bin/gen-routing-dispatch.sh
ops/plugins/core/ops/bin/gen-launcher-view.sh
ops/plugins/core/ops/bin/gen-worker-usage-docs.sh"

d411_surface_staged=0
while IFS= read -r d411_surface; do
  [[ -n "$d411_surface" ]] || continue
  if printf '%s\n' "$staged" | grep -Fxq "$d411_surface"; then
    d411_surface_staged=1
    break
  fi
done <<< "$D411_SURFACES"

if [[ "$d411_surface_staged" -eq 1 ]] || printf '%s\n' "$staged" | rg -q '^docs/reference/generated/worker-usage/'; then
  d411_gate="$ROOT/surfaces/verify/d411-terminal-worker-projection-lock.sh"
  if [[ -x "$d411_gate" ]] && ! bash "$d411_gate" > /dev/null 2>&1; then
    echo "BLOCKED: D411 projection surface staged but governed projections are stale." >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  bash ops/plugins/core/ops/bin/gen-worker-catalog.sh --apply" >&2
    echo "  bash ops/plugins/core/ops/bin/gen-routing-dispatch.sh --apply" >&2
    echo "  bash ops/plugins/core/ops/bin/gen-launcher-view.sh --apply" >&2
    echo "  bash ops/plugins/core/ops/bin/gen-worker-usage-docs.sh --apply" >&2
    echo "  git add ops/bindings/terminal.worker.projection.contract.yaml ops/bindings/terminal.worker.catalog.yaml ops/bindings/routing.dispatch.yaml ops/bindings/terminal.launcher.view.yaml docs/reference/generated/worker-usage/" >&2
    exit 1
  fi
fi
