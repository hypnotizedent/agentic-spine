#!/usr/bin/env bash
set -euo pipefail

# Canonical versioned pre-commit hook.
#
# Behavioral authority mirrors the currently enforced live gate set:
# D30, D31, D42, D44, D46, D47, D48 (--lane), D58, D84, D85, D150,
# D411 staged-projection enforcement, and the mirror-sanitization canary.
# The only added governance guard here is truthful intentional-main override
# handling: OPS_GOVERNED_MAIN_OVERRIDE=1 authorizes a controller landing on
# root main, but it does not bypass D48, D150, or any other gate.

# When git invokes hooks from a worktree, inherited git env vars can cause
# cross-worktree checks to resolve the wrong repository. Clear them so each
# gate resolves paths through its own git -C / repo-root logic.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE 2>/dev/null || true

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${ROOT:-}" ]]; then
  ROOT="${SPINE_ROOT:-$HOME/code/agentic-spine}"
fi
if [[ ! -d "${ROOT:-}" ]]; then
  exit 0
fi

cd "$ROOT"

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

current_branch="$(git branch --show-current 2>/dev/null || echo detached)"
STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

if [[ -n "${STAGED_FILES:-}" && ("$current_branch" == "main" || "$current_branch" == "master") ]]; then
  override="${OPS_GOVERNED_MAIN_OVERRIDE:-}"
  override_lc="$(printf '%s' "$override" | tr '[:upper:]' '[:lower:]')"

  if [[ "$override_lc" == "1" || "$override_lc" == "true" || "$override_lc" == "yes" ]]; then
    echo "NOTICE: main commit override accepted. D48, D150, and the remaining hook gates still enforce." >&2
  else
    echo "BLOCKED: root '$current_branch' is integration-only." >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  move broad or concurrent mutation into a managed worktree" >&2
    echo "  use a bounded staged-only controller landing on root main only for one exact slice" >&2
    echo "  rerun with: OPS_GOVERNED_MAIN_OVERRIDE=1 git commit ..." >&2
    exit 1
  fi
fi

SP="$ROOT"
FAIL=0
CHECKED=0
FAILED_GATES=""

for gate in \
  "$SP/surfaces/verify/d30-active-config-lock.sh" \
  "$SP/surfaces/verify/d31-home-output-sink-lock.sh" \
  "$SP/surfaces/verify/d42-code-path-case-lock.sh" \
  "$SP/surfaces/verify/d44-cli-tools-discovery-lock.sh" \
  "$SP/surfaces/verify/d46-claude-instruction-source-lock.sh" \
  "$SP/surfaces/verify/d47-brain-surface-path-lock.sh" \
  "$SP/surfaces/verify/d48-codex-worktree-hygiene.sh" \
  "$SP/surfaces/verify/d58-ssot-freshness-lock.sh" \
  "$SP/surfaces/verify/d84-docs-index-registration-lock.sh" \
  "$SP/surfaces/verify/d85-gate-registry-parity-lock.sh" \
  "$SP/surfaces/verify/d150-code-root-hygiene-lock.sh"; do
  # NOTE: D62 removed from pre-commit (2026-03-23) because network git fetches
  # can hang indefinitely. D62 remains in verify.fast.
  if [[ -x "$gate" ]]; then
    CHECKED=$((CHECKED + 1))
    if [[ "$(basename "$gate")" == "d48-codex-worktree-hygiene.sh" ]]; then
      if ! bash "$gate" --lane; then
        FAIL=1
        FAILED_GATES="$FAILED_GATES $(basename "$gate")"
      fi
    elif ! bash "$gate" > /dev/null 2>&1; then
      FAIL=1
      FAILED_GATES="$FAILED_GATES $(basename "$gate")"
    fi
  fi
done

if [[ "$FAIL" -eq 1 ]]; then
  echo "pre-commit: $CHECKED gates checked, FAILED:$FAILED_GATES"
  echo "Fix the issue, then commit again."
  exit 1
fi

# D411 projection enforcement: if any D411 input is staged, require the
# governed projections to be regenerated in the same commit.
D411_INPUTS=(
  "ops/capabilities.yaml"
  "ops/bindings/capability_map.yaml"
  "ops/bindings/agents.registry.yaml"
  "ops/bindings/terminal.role.contract.yaml"
  "ops/bindings/gate.domain.profiles.yaml"
  "ops/bindings/gate.agent.profiles.yaml"
  "ops/bindings/service.endpoint.catalog.yaml"
  "ops/plugins/core/ops/bin/gen-terminal-worker-runtime-v2.py"
)

D411_INPUT_STAGED=0
for input_file in "${D411_INPUTS[@]}"; do
  if printf '%s\n' "$STAGED_FILES" | grep -Fxq "$input_file"; then
    D411_INPUT_STAGED=1
    break
  fi
done

if [[ "$D411_INPUT_STAGED" -eq 1 ]]; then
  CHECKED=$((CHECKED + 1))
  if ! bash "$SP/surfaces/verify/d411-terminal-worker-projection-lock.sh" > /dev/null 2>&1; then
    echo "pre-commit: D411 input file staged but governed projections are stale."
    echo "  Run these to regenerate, then stage the output files:"
    echo "    bash ops/plugins/core/ops/bin/gen-worker-catalog.sh --apply"
    echo "    bash ops/plugins/core/ops/bin/gen-routing-dispatch.sh --apply"
    echo "    bash ops/plugins/core/ops/bin/gen-launcher-view.sh --apply"
    echo "    bash ops/plugins/core/ops/bin/gen-worker-usage-docs.sh --apply"
    echo "  Then: git add ops/bindings/terminal.worker.catalog.yaml ops/bindings/routing.dispatch.yaml ops/bindings/terminal.launcher.view.yaml docs/reference/generated/worker-usage/"
    exit 1
  fi
fi

# Mirror-sanitization canary: reject redaction placeholders from the mirror
# pipeline. They belong only in the ephemeral mirror payload.
CANARY_PATTERN='<INFISICAL_WORKSPACE_ID_REDACTED>'
CANARY_DIRS="ops/bindings/ ops/plugins/providers/ docs/core/ docs/governance/"
CANARY_HITS=""
for cdir in $CANARY_DIRS; do
  while IFS= read -r cfile; do
    [[ -n "$cfile" ]] || continue
    if git show ":$cfile" 2>/dev/null | grep -qF "$CANARY_PATTERN"; then
      CANARY_HITS="$CANARY_HITS $cfile"
    fi
  done < <(printf '%s\n' "$STAGED_FILES" | grep "^${cdir}" || true)
done

if [[ -n "$CANARY_HITS" ]]; then
  echo "pre-commit: BLOCKED - mirror sanitization placeholder in staged files:"
  for chit in $CANARY_HITS; do
    echo "  $chit"
  done
  echo "  The string '$CANARY_PATTERN' must NEVER be committed to the canonical repo."
  echo "  This placeholder belongs only in the ephemeral mirror payload."
  echo "  Incident ref: b6d55b39 (2026-03-25 break-glass recovery)"
  exit 1
fi

echo "pre-commit: $CHECKED gates passed"
exit 0
