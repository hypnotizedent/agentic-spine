# Runtime mailroom — fully externalized (D396/D397 forbid repo-local mailroom/)
mailroom/

# Receipts: never commit sessions or audits (runtime evidence)
receipts/sessions/
receipts/audits/

# Logs / temp
*.log
*.tmp
.DS_Store
**/.DS_Store

# Audit artifacts: runtime analysis outputs (ephemeral, regenerable)
# Authoritative audit docs in docs/governance/_audits/*.md are tracked.
docs/governance/_audits/_artifacts/
docs/governance/_audits/AOF_ALIGNMENT_INBOX_*/

# Generated context (local only)
docs/brain/context.md

# Session logs (local only; non-canonical)
docs/sessions/
docs/planning/W67_GATE_BUDGET_REPORT.*

# Execution lane metadata (worktree-local only; see Phase 2)
.lane-*

# Secrets / env (actual secret files, not verification scripts)
.env
.env.*
!*.env.example
.contract_read_*
**/apikey*
**/token.*
**/*.secret
**/*.key
**/credentials*

# Caches
.cache/
tmp/
__pycache__/
ops/plugins/core/evidence/state/
ops/plugins/core/recovery/state/
fixtures/n8n/snapshots/
ops/plugins/core/verify/state/verify-failure-class-history.ndjson
ops/plugins/core/verify/state/gate-pass-streak.json

# Domain-specific runtime state (local only — NOT governance)
runtime/

# Codex worktrees (local only)
.worktrees/

# Legacy/archive (optional - remove if you want to keep)
.archive/
.spine/
_imports/
.archive/releases/

# Generated capability map (kept tracked for current gate contract; do not create extra local copies)
ops/bindings/capability_map.yaml
