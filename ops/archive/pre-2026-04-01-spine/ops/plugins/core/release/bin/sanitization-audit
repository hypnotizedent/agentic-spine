#!/usr/bin/env bash
set -euo pipefail

# sanitization-audit — Deterministic audit of sensitive data in the repo
#
# Usage: sanitization-audit [--json] [--output FILE]
#
# Scans the agentic-spine repo for hardcoded personal paths, internal domains,
# Tailscale IPs, leaked credentials, and infrastructure identifiers. Produces
# a deterministic manifest suitable for review before a sanitization wave.
#
# THIS SCRIPT DOES NOT MODIFY ANY FILES. It is read-only and safe to run
# at any time. The output is deterministic: same repo state → same output.
#
# Created: 2026-03-24
# Loop: LOOP-SPINE-PRODUCTIZATION-20260324
# Phase: 3 (sanitization audit — deterministic script for follow-up wave)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
JSON_OUTPUT=0
OUTPUT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --json)   JSON_OUTPUT=1; shift ;;
    --output) OUTPUT_FILE="${2:?--output requires a path}"; shift 2 ;;
    -h|--help)
      echo "Usage: sanitization-audit [--json] [--output FILE]"
      echo ""
      echo "Read-only audit of sensitive data in the repo."
      echo "Produces a manifest for review. Does NOT modify files."
      echo ""
      echo "Options:"
      echo "  --json           Machine-consumable NDJSON output"
      echo "  --output FILE    Write report to FILE instead of stdout"
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

# ── Scanning infrastructure ────────────────────────────────────────
# Uses git ls-files to ensure we only scan tracked files (deterministic).
# Excludes binary files and known large generated artifacts.

TRACKED_FILES="$(git -C "$ROOT" ls-files -- '*.yaml' '*.yml' '*.md' '*.sh' '*.json' '*.py' '*.txt' '*.toml' '*.cfg' '*.conf' '*.plist' | sort)"

# Counters
declare -A CATEGORY_COUNTS
TOTAL_FINDINGS=0

emit() {
  local category="$1" severity="$2" file="$3" line="$4" match="$5" description="$6"
  (( TOTAL_FINDINGS++ )) || true
  CATEGORY_COUNTS["$category"]=$(( ${CATEGORY_COUNTS["$category"]:-0} + 1 ))

  if [[ "$JSON_OUTPUT" -eq 1 ]]; then
    printf '{"category":"%s","severity":"%s","file":"%s","line":%s,"match":"%s","description":"%s"}\n' \
      "$category" "$severity" "$file" "$line" \
      "$(echo "$match" | sed 's/"/\\"/g' | head -c 200)" \
      "$(echo "$description" | sed 's/"/\\"/g')"
  else
    printf "  [%s] %s:%s — %s\n" "$severity" "$file" "$line" "$description"
  fi
}

# Redirect output if --output specified
if [[ -n "$OUTPUT_FILE" ]]; then
  exec > "$OUTPUT_FILE"
fi

if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo "═══════════════════════════════════════════════════════════"
  echo "  SANITIZATION AUDIT — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "  Repo: $ROOT"
  echo "  Mode: READ-ONLY (no modifications)"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
fi

# ── Category 1: Hardcoded personal paths ───────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo "── Category: HARDCODED_PATHS ──────────────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "HARDCODED_PATHS" "HIGH" "$file" "$line" "$match" \
    "Hardcoded /Users/ronnyworks path — replace with \$SPINE_ROOT or \$HOME"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -n '/Users/ronnyworks' "$ROOT/{}" 2>/dev/null | head -500 || true)

# ── Category 2: Internal domains ───────────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: INTERNAL_DOMAINS ─────────────────────────────"
fi

for domain_pattern in '\.ronny\.works' '\.mintprints\.co' 'git\.ronny\.works'; do
  while IFS=: read -r file line match; do
    [[ -n "$file" ]] || continue
    emit "INTERNAL_DOMAINS" "HIGH" "$file" "$line" "$match" \
      "Internal domain reference — replace with placeholder (e.g., example.com)"
  done < <(echo "$TRACKED_FILES" | xargs -I{} grep -n "$domain_pattern" "$ROOT/{}" 2>/dev/null | head -200 || true)
done

# ── Category 3: Tailscale IPs ──────────────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: TAILSCALE_IPS ────────────────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "TAILSCALE_IPS" "HIGH" "$file" "$line" "$match" \
    "Tailscale VPN IP — replace with placeholder (e.g., 100.x.x.x)"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -nE '100\.(6[4-9]|[7-9][0-9]|1[0-2][0-9])\.[0-9]+\.[0-9]+' "$ROOT/{}" 2>/dev/null | head -200 || true)

# ── Category 4: Private LAN IPs ───────────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: PRIVATE_LAN_IPS ──────────────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "PRIVATE_LAN_IPS" "MEDIUM" "$file" "$line" "$match" \
    "Private LAN IP — replace with placeholder (e.g., 192.168.x.x)"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -nE '192\.168\.[0-9]+\.[0-9]+' "$ROOT/{}" 2>/dev/null | head -200 || true)

# ── Category 5: Infisical workspace IDs ────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: INFISICAL_WORKSPACE_IDS ──────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "INFISICAL_WORKSPACE_IDS" "CRITICAL" "$file" "$line" "$match" \
    "Infisical workspace ID — MUST be redacted before public release"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -nE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' "$ROOT/{}" 2>/dev/null | head -100 || true)

# ── Category 6: Email addresses ────────────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: EMAIL_ADDRESSES ──────────────────────────────"
fi

for email_pattern in 'hypnotizedent@' 'ronny@'; do
  while IFS=: read -r file line match; do
    [[ -n "$file" ]] || continue
    emit "EMAIL_ADDRESSES" "MEDIUM" "$file" "$line" "$match" \
      "Personal email — replace with user@example.com"
  done < <(echo "$TRACKED_FILES" | xargs -I{} grep -n "$email_pattern" "$ROOT/{}" 2>/dev/null | head -100 || true)
done

# ── Category 7: Infrastructure identifiers ─────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: INFRASTRUCTURE_IDS ───────────────────────────"
fi

for infra_pattern in 'md1400' 'r730xd' 'PM8072' 'UDR[67]'; do
  while IFS=: read -r file line match; do
    [[ -n "$file" ]] || continue
    emit "INFRASTRUCTURE_IDS" "MEDIUM" "$file" "$line" "$match" \
      "Hardware/infrastructure identifier — consider redacting for public release"
  done < <(echo "$TRACKED_FILES" | xargs -I{} grep -nE "$infra_pattern" "$ROOT/{}" 2>/dev/null | head -50 || true)
done

# ── Category 8: GitHub container registry ──────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: CONTAINER_REGISTRY_REFS ──────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "CONTAINER_REGISTRY_REFS" "MEDIUM" "$file" "$line" "$match" \
    "GitHub container registry ref — replace org name for public release"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -n 'ghcr.io/hypnotizedent' "$ROOT/{}" 2>/dev/null | head -50 || true)

# ── Category 9: Infisical secret paths ─────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "── Category: SECRET_PATHS ─────────────────────────────────"
fi

while IFS=: read -r file line match; do
  [[ -n "$file" ]] || continue
  emit "SECRET_PATHS" "MEDIUM" "$file" "$line" "$match" \
    "Infisical secret path — consider redacting path structure"
done < <(echo "$TRACKED_FILES" | xargs -I{} grep -nE '/spine/(services|vm-infra|platform|communications)/' "$ROOT/{}" 2>/dev/null | head -100 || true)

# ── Summary ─────────────────────────────────────────────────────────
if [[ "$JSON_OUTPUT" -eq 0 ]]; then
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "  SUMMARY"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "  Total findings: $TOTAL_FINDINGS"
  echo ""
  for cat in "${!CATEGORY_COUNTS[@]}"; do
    printf "    %-30s %d\n" "$cat" "${CATEGORY_COUNTS[$cat]}"
  done | sort
  echo ""
  echo "  NOTE: This audit is capped at representative samples per"
  echo "  category (not exhaustive counts). Run with --json for full"
  echo "  machine-consumable output."
  echo ""
  echo "  NEXT STEP: Review this manifest, then execute the sanitization"
  echo "  wave in an isolated worktree. Do NOT apply fixes on main without"
  echo "  a governing loop and verification pass."
  echo ""
  echo "═══════════════════════════════════════════════════════════"
else
  printf '{"summary":{"total_findings":%d' "$TOTAL_FINDINGS"
  for cat in "${!CATEGORY_COUNTS[@]}"; do
    printf ',"%s":%d' "$cat" "${CATEGORY_COUNTS[$cat]}"
  done
  printf '}}\n'
fi
