#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parents[5]
FRICTION_INGEST = ROOT / "ops/plugins/core/lifecycle/bin/friction-ingest"
GATE_REGISTRY = ROOT / "ops/bindings/gate.registry.yaml"
DEFAULT_EVIDENCE_ROOT = ROOT.parent / ".evidence/spine/sessions"
DEFAULT_QUEUE = (ROOT.parent / ".runtime/spine/state/friction-queue.ndjson").resolve()
DEFAULT_LOCK = (ROOT.parent / ".runtime/spine/state/locks/friction-queue.lock").resolve()

MAILROOM_LOOP = "LOOP-MAILROOM-EXTERNALIZATION-CLOSEOUT-20260323"
UNFINISHED_LOOP = "LOOP-UNFINISHED-WORK-LIFECYCLE-CLOSEOUT-20260323"
CROSS_DOMAIN_LOOP = "LOOP-CROSS-DOMAIN-LIVE-ENFORCEMENT-SCOPING-20260323"

LOOP_BY_GATE = {
    "D377": MAILROOM_LOOP,
    "D396": MAILROOM_LOOP,
    "D397": MAILROOM_LOOP,
    "D83": UNFINISHED_LOOP,
    "D75": UNFINISHED_LOOP,
    "D67": UNFINISHED_LOOP,
    "D121": UNFINISHED_LOOP,
    "D126": UNFINISHED_LOOP,
    "D127": UNFINISHED_LOOP,
    "D331": UNFINISHED_LOOP,
    "D411": UNFINISHED_LOOP,
    "D150": UNFINISHED_LOOP,
    "D399": CROSS_DOMAIN_LOOP,
}

FAIL_LINE_RE = re.compile(r"\b(D\d{1,3})\b.*\bFAIL\b|\bFAIL\b.*\b(D\d{1,3})\b", re.IGNORECASE)
RCAP_DATE_RE = re.compile(r"^RCAP-(\d{8})-")


def fail(message: str, code: int = 1) -> None:
    print(f"gate.recurrence.convert FAIL: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_args() -> argparse.Namespace:
    ap = argparse.ArgumentParser(description="Convert recurring gate failures into governed friction items")
    ap.add_argument("--evidence-root", default=str(DEFAULT_EVIDENCE_ROOT))
    ap.add_argument("--queue", default=str(DEFAULT_QUEUE))
    ap.add_argument("--lock-file", default=str(DEFAULT_LOCK))
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--threshold", type=int, default=20)
    ap.add_argument("--friction-ingest-cmd", default=str(FRICTION_INGEST))
    ap.add_argument("--source", default="gate.recurrence")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    return ap.parse_args()


def load_gate_meta() -> dict[str, dict[str, Any]]:
    if not GATE_REGISTRY.exists():
        return {}
    data = yaml.safe_load(GATE_REGISTRY.read_text(encoding="utf-8")) or {}
    rows = data.get("gates") if isinstance(data, dict) else []
    if not isinstance(rows, list):
        return {}
    meta: dict[str, dict[str, Any]] = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        gate_id = str(row.get("id") or "").strip().upper()
        if gate_id:
            meta[gate_id] = row
    return meta


def collect_recent_failures(evidence_root: Path, days: int) -> tuple[Counter[str], dict[str, list[str]]]:
    cutoff = datetime.now(timezone.utc) - timedelta(days=max(days, 0))
    counts: Counter[str] = Counter()
    samples: dict[str, list[str]] = defaultdict(list)
    if not evidence_root.exists():
        return counts, samples

    for output_path in evidence_root.glob("RCAP-*/output.txt"):
        receipt_dir = output_path.parent
        receipt_name = receipt_dir.name
        receipt_date = None
        match = RCAP_DATE_RE.match(receipt_name)
        if match:
            try:
                receipt_date = datetime.strptime(match.group(1), "%Y%m%d").replace(tzinfo=timezone.utc)
            except ValueError:
                receipt_date = None
        if receipt_date is None:
            try:
                receipt_date = datetime.fromtimestamp(output_path.stat().st_mtime, tz=timezone.utc)
            except FileNotFoundError:
                continue
        if receipt_date < cutoff:
            continue
        try:
            text = output_path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        rel = str(output_path)
        for line in text.splitlines():
            match = FAIL_LINE_RE.search(line.strip())
            if not match:
                continue
            gate_id = (match.group(1) or match.group(2) or "").upper()
            counts[gate_id] += 1
            if len(samples[gate_id]) < 3 and rel not in samples[gate_id]:
                samples[gate_id].append(rel)
    return counts, samples


def build_items(
    counts: Counter[str],
    samples: dict[str, list[str]],
    days: int,
    threshold: int,
    gate_meta: dict[str, dict[str, Any]],
) -> dict[str, list[dict[str, Any]]]:
    items_by_loop: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for gate_id, count in sorted(counts.items()):
        if count < threshold:
            continue
        loop_id = LOOP_BY_GATE.get(gate_id)
        if not loop_id:
            continue
        meta = gate_meta.get(gate_id, {})
        severity = str(meta.get("severity") or "medium").strip().lower() or "medium"
        name = str(meta.get("name") or gate_id).strip()
        gate_samples = samples.get(gate_id, [])
        actual = (
            f"{gate_id} recurrence remains unresolved: {count} FAIL hits across the last {days}d. "
            f"Evidence samples: {', '.join(gate_samples[:3]) or 'none'}. "
            f"This gate should have been converted into governed cleanup for {loop_id}."
        )
        expected = f"{name} recurrence should be converted into governed cleanup for {loop_id}."
        items_by_loop[loop_id].append(
            {
                "capability": f"gate.recurrence.{gate_id.lower()}",
                "expected": expected,
                "actual": actual,
                "severity": severity,
            }
        )
    return items_by_loop


def run_friction_ingest(
    ingest_cmd: Path,
    queue: Path,
    lock_file: Path,
    loop_id: str,
    items: list[dict[str, Any]],
    source: str,
) -> dict[str, Any]:
    payload = "\n".join(json.dumps(item, sort_keys=True) for item in items) + "\n"
    proc = subprocess.run(
        [
            str(ingest_cmd),
            "--queue",
            str(queue),
            "--lock-file",
            str(lock_file),
            "--source",
            source,
            "--loop-id",
            loop_id,
            "--auto-reconcile",
            "--stdin-jsonl",
            "--json",
        ],
        cwd=str(ROOT),
        input=payload,
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip() or "unknown friction.ingest failure"
        fail(f"friction.ingest failed for {loop_id}: {detail}")
    out = (proc.stdout or "").strip()
    if not out:
        return {"loop_id": loop_id, "status": "ok"}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {"loop_id": loop_id, "status": "ok", "raw_output": out}


def main() -> int:
    args = parse_args()
    evidence_root = Path(args.evidence_root).expanduser()
    queue = Path(args.queue).expanduser()
    lock_file = Path(args.lock_file).expanduser()
    ingest_cmd = Path(args.friction_ingest_cmd).expanduser()

    if not ingest_cmd.exists():
        fail(f"missing friction.ingest command: {ingest_cmd}")

    gate_meta = load_gate_meta()
    counts, samples = collect_recent_failures(evidence_root, args.days)
    items_by_loop = build_items(counts, samples, args.days, args.threshold, gate_meta)

    payload = {
        "status": "ok",
        "evidence_root": str(evidence_root),
        "days": args.days,
        "threshold": args.threshold,
        "loops": {},
        "queue": str(queue),
        "auto_reconcile": not args.dry_run,
    }

    for loop_id, items in sorted(items_by_loop.items()):
        payload["loops"][loop_id] = {
            "item_count": len(items),
            "gates": sorted({item["capability"].removeprefix("gate.recurrence.") for item in items}),
        }
        if not args.dry_run:
            run_friction_ingest(ingest_cmd, queue, lock_file, loop_id, items, args.source)

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=False))
    else:
        print("gate.recurrence.convert")
        print("status: ok")
        print(f"evidence_root: {evidence_root}")
        print(f"days: {args.days}")
        print(f"threshold: {args.threshold}")
        for loop_id, details in sorted(payload["loops"].items()):
            print(f"{loop_id}: {details['item_count']} item(s) -> {', '.join(details['gates'])}")
        if not payload["loops"]:
            print("no recurring gate failures met threshold")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
