#!/usr/bin/env python3
"""blueprint-admission-status — Read-only readback of operator blueprint admission matrix."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("BLOCKED: PyYAML not installed")

ROOT = Path(__file__).resolve().parents[5]
ADMISSION_PATH = ROOT / "ops" / "bindings" / "operator.blueprint.admission.yaml"
RONNY_PROJECTS_ROOT = Path("/Users/ronnyworks/code/ronny-projects")


L3_PROOF_SUBJECTS = [
    {
        "domain": "travel",
        "source_oi": "OI-20260429-023809-21a9",
        "expected_files": ["README.md", "pyproject.toml", "tests", "src"],
    },
    {
        "domain": "health",
        "source_oi": "OI-20260429-023725-75b4",
        "expected_files": ["README.md", "pyproject.toml", "tests", "src"],
    },
    {
        "domain": "investment",
        "source_oi": "OI-20260429-023732-a58e",
        "expected_files": ["README.md", "pyproject.toml", "tests", "src"],
    },
]


def load_matrix() -> dict:
    if not ADMISSION_PATH.exists():
        return {"error": f"Admission matrix not found: {ADMISSION_PATH}"}
    with open(ADMISSION_PATH) as f:
        data = yaml.safe_load(f)
    if isinstance(data, dict):
        data["summary"] = computed_summary(data.get("entries", []), data.get("summary", {}))
    return data


def computed_summary(entries: list[dict], existing: dict | None = None) -> dict:
    existing = existing or {}
    summary = dict(existing)
    decisions = {"materialize": 0, "shelf": 0, "reference_only": 0, "tombstone": 0}
    statuses = {"proved": 0, "materializing": 0, "shelved": 0, "classified": 0}
    blueprint_l1 = 0
    domain_vision_l3 = 0
    reference_only = 0

    for entry in entries:
        if not isinstance(entry, dict):
            continue
        decision = str(entry.get("decision", "") or "")
        status = str(entry.get("status", "") or "")
        if decision:
            decisions[decision] = decisions.get(decision, 0) + 1
        if status:
            statuses[status] = statuses.get(status, 0) + 1
        intent_class = str(entry.get("operator_intent_class", "") or "")
        layer = str(entry.get("layer", "") or "")
        if intent_class == "blueprint" and layer == "L1":
            blueprint_l1 += 1
        elif intent_class == "domain_vision" and layer == "L3":
            domain_vision_l3 += 1
        elif intent_class == "reference_only":
            reference_only += 1

    summary.update(
        {
            "total_files": len(entries),
            "blueprint_l1": blueprint_l1,
            "domain_vision_l3": domain_vision_l3,
            "reference_only": reference_only,
            "decisions": decisions,
            "statuses": statuses,
        }
    )
    return summary


def render_text(data: dict) -> str:
    lines: list[str] = []
    if "error" in data:
        return data["error"]

    entries = data.get("entries", [])
    summary = data.get("summary", {})

    lines.append("=== OPERATOR BLUEPRINT ADMISSION STATUS ===")
    lines.append("")
    lines.append(f"Total files: {summary.get('total_files', '?')}")
    lines.append(f"  Blueprint (L1): {summary.get('blueprint_l1', '?')}")
    lines.append(f"  Domain vision (L3): {summary.get('domain_vision_l3', '?')}")
    lines.append(f"  Reference only: {summary.get('reference_only', '?')}")
    lines.append("")

    decisions = summary.get("decisions", {})
    lines.append("Decisions:")
    for k, v in decisions.items():
        lines.append(f"  {k}: {v}")
    lines.append("")

    statuses = summary.get("statuses", {})
    lines.append("Statuses:")
    for k, v in statuses.items():
        lines.append(f"  {k}: {v}")
    lines.append("")

    proof = summary.get("materialization_proof", {})
    if proof:
        lines.append("Materialization proof:")
        lines.append(f"  Specimen: {proof.get('specimen', '?')}")
        lines.append(f"  Source: {proof.get('source', '?')}")
        lines.append(f"  Target: {proof.get('target', '?')}")
        lines.append(f"  Gate: {proof.get('gate', '?')}")
        lines.append(f"  Commits: {', '.join(proof.get('commits', []))}")
        lines.append(f"  Evidence: {proof.get('evidence', '?')}")
        lines.append("")

    lines.append("--- Entry Details ---")
    lines.append("")

    for e in entries:
        eid = e.get("id", "?")
        title = e.get("title", "?")
        decision = e.get("decision", "?")
        status = e.get("status", "?")
        layer = e.get("layer", "?")
        intent_class = e.get("operator_intent_class", "?")
        claim = e.get("claim_type", "?")

        lines.append(f"[{eid}] {title}")
        lines.append(f"  class={intent_class}  layer={layer}  decision={decision}  status={status}  claim={claim}")

        if e.get("materialization_target"):
            mt = e["materialization_target"]
            lines.append(f"  materialized_to: {mt.get('authority', '?')}")
            lines.append(f"  proof: {mt.get('proof', '?')}")

        gap = e.get("materialization_gap")
        if gap and decision != "reference_only":
            lines.append(f"  gap: {gap.strip()}")

        trigger = e.get("shelf_trigger")
        if trigger:
            lines.append(f"  trigger: {trigger.strip()}")

        lines.append("")

    return "\n".join(lines)


def l3_proof_tranche() -> dict:
    rows = []
    for subject in L3_PROOF_SUBJECTS:
        project_path = RONNY_PROJECTS_ROOT / subject["domain"]
        expected = []
        for rel in subject["expected_files"]:
            path = project_path / rel
            expected.append({"path": str(path), "present": path.exists()})
        build_summary = project_path / "BUILD_SUMMARY.md"
        readme = project_path / "README.md"
        rows.append(
            {
                "domain": subject["domain"],
                "source_oi": subject["source_oi"],
                "project_path": str(project_path),
                "project_present": project_path.exists(),
                "expected_files": expected,
                "spec_state": "v1_base_present" if all(item["present"] for item in expected) else "incomplete",
                "build_summary_present": build_summary.exists(),
                "readme_present": readme.exists(),
                "proof_state": "ready_for_governed_spec_readback"
                if project_path.exists() and readme.exists()
                else "missing_project_base",
                "stop_line": "new L3 proof only; does not launch old L3 cleanup",
            }
        )
    ready = sum(1 for row in rows if row["proof_state"] == "ready_for_governed_spec_readback")
    return {
        "status": "ok",
        "packet": "PACKET-536-NEW-L3-PROOF-TRANCHE",
        "root": str(RONNY_PROJECTS_ROOT),
        "summary": {
            "subjects": len(rows),
            "ready_for_governed_spec_readback": ready,
            "old_l3_cleanup_excluded": True,
        },
        "rows": rows,
    }


def render_l3_proof(payload: dict) -> str:
    lines = ["=== NEW L3 PROOF TRANCHE ===", ""]
    summary = payload.get("summary") or {}
    lines.append(f"Root: {payload.get('root')}")
    lines.append(f"Subjects: {summary.get('subjects')}  ready: {summary.get('ready_for_governed_spec_readback')}")
    lines.append("Old L3 cleanup excluded: true")
    lines.append("")
    for row in payload.get("rows") or []:
        lines.append(f"[{row['domain']}] {row['proof_state']}")
        lines.append(f"  source_oi: {row['source_oi']}")
        lines.append(f"  path: {row['project_path']}")
        lines.append(f"  spec_state: {row['spec_state']}")
        missing = [item["path"] for item in row["expected_files"] if not item["present"]]
        lines.append(f"  missing: {', '.join(missing) if missing else 'none'}")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="blueprint-admission-status",
        description="Read-only readback of operator blueprint admission matrix.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_output",
        help="Emit JSON output.",
    )
    parser.add_argument(
        "--id",
        type=str,
        default=None,
        help="Filter to a single entry by BPA-NNN id.",
    )
    parser.add_argument(
        "--decision",
        type=str,
        default=None,
        choices=["materialize", "shelf", "tombstone", "reference_only"],
        help="Filter entries by admission decision.",
    )
    parser.add_argument(
        "--status",
        type=str,
        default=None,
        help="Filter entries by admission status.",
    )
    parser.add_argument(
        "--l3-proof-tranche",
        action="store_true",
        help="Read Packet 536 proof tranche against ronny-projects v1 bases.",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="Verify dependencies and exit.",
    )
    args = parser.parse_args()

    if args.self_check:
        if not ADMISSION_PATH.exists():
            print(f"BLOCKED: {ADMISSION_PATH} not found")
            return 1
        print(f"OK: {ADMISSION_PATH}")
        return 0

    if args.l3_proof_tranche:
        payload = l3_proof_tranche()
        if args.json_output:
            print(json.dumps(payload, indent=2, default=str))
        else:
            print(render_l3_proof(payload))
        return 0

    data = load_matrix()
    if "error" in data:
        print(data["error"], file=sys.stderr)
        return 1

    entries = data.get("entries", [])
    if args.id:
        entries = [e for e in entries if e.get("id") == args.id]
    if args.decision:
        entries = [e for e in entries if e.get("decision") == args.decision]
    if args.status:
        entries = [e for e in entries if e.get("status") == args.status]
    data["entries"] = entries

    if args.json_output:
        out = {
            "entries": entries,
            "summary": data.get("summary", {}),
        }
        print(json.dumps(out, indent=2, default=str))
    else:
        print(render_text(data))

    return 0


if __name__ == "__main__":
    sys.exit(main())
