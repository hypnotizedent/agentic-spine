#!/usr/bin/env python3
"""delegation-status — CLI for delegation.status capability.

Read-only query of delegation state. Shows all delegations or filtered
by ID or state. Primary operator read path for delegated work.

Exit codes:
  0  success
  1  query failed
  2  invalid arguments
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import delegation_broker as db


def _format_table(delegations: list[dict]) -> str:
    """Format delegations as a human-readable table."""
    if not delegations:
        return "No delegations found."

    lines = []
    header = f"{'DELEGATION':<22s} {'LOOP':<45s} {'PACKET':<30s} {'STATE':<18s} {'WORKER':<18s} {'DISPOSITION'}"
    lines.append(header)
    lines.append("-" * len(header))

    for d in delegations:
        del_id = str(d.get("delegation_id", ""))
        loop_id = str(d.get("loop_id", ""))
        if len(loop_id) > 43:
            loop_id = loop_id[:40] + "..."
        packet_id = str(d.get("packet_id", ""))
        if len(packet_id) > 28:
            packet_id = packet_id[:25] + "..."
        raw_state = str(d.get("delegation_state", ""))
        effective_state = str(d.get("effective_state", "")).strip()
        if effective_state and effective_state != raw_state:
            state = f"{effective_state}/{raw_state}"
        else:
            state = effective_state or raw_state
        worker = str(d.get("picked_up_by") or "(pending)")
        disposition = str(d.get("disposition") or "")
        lines.append(
            f"{del_id:<22s} {loop_id:<45s} {packet_id:<30s} {state:<18s} {worker:<18s} {disposition}"
        )

    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="delegation-status",
        description="Query delegation state.",
    )
    parser.add_argument(
        "--id", default="", dest="delegation_id",
        help="Specific delegation ID to query",
    )
    parser.add_argument(
        "--state", default="", dest="state_filter",
        help="Filter by delegation state (delegated, picked_up, executing, landed, needs_review, cancelled)",
    )
    parser.add_argument(
        "--json", action="store_true", dest="json_output",
        help="Emit JSON output",
    )
    parser.add_argument(
        "--self-check", action="store_true",
        help="Verify dependencies and exit",
    )

    if "--self-check" in sys.argv:
        try:
            import delegation_broker  # noqa: F401
            import yaml  # noqa: F401
            print("delegation.status self-check PASS")
            return 0
        except ImportError as exc:
            print(f"delegation.status self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    spine_state = os.environ.get("SPINE_STATE", "")
    if not spine_state:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"delegation.status FAIL: {msg}", file=sys.stderr)
        return 1

    try:
        result = db.status(
            state_root=spine_state,
            delegation_id=args.delegation_id,
            state_filter=args.state_filter,
        )
    except db.DelegationError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"delegation.status FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(_format_table(result.get("delegations", [])))
        print(f"\nTotal: {result.get('count', 0)}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
