#!/usr/bin/env python3
"""operator-ingress-auto-metabolizer-status — runtime status for ingress worker."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import operator_ingress as oi

_LABEL = "com.ronny.operator-ingress-auto-metabolizer"
_FALLBACK_EXEC_HOST_TARGET_ID = "ai-consolidation"
_FALLBACK_EXEC_HOST_STATE_ROOT = "/home/ubuntu/code/.runtime/spine/state"
_STALE_THRESHOLD_SECONDS = 300  # 5 minutes — local heartbeat older than this triggers remote probe


def _load_yaml_file(path: Path) -> dict:
    try:
        import yaml

        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _load_scheduler_entry() -> dict:
    registry = _load_yaml_file(ROOT / "ops" / "bindings" / "launchd.scheduler.registry.yaml")
    labels = registry.get("labels") if isinstance(registry.get("labels"), list) else []
    for entry in labels:
        if isinstance(entry, dict) and entry.get("label") == _LABEL:
            return entry
    return {}


def _parse_systemd_environment(path: Path) -> dict[str, str]:
    env: dict[str, str] = {}
    if not path.is_file():
        return env
    pattern = re.compile(r'^Environment=["\']?([^="\']+)=([^"\']*)["\']?$')
    for raw_line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        match = pattern.match(line)
        if match:
            env[match.group(1)] = match.group(2)
    return env


def _derive_state_root_from_heartbeat(path: str) -> str:
    suffix = "/inputs/operator-ingress/.auto-metabolizer-heartbeat.json"
    return path[: -len(suffix)] if path.endswith(suffix) else ""


def _resolve_custody_metadata(local_state_root: str | None = None) -> dict:
    entry = _load_scheduler_entry()
    proof = entry.get("proof_channel") if isinstance(entry.get("proof_channel"), dict) else {}
    systemd_unit_path = str(entry.get("systemd_unit_path") or "")
    systemd_env = _parse_systemd_environment(ROOT / systemd_unit_path) if systemd_unit_path else {}

    risks: list[str] = []
    exec_host_id = str(entry.get("active_runtime_host") or proof.get("host") or "")
    exec_host_source = "launchd.scheduler.registry"
    if not exec_host_id:
        exec_host_id = _FALLBACK_EXEC_HOST_TARGET_ID
        exec_host_source = "hardcoded_fallback"
        risks.append("execution_host_id fell back to hardcoded ai-consolidation")

    exec_state_root = str(systemd_env.get("SPINE_STATE") or "")
    exec_state_source = "systemd_unit_environment" if exec_state_root else ""
    if not exec_state_root:
        exec_state_root = _derive_state_root_from_heartbeat(str(proof.get("path") or ""))
        exec_state_source = "launchd.scheduler.registry.proof_channel.path" if exec_state_root else ""
    if not exec_state_root:
        exec_state_root = _FALLBACK_EXEC_HOST_STATE_ROOT
        exec_state_source = "hardcoded_fallback"
        risks.append("execution_host_runtime_path fell back to hardcoded state root")

    local_runtime_path = local_state_root or os.environ.get("SPINE_STATE", "")
    local_heartbeat = (
        str(Path(local_runtime_path) / "inputs" / "operator-ingress" / ".auto-metabolizer-heartbeat.json")
        if local_runtime_path
        else ""
    )
    exec_heartbeat = str(Path(exec_state_root) / "inputs" / "operator-ingress" / ".auto-metabolizer-heartbeat.json")
    if local_runtime_path and local_runtime_path != exec_state_root:
        risks.append("operator_console/local runtime path differs from execution_host runtime path; custody depends on state sync/API path")

    return {
        "custody_topology": "operator_console_local_readback_plus_execution_host_worker",
        "source_of_truth": "$SPINE_STATE/inputs/operator-ingress/OI-*.yaml with human_intent nested inside each OI YAML",
        "local_runtime_path": local_runtime_path,
        "local_heartbeat_path": local_heartbeat,
        "execution_host_id": exec_host_id,
        "execution_host_id_source": exec_host_source,
        "execution_host_runtime_path": exec_state_root,
        "execution_host_runtime_path_source": exec_state_source,
        "execution_host_heartbeat_path": exec_heartbeat,
        "scheduler_label": _LABEL,
        "systemd_unit_path": systemd_unit_path,
        "custody_risk": risks or ["none_detected"],
    }


def _format_age(seconds: int | None) -> str:
    if seconds is None or seconds < 0:
        return "n/a"
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h {(seconds % 3600) // 60}m"


def _health_label(status: str, worker: dict) -> str:
    """Return one of: HEALTHY / IDLE / STALE / DEAD / NEVER_RUN."""
    if status == "running":
        return "HEALTHY"
    if status == "recent":
        return "IDLE"
    if status == "stale":
        return "STALE"
    if status == "idle":
        if not worker.get("heartbeat_at"):
            return "NEVER_RUN"
        return "DEAD"
    return status.upper()


def _heartbeat_state(status: str, worker: dict) -> str:
    """Return one of: fresh, stale, missing, unavailable."""
    if status in {"running", "recent"}:
        return "fresh"
    if status == "stale":
        return "stale"
    if not worker.get("heartbeat_at"):
        return "missing"
    return "unavailable"


def _resolve_ssh_host(target_id: str) -> str | None:
    """Resolve execution host SSH host via ssh-resolve.sh."""
    resolver = ROOT / "ops" / "lib" / "ssh-resolve.sh"
    if not resolver.is_file():
        return None
    # Source the resolver and call ssh_resolve_tailscale_ip, falling back to host
    script = f"""
        source "{resolver}"
        ts="$(ssh_resolve_tailscale_ip "{target_id}")"
        host="$(ssh_resolve_host "{target_id}")"
        echo "${{ts:-$host}}"
    """
    try:
        result = subprocess.run(
            ["bash", "-c", script],
            capture_output=True, text=True, timeout=5,
        )
        addr = result.stdout.strip()
        return addr if addr else None
    except Exception:
        return None


def _resolve_ssh_user(target_id: str) -> str:
    resolver = ROOT / "ops" / "lib" / "ssh-resolve.sh"
    if not resolver.is_file():
        return "ubuntu"
    script = f'source "{resolver}"; ssh_resolve_user "{target_id}" "ubuntu"'
    try:
        result = subprocess.run(["bash", "-c", script], capture_output=True, text=True, timeout=5)
        user = result.stdout.strip()
        return user or "ubuntu"
    except Exception:
        return "ubuntu"


def _fetch_remote_heartbeat(custody: dict) -> dict | None:
    """SSH to execution host and read the heartbeat file. Returns parsed JSON or None."""
    target_id = str(custody.get("execution_host_id") or "")
    heartbeat = str(custody.get("execution_host_heartbeat_path") or "")
    if not target_id or not heartbeat:
        return None
    host = _resolve_ssh_host(target_id)
    if not host:
        return None
    user = _resolve_ssh_user(target_id)
    # Resolve machine identity opts
    resolver = ROOT / "ops" / "lib" / "ssh-resolve.sh"
    id_script = f'source "{resolver}"; ssh_resolve_machine_identity_opts "{target_id}"'
    try:
        id_result = subprocess.run(
            ["bash", "-c", id_script],
            capture_output=True, text=True, timeout=5,
        )
        identity_opts = id_result.stdout.strip().split() if id_result.returncode == 0 else []
    except Exception:
        identity_opts = []

    ssh_cmd = [
        "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3",
        "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
        *identity_opts,
        f"{user}@{host}",
        f"cat {heartbeat}",
    ]
    for attempt in range(2):
        try:
            result = subprocess.run(ssh_cmd, capture_output=True, text=True, timeout=10)
            if result.returncode == 0 and result.stdout.strip():
                return json.loads(result.stdout)
        except Exception:
            pass
        if attempt == 0:
            time.sleep(0.2)
    return None


def _heartbeat_to_result(hb: dict) -> dict:
    """Convert a raw heartbeat JSON into the same shape as oi.operator_ingress_auto_metabolizer_status."""
    heartbeat_at = hb.get("heartbeat_at", "")
    age_seconds = None
    if heartbeat_at:
        try:
            hb_time = datetime.fromisoformat(heartbeat_at.replace("Z", "+00:00"))
            age_seconds = int((datetime.now(timezone.utc) - hb_time).total_seconds())
        except Exception:
            pass

    pid = hb.get("pid", 0)
    # Derive status from heartbeat age
    if age_seconds is not None and age_seconds < _STALE_THRESHOLD_SECONDS:
        status = "running"
    elif age_seconds is not None:
        status = "stale"
    elif not heartbeat_at:
        status = "idle"
    else:
        status = "stale"

    return {
        "status": status,
        "read_state": "ok",
        "worker": {
            "heartbeat_at": heartbeat_at or None,
            "heartbeat_age_seconds": age_seconds,
            "pid": pid,
            "pid_alive": True if status == "running" else False,
            "last_ingress_ids": hb.get("last_ingress_ids", []),
        },
        "queue": {
            "pending": hb.get("pending_count", 0),
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="operator-ingress-auto-metabolizer-status",
        description="Show runtime status for the operator ingress auto-metabolizer.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_output",
        help="Emit JSON output.",
    )
    parser.add_argument(
        "--remote",
        action="store_true",
        help="Force read from execution host (ai-consolidation) via SSH.",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="Force read from local state only (no remote fallback).",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="Verify dependencies and exit.",
    )

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            custody = _resolve_custody_metadata(os.environ.get("SPINE_STATE", ""))
            if not custody.get("execution_host_id") or not custody.get("execution_host_runtime_path"):
                raise RuntimeError("custody metadata resolution incomplete")
            print("operator.ingress.auto_metabolize.status self-check PASS")
            return 0
        except Exception as exc:
            print(
                f"operator.ingress.auto_metabolize.status self-check FAIL: {exc}",
                file=sys.stderr,
            )
            return 1

    args = parser.parse_args()
    state_root = os.environ.get("SPINE_STATE", "")
    custody = _resolve_custody_metadata(state_root)
    if not state_root and not args.remote:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"operator.ingress.auto_metabolize.status FAIL: {msg}", file=sys.stderr)
        return 1

    result = None
    source = "local"

    # Try local first (unless --remote forces remote)
    if not args.remote and state_root:
        try:
            result = oi.operator_ingress_auto_metabolizer_status(state_root)
        except oi.OperatorIngressError:
            result = None

        # If local heartbeat is stale/missing and --local not forced, try remote
        if result and not args.local:
            worker = result.get("worker", {})
            age = worker.get("heartbeat_age_seconds")
            has_heartbeat = bool(worker.get("heartbeat_at"))
            if not has_heartbeat or (age is not None and age > _STALE_THRESHOLD_SECONDS):
                remote_hb = _fetch_remote_heartbeat(custody)
                if remote_hb:
                    result = _heartbeat_to_result(remote_hb)
                    source = "remote"

    # --remote or local failed entirely
    if result is None:
        remote_hb = _fetch_remote_heartbeat(custody)
        if remote_hb:
            result = _heartbeat_to_result(remote_hb)
            source = "remote"
        else:
            msg = "no heartbeat available (local missing, remote unreachable)"
            if args.json_output:
                print(json.dumps({
                    "health": "UNKNOWN",
                    "status": "unknown",
                    "read_state": "unavailable",
                    "source": "unavailable",
                    "heartbeat_at": None,
                    "heartbeat_age": None,
                    "heartbeat_age_seconds": None,
                    "heartbeat_state": "unavailable",
                    "pid_alive": False,
                    "queue_pending": 0,
                    "last_processed": [],
                    "stale_threshold_seconds": _STALE_THRESHOLD_SECONDS,
                    "custody": custody,
                    "error": msg,
                }, indent=2))
            else:
                print(f"Metabolizer: UNKNOWN  ({msg})")
            return 0

    worker = result["worker"]
    queue = result["queue"]
    age = worker.get("heartbeat_age_seconds")
    health = _health_label(result["status"], worker)

    if args.json_output:
        heartbeat_state = _heartbeat_state(result["status"], worker)
        out = {
            "health": health,
            "status": result["status"],
            "read_state": result.get("read_state", "ok"),
            "source": source,
            "heartbeat_at": worker["heartbeat_at"] or None,
            "heartbeat_age": _format_age(age) if age is not None else None,
            "heartbeat_age_seconds": age,
            "heartbeat_state": heartbeat_state,
            "pid_alive": worker["pid_alive"],
            "queue_pending": queue["pending"],
            "last_processed": worker.get("last_ingress_ids", []),
            "stale_threshold_seconds": _STALE_THRESHOLD_SECONDS,
            "custody": custody,
        }
        print(json.dumps(out, indent=2))
    else:
        source_tag = f"  (via {source})" if source == "remote" else ""
        age_str = f" ({_format_age(age)} ago)" if age is not None else ""
        print(f"Metabolizer: {health}  heartbeat: {worker['heartbeat_at'] or 'never'}{age_str}{source_tag}")
        if queue["pending"] > 0:
            print(f"Queue: {queue['pending']} pending")

        last_ids = worker.get("last_ingress_ids", [])
        if last_ids:
            print(f"Last processed: {', '.join(last_ids)}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
