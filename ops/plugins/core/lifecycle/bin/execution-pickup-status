#!/usr/bin/env python3
"""Public execution pickup readback.

This joins the existing execution-request realizations without creating a new
queue or transport. Plain wave dispatches are requests only until a delegation
or operational task claim exists.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shlex
import subprocess
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
WORKSPACE_ROOT = ROOT.parent
RUNTIME_ROOT = Path(os.environ.get("SPINE_RUNTIME_ROOT") or WORKSPACE_ROOT / ".runtime" / "spine")
STATE_ROOT = Path(os.environ.get("SPINE_STATE") or RUNTIME_ROOT / "state")
WAVES_ROOT = RUNTIME_ROOT / "waves"
DELEGATIONS_ROOT = STATE_ROOT / "delegations"
TASK_ROOT = STATE_ROOT / "agent-tasks"
PATCH_REVIEW_ROOT = STATE_ROOT / "domain-state" / "ai-patch-reviews"
SCHEDULER_REGISTRY = ROOT / "ops" / "bindings" / "launchd.scheduler.registry.yaml"
RUNTIME_BOOTSTRAP_CONTRACT = ROOT / "ops" / "bindings" / "runtime.bootstrap.contract.yaml"
MAILROOM_WORKER_CONTRACT = ROOT / "ops" / "bindings" / "mailroom.task.worker.contract.yaml"
SSH_RESOLVER = ROOT / "ops" / "lib" / "ssh-resolve.sh"


def _resolve_task_heartbeat_stale_threshold() -> int:
    """Per-task heartbeat staleness threshold (PACKET-1225 canon line 199 closure).

    Source-of-truth precedence:
      1. EXECUTION_PICKUP_STALE_SECONDS env (escape hatch)
      2. mailroom.task.worker.contract.yaml#kernel_realization.primitives.heartbeat
         .task_heartbeat_staleness_threshold_seconds (canonical)
      3. defensive 300s fallback (only if contract is unreadable / field missing)
    """
    env_value = os.environ.get("EXECUTION_PICKUP_STALE_SECONDS", "").strip()
    if env_value:
        try:
            return int(env_value)
        except ValueError:
            pass
    try:
        contract = yaml.safe_load(MAILROOM_WORKER_CONTRACT.read_text(encoding="utf-8")) or {}
        primitives = (((contract.get("kernel_realization") or {}).get("primitives") or {}))
        heartbeat = primitives.get("heartbeat") or {}
        contract_value = heartbeat.get("task_heartbeat_staleness_threshold_seconds")
        if isinstance(contract_value, int) and contract_value > 0:
            return contract_value
    except Exception:
        pass
    return 300


STALE_SECONDS = _resolve_task_heartbeat_stale_threshold()
CANONICAL_TASK_ROOT_DEFAULT = "/md1400/spine/state/agent-tasks"
LOCAL_CANONICAL_FETCH_DISABLE = os.environ.get("EXECUTION_PICKUP_DISABLE_CANONICAL_FETCH", "").strip() == "1"
CANONICAL_PLANE_ACCESS_BINDING = "ops/bindings/node.role.contract.yaml#canonical_plane_access.by_role"


ACTIVE_DELEGATION_STATES = {"delegated", "picked_up", "executing", "running"}
TERMINAL_TASK_STATES = {"done", "failed", "cancelled"}


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def parse_time(value: Any) -> dt.datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def age_seconds(value: Any) -> int | None:
    parsed = parse_time(value)
    if parsed is None:
        return None
    return max(0, int((now_utc() - parsed).total_seconds()))


def load_json(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def load_yaml(path: Path) -> dict[str, Any]:
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return {}
    return payload if isinstance(payload, dict) else {}


def patch_review_for(task_id: str) -> dict[str, Any]:
    if not task_id:
        return {}
    return load_yaml(PATCH_REVIEW_ROOT / f"{task_id}.yaml")


def effective_patch_review_state(review: dict[str, Any]) -> str:
    raw_state = str(review.get("review_state") or review.get("review_status") or "").strip()
    if raw_state in {"rejected_by_controller", "merged_by_controller", "superseded", "stale"}:
        return raw_state
    patch_artifact = Path(str(review.get("patch_artifact_path") or ""))
    review_worktree = Path(str(review.get("review_worktree") or ""))
    if review_worktree and str(review_worktree) != "." and review_worktree.is_dir():
        return "review_worktree_active"
    if patch_artifact and str(patch_artifact) != "." and patch_artifact.is_file():
        return "review_artifact_retained"
    if raw_state:
        return raw_state
    return "needs_controller_review"


def patch_artifact_readback(path_value: Any) -> dict[str, Any]:
    path_text = str(path_value or "").strip()
    if not path_text:
        return {
            "patch_artifact_available": False,
            "patch_artifact_locality": "missing",
        }
    path = Path(path_text)
    if path.is_file():
        return {
            "patch_artifact_available": True,
            "patch_artifact_locality": "local",
        }
    if path.is_absolute():
        try:
            path.relative_to(STATE_ROOT)
        except ValueError:
            locality = "foreign_absolute"
        else:
            locality = "missing_local"
        return {
            "patch_artifact_available": False,
            "patch_artifact_locality": locality,
        }
    return {
        "patch_artifact_available": False,
        "patch_artifact_locality": "missing",
    }


def normalize_task_payload(value: Any) -> dict[str, Any]:
    if isinstance(value, dict):
        return value
    if isinstance(value, str) and value.strip():
        try:
            payload = json.loads(value)
        except json.JSONDecodeError:
            return {}
        return payload if isinstance(payload, dict) else {}
    return {}


def mailroom_worker_proof_channel() -> dict[str, Any]:
    registry = load_yaml(SCHEDULER_REGISTRY)
    for entry in registry.get("labels", []) or []:
        if not isinstance(entry, dict):
            continue
        if str(entry.get("label") or "") == "com.ronny.mailroom-task-worker":
            proof = entry.get("proof_channel")
            return proof if isinstance(proof, dict) else {}
    return {}


def load_remote_json(host_ref: str, remote_path: str) -> dict[str, Any]:
    if not host_ref or not remote_path or not SSH_RESOLVER.is_file():
        return {}
    script = f'''
set -euo pipefail
source {shlex.quote(str(SSH_RESOLVER))}
target={shlex.quote(host_ref)}
path={shlex.quote(remote_path)}
resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 3 | awk '{{print $1}}')"
user="$(ssh_resolve_user "$target" ubuntu)"
identity_opts="$(ssh_resolve_machine_identity_opts "$target" 2>/dev/null || true)"
ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $identity_opts "$user@$resolved" "cat $(printf %q "$path")"
'''
    try:
        proc = subprocess.run(
            ["bash", "-lc", script],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except Exception:
        return {}
    if proc.returncode != 0 or not proc.stdout.strip():
        return {}
    try:
        payload = json.loads(proc.stdout)
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


def receipt_refs_from(row: dict[str, Any]) -> list[str]:
    refs: list[str] = []
    run_key = str(row.get("run_key") or "").strip()
    if run_key:
        refs.append(run_key)
    bridge_proof = row.get("bridge_proof")
    if isinstance(bridge_proof, dict):
        for key in ("run_id", "run_dir", "request_file", "result_file"):
            value = str(bridge_proof.get(key) or "").strip()
            if value:
                refs.append(value)
        run_keys = bridge_proof.get("run_keys")
        if isinstance(run_keys, list):
            refs.extend(str(item).strip() for item in run_keys if str(item).strip())
    result = str(row.get("result") or "")
    for token in result.replace(",", " ").split():
        if token.startswith("run_key="):
            refs.append(token.split("=", 1)[1])
        elif token.startswith("receipt="):
            refs.append(token.split("=", 1)[1])
    return sorted(set(refs))


SAFETY_TIERS = (
    "capability",
    "bounded_readonly_provider_agent",
    "tool_using_agent_v2_1_readonly_repo",
    "tool_using_agent_v2_2_readonly_capability_calls",
    "tool_using_agent_v2_3_fenced_artifact_write",
    "tool_using_agent_v2_4_patch_artifact",
    "tool_using_agent_v2_5_patch_apply_sandbox",
    "tool_using_agent_reserved",
    "destructive_manual",
)


def safety_tier_for(row: dict[str, Any]) -> str:
    route_target = str(row.get("route_target") or "").strip().lower()
    if route_target == "agent_tool":
        bridge_proof = row.get("bridge_proof") if isinstance(row.get("bridge_proof"), dict) else {}
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        bridge_scope = str(bridge_proof.get("scope") or "").strip()
        if (
            bridge_proof.get("scope") == "tool_using_agent_v2_5_patch_apply_sandbox"
            or str(payload.get("tool_set") or "").strip() == "patch_apply_sandbox"
        ):
            return "tool_using_agent_v2_5_patch_apply_sandbox"
        if (
            bridge_proof.get("scope") == "tool_using_agent_v2_4_patch_artifact"
            or str(payload.get("tool_set") or "").strip() == "patch_artifact"
        ):
            return "tool_using_agent_v2_4_patch_artifact"
        if (
            bridge_proof.get("scope") == "tool_using_agent_v2_3_fenced_artifact_write"
            or str(payload.get("tool_set") or "").strip() == "fenced_artifact_write"
        ):
            return "tool_using_agent_v2_3_fenced_artifact_write"
        if (
            bridge_proof.get("scope") == "tool_using_agent_v2_2_readonly_capability_calls"
            or str(payload.get("tool_set") or "").strip() == "read_only_capability_calls"
        ):
            return "tool_using_agent_v2_2_readonly_capability_calls"
        if bridge_proof.get("scope") == "tool_using_agent_v2_1_readonly_repo" or str(payload.get("tool_set") or "").strip() == "read_only_repo":
            return "tool_using_agent_v2_1_readonly_repo"
        if bridge_scope.startswith("tool_using_agent_"):
            return bridge_scope
        if (
            bridge_proof.get("scope") == "bounded_readonly_provider_agent"
            or row.get("bridge_allowed") is True
            or row.get("route_prompt_ref")
        ):
            return "bounded_readonly_provider_agent"
        return "capability"
    if route_target == "capability" or row.get("route_capability"):
        return "capability"
    if row.get("realization") == "operational_capability_worker":
        return "capability"
    if row.get("source") in {"wave_dispatch", "delegation"}:
        return "capability"
    return "capability"


def kernel_states_for(row: dict[str, Any]) -> dict[str, Any]:
    pickup_state = str(row.get("pickup_state") or "")
    source = str(row.get("source") or "")
    realization = str(row.get("realization") or "")
    heartbeat_age = row.get("heartbeat_age_seconds")
    worker = row.get("worker")
    terminal = pickup_state in TERMINAL_TASK_STATES

    if pickup_state == "not_claimed":
        claim_status = "unclaimed"
    elif pickup_state in {"claimed", "stale"}:
        claim_status = "claimed"
    elif terminal:
        claim_status = "terminal"
    else:
        claim_status = pickup_state or "unknown"

    if pickup_state == "stale":
        heartbeat_status = "stale"
    elif pickup_state == "claimed":
        heartbeat_status = "fresh" if heartbeat_age is not None and heartbeat_age <= STALE_SECONDS else "unknown"
    elif pickup_state == "not_claimed":
        heartbeat_status = "not_applicable_until_claimed"
    elif terminal:
        heartbeat_status = "terminal"
    else:
        heartbeat_status = "unknown"

    if pickup_state == "done":
        outcome_status = "success"
    elif pickup_state == "failed":
        outcome_status = "failure"
    elif pickup_state == "cancelled":
        outcome_status = "blocked"
    elif pickup_state == "stale":
        outcome_status = "active_at_risk"
    else:
        outcome_status = "pending"

    if pickup_state == "not_claimed":
        recovery_status = "claim_needed"
    elif pickup_state == "stale":
        recovery_status = "worker_recovery_needed"
    elif pickup_state == "claimed":
        recovery_status = "worker_has_custody"
    elif terminal:
        recovery_status = "terminal_read_receipt"
    else:
        recovery_status = "inspect"

    return {
        "request_state": {
            "status": "terminal" if terminal else "active",
            "source": source,
            "realization": realization,
            "boundary": "request does not imply claim or execution" if pickup_state == "not_claimed" else "execution request has runtime state",
        },
        "claim_state": {
            "status": claim_status,
            "worker": worker,
            "boundary": "claim is custody only; not node admission, role promotion, placement, backup, watcher, or domain authority",
        },
        "heartbeat_state": {
            "status": heartbeat_status,
            "heartbeat_at": row.get("heartbeat_at"),
            "age_seconds": heartbeat_age,
            "stale_after_seconds": STALE_SECONDS if pickup_state in {"claimed", "stale"} else None,
        },
        "outcome_state": {
            "status": outcome_status,
            "native_state": pickup_state,
            "result": row.get("result"),
            "failure_reason": row.get("failure_reason"),
        },
        "receipt_refs": receipt_refs_from(row),
        "recovery_posture": {
            "status": recovery_status,
            "public_readback": "execution.pickup.status",
            "drilldown": "internal task lifecycle" if source == "operational_task" else "delegation.status | orchestration.wave.status | wave.execute.status",
        },
    }


def add_request(rows: list[dict[str, Any]], **kwargs: Any) -> None:
    row = {k: v for k, v in kwargs.items() if v not in (None, "", [], {})}
    row["safety_tier"] = safety_tier_for(row)
    proof = row.get("bridge_proof") if isinstance(row.get("bridge_proof"), dict) else {}
    if proof.get("scope") == "tool_using_agent_v2_5_patch_apply_sandbox" and row.get("pickup_state") == "done":
        review = patch_review_for(str(row.get("request_id") or ""))
        if review:
            row["review_state"] = effective_patch_review_state(review)
            row["patch_review_receipt"] = str(PATCH_REVIEW_ROOT / f"{row.get('request_id')}.yaml")
            if row["review_state"] == "review_worktree_active" and review.get("review_worktree"):
                row["review_worktree"] = review.get("review_worktree")
            if row["review_state"] == "review_worktree_active" and review.get("review_branch"):
                row["review_branch"] = review.get("review_branch")
            if review.get("patch_artifact_path"):
                row["patch_artifact_path"] = review.get("patch_artifact_path")
                row.update(patch_artifact_readback(review.get("patch_artifact_path")))
            for key in ("push_sha", "merge_commit", "pushed_ref", "confirmed_by", "merged_at_utc"):
                if review.get(key):
                    row[key] = review.get(key)
        else:
            row["review_state"] = "needs_controller_review"
    row.update(kernel_states_for(row))
    rows.append(row)


def collect_wave_dispatches(rows: list[dict[str, Any]]) -> None:
    if not WAVES_ROOT.is_dir():
        return
    for state_file in sorted(WAVES_ROOT.glob("*/state.json")):
        state = load_json(state_file)
        if state.get("status") != "active":
            continue
        wave_id = str(state.get("wave_id") or state_file.parent.name)
        loop_id = str(((state.get("packet") or {}).get("loop_id")) or "")
        transport = str(state.get("transport") or ((state.get("packet") or {}).get("transport")) or "")
        execution_mode = str(state.get("execution_mode") or ((state.get("packet") or {}).get("execution_mode")) or "")
        for dispatch in state.get("dispatches") or []:
            if not isinstance(dispatch, dict):
                continue
            status = str(dispatch.get("status") or "dispatched")
            if status in {"done", "failed"}:
                continue
            task_id = str(dispatch.get("task_id") or "")
            mailroom_task_id = str(dispatch.get("mailroom_task_id") or "")
            mailroom_state = str(dispatch.get("mailroom_task_state") or "")
            if mailroom_task_id:
                pickup_state = "claimed" if mailroom_state == "running" else mailroom_state or "queued"
                realization = "operational_capability_worker"
            else:
                pickup_state = "not_claimed"
                realization = "wave_dispatch_request_only"
            add_request(
                rows,
                request_id=f"{wave_id}:{task_id}" if task_id else wave_id,
                source="wave_dispatch",
                realization=realization,
                pickup_state=pickup_state,
                loop_id=loop_id,
                wave_id=wave_id,
                dispatch_id=task_id,
                lane=dispatch.get("lane"),
                transport=transport,
                execution_mode=execution_mode,
                task=str(dispatch.get("task") or "")[:180],
                dispatched_at=dispatch.get("dispatched_at"),
                worker=dispatch.get("claimed_by") or dispatch.get("worker"),
                heartbeat_at=dispatch.get("heartbeat_at"),
                result=dispatch.get("result"),
                run_key=dispatch.get("run_key"),
                task_source="local",
            )


def collect_delegations(rows: list[dict[str, Any]]) -> None:
    if not DELEGATIONS_ROOT.is_dir():
        return
    for path in sorted(DELEGATIONS_ROOT.glob("DEL-*.yaml")):
        doc = load_yaml(path)
        state = str(doc.get("delegation_state") or doc.get("state") or "").strip()
        if state not in ACTIVE_DELEGATION_STATES:
            continue
        picked_up = state in {"picked_up", "executing", "running"}
        heartbeat = doc.get("heartbeat_at") or doc.get("updated_at") or doc.get("picked_up_at")
        heartbeat_age = age_seconds(heartbeat)
        stale = picked_up and (heartbeat_age is None or heartbeat_age > STALE_SECONDS)
        add_request(
            rows,
            request_id=str(doc.get("delegation_id") or path.stem),
            source="delegation",
            realization="interactive_worker_handoff",
            pickup_state="stale" if stale else ("claimed" if picked_up else "not_claimed"),
            loop_id=doc.get("loop_id"),
            packet_id=doc.get("packet_id") or doc.get("packet"),
            worker=doc.get("worker") or doc.get("claimed_by"),
            heartbeat_at=heartbeat,
            heartbeat_age_seconds=heartbeat_age,
            task=str(doc.get("summary") or doc.get("objective") or "")[:180],
            task_source="local",
        )


def collect_task_dir(rows: list[dict[str, Any]], state_name: str) -> None:
    directory = TASK_ROOT / state_name
    if not directory.is_dir():
        return
    for path in sorted(directory.glob("TASK-*.yaml")):
        doc = load_yaml(path)
        task_id = str(doc.get("task_id") or path.stem)
        heartbeat = doc.get("heartbeat_at") or doc.get("updated_at")
        heartbeat_age = age_seconds(heartbeat)
        if state_name == "queued":
            pickup_state = "not_claimed"
        elif state_name == "running":
            pickup_state = "stale" if heartbeat_age is None or heartbeat_age > STALE_SECONDS else "claimed"
        else:
            pickup_state = state_name
        add_request(
            rows,
            request_id=task_id,
            source="operational_task",
            realization="operational_capability_worker",
            pickup_state=pickup_state,
            loop_id=doc.get("loop_id"),
            packet_id=doc.get("packet_id"),
            worker=doc.get("claimed_by"),
            heartbeat_at=heartbeat,
            heartbeat_age_seconds=heartbeat_age,
            route_target=doc.get("route_target"),
            route_capability=doc.get("route_capability"),
            route_prompt_ref=doc.get("route_prompt_ref"),
            bridge_allowed=doc.get("bridge_allowed"),
            payload=normalize_task_payload(doc.get("payload")),
            bridge_proof=doc.get("bridge_proof") if isinstance(doc.get("bridge_proof"), dict) else None,
            task=str(doc.get("summary") or "")[:180],
            result=doc.get("result"),
            failure_reason=doc.get("failure_reason"),
            updated_at=doc.get("updated_at"),
        )


def _db_authority_block() -> dict[str, Any]:
    block = load_yaml(RUNTIME_BOOTSTRAP_CONTRACT).get("db_authority")
    return block if isinstance(block, dict) else {}


def _local_hostname() -> str:
    try:
        proc = subprocess.run(
            ["hostname", "-s"], capture_output=True, text=True, timeout=2, check=False
        )
        if proc.returncode == 0:
            return proc.stdout.strip()
    except Exception:
        pass
    try:
        return subprocess.check_output(["hostname"], text=True, timeout=2).strip()
    except Exception:
        return ""


def canonical_plane_access_role() -> str:
    """Derive the canonical_plane_access role of the host running this cap.

    Reads the same db_authority signal `_canonical_fetch_target` reads:
    - 'authority_local' reason → storage_evidence_node (this host owns canonical)
    - hostname matches ai-consolidation pattern → execution_host
    - everything else → operator_console

    Three roles are sufficient for the surfaces that consume this readback;
    watcher / forge / translator / verification roles are not pickup consumers.
    """
    _target, reason = _canonical_fetch_target()
    if reason == "authority_local":
        return "storage_evidence_node"
    host = _local_hostname().lower()
    if host.startswith("ai-cons") or "ai-consolidation" in host:
        return "execution_host"
    return "operator_console"


def _canonical_fetch_target() -> tuple[dict[str, str], str]:
    """Return ({host_ref, remote_root}, reason).

    reason is one of:
      - 'fetch'             : target valid; do canonical fetch
      - 'authority_local'   : this host IS the canonical authority; no fetch needed
      - 'disabled_env'      : EXECUTION_PICKUP_DISABLE_CANONICAL_FETCH=1
      - 'disabled_contract' : db_authority disabled or contract missing
      - 'no_host'           : contract enabled but host_ref unresolved
    """
    if LOCAL_CANONICAL_FETCH_DISABLE:
        return {}, "disabled_env"
    block = _db_authority_block()
    if not block or block.get("enabled") is not True:
        return {}, "disabled_contract"
    authority_hostnames = block.get("authority_hostnames") or []
    if not isinstance(authority_hostnames, list):
        authority_hostnames = []
    if _local_hostname() in {str(h) for h in authority_hostnames}:
        return {}, "authority_local"
    host_ref = str(block.get("host") or block.get("host_addr_lan") or "").strip()
    if not host_ref:
        return {}, "no_host"
    return {"host_ref": host_ref, "remote_root": CANONICAL_TASK_ROOT_DEFAULT}, "fetch"


def load_remote_yaml_dir(host_ref: str, remote_dir: str) -> tuple[list[dict[str, Any]], str]:
    """SSH to host_ref, list TASK-*.yaml under remote_dir, return (docs, status).

    status: 'ok' on success (possibly empty list); 'unreachable' on SSH/parse failure.
    Reuses the ssh-resolve helper used by load_remote_json so identity/key/host
    resolution stays consistent with the existing remote-readback pattern.
    """
    if not host_ref or not remote_dir or not SSH_RESOLVER.is_file():
        return [], "unreachable"
    script = f'''
set -euo pipefail
source {shlex.quote(str(SSH_RESOLVER))}
target={shlex.quote(host_ref)}
dir={shlex.quote(remote_dir)}
resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 3 | awk '{{print $1}}')"
user="$(ssh_resolve_user "$target" ubuntu)"
identity_opts="$(ssh_resolve_machine_identity_opts "$target" 2>/dev/null || true)"
ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null $identity_opts "$user@$resolved" \
    "for f in \\"$dir\\"/TASK-*.yaml; do [ -f \\"\\$f\\" ] || continue; echo '---'; cat \\"\\$f\\"; done"
'''
    try:
        proc = subprocess.run(
            ["bash", "-lc", script],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except Exception:
        return [], "unreachable"
    if proc.returncode != 0:
        return [], "unreachable"
    text = proc.stdout
    if not text.strip():
        return [], "ok"
    try:
        docs = list(yaml.safe_load_all(text))
    except Exception:
        return [], "unreachable"
    return [d for d in docs if isinstance(d, dict)], "ok"


def _add_task_row(rows: list[dict[str, Any]], doc: dict[str, Any], state_name: str, source_locality: str) -> None:
    task_id = str(doc.get("task_id") or "")
    if not task_id:
        return
    heartbeat = doc.get("heartbeat_at") or doc.get("updated_at")
    heartbeat_age = age_seconds(heartbeat)
    if state_name == "queued":
        pickup_state = "not_claimed"
    elif state_name == "running":
        pickup_state = "stale" if heartbeat_age is None or heartbeat_age > STALE_SECONDS else "claimed"
    else:
        pickup_state = state_name
    add_request(
        rows,
        request_id=task_id,
        source="operational_task",
        realization="operational_capability_worker",
        pickup_state=pickup_state,
        loop_id=doc.get("loop_id"),
        packet_id=doc.get("packet_id"),
        worker=doc.get("claimed_by"),
        heartbeat_at=heartbeat,
        heartbeat_age_seconds=heartbeat_age,
        route_target=doc.get("route_target"),
        route_capability=doc.get("route_capability"),
        route_prompt_ref=doc.get("route_prompt_ref"),
        bridge_allowed=doc.get("bridge_allowed"),
        payload=normalize_task_payload(doc.get("payload")),
        bridge_proof=doc.get("bridge_proof") if isinstance(doc.get("bridge_proof"), dict) else None,
        task=str(doc.get("summary") or "")[:180],
        result=doc.get("result"),
        failure_reason=doc.get("failure_reason"),
        updated_at=doc.get("updated_at"),
        task_source=source_locality,
    )


def collect_operational_tasks(rows: list[dict[str, Any]]) -> tuple[str, int]:
    """Merge local + canonical task envelopes; canonical wins on dedupe.

    Returns (canonical_status, canonical_row_count) for summary surfacing:
      - 'authority_local'   : running on the canonical authority host; local IS canonical
      - 'merged'            : fetched canonical via SSH and merged with local (canonical preferred)
      - 'unreachable'       : canonical fetch attempted but failed; local-only fallback
      - 'disabled'          : canonical fetch disabled via env or contract
    """
    target, reason = _canonical_fetch_target()
    canonical_rows = 0
    canonical_status = reason
    seen: dict[str, str] = {}

    if reason == "fetch" and target:
        merged_any = False
        canonical_status = "unreachable"
        for state_name in ("queued", "running", "done", "failed"):
            remote_dir = f"{target['remote_root']}/{state_name}"
            docs, fetch_status = load_remote_yaml_dir(target["host_ref"], remote_dir)
            if fetch_status == "ok":
                merged_any = True
                for doc in docs:
                    task_id = str(doc.get("task_id") or "")
                    if not task_id or task_id in seen:
                        continue
                    seen[task_id] = "canonical"
                    _add_task_row(rows, doc, state_name, "canonical")
                    canonical_rows += 1
        if merged_any:
            canonical_status = "merged"

    for state_name in ("queued", "running", "done", "failed"):
        directory = TASK_ROOT / state_name
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("TASK-*.yaml")):
            doc = load_yaml(path)
            task_id = str(doc.get("task_id") or path.stem)
            if task_id in seen:
                continue
            seen[task_id] = "local"
            _add_task_row(rows, doc, state_name, "local")

    return canonical_status, canonical_rows


def worker_status() -> dict[str, Any]:
    candidates = [
        TASK_ROOT / "mailroom-task-worker.status.json",
        STATE_ROOT / "mailroom-task-worker.status.json",
    ]
    payloads = [load_json(path) | {"path": str(path)} for path in candidates if path.is_file()]
    proof_channel = mailroom_worker_proof_channel()
    remote_payload = load_remote_json(
        str(proof_channel.get("host") or ""),
        str(proof_channel.get("path") or ""),
    )
    if remote_payload:
        payloads.append(remote_payload | {
            "path": str(proof_channel.get("path") or ""),
            "host": str(proof_channel.get("host") or ""),
        })
    freshest: dict[str, Any] = {}
    freshest_age: int | None = None
    for payload in payloads:
        timestamp = payload.get("generated_at")
        current_age = age_seconds(timestamp)
        if freshest_age is None or (current_age is not None and current_age < freshest_age):
            freshest = payload
            freshest_age = current_age
    if not freshest:
        return {"status": "missing", "fresh": False}
    fresh = freshest_age is not None and freshest_age <= STALE_SECONDS
    return {
        "status": freshest.get("status") or "recorded",
        "fresh": fresh,
        "generated_at": freshest.get("generated_at"),
        "age_seconds": freshest_age,
        "worker_id": freshest.get("worker_id") or ((freshest.get("data") or {}).get("worker_id") if isinstance(freshest.get("data"), dict) else ""),
        "path": freshest.get("path"),
    }


def summarize(rows: list[dict[str, Any]]) -> dict[str, Any]:
    active_rows = [row for row in rows if row.get("pickup_state") not in TERMINAL_TASK_STATES]
    safety_tiers = {tier: 0 for tier in SAFETY_TIERS}
    for row in rows:
        tier = str(row.get("safety_tier") or "").strip()
        if tier not in safety_tiers:
            safety_tiers[tier] = 0
        safety_tiers[tier] += 1
    delivered_v2_1 = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "tool_using_agent_v2_1_readonly_repo"
        for row in rows
    )
    delivered_v2_2 = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "tool_using_agent_v2_2_readonly_capability_calls"
        for row in rows
    )
    delivered_v2_3 = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "tool_using_agent_v2_3_fenced_artifact_write"
        for row in rows
    )
    delivered_v2_4 = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "tool_using_agent_v2_4_patch_artifact"
        for row in rows
    )
    delivered_v2_5 = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "tool_using_agent_v2_5_patch_apply_sandbox"
        for row in rows
    )
    delivered_bridge = any(
        row.get("pickup_state") == "done"
        and str(row.get("route_target") or "").strip().lower() == "agent_tool"
        and isinstance(row.get("bridge_proof"), dict)
        and (row.get("bridge_proof") or {}).get("status") == "completed"
        and (row.get("bridge_proof") or {}).get("scope") == "bounded_readonly_provider_agent"
        for row in rows
    )
    ai_agent_bridge = "not_delivered"
    if delivered_bridge:
        ai_agent_bridge = "delivered (bounded: readonly provider agent)"
    if delivered_v2_1:
        ai_agent_bridge = "delivered (tool-using: read-only repo inspection)"
    if delivered_v2_2:
        ai_agent_bridge = "delivered (tool-using: read-only capability calls)"
    if delivered_v2_3:
        ai_agent_bridge = "delivered (tool-using: fenced artifact write)"
    if delivered_v2_4:
        ai_agent_bridge = "delivered (tool-using: patch artifact generation)"
    if delivered_v2_5:
        ai_agent_bridge = "delivered (tool-using: patch apply sandbox)"
    patch_review = {
        "needs_controller_review": 0,
        "review_worktree_active": 0,
        "review_artifact_retained": 0,
        "rejected_by_controller": 0,
        "merged_by_controller": 0,
        "superseded": 0,
        "stale": 0,
        "other": 0,
    }
    for row in rows:
        if row.get("safety_tier") != "tool_using_agent_v2_5_patch_apply_sandbox" or row.get("pickup_state") != "done":
            continue
        state = str(row.get("review_state") or "needs_controller_review")
        if state in patch_review:
            patch_review[state] += 1
        else:
            patch_review["other"] += 1
    return {
        "requests_total": len(active_rows),
        "not_claimed": sum(1 for row in active_rows if row.get("pickup_state") == "not_claimed"),
        "claimed_or_running": sum(1 for row in active_rows if row.get("pickup_state") == "claimed"),
        "stale": sum(1 for row in active_rows if row.get("pickup_state") == "stale"),
        "done_recent": sum(1 for row in rows if row.get("pickup_state") == "done"),
        "failed_recent": sum(1 for row in rows if row.get("pickup_state") == "failed"),
        "wave_dispatch_request_only": sum(1 for row in active_rows if row.get("realization") == "wave_dispatch_request_only"),
        "operational_capability_worker": sum(1 for row in active_rows if row.get("realization") == "operational_capability_worker"),
        "interactive_worker_handoff": sum(1 for row in active_rows if row.get("realization") == "interactive_worker_handoff"),
        "ai_agent_bridge": ai_agent_bridge,
        "safety_tiers": safety_tiers,
        "patch_review": patch_review,
    }


def collect() -> dict[str, Any]:
    rows: list[dict[str, Any]] = []
    collect_wave_dispatches(rows)
    collect_delegations(rows)
    canonical_status, canonical_rows = collect_operational_tasks(rows)
    rows.sort(key=lambda row: (str(row.get("pickup_state")), str(row.get("request_id"))))
    summary = summarize(rows)
    summary["canonical_task_source"] = canonical_status
    summary["canonical_task_rows"] = canonical_rows
    role = canonical_plane_access_role()
    return {
        "capability": "execution.pickup.status",
        "generated_at": now_utc().strftime("%Y-%m-%dT%H:%M:%SZ"),
        "canonical_plane_access_role": role,
        "plane_access_source": f"{CANONICAL_PLANE_ACCESS_BINDING}.{role}",
        "canonical_queue_source": canonical_status,
        "summary": summary,
        "worker": worker_status(),
        "requests": rows,
        "subtraction": {
            "public_language": "execution pickup",
            "kernel_translation": {
                "request": "queued or dispatched execution request",
                "claim": "worker custody, never role/admission/placement authority",
                "heartbeat": "task/worker liveness only",
                "result_failure": "terminal task outcome",
                "receipt": "linked governed run key or close receipt when present",
            },
            "expert_drilldowns": [
                "delegation.status",
                "orchestration.wave.status",
                "wave.execute.status",
                "internal task lifecycle",
            ],
            "demoted_public_terms": [
                "mailroom lane",
                "mailroom bridge",
                "dispatch means executing",
            ],
        },
    }


def render_human(data: dict[str, Any]) -> None:
    summary = data["summary"]
    worker = data["worker"]
    print("execution.pickup.status")
    print()
    role = data.get("canonical_plane_access_role") or "unknown"
    source = data.get("plane_access_source") or ""
    print(f"  plane access role: {role}")
    if source:
        print(f"  plane access source: {source}")
    print()
    print(f"  requests:          {summary['requests_total']} active")
    print(f"  not claimed:       {summary['not_claimed']}")
    print(f"  claimed/running:   {summary['claimed_or_running']}")
    print(f"  stale:             {summary['stale']}")
    print(f"  done recent:       {summary['done_recent']}")
    print(f"  failed recent:     {summary['failed_recent']}")
    print(f"  AI agent bridge:   {summary['ai_agent_bridge']}")
    safety_tiers = summary.get("safety_tiers") if isinstance(summary.get("safety_tiers"), dict) else {}
    if safety_tiers:
        realized = ", ".join(f"{key}={value}" for key, value in safety_tiers.items() if value)
        print(f"  safety tiers:      {realized or 'none active/recent'}")
    worker_line = worker.get("status", "unknown")
    if worker.get("generated_at"):
        worker_line += f" ({worker.get('generated_at')}, age={worker.get('age_seconds')}s)"
    print(f"  capability worker: {worker_line}")
    canonical_status = str(summary.get("canonical_task_source") or "unknown")
    canonical_rows = summary.get("canonical_task_rows") or 0
    if canonical_status == "merged":
        print(f"  canonical queue:   merged ({canonical_rows} canonical rows)")
    elif canonical_status == "authority_local":
        print(f"  canonical queue:   authority_local (this host owns canonical)")
    elif canonical_status == "unreachable":
        print(f"  canonical queue:   unreachable — local-only fallback (set EXECUTION_PICKUP_DISABLE_CANONICAL_FETCH=1 to suppress this attempt)")
    elif canonical_status == "disabled_env":
        print(f"  canonical queue:   disabled_env (EXECUTION_PICKUP_DISABLE_CANONICAL_FETCH=1)")
    elif canonical_status == "disabled_contract":
        print(f"  canonical queue:   disabled_contract (db_authority off or contract missing)")
    elif canonical_status == "no_host":
        print(f"  canonical queue:   no_host (db_authority enabled but host_ref unresolved)")
    print()
    rows = [row for row in data["requests"] if row.get("pickup_state") not in TERMINAL_TASK_STATES]
    if rows:
        print(f"{'STATE':14s} {'SOURCE':18s} {'REQUEST':34s} DETAIL")
        print("-" * 96)
        for row in rows:
            request_id = str(row.get("request_id") or "")[:34]
            kernel = f"{(row.get('claim_state') or {}).get('status','?')}/{(row.get('heartbeat_state') or {}).get('status','?')}/{(row.get('outcome_state') or {}).get('status','?')}"
            detail = row.get("task") or row.get("route_capability") or row.get("packet_id") or ""
            print(f"{str(row.get('pickup_state'))[:14]:14s} {str(row.get('source'))[:18]:18s} {request_id:34s} {kernel:24s} {str(detail)[:60]}")
    else:
        print("  no active execution requests")
    print()
    print("Drilldown: delegation.status | orchestration.wave.status | wave.execute.status | internal task lifecycle")


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only execution pickup status.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args()

    data = collect()
    if args.self_check:
        dispatch_only = [
            row for row in data["requests"]
            if row.get("source") == "wave_dispatch" and row.get("realization") == "wave_dispatch_request_only"
        ]
        for row in dispatch_only:
            if row.get("pickup_state") != "not_claimed":
                print("execution.pickup.status self-check FAIL: dispatch-only row rendered as claimed", file=os.sys.stderr)
                return 1
        print("execution.pickup.status self-check PASS")
        return 0

    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        render_human(data)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
