#!/usr/bin/env python3
"""standing-program-drift-check — evaluate bounded V1 standing-program drift."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import standing_program_exception_v1 as spx


HEALTH_SYMBOLS = {
    "healthy": "[OK]",
    "stale": "[STALE]",
    "failed": "[FAIL]",
    "unreachable": "[UNREACH]",
    "unknown": "[?]",
}


def _human_age(seconds: int | None) -> str:
    if seconds is None:
        return "-"
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


def _build_summary(results: list[dict]) -> dict[str, int]:
    summary = {
        "total": len(results),
        "healthy": 0,
        "stale": 0,
        "failed": 0,
        "unreachable": 0,
        "unknown": 0,
        "drift_present": 0,
        "intervention_ready": 0,
    }
    for row in results:
        health = str(row.get("health") or "unknown")
        if health in summary:
            summary[health] += 1
        else:
            summary["unknown"] += 1
        if row.get("drift_present"):
            summary["drift_present"] += 1
        if row.get("enabled_trigger_types"):
            summary["intervention_ready"] += 1
    return summary


def _print_table(results: list[dict], summary: dict[str, int]) -> None:
    print("standing-program-drift-check")
    print()
    if not results:
        print("  No V1 standing-program specimens found.")
        return

    fmt = "  {:<42s} {:<10s} {:<24s} {:<12s} {}"
    print(fmt.format("LABEL", "HEALTH", "ENABLED TRIGGERS", "AGE", "DETAIL"))
    print(fmt.format("-" * 42, "-" * 10, "-" * 24, "-" * 12, "-" * 32))

    for row in results:
        label = str(row.get("label") or "")
        health = HEALTH_SYMBOLS.get(str(row.get("health") or "unknown"), "[?]")
        triggers = ",".join(row.get("enabled_trigger_types") or []) or "none"
        age = _human_age(row.get("staleness_seconds"))
        detail = str(row.get("detail") or "")
        print(fmt.format(label[:42], health, triggers[:24], age, detail))
        active = list(row.get("active_trigger_types") or [])
        if active:
            print(f"    active: {', '.join(active)}")

    print()
    print(
        f"  Summary: {summary['total']} specimen(s) — "
        f"{summary['healthy']} healthy, {summary['stale']} stale, "
        f"{summary['failed']} failed, {summary['unreachable']} unreachable, "
        f"{summary['drift_present']} drifting"
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Evaluate bounded V1 standing-program drift via accepted proof surfaces."
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output as JSON.",
    )
    parser.add_argument(
        "--label",
        action="append",
        default=[],
        help="Evaluate one bounded V1 label. Repeat to check both explicitly.",
    )
    args = parser.parse_args()

    try:
        labels = spx.v1_labels(args.label or None)
        results = spx.evaluate_labels(labels)
    except Exception as exc:
        if args.json:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"standing-program-drift-check FAIL: {exc}", file=sys.stderr)
        return 1

    summary = _build_summary(results)
    if args.json:
        print(json.dumps({
            "evaluated_at_utc": spx.utc_now(),
            "labels": labels,
            "programs": results,
            "summary": summary,
        }, indent=2))
    else:
        _print_table(results, summary)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
