#!/usr/bin/env python3
"""open-set-snapshot — Generate a single-file view of the current open set.

Reads active/open loops from the joined runtime loop view when available,
falling back to SQLite-only loop authority, and reads open gaps from SQLite
authority.
Writes a YAML snapshot to $SPINE_STATE/open-set-snapshot.yaml and prints it.

This is a read-only diagnostic. It creates no new obligations.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import gaps_sql_authority as gsa


def resolve_root() -> Path:
    candidate = SCRIPT_DIR
    for _ in range(10):
        if (candidate / "ops" / "bindings").exists():
            return candidate
        candidate = candidate.parent
    raise RuntimeError("Cannot resolve SPINE_ROOT")


def resolve_state_root(root: Path) -> Path:
    return Path(
        os.environ.get("SPINE_STATE")
        or str(root.parent / ".runtime" / "spine" / "state")
    )


def read_active_loops(root: Path) -> list[dict]:
    """Read active loops from SQLite authority only."""
    import loops_sql_authority as lsa

    db_path, _ = lsa.resolve_paths(root)
    conn = lsa.connect(db_path)
    lsa.ensure_schema(conn)
    all_loops = lsa.list_loops(conn, status="all")
    conn.close()
    loops = []
    for loop in all_loops:
        status = str(loop.get("status") or "").lower()
        if status not in ("active", "open"):
            continue
        loops.append({
            "loop_id": loop.get("loop_id", ""),
            "status": status,
            "owner": loop.get("owner", ""),
            "scope": loop.get("scope", ""),
            "priority": loop.get("priority", ""),
            "objective": str(loop.get("objective") or "")[:120],
            "next_action": str(loop.get("next_action") or "")[:120] or None,
        })
    return loops


def read_joined_active_loops(root: Path) -> list[dict] | None:
    """Read active loops from the canonical joined runtime view."""
    joined_bin = root / "ops" / "plugins" / "core" / "lifecycle" / "bin" / "spine-engine-joined-state"
    if not joined_bin.exists():
        return None
    try:
        proc = subprocess.run(
            [str(joined_bin), "--json", "--no-write"],
            cwd=str(root),
            text=True,
            capture_output=True,
            check=False,
            timeout=20,
        )
    except Exception:
        return None
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None

    raw_loops = ((payload.get("loops") or {}).get("open")) or []
    if not isinstance(raw_loops, list):
        return None

    loops = []
    for row in raw_loops:
        if not isinstance(row, dict):
            continue
        loop_id = str(row.get("loop_id") or "").strip()
        if not loop_id:
            continue
        loops.append({
            "loop_id": loop_id,
            "status": str(row.get("status") or "").strip().lower(),
            "owner": str(row.get("owner") or "").strip(),
            "scope": str(row.get("scope") or "").strip(),
            "priority": str(row.get("priority") or "").strip(),
            "objective": str(row.get("objective") or "")[:120],
            "next_action": str(row.get("next_action") or "")[:120] or None,
        })
    return loops


def read_open_gaps(root: Path) -> list[dict]:
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    cursor = conn.execute(
        "SELECT gap_id, title, severity, status, parent_loop, description "
        "FROM gaps WHERE status = 'open' ORDER BY gap_id"
    )
    gaps = []
    for row in cursor.fetchall():
        desc = str(row[5] or "")
        first_line = desc.split("\n")[0][:120] if desc else ""
        gaps.append({
            "gap_id": row[0],
            "title": row[1] or first_line,
            "severity": row[2],
            "parent_loop": row[4],
            "summary": first_line,
        })
    conn.close()
    return gaps


def main() -> int:
    root = resolve_root()
    state_root = resolve_state_root(root)
    posture = os.environ.get("SPINE_EXECUTION_POSTURE", "discover")

    loops = read_joined_active_loops(root) or read_active_loops(root)
    gaps = read_open_gaps(root)

    snapshot = {
        "generated_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "execution_posture": posture,
        "summary": {
            "active_loops": len(loops),
            "open_gaps": len(gaps),
        },
        "active_loops": loops,
        "open_gaps": gaps,
    }

    output_path = state_root / "open-set-snapshot.yaml"
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(
        yaml.dump(snapshot, default_flow_style=False, sort_keys=False, allow_unicode=True),
        encoding="utf-8",
    )

    if "--json" in sys.argv:
        print(json.dumps(snapshot, indent=2))
    else:
        print(yaml.dump(snapshot, default_flow_style=False, sort_keys=False, allow_unicode=True), end="")
        print(f"\nWritten to: {output_path}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
