#!/usr/bin/env bash
set -euo pipefail

# gaps.projection.commit — Project SQLite gap authority to YAML and commit
# with D75-required trailers.
#
# This capability bridges the gap between SQLite-authority mutations (which
# happen via gaps.file/gaps.close) and the on-disk YAML projection that D75
# enforces commit trailers on. Without this, any time the YAML drifts from
# SQLite (e.g. after bulk mutations, migrations, or reconcile passes), the
# projection commit would lack the required Gap-* trailers and D75 would fail.
#
# Usage:
#   gaps-projection-commit [--dry-run]
#
# What it does:
#   1. Runs gaps-authority-bridge project to regenerate operational.gaps.yaml
#   2. Checks if the file actually changed (git diff)
#   3. If changed, stages and commits with the 3 required D75 trailers:
#        Gap-Mutation: projection
#        Gap-Capability: gaps.projection.commit
#        Gap-Run-Key: <auto-generated>
#   4. If no changes, exits cleanly with a message
#
# Requires:
#   - Clean working tree (no unrelated staged/unstaged changes)
#   - OPS_GOVERNED_MAIN_OVERRIDE=1 if committing to main

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/git-lock.sh"
GAPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/gaps-authority-bridge"
GAPS_FILE_REL="ops/bindings/operational.gaps.yaml"
GAPS_FILE="$ROOT/$GAPS_FILE_REL"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help)
      echo "Usage: gaps-projection-commit [--dry-run]"
      echo ""
      echo "Project SQLite gap authority to YAML and commit with D75 trailers."
      echo "If no drift exists, exits cleanly."
      exit 0
      ;;
    *) echo "FAIL: unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ -x "$GAPS_BRIDGE" ]] || fail "gaps authority bridge not found: $GAPS_BRIDGE"
[[ -f "$GAPS_FILE" ]] || fail "gap registry not found: $GAPS_FILE"
command -v python3 >/dev/null 2>&1 || fail "python3 required"

# ── Step 1: Run projection ──
echo "Running gaps-authority-bridge project..." >&2
project_output="$(python3 "$GAPS_BRIDGE" project 2>&1)" || fail "projection failed: $project_output"
echo "$project_output" >&2

# ── Step 2: Check for changes ──
if git -C "$ROOT" diff --quiet -- "$GAPS_FILE_REL" 2>/dev/null; then
  echo "gaps.projection.commit: no drift — YAML already matches SQLite authority"
  exit 0
fi

echo "Drift detected in $GAPS_FILE_REL" >&2

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "gaps.projection.commit: DRY_RUN — would commit the following changes:" >&2
  git -C "$ROOT" diff --stat -- "$GAPS_FILE_REL"
  exit 0
fi

# ── Step 3: Preflight — no unrelated changes ──
porcelain="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
unrelated="$(printf '%s\n' "$porcelain" | grep -v "^ M $GAPS_FILE_REL" | grep -v "^$" || true)"
if [[ -n "$unrelated" ]]; then
  fail "working tree has unrelated changes — commit or stash first:
$unrelated"
fi

# ── Step 4: Acquire lock, stage, commit with trailers ──
acquire_git_lock gaps || fail "unable to acquire git.gaps.lock"
trap 'release_git_lock' EXIT INT TERM

RUN_KEY="${SPINE_CAP_RUN_KEY:-CAP-projection-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

git -C "$ROOT" add "$GAPS_FILE_REL"

OPS_GOVERNED_MAIN_OVERRIDE="${OPS_GOVERNED_MAIN_OVERRIDE:-1}" \
  git -C "$ROOT" commit -m "$(cat <<EOF
chore(gaps): project SQLite authority to YAML

Regenerate $GAPS_FILE_REL from SQLite gap authority.
Projected at $TIMESTAMP.

Gap-Mutation: projection
Gap-Capability: gaps.projection.commit
Gap-Run-Key: $RUN_KEY
EOF
)"

echo "gaps.projection.commit: committed projection (run_key=$RUN_KEY)"
