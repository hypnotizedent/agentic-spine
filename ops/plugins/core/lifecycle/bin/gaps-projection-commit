#!/usr/bin/env bash
set -euo pipefail

# gaps.projection.commit — Project SQLite gap authority to YAML and commit
# with the D75 trailer schema from the shared-authority mutation contract.
#
# This capability bridges the gap between SQLite-authority mutations (which
# happen via gaps.file/gaps.close) and the on-disk YAML projection that D75
# enforces commit trailers on. Without this, any time the YAML drifts from
# SQLite (e.g. after bulk mutations, migrations, or reconcile passes), the
# projection commit would lack the required Gap-* trailers and D75 would fail.
#
# Usage:
#   gaps-projection-commit [--dry-run]
#
# What it does:
#   1. Runs gaps-authority-bridge project to regenerate operational.gaps.yaml
#   2. Checks if the file actually changed (git diff)
#   3. If changed, stages and commits with the D75 trailers defined in
#      shared-authority.mutation.contract.yaml
#   4. If no changes, exits cleanly with a message
#
# Requires:
#   - Clean working tree (no unrelated staged/unstaged changes)
#   - OPS_GOVERNED_MAIN_OVERRIDE=1 if committing to main

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/git-lock.sh"
CONTRACT_FILE="$ROOT/ops/bindings/shared-authority.mutation.contract.yaml"
GAPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/gaps-authority-bridge"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help)
      echo "Usage: gaps-projection-commit [--dry-run]"
      echo ""
      echo "Project SQLite gap authority to YAML and commit with D75 trailers."
      echo "If no drift exists, exits cleanly."
      exit 0
      ;;
    *) echo "FAIL: unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ -x "$GAPS_BRIDGE" ]] || fail "gaps authority bridge not found: $GAPS_BRIDGE"
[[ -f "$CONTRACT_FILE" ]] || fail "shared-authority mutation contract not found: $CONTRACT_FILE"
command -v yq >/dev/null 2>&1 || fail "yq required"
command -v python3 >/dev/null 2>&1 || fail "python3 required"

GAPS_FILE_REL="$(yq e -r '.gap_projection_enforcement.active_projection // ""' "$CONTRACT_FILE")"
ARCHIVE_FILE_REL="$(yq e -r '.gap_projection_enforcement.archive_projection // ""' "$CONTRACT_FILE")"
PROJECTION_MUTATION="$(yq e -r '.gap_projection_enforcement.projection_commit.mutation // ""' "$CONTRACT_FILE")"
PROJECTION_CAPABILITY="$(yq e -r '.gap_projection_enforcement.projection_commit.capability // ""' "$CONTRACT_FILE")"
GAPS_FILE="$ROOT/$GAPS_FILE_REL"
ARCHIVE_FILE="$ROOT/$ARCHIVE_FILE_REL"

[[ -n "$GAPS_FILE_REL" ]] || fail "active gap projection path missing in contract"
[[ -n "$ARCHIVE_FILE_REL" ]] || fail "archive gap projection path missing in contract"
[[ -n "$PROJECTION_MUTATION" ]] || fail "projection mutation trailer value missing in contract"
[[ -n "$PROJECTION_CAPABILITY" ]] || fail "projection capability trailer value missing in contract"
[[ -f "$GAPS_FILE" ]] || fail "gap registry not found: $GAPS_FILE"

# ── Step 1: Run projection ──
echo "Running gaps-authority-bridge project..." >&2
project_output="$(python3 "$GAPS_BRIDGE" project 2>&1)" || fail "projection failed: $project_output"
echo "$project_output" >&2

# ── Step 2: Check for changes ──
gaps_changed=0
archive_changed=0

# Check active projection for modifications
git -C "$ROOT" diff --quiet -- "$GAPS_FILE_REL" 2>/dev/null || gaps_changed=1

# Check archive projection for modifications OR untracked status
if [[ -f "$ARCHIVE_FILE" ]]; then
  if git -C "$ROOT" ls-files --error-unmatch "$ARCHIVE_FILE_REL" >/dev/null 2>&1; then
    # Archive is tracked, check if modified
    git -C "$ROOT" diff --quiet -- "$ARCHIVE_FILE_REL" 2>/dev/null || archive_changed=1
  else
    # Archive is untracked (newly created)
    archive_changed=1
  fi
fi

if [[ "$gaps_changed" -eq 0 && "$archive_changed" -eq 0 ]]; then
  echo "gaps.projection.commit: no drift — YAML already matches SQLite authority"
  exit 0
fi

changed_files=()
[[ "$gaps_changed" -eq 1 ]] && changed_files+=("$GAPS_FILE_REL")
[[ "$archive_changed" -eq 1 ]] && changed_files+=("$ARCHIVE_FILE_REL")
echo "Drift detected in: ${changed_files[*]}" >&2

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "gaps.projection.commit: DRY_RUN — would commit the following changes:" >&2
  git -C "$ROOT" diff --stat -- "${changed_files[@]}"
  exit 0
fi

# ── Step 3: Preflight — no unrelated changes ──
porcelain="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
unrelated="$(printf '%s\n' "$porcelain" | grep -v "^ M $GAPS_FILE_REL" | grep -v "^ M $ARCHIVE_FILE_REL" | grep -v "^?? $ARCHIVE_FILE_REL" | grep -v "^$" || true)"
if [[ -n "$unrelated" ]]; then
  fail "working tree has unrelated changes — commit or stash first:
$unrelated"
fi

# ── Step 4: Acquire lock, stage, commit with trailers ──
if [[ "${GAPS_PROJECTION_COMMIT_SKIP_LOCK:-0}" != "1" ]]; then
  acquire_git_lock gaps || fail "unable to acquire git.gaps.lock"
fi

staged_projection=0
projection_commit_completed=0
cleanup_projection_commit() {
  local rc=$?
  if [[ "$staged_projection" -eq 1 && "$projection_commit_completed" -ne 1 ]]; then
    git -C "$ROOT" restore --staged -- "${changed_files[@]}" >/dev/null 2>&1 || \
      git -C "$ROOT" reset -q HEAD -- "${changed_files[@]}" >/dev/null 2>&1 || true
  fi
  if [[ "${GAPS_PROJECTION_COMMIT_SKIP_LOCK:-0}" != "1" ]]; then
    release_git_lock
  fi
  exit "$rc"
}
trap cleanup_projection_commit EXIT INT TERM

RUN_KEY="${SPINE_CAP_RUN_KEY:-CAP-projection-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Stage both projection files (active + archive)
for file in "${changed_files[@]}"; do
  git -C "$ROOT" add "$file"
done
staged_projection=1

OPS_GOVERNED_MAIN_OVERRIDE="${OPS_GOVERNED_MAIN_OVERRIDE:-1}" \
  git -C "$ROOT" commit -m "$(cat <<EOF
chore(gaps): project SQLite authority to YAML

Regenerate gaps projection (active + archive) from SQLite authority.
Files: ${changed_files[*]}
Projected at $TIMESTAMP.

Gap-Mutation: $PROJECTION_MUTATION
Gap-Capability: $PROJECTION_CAPABILITY
Gap-Run-Key: $RUN_KEY
EOF
)"
projection_commit_completed=1

echo "gaps.projection.commit: committed projection (run_key=$RUN_KEY)"
