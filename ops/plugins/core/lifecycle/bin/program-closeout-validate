#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
from typing import Any

import yaml


def expand(path: str | Path) -> Path:
    return Path(os.path.expanduser(os.path.expandvars(str(path)))).resolve()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="program-closeout-validate")
    parser.add_argument("--root", default=None, help="Repo root. Defaults to current checkout.")
    parser.add_argument(
        "--artifact",
        action="append",
        default=[],
        help="Artifact path to validate. May be repeated. Defaults to all ops/bindings/program.closeout.*.yaml files except the contract.",
    )
    parser.add_argument("--brief", action="store_true")
    parser.add_argument("--json", action="store_true")
    return parser.parse_args()


def load_yaml(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle)


def is_nonempty(value: Any) -> bool:
    if value is None:
        return False
    if isinstance(value, str):
        return value.strip() != ""
    if isinstance(value, (list, dict, tuple, set)):
        return len(value) > 0
    return True


def get_nested(data: Any, dotted: str) -> Any:
    current = data
    for segment in dotted.split("."):
        if not isinstance(current, dict) or segment not in current:
            return None
        current = current[segment]
    return current


def display_path(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def main() -> None:
    args = parse_args()
    root = expand(args.root or Path(__file__).resolve().parents[5])
    contract_path = root / "ops/bindings/program.closeout.contract.yaml"
    contract = load_yaml(contract_path)

    artifact_paths: list[Path]
    if args.artifact:
        artifact_paths = [
            expand(path) if Path(path).is_absolute() else (root / path).resolve()
            for path in args.artifact
        ]
    else:
        artifact_paths = sorted(
            path
            for path in (root / "ops/bindings").glob("program.closeout*.yaml")
            if path.name != "program.closeout.contract.yaml"
        )

    errors: list[str] = []
    results: list[dict[str, Any]] = []
    total_findings = 0

    allowed_terminal_states = set(contract["terminal_states"]["allowed"])
    top_level_required = contract["artifact_shape"]["top_level_required"]
    program_required = contract["artifact_shape"]["program_required"]
    finding_common_required = contract["artifact_shape"]["finding_common_required"]
    state_requirements = contract["artifact_shape"]["finding_state_requirements"]
    closure_status_allowed = set(contract["artifact_shape"]["closure_status_allowed"])

    if not artifact_paths:
        errors.append("no program closeout artifacts found")

    for artifact_path in artifact_paths:
        if not artifact_path.exists():
            errors.append(f"{artifact_path}: artifact missing")
            continue

        data = load_yaml(artifact_path) or {}
        artifact_errors: list[str] = []

        for field in top_level_required:
            if not is_nonempty(get_nested(data, field)):
                artifact_errors.append(f"missing top-level field '{field}'")

        program = data.get("program", {})
        for field in program_required:
            if not is_nonempty(program.get(field)):
                artifact_errors.append(f"missing program field '{field}'")

        closure_status = program.get("closure_status")
        if closure_status not in closure_status_allowed:
            artifact_errors.append(
                f"invalid closure_status '{closure_status}' (allowed: {', '.join(sorted(closure_status_allowed))})"
            )

        narrative = program.get("companion_narrative")
        if is_nonempty(narrative):
            narrative_path = (root / str(narrative)).resolve()
            if not narrative_path.exists():
                artifact_errors.append(f"missing companion narrative '{narrative}'")

        in_scope_gate_ids = program.get("in_scope_gate_ids") or []
        if len(in_scope_gate_ids) != len(set(in_scope_gate_ids)):
            artifact_errors.append("program.in_scope_gate_ids contains duplicates")
        in_scope_gate_set = set(in_scope_gate_ids)

        findings = data.get("findings")
        if not isinstance(findings, list) or not findings:
            artifact_errors.append("findings must be a non-empty list")
            findings = []

        seen_gate_ids: set[str] = set()
        for finding in findings:
            if not isinstance(finding, dict):
                artifact_errors.append("each finding must be a mapping")
                continue

            total_findings += 1
            gate_id = finding.get("gate_id")
            terminal_state = finding.get("terminal_state")

            for field in finding_common_required:
                if not is_nonempty(finding.get(field)):
                    artifact_errors.append(f"finding missing '{field}'")

            if gate_id in seen_gate_ids:
                artifact_errors.append(f"duplicate finding for gate '{gate_id}'")
            elif is_nonempty(gate_id):
                seen_gate_ids.add(str(gate_id))

            if is_nonempty(gate_id) and gate_id not in in_scope_gate_set:
                artifact_errors.append(f"finding gate_id '{gate_id}' is not declared in program.in_scope_gate_ids")

            if terminal_state not in allowed_terminal_states:
                artifact_errors.append(
                    f"finding '{gate_id}' uses invalid terminal_state '{terminal_state}' "
                    f"(allowed: {', '.join(sorted(allowed_terminal_states))})"
                )
                continue

            required_fields = state_requirements[terminal_state]["required"]
            for field in required_fields:
                if not is_nonempty(get_nested(finding, field)):
                    artifact_errors.append(
                        f"finding '{gate_id}' missing '{field}' for terminal_state '{terminal_state}'"
                    )

        if closure_status == contract["closed_program_requirements"]["closure_status_must_equal"]:
            missing_gate_ids = sorted(in_scope_gate_set - seen_gate_ids)
            if missing_gate_ids:
                artifact_errors.append(
                    "closed program missing findings for: " + ", ".join(missing_gate_ids)
                )
            if program.get("no_silent_warn_only_residue") is not True:
                artifact_errors.append("closed program must set no_silent_warn_only_residue=true")

        results.append(
            {
                "artifact": display_path(artifact_path, root),
                "findings": len(findings),
                "status": "PASS" if not artifact_errors else "FAIL",
                "errors": artifact_errors,
            }
        )
        errors.extend(f"{display_path(artifact_path, root)}: {issue}" for issue in artifact_errors)

    overall = "PASS" if not errors else "FAIL"

    if args.json:
        print(
            json.dumps(
                {
                    "status": overall.lower(),
                    "artifacts": len(artifact_paths),
                    "findings": total_findings,
                    "results": results,
                },
                indent=2,
                sort_keys=False,
            )
        )
        raise SystemExit(1 if errors else 0)

    if args.brief:
        if errors:
            print(f"FAIL artifacts={len(artifact_paths)} findings={total_findings} issues={len(errors)}")
        else:
            print(f"PASS artifacts={len(artifact_paths)} findings={total_findings} issues=0")
        raise SystemExit(1 if errors else 0)

    if errors:
        for issue in errors:
            print(f"FAIL: {issue}")
        raise SystemExit(1)

    print(
        f"PASS: program closeout artifacts valid "
        f"(artifacts={len(artifact_paths)} findings={total_findings})"
    )


if __name__ == "__main__":
    main()
