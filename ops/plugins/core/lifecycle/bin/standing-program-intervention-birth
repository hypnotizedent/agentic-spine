#!/usr/bin/env python3
"""standing-program-intervention-birth — bounded V1 autonomous exception birth."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import standing_program_exception_v1 as spx


def _normalize_programs(data: Any) -> list[dict[str, Any]]:
    if isinstance(data, list):
        programs = data
    elif isinstance(data, dict) and isinstance(data.get("programs"), list):
        programs = data["programs"]
    else:
        raise ValueError("expected a JSON array or an object with a 'programs' key")

    results: list[dict[str, Any]] = []
    for row in programs:
        if not isinstance(row, dict):
            continue
        label = str(row.get("label") or "").strip()
        if label not in spx.V1_ALLOWED_LABELS:
            raise ValueError(f"label outside bounded V1 lane: {label}")
        results.append(row)
    return results


def build_intervention_record(program: dict[str, Any], trigger_type: str, now: str) -> dict[str, Any]:
    trigger = dict((program.get("trigger_evaluations") or {}).get(trigger_type) or {})
    label = str(program.get("label") or "")
    return {
        "intervention_id": spx.intervention_id(label, trigger_type),
        "created_at": now,
        "last_observed_at": str(program.get("last_evidence_at_utc") or now),
        "disposition": "pending",
        "escalation_state": "packet_only",
        "source_label": label,
        "birth_mode": "standing_program",
        "intended_node_role": str(program.get("intended_node_role") or ""),
        "source_node": str(program.get("source_node") or ""),
        "trigger_type": trigger_type,
        "dedupe_key": spx.dedupe_key(label, trigger_type),
        "evidence_surface": str(trigger.get("evidence_surface") or program.get("evidence_surface") or ""),
        "evidence_ref": str(trigger.get("evidence_ref") or program.get("evidence_ref") or ""),
        "observed_status": str(trigger.get("observed_status") or program.get("observed_status") or ""),
        "observed_counts": dict(trigger.get("observed_counts") or {}),
        "suggested_actions": list(trigger.get("suggested_actions") or []),
        "delegation_state": "not_delegated",
        "delegation_id": None,
        "linked_loop_id": None,
    }


def _load_programs(args: argparse.Namespace) -> list[dict[str, Any]]:
    raw = ""
    if args.drift_json:
        raw = Path(args.drift_json).read_text(encoding="utf-8")
    elif args.stdin or not sys.stdin.isatty():
        raw = sys.stdin.read()

    if raw.strip():
        return _normalize_programs(json.loads(raw))

    labels = spx.v1_labels(args.label or None)
    return spx.evaluate_labels(labels)


def process_programs(
    programs: list[dict[str, Any]],
    *,
    state_root: str,
    dry_run: bool = False,
) -> dict[str, Any]:
    state = spx.load_observation_state(state_root)
    actions: list[str] = []
    birthed = 0
    locked = 0
    healthy = 0
    evaluated = 0
    now = spx.utc_now()

    for program in programs:
        label = str(program.get("label") or "")
        evaluated += 1
        trigger_evaluations = dict(program.get("trigger_evaluations") or {})
        if not trigger_evaluations:
            healthy += 1
            continue

        for trigger_type in spx.V1_ALLOWED_LABELS.get(label, ()):
            trigger = dict(trigger_evaluations.get(trigger_type) or {})
            if not trigger.get("enabled"):
                continue

            key = spx.dedupe_key(label, trigger_type)
            obs = dict(state.get(key) or {})
            existing_path, existing = spx.find_open_intervention(state_root, label, trigger_type)
            condition_met = bool(trigger.get("condition_met"))
            required_observations = int(trigger.get("required_observations", 1) or 1)

            if existing_path is None and obs.get("locked"):
                obs = {}

            if existing_path is not None:
                obs["locked"] = True

            if not condition_met:
                obs["confirmations"] = 0
                obs["last_condition_met"] = False
                if existing_path is None:
                    obs["locked"] = False
                state[key] = obs
                continue

            if existing_path is not None and existing is not None:
                actions.append(
                    f"[{now}] LOCKED: {existing.get('intervention_id', existing_path.stem)}"
                )
                obs["last_condition_met"] = True
                obs["confirmations"] = max(int(obs.get("confirmations", 0) or 0), required_observations)
                state[key] = obs
                locked += 1
                continue

            if required_observations <= 1:
                confirmations = 1
                birth_now = True
            else:
                if obs.get("last_condition_met"):
                    confirmations = int(obs.get("confirmations", 0) or 0) + 1
                else:
                    confirmations = 1
                birth_now = confirmations >= required_observations

            obs["last_condition_met"] = True
            obs["confirmations"] = confirmations

            if not birth_now:
                actions.append(
                    f"[{now}] OBSERVE: {label}::{trigger_type} confirmation {confirmations}/{required_observations}"
                )
                state[key] = obs
                continue

            record = build_intervention_record(program, trigger_type, now)
            path = spx.interventions_dir(state_root) / spx.intervention_filename(label, trigger_type)
            if not dry_run:
                spx.atomic_write_yaml(path, record)

            actions.append(
                f"[{now}] BIRTH: {record['intervention_id']} ({label}::{trigger_type})"
            )
            obs["locked"] = True
            state[key] = obs
            birthed += 1

        if not program.get("drift_present"):
            healthy += 1

    if not dry_run:
        spx.save_observation_state(state_root, state)

    return {
        "evaluated": evaluated,
        "birthed": birthed,
        "locked": locked,
        "healthy": healthy,
        "actions": actions,
        "surface_refresh_recommended": birthed > 0,
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Birth bounded V1 intervention packets for governed standing-program drift."
    )
    parser.add_argument("--dry-run", action="store_true", help="Compute births without writing.")
    parser.add_argument("--drift-json", default=None, help="Read drift-check JSON from a file.")
    parser.add_argument("--stdin", action="store_true", help="Read drift-check JSON from stdin.")
    parser.add_argument(
        "--label",
        action="append",
        default=[],
        help="Restrict evaluation to one bounded V1 label. Repeat for one or more.",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON result.")
    args = parser.parse_args()

    state_root = os.environ.get(
        "SPINE_STATE",
        str(Path.home() / "code" / ".runtime" / "spine" / "state"),
    )

    try:
        programs = _load_programs(args)
        result = process_programs(programs, state_root=state_root, dry_run=args.dry_run)
    except Exception as exc:
        if args.json:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"standing-program-intervention-birth FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        if args.dry_run:
            print("[DRY RUN]")
        for line in result.get("actions", []):
            print(line)
        print(
            f"evaluated={result['evaluated']} birthed={result['birthed']} "
            f"locked={result['locked']} healthy={result['healthy']}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
