#!/usr/bin/env python3
"""controller-prompt-create — CLI for controller_prompt.create capability.

Creates a controller-prompt packet with governed frontmatter and validated
loop binding. One write target only: the packet file.

Exit codes:
  0  success
  1  create failed
  2  invalid arguments
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import controller_prompt_create as cpc


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="controller-prompt-create",
        description="Create a controller-prompt packet with governed frontmatter.",
    )
    parser.add_argument(
        "--packet-id", required=True,
        help="Packet ID (format: PACKET-{NN}-{SLUG})",
    )
    parser.add_argument(
        "--loop-id", required=True,
        help="Loop ID to bind the packet to (must be active)",
    )
    parser.add_argument(
        "--concern", required=True,
        help="One-line description of the packet's concern",
    )
    parser.add_argument(
        "--body-source", default=None,
        help=(
            "Path to file containing packet body (markdown). When invoked via "
            "`bin/ops cap run controller_prompt.create -- --body-source PATH`, "
            "cap.sh resolves PATH on the CONSUMER host, reads it locally, and "
            "transparently rewrites to --body-inline over the routed SSH dispatch. "
            "If the consumer-side path does not exist, cap.sh fails fast with a "
            "consumer-side pointer; if PATH is interpreted on the authority host "
            "(e.g., direct python invocation bypassing cap.sh), the file must "
            "exist on the authority host."
        ),
    )
    parser.add_argument(
        "--body-inline", action="store_true",
        help="Read body from stdin instead of --body-source",
    )
    parser.add_argument(
        "--owner", default="@ronny",
        help="Packet owner (default: @ronny)",
    )
    parser.add_argument(
        "--mutation-permitted", action="store_true", default=False,
        help="Allow mutation (default: false)",
    )
    parser.add_argument(
        "--parent-loop", default="",
        help="Parent loop ID (optional)",
    )
    parser.add_argument(
        "--origin-packet", default="",
        help="Origin packet ID (optional)",
    )
    parser.add_argument(
        "--anti-drift-rule", default="",
        help="Anti-drift constraint (optional)",
    )
    parser.add_argument(
        "--type", default="", dest="packet_type",
        help="Packet subtype (optional)",
    )
    parser.add_argument(
        "--source-ref", default="",
        help="Upstream source reference, such as an OI id or OI field path (optional)",
    )
    parser.add_argument(
        "--human-intent-id", default="",
        help="Human intent id carried from operator ingress when already known (optional)",
    )
    parser.add_argument(
        "--materialization-status", default="",
        help="Known downstream materialization/adoption status at birth (optional)",
    )
    parser.add_argument(
        "--materialization-ref", default="",
        help="Known downstream materialization/adoption ref at birth (optional)",
    )
    parser.add_argument(
        "--allow-sibling",
        action="store_true",
        default=False,
        help=(
            "Allow creating a live packet for a loop that already has a live "
            "controller packet. Requires --sibling-justification unless "
            "--supersedes-packet is supplied."
        ),
    )
    parser.add_argument(
        "--sibling-justification",
        default="",
        help="Operator-visible reason this packet must coexist with another live packet in the same loop.",
    )
    parser.add_argument(
        "--supersedes-packet",
        default="",
        help="Live packet ID in the same loop that this new packet explicitly supersedes.",
    )
    parser.add_argument(
        "--json", action="store_true", dest="json_output",
        help="Emit JSON output",
    )
    parser.add_argument(
        "--self-check", action="store_true",
        help="Verify dependencies and exit",
    )

    # Handle --self-check before full parse (required args not needed)
    if "--self-check" in sys.argv:
        try:
            import controller_prompt_create  # noqa: F401
            import yaml  # noqa: F401
            print("controller_prompt.create self-check PASS")
            return 0
        except ImportError as exc:
            print(f"controller_prompt.create self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    if args.self_check:
        try:
            import controller_prompt_create  # noqa: F401
            import yaml  # noqa: F401
            print("controller_prompt.create self-check PASS")
            return 0
        except ImportError as exc:
            print(f"controller_prompt.create self-check FAIL: {exc}", file=sys.stderr)
            return 1

    spine_state = os.environ.get("SPINE_STATE", "")
    if not spine_state:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"controller_prompt.create FAIL: {msg}", file=sys.stderr)
        return 1

    try:
        result = cpc.create_packet(
            packet_id=args.packet_id,
            loop_id=args.loop_id,
            concern=args.concern,
            state_root=spine_state,
            body_source=args.body_source,
            body_inline=args.body_inline,
            owner=args.owner,
            mutation_permitted=args.mutation_permitted,
            parent_loop=args.parent_loop,
            origin_packet=args.origin_packet,
            anti_drift_rule=args.anti_drift_rule,
            packet_type=args.packet_type,
            source_ref=args.source_ref,
            human_intent_id=args.human_intent_id,
            materialization_status=args.materialization_status,
            materialization_ref=args.materialization_ref,
            allow_sibling=args.allow_sibling,
            sibling_justification=args.sibling_justification,
            supersedes_packet=args.supersedes_packet,
        )
    except cpc.ControllerPromptCreateError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"controller_prompt.create FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"CREATED: {result.get('packet_id', '')}")
        print(f"  path: {result.get('packet_path', '')}")
        print(f"  loop: {result.get('loop_id', '')}")
        print(f"  concern: {result.get('concern', '')}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
