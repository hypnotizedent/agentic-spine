#!/usr/bin/env python3
"""entry-compile — Compile current assignment from existing runtime truth.

Reads canonical authority for active loop, then enriches with execution
tracker and packet artifacts:
  1. Active loop: SQLite shared_authority.db via loops_sql_authority
     (no scope-file fallback — scope files are projections of SQLite,
     not independent policy)
  2. Execution tracker ($SPINE_STATE/controller-prompts/_intake-artifacts/*PACKET-EXECUTION*.md)
  3. Active packet prompt ($SPINE_STATE/controller-prompts/MAILROOM-CONTROLLER-PACKET-<NN>-*.md)

Emits a JSON compiled assignment object to stdout containing:
  loop_id, packet_id, context_sources, active_artifacts,
  stop_condition, mutation_ground, handoff_target

If canonical DB read SUCCEEDED but returned zero open loops, emits
compilation_state: clean_start.

If canonical DB read FAILED (missing/corrupt/unreachable), emits
compilation_state: authority_unavailable with sanitized
authority_error_class. Does NOT silently substitute scope-file projection
as authority. Does NOT collapse "no work" and "broken authority" into
the same downstream state (PACKET-635).

Read-only. Never mutates state.
"""

from __future__ import annotations

import json
import os
import re
import sqlite3
import sys

# ── Constants ────────────────────────────────────────────────────────────

_OPEN_STATUSES = frozenset({"open", "active", "draft"})
_TERMINAL_TRACKER_STATUSES = frozenset({"complete", "closed", "superseded", "archived"})


# ── Helpers ──────────────────────────────────────────────────────────────

def _parse_frontmatter(text: str) -> dict:
    """Extract key: value pairs and lists from YAML frontmatter."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}
    result: dict = {}
    current_list_key: str | None = None
    for line in lines[1:]:
        stripped = line.strip()
        if stripped == "---":
            break
        # List item under a key
        if stripped.startswith("- ") and current_list_key is not None:
            val = stripped[2:].strip().strip('"').strip("'")
            result.setdefault(current_list_key, []).append(val)
            continue
        # Key: value
        colon = stripped.find(":")
        if colon < 1:
            current_list_key = None
            continue
        key = stripped[:colon].strip()
        val = stripped[colon + 1 :].strip().strip('"').strip("'")
        current_list_key = None
        if val:
            result[key] = val
        else:
            # Empty value — might be a list key
            current_list_key = key
    return result


def _normalize_tracker_value(value: object) -> str | None:
    """Normalize nullish tracker strings to None."""
    if value is None:
        return None
    text = str(value).strip()
    if not text:
        return None
    if text.lower() in {"none", "null", "<none>"}:
        return None
    return text


def _normalize_string_list(value: object) -> list[str]:
    if isinstance(value, list):
        items = value
    elif value is None:
        items = []
    else:
        items = [value]
    result: list[str] = []
    for item in items:
        text = str(item).strip()
        if text:
            result.append(text)
    return result


# Authority: SQLite via loops_sql_authority. Scope files are projections,
# not independent policy (see loops_sql_authority library docstring).
# Two distinct return shapes for "no active loop":
#   - None              => canonical DB read succeeded; zero open loops.
#                          compile_assignment turns this into clean_start.
#   - {_authority_unavailable: True, reason: ...} => DB read FAILED
#                          (missing/corrupt/unreachable). compile_assignment
#                          turns this into compilation_state: authority_unavailable.
# This distinction (PACKET-635) eradicates the authority-unavailable-as-
# clean-start ambiguity that survived PACKET-630 F2: previously, any
# exception during the SQLite path collapsed into the same None/clean_start
# downstream as "no active loops." Downstream consumers can now tell
# "authority is broken" from "no work pending."
# Scope-file projection MUST NOT be substituted as authority (PACKET-630).
def _find_active_loop(state_root: str) -> dict | None:
    """Find the active loop from SQLite authority.

    Returns one of:
      - active loop dict (single live loop)
      - {"_ambiguous": True, "_candidates": [...]} (multiple live loops)
      - None (DB read succeeded; zero live loops)
      - {"_authority_unavailable": True, "reason": "..."} (DB read FAILED)

    Does NOT fall back to scope-file projection.
    """
    db_path = os.path.join(state_root, "shared_authority.db")
    try:
        from pathlib import Path

        _script_dir = Path(__file__).resolve().parent
        _lib_dir = _script_dir.parent / "lib"
        if str(_lib_dir) not in sys.path:
            sys.path.insert(0, str(_lib_dir))
        import loops_sql_authority as lsa

        conn = lsa.connect(Path(db_path))
        try:
            rows = conn.execute(
                "SELECT * FROM loops WHERE LOWER(status) IN (?, ?, ?) ORDER BY loop_id",
                tuple(sorted(_OPEN_STATUSES)),
            ).fetchall()
            candidates = [lsa.loop_from_row(r) for r in rows]
        finally:
            conn.close()

        if len(candidates) == 1:
            return candidates[0]
        if len(candidates) > 1:
            return {"_ambiguous": True, "_candidates": candidates}
        return None

    except Exception as exc:
        # Canonical DB unavailable. Do NOT substitute scope-file projection
        # as authority. Return a distinct marker so compile_assignment can
        # emit compilation_state: authority_unavailable instead of flattening
        # into clean_start. Reason is sanitized to error class only — no
        # path/value details that could leak runtime information.
        return {
            "_authority_unavailable": True,
            "reason": f"{type(exc).__name__}",
        }


def _find_execution_tracker(state_root: str, loop_id: str | None = None) -> dict | None:
    """Find the current execution tracker for the active loop, if any."""
    artifacts_dir = os.path.join(state_root, "controller-prompts", "_intake-artifacts")
    if not os.path.isdir(artifacts_dir):
        return None

    try:
        for name in sorted(os.listdir(artifacts_dir), reverse=True):
            if "PACKET-EXECUTION" in name and name.endswith(".md"):
                tracker_path = os.path.join(artifacts_dir, name)

                try:
                    with open(tracker_path, "r", encoding="utf-8") as f:
                        text = f.read()
                except OSError:
                    continue

                fm = _parse_frontmatter(text)
                result = {"_path": tracker_path}

                # Parse the Current State section for structured fields
                state_section = False
                for line in text.split("\n"):
                    stripped = line.strip()
                    if stripped == "## Current State":
                        state_section = True
                        continue
                    if state_section and stripped.startswith("## "):
                        break
                    if state_section and stripped.startswith("- "):
                        # Parse "- key: value" lines
                        m = re.match(r"^-\s+(\w+):\s+(.+)$", stripped)
                        if m:
                            result[m.group(1)] = m.group(2).strip()

                tracker_loop_id = _normalize_tracker_value(fm.get("loop_id"))
                tracker_status = str(fm.get("status", "")).strip().lower()
                active_packet = _normalize_tracker_value(result.get("active_packet"))
                packet_status = str(result.get("packet_status", "")).strip().lower()
                next_packet = _normalize_tracker_value(result.get("next_packet"))

                if loop_id and tracker_loop_id and tracker_loop_id != loop_id:
                    continue

                # Historical/terminal trackers with no active packet are evidence,
                # not current assignment truth.
                if (
                    not active_packet
                    and (
                        tracker_status in _TERMINAL_TRACKER_STATUSES
                        or packet_status in _TERMINAL_TRACKER_STATUSES
                    )
                ):
                    continue

                result["loop_id"] = tracker_loop_id
                result["active_packet"] = active_packet
                result["next_packet"] = next_packet
                return result
    except OSError:
        return None

    return None


def _find_active_wave_kind(state_root: str, loop_id: str) -> str | None:
    """Find wave_kind from the active wave for this loop, if any."""
    waves_dir = os.path.join(state_root, "..", "waves")
    if not os.path.isdir(waves_dir):
        return None

    try:
        entries = sorted(os.listdir(waves_dir))
    except OSError:
        return None

    for name in entries:
        if not name.startswith("WAVE-"):
            continue
        sf = os.path.join(waves_dir, name, "state.json")
        if not os.path.isfile(sf):
            continue
        try:
            with open(sf, "r", encoding="utf-8") as f:
                state = json.loads(f.read())
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(state, dict):
            continue
        status = str(state.get("status") or "").strip().lower()
        if status in ("closed", "superseded"):
            continue
        pkt = state.get("packet") if isinstance(state.get("packet"), dict) else {}
        wave_loop = str(pkt.get("loop_id") or "").strip()
        if wave_loop == loop_id:
            return str(state.get("wave_kind") or "production").strip()

    return None


def _find_packet_prompt(state_root: str, packet_id: str) -> dict | None:
    """Find and parse the packet prompt for context_sources and stop_condition."""
    prompts_dir = os.path.join(state_root, "controller-prompts")
    if not os.path.isdir(prompts_dir):
        return None

    # Derive filename pattern from packet_id like PACKET-23-CLOSURE-PROPAGATION
    # → MAILROOM-CONTROLLER-PACKET-23-CLOSURE-PROPAGATION-20260415.md
    packet_num_match = re.match(r"PACKET-(\d+)-(.+)", packet_id)
    if not packet_num_match:
        return None

    packet_num = packet_num_match.group(1)
    packet_suffix = packet_num_match.group(2)

    prompt_path = None
    try:
        for name in sorted(os.listdir(prompts_dir)):
            if not name.endswith(".md"):
                continue
            # Match pattern: *PACKET-<num>-<suffix>*
            if f"PACKET-{packet_num}-{packet_suffix}" in name:
                prompt_path = os.path.join(prompts_dir, name)
                break
    except OSError:
        return None

    if not prompt_path:
        return None

    try:
        with open(prompt_path, "r", encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return None

    fm = _parse_frontmatter(text)
    result = {"_path": prompt_path, "frontmatter": fm}

    # Extract "Load before synthesis" section → context_sources
    context_sources = []
    in_load_section = False
    for line in text.split("\n"):
        stripped = line.strip()
        if "load before synthesis" in stripped.lower():
            in_load_section = True
            continue
        if in_load_section and stripped.startswith("#"):
            break
        if in_load_section and stripped.startswith("- "):
            # Extract path from bullet: "- `/path/to/file`" or "- /path/to/file"
            val = stripped[2:].strip().strip("`").strip('"').strip("'")
            if val and ("/" in val or val.startswith("$")):
                context_sources.append(val)

    result["context_sources"] = context_sources

    # Extract "Artifact produced" section → stop_condition
    stop_lines = []
    in_artifact_section = False
    for line in text.split("\n"):
        stripped = line.strip()
        if "artifact produced" in stripped.lower():
            in_artifact_section = True
            continue
        if in_artifact_section and stripped.startswith("#"):
            break
        if in_artifact_section and stripped.startswith("- "):
            stop_lines.append(stripped[2:].strip())

    result["stop_condition_lines"] = stop_lines

    # Extract "Out of scope" section (optional)
    out_of_scope = []
    in_oos_section = False
    for line in text.split("\n"):
        stripped = line.strip()
        if "out of scope" in stripped.lower():
            in_oos_section = True
            continue
        if in_oos_section and stripped.startswith("#"):
            break
        if in_oos_section and stripped.startswith("- "):
            out_of_scope.append(stripped[2:].strip())

    result["out_of_scope"] = out_of_scope

    return result


def _find_live_packet_for_loop(state_root: str, loop_id: str) -> dict | None:
    """Recover one live controller packet directly from packet truth.

    Used when no execution tracker is present but one draft packet remains the
    authoritative continuity seam for the active loop.
    """
    prompts_dir = os.path.join(state_root, "controller-prompts")
    if not os.path.isdir(prompts_dir):
        return None

    candidates: list[dict] = []
    try:
        for name in sorted(os.listdir(prompts_dir)):
            if not name.endswith(".md"):
                continue
            path = os.path.join(prompts_dir, name)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                continue
            fm = _parse_frontmatter(text)
            if str(fm.get("loop_id", "")).strip() != loop_id:
                continue
            packet_id = str(fm.get("packet_id", "")).strip()
            status = str(fm.get("status", "")).strip().lower()
            if not packet_id or status == "closed":
                continue
            candidates.append({
                "_path": path,
                "packet_id": packet_id,
                "frontmatter": fm,
            })
    except OSError:
        return None

    if len(candidates) == 1:
        return candidates[0]
    if len(candidates) > 1:
        return {"_ambiguous": True, "_candidates": candidates}
    return None


# ── Main ─────────────────────────────────────────────────────────────────

def compile_assignment(state_root: str) -> dict:
    """Compile the assignment object from runtime truth."""
    assignment: dict = {
        "version": "0.1",
        "type": "entry.assignment.compiled",
        "compilation_state": "unknown",
    }

    # Step 1: Find active loop
    loop_result = _find_active_loop(state_root)

    # PACKET-635: distinguish "DB read failed" from "DB read succeeded
    # with zero loops." Both used to flatten into clean_start; now they
    # emit different compilation_state values so downstream cannot mistake
    # authority outage for honest empty.
    if isinstance(loop_result, dict) and loop_result.get("_authority_unavailable"):
        assignment["compilation_state"] = "authority_unavailable"
        assignment["loop_id"] = None
        assignment["packet_id"] = None
        assignment["context_sources"] = None
        assignment["active_artifacts"] = None
        assignment["stop_condition"] = None
        assignment["mutation_ground"] = None
        assignment["handoff_target"] = None
        # Sanitized — error class only, no values/paths/messages
        assignment["authority_error_class"] = str(loop_result.get("reason", "")).strip() or "unknown"
        return assignment

    if loop_result is None:
        assignment["compilation_state"] = "clean_start"
        assignment["loop_id"] = None
        assignment["packet_id"] = None
        assignment["context_sources"] = None
        assignment["active_artifacts"] = None
        assignment["stop_condition"] = None
        assignment["mutation_ground"] = None
        assignment["handoff_target"] = None
        return assignment

    if loop_result.get("_ambiguous"):
        cands = loop_result.get("_candidates", [])
        assignment["compilation_state"] = "ambiguous"
        assignment["loop_candidates"] = [
            {"loop_id": c.get("loop_id", "unknown"), "objective": c.get("objective")}
            for c in cands
        ]
        assignment["loop_id"] = None
        assignment["packet_id"] = None
        assignment["context_sources"] = None
        assignment["active_artifacts"] = None
        assignment["stop_condition"] = None
        assignment["mutation_ground"] = None
        assignment["handoff_target"] = None
        return assignment

    # Single active loop
    loop_id = loop_result.get("loop_id", "unknown")
    assignment["loop_id"] = loop_id
    assignment["loop_objective"] = loop_result.get("objective")
    assignment["loop_priority"] = loop_result.get("priority")
    assignment["loop_evidence_refs"] = loop_result.get("evidence_refs")
    assignment["loop_exclusions"] = loop_result.get("exclusions")

    # Resolve wave_kind from active wave state (if any wave is running for this loop)
    wave_kind = _find_active_wave_kind(state_root, loop_id)
    if wave_kind:
        assignment["wave_kind"] = wave_kind

    # Step 2: Find execution tracker
    tracker = _find_execution_tracker(state_root, loop_id=loop_id)

    if not tracker:
        packet_continuity = _find_live_packet_for_loop(state_root, loop_id)
        if packet_continuity and packet_continuity.get("_ambiguous"):
            candidates = packet_continuity.get("_candidates", [])
            assignment["compilation_state"] = "packet_ambiguous"
            assignment["packet_candidates"] = [
                {"packet_id": c.get("packet_id"), "path": c.get("_path")}
                for c in candidates
            ]
            assignment["packet_id"] = None
            assignment["context_sources"] = loop_result.get("evidence_refs")
            assignment["active_artifacts"] = None
            assignment["stop_condition"] = None
            assignment["mutation_ground"] = {
                "mutation_permitted": loop_result.get("mutation_permitted", "false").lower() == "true",
                "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
                "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
            }
            assignment["handoff_target"] = None
            return assignment

        if packet_continuity:
            active_packet = packet_continuity.get("packet_id")
            packet_prompt = _find_packet_prompt(state_root, active_packet) if active_packet else None
            packet_fm = packet_continuity.get("frontmatter", {})
            packet_refs = _normalize_string_list(packet_fm.get("evidence_refs"))
            assignment["compilation_state"] = "packet_continuity"
            assignment["packet_id"] = active_packet
            assignment["active_artifacts"] = None
            assignment["handoff_target"] = None
            assignment["context_sources"] = (
                (packet_prompt or {}).get("context_sources")
                or packet_refs
                or loop_result.get("evidence_refs")
            )
            stop_lines = (packet_prompt or {}).get("stop_condition_lines", [])
            assignment["stop_condition"] = stop_lines[0] if len(stop_lines) == 1 else (stop_lines or None)
            assignment["mutation_ground"] = {
                "mutation_permitted": str(packet_fm.get("mutation_permitted", "false")).lower() == "true",
                "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
                "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
            }
            assignment["packet_next_action"] = str(packet_fm.get("next_action", "")).strip() or None
            assignment["packet_continuity_summary"] = str(packet_fm.get("continuity_summary", "")).strip() or None
            assignment["packet_evidence_refs"] = packet_refs or None
            assignment["packet_last_amended_at_utc"] = str(packet_fm.get("last_amended_at_utc", "")).strip() or None
            assignment["packet_last_amendment_id"] = str(packet_fm.get("last_amendment_id", "")).strip() or None
            assignment["packet_checkpoint_status"] = str(packet_fm.get("checkpoint_status", "")).strip() or None
            return assignment

        assignment["compilation_state"] = "loop_only"
        assignment["packet_id"] = None
        assignment["context_sources"] = loop_result.get("evidence_refs")
        assignment["active_artifacts"] = None
        assignment["stop_condition"] = None
        assignment["mutation_ground"] = {
            "mutation_permitted": loop_result.get("mutation_permitted", "false").lower() == "true",
            "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
            "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
        }
        assignment["handoff_target"] = None
        return assignment

    # Step 3: Extract packet from tracker
    active_packet = tracker.get("active_packet")
    assignment["packet_id"] = active_packet
    assignment["active_artifacts"] = [tracker.get("artifact_path")] if tracker.get("artifact_path") else None
    assignment["handoff_target"] = tracker.get("next_packet")

    # Step 4: Load packet prompt for context_sources and stop_condition
    if active_packet:
        packet_prompt = _find_packet_prompt(state_root, active_packet)
        if packet_prompt:
            assignment["context_sources"] = packet_prompt.get("context_sources") or loop_result.get("evidence_refs")
            stop_lines = packet_prompt.get("stop_condition_lines", [])
            assignment["stop_condition"] = stop_lines[0] if len(stop_lines) == 1 else (stop_lines or None)
            fm = packet_prompt.get("frontmatter", {})
            assignment["mutation_ground"] = {
                "mutation_permitted": fm.get("mutation_permitted", "false").lower() == "true",
                "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
                "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
            }
            assignment["compilation_state"] = "compiled"
        else:
            assignment["context_sources"] = loop_result.get("evidence_refs")
            assignment["stop_condition"] = None
            assignment["mutation_ground"] = {
                "mutation_permitted": False,
                "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
                "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
            }
            assignment["compilation_state"] = "partial"
    else:
        assignment["context_sources"] = loop_result.get("evidence_refs")
        assignment["stop_condition"] = None
        assignment["mutation_ground"] = {
            "mutation_permitted": loop_result.get("mutation_permitted", "false").lower() == "true",
            "execution_class": os.environ.get("SPINE_EXECUTION_CLASS") or os.environ.get("SPINE_RUNTIME_ROLE"),
            "runtime_role": os.environ.get("SPINE_RUNTIME_ROLE"),
        }
        assignment["compilation_state"] = "partial"

    return assignment


def main() -> None:
    import argparse

    parser = argparse.ArgumentParser(
        description="Compile current assignment from loop scope, execution tracker, and packet prompt."
    )
    parser.add_argument(
        "--state-root",
        default=os.environ.get("SPINE_STATE", ""),
        help="Path to $SPINE_STATE (default: from env)",
    )
    parser.add_argument(
        "--format",
        choices=["json", "summary"],
        default="json",
        help="Output format (default: json)",
    )
    # Accept and ignore unknown flags for forward compat
    args, _ = parser.parse_known_args()

    state_root = args.state_root
    if not state_root:
        print(json.dumps({"error": "SPINE_STATE not set and --state-root not provided"}))
        sys.exit(1)

    assignment = compile_assignment(state_root)

    # ── Delegation state enrichment ──────────────────────────────
    # If active delegations exist, surface them as primary next-action
    # context. Delegation state is more specific than raw packet/handoff.
    delegations_dir = os.path.join(state_root, "delegations")
    current_loop_id = str(assignment.get("loop_id") or "").strip()
    if current_loop_id and os.path.isdir(delegations_dir):
        try:
            import delegation_broker as db
            active_dels = []
            stale_dels = []
            result = db.status(state_root=state_root)
            for doc in result.get("delegations", []):
                if not isinstance(doc, dict):
                    continue
                if str(doc.get("loop_id") or "").strip() != current_loop_id:
                    continue
                ds = str(doc.get("delegation_state", "")).strip()
                if ds in ("landed", "needs_review", "cancelled"):
                    continue
                payload = {
                    "delegation_id": doc.get("delegation_id"),
                    "delegation_state": ds,
                    "effective_state": doc.get("effective_state"),
                    "loop_id": doc.get("loop_id"),
                    "packet_id": doc.get("packet_id"),
                    "objective": doc.get("objective"),
                }
                if bool(doc.get("continuity_live", True)):
                    active_dels.append({
                        **payload,
                        "continuity_live": True,
                    })
                else:
                    stale_dels.append({
                        **payload,
                        "continuity_live": False,
                        "continuity_reason": doc.get("continuity_reason"),
                    })
            if active_dels:
                assignment["active_delegations"] = active_dels
                assignment["delegation_preferred"] = True
            else:
                assignment["active_delegations"] = []
                assignment["delegation_preferred"] = False
            if stale_dels:
                assignment["stale_delegations"] = stale_dels
        except ImportError:
            pass
    else:
        assignment["active_delegations"] = []
        assignment["delegation_preferred"] = False

    prompts_dir = os.path.join(state_root, "controller-prompts")
    active_operational = []
    if current_loop_id and os.path.isdir(prompts_dir):
        try:
            import yaml
            for fname in sorted(os.listdir(prompts_dir)):
                if not fname.endswith(".md"):
                    continue
                fpath = os.path.join(prompts_dir, fname)
                try:
                    with open(fpath, encoding="utf-8") as f:
                        text = f.read()
                    if not text.startswith("---"):
                        continue
                    parts = text.split("---", 2)
                    if len(parts) < 3:
                        continue
                    doc = yaml.safe_load(parts[1])
                except Exception:
                    continue
                if not isinstance(doc, dict):
                    continue
                if str(doc.get("loop_id", "")).strip() != current_loop_id:
                    continue
                if str(doc.get("execution_mode", "")).strip().lower() != "operational":
                    continue
                task_state = str(doc.get("execution_request_state", "")).strip().lower()
                if not task_state or task_state in {"done", "failed", "cancelled"}:
                    continue
                active_operational.append({
                    "packet_id": doc.get("packet_id"),
                    "task_id": doc.get("execution_request_id"),
                    "state": task_state,
                    "execution_lane_id": doc.get("execution_lane_id"),
                })
        except ImportError:
            pass
    assignment["active_operational_tasks"] = active_operational
    assignment["operational_lane_preferred"] = bool(active_operational)

    if args.format == "summary":
        cs = assignment.get("compilation_state", "unknown")
        print(f"compilation: {cs}")
        print(f"loop:        {assignment.get('loop_id') or '<none>'}")
        print(f"packet:      {assignment.get('packet_id') or '<none>'}")
        sources = assignment.get("context_sources") or []
        print(f"sources:     {len(sources)} file(s)")
        print(f"stop:        {assignment.get('stop_condition') or '<none>'}")
        mg = assignment.get("mutation_ground") or {}
        print(f"mutation:    permitted={mg.get('mutation_permitted', '?')} role={mg.get('runtime_role', '?')}")
        print(f"handoff:     {assignment.get('handoff_target') or '<none>'}")
        active_dels = assignment.get("active_delegations") or []
        if active_dels:
            print(f"delegations: {len(active_dels)} active")
            for d in active_dels:
                print(f"  {d.get('delegation_id', '?')} [{d.get('delegation_state', '?')}] {d.get('objective', '')[:60]}")
        else:
            print(f"delegations: none")
        active_operational = assignment.get("active_operational_tasks") or []
        if active_operational:
            print(f"operational: {len(active_operational)} active")
            for task in active_operational:
                print(f"  {task.get('task_id', '?')} [{task.get('state', '?')}] {task.get('packet_id', '')}")
        else:
            print("operational: none")
    else:
        print(json.dumps(assignment, indent=2))


if __name__ == "__main__":
    main()
