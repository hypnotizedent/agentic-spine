#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# session.v3.attach - Canonical session entry point
# ═══════════════════════════════════════════════════════════════════════════
#
# Single entry capability for a new terminal session.
# Composes the birth banner (context) and work summary (status --brief)
# into one screen so the operator lands oriented.
#
# Called by: ops terminal launch (internally, after env setup)
# Also callable directly: ops cap run session.v3.attach
#
# Does NOT:
#   - Mutate state
#   - Attach loops (use --loop on terminal launch for that)
#   - Run verify (ops verify is a separate health surface)
#   - Dispatch work (ops dispatch local is a separate work surface)
#
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

SPINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"

# ── Flag parsing (bounded, forward-compatible) ─────────────────────────────
EMIT_ENV=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --emit-env)
            EMIT_ENV=1
            shift
            ;;
        --allow-no-loop)
            # accepted and ignored (packet proof compatibility)
            shift
            ;;
        -h|--help)
            echo "usage: session-v3-attach [--emit-env] [--allow-no-loop] [-h|--help]"
            exit 0
            ;;
        *)
            # unknown flags: accept and ignore (forward compat)
            shift
            ;;
    esac
done

# ── Source posture helper (best-effort) ────────────────────────────────────
POSTURE_HELPER="$SPINE_ROOT/ops/plugins/core/lifecycle/lib/session_posture.sh"
# shellcheck source=/dev/null
[[ -f "$POSTURE_HELPER" ]] && . "$POSTURE_HELPER" 2>/dev/null || true

# ── Context banner ─────────────────────────────────────────────────────────
# Best-effort: never block terminal birth
"$SPINE_ROOT/bin/ops" status --context 2>/dev/null || true

# ── Status one-liner ───────────────────────────────────────────────────────
echo ""
"$SPINE_ROOT/bin/ops" status --brief 2>/dev/null || true
echo ""

# ── Session posture (best-effort, non-blocking) ────────────────────────────
POSTURE_OK=0
if command -v session_posture_resolve >/dev/null 2>&1; then
    if session_posture_resolve "${OPS_TERMINAL_ROLE:-}" "" 2>/dev/null; then
        POSTURE_OK=1
        echo "── session posture ─────────────────────────────────────────────"
        echo "  node type:       ${__SP_NODE_TYPE:-unknown}"
        echo "  session posture: ${__SP_POSTURE:-unknown}"
        echo "  posture source:  ${__SP_SOURCE:-unknown}"
        echo "  runtime role:    ${SPINE_RUNTIME_ROLE:-unset}"
        echo "  verify cmd:      ./bin/ops verify --spine-lite"
        echo "  control loop:    ./bin/ops status --control-loop"
        echo ""

        # Recovery posture (best-effort, non-blocking)
        if command -v session_recovery_posture_resolve >/dev/null 2>&1; then
            if session_recovery_posture_resolve 2>/dev/null; then
                echo "── recovery posture ───────────────────────────────────────────"
                echo "  operator site:   ${__SP_OPERATOR_SITE:-unknown}"
                echo "  recovery:        ${__SP_RECOVERY_POSTURE:-unknown}"
                echo "  safe to mutate:  ${__SP_SAFE_TO_MUTATE:-false}"
                echo "  detection basis: ${__SP_SITE_DETECTION_BASIS:-unavailable}"
                echo ""
            fi
        fi
    fi
fi

# ── Workflow routing (best-effort, non-blocking) ─────────────────────────
ROUTER_HELPER="$SPINE_ROOT/ops/plugins/core/lifecycle/lib/post_attach_router.py"
ROUTING_JSON=""
if [[ -f "$ROUTER_HELPER" ]]; then
    ROUTING_JSON=$(python3 "$ROUTER_HELPER" \
        --runtime-root "${SPINE_RUNTIME_ROOT:-$HOME/code/.runtime/spine}" \
        --state-root "${SPINE_STATE:-$HOME/code/.runtime/spine/state}" \
        2>/dev/null) || true
fi

if [[ -n "$ROUTING_JSON" ]]; then
    # Extract fields via python3 (jq may not be available)
    eval "$(python3 -c "
import json, sys, shlex
d = json.loads(sys.stdin.read())
print(f'_RT_STATE={shlex.quote(d.get(\"routing_state\", \"unknown\"))}')
print(f'_RT_ACTION={shlex.quote(d.get(\"recommended_next_action\", \"\"))}')
print(f'_RT_CMD={shlex.quote(d.get(\"recommended_command\", \"\") or \"\")}')
print(f'_RT_CONTAINER={shlex.quote(d.get(\"recommended_container\", \"\"))}')
print(f'_RT_WHY={shlex.quote(d.get(\"why\", \"\"))}')
print(f'_RT_RULES={shlex.quote(d.get(\"container_rules_summary\", \"\"))}')
# candidates
cands = d.get(\"open_loop_candidates\", [])[:3]
for i, c in enumerate(cands):
    print(f'_RT_CAND{i}_ID={shlex.quote(c.get(\"loop_id\", \"\"))}')
    print(f'_RT_CAND{i}_OBJ={shlex.quote(c.get(\"objective\", \"\")[:80])}')
print(f'_RT_CAND_COUNT={len(cands)}')
" <<< "$ROUTING_JSON" 2>/dev/null)" || true

    if [[ -n "${_RT_STATE:-}" ]]; then
        echo "── workflow routing ────────────────────────────────────────────"
        echo "  routing state:   ${_RT_STATE}"
        echo "  next action:     ${_RT_ACTION}"
        if [[ -n "${_RT_CMD}" ]]; then
            echo "  suggested cmd:   ${_RT_CMD}"
        fi
        echo "  container:       ${_RT_CONTAINER}"
        echo "  why:             ${_RT_WHY}"
        # Show loop candidates if any
        if [[ "${_RT_CAND_COUNT:-0}" -gt 0 ]]; then
            echo ""
            echo "  open loop candidates:"
            for i in $(seq 0 $((_RT_CAND_COUNT - 1))); do
                eval "_id=\${_RT_CAND${i}_ID:-}"
                eval "_obj=\${_RT_CAND${i}_OBJ:-}"
                echo "    - ${_id}: ${_obj}"
            done
        fi
        echo ""
        echo "  container rules: ${_RT_RULES}"
        echo ""
    fi
fi

# ── --emit-env handling ────────────────────────────────────────────────────
if [[ "$EMIT_ENV" -eq 1 ]]; then
    if [[ "$POSTURE_OK" -eq 1 ]] && command -v session_posture_emit_env >/dev/null 2>&1; then
        echo "# posture env exports"
        session_posture_emit_env 2>/dev/null || true
    else
        echo "# posture env unavailable"
    fi
fi

exit 0
