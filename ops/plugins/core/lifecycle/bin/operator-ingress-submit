#!/usr/bin/env python3
"""operator-ingress-submit — CLI for operator_ingress.submit capability."""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
import urllib.parse
import urllib.request
import urllib.error
from pathlib import Path
from typing import Any


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Raise HTTPError on redirects so we can extract Location header."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(
            req.full_url, code, msg, headers, fp
        )

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import operator_ingress as oi


def _load_yaml(path: Path) -> dict[str, Any]:
    try:
        import yaml

        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _operator_route(path: str) -> str:
    contract = _load_yaml(ROOT / "ops/bindings/operator.cockpit.contract.yaml")
    authority = contract.get("authority") if isinstance(contract.get("authority"), dict) else {}
    base = os.environ.get("OPERATOR_COCKPIT_URL") or str(authority.get("public_operator_url") or "").strip()
    if not base:
        raise RuntimeError("operator cockpit URL missing; set OPERATOR_COCKPIT_URL or restore operator.cockpit.contract.yaml")
    return base.rstrip("/") + "/" + path.lstrip("/")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="operator-ingress-submit",
        description="Submit human intent into the canonical OI/HI lifecycle.",
    )
    parser.add_argument(
        "--content-type",
        required=True,
        choices=sorted(oi.ALLOWED_CONTENT_TYPES),
        help="Submitted artifact content type.",
    )
    parser.add_argument(
        "--raw-content",
        default="",
        help="Raw operator content. Use --stdin for multiline input.",
    )
    parser.add_argument(
        "--stdin",
        action="store_true",
        help="Read raw content from stdin.",
    )
    parser.add_argument(
        "--hint",
        default="",
        help="Optional one-line operator hint.",
    )
    parser.add_argument(
        "--source-device",
        default="desktop",
        help="Source device label (default: desktop).",
    )
    parser.add_argument(
        "--source-app",
        default="manual",
        help="Source app label (default: manual).",
    )
    parser.add_argument(
        "--operator-id",
        default="ronny",
        help="Operator ID (default: ronny).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_output",
        help="Emit JSON output.",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="Write to local SPINE_STATE instead of canonical remote root.",
    )
    parser.add_argument(
        "--remote-url",
        default=None,
        help="Canonical remote submit endpoint URL (default: operator.cockpit.contract.yaml public_operator_url + /submit).",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="Verify dependencies and exit.",
    )

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            with tempfile.TemporaryDirectory(prefix="operator-ingress-submit-") as tmp:
                state_root = Path(tmp)
                first = oi.create_operator_ingress(
                    state_root=str(state_root),
                    raw_content="self-check harmless human intent artifact",
                    content_type="note",
                    operator_hint="self-check",
                    source_device="self-check-cli",
                    source_app="operator.ingress.submit",
                    submitted_via="operator_ingress.submit.self_check",
                )
                second = oi.create_operator_ingress(
                    state_root=str(state_root),
                    raw_content="self-check harmless human intent artifact",
                    content_type="note",
                    operator_hint="self-check from another transport",
                    source_device="self-check-web",
                    source_app="operator_surface_submit",
                    submitted_via="operator_ingress.submit.self_check",
                )
                files = list((state_root / "inputs" / "operator-ingress").glob("OI-*.yaml"))
                if first.get("status") != "submitted" or not first.get("created"):
                    raise RuntimeError(f"unexpected create result: {first}")
                if second.get("status") != "duplicate" or second.get("created"):
                    raise RuntimeError(f"duplicate was not idempotent: {second}")
                if len(files) != 1:
                    raise RuntimeError(f"duplicate self-check wrote {len(files)} OI objects")
            print("operator.ingress.submit self-check PASS")
            return 0
        except ImportError as exc:
            print(f"operator.ingress.submit self-check FAIL: {exc}", file=sys.stderr)
            return 1
        except Exception as exc:
            print(f"operator.ingress.submit self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    raw_content = sys.stdin.read() if args.stdin else args.raw_content

    # --- Canonical remote submission (default): POST to execution host ---
    if not args.local:
        payload = json.dumps({
            "content_type": args.content_type,
            "raw_content": raw_content,
            "operator_hint": args.hint,
            "source_device": args.source_device,
            "source_app": args.source_app,
        }).encode("utf-8")
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "operator-ingress-submit/1.0",
        }
        # Cloudflare Access service-token auth when available
        cf_id = os.environ.get("CF_ACCESS_CLIENT_ID", "")
        cf_secret = os.environ.get("CF_ACCESS_CLIENT_SECRET", "")
        if cf_id and cf_secret:
            headers["CF-Access-Client-Id"] = cf_id
            headers["CF-Access-Client-Secret"] = cf_secret

        try:
            remote_url = args.remote_url or _operator_route("/submit")
        except Exception as exc:
            print(f"FAIL: {exc}", file=sys.stderr)
            return 1

        req = urllib.request.Request(
            remote_url,
            data=payload,
            headers=headers,
            method="POST",
        )
        opener = urllib.request.build_opener(_NoRedirectHandler)
        try:
            with opener.open(req, timeout=30) as resp:
                body = resp.read().decode("utf-8")
                ctype = resp.headers.get("Content-Type", "")
                if "application/json" in ctype and body.strip():
                    result = json.loads(body)
                else:
                    result = {"status": "submitted", "ingress_id": "submitted (non-JSON response)"}
        except urllib.error.HTTPError as exc:
            # 303 redirect means success — extract ingress_id from Location header
            if exc.code == 303:
                location = exc.headers.get("Location", "")
                ingress_id = "unknown"
                if "submitted=" in location:
                    ingress_id = location.split("submitted=")[-1].split("&")[0]
                result = {
                    "status": "submitted",
                    "created": True,
                    "duplicate": False,
                    "ingress_id": urllib.parse.unquote(ingress_id),
                    "lifecycle_state": "submitted",
                    "disposition": "awaiting_classification",
                }
            else:
                body = exc.read().decode("utf-8", errors="replace")
                try:
                    err_data = json.loads(body)
                    msg = err_data.get("error", body)
                except Exception:
                    msg = body
                if args.json_output:
                    print(json.dumps({"status": "error", "created": False, "error": msg}, indent=2))
                else:
                    print(f"operator.ingress.submit FAIL (remote): {msg}", file=sys.stderr)
                return 1
        except Exception as exc:
            hint = "Set CF_ACCESS_CLIENT_ID/CF_ACCESS_CLIENT_SECRET or use --local for local-only write." if "403" in str(exc) or "urlopen" in str(exc).lower() else ""
            if args.json_output:
                err = {"status": "error", "created": False, "error": str(exc), "write_root": "canonical (unreachable)"}
                if hint:
                    err["hint"] = hint
                print(json.dumps(err, indent=2))
            else:
                print(f"operator.ingress.submit FAIL (canonical root unreachable): {exc}", file=sys.stderr)
                if hint:
                    print(f"  hint: {hint}", file=sys.stderr)
            return 1

        if args.json_output:
            result["write_root"] = "canonical (remote)"
            print(json.dumps(result, indent=2))
        else:
            action = "DUPLICATE" if result.get("duplicate") else "SUBMITTED"
            hi = result.get("human_intent_id") or "HI pending"
            print(f"{action}: {result.get('ingress_id', '?')}  {hi}  [{args.content_type}]  state={result.get('lifecycle_state', '?')}  root=canonical")
        return 0

    # --- Local submission (--local): write directly to SPINE_STATE ---
    state_root = os.environ.get("SPINE_STATE", "")
    if not state_root:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "created": False, "error": msg}, indent=2))
        else:
            print(f"operator.ingress.submit FAIL: {msg}", file=sys.stderr)
        return 1

    try:
        result = oi.create_operator_ingress(
            state_root=state_root,
            raw_content=raw_content,
            content_type=args.content_type,
            operator_hint=args.hint,
            operator_id=args.operator_id,
            source_device=args.source_device,
            source_app=args.source_app,
            submitted_via="operator_ingress.submit",
        )
    except oi.OperatorIngressError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "created": False, "error": str(exc)}, indent=2))
        else:
            print(f"operator.ingress.submit FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        result["write_root"] = f"local ({state_root})"
        print(json.dumps(result, indent=2))
    else:
        action = "DUPLICATE" if result.get("duplicate") else "SUBMITTED"
        print(f"{action}: {result['ingress_id']}  {result.get('human_intent_id', 'HI pending')}  [{result.get('content_type', args.content_type)}]  state={result['lifecycle_state']}  root=local ({state_root})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
