#!/usr/bin/env python3
"""CLI bridge for friction SQLite authority operations.

Shell scripts (friction-ingest, friction-reconcile) can call this instead of
mutating friction-queue.ndjson directly. This script:
  1. Performs the SQLite mutation (upsert/close/match)
  2. Returns status to the calling shell script

NDJSON projection is NOT triggered on mutation. Refresh on demand:
  friction-authority-bridge project

Usage:
  friction-authority-bridge bootstrap
  friction-authority-bridge upsert --json '{"friction_id":"FR-...","capability":"...","expected":"...","actual":"...","severity":"medium"}'
  friction-authority-bridge close --id FR-... --reason gap_resolved
  friction-authority-bridge match --id FR-... --gap-id GAP-OP-1234
  friction-authority-bridge query --id FR-...
  friction-authority-bridge list [--status queued|filed|matched|closed]
  friction-authority-bridge stats
  friction-authority-bridge project
  friction-authority-bridge backfill-gap-ids
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

# Resolve lib path relative to this script.
SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import gaps_sql_authority as gsa

# ── Mutation ceremony ────────────────────────────────────────────
# Write operations require governed execution (SPINE_CAP_RUN_KEY set by cap.sh).
# Read operations are always allowed.

MUTATING_COMMANDS = frozenset({"upsert", "close", "match"})
READ_COMMANDS = frozenset({"query", "list", "stats", "bootstrap", "project", "backfill-gap-ids"})


def check_mutation_ceremony(command: str, args: argparse.Namespace) -> tuple[str | None, str]:
    """Verify mutation ceremony for write operations.

    Returns (run_key, mutation_source) on success.
    Prints error and calls sys.exit(1) if blocked.
    """
    if command not in MUTATING_COMMANDS:
        return None, "read"

    run_key = os.environ.get("SPINE_CAP_RUN_KEY", "").strip()
    ungoverned = getattr(args, "ungoverned_override", False)
    override_reason = getattr(args, "reason", None) or ""

    if run_key:
        print(
            f"mutation-ceremony: governed (run_key={run_key})",
            file=sys.stderr,
        )
        return run_key, "governed"

    if ungoverned and override_reason.strip():
        print(
            f"mutation-ceremony: override (reason={override_reason.strip()})",
            file=sys.stderr,
        )
        print(
            "WARNING: ungoverned mutation -- no SPINE_CAP_RUN_KEY audit trail",
            file=sys.stderr,
        )
        return None, "override"

    print(
        "MUTATION BLOCKED: friction-authority-bridge requires governed execution "
        "(SPINE_CAP_RUN_KEY not set). "
        "Run through: ./bin/ops cap run friction.authority.bootstrap|friction.authority.query",
        file=sys.stderr,
    )
    if ungoverned and not override_reason.strip():
        print(
            "  --ungoverned-override requires --reason",
            file=sys.stderr,
        )
    sys.exit(1)


def resolve_root() -> Path:
    spine_root = os.environ.get("SPINE_ROOT") or os.environ.get("SPINE_CODE")
    if spine_root:
        return Path(spine_root).resolve()
    # Walk up from script location to find repo root.
    candidate = SCRIPT_DIR
    for _ in range(10):
        if (candidate / "ops" / "bindings" / "operational.gaps.yaml").exists():
            return candidate
        candidate = candidate.parent
    raise RuntimeError("Cannot resolve SPINE_ROOT")


def resolve_ndjson(root: Path) -> Path:
    """Resolve friction-queue.ndjson path from contract or env."""
    override = os.environ.get("SPINE_STATE", "").strip()
    if override:
        return Path(override).expanduser() / "friction-queue.ndjson"

    contract_path = root / "ops/bindings/mailroom.runtime.contract.yaml"
    if contract_path.exists():
        try:
            import yaml
            doc = yaml.safe_load(contract_path.read_text(encoding="utf-8")) or {}
            state_root_raw = str(doc.get("state_root") or "").strip()
            if state_root_raw:
                return Path(os.path.expanduser(state_root_raw)) / "friction-queue.ndjson"
            runtime_root_raw = str(doc.get("runtime_root") or "").strip()
            if runtime_root_raw:
                runtime_root = Path(os.path.expanduser(runtime_root_raw))
                if not runtime_root.is_absolute():
                    runtime_root = root / runtime_root
                return runtime_root / "state" / "friction-queue.ndjson"
        except Exception:
            pass
    return root.parent / ".runtime/spine/state/friction-queue.ndjson"


# ── Subcommands ──────────────────────────────────────────────────


def cmd_bootstrap(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    imported = gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)
    total = gsa.friction_count(conn)
    ok, msg = gsa.integrity_check(conn)
    conn.close()
    print(json.dumps({"ok": ok, "imported": imported, "total": total, "integrity": msg, "source": str(ndjson_path)}))


def cmd_upsert(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("upsert", args)

    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    item = json.loads(args.json)
    friction_id = item.get("friction_id", "")

    old = gsa.get_friction(conn, friction_id)
    gsa.upsert_friction(conn, item)
    gsa.insert_friction_event(
        conn,
        friction_id=friction_id,
        event_type="upsert",
        from_status=old["status"] if old else None,
        to_status=item.get("status", "queued"),
        reason="Filed via friction-authority-bridge upsert",
        actor=args.actor or "friction.authority.upsert",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "friction_id": friction_id}), file=sys.stdout)
    print("NDJSON projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_close(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("close", args)

    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    item = gsa.close_friction(
        conn,
        args.id,
        args.reason,
        args.actor or "friction.authority.close",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    if item is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "friction_id": args.id, "status": "closed", "reason": args.reason}), file=sys.stdout)
    print("NDJSON projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_match(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("match", args)

    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    item = gsa.match_friction(
        conn,
        args.id,
        args.gap_id,
        args.actor or "friction.authority.match",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    if item is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "friction_id": args.id, "matched_gap_id": args.gap_id}), file=sys.stdout)
    print("NDJSON projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_query(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    item = gsa.get_friction(conn, args.id)
    conn.close()

    if item is None:
        print(json.dumps({"exists": False, "friction_id": args.id}))
    else:
        print(json.dumps({
            "exists": True,
            "friction_id": item.get("friction_id", args.id),
            "status": item.get("status", ""),
            "severity": item.get("severity", ""),
            "capability": item.get("capability", ""),
            "matched_gap_id": item.get("matched_gap_id"),
            "filed_gap_id": item.get("filed_gap_id"),
        }))


def cmd_list(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    items = gsa.list_friction(conn, status=args.status)
    conn.close()

    result = []
    for item in items:
        result.append({
            "friction_id": item["friction_id"],
            "capability": item["capability"],
            "severity": item["severity"],
            "status": item["status"],
            "hit_count": item["hit_count"],
            "matched_gap_id": item.get("matched_gap_id"),
            "filed_gap_id": item.get("filed_gap_id"),
            "first_seen_utc": item.get("first_seen_utc"),
        })
    print(json.dumps(result, indent=2))


def cmd_stats(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)

    stats = gsa.friction_stats(conn)
    conn.close()
    print(json.dumps(stats, indent=2))


def cmd_project(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, _gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)
    result = gsa.project_friction_to_ndjson(conn, ndjson_path)
    conn.close()
    print(json.dumps({"ok": True, "projection": result}))


def cmd_backfill_gap_ids(args: argparse.Namespace) -> None:
    """Scan filed friction items missing filed_gap_id — try to match from gap descriptions."""
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    ndjson_path = resolve_ndjson(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_friction_from_ndjson(conn, ndjson_path)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    # Find filed friction items without filed_gap_id.
    filed_items = conn.execute(
        "SELECT * FROM friction WHERE status = 'filed' AND filed_gap_id IS NULL ORDER BY friction_id"
    ).fetchall()

    backfilled = 0
    for row in filed_items:
        item = gsa.friction_from_row(row)
        friction_id = item["friction_id"]
        fingerprint = item.get("fingerprint", "")

        # Search gaps table for description containing this friction_id or fingerprint.
        match_row = None
        if friction_id:
            match_row = conn.execute(
                "SELECT gap_id FROM gaps WHERE data_json LIKE ? AND status IN ('open', 'accepted') LIMIT 1",
                (f"%{friction_id}%",),
            ).fetchone()
        if match_row is None and fingerprint:
            match_row = conn.execute(
                "SELECT gap_id FROM gaps WHERE data_json LIKE ? AND status IN ('open', 'accepted') LIMIT 1",
                (f"%{fingerprint}%",),
            ).fetchone()

        if match_row is not None:
            gap_id = match_row["gap_id"]
            conn.execute(
                "UPDATE friction SET filed_gap_id = ?, updated_at_utc = ? WHERE friction_id = ?",
                (gap_id, gsa.utc_now_text(), friction_id),
            )
            gsa.insert_friction_event(
                conn,
                friction_id=friction_id,
                event_type="backfill_gap_id",
                from_status="filed",
                to_status="filed",
                reason=f"Backfilled filed_gap_id={gap_id} from gap description match",
                actor="friction.authority.backfill",
            )
            backfilled += 1

    conn.commit()
    conn.close()
    print(json.dumps({
        "ok": True,
        "scanned": len(filed_items),
        "backfilled": backfilled,
    }))


# ── Main ─────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(description="Friction SQLite authority bridge")
    sub = parser.add_subparsers(dest="command", required=True)

    # -- Shared override flags for mutating subcommands --
    def add_mutation_override_flags(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--ungoverned-override",
            action="store_true",
            default=False,
            help="Allow mutation without SPINE_CAP_RUN_KEY (emergency/bootstrap). Requires --reason.",
        )

    sub.add_parser("bootstrap")

    p_upsert = sub.add_parser("upsert")
    p_upsert.add_argument("--json", required=True)
    p_upsert.add_argument("--actor", default="")
    p_upsert.add_argument("--reason", default=None)
    add_mutation_override_flags(p_upsert)

    p_close = sub.add_parser("close")
    p_close.add_argument("--id", required=True)
    p_close.add_argument("--reason", required=True, help="Reason: gap_resolved, gap_archived, duplicate, etc.")
    p_close.add_argument("--actor", default="")
    add_mutation_override_flags(p_close)

    p_match = sub.add_parser("match")
    p_match.add_argument("--id", required=True)
    p_match.add_argument("--gap-id", required=True)
    p_match.add_argument("--actor", default="")
    p_match.add_argument("--reason", default=None)
    add_mutation_override_flags(p_match)

    p_query = sub.add_parser("query")
    p_query.add_argument("--id", required=True)

    p_list = sub.add_parser("list")
    p_list.add_argument("--status", default=None, choices=["queued", "filed", "matched", "closed"])

    sub.add_parser("stats")
    sub.add_parser("project")
    sub.add_parser("backfill-gap-ids")

    args = parser.parse_args()
    cmd_map = {
        "bootstrap": cmd_bootstrap,
        "upsert": cmd_upsert,
        "close": cmd_close,
        "match": cmd_match,
        "query": cmd_query,
        "list": cmd_list,
        "stats": cmd_stats,
        "project": cmd_project,
        "backfill-gap-ids": cmd_backfill_gap_ids,
    }
    cmd_map[args.command](args)


if __name__ == "__main__":
    main()
