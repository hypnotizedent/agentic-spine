#!/usr/bin/env python3
"""intent-use-receipt-status — query HI -> work usage receipts."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import intent_use_receipts as iur


def ingress_dir(state_root: Path) -> Path:
    return state_root / "inputs" / "operator-ingress"


def unresolved_ingress(conn, state_root: Path, limit: int) -> list[dict]:
    rows = []
    for path in sorted(ingress_dir(state_root).glob("OI-*.yaml"), reverse=True):
        try:
            doc = yaml.safe_load(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if not isinstance(doc, dict):
            continue
        hi = doc.get("human_intent") if isinstance(doc.get("human_intent"), dict) else {}
        hi_ref = str(hi.get("intent_id") or "").strip()
        if not hi_ref:
            continue
        receipts = iur.query_receipts(conn, human_intent_ref=hi_ref, limit=1)
        if receipts:
            continue
        rows.append(
            {
                "ingress_id": str(doc.get("ingress_id", path.stem)),
                "human_intent_ref": hi_ref,
                "lifecycle_state": str(doc.get("lifecycle_state", "")),
                "disposition": str(doc.get("disposition", "")),
                "statement": str(hi.get("statement", "")),
                "path": str(path),
            }
        )
        if len(rows) >= limit:
            break
    return rows


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="intent-use-receipt-status",
        description="Query intent-use receipts by human intent or destination.",
    )
    parser.add_argument("--human-intent-ref", default="")
    parser.add_argument("--destination-type", default="")
    parser.add_argument("--destination-ref", default="")
    parser.add_argument("--unresolved-ingress", action="store_true")
    parser.add_argument("--limit", type=int, default=50)
    parser.add_argument("--json", action="store_true", dest="json_output")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args()

    try:
        conn = iur.connect(iur.db_path())
        iur.ensure_schema(conn)
        if args.self_check:
            conn.close()
            print("intent.use.receipt.status self-check PASS")
            return 0
        receipts = iur.query_receipts(
            conn,
            human_intent_ref=args.human_intent_ref,
            destination_type=args.destination_type,
            destination_ref=args.destination_ref,
            limit=args.limit,
        )
        unresolved = []
        if args.unresolved_ingress:
            unresolved = unresolved_ingress(conn, iur.default_state_root(), args.limit)
        conn.close()
    except Exception as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"intent.use.receipt.status FAIL: {exc}", file=sys.stderr)
        return 1

    payload = {
        "status": "ok",
        "count": len(receipts),
        "receipts": receipts,
        "unresolved_ingress_count": len(unresolved),
        "unresolved_ingress": unresolved,
    }
    if args.json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("intent.use.receipt.status")
        print(f"receipts: {len(receipts)}")
        for receipt in receipts:
            print(
                f"  {receipt['id']}  {receipt['human_intent_ref']}  "
                f"{receipt['used_as']} -> {receipt['destination_type']}:{receipt['destination_ref']}"
            )
        if args.unresolved_ingress:
            print(f"unresolved_ingress: {len(unresolved)}")
            for item in unresolved:
                print(f"  {item['ingress_id']}  {item['human_intent_ref']}  {item['disposition']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
