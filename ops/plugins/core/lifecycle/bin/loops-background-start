#!/usr/bin/env bash
set -euo pipefail

# loops.background.start — mark a loop as background-active with heartbeat metadata.
#
# Usage:
#   loops-background-start --loop-id LOOP-ID [--terminal-id ID] [--ttl-minutes N]
#                          [--blocked-by "reason"] [--note "text"]

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
SCOPES_DIR="$SPINE_STATE/loop-scopes"
LOOP_HEARTBEAT_DIR="$SPINE_STATE/loop-heartbeats"
CONTRACT="$ROOT/ops/bindings/stabilization.mode.yaml"
source "$ROOT/ops/lib/git-lock.sh"

usage() {
  cat <<'EOF'
Usage:
  loops-background-start --loop-id LOOP-ID [--terminal-id ID] [--ttl-minutes N]
                         [--blocked-by "reason"] [--note "text"]

Marks a loop as execution_mode=background and stamps heartbeat metadata:
- active_terminal
- last_heartbeat_utc
- heartbeat_ttl_minutes
EOF
}

loop_id=""
terminal_id="${SPINE_TERMINAL_ID:-}"
ttl_minutes=""
blocked_by=""
note=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --loop-id) loop_id="${2:?--loop-id requires a value}"; shift 2 ;;
    --terminal-id) terminal_id="${2:?--terminal-id requires a value}"; shift 2 ;;
    --ttl-minutes) ttl_minutes="${2:?--ttl-minutes requires a value}"; shift 2 ;;
    --blocked-by) blocked_by="${2:?--blocked-by requires a value}"; shift 2 ;;
    --note) note="${2:?--note requires a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$loop_id" ]] || { echo "FAIL: --loop-id required" >&2; exit 2; }

if [[ -z "$ttl_minutes" ]]; then
  ttl_minutes="$(yq e -r '.terminal_contract.heartbeat_ttl_minutes // 45' "$CONTRACT" 2>/dev/null || echo 45)"
fi
[[ "$ttl_minutes" =~ ^[0-9]+$ ]] || { echo "FAIL: --ttl-minutes must be numeric" >&2; exit 2; }

if [[ -z "$terminal_id" ]]; then
  terminal_id="$(hostname -s | tr '[:lower:]' '[:upper:]')-LOCAL-01"
fi

# Authority: SQLite (scope-file projection updated after)
scope_file="$SCOPES_DIR/${loop_id}.scope.md"

heartbeat_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Check loop exists in SQLite authority
BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/loops-authority-bridge"
loop_json="$("$BRIDGE" query --id "$loop_id" 2>/dev/null)" || {
  echo "FAIL: loop not found in SQLite: $loop_id" >&2; exit 1
}

acquire_git_lock gaps || exit 1
trap 'release_git_lock' EXIT INT TERM

python3 - "$loop_id" "$terminal_id" "$ttl_minutes" "$heartbeat_at" "$blocked_by" "$note" "$SCOPES_DIR" "$ROOT" <<'PY'
import json
import os
import sys
from pathlib import Path

repo_root = Path(sys.argv[8])
sys.path.insert(0, str(repo_root / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import loops_sql_authority as lsa

loop_id = sys.argv[1]
terminal_id = sys.argv[2]
ttl_minutes = sys.argv[3]
heartbeat_at = sys.argv[4]
blocked_by = sys.argv[5]
note = sys.argv[6]
scopes_dir = Path(sys.argv[7])

state = os.environ.get('SPINE_STATE') or str(Path.home() / 'code' / '.runtime' / 'spine' / 'state')
db_path = Path(os.environ.get('LOOPS_DB_PATH', str(Path(state) / 'shared_authority.db')))
conn = lsa.connect(db_path)
lsa.ensure_schema(conn)

loop = lsa.get_loop(conn, loop_id)
if not loop:
    print(f"FAIL: loop not found in SQLite: {loop_id}", file=sys.stderr)
    sys.exit(1)

# Update fields
loop["execution_mode"] = "background"
loop["active_terminal"] = terminal_id
loop["last_heartbeat_utc"] = heartbeat_at
loop["heartbeat_ttl_minutes"] = int(ttl_minutes)
if blocked_by:
    loop["blocked_by"] = blocked_by
if note:
    loop["operator_note"] = note

lsa.upsert_loop(conn, loop)
conn.commit()

# Refresh scope-file projection from SQLite
lsa.project_to_scope_files(conn, scopes_dir)
conn.close()
PY

trap - EXIT INT TERM
release_git_lock

mkdir -p "$LOOP_HEARTBEAT_DIR"
safe_loop_id="$(printf '%s' "$loop_id" | tr -cs 'A-Za-z0-9._-' '_')"
loop_heartbeat_file="$LOOP_HEARTBEAT_DIR/${safe_loop_id}.yaml"
loop_tmp_file="${loop_heartbeat_file}.tmp.$$"
cat > "$loop_tmp_file" <<EOF
version: 1
loop_id: "$loop_id"
terminal_id: "$terminal_id"
last_heartbeat_utc: "$heartbeat_at"
heartbeat_ttl_minutes: $ttl_minutes
expires_at: ""
terminal_status: "active"
EOF
mv "$loop_tmp_file" "$loop_heartbeat_file"

echo "loops.background.start"
echo "loop_id: $loop_id"
echo "execution_mode: background"
echo "active_terminal: $terminal_id"
echo "last_heartbeat_utc: $heartbeat_at"
echo "heartbeat_ttl_minutes: $ttl_minutes"
if [[ -n "$blocked_by" ]]; then
  echo "blocked_by: $blocked_by"
fi
if [[ -n "$note" ]]; then
  echo "operator_note: $note"
fi
echo "scope_file: $scope_file"
echo "loop_heartbeat_file: $loop_heartbeat_file"
