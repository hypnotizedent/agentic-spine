#!/usr/bin/env python3
"""transition.apply --check — read-only parity oracle for projection surfaces.

Compares canonical authority surfaces (scope files, SQLite) against derived
surfaces (joined-state, status, completion-state reconciler) and reports
whether they agree.

Design authority: TRANSITION-APPLY-DESIGN-20260416.md (T1)

Usage:
    transition-parity-check [--json] [--strict]

Flags:
    --json      Emit structured JSON (default: human-readable)
    --strict    Exit nonzero on warnings too, not just failures
    -h, --help  Show this help

Exit codes:
    0   parity: pass (all checks agree)
    1   parity: fail (canonical surfaces disagree, or derived disagrees with canonical)
    2   parity: degraded (a surface was unavailable)
    3   usage error
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))


# ── Path resolution ──────────────────────────────────────────────────

def resolve_repo_root() -> Path:
    """Resolve the real repo root, even from a worktree."""
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=str(SCRIPT_DIR), capture_output=True, text=True, check=True, timeout=5,
        )
        return Path(proc.stdout.strip()).parent
    except (subprocess.SubprocessError, OSError):
        return SCRIPT_DIR.parents[4]


def resolve_state_root(repo_root: Path) -> Path:
    return Path(
        os.environ.get("SPINE_STATE")
        or str(repo_root.parent / ".runtime" / "spine" / "state")
    )


# ── Surface readers ──────────────────────────────────────────────────

def read_reconciler(repo_root: Path, state_root: Path) -> dict[str, Any] | None:
    """Run completion-state reconciler and return its output."""
    try:
        import completion_state_reconciler as csr
        return csr.reconcile(str(repo_root), str(state_root))
    except Exception as exc:
        return {"_error": f"reconciler unavailable: {exc}"}


def read_sqlite_loops(state_root: Path) -> list[dict[str, Any]] | None:
    """Read loop state from SQLite authority."""
    try:
        import loops_sql_authority as lsa
        db_path, _ = lsa.resolve_paths(state_root)
        conn = lsa.connect(db_path)
        try:
            lsa.ensure_schema(conn)
            all_loops = lsa.list_loops(conn, status="all")
            return all_loops
        finally:
            conn.close()
    except Exception as exc:
        return None


def read_status_json(repo_root: Path) -> dict[str, Any] | None:
    """Run ops status --json and return parsed output."""
    try:
        proc = subprocess.run(
            [str(repo_root / "bin" / "ops"), "status", "--json"],
            capture_output=True, text=True, check=False, timeout=30,
            cwd=str(repo_root),
        )
        if proc.returncode != 0:
            return None
        return json.loads(proc.stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return None


def _read_scope_frontmatter(path: Path) -> dict[str, Any]:
    """Read YAML frontmatter from a scope file without regex splitting."""
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}

    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}

    end_idx = None
    for idx in range(1, len(lines)):
        if lines[idx].strip() == "---":
            end_idx = idx
            break
    if end_idx is None:
        return {}

    try:
        frontmatter = yaml.safe_load("\n".join(lines[1:end_idx])) or {}
    except yaml.YAMLError:
        return {}
    if not isinstance(frontmatter, dict):
        return {}
    return frontmatter


# ── Parity checks ────────────────────────────────────────────────────

LIVE_STATUSES = {"active", "open", "draft", "planned"}
CLOSED_STATUSES = {"closed", "completed", "deferred", "superseded", "abandoned", "landed"}
RECEIPT_DISCIPLINE_EPOCH_UTC = "2026-04-14T00:00:00Z"


def _parse_utc_timestamp(raw: str | None) -> datetime | None:
    """Parse spine timestamp strings into UTC-aware datetimes."""
    if not raw:
        return None
    text = str(raw).strip()
    if not text:
        return None
    normalized = text.replace("Z", "+00:00")
    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        try:
            parsed = datetime.strptime(text, "%Y-%m-%d %H:%M:%S")
        except ValueError:
            try:
                parsed = datetime.strptime(text, "%Y-%m-%d")
            except ValueError:
                return None
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


RECEIPT_DISCIPLINE_EPOCH = _parse_utc_timestamp(RECEIPT_DISCIPLINE_EPOCH_UTC)
LOOP_ID_DATE_RE = re.compile(r"-(\d{8}|\d{4}-\d{2}-\d{2})$")


def _loop_id_epoch_hint(loop_id: str | None) -> datetime | None:
    if not loop_id:
        return None
    match = LOOP_ID_DATE_RE.search(str(loop_id).strip())
    if not match:
        return None
    raw = match.group(1)
    if len(raw) == 8:
        raw = f"{raw[0:4]}-{raw[4:6]}-{raw[6:8]}"
    return _parse_utc_timestamp(raw)


def _receipt_expected(loop: dict[str, Any]) -> bool:
    """Only require loop closeout receipts after the modern discipline epoch."""
    if RECEIPT_DISCIPLINE_EPOCH is None:
        return True
    closed_at = _parse_utc_timestamp(
        loop.get("closed_at")
        or loop.get("created")
        or _loop_id_epoch_hint(loop.get("loop_id"))
        or loop.get("updated_at_utc")
        or loop.get("created_at_utc")
    )
    if closed_at is None:
        return True
    return closed_at >= RECEIPT_DISCIPLINE_EPOCH


def check_c1_scope_vs_sqlite(
    state_root: Path,
    sqlite_loops: list[dict[str, Any]],
) -> dict[str, Any]:
    """C1: Every live scope file's loop_id+status matches its SQLite row."""
    scopes_dir = state_root / "loop-scopes"
    archive_dir = state_root / "archive" / "closed-loop-scopes"

    # Build SQLite lookup
    sqlite_by_id: dict[str, dict[str, Any]] = {}
    for loop in sqlite_loops:
        lid = loop.get("loop_id", "")
        if lid:
            sqlite_by_id[lid] = loop

    failures: list[str] = []

    # Check live scope files
    if scopes_dir.is_dir():
        for path in sorted(scopes_dir.glob("*.scope.md")):
            front = _parse_scope_frontmatter(path)
            loop_id = front.get("loop_id", "")
            scope_status = front.get("status", "unknown").lower()
            if not loop_id:
                continue

            sqlite_row = sqlite_by_id.get(loop_id)
            if sqlite_row is None:
                failures.append(
                    f"{loop_id}: live scope file exists (status={scope_status}) "
                    f"but no SQLite row"
                )
                continue

            sqlite_status = (sqlite_row.get("status") or "unknown").lower()
            if scope_status in LIVE_STATUSES and sqlite_status in CLOSED_STATUSES:
                failures.append(
                    f"{loop_id}: scope says '{scope_status}' but SQLite says "
                    f"'{sqlite_status}'"
                )
            elif scope_status in CLOSED_STATUSES and sqlite_status in LIVE_STATUSES:
                failures.append(
                    f"{loop_id}: scope says '{scope_status}' but SQLite says "
                    f"'{sqlite_status}'"
                )

    # Check archived scope files that SQLite thinks are still live
    if archive_dir.is_dir():
        for path in sorted(archive_dir.glob("*.scope.md")):
            front = _parse_scope_frontmatter(path)
            loop_id = front.get("loop_id", "")
            if not loop_id:
                continue
            sqlite_row = sqlite_by_id.get(loop_id)
            if sqlite_row is None:
                continue
            sqlite_status = (sqlite_row.get("status") or "unknown").lower()
            if sqlite_status in LIVE_STATUSES:
                failures.append(
                    f"{loop_id}: archived scope file but SQLite says "
                    f"'{sqlite_status}' (expected closed)"
                )

    return {
        "check": "C1",
        "name": "scope_vs_sqlite",
        "result": "pass" if not failures else "fail",
        "failures": failures,
    }


def check_c2_scope_vs_reconciler(
    state_root: Path,
    reconciler_output: dict[str, Any],
) -> dict[str, Any]:
    """C2: Every loop the reconciler classified as non-live has no live scope file."""
    scopes_dir = state_root / "loop-scopes"
    failures: list[str] = []

    # Get loop classifications from reconciler
    classifications = reconciler_output.get("classifications", [])
    non_live_loops: set[str] = set()
    for c in classifications:
        if c.get("object_class") != "loop":
            continue
        if not c.get("is_live", True):
            identity = c.get("identity", "")
            if identity:
                non_live_loops.add(identity)

    # Check that non-live loops don't have live scope files
    if scopes_dir.is_dir():
        for path in sorted(scopes_dir.glob("*.scope.md")):
            front = _parse_scope_frontmatter(path)
            loop_id = front.get("loop_id", "")
            if loop_id in non_live_loops:
                failures.append(
                    f"{loop_id}: reconciler classified as non-live but "
                    f"live scope file exists at {path.name}"
                )

    return {
        "check": "C2",
        "name": "scope_vs_reconciler",
        "result": "pass" if not failures else "fail",
        "failures": failures,
    }


def check_c3_sqlite_vs_status(
    sqlite_loops: list[dict[str, Any]],
    status_output: dict[str, Any],
) -> dict[str, Any]:
    """C3: status --json open_loops set == SQLite live-status loop set."""
    # SQLite live loops
    sqlite_open: set[str] = set()
    for loop in sqlite_loops:
        status = (loop.get("status") or "unknown").lower()
        lid = loop.get("loop_id", "")
        if status in LIVE_STATUSES and lid:
            sqlite_open.add(lid)

    # Status open loops
    status_open: set[str] = set()
    open_loops = status_output.get("open_loops", [])
    if isinstance(open_loops, list):
        for entry in open_loops:
            if isinstance(entry, dict):
                lid = entry.get("loop_id", "")
            elif isinstance(entry, str):
                lid = entry
            else:
                continue
            if lid:
                status_open.add(lid)

    failures: list[str] = []
    in_sqlite_not_status = sqlite_open - status_open
    in_status_not_sqlite = status_open - sqlite_open

    for lid in sorted(in_sqlite_not_status):
        failures.append(
            f"{lid}: in SQLite (live) but not in status --json open_loops"
        )
    for lid in sorted(in_status_not_sqlite):
        failures.append(
            f"{lid}: in status --json open_loops but not in SQLite as live"
        )

    return {
        "check": "C3",
        "name": "sqlite_vs_status",
        "result": "pass" if not failures else "fail",
        "failures": failures,
    }


def check_c4_reconciler_vs_status(
    reconciler_output: dict[str, Any],
    status_output: dict[str, Any],
) -> dict[str, Any]:
    """C4: status open loop count == reconciler open count."""
    # Reconciler open loops
    reconciler_open: set[str] = set()
    for c in reconciler_output.get("classifications", []):
        if c.get("object_class") != "loop":
            continue
        if c.get("computed_state") == "open":
            identity = c.get("identity", "")
            if identity:
                reconciler_open.add(identity)

    # Status open loops
    status_open: set[str] = set()
    open_loops = status_output.get("open_loops", [])
    if isinstance(open_loops, list):
        for entry in open_loops:
            if isinstance(entry, dict):
                lid = entry.get("loop_id", "")
            elif isinstance(entry, str):
                lid = entry
            else:
                continue
            if lid:
                status_open.add(lid)

    failures: list[str] = []
    in_reconciler_not_status = reconciler_open - status_open
    in_status_not_reconciler = status_open - reconciler_open

    for lid in sorted(in_reconciler_not_status):
        failures.append(
            f"{lid}: reconciler says open but status does not show it"
        )
    for lid in sorted(in_status_not_reconciler):
        failures.append(
            f"{lid}: status shows open but reconciler does not classify as open"
        )

    return {
        "check": "C4",
        "name": "reconciler_vs_status",
        "result": "pass" if not failures else "fail",
        "failures": failures,
    }


# ── Advisory warnings ────────────────────────────────────────────────

def check_warnings(
    state_root: Path,
    sqlite_loops: list[dict[str, Any]],
    reconciler_output: dict[str, Any],
) -> list[dict[str, str]]:
    """Advisory checks that do not block success."""
    warnings: list[dict[str, str]] = []
    evidence_dir = Path(os.environ.get("HOME", "")) / "code" / ".evidence" / "spine" / "loop-closeouts"

    # Closed loops without receipts
    for loop in sqlite_loops:
        status = (loop.get("status") or "").lower()
        lid = loop.get("loop_id", "")
        if status in CLOSED_STATUSES and lid:
            if not _receipt_expected(loop):
                continue
            receipt_path = evidence_dir / f"{lid}.closeout.md"
            if not receipt_path.exists():
                warnings.append({
                    "type": "missing_receipt",
                    "loop_id": lid,
                    "message": f"{lid}: closed but no receipt at {receipt_path}",
                })

    # Stale handoff references
    handoffs_dir = state_root / "handoffs"
    if handoffs_dir.is_dir():
        closed_loop_ids: set[str] = set()
        for c in reconciler_output.get("classifications", []):
            if c.get("object_class") == "loop" and not c.get("is_live", True):
                identity = c.get("identity", "")
                if identity:
                    closed_loop_ids.add(identity)

        for path in sorted(handoffs_dir.glob("HO-*.yaml")):
            try:
                import yaml
                text = path.read_text(encoding="utf-8", errors="replace")
                payload = yaml.safe_load(text)
            except Exception:
                continue
            if not isinstance(payload, dict):
                continue
            state = str(payload.get("state", "")).lower()
            if state != "active":
                continue
            loops_ref = payload.get("loops", [])
            if isinstance(loops_ref, list):
                for ref in loops_ref:
                    ref_str = str(ref).strip()
                    if ref_str in closed_loop_ids:
                        warnings.append({
                            "type": "stale_handoff_reference",
                            "handoff": path.stem,
                            "loop_id": ref_str,
                            "message": f"{path.stem}: references {ref_str} which is non-live",
                        })

    return warnings


# ── Frontmatter parser ───────────────────────────────────────────────

def _parse_scope_frontmatter(path: Path) -> dict[str, str]:
    """Extract key fields from scope file YAML frontmatter."""
    result: dict[str, str] = {}
    frontmatter = _read_scope_frontmatter(path)
    for key in ("loop_id", "status", "owner", "disposition", "created"):
        value = frontmatter.get(key)
        if value is None:
            continue
        result[key] = str(value).strip()
    return result


# ── Main ─────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(
        description="transition.apply --check: read-only parity oracle for projection surfaces."
    )
    parser.add_argument("--json", action="store_true", help="Emit structured JSON output")
    parser.add_argument("--strict", action="store_true", help="Exit nonzero on warnings too")
    parser.add_argument("--", dest="passthrough_separator", nargs="?", help=argparse.SUPPRESS)
    args, _unknown = parser.parse_known_args()

    repo_root = resolve_repo_root()
    state_root = resolve_state_root(repo_root)
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    # ── Collect surface data ──────────────────────────────────────────

    checks: list[dict[str, Any]] = []
    degraded_surfaces: list[str] = []

    # Reconciler
    reconciler_output = read_reconciler(repo_root, state_root)
    if reconciler_output is None or "_error" in (reconciler_output or {}):
        err = (reconciler_output or {}).get("_error", "unknown error")
        degraded_surfaces.append(f"reconciler: {err}")
        reconciler_output = None

    # SQLite
    sqlite_loops = read_sqlite_loops(state_root)
    if sqlite_loops is None:
        degraded_surfaces.append("sqlite: loops authority unavailable")

    # Status
    status_output = read_status_json(repo_root)
    if status_output is None:
        degraded_surfaces.append("status: ops status --json unavailable")

    # ── Run checks ────────────────────────────────────────────────────

    # C1: scope vs SQLite (needs SQLite)
    if sqlite_loops is not None:
        checks.append(check_c1_scope_vs_sqlite(state_root, sqlite_loops))
    else:
        checks.append({
            "check": "C1", "name": "scope_vs_sqlite",
            "result": "degraded", "failures": ["SQLite unavailable"],
        })

    # C2: scope vs reconciler (needs reconciler)
    if reconciler_output is not None:
        checks.append(check_c2_scope_vs_reconciler(state_root, reconciler_output))
    else:
        checks.append({
            "check": "C2", "name": "scope_vs_reconciler",
            "result": "degraded", "failures": ["reconciler unavailable"],
        })

    # C3: SQLite vs status (needs both)
    if sqlite_loops is not None and status_output is not None:
        checks.append(check_c3_sqlite_vs_status(sqlite_loops, status_output))
    else:
        missing = []
        if sqlite_loops is None:
            missing.append("SQLite")
        if status_output is None:
            missing.append("status")
        checks.append({
            "check": "C3", "name": "sqlite_vs_status",
            "result": "degraded",
            "failures": [f"{', '.join(missing)} unavailable"],
        })

    # C4: reconciler vs status (needs both)
    if reconciler_output is not None and status_output is not None:
        checks.append(check_c4_reconciler_vs_status(reconciler_output, status_output))
    else:
        missing = []
        if reconciler_output is None:
            missing.append("reconciler")
        if status_output is None:
            missing.append("status")
        checks.append({
            "check": "C4", "name": "reconciler_vs_status",
            "result": "degraded",
            "failures": [f"{', '.join(missing)} unavailable"],
        })

    # ── Warnings ──────────────────────────────────────────────────────

    warnings: list[dict[str, str]] = []
    if sqlite_loops is not None and reconciler_output is not None:
        warnings = check_warnings(state_root, sqlite_loops, reconciler_output)

    # ── Verdict ───────────────────────────────────────────────────────

    has_fail = any(c["result"] == "fail" for c in checks)
    has_degraded = any(c["result"] == "degraded" for c in checks)

    if has_fail:
        parity = "fail"
        exit_code = 1
    elif has_degraded:
        parity = "degraded"
        exit_code = 2
    elif args.strict and warnings:
        parity = "pass_with_warnings"
        exit_code = 1
    else:
        parity = "pass"
        exit_code = 0

    total_failures = sum(len(c.get("failures", [])) for c in checks)

    # ── Output ────────────────────────────────────────────────────────

    result = {
        "capability": "transition.parity.check",
        "snapshot_timestamp": timestamp,
        "parity": parity,
        "checks": checks,
        "total_failures": total_failures,
        "degraded_surfaces": degraded_surfaces,
        "warnings": warnings,
        "warning_count": len(warnings),
    }

    if args.json:
        json.dump(result, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print("transition.parity.check")
        print(f"  snapshot: {timestamp}")
        print(f"  parity:   {parity}")
        print()

        for check in checks:
            status_marker = {
                "pass": "PASS",
                "fail": "FAIL",
                "degraded": "DEGRADED",
            }.get(check["result"], check["result"])
            print(f"  [{status_marker:8s}] {check['check']}: {check['name']}")
            for f in check.get("failures", []):
                print(f"           {f}")

        if warnings:
            print()
            print(f"  Warnings ({len(warnings)}):")
            for w in warnings:
                print(f"    [{w['type']}] {w['message']}")

        if degraded_surfaces:
            print()
            print(f"  Degraded surfaces ({len(degraded_surfaces)}):")
            for d in degraded_surfaces:
                print(f"    {d}")

        print()
        print(f"  total_failures: {total_failures}")
        print(f"  exit_code: {exit_code}")

    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
