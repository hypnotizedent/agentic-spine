#!/usr/bin/env python3
# Authority: shared_authority.db -> friction table
"""Backfill filed friction items that are missing filed_gap_id.

Searches for gap IDs by:
  1. Reading the mutation YAML at filed_request_path (if present)
  2. Matching by capability+description against recent gaps in SQLite

Usage:
  friction-backfill-gap-ids [--dry-run] [--json]
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parents[5]

# ── SQLite authority (required for this script) ──────────────────
sys.path.insert(0, str(ROOT / "ops/plugins/core/lifecycle/lib"))
try:
    from gaps_sql_authority import (
        resolve_paths as _gsa_resolve_paths,
        connect as _gsa_connect,
        ensure_schema as _gsa_ensure_schema,
        fetch_gaps as _gsa_fetch_gaps,
    )
    from gaps_sql_authority import (
        ensure_friction_schema,
        upsert_friction,
        fetch_friction_filed_missing_gap_id,
    )
    SQLITE_AVAILABLE = True
except ImportError:
    SQLITE_AVAILABLE = False


def _sqlite_conn():
    """Open and return a ready SQLite connection, or None."""
    if not SQLITE_AVAILABLE:
        return None
    try:
        db_path, _ = _gsa_resolve_paths(ROOT)
        conn = _gsa_connect(db_path)
        _gsa_ensure_schema(conn)
        ensure_friction_schema(conn)
        return conn
    except Exception:
        return None


def try_extract_gap_id_from_request(request_path: str) -> str | None:
    """Read a lane-safe mutation YAML and extract the resulting gap ID."""
    p = Path(request_path).expanduser()
    if not p.exists():
        return None
    try:
        doc = yaml.safe_load(p.read_text(encoding="utf-8")) or {}
        # Lane-safe requests may store the result in various keys.
        for key in ("result_gap_id", "gap_id", "filed_gap_id"):
            val = doc.get(key)
            if val and str(val).startswith("GAP-OP-"):
                return str(val).strip()
        # Check nested results
        result = doc.get("result") or {}
        if isinstance(result, dict):
            for key in ("gap_id", "id"):
                val = result.get(key)
                if val and str(val).startswith("GAP-OP-"):
                    return str(val).strip()
    except Exception:
        pass
    return None


def try_match_by_capability(item: dict[str, Any], open_gaps: list[dict[str, Any]]) -> str | None:
    """Try to match a friction item to a gap by capability+description overlap."""
    capability = str(item.get("capability", "")).strip().lower()
    fingerprint = str(item.get("fingerprint", "")).strip()
    friction_id = str(item.get("friction_id", "")).strip()
    if not capability:
        return None

    for gap in open_gaps:
        desc = str(gap.get("description", "")).lower()
        gap_id = str(gap.get("id", "")).strip()
        if not gap_id:
            continue
        # Match by embedded fingerprint or friction_id in gap description
        if fingerprint and fingerprint in desc:
            return gap_id
        if friction_id and friction_id in desc:
            return gap_id
        # Match by capability name in gap description
        if capability in desc:
            return gap_id
    return None


def main() -> int:
    ap = argparse.ArgumentParser(description="Backfill filed friction items missing filed_gap_id")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    conn = _sqlite_conn()
    if conn is None:
        msg = "friction-backfill-gap-ids FAIL: SQLite friction functions not available"
        if args.json:
            print(json.dumps({"status": "unavailable", "error": msg}))
        else:
            print(msg, file=sys.stderr)
        return 1

    try:
        missing = fetch_friction_filed_missing_gap_id(conn)
    except Exception as e:
        msg = f"friction-backfill-gap-ids FAIL: {e}"
        if args.json:
            print(json.dumps({"status": "error", "error": msg}))
        else:
            print(msg, file=sys.stderr)
        conn.close()
        return 1

    if not missing:
        payload = {
            "status": "ok",
            "backfilled": 0,
            "still_missing": 0,
            "total_checked": 0,
        }
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print("friction-backfill-gap-ids")
            print("status: ok")
            print("nothing to backfill")
        conn.close()
        return 0

    # Load all gaps for capability matching
    all_gaps = _gsa_fetch_gaps(conn)

    backfilled = 0
    still_missing = 0
    details: list[dict[str, str]] = []

    for item in missing:
        friction_id = str(item.get("friction_id", "")).strip()
        request_path = str(item.get("filed_request_path", "")).strip()

        gap_id = None

        # Strategy 1: extract from filed_request_path
        if request_path:
            gap_id = try_extract_gap_id_from_request(request_path)

        # Strategy 2: match by capability/fingerprint against gaps
        if not gap_id:
            gap_id = try_match_by_capability(item, all_gaps)

        if gap_id:
            if not args.dry_run:
                item["filed_gap_id"] = gap_id
                upsert_friction(conn, item)
            backfilled += 1
            details.append({"friction_id": friction_id, "gap_id": gap_id, "action": "backfilled"})
        else:
            still_missing += 1
            details.append({"friction_id": friction_id, "gap_id": "", "action": "unresolved"})

    if not args.dry_run:
        conn.commit()
    conn.close()

    payload = {
        "status": "ok",
        "backfilled": backfilled,
        "still_missing": still_missing,
        "total_checked": len(missing),
        "dry_run": args.dry_run,
        "details": details,
    }

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("friction-backfill-gap-ids")
        print("status: ok")
        print(f"backfilled: {backfilled}")
        print(f"still_missing: {still_missing}")
        print(f"total_checked: {len(missing)}")
        if args.dry_run:
            print("dry_run: true")
        for d in details:
            print(f"  {d['friction_id']}: {d['action']}" + (f" -> {d['gap_id']}" if d['gap_id'] else ""))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
