#!/usr/bin/env python3
"""Promote a V2.5 patch receipt into a controller review worktree."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
WORKSPACE_ROOT = ROOT.parent
RUNTIME_ROOT = Path(os.environ.get("SPINE_RUNTIME_ROOT") or WORKSPACE_ROOT / ".runtime" / "spine")
STATE_ROOT = Path(os.environ.get("SPINE_STATE") or RUNTIME_ROOT / "state")
TASK_ROOT = STATE_ROOT / "agent-tasks"
REVIEW_ROOT = RUNTIME_ROOT / "tmp" / "worktrees" / "agentic-spine"
RECEIPT_ROOT = STATE_ROOT / "domain-state" / "ai-patch-reviews"
CONTRACT = ROOT / "ops" / "bindings" / "ai.patch.review.contract.yaml"
WORKTREE_CONTRACT = ROOT / "ops" / "bindings" / "worktree.lifecycle.contract.yaml"


class ReviewError(RuntimeError):
    pass


def now_utc() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd: list[str], cwd: Path, timeout: int = 120) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, timeout=timeout, check=False)


def load_yaml(path: Path) -> dict[str, Any]:
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as exc:
        raise ReviewError(f"cannot read YAML {path}: {exc}") from exc
    if not isinstance(payload, dict):
        raise ReviewError(f"expected mapping in {path}")
    return payload


def safe_slug(value: str) -> str:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip("-")
    return slug[:120] or "patch-review"


def safe_wave_slug(value: str) -> str:
    return safe_slug(value).upper()


def task_file_for(task_id: str) -> Path:
    for state in ("done", "failed", "cancelled", "queued", "claimed"):
        path = TASK_ROOT / state / f"{task_id}.yaml"
        if path.is_file():
            return path
    raise ReviewError(f"task not found: {task_id}")


def validate_task(task: dict[str, Any], task_file: Path) -> dict[str, Any]:
    if task.get("status") != "done":
        raise ReviewError("only done V2.5 patch tasks can be promoted")
    proof = task.get("bridge_proof")
    if not isinstance(proof, dict):
        raise ReviewError("task missing bridge_proof")
    required = {
        "scope": "tool_using_agent_v2_5_patch_apply_sandbox",
        "tool_set": "patch_apply_sandbox",
        "status": "completed",
        "patch_apply_status": "applied",
        "worktree_lifecycle_contract": "ops/bindings/worktree.lifecycle.contract.yaml",
        "lease_filename": ".spine-lane-lease.yaml",
        "sandbox_cleanup": "removed",
        "mutation_access": "leased_sandbox_worktree_only",
    }
    for key, expected in required.items():
        if proof.get(key) != expected:
            raise ReviewError(f"task {task_file.name} bridge_proof {key} must be {expected!r}")
    if proof.get("sandbox_worktree_retained") is not False:
        raise ReviewError("V2.5 sandbox must be removed before promotion")
    if proof.get("push_performed") is not False or proof.get("merge_performed") is not False:
        raise ReviewError("V2.5 proof must show no push and no merge")
    expected_files = proof.get("expected_patch_files")
    actual_files = proof.get("actual_patch_files")
    if not isinstance(expected_files, list) or expected_files != actual_files:
        raise ReviewError("expected_patch_files must exactly equal actual_patch_files")
    if proof.get("side_effect_files") != []:
        raise ReviewError("side_effect_files must be empty")
    patch_path = Path(str(proof.get("patch_artifact_path") or ""))
    if not patch_path.is_file():
        raise ReviewError(f"patch artifact missing: {patch_path}")
    if STATE_ROOT not in patch_path.parents:
        raise ReviewError(f"patch artifact must live under SPINE_STATE: {patch_path}")
    return proof


def existing_receipt(task_id: str) -> Path | None:
    path = RECEIPT_ROOT / f"{task_id}.yaml"
    return path if path.is_file() else None


def write_yaml(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")


def promote(task_id: str, loop_id: str, retain_existing: bool = False) -> dict[str, Any]:
    if not CONTRACT.is_file():
        raise ReviewError(f"contract missing: {CONTRACT}")
    task_file = task_file_for(task_id)
    task = load_yaml(task_file)
    proof = validate_task(task, task_file)
    receipt_path = RECEIPT_ROOT / f"{task_id}.yaml"
    if receipt_path.exists() and not retain_existing:
        existing = load_yaml(receipt_path)
        if existing.get("review_status") == "promoted_to_review_worktree":
            return {"status": "already_promoted", "receipt_path": str(receipt_path), "review_worktree": existing.get("review_worktree")}
        raise ReviewError(f"review receipt already exists with status={existing.get('review_status')!r}")

    patch_path = Path(str(proof["patch_artifact_path"]))
    expected_files = sorted(str(item) for item in proof["expected_patch_files"])
    slug = safe_slug(task_id)
    wave_slug = safe_wave_slug(task_id)
    review_id = f"REVIEW-{slug}"
    wave_id = f"WAVE-AI-PATCH-REVIEW-{wave_slug}"
    branch = f"codex/{wave_id}"
    review_worktree = REVIEW_ROOT / wave_id

    if review_worktree.exists():
        shutil.rmtree(review_worktree)
    REVIEW_ROOT.mkdir(parents=True, exist_ok=True)

    if not loop_id.strip():
        raise ReviewError("--loop-id required so the review worktree is born through governed wave state")
    start = run(
        [
            str(ROOT / "bin" / "ops"),
            "wave",
            "start",
            wave_id,
            "--loop-id",
            loop_id.strip(),
            "--objective",
            f"Controller review worktree for {task_id}",
            "--claimed-paths",
            ",".join(expected_files),
            "--repo",
            str(ROOT),
        ],
        ROOT,
    )
    if start.returncode != 0:
        raise ReviewError(f"ops wave start failed: {(start.stderr or start.stdout).strip()}")
    if not review_worktree.is_dir():
        raise ReviewError(f"review worktree not created by wave start: {review_worktree}")

    lease = {
        "lane": review_id,
        "owner": "ai.patch.review.promote",
        "task_id": task_id,
        "created_at_utc": now_utc(),
        "ttl_hours": 24,
        "contract": "ops/bindings/worktree.lifecycle.contract.yaml",
    }
    write_yaml(review_worktree / ".spine-lane-lease.yaml", lease)

    check = run(["git", "apply", "--check", str(patch_path)], review_worktree)
    if check.returncode != 0:
        raise ReviewError(f"git apply --check failed: {(check.stderr or check.stdout).strip()}")
    apply = run(["git", "apply", str(patch_path)], review_worktree)
    if apply.returncode != 0:
        raise ReviewError(f"git apply failed: {(apply.stderr or apply.stdout).strip()}")
    diff_check = run(["git", "diff", "--check"], review_worktree)
    status = run(["git", "status", "--short"], review_worktree)
    changed = sorted(line[3:] for line in status.stdout.splitlines() if line.strip() and not line.endswith(".spine-lane-lease.yaml"))
    side_effect_files = sorted(set(changed) - set(expected_files))
    if changed != expected_files:
        raise ReviewError(f"review worktree changed files {changed!r} do not match expected {expected_files!r}")
    if diff_check.returncode != 0:
        raise ReviewError(f"git diff --check failed: {(diff_check.stderr or diff_check.stdout).strip()}")
    add_paths = run(["git", "add", "--", *expected_files], review_worktree)
    if add_paths.returncode != 0:
        raise ReviewError(f"git add failed: {(add_paths.stderr or add_paths.stdout).strip()}")
    commit_msg = (
        f"AI patch review: {task_id}\n\n"
        "Bridge-Tier: tool_using_agent_v2_5_patch_apply_sandbox\n"
        f"Patch-Review-Task: {task_id}\n"
        "Push-Performed: false\n"
        "Merge-Performed: false\n"
    )
    commit = run(
        [
            "git",
            "-c",
            "user.name=SPINE-MAILROOM-EXECUTION-HOST",
            "-c",
            "user.email=spine-mailroom@localhost",
            "commit",
            "-m",
            commit_msg,
        ],
        review_worktree,
    )
    if commit.returncode != 0:
        raise ReviewError(f"git commit failed: {(commit.stderr or commit.stdout).strip()}")
    rev_parse = run(["git", "rev-parse", "HEAD"], review_worktree)
    if rev_parse.returncode != 0:
        raise ReviewError(f"git rev-parse failed: {(rev_parse.stderr or rev_parse.stdout).strip()}")
    review_commit = rev_parse.stdout.strip()
    final_status = run(["git", "status", "--short"], review_worktree)
    if final_status.returncode != 0:
        raise ReviewError(f"git status failed: {(final_status.stderr or final_status.stdout).strip()}")

    receipt = {
        "review_id": review_id,
        "review_status": "promoted_to_review_worktree",
        "review_state": "promoted_to_review_worktree",
        "task_id": task_id,
        "source_task_file": str(task_file),
        "created_at_utc": now_utc(),
        "capability": "ai.patch.review.promote",
        "patch_artifact_path": str(patch_path),
        "expected_patch_files": expected_files,
        "actual_patch_files": changed,
        "side_effect_files": side_effect_files,
        "review_worktree": str(review_worktree),
        "review_wave_id": wave_id,
        "review_branch": branch,
        "review_commit": review_commit,
        "lease_filename": ".spine-lane-lease.yaml",
        "lease_ttl_hours": 24,
        "worktree_lifecycle_contract": "ops/bindings/worktree.lifecycle.contract.yaml",
        "verify_command": ["git", "diff", "--check"],
        "verify_rc": diff_check.returncode,
        "worktree_status": final_status.stdout.splitlines(),
        "push_performed": False,
        "merge_performed": False,
        "commit_performed": True,
        "mutation_access": "controller_review_worktree_only",
    }
    write_yaml(receipt_path, receipt)
    return {"status": "promoted", "receipt_path": str(receipt_path), "review_worktree": str(review_worktree), "review_wave_id": wave_id, "review_branch": branch}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task-id", required=False)
    parser.add_argument("--loop-id", default=os.environ.get("SPINE_LOOP_ID", ""))
    parser.add_argument("--self-check", action="store_true")
    parser.add_argument("--json", action="store_true", dest="json_output")
    args = parser.parse_args()
    if args.self_check:
        if not CONTRACT.is_file():
            print(f"ai.patch.review.promote self-check FAIL: missing {CONTRACT}", file=sys.stderr)
            return 1
        print("ai.patch.review.promote self-check PASS")
        return 0
    if not args.task_id:
        print("ai.patch.review.promote FAIL: --task-id required", file=sys.stderr)
        return 2
    try:
        result = promote(args.task_id, args.loop_id)
    except Exception as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"ai.patch.review.promote FAIL: {exc}", file=sys.stderr)
        return 1
    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print("ai.patch.review.promote")
        for key, value in result.items():
            print(f"{key}: {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
