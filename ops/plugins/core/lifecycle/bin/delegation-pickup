#!/usr/bin/env python3
"""delegation-pickup — CLI for delegation.pickup capability.

Worker picks up a delegated work item. Discovers the oldest pending
delegation (FIFO) or an explicit delegation by ID. Sets state to
picked_up and records the claiming terminal.

Does NOT start a wave — worker runs wave.execute start after pickup.

Exit codes:
  0  success
  1  pickup failed
  2  invalid arguments
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import delegation_broker as db


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="delegation-pickup",
        description="Pick up a delegated work item for execution.",
    )
    parser.add_argument(
        "--id", default="", dest="delegation_id",
        help="Specific delegation ID to pick up (default: oldest pending)",
    )
    parser.add_argument(
        "--json", action="store_true", dest="json_output",
        help="Emit JSON output",
    )
    parser.add_argument(
        "--self-check", action="store_true",
        help="Verify dependencies and exit",
    )

    if "--self-check" in sys.argv:
        try:
            import delegation_broker  # noqa: F401
            import yaml  # noqa: F401
            print("delegation.pickup self-check PASS")
            return 0
        except ImportError as exc:
            print(f"delegation.pickup self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    spine_state = os.environ.get("SPINE_STATE", "")
    if not spine_state:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"delegation.pickup FAIL: {msg}", file=sys.stderr)
        return 1

    try:
        result = db.pickup(
            state_root=spine_state,
            delegation_id=args.delegation_id,
        )
    except db.DelegationError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"delegation.pickup FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"PICKED UP: {result.get('delegation_id', '')}")
        print(f"  loop:      {result.get('loop_id', '')}")
        print(f"  packet:    {result.get('packet_id', '')}")
        print(f"  objective: {result.get('objective', '')}")
        print(f"  packet_path: {result.get('packet_path', '')}")
        print()
        print("Next: ./bin/ops cap run wave.execute.start -- \\")
        print(f"        --loop-id {result.get('loop_id', '')} \\")
        print(f"        --objective \"{result.get('objective', '')}\"")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
