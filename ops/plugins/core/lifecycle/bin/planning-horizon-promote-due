#!/usr/bin/env bash
set -euo pipefail

# planning.horizon.promote_due — Auto-promote loops from later->now when eligible
#
# Checks:
#   1. Date-triggered: not_before_est has passed (in EST)
#   2. Dependency-triggered: depends_on_loop is closed
#
# Usage: planning-horizon-promote-due [--dry-run]
#
# Authority: SQLite (scope-file projection updated after)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
SCOPES_DIR="$SPINE_STATE/loop-scopes"
DB_PATH="$SPINE_STATE/shared_authority.db"
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help)
      echo "Usage: planning-horizon-promote-due [--dry-run]"
      echo "Auto-promote later/future loops to now when date/dependency triggers are met."
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

exec python3 - "$SCOPES_DIR" "$DRY_RUN" "$ROOT" "$DB_PATH" <<'PYTHON'
# Authority: SQLite (scope-file projection updated after)
import sys
from datetime import datetime, timezone, timedelta
from pathlib import Path

scopes_dir = Path(sys.argv[1])
dry_run = sys.argv[2] == "True"
root = Path(sys.argv[3])
db_path = Path(sys.argv[4])

# Add the library directory to sys.path
sys.path.insert(0, str(root / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

from loops_sql_authority import (
    connect,
    ensure_schema,
    list_loops,
    get_loop,
    upsert_loop,
    project_to_scope_files,
    ARCHIVED_SCOPE_STATUSES,
)

EST = timezone(timedelta(hours=-5))

conn = connect(db_path)
ensure_schema(conn)

def is_loop_closed(loop_id):
    loop = get_loop(conn, loop_id)
    if loop is None:
        return False
    return (loop.get("status") or "") in ARCHIVED_SCOPE_STATUSES

now_est = datetime.now(EST).date()
promoted = []
skipped = []
mutated = False

for loop in list_loops(conn):
    status = loop.get("status", "")
    if status not in ("active", "draft", "open", "planned"):
        continue

    horizon = loop.get("horizon", "now")
    if horizon == "now":
        continue

    loop_id = loop.get("loop_id", "")
    trigger = loop.get("activation_trigger", "manual")

    if trigger == "date":
        not_before = loop.get("not_before_est", "")
        if not not_before:
            skipped.append(f"{loop_id}: date trigger but no not_before_est")
            continue
        try:
            target_date = datetime.strptime(not_before, "%Y-%m-%d").date()
        except ValueError:
            skipped.append(f"{loop_id}: invalid not_before_est '{not_before}'")
            continue

        if now_est >= target_date:
            if dry_run:
                promoted.append(f"{loop_id}: would promote {horizon}->now (date={not_before} reached)")
            else:
                loop["horizon"] = "now"
                if status == "planned":
                    loop["status"] = "active"
                upsert_loop(conn, loop)
                mutated = True
                promoted.append(f"{loop_id}: promoted {horizon}->now (date={not_before} reached)")
        else:
            skipped.append(f"{loop_id}: not yet due (not_before={not_before}, today={now_est})")

    elif trigger == "dependency":
        depends_on = loop.get("depends_on_loop", "")
        if not depends_on:
            skipped.append(f"{loop_id}: dependency trigger but no depends_on_loop")
            continue

        if is_loop_closed(depends_on):
            if dry_run:
                promoted.append(f"{loop_id}: would promote {horizon}->now (dependency {depends_on} closed)")
            else:
                loop["horizon"] = "now"
                if status == "planned":
                    loop["status"] = "active"
                upsert_loop(conn, loop)
                mutated = True
                promoted.append(f"{loop_id}: promoted {horizon}->now (dependency {depends_on} closed)")
        else:
            skipped.append(f"{loop_id}: waiting on {depends_on}")

    elif trigger == "manual":
        skipped.append(f"{loop_id}: manual trigger, no auto-promotion")

# Refresh scope-file projections once after all mutations
if mutated:
    project_to_scope_files(conn, scopes_dir)

conn.close()

prefix = "[DRY RUN] " if dry_run else ""
print(f"{prefix}Planning Horizon Promotion Check")
print("=" * 60)
print()

if promoted:
    print(f"PROMOTED ({len(promoted)}):")
    for p in promoted:
        print(f"  + {p}")
    print()

if skipped:
    print(f"SKIPPED ({len(skipped)}):")
    for s in skipped:
        print(f"  - {s}")
    print()

if not promoted and not skipped:
    print("  No later/future loops found.")
    print()

print(f"Summary: {len(promoted)} promoted, {len(skipped)} skipped")
PYTHON
