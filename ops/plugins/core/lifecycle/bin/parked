#!/usr/bin/env python3
"""Read-only scanner for parked items with parked_lifecycle blocks.

Each item carries a structured review-horizon flag derived from `next_review`
or, when absent, a fallback cadence of `parked_at + 90d`. The fallback cadence
was named in PARKED-ITEM-LIFECYCLE-FORENSIC-20260415 as the missing piece for
parked items whose triggers never fire. This readback flags it; it is not a
runtime daemon.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml

# Fallback review cadence applied when `next_review` is null/missing.
# Origin: PARKED-ITEM-LIFECYCLE-FORENSIC-20260415 line 94 ("90 days would close this gap").
_FALLBACK_REVIEW_DAYS = 90


def spine_state() -> Path:
    return Path(
        os.environ.get(
            "SPINE_STATE",
            str(Path.home() / "code" / ".runtime" / "spine" / "state"),
        )
    )


def spine_code() -> Path:
    return Path(
        os.environ.get(
            "SPINE_CODE",
            str(Path.home() / "code" / "agentic-spine"),
        )
    )


def scan_dirs() -> list[Path]:
    """Directories to scan for parked items."""
    dirs = [spine_state() / "domain-state"]
    # Repo planning docs may also contain parked items.
    repo_planning = spine_code() / "docs" / "planning"
    if repo_planning.is_dir():
        dirs.append(repo_planning)
    return [d for d in dirs if d.is_dir()]


_YAML_FENCE = re.compile(
    r"```ya?ml\s*\n(.*?)```", re.DOTALL | re.IGNORECASE
)


def extract_lifecycle_from_yaml(data: object) -> dict | None:
    """Return parked_lifecycle dict if present at any level."""
    if not isinstance(data, dict):
        return None
    if "parked_lifecycle" in data:
        return data["parked_lifecycle"]
    for value in data.values():
        if isinstance(value, dict):
            result = extract_lifecycle_from_yaml(value)
            if result is not None:
                return result
    return None


def extract_lifecycle_from_md(text: str) -> dict | None:
    """Parse YAML code fences in markdown looking for parked_lifecycle."""
    for match in _YAML_FENCE.finditer(text):
        try:
            parsed = yaml.safe_load(match.group(1))
        except yaml.YAMLError:
            continue
        lc = extract_lifecycle_from_yaml(parsed)
        if lc is not None:
            return lc
    return None


def extract_lifecycle(path: Path) -> dict | None:
    """Extract parked_lifecycle from a file, handling YAML and markdown."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None

    if path.suffix == ".yaml" or path.suffix == ".yml":
        try:
            data = yaml.safe_load(text)
        except yaml.YAMLError:
            return None
        return extract_lifecycle_from_yaml(data)

    if path.suffix == ".md":
        return extract_lifecycle_from_md(text)

    return None


def item_name(path: Path) -> str:
    """Derive a short human name from the file path."""
    return path.stem


def item_location(path: Path) -> str:
    """Classify where the item lives."""
    s = str(path)
    if "/domain-state/spine/" in s:
        return "runtime/spine"
    if "/domain-state/mint/" in s:
        return "runtime/mint"
    if "/domain-state/" in s:
        return "runtime/domain-state"
    if "/docs/planning/" in s:
        return "repo/planning"
    return "other"


def _parse_iso_date(value: str | None) -> datetime | None:
    if not value:
        return None
    s = str(value).strip().strip('"').strip("'")
    if not s or s.lower() in {"null", "none", "(none)"}:
        return None
    # Accept either YYYY-MM-DD or full ISO timestamps.
    try:
        if len(s) == 10:
            return datetime.fromisoformat(s).replace(tzinfo=timezone.utc)
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def _path_mtime_utc(path: Path) -> datetime | None:
    try:
        return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    except OSError:
        return None


def _review_horizon(lc: dict, path: Path, now: datetime) -> dict:
    """Derive structured review-horizon truth for a parked item.

    Returns a dict with:
      - declared_next_review: original next_review value (string or None)
      - has_next_review: bool — True only when a real ISO date was declared
      - effective_next_review: ISO date used for staleness math
                                (declared if present; otherwise parked_at + fallback days)
      - source: "declared" | "fallback_parked_plus_90d" | "unknown"
      - days_overdue: int (negative when not yet due, 0 when due today)
      - review_horizon_missing: bool — True when no declared next_review exists
      - review_horizon_overdue: bool — True when effective_next_review is past today
    """
    declared = lc.get("next_review")
    declared_dt = _parse_iso_date(declared)

    if declared_dt is not None:
        eff_dt = declared_dt
        source = "declared"
        missing = False
    else:
        parked_at = _parse_iso_date(lc.get("parked_at"))
        if parked_at is None:
            parked_at = _path_mtime_utc(path)
        if parked_at is None:
            return {
                "declared_next_review": declared,
                "has_next_review": False,
                "effective_next_review": None,
                "source": "unknown",
                "days_overdue": None,
                "review_horizon_missing": True,
                "review_horizon_overdue": False,
            }
        from datetime import timedelta
        eff_dt = parked_at + timedelta(days=_FALLBACK_REVIEW_DAYS)
        source = "fallback_parked_plus_90d"
        missing = True

    days_overdue = (now.date() - eff_dt.date()).days
    return {
        "declared_next_review": declared,
        "has_next_review": declared_dt is not None,
        "effective_next_review": eff_dt.date().isoformat(),
        "source": source,
        "days_overdue": days_overdue,
        "review_horizon_missing": missing,
        "review_horizon_overdue": days_overdue > 0,
    }


def scan_all() -> list[dict]:
    """Walk scan dirs and collect all parked items with lifecycle blocks."""
    items = []
    seen = set()
    now = datetime.now(timezone.utc)
    for base in scan_dirs():
        for path in sorted(base.rglob("*")):
            if path.is_dir():
                continue
            if path.suffix not in (".yaml", ".yml", ".md"):
                continue
            if path in seen:
                continue
            seen.add(path)
            lc = extract_lifecycle(path)
            if lc is None:
                continue
            triggers = lc.get("activation_trigger", [])
            if isinstance(triggers, str):
                triggers = [triggers]
            horizon = _review_horizon(lc, path, now)
            items.append({
                "name": item_name(path),
                "path": str(path),
                "location": item_location(path),
                "status": lc.get("status", "parked"),
                "parked_reason": lc.get("parked_reason", ""),
                "activation_trigger": triggers,
                "trigger_count": len(triggers),
                "next_review": lc.get("next_review"),
                "review_horizon": horizon,
                "activation_destination": lc.get("activation_destination", ""),
                "retire_if": lc.get("retire_if", ""),
                "superseded_by": lc.get("superseded_by", []),
            })
    return items


def _summary_counts(items: list[dict]) -> dict:
    missing = sum(1 for it in items if it.get("review_horizon", {}).get("review_horizon_missing"))
    overdue = sum(1 for it in items if it.get("review_horizon", {}).get("review_horizon_overdue"))
    return {
        "total": len(items),
        "review_horizon_missing": missing,
        "review_horizon_overdue": overdue,
    }


def cmd_list(args: argparse.Namespace) -> int:
    items = scan_all()
    summary = _summary_counts(items)
    if args.json:
        print(json.dumps({
            "capability": "parked.list",
            "status": "ok",
            "count": len(items),
            "summary": summary,
            "items": items,
        }, indent=2))
    else:
        if not items:
            print("No parked items with parked_lifecycle found.")
            return 0
        for i, item in enumerate(items, 1):
            print(f"\n{'─' * 60}")
            print(f"  [{i}/{len(items)}] {item['name']}")
            print(f"  location:    {item['location']}")
            print(f"  status:      {item['status']}")
            print(f"  reason:      {item['parked_reason']}")
            print(f"  triggers:    {item['trigger_count']} defined")
            for t in item["activation_trigger"]:
                print(f"               - {t}")
            horizon = item.get("review_horizon", {})
            review_label = item['next_review'] or '(none)'
            flags = []
            if horizon.get("review_horizon_missing"):
                flags.append("missing")
            if horizon.get("review_horizon_overdue"):
                days = horizon.get("days_overdue")
                flags.append(f"overdue:{days}d" if days is not None else "overdue")
            flag_suffix = f"  [{' '.join(flags)}]" if flags else ""
            print(f"  next_review: {review_label}{flag_suffix}")
            if horizon.get("source") == "fallback_parked_plus_90d":
                print(f"  effective:   {horizon.get('effective_next_review')} (fallback parked_at + 90d)")
            print(f"  destination: {item['activation_destination']}")
            print(f"  retire_if:   {item['retire_if']}")
            sup = item["superseded_by"]
            if sup:
                print(f"  superseded:  {', '.join(sup)}")
            print(f"  path:        {item['path']}")
        print(f"\n{'─' * 60}")
        print(
            f"\nTotal: {summary['total']} parked  |  "
            f"review_horizon_missing: {summary['review_horizon_missing']}  |  "
            f"review_horizon_overdue: {summary['review_horizon_overdue']}\n"
        )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Read-only scanner for parked items with parked_lifecycle blocks."
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_list = sub.add_parser("list", help="List all parked items with lifecycle metadata.")
    p_list.add_argument("--json", action="store_true", help="Output as JSON.")
    args = parser.parse_args()
    if args.cmd == "list":
        return cmd_list(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
