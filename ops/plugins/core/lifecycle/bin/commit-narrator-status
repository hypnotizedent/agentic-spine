#!/usr/bin/env python3
"""commit.narrator.status - read-only commit-class narrative witness.

The narrator is a signal surface, not authority. It reads recent commit
metadata, changed paths, and shortstat only, then classifies direction signals
with explicit confidence boundaries. Governed node admission and Site
Intelligence are optional input readbacks; they do not own this program.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[5]
NODE_ADMISSION = ROOT / "ops/plugins/infra/bin/node-admission-status"
SITE_PRESENCE = ROOT / "ops/plugins/infra/bin/site-presence-status"

# Slice D: rule engine module (Python path import)
_LIFECYCLE_LIB = ROOT / "ops/plugins/core/lifecycle/lib"
if str(_LIFECYCLE_LIB) not in sys.path:
    sys.path.insert(0, str(_LIFECYCLE_LIB))
try:  # pragma: no cover - optional at import time
    import narrator_rules as _narrator_rules  # type: ignore
except Exception:  # pragma: no cover
    _narrator_rules = None  # type: ignore

CAPABILITY = "commit.narrator.status"
READ_BOUNDARY = "commit_metadata_changed_paths_shortstat_only_not_full_diff"
DEFAULT_LIMIT = 12
DEFAULT_INPUT_NODES = ("pve-r620", "observability-r620")

SUBTRACTION_TOKENS = {
    "subtract",
    "subtraction",
    "retire",
    "retired",
    "demote",
    "demoted",
    "fold",
    "folded",
    "delete",
    "deleted",
    "trim",
    "remove",
    "removed",
}
EXPANSION_TOKENS = {
    "add",
    "added",
    "create",
    "created",
    "new",
    "promote",
    "promoted",
    "register",
    "registered",
    "emit",
    "integrate",
    "first-class",
    "first_class",
}

AUTHORITY_PREFIXES = (
    "AGENTS.md",
    "NORTH_STAR.md",
    "docs/governance/",
    "ops/bindings/",
)
VERIFY_PREFIXES = (
    "surfaces/verify/",
    "ops/plugins/core/verify/",
)
LIFECYCLE_PREFIXES = (
    "ops/plugins/core/lifecycle/",
    "ops/plugins/core/orchestration/",
    "ops/plugins/core/loops/",
    "ops/plugins/infra/mailroom-bridge/",
    "ops/commands/status.sh",
)
SURFACE_PREFIXES = (
    "ops/capabilities.yaml",
    "ops/plugins/MANIFEST.yaml",
    "ops/plugins/core/surface/",
)
ESTATE_INPUT_PREFIXES = (
    "ops/plugins/infra/bin/node-admission-status",
    "ops/plugins/infra/bin/site-presence-status",
    "ops/bindings/node.role.contract.yaml",
    "ops/bindings/topology.sites.yaml",
    "ops/bindings/site.profile.contract.yaml",
)


def run(cmd: list[str], *, timeout: int = 10) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True, timeout=timeout)


def git(*args: str, timeout: int = 10) -> subprocess.CompletedProcess[str]:
    return run(["git", *args], timeout=timeout)


def token_hit(text: str, tokens: set[str]) -> list[str]:
    lowered = text.lower()
    return sorted(token for token in tokens if token in lowered)


def path_matches(path: str, prefixes: tuple[str, ...]) -> bool:
    return any(path == prefix.rstrip("/") or path.startswith(prefix) for prefix in prefixes)


def parse_shortstat(text: str) -> dict[str, int]:
    stats = {"files_changed": 0, "insertions": 0, "deletions": 0}
    if not text.strip():
        return stats
    files = re.search(r"(\d+)\s+files? changed", text)
    insertions = re.search(r"(\d+)\s+insertions?\(\+\)", text)
    deletions = re.search(r"(\d+)\s+deletions?\(-\)", text)
    if files:
        stats["files_changed"] = int(files.group(1))
    if insertions:
        stats["insertions"] = int(insertions.group(1))
    if deletions:
        stats["deletions"] = int(deletions.group(1))
    return stats


def changed_paths_for_commit(sha: str) -> tuple[list[str], dict[str, int], dict[str, str]]:
    # diff-tree with -m keeps merge commits honest; `git show --name-status`
    # can emit no paths for a merge even when shortstat shows real changes.
    proc = git("diff-tree", "--no-commit-id", "--name-status", "-r", "-m", sha)
    if proc.returncode != 0:
        return [], {}, {}
    paths: list[str] = []
    statuses: Counter[str] = Counter()
    path_status: dict[str, str] = {}
    for raw in proc.stdout.splitlines():
        line = raw.strip()
        if not line:
            continue
        parts = line.split("\t")
        status = parts[0]
        path = parts[-1] if len(parts) > 1 else ""
        if not path:
            continue
        paths.append(path)
        statuses[status[:1]] += 1
        # Per-path status preserved for fine-grained rule evaluation. For
        # rename rows (R<score>\told\tnew), the new path receives the rename
        # marker; downstream rules that need the rename source can consult
        # diff_body.
        if path not in path_status:
            path_status[path] = status[:1]
    return sorted(dict.fromkeys(paths)), dict(statuses), path_status


def commit_shortstat(sha: str) -> dict[str, int]:
    proc = git("show", "--shortstat", "--format=", "--no-renames", sha)
    if proc.returncode != 0:
        return {"files_changed": 0, "insertions": 0, "deletions": 0}
    return parse_shortstat(proc.stdout)


def gate_script_count(treeish: str) -> int | None:
    proc = git("ls-tree", "-r", "--name-only", treeish, "--", "surfaces/verify")
    if proc.returncode != 0:
        return None
    return sum(1 for line in proc.stdout.splitlines() if re.search(r"/d[0-9].*\.sh$", line))


def classify_commit(commit: dict[str, Any]) -> dict[str, Any]:
    subject = str(commit.get("subject") or "")
    paths = [str(path) for path in commit.get("paths") or []]
    path_text = " ".join(paths)
    combined = f"{subject} {path_text}"
    subtraction_hits = token_hit(combined, SUBTRACTION_TOKENS)
    expansion_hits = token_hit(combined, EXPANSION_TOKENS)

    touched = []
    if any(path_matches(path, AUTHORITY_PREFIXES) for path in paths):
        touched.append("governance_or_contract")
    if any(path_matches(path, VERIFY_PREFIXES) for path in paths):
        touched.append("verify_lock")
    if any(path_matches(path, LIFECYCLE_PREFIXES) for path in paths):
        touched.append("core_lifecycle")
    if any(path_matches(path, SURFACE_PREFIXES) for path in paths):
        touched.append("capability_or_operator_surface")
    if any(path_matches(path, ESTATE_INPUT_PREFIXES) for path in paths):
        touched.append("node_or_site_input_readback")
    if not touched:
        touched.append("unclassified_repo_surface")

    status_counts = commit.get("status_counts") or {}
    added_files = int(status_counts.get("A", 0) or 0)
    deleted_files = int(status_counts.get("D", 0) or 0)
    shortstat = commit.get("shortstat") or {}
    net_lines = int(shortstat.get("insertions", 0) or 0) - int(shortstat.get("deletions", 0) or 0)
    adds_new_surface = (
        "capability_or_operator_surface" in touched
        or added_files > 0
        or any(path.endswith(".sh") and path.startswith("surfaces/verify/") for path in paths)
    )

    reasons: list[str] = []
    if subtraction_hits:
        reasons.append(f"subtraction language: {', '.join(subtraction_hits)}")
    if expansion_hits:
        reasons.append(f"expansion language: {', '.join(expansion_hits)}")
    if added_files:
        reasons.append(f"added_files={added_files}")
    if deleted_files:
        reasons.append(f"deleted_files={deleted_files}")
    if net_lines:
        reasons.append(f"net_lines={net_lines:+d}")
    reasons.extend(f"touches {surface}" for surface in touched if surface != "unclassified_repo_surface")

    if adds_new_surface and not subtraction_hits and not deleted_files:
        signal = "expansion_pressure_operator_eye"
        verdict = "unknown_requires_closure_check"
        confidence = "medium"
    elif "governance_or_contract" in touched:
        signal = "authority_shift_operator_eye"
        verdict = "unknown_requires_authority_read"
        confidence = "medium"
    elif "verify_lock" in touched:
        signal = "verify_lock_change"
        verdict = "unknown_until_gate_read"
        confidence = "medium"
    elif subtraction_hits and (deleted_files or shortstat.get("deletions", 0)):
        signal = "subtraction_signal"
        verdict = "likely_subtraction_aligned"
        confidence = "medium"
    elif subtraction_hits:
        signal = "named_subtraction_without_deletion_proof"
        verdict = "unknown_check_if_old_surface_was_removed"
        confidence = "low"
    elif "core_lifecycle" in touched:
        signal = "core_lifecycle_change"
        verdict = "unknown_needs_diff_read"
        confidence = "medium"
    elif "node_or_site_input_readback" in touched:
        signal = "input_readback_change"
        verdict = "unknown_not_narrator_owner"
        confidence = "medium"
    else:
        signal = "unknown_surface_change"
        verdict = "unknown_not_enough_read"
        confidence = "low"

    if not paths:
        signal = "unknown_paths_unread"
        verdict = "unknown"
        confidence = "low"
        reasons.append("changed paths unavailable")

    return {
        "direction_signal": signal,
        "plain_verdict": verdict,
        "confidence": confidence,
        "confidence_boundary": READ_BOUNDARY,
        "touched_surfaces": touched,
        "operator_eye": signal.endswith("operator_eye") or confidence == "low",
        "reason": "; ".join(reasons) if reasons else "metadata did not expose a strong direction signal",
    }


_SINCE_COMPACT_RE = re.compile(
    r"^(\d+)\s*\.?\s*(d|day|days|w|week|weeks|h|hour|hours|m|month|months)$",
    re.IGNORECASE,
)
_SINCE_UNIT_MAP = {
    "d": "days", "day": "days", "days": "days",
    "w": "weeks", "week": "weeks", "weeks": "weeks",
    "h": "hours", "hour": "hours", "hours": "hours",
    "m": "months", "month": "months", "months": "months",
}


def normalize_since(value: str) -> str:
    """Translate compact forms like '14.days' into git's '14 days ago' shape.

    ISO dates and any other free-form value are passed through verbatim so
    git --since can interpret them (git accepts many natural-language forms).
    """
    text = value.strip()
    match = _SINCE_COMPACT_RE.match(text)
    if not match:
        return text
    n = match.group(1)
    unit = _SINCE_UNIT_MAP[match.group(2).lower()]
    return f"{n} {unit} ago"


DIFF_TOO_LARGE_THRESHOLD = 50000


def collect_commit_diff(
    sha: str,
    *,
    max_per_file: int,
    max_per_commit: int,
    max_files: int,
    shortstat: dict[str, int],
) -> dict[str, Any]:
    """Read bounded full-diff body for a commit. Honest disclosure on truncation.

    Witness-only: this is a read of git history. No mutation, no decision.
    """
    total_in_commit = (shortstat or {}).get("insertions", 0) + (shortstat or {}).get("deletions", 0)
    files_total = (shortstat or {}).get("files_changed", 0)
    block: dict[str, Any] = {
        "status": "included",
        "truncated": False,
        "total_lines_collected": 0,
        "total_lines_in_commit": total_in_commit,
        "files_included": 0,
        "files_total": files_total,
        "per_file_caps_hit": [],
        "max_per_file": max_per_file,
        "max_per_commit": max_per_commit,
        "max_files": max_files,
    }
    if total_in_commit > DIFF_TOO_LARGE_THRESHOLD:
        block["status"] = "skipped_too_large"
        block["truncated"] = True
        return block
    proc = git("show", sha, "--no-color", "--format=", "--unified=3")
    if proc.returncode != 0:
        block["status"] = "skipped_git_failed"
        block["truncated"] = True
        block["error"] = (proc.stderr or proc.stdout).strip()[:300]
        return block
    raw = proc.stdout
    if not raw:
        block["status"] = "included"
        block["body"] = ""
        return block
    file_chunks: list[tuple[str, list[str]]] = []
    current_path = "<unknown>"
    current_lines: list[str] = []
    for line in raw.splitlines():
        if line.startswith("diff --git "):
            if current_lines:
                file_chunks.append((current_path, current_lines))
            current_lines = [line]
            tail = line.split(" b/", 1)
            current_path = tail[1] if len(tail) == 2 else "<unknown>"
        else:
            current_lines.append(line)
    if current_lines:
        file_chunks.append((current_path, current_lines))
    body_parts: list[str] = []
    total_collected = 0
    files_emitted = 0
    for path, chunk in file_chunks:
        if files_emitted >= max_files:
            block["status"] = "skipped_per_commit_cap"
            block["truncated"] = True
            break
        if len(chunk) > max_per_file:
            chunk = chunk[:max_per_file] + [f"... [diff truncated at {max_per_file} lines for {path}]"]
            block["per_file_caps_hit"].append(path)
            block["truncated"] = True
        if total_collected + len(chunk) > max_per_commit:
            remaining = max(0, max_per_commit - total_collected)
            if remaining > 0:
                truncated_chunk = chunk[:remaining]
                body_parts.append("\n".join(truncated_chunk + ["... [diff truncated at per-commit cap]"]))
                total_collected += remaining
                files_emitted += 1
            block["status"] = "skipped_per_commit_cap"
            block["truncated"] = True
            break
        body_parts.append("\n".join(chunk))
        total_collected += len(chunk)
        files_emitted += 1
    block["body"] = "\n".join(body_parts)
    block["total_lines_collected"] = total_collected
    block["files_included"] = files_emitted
    return block


_ARTIFACT_REL = "domain-state/narrator/per-commit"


def _resolve_state_root() -> Path | None:
    env = os.environ.get("SPINE_STATE")
    if env:
        return Path(env)
    return None


def load_commit_artifact(sha: str, state_root: Path | None = None) -> dict | None:
    """Read a per-commit narrator artifact yaml. Returns None when absent."""
    root = state_root or _resolve_state_root()
    if root is None:
        return None
    target = root / _ARTIFACT_REL / f"{sha}.yaml"
    if not target.is_file():
        return None
    try:
        import yaml  # local import to avoid hard dep at module top
        return yaml.safe_load(target.read_text(encoding="utf-8"))
    except Exception:
        return None


def commits_from_artifacts(
    ref: str,
    limit: int,
    since: str | None = None,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    """Slice E: load commits from existing per-commit artifacts.

    Iterates SHAs in the requested window via git log (cheap), then loads each
    SHA's artifact yaml from canonical state. Missing artifacts produce an
    explicit disclosure row instead of silent recomputation.
    """
    log_args = ["log", ref, "--date=iso-strict",
                "--format=%H%x1f%aI%x1f%an%x1f%ae%x1f%s"]
    if since:
        log_args.append(f"--since={normalize_since(since)}")
    log_args.append(f"--max-count={limit}")
    proc = git(*log_args)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "git log failed")
    state_root = _resolve_state_root()
    rows: list[dict[str, Any]] = []
    summary = {"attempted": 0, "from_artifact": 0, "artifact_missing": 0, "parse_errors": 0}
    for line in proc.stdout.splitlines():
        parts = line.split("\x1f", 4)
        if len(parts) != 5:
            continue
        sha, author_date, author_name, author_email, subject = parts
        summary["attempted"] += 1
        artifact = load_commit_artifact(sha, state_root)
        if artifact is None:
            rows.append({
                "sha": sha,
                "short_sha": sha[:8],
                "author_date": author_date,
                "author_name": author_name,
                "author_email_class": classify_author_email(author_email),
                "subject": subject,
                "from_artifact": False,
                "artifact_source": "missing",
                "disclosure": "artifact_not_found_run_write_artifacts",
                "paths": [],
                "status_counts": {},
                "shortstat": {},
                "diff_body": {"status": "skipped_disabled", "truncated": False},
                "direction_signal": "unknown_artifact_absent",
                "plain_verdict": "unknown_artifact_absent",
                "confidence": "low",
                "confidence_boundary": "no_artifact_loaded",
                "operator_eye": False,
                "reason": "artifact missing for SHA",
                "touched_surfaces": [],
            })
            summary["artifact_missing"] += 1
            continue
        if not isinstance(artifact, dict):
            rows.append({
                "sha": sha,
                "short_sha": sha[:8],
                "author_date": author_date,
                "author_name": author_name,
                "author_email_class": classify_author_email(author_email),
                "subject": subject,
                "from_artifact": False,
                "artifact_source": "parse_error",
                "disclosure": "artifact_yaml_did_not_parse_as_dict",
                "paths": [],
                "status_counts": {},
                "shortstat": {},
                "diff_body": {"status": "skipped_disabled", "truncated": False},
                "direction_signal": "unknown_artifact_unreadable",
                "plain_verdict": "unknown_artifact_unreadable",
                "confidence": "low",
                "confidence_boundary": "artifact_parse_failed",
                "operator_eye": False,
                "reason": "artifact present but did not parse as dict",
                "touched_surfaces": [],
            })
            summary["parse_errors"] += 1
            continue
        fact_layer = artifact.get("fact_layer") or {}
        artifact_path = (state_root / _ARTIFACT_REL / f"{sha}.yaml") if state_root else None
        rows.append({
            "sha": sha,
            "short_sha": sha[:8],
            "author_date": fact_layer.get("author_date") or author_date,
            "author_name": fact_layer.get("author_name") or author_name,
            "author_email_class": fact_layer.get("author_email_class") or classify_author_email(author_email),
            "subject": fact_layer.get("subject") or subject,
            "from_artifact": True,
            "artifact_source": str(artifact_path) if artifact_path else "<state_root_unset>",
            "paths": list(fact_layer.get("paths") or []),
            "status_counts": dict(fact_layer.get("status_counts") or {}),
            "shortstat": dict(fact_layer.get("shortstat") or {}),
            "diff_body": fact_layer.get("diff_body") or {"status": "skipped_disabled", "truncated": False},
            "direction_signal": artifact.get("direction_signal") or "unknown_no_signal_in_artifact",
            "plain_verdict": artifact.get("plain_verdict") or "unknown_no_verdict_in_artifact",
            "confidence": artifact.get("confidence") or "low",
            "confidence_boundary": artifact.get("confidence_boundary") or "from_artifact_replay",
            "operator_eye": bool(artifact.get("operator_eye")),
            "reason": artifact.get("reason") or "loaded from per-commit artifact",
            "touched_surfaces": list(artifact.get("touched_surfaces") or []),
            "rule_layer": artifact.get("rule_layer"),
            "narrative_layer": artifact.get("narrative_layer"),
        })
        summary["from_artifact"] += 1
    return rows, summary


def recent_commits(
    ref: str,
    limit: int,
    since: str | None = None,
    *,
    include_diff: bool = False,
    diff_max_per_file: int = 500,
    diff_max_per_commit: int = 5000,
    diff_max_files: int = 100,
) -> list[dict[str, Any]]:
    log_args = ["log", ref, "--date=iso-strict",
                "--format=%H%x1f%aI%x1f%an%x1f%ae%x1f%s"]
    if since:
        log_args.append(f"--since={normalize_since(since)}")
    log_args.append(f"--max-count={limit}")
    proc = git(*log_args)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "git log failed")
    rows: list[dict[str, Any]] = []
    for line in proc.stdout.splitlines():
        parts = line.split("\x1f", 4)
        if len(parts) != 5:
            continue
        sha, author_date, author_name, author_email, subject = parts
        paths, status_counts, path_status = changed_paths_for_commit(sha)
        shortstat = commit_shortstat(sha)
        row: dict[str, Any] = {
            "sha": sha,
            "short_sha": sha[:8],
            "author_date": author_date,
            "author_name": author_name,
            "author_email_class": classify_author_email(author_email),
            "subject": subject,
            "paths": paths,
            "status_counts": status_counts,
            "path_status": path_status,
            "shortstat": shortstat,
        }
        if include_diff:
            row["diff_body"] = collect_commit_diff(
                sha,
                max_per_file=diff_max_per_file,
                max_per_commit=diff_max_per_commit,
                max_files=diff_max_files,
                shortstat=shortstat,
            )
        else:
            row["diff_body"] = {"status": "skipped_disabled", "truncated": False}
        row.update(classify_commit(row))
        rows.append(row)
    return rows


def classify_author_email(email: str) -> str:
    lowered = email.lower()
    if "bot" in lowered or "runner" in lowered or "codex" in lowered or "claude" in lowered:
        return "agent_or_automation"
    if lowered == "hypnotizedent@gmail.com":
        return "operator"
    return "unknown"


def summarize(commits: list[dict[str, Any]], ref: str) -> dict[str, Any]:
    by_signal = Counter(str(row.get("direction_signal") or "unknown") for row in commits)
    touched = Counter()
    operator_eye = []
    for row in commits:
        touched.update(row.get("touched_surfaces") or [])
        if row.get("operator_eye"):
            operator_eye.append(
                {
                    "sha": row.get("short_sha"),
                    "subject": row.get("subject"),
                    "reason": row.get("reason"),
                    "direction_signal": row.get("direction_signal"),
                }
            )
    latest_sha = commits[0]["sha"] if commits else ref
    oldest_sha = commits[-1]["sha"] if commits else ref
    return {
        "ref": ref,
        "count_inspected": len(commits),
        "by_direction_signal": dict(sorted(by_signal.items())),
        "touched_surface_counts": dict(sorted(touched.items())),
        "operator_eye_count": len(operator_eye),
        "operator_eye": operator_eye[:8],
        "gate_script_count": {
            "latest": gate_script_count(latest_sha),
            "oldest_inspected": gate_script_count(oldest_sha),
            "boundary": "D-gate script count only; active registry budget remains owned by D127.",
        },
    }


def run_json_script(script: Path, args: list[str], timeout: int) -> dict[str, Any]:
    proc = run([str(script), *args], timeout=timeout)
    if proc.returncode != 0:
        return {
            "status": "unavailable",
            "error": (proc.stderr or proc.stdout).strip()[:500],
        }
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {
            "status": "unavailable",
            "error": "readback did not emit JSON",
        }


def input_readbacks(nodes: list[str]) -> dict[str, Any]:
    node_rows: dict[str, Any] = {}
    for node in nodes:
        payload = run_json_script(NODE_ADMISSION, ["--node", node, "--json"], timeout=20)
        rows = payload.get("rows") if isinstance(payload, dict) else None
        row = rows[0] if isinstance(rows, list) and rows and isinstance(rows[0], dict) else {}
        node_rows[node] = {
            "readback": "node.admission.status",
            "boundary": "input_readback_only_not_narrator_owner",
            "status": payload.get("status", "unknown") if isinstance(payload, dict) else "unknown",
            "admission_state": row.get("admission_state", "unknown"),
            "promotion_stage": row.get("promotion_stage", "unknown"),
            "lifecycle_state": row.get("lifecycle_state", "unknown"),
            "role_candidacy": row.get("role_candidacy", []),
            "active_runtime_roles": ((row.get("runtime_obligations") or {}).get("active_runtime_roles") or []),
            "canonical_plane_access_roles": sorted(((row.get("canonical_plane_access") or {}).get("by_role") or {}).keys()),
        }
        if payload.get("status") == "unavailable":
            node_rows[node]["error"] = payload.get("error")
    site_payload = run_json_script(SITE_PRESENCE, ["--json"], timeout=30)
    first_class_system = site_payload.get("first_class_system") if isinstance(site_payload, dict) else {}
    return {
        "node_admission": {
            "capability": "node.admission.status",
            "boundary": "input_readback_only_not_narrator_owner",
            "nodes": node_rows,
        },
        "site_intelligence": {
            "capability": "site.presence.status",
            "boundary": "input_readback_only_not_narrator_owner",
            "status": site_payload.get("status", "unknown") if isinstance(site_payload, dict) else "unknown",
            "summary": site_payload.get("summary", {}) if isinstance(site_payload, dict) else {},
            "first_class_system": {
                "name": (first_class_system or {}).get("name"),
                "public_readback": (first_class_system or {}).get("public_readback"),
                "admission_readback": (first_class_system or {}).get("admission_readback"),
            },
        },
    }


def build_payload(args: argparse.Namespace) -> dict[str, Any]:
    since = getattr(args, "since", None)
    include_diff = getattr(args, "include_diff", False)
    from_artifacts = getattr(args, "from_artifacts", False)
    artifact_reads_summary: dict[str, Any] | None = None
    if from_artifacts:
        commits, artifact_reads_summary = commits_from_artifacts(
            args.ref,
            args.limit,
            since=since,
        )
    else:
        commits = recent_commits(
            args.ref,
            args.limit,
            since=since,
            include_diff=include_diff,
            diff_max_per_file=getattr(args, "diff_max_lines_per_file", 500),
            diff_max_per_commit=getattr(args, "diff_max_lines_per_commit", 5000),
            diff_max_files=getattr(args, "diff_max_files_per_commit", 100),
        )
    scope: dict[str, Any] = {
        "class": "witness",
        "subject": "commit_class_estate_narrative",
        "ref": args.ref,
        "limit": args.limit,
        "read_depth": (
            "per_commit_artifact_yaml_replay" if from_artifacts
            else "commit_metadata_changed_paths_shortstat_and_bounded_full_diff" if include_diff
            else READ_BOUNDARY
        ),
    }
    if since:
        scope["since"] = since
        scope["since_normalized"] = normalize_since(since)
    if include_diff:
        scope["diff_caps"] = {
            "max_per_file": getattr(args, "diff_max_lines_per_file", 500),
            "max_per_commit": getattr(args, "diff_max_lines_per_commit", 5000),
            "max_files": getattr(args, "diff_max_files_per_commit", 100),
            "skip_threshold_total_lines": DIFF_TOO_LARGE_THRESHOLD,
        }
    payload: dict[str, Any] = {
        "canonical_authority": CAPABILITY,
        "capability": CAPABILITY,
        "status": "ok",
        "generated_at": datetime.now(UTC).isoformat(),
        "scope": scope,
        "authority_boundary": {
            "mutation_access": "none",
            "decision_authority": "none",
            "does_not_decide": [
                "node_admission",
                "runtime_placement",
                "backup_authority",
                "watcher_authority",
                "verify_pass_fail",
                "loop_or_packet_closure",
            ],
            "does_not_replace": [
                "git history",
                "packet.label.validate",
                "verify.engine.run",
                "spine.verify",
                "node.admission.status",
                "site.presence.status",
            ],
        },
        "subtraction": {
            "replaces": [
                "manual after-the-fact conversational commit narration as the only aggregate signal",
                "per-agent self-report as the only direction signal for commits",
            ],
            "demotes_to_drilldown": [
                "raw git show/git log spelunking for ordinary narrator status",
                "individual agent commit narration when aggregate trend is needed",
            ],
            "does_not_delete": [
                "expert git inspection",
                "operator judgment",
                "verify gates",
            ],
        },
        "input_readbacks": (
            {"status": "skipped", "reason": "--skip-input-readbacks"}
            if args.skip_input_readbacks
            else input_readbacks(args.input_node)
        ),
        "direction_signals": summarize(commits, args.ref),
        "commits": commits,
        "read_boundaries": [
            (
                "commit_metadata_changed_paths_shortstat_and_bounded_full_diff_when_include_diff_set"
                if include_diff
                else READ_BOUNDARY
            ),
            "no LLM inference in v1",
            (
                "full diff body bounded by per-file and per-commit caps; skipped-diff disclosed in diff_body block"
                if include_diff
                else "no full diff body read unless --include-diff"
            ),
            "node admission and site intelligence are consumed only as readback inputs",
        ],
    }
    if artifact_reads_summary is not None:
        payload["artifact_reads"] = artifact_reads_summary
    return payload


def print_human(payload: dict[str, Any]) -> None:
    print(CAPABILITY)
    print(f"status: {payload.get('status')}")
    scope = payload.get("scope") or {}
    print(f"scope: {scope.get('subject')} ref={scope.get('ref')} limit={scope.get('limit')}")
    print("authority: witness signal only; mutation_access=none; decision_authority=none")
    print("subtraction:")
    for item in (payload.get("subtraction") or {}).get("replaces", []):
        print(f"  replaces: {item}")
    print("direction_signals:")
    summary = payload.get("direction_signals") or {}
    print(f"  inspected: {summary.get('count_inspected')}")
    print(f"  by_signal: {json.dumps(summary.get('by_direction_signal') or {}, sort_keys=True)}")
    print(f"  operator_eye_count: {summary.get('operator_eye_count')}")
    gates = summary.get("gate_script_count") or {}
    print(f"  gate_scripts: latest={gates.get('latest')} oldest_inspected={gates.get('oldest_inspected')}")
    inputs = payload.get("input_readbacks") or {}
    if inputs.get("status") == "skipped":
        print("input_readbacks: skipped")
    else:
        print("input_readbacks:")
        site = inputs.get("site_intelligence") or {}
        print(f"  site_intelligence: {site.get('status')} via {site.get('capability')} (input only)")
        nodes = ((inputs.get("node_admission") or {}).get("nodes") or {})
        for node, row in nodes.items():
            print(
                f"  node_admission: {node} state={row.get('admission_state')} "
                f"stage={row.get('promotion_stage')} lifecycle={row.get('lifecycle_state')}"
            )
    print("commits:")
    for row in payload.get("commits") or []:
        print(
            f"- {row.get('short_sha')} {row.get('direction_signal')} "
            f"confidence={row.get('confidence')} verdict={row.get('plain_verdict')}"
        )
        print(f"  subject: {row.get('subject')}")
        print(f"  reason: {row.get('reason')}")
        paths = row.get("paths") or []
        shown = ", ".join(paths[:5])
        suffix = f" (+{len(paths) - 5} more)" if len(paths) > 5 else ""
        print(f"  paths: {shown}{suffix}")
        diff = row.get("diff_body") or {}
        if diff.get("status") and diff.get("status") != "skipped_disabled":
            disclosure = (
                f"  diff: status={diff.get('status')} "
                f"truncated={diff.get('truncated')} "
                f"lines={diff.get('total_lines_collected')}/{diff.get('total_lines_in_commit')} "
                f"files={diff.get('files_included')}/{diff.get('files_total')}"
            )
            print(disclosure)


def print_markdown(payload: dict[str, Any]) -> None:
    scope = payload.get("scope") or {}
    summary = payload.get("direction_signals") or {}
    since = scope.get("since")
    print(f"# Commit Narrator — {scope.get('ref')}" + (f" since {since}" if since else ""))
    print()
    print(f"**generated:** {payload.get('generated_at')}")
    print(f"**inspected:** {summary.get('count_inspected')} commit(s)")
    print(f"**operator_eye:** {summary.get('operator_eye_count')}")
    print(f"**authority:** witness signal only; mutation_access=none; decision_authority=none")
    if since:
        print(f"**since:** {since} → {scope.get('since_normalized')}")
    artifact_reads = payload.get("artifact_reads")
    if artifact_reads:
        print(
            f"**artifact replay:** {artifact_reads.get('from_artifact', 0)} from artifact, "
            f"{artifact_reads.get('artifact_missing', 0)} missing, "
            f"{artifact_reads.get('parse_errors', 0)} parse error(s)"
        )
        if artifact_reads.get("artifact_missing"):
            print("**recommendation:** rerun narrator with --write-artifacts to populate missing per-commit yamls")
    print()
    print("## Direction signals")
    for signal, count in (summary.get("by_direction_signal") or {}).items():
        print(f"- `{signal}`: {count}")
    print()
    eye = summary.get("operator_eye") or []
    if eye:
        print("## Operator-eye flagged")
        for row in eye:
            print(f"- `{row.get('sha')}` — {row.get('subject')}")
            print(f"  - signal: `{row.get('direction_signal')}`")
            print(f"  - reason: {row.get('reason')}")
        print()
    commits = payload.get("commits") or []
    print(f"## All commits ({len(commits)})")
    for row in commits:
        print(
            f"- `{row.get('short_sha')}` {row.get('direction_signal')} "
            f"conf={row.get('confidence')} — {row.get('subject')}"
        )
        paths = row.get("paths") or []
        shown = ", ".join(paths[:5])
        suffix = f" (+{len(paths) - 5} more)" if len(paths) > 5 else ""
        if paths:
            print(f"  - paths: {shown}{suffix}")
        diff = row.get("diff_body") or {}
        if diff.get("status") and diff.get("status") != "skipped_disabled":
            disclosure = (
                f"  - diff: `{diff.get('status')}` "
                f"truncated={diff.get('truncated')} "
                f"lines={diff.get('total_lines_collected')}/{diff.get('total_lines_in_commit')} "
                f"files={diff.get('files_included')}/{diff.get('files_total')}"
            )
            print(disclosure)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Read-only commit-class narrative witness")
    parser.add_argument("--ref", default="HEAD", help="Git ref to inspect")
    parser.add_argument("--limit", type=int, default=DEFAULT_LIMIT, help="Recent commit count (or safety cap when --since is supplied)")
    parser.add_argument("--since", default=None, help="Filter to commits within window. Accepts compact forms like 14.days, 7d, 2w, 24h, 2.months, or git-readable forms (ISO date, '2 weeks ago').")
    parser.add_argument("--format", dest="format", choices=("line", "markdown", "json"), default="line", help="Output format (default: line). --json is a compat alias for --format json.")
    parser.add_argument("--include-diff", action="store_true", help="Include bounded full-diff body per commit (size-capped, with skipped-diff disclosure). Default off; preserves slice-A payload shape when absent.")
    parser.add_argument("--write-artifacts", action="store_true", help="Persist each commit row to canonical state via commit.narrator.artifact.write (Slice C). Default off.")
    parser.add_argument("--evaluate-rules", action="store_true", help="Run the deterministic rule engine (Slice D) over each commit and populate rule_layer with verdict, citations, and honest unknown when no rule applies. Reads committed governance only. Default off.")
    parser.add_argument("--from-artifacts", action="store_true", help="Slice E rollup mode: load commits from per-commit artifact yaml under \\$SPINE_STATE/domain-state/narrator/per-commit/ instead of recomputing classify+rules. Missing artifacts produce explicit disclosure rows (no silent recompute). Default off.")
    parser.add_argument("--diff-max-lines-per-file", type=int, default=500, help="Max diff lines included per file when --include-diff (default 500); excess truncated with disclosure.")
    parser.add_argument("--diff-max-lines-per-commit", type=int, default=5000, help="Max diff lines collected per commit when --include-diff (default 5000); excess truncated with disclosure.")
    parser.add_argument("--diff-max-files-per-commit", type=int, default=100, help="Max files emitted per commit when --include-diff (default 100); excess truncated with disclosure.")
    parser.add_argument("--input-node", action="append", default=[], help="Node id to summarize via node.admission.status")
    parser.add_argument("--skip-input-readbacks", action="store_true", help="Do not invoke node/site input readbacks")
    parser.add_argument("--json", action="store_true", help="Compat alias for --format json")
    parser.add_argument("--self-check", action="store_true", help="Run a lightweight self-check")
    args = parser.parse_args(argv)
    if args.json:
        args.format = "json"
    if args.since is not None and args.limit == DEFAULT_LIMIT:
        args.limit = 200
    if args.limit < 1 or args.limit > 500:
        parser.error("--limit must be between 1 and 500")
    if args.diff_max_lines_per_file < 10 or args.diff_max_lines_per_file > 50000:
        parser.error("--diff-max-lines-per-file must be between 10 and 50000")
    if args.diff_max_lines_per_commit < 100 or args.diff_max_lines_per_commit > 200000:
        parser.error("--diff-max-lines-per-commit must be between 100 and 200000")
    if args.diff_max_files_per_commit < 1 or args.diff_max_files_per_commit > 1000:
        parser.error("--diff-max-files-per-commit must be between 1 and 1000")
    if not args.input_node:
        args.input_node = list(DEFAULT_INPUT_NODES)
    return args


def _row_to_artifact_payload(row: dict[str, Any]) -> dict[str, Any]:
    fact_layer = {
        "author_date": row.get("author_date"),
        "author_name": row.get("author_name"),
        "author_email_class": row.get("author_email_class"),
        "subject": row.get("subject"),
        "paths": row.get("paths") or [],
        "status_counts": row.get("status_counts") or {},
        "shortstat": row.get("shortstat") or {},
    }
    diff_body = row.get("diff_body")
    if diff_body and diff_body.get("status") != "skipped_disabled":
        fact_layer["diff_body"] = diff_body
    payload = {
        "fact_layer": fact_layer,
        "direction_signal": row.get("direction_signal"),
        "plain_verdict": row.get("plain_verdict"),
        "confidence": row.get("confidence"),
        "confidence_boundary": row.get("confidence_boundary"),
        "reason": row.get("reason"),
        "operator_eye": row.get("operator_eye"),
        "touched_surfaces": row.get("touched_surfaces") or [],
    }
    if row.get("rule_layer"):
        payload["rule_layer"] = row["rule_layer"]
    return payload


def write_artifacts(commits: list[dict[str, Any]]) -> dict[str, Any]:
    """Persist each commit row to canonical state via routed cap.sh dispatch.

    Witness-only: the write cap's mutation surface is the per-commit yaml path
    only; this function does not promote, decide, gate, or close anything.
    """
    bin_ops = ROOT / "bin" / "ops"
    summary: dict[str, Any] = {
        "capability": "commit.narrator.artifact.write",
        "attempted": 0,
        "succeeded": 0,
        "failed": 0,
        "errors": [],
    }
    for row in commits:
        sha = row.get("sha")
        if not sha:
            continue
        summary["attempted"] += 1
        payload = _row_to_artifact_payload(row)
        try:
            proc = subprocess.run(
                [str(bin_ops), "cap", "run", "commit.narrator.artifact.write",
                 "--", "--sha", sha, "--payload-inline", "--json"],
                input=json.dumps(payload),
                cwd=str(ROOT),
                text=True,
                capture_output=True,
                timeout=45,
            )
        except subprocess.TimeoutExpired:
            summary["failed"] += 1
            summary["errors"].append({"sha": sha, "error": "write_timeout"})
            row["artifact_status"] = "failed_timeout"
            continue
        if proc.returncode != 0:
            summary["failed"] += 1
            summary["errors"].append({"sha": sha, "error": (proc.stderr or proc.stdout).strip()[:300]})
            row["artifact_status"] = "failed"
            continue
        artifact_path = None
        for line in proc.stdout.splitlines():
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict) and obj.get("status") == "written" and obj.get("artifact_path"):
                artifact_path = obj["artifact_path"]
                break
        if not artifact_path:
            try:
                start = proc.stdout.find("{")
                end = proc.stdout.rfind("}")
                if start != -1 and end != -1 and end > start:
                    obj = json.loads(proc.stdout[start:end + 1])
                    if obj.get("status") == "written":
                        artifact_path = obj.get("artifact_path")
            except json.JSONDecodeError:
                pass
        if artifact_path:
            row["artifact_path"] = artifact_path
            row["artifact_status"] = "written"
            summary["succeeded"] += 1
        else:
            summary["failed"] += 1
            summary["errors"].append({"sha": sha, "error": "write_cap_returned_no_path"})
            row["artifact_status"] = "failed_no_path"
    return summary


def evaluate_rules_into_rows(commits: list[dict[str, Any]]) -> dict[str, Any]:
    """Slice D: run the rule engine over each commit row, populating
    row['rule_layer'] in place. Returns a small summary block for the payload.
    Witness-only: this function reads committed governance and emits structured
    classifications; it does not mutate state, decide closure, or gate verify.
    """
    summary: dict[str, Any] = {
        "module": "narrator_rules",
        "evaluated": 0,
        "skipped_unavailable": 0,
        "verdict_counts": {},
    }
    if _narrator_rules is None:
        for row in commits:
            row["rule_layer"] = {
                "status": "unavailable",
                "verdict": "unknown_no_rule_applies",
                "confidence": "low",
                "rules_evaluated": 0,
                "rule_outcomes": [],
                "honest_unknown_reason": "narrator_rules module did not import",
            }
            summary["skipped_unavailable"] += 1
        return summary
    try:
        bundle = _narrator_rules.load_governance_bundle(ROOT)
    except Exception as exc:  # pragma: no cover - defensive
        for row in commits:
            row["rule_layer"] = {
                "status": "unavailable",
                "verdict": "unknown_no_rule_applies",
                "confidence": "low",
                "rules_evaluated": 0,
                "rule_outcomes": [],
                "honest_unknown_reason": f"governance bundle load error: {exc!r}",
            }
            summary["skipped_unavailable"] += 1
        return summary
    counts: dict[str, int] = {}
    for row in commits:
        rl = _narrator_rules.evaluate_commit(row, bundle)
        row["rule_layer"] = rl
        verdict = rl.get("verdict") or "unknown_no_rule_applies"
        counts[verdict] = counts.get(verdict, 0) + 1
        summary["evaluated"] += 1
    summary["verdict_counts"] = counts
    return summary


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.self_check:
        _ = recent_commits("HEAD", 1)
        print(f"{CAPABILITY} self-check PASS")
        return 0
    try:
        payload = build_payload(args)
    except Exception as exc:
        print(f"{CAPABILITY} FAIL: {exc}", file=sys.stderr)
        return 1
    if getattr(args, "evaluate_rules", False):
        payload["rule_evaluation"] = evaluate_rules_into_rows(payload.get("commits") or [])
    if getattr(args, "write_artifacts", False):
        payload["artifact_writes"] = write_artifacts(payload.get("commits") or [])
    if args.format == "json":
        print(json.dumps(payload, indent=2, sort_keys=True))
    elif args.format == "markdown":
        print_markdown(payload)
    else:
        print_human(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
