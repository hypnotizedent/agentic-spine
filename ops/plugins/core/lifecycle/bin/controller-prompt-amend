#!/usr/bin/env python3
"""controller-prompt-amend — CLI for controller_prompt.amend capability."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import controller_prompt_amend as cpa


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="controller-prompt-amend",
        description="Write a governed mid-packet continuity checkpoint to a live controller prompt.",
    )
    parser.add_argument("--packet-id", required=True, help="Packet ID to amend")
    parser.add_argument("--summary", required=True, help="Continuity summary to persist on the packet")
    parser.add_argument("--reason", required=True, help="Why this checkpoint/amendment is being recorded")
    parser.add_argument("--next-action", default="", help="Explicit next action for resumption")
    parser.add_argument(
        "--evidence-ref",
        action="append",
        default=[],
        help="Evidence reference to persist on the packet (repeatable)",
    )
    parser.add_argument(
        "--append-evidence-refs",
        action="store_true",
        help="Append incoming evidence refs instead of replacing packet evidence_refs",
    )
    parser.add_argument("--actor", default="", help="Actor identity for the checkpoint (default: terminal env)")
    parser.add_argument("--json", action="store_true", dest="json_output", help="Emit JSON output")
    parser.add_argument("--self-check", action="store_true", help="Verify dependencies and exit")

    if "--self-check" in sys.argv:
        try:
            import controller_prompt_amend  # noqa: F401
            import yaml  # noqa: F401
            print("controller_prompt.amend self-check PASS")
            return 0
        except ImportError as exc:
            print(f"controller_prompt.amend self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    spine_state = os.environ.get("SPINE_STATE", "")
    if not spine_state:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"controller_prompt.amend FAIL: {msg}", file=sys.stderr)
        return 1

    try:
        result = cpa.amend_packet(
            packet_id=args.packet_id,
            state_root=spine_state,
            summary=args.summary,
            reason=args.reason,
            next_action=args.next_action,
            evidence_refs=list(args.evidence_ref),
            append_evidence_refs=args.append_evidence_refs,
            actor=args.actor,
        )
    except cpa.ControllerPromptAmendError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"controller_prompt.amend FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"AMENDED: {result.get('packet_id', '')}")
        print(f"  amendment: {result.get('amendment_id', '')}")
        print(f"  packet: {result.get('packet_path', '')}")
        if result.get("next_action"):
            print(f"  next_action: {result.get('next_action', '')}")
        refs = result.get("evidence_refs") or []
        print(f"  evidence_refs: {len(refs)}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
