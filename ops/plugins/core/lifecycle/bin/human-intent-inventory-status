#!/usr/bin/env python3
"""human-intent-inventory-status — one readback for known Ronny input sources."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

from human_intent_inventory import build_inventory


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="human-intent-inventory-status",
        description="Generated read-only inventory of human intent input sources and carriers.",
    )
    parser.add_argument("--json", action="store_true", dest="json_output", help="Emit JSON output.")
    parser.add_argument("--limit", type=int, default=0, help="Limit printed rows in text mode.")
    parser.add_argument("--oi-limit", type=int, default=0, help="Limit OI rows; 0 means all.")
    parser.add_argument(
        "--extra-root",
        action="append",
        default=[],
        help="Additional path/folder root to compare against known captured sources.",
    )
    parser.add_argument("--self-check", action="store_true", help="Verify dependencies and exit.")
    args = parser.parse_args()

    if args.self_check:
        try:
            import yaml  # noqa: F401
            print("human.intent.inventory.status self-check PASS")
            return 0
        except ImportError as exc:
            print(f"human.intent.inventory.status self-check FAIL: {exc}", file=sys.stderr)
            return 1

    state_root = Path(os.environ.get("SPINE_STATE", Path.home() / "code" / ".runtime" / "spine" / "state"))
    evidence_root = Path(os.environ.get("SPINE_EVIDENCE_ROOT", Path.home() / "code" / ".evidence" / "spine"))
    extra_roots = [Path(p).expanduser() for p in args.extra_root] if args.extra_root else None
    inventory = build_inventory(
        repo=ROOT,
        state_root=state_root,
        evidence_root=evidence_root,
        extra_roots=extra_roots,
        oi_limit=args.oi_limit or None,
    )

    if args.json_output:
        print(json.dumps(inventory, indent=2, sort_keys=False))
        return 0

    summary = inventory["summary"]
    print("=== HUMAN INTENT INVENTORY ===")
    print(f"Rows: {summary['total_rows']}")
    print("Source kinds: " + ", ".join(f"{k}={v}" for k, v in sorted(summary["by_source_kind"].items())))
    print("Capture: " + ", ".join(f"{k}={v}" for k, v in sorted(summary["by_capture_status"].items())))
    print("Review: " + ", ".join(f"{k}={v}" for k, v in sorted(summary["by_review_status"].items())))
    print("")
    items = inventory["items"]
    if args.limit:
        items = items[: args.limit]
    for row in items:
        print(
            f"{row['source_id']} | {row['source_kind']} | {row['capture_status']} | "
            f"{row['review_status']} | {row['carrier_kind']}:{row['carrier_ref']}"
        )
        if row.get("next_missing_step") and row["next_missing_step"] != "none":
            print(f"  missing: {row['next_missing_step']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
