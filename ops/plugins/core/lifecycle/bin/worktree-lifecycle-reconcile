#!/usr/bin/env python3
"""Worktree lifecycle classifier for worktree-lifecycle-cleanup.

This is intentionally boring: it reports enough structured state for the
cleanup wrapper to decide what is safe to archive/delete. It does not mutate.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


def run(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=str(cwd) if cwd else None, text=True, capture_output=True)


def git(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return run(["git", "-C", str(repo), *args])


def parse_worktree_list(repo: Path) -> list[dict[str, Any]]:
    proc = git(repo, "worktree", "list", "--porcelain")
    if proc.returncode != 0:
        return []
    rows: list[dict[str, Any]] = []
    row: dict[str, Any] = {}
    for raw in proc.stdout.splitlines():
        line = raw.strip()
        if not line:
            if row:
                rows.append(row)
                row = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            row["path"] = value
        elif key == "HEAD":
            row["head"] = value
        elif key == "branch":
            row["branch_ref"] = value
            row["branch"] = value.removeprefix("refs/heads/")
        elif key == "detached":
            row["detached"] = True
        else:
            row[key] = value or True
    if row:
        rows.append(row)
    for idx, item in enumerate(rows):
        item["is_primary"] = idx == 0
    return rows


def is_dirty(path: Path) -> bool:
    proc = git(path, "status", "--porcelain", "--untracked-files=all")
    return proc.returncode != 0 or bool(proc.stdout.strip())


def merged_into(repo: Path, branch_ref: str | None, main_ref: str) -> bool:
    if not branch_ref:
        return False
    proc = git(repo, "merge-base", "--is-ancestor", branch_ref, main_ref)
    return proc.returncode == 0


def load_lease(path: Path) -> dict[str, Any]:
    lease_path = path / ".spine-lane-lease.yaml"
    if not lease_path.exists():
        return {"present": False, "active": False}

    raw = lease_path.read_text(encoding="utf-8", errors="replace")
    lease: dict[str, Any] = {"present": True, "active": False, "path": str(lease_path)}
    for line in raw.splitlines():
        if ":" not in line or line.lstrip().startswith("#"):
            continue
        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip().strip("'\"")
        if key in {"status", "owner", "loop_or_wave_id", "heartbeat_at", "ttl_hours"}:
            lease[key] = value

    status = str(lease.get("status") or "").lower()
    heartbeat = str(lease.get("heartbeat_at") or "")
    ttl_raw = str(lease.get("ttl_hours") or "0")
    active = status == "active"
    try:
        ttl_hours = float(ttl_raw)
        if heartbeat and ttl_hours > 0:
            hb = datetime.fromisoformat(heartbeat.replace("Z", "+00:00"))
            age_hours = (datetime.now(timezone.utc) - hb).total_seconds() / 3600
            lease["age_hours"] = round(age_hours, 3)
            if age_hours > ttl_hours:
                active = False
    except Exception:
        pass
    lease["active"] = bool(active)
    return lease


def packet_status(state_root: Path, packet_id: str) -> str | None:
    prompts_dir = state_root / "controller-prompts"
    if not prompts_dir.exists():
        return None
    matches = sorted(prompts_dir.glob(f"CONTROLLER-{packet_id}-*.md"))
    if not matches:
        matches = sorted(prompts_dir.glob(f"{packet_id}-*.md"))
    if not matches:
        return None
    status = "present"
    try:
        for raw in matches[0].read_text(encoding="utf-8", errors="replace").splitlines()[:40]:
            if raw.strip() == "---" and status != "present":
                break
            if raw.startswith("status:"):
                value = raw.split(":", 1)[1].strip().strip("'\"")
                status = value or status
                break
    except Exception:
        return "unknown"
    return status


def classify_owner(state_root: Path, identity: str | None) -> tuple[str | None, str | None]:
    if not identity:
        return None, None
    loop_scope = state_root / "loop-scopes" / f"{identity}.scope.md"
    closed_scope = state_root / "archive" / "closed-loop-scopes" / f"{identity}.scope.md"
    wave_state = state_root.parent / "waves" / identity / "state.json"
    if loop_scope.exists():
        return "loop", "active"
    if closed_scope.exists():
        return "loop", "closed"
    if wave_state.exists():
        try:
            data = json.loads(wave_state.read_text(encoding="utf-8"))
            return "wave", str(data.get("status") or data.get("lifecycle") or "unknown")
        except Exception:
            return "wave", "unknown"
    if identity.startswith("PACKET-"):
        status = packet_status(state_root, identity)
        return "packet", status or "unresolved"
    return None, None


def owner_id_from_branch(branch: str | None) -> str | None:
    if not branch or branch == "<detached>":
        return None
    if branch.startswith("codex/"):
        return branch.split("/", 1)[1]
    if branch.startswith("orchestration/"):
        return branch.split("/", 1)[1]
    if "PACKET-" in branch:
        owner = "PACKET-" + branch.split("PACKET-", 1)[1]
        return re.sub(r"-20[0-9]{6}$", "", owner)
    return branch


def rehydrate_command(branch: str | None, owner_id: str | None, repo: Path) -> str:
    lane = owner_id or "<LANE_ID>"
    branch_arg = branch or "<BRANCH>"
    return (
        "./bin/ops cap run worktree.lifecycle.rehydrate -- "
        f"--branch {branch_arg} --lane {lane} --repo {repo}"
    )


def cleanup_command() -> str:
    return "./bin/ops cap run worktree.lifecycle.cleanup -- --mode archive-only --json"


def classify_ownership(
    *,
    repo: Path,
    path: Path,
    branch: str | None,
    owner_id: str | None,
    owner_type: str | None,
    owner_state: str | None,
    lease: dict[str, Any],
    merged: bool,
    dirty: bool,
) -> dict[str, Any]:
    evidence: list[str] = []
    if lease.get("present"):
        lease_status = str(lease.get("status") or "unknown")
        lease_owner = str(lease.get("owner") or "unknown")
        evidence.append(f"lease:{lease_status}:owner={lease_owner}")
        if lease.get("heartbeat_at"):
            evidence.append(f"lease_heartbeat_at:{lease.get('heartbeat_at')}")
    else:
        evidence.append("lease:missing")

    if owner_type:
        evidence.append(f"owner:{owner_type}:{owner_state or 'unknown'}")
    elif owner_id:
        evidence.append(f"owner:{owner_id}:not_found_in_local_projection")
    else:
        evidence.append("owner:unknown")

    if lease.get("active"):
        return {
            "ownership_status": "active_lease",
            "ownership_evidence": evidence,
            "cleanup_class": "blocked_active_lease",
            "next_action": f"./bin/ops cap run worktree.lease.heartbeat -- --status --worktree {path}",
        }

    active_owner = owner_type in {"loop", "wave"} and owner_state == "active"
    if active_owner:
        return {
            "ownership_status": "active_owner_missing_active_lease",
            "ownership_evidence": evidence,
            "cleanup_class": "blocked_active_owner_missing_lease",
            "next_action": rehydrate_command(branch, owner_id, repo),
        }

    if dirty:
        return {
            "ownership_status": "unclaimed_dirty_residue",
            "ownership_evidence": evidence,
            "cleanup_class": "blocked_dirty_residue_reclaim_or_clean",
            "next_action": rehydrate_command(branch, owner_id, repo),
        }

    if owner_type == "packet" and owner_state in {"unresolved", "draft", "open", "active", "in_progress", "present"}:
        return {
            "ownership_status": f"packet_owner_{owner_state}",
            "ownership_evidence": evidence,
            "cleanup_class": "blocked_packet_owner_not_terminal",
            "next_action": f"./bin/ops cap run controller_prompt.status -- --packet-id {owner_id}",
        }

    if not merged:
        status = "open_packet_missing_active_lease" if owner_type == "packet" else "unclaimed_unmerged_branch"
        return {
            "ownership_status": status,
            "ownership_evidence": evidence,
            "cleanup_class": "blocked_unmerged_branch",
            "next_action": rehydrate_command(branch, owner_id, repo),
        }

    return {
        "ownership_status": "cleanable_landed_residue",
        "ownership_evidence": evidence,
        "cleanup_class": "cleanable_after_archive",
        "next_action": cleanup_command(),
    }


def stash_rows(repo: Path) -> list[dict[str, Any]]:
    proc = git(repo, "stash", "list", "--format=%gd%x09%H%x09%gs")
    if proc.returncode != 0:
        return []
    rows = []
    for raw in proc.stdout.splitlines():
        parts = raw.split("\t", 2)
        if len(parts) != 3:
            continue
        ref, commit, subject = parts
        rows.append(
            {
                "ref": ref,
                "commit": commit,
                "subject": subject,
                "branch": None,
                "message": subject,
                "age_hours": None,
                "cleanup_candidate": False,
                "issues": ["manual_review_required"],
                "warnings": [],
            }
        )
    return rows


def temp_clone_rows(root: Path) -> list[dict[str, Any]]:
    if not root.exists():
        return []
    rows: list[dict[str, Any]] = []
    for path in sorted(p for p in root.iterdir() if p.is_dir()):
        rows.append(
            {
                "path": str(path),
                "branch": None,
                "origin_kind": "unknown",
                "origin_exists": None,
                "age_hours": None,
                "dirty": is_dirty(path) if (path / ".git").exists() else True,
            }
        )
    return rows


def resolve_repo() -> Path:
    explicit = os.environ.get("SPINE_TARGET_REPO") or os.environ.get("SPINE_REPO")
    if explicit:
        return Path(explicit).expanduser().resolve()
    proc = run(["git", "rev-parse", "--show-toplevel"])
    if proc.returncode == 0 and proc.stdout.strip():
        return Path(proc.stdout.strip()).resolve()
    return Path.cwd().resolve()


def common_repo_name(repo: Path) -> str:
    proc = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if proc.returncode == 0 and proc.stdout.strip():
        common_dir = Path(proc.stdout.strip()).resolve()
        if common_dir.name == ".git":
            return common_dir.parent.name
    return repo.name


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    repo = resolve_repo()
    state_root = Path(os.environ.get("SPINE_STATE") or repo.parent / ".runtime" / "spine" / "state").resolve()
    tmp_root = Path(os.environ.get("SPINE_TMP") or repo.parent / ".runtime" / "spine" / "tmp").resolve()
    worktree_root = Path(os.environ.get("SPINE_WORKTREE_LIFECYCLE_WORKTREE_ROOT") or tmp_root / "worktrees").resolve()
    temp_clone_root = Path(os.environ.get("SPINE_WORKTREE_LIFECYCLE_TEMP_CLONE_ROOT") or tmp_root / "clones").resolve()
    main_ref = os.environ.get("SPINE_WORKTREE_LIFECYCLE_MAIN_REF", "main")

    repo_name = common_repo_name(repo)
    worktree_entries = parse_worktree_list(repo)
    primary_entry = next((wt for wt in worktree_entries if wt.get("is_primary")), None)
    primary_path = (
        Path(str(primary_entry.get("path") or "")).resolve()
        if primary_entry
        else repo
    )

    rows: list[dict[str, Any]] = []
    for wt in worktree_entries:
        path = Path(str(wt.get("path") or "")).resolve()
        if not path.exists() or wt.get("is_primary"):
            continue
        branch_ref = wt.get("branch_ref")
        branch = wt.get("branch")
        lease = load_lease(path)
        owner_id = str(lease.get("loop_or_wave_id") or owner_id_from_branch(branch) or "")
        owner_type, owner_state = classify_owner(state_root, str(owner_id) if owner_id else None)
        merged = merged_into(repo, branch_ref, main_ref)
        dirty = is_dirty(path)
        ownership = classify_ownership(
            repo=repo,
            path=path,
            branch=branch,
            owner_id=owner_id or None,
            owner_type=owner_type,
            owner_state=owner_state,
            lease=lease,
            merged=merged,
            dirty=dirty,
        )
        rows.append(
            {
                "path": str(path),
                "branch": branch or "<detached>",
                "branch_ref": branch_ref,
                "head": wt.get("head"),
                "managed_worktree": False,
                "canonical_root_ok": str(path).startswith(str(worktree_root / repo_name) + os.sep),
                "lease": lease,
                "owner_id": owner_id or None,
                "owner_type": owner_type,
                "owner_state": owner_state,
                "merged_into_main": merged,
                "dirty": dirty,
                **ownership,
            }
        )

    root_branch = git(primary_path, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    root_dirty = is_dirty(primary_path)
    root_checkout = {
        "checked": True,
        "path": str(primary_path),
        "branch": root_branch,
        "main_branch": main_ref,
        "normalizable": (root_branch != main_ref and not root_dirty),
        "issues": ([] if root_branch == main_ref and not root_dirty else ["root_not_clean_or_not_main"]),
    }

    report = {
        "schema_version": "1.0",
        "snapshot": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "repo": str(repo),
        "main_ref": main_ref,
        "worktree_root": str(worktree_root),
        "temp_clone_root": str(temp_clone_root),
        "root_checkout": root_checkout,
        "worktrees": rows,
        "temp_clones": temp_clone_rows(temp_clone_root),
        "stashes": stash_rows(repo),
    }

    if args.json:
        json.dump(report, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        print(json.dumps(report, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
