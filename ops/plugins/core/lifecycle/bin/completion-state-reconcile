#!/usr/bin/env python3
"""Completion-state reconciler — read-only capability entry surface.

Classifies all work items (loops, worktrees, stashes, parked branches,
unpushed commits) into six states using the PACKET-38 design model.

Usage:
    completion-state-reconcile [--json] [--summary]

Flags:
    --json      Emit full structured JSON (default: human-readable)
    --summary   Emit summary counts only (for status integration)
    -h, --help  Show this help

Design authority: COMPLETION-STATE-RECONCILER-DESIGN-20260416.md
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from completion_state_reconciler import reconcile, summary_for_joined_state


def resolve_repo_root() -> Path:
    """Resolve the real repo root, even when running from a worktree.

    Uses git's common dir to find the primary checkout, since worktrees
    share the same .git/common dir as the main checkout.
    """
    script_dir = Path(__file__).resolve().parent
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=str(script_dir), capture_output=True, text=True, check=True, timeout=5,
        )
        # git-common-dir returns e.g. /repo/.git — parent is the repo root
        common_dir = Path(proc.stdout.strip())
        return common_dir.parent
    except (subprocess.SubprocessError, OSError):
        # Fallback: walk up from script
        return script_dir.parents[4]


def resolve_state_root(repo_root: Path) -> Path:
    return Path(
        os.environ.get("SPINE_STATE")
        or str(repo_root.parent / ".runtime" / "spine" / "state")
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Completion-state reconciler — classify work items into six states."
    )
    parser.add_argument("--json", action="store_true", help="Emit full JSON output")
    parser.add_argument("--summary", action="store_true", help="Summary counts only")
    parser.add_argument("--", dest="passthrough_separator", nargs="?", help=argparse.SUPPRESS)
    args, _unknown = parser.parse_known_args()

    root = resolve_repo_root()
    state_root = resolve_state_root(root)

    # Detect current worktree from CWD or env
    current_worktree = os.environ.get("SPINE_WORKTREE_PATH")
    if not current_worktree:
        cwd = os.getcwd()
        if os.path.normpath(cwd) != os.path.normpath(str(root)):
            current_worktree = cwd

    result = reconcile(str(root), str(state_root), current_worktree=current_worktree)

    if args.summary:
        summary = summary_for_joined_state(result)
        if args.json:
            json.dump(summary, sys.stdout, indent=2)
            sys.stdout.write("\n")
        else:
            print("completion.state.reconcile (summary)")
            for key, value in summary.items():
                print(f"  {key}: {value}")
        return 0

    if args.json:
        json.dump(result, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    # Human-readable output
    print("completion.state.reconcile")
    print(f"snapshot: {result['snapshot_timestamp']}")
    print(f"total: {result['total_specimens']} specimens"
          f" ({result['live_specimens']} live, {result['non_live_specimens']} non-live)")
    print()

    counts = result.get("state_counts", {})
    ambiguous = result.get("ambiguous_count", 0)
    print("State counts:")
    for state_name in ("open", "parked", "landed_local", "delivered", "owned_elsewhere", "orphaned"):
        count = counts.get(state_name, 0)
        if count > 0:
            print(f"  {state_name}: {count}")
    if ambiguous > 0:
        print(f"  ambiguous: {ambiguous}")
    print()

    for item in result.get("classifications", []):
        state = item.get("computed_state") or "(non-live)"
        confidence = item.get("confidence", "?")
        obj_class = item.get("object_class", "?")
        identity = item.get("identity", "?")
        is_live = item.get("is_live", True)

        marker = ""
        if state == "ambiguous":
            marker = " [!]"
        elif not is_live:
            marker = " [non-live]"

        print(f"  [{obj_class:20s}] {identity}")
        print(f"    state: {state}{marker}  confidence: {confidence}")
        evidence = item.get("evidence", "")
        if evidence:
            print(f"    evidence: {evidence}")
        reason = item.get("ambiguity_reason", "")
        if reason:
            print(f"    ambiguity: {reason}")
        note = item.get("note", "")
        if note:
            print(f"    note: {note}")
        print()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
