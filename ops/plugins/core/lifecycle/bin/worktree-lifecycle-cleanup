#!/usr/bin/env bash
set -euo pipefail

CONTROL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
TARGET_ROOT="${SPINE_TARGET_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "${SPINE_REPO:-$PWD}")}"
export SPINE_CODE="${SPINE_CODE:-$CONTROL_ROOT}"
export SPINE_REPO="$TARGET_ROOT"
source "$CONTROL_ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
source "$CONTROL_ROOT/ops/lib/git-lock.sh"
CONTRACT="$CONTROL_ROOT/ops/bindings/worktree.lifecycle.contract.yaml"
CLOSEOUT_CONTRACT="$CONTROL_ROOT/ops/bindings/wave.closeout.contract.yaml"
RECONCILE_SCRIPT="$CONTROL_ROOT/ops/plugins/core/lifecycle/bin/worktree-lifecycle-reconcile"

MODE="report-only"
TOKEN=""
MANIFEST=""
JSON_MODE=0

usage() {
  cat <<'USAGE'
worktree-lifecycle-cleanup

Usage:
  worktree-lifecycle-cleanup --mode report-only|archive-only|delete [--token <token>] [--manifest <path>] [--json]

Modes:
  report-only  Classify only; no filesystem/git mutations.
  archive-only Snapshot + archive candidate worktrees (no delete).
  delete       Token-gated delete path (requires archive manifest when contract enabled).
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --token) TOKEN="${2:-}"; shift 2 ;;
    --manifest) MANIFEST="${2:-}"; shift 2 ;;
    --json) JSON_MODE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

case "$MODE" in
  report-only|archive-only|delete) ;;
  *) echo "FAIL: --mode must be report-only|archive-only|delete" >&2; exit 2 ;;
esac

MAIN_BRANCH="main"
CANONICAL_WORKTREE_ROOT="${SPINE_WORKTREE_LIFECYCLE_WORKTREE_ROOT:-$SPINE_TMP/worktrees}"
CANONICAL_TEMP_CLONE_ROOT="${SPINE_WORKTREE_LIFECYCLE_TEMP_CLONE_ROOT:-$SPINE_TMP/clones}"
TEMP_CLONE_GRACE_HOURS="24"
ARCHIVE_ROOT="$HOME/.local/state/agentic-spine/worktree-lifecycle-archive"
DELETE_TOKEN_ENV="OPS_WORKTREE_DELETE_TOKEN"
DELETE_TOKEN_VALUE="RELEASE_MAIN_CLEANUP_WINDOW"
REQUIRE_ARCHIVE="true"
REQUIRE_MERGED_OR_TOKEN="true"
BLOCK_ACTIVE_LEASE="true"
NORMALIZE_ROOT_WHEN_HEAD_MATCHES_MAIN="true"
REQUIRE_CLEAN_WORKTREE_DELETE="true"
REQUIRE_CLEAN_TEMP_CLONE_DELETE="true"
REQUIRE_RECEIPT_GATE_PASS_DELETE="true"
RECEIPT_CRUMB_LOCK="$CONTROL_ROOT/ops/plugins/core/orchestration/bin/receipt-closeout-completeness-lock"

if command -v yq >/dev/null 2>&1 && [[ -f "$CONTRACT" ]]; then
  MAIN_BRANCH="$(yq e -r '.policy.main_branch // "main"' "$CONTRACT" 2>/dev/null || echo "$MAIN_BRANCH")"
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_WORKTREE_ROOT:-}" ]]; then
    CANONICAL_WORKTREE_ROOT="$(yq e -r '.policy.canonical_worktree_root // ""' "$CONTRACT" 2>/dev/null || echo "$CANONICAL_WORKTREE_ROOT")"
    [[ -n "$CANONICAL_WORKTREE_ROOT" && "$CANONICAL_WORKTREE_ROOT" != "null" ]] || CANONICAL_WORKTREE_ROOT="$SPINE_TMP/worktrees"
  fi
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_TEMP_CLONE_ROOT:-}" ]]; then
    CANONICAL_TEMP_CLONE_ROOT="$(yq e -r '.policy.canonical_temp_clone_root // ""' "$CONTRACT" 2>/dev/null || echo "$CANONICAL_TEMP_CLONE_ROOT")"
    [[ -n "$CANONICAL_TEMP_CLONE_ROOT" && "$CANONICAL_TEMP_CLONE_ROOT" != "null" ]] || CANONICAL_TEMP_CLONE_ROOT="$SPINE_TMP/clones"
  fi
  TEMP_CLONE_GRACE_HOURS="$(yq e -r '.policy.temp_clone_grace_hours // 24' "$CONTRACT" 2>/dev/null || echo "$TEMP_CLONE_GRACE_HOURS")"
  ARCHIVE_ROOT="$(yq e -r '.runtime.archive_root // "~/.local/state/agentic-spine/worktree-lifecycle-archive"' "$CONTRACT" 2>/dev/null || echo "$ARCHIVE_ROOT")"
  DELETE_TOKEN_ENV="$(yq e -r '.cleanup.delete_token_env_var // "OPS_WORKTREE_DELETE_TOKEN"' "$CONTRACT" 2>/dev/null || echo "$DELETE_TOKEN_ENV")"
  DELETE_TOKEN_VALUE="$(yq e -r '.cleanup.delete_token_value // "RELEASE_MAIN_CLEANUP_WINDOW"' "$CONTRACT" 2>/dev/null || echo "$DELETE_TOKEN_VALUE")"
  REQUIRE_ARCHIVE="$(yq e -r '.cleanup.require_archive_before_delete // true' "$CONTRACT" 2>/dev/null || echo true)"
  REQUIRE_MERGED_OR_TOKEN="$(yq e -r '.cleanup.require_branch_merged_or_explicit_token // true' "$CONTRACT" 2>/dev/null || echo true)"
  BLOCK_ACTIVE_LEASE="$(yq e -r '.cleanup.block_if_active_lease // true' "$CONTRACT" 2>/dev/null || echo true)"
  NORMALIZE_ROOT_WHEN_HEAD_MATCHES_MAIN="$(yq e -r '.cleanup.normalize_root_when_head_matches_main // true' "$CONTRACT" 2>/dev/null || echo true)"
  REQUIRE_CLEAN_TEMP_CLONE_DELETE="$(yq e -r '.cleanup.require_clean_temp_clone_for_delete // true' "$CONTRACT" 2>/dev/null || echo true)"
fi

if command -v yq >/dev/null 2>&1 && [[ -f "$CLOSEOUT_CONTRACT" ]]; then
  REQUIRE_CLEAN_WORKTREE_DELETE="$(yq e -r '.closeout.require_clean_worktree_for_cleanup_delete // true' "$CLOSEOUT_CONTRACT" 2>/dev/null || echo true)"
  REQUIRE_RECEIPT_GATE_PASS_DELETE="$(yq e -r '.closeout.require_receipt_gate_pass_for_cleanup_delete // true' "$CLOSEOUT_CONTRACT" 2>/dev/null || echo true)"
  RECEIPT_CRUMB_LOCK_REL="$(yq e -r '.finalize.receipt_crumb_lock_script // "ops/plugins/core/orchestration/bin/receipt-closeout-completeness-lock"' "$CLOSEOUT_CONTRACT" 2>/dev/null || echo "ops/plugins/core/orchestration/bin/receipt-closeout-completeness-lock")"
  RECEIPT_CRUMB_LOCK="$CONTROL_ROOT/$RECEIPT_CRUMB_LOCK_REL"
fi

ARCHIVE_ROOT="$(python3 - "$ARCHIVE_ROOT" <<'PY'
import os
import sys

print(os.path.expanduser(sys.argv[1]))
PY
)"

if [[ -n "${OPS_WORKTREE_CLEANUP_REQUIRE_RECEIPT_GATE_PASS_DELETE:-}" ]]; then
  REQUIRE_RECEIPT_GATE_PASS_DELETE="${OPS_WORKTREE_CLEANUP_REQUIRE_RECEIPT_GATE_PASS_DELETE}"
fi
if [[ -n "${OPS_WORKTREE_CLEANUP_REQUIRE_CLEAN_WORKTREE_DELETE:-}" ]]; then
  REQUIRE_CLEAN_WORKTREE_DELETE="${OPS_WORKTREE_CLEANUP_REQUIRE_CLEAN_WORKTREE_DELETE}"
fi
if [[ -n "${OPS_WORKTREE_CLEANUP_REQUIRE_CLEAN_TEMP_CLONE_DELETE:-}" ]]; then
  REQUIRE_CLEAN_TEMP_CLONE_DELETE="${OPS_WORKTREE_CLEANUP_REQUIRE_CLEAN_TEMP_CLONE_DELETE}"
fi

if [[ "$MODE" == "delete" ]]; then
  acquire_git_lock worktree-lifecycle-cleanup || exit 1
fi

ENV_TOKEN="${!DELETE_TOKEN_ENV-}"
if [[ -z "$TOKEN" ]]; then
  TOKEN="$ENV_TOKEN"
fi
EXPLICIT_TOKEN=0
if [[ -n "$TOKEN" && "$TOKEN" == "$DELETE_TOKEN_VALUE" ]]; then
  EXPLICIT_TOKEN=1
fi

RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_ID="WORKTREE-LC-${RUN_TS}-$$"
ARTIFACT_ROOT="$(spine_resolve_mailroom_path 'evidence/loop-closeouts/worktree-lifecycle-cleanup')"
ARTIFACT_DIR="$ARTIFACT_ROOT/$RUN_ID"
mkdir -p "$ARTIFACT_DIR"

REPORT_JSON="$ARTIFACT_DIR/report.json"
POST_REPORT_JSON=""
REPORT_MD="$ARTIFACT_DIR/report.md"
ARCHIVE_MANIFEST="$ARTIFACT_DIR/archive-manifest.json"
ACTIONS_LOG="$ARTIFACT_DIR/actions.log"

if [[ ! -x "$RECONCILE_SCRIPT" ]]; then
  echo "FAIL: reconcile classifier not found: $RECONCILE_SCRIPT" >&2
  exit 1
fi
SPINE_TARGET_REPO="$TARGET_ROOT" "$RECONCILE_SCRIPT" --json > "$REPORT_JSON"

python3 - "$REPORT_JSON" "$REPORT_MD" "$MODE" "$BLOCK_ACTIVE_LEASE" "$REQUIRE_MERGED_OR_TOKEN" "$EXPLICIT_TOKEN" "$REQUIRE_CLEAN_WORKTREE_DELETE" "$REQUIRE_CLEAN_TEMP_CLONE_DELETE" "$TEMP_CLONE_GRACE_HOURS" "$NORMALIZE_ROOT_WHEN_HEAD_MATCHES_MAIN" <<'PY'
import json, subprocess, sys
from pathlib import Path

report = json.loads(Path(sys.argv[1]).read_text())
md = Path(sys.argv[2])
mode = sys.argv[3]
block_active = sys.argv[4].lower() == "true"
require_merged_or_token = sys.argv[5].lower() == "true"
explicit_token = sys.argv[6] == "1"
require_clean_delete = sys.argv[7].lower() == "true"
require_clean_temp_clone_delete = sys.argv[8].lower() == "true"
temp_clone_grace_h = float(sys.argv[9])
normalize_root = sys.argv[10].lower() == "true"

rows = report.get("worktrees", [])
clone_rows = report.get("temp_clones", [])
stash_rows = report.get("stashes", [])
root_checkout = report.get("root_checkout") or {}

blocked = []
delete_candidates = []
root_violations = []
clone_blocked = []
clone_delete_candidates = []
stash_blocked = []
stash_delete_candidates = []
root_normalization = {"candidate": None, "blocked": None}


def candidate_row(row):
    return {
        "path": row["path"],
        "branch": row["branch"],
        "owner_id": row.get("owner_id"),
        "ownership_status": row.get("ownership_status"),
        "cleanup_class": row.get("cleanup_class"),
        "next_action": row.get("next_action"),
    }


def lease_only_dirty(row):
    lease = row.get("lease") or {}
    if lease.get("active"):
        return False
    if row.get("owner_type") in {"loop", "wave"} and row.get("owner_state") == "active":
        return False
    wt = row.get("path")
    if not wt or not Path(wt).exists():
        return False
    proc = subprocess.run(
        ["git", "-C", wt, "status", "--porcelain", "--untracked-files=all"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return False
    lines = [line.strip() for line in (proc.stdout or "").splitlines() if line.strip()]
    return bool(lines) and all(line == "?? .spine-lane-lease.yaml" for line in lines)

for row in rows:
    reasons = []
    lease = row.get("lease") or {}
    cleanup_class = str(row.get("cleanup_class") or "")
    if cleanup_class.startswith("blocked_"):
        reasons.append(cleanup_class)
    if row.get("managed_worktree"):
        reasons.append("managed_worktree_protected")
    elif not row.get("canonical_root_ok", True):
        reasons.append("noncanonical_worktree_root")
        root_violations.append(row["path"])
    if block_active and lease.get("active"):
        reasons.append("active_lease")
    if require_merged_or_token and not row.get("merged_into_main", False) and not explicit_token:
        reasons.append("not_merged_no_token")
    row["cleanup_lease_only_residue"] = False
    if require_clean_delete and row.get("dirty", False):
        row["cleanup_lease_only_residue"] = lease_only_dirty(row)
        if not row["cleanup_lease_only_residue"]:
            reasons.append("dirty_worktree")

    if reasons:
        blocked.append({**candidate_row(row), "reasons": reasons})
    else:
        delete_candidates.append(candidate_row(row))

for row in clone_rows:
    reasons = []
    eligible = False
    age = row.get("age_hours")
    if row.get("origin_kind") == "local_path" and row.get("origin_exists") is False:
        eligible = True
    if age is not None and age >= temp_clone_grace_h:
        eligible = True
    if not eligible:
        reasons.append("within_grace")
    if require_clean_temp_clone_delete and row.get("dirty", False):
        reasons.append("dirty_temp_clone")
    if reasons:
        clone_blocked.append({"path": row["path"], "branch": row.get("branch"), "reasons": reasons})
    else:
        clone_delete_candidates.append({"path": row["path"], "branch": row.get("branch")})

for row in stash_rows:
    reasons = []
    if not row.get("cleanup_candidate"):
        reasons.append("not_cleanup_candidate")
    candidate = {
        "ref": row.get("ref"),
        "commit": row.get("commit"),
        "branch": row.get("branch"),
        "subject": row.get("subject"),
        "message": row.get("message"),
        "age_hours": row.get("age_hours"),
        "issues": list(row.get("issues") or []),
        "warnings": list(row.get("warnings") or []),
    }
    if reasons:
        candidate["reasons"] = reasons
        stash_blocked.append(candidate)
    else:
        stash_delete_candidates.append(candidate)

if root_checkout.get("checked"):
    if normalize_root and root_checkout.get("normalizable"):
        root_normalization["candidate"] = {
            "path": root_checkout["path"],
            "from_branch": root_checkout.get("branch"),
            "to_branch": root_checkout.get("main_branch"),
        }
    elif root_checkout.get("issues"):
        root_normalization["blocked"] = {
            "path": root_checkout["path"],
            "branch": root_checkout.get("branch"),
            "reasons": list(root_checkout.get("issues") or []),
        }

summary = {
    "mode": mode,
    "worktree_count": len(rows),
    "temp_clone_count": len(clone_rows),
    "delete_candidate_count": len(delete_candidates),
    "temp_clone_delete_candidate_count": len(clone_delete_candidates),
    "blocked_count": len(blocked),
    "temp_clone_blocked_count": len(clone_blocked),
    "stash_delete_candidate_count": len(stash_delete_candidates),
    "stash_blocked_count": len(stash_blocked),
    "root_violation_count": len(root_violations),
    "root_normalization_candidate_count": 1 if root_normalization["candidate"] else 0,
    "root_normalization_blocked_count": 1 if root_normalization["blocked"] else 0,
}

report["summary"] = summary
report["delete_candidates"] = delete_candidates
report["blocked"] = blocked
report["temp_clone_delete_candidates"] = clone_delete_candidates
report["temp_clone_blocked"] = clone_blocked
report["stash_delete_candidates"] = stash_delete_candidates
report["stash_blocked"] = stash_blocked
report["root_normalization"] = root_normalization
report["root_violations"] = root_violations
Path(sys.argv[1]).write_text(json.dumps(report, indent=2) + "\n")

with md.open("w", encoding="utf-8") as f:
    f.write("# Worktree Lifecycle Cleanup Report\n\n")
    f.write(f"- mode: {mode}\n")
    f.write(f"- worktrees: {summary['worktree_count']}\n")
    f.write(f"- temp_clones: {summary['temp_clone_count']}\n")
    f.write(f"- delete_candidates: {summary['delete_candidate_count']}\n")
    f.write(f"- temp_clone_delete_candidates: {summary['temp_clone_delete_candidate_count']}\n")
    f.write(f"- stash_delete_candidates: {summary['stash_delete_candidate_count']}\n")
    f.write(f"- blocked: {summary['blocked_count']}\n")
    f.write(f"- temp_clone_blocked: {summary['temp_clone_blocked_count']}\n")
    f.write(f"- stash_blocked: {summary['stash_blocked_count']}\n")
    f.write(f"- root_violations: {summary['root_violation_count']}\n\n")
    f.write("## Delete Candidates\n")
    for item in delete_candidates:
      f.write(f"- {item['path']} | {item['branch']} | {item.get('ownership_status') or 'unknown'} | {item.get('next_action') or ''}\n")
    if not delete_candidates:
      f.write("- none\n")
    f.write("\n## Temp Clone Delete Candidates\n")
    for item in clone_delete_candidates:
      f.write(f"- {item['path']} | {item.get('branch') or '<detached>'}\n")
    if not clone_delete_candidates:
      f.write("- none\n")
    f.write("\n## Stash Delete Candidates\n")
    for item in stash_delete_candidates:
      f.write(f"- {item['ref']} | {item.get('branch') or '<unknown>'} | {item.get('commit') or '<unknown>'}\n")
    if not stash_delete_candidates:
      f.write("- none\n")
    f.write("\n## Blocked\n")
    for item in blocked:
      f.write(f"- {item['path']} | {item['branch']} | {','.join(item['reasons'])} | {item.get('ownership_status') or 'unknown'} | {item.get('next_action') or ''}\n")
    if not blocked:
      f.write("- none\n")
    f.write("\n## Temp Clone Blocked\n")
    for item in clone_blocked:
      f.write(f"- {item['path']} | {item.get('branch') or '<detached>'} | {','.join(item['reasons'])}\n")
    if not clone_blocked:
      f.write("- none\n")
    f.write("\n## Stash Blocked\n")
    for item in stash_blocked:
      f.write(f"- {item['ref']} | {item.get('branch') or '<unknown>'} | {','.join(item['reasons'])}\n")
    if not stash_blocked:
      f.write("- none\n")
    f.write("\n## Root Normalization\n")
    if root_normalization["candidate"]:
      item = root_normalization["candidate"]
      f.write(f"- candidate: {item['path']} | {item['from_branch']} -> {item['to_branch']}\n")
    elif root_normalization["blocked"]:
      item = root_normalization["blocked"]
      f.write(f"- blocked: {item['path']} | {item.get('branch') or '<detached>'} | {','.join(item['reasons'])}\n")
    else:
      f.write("- none\n")
PY

REQUIRE_RECEIPT_GATE_FOR_RUN="$REQUIRE_RECEIPT_GATE_PASS_DELETE"
if [[ "$REQUIRE_RECEIPT_GATE_FOR_RUN" == "true" ]]; then
  WORKTREE_DELETE_CANDIDATE_COUNT="$(python3 - "$REPORT_JSON" <<'PY'
import json
import sys
from pathlib import Path

report = json.loads(Path(sys.argv[1]).read_text())
print(len(report.get("delete_candidates", [])))
PY
)"
  if [[ "$WORKTREE_DELETE_CANDIDATE_COUNT" == "0" ]]; then
    REQUIRE_RECEIPT_GATE_FOR_RUN="false"
  fi
fi

: > "$ACTIONS_LOG"

if [[ "$MODE" == "archive-only" || "$MODE" == "delete" ]]; then
  mkdir -p "$ARCHIVE_ROOT"
  ARCHIVE_RUN_DIR="$ARCHIVE_ROOT/$RUN_ID"
  mkdir -p "$ARCHIVE_RUN_DIR"

  python3 - "$TARGET_ROOT" "$REPORT_JSON" "$ARCHIVE_RUN_DIR" "$ARCHIVE_MANIFEST" "$ACTIONS_LOG" <<'PY'
import json, subprocess, sys, tarfile
from pathlib import Path

repo = Path(sys.argv[1]).resolve()
report = json.loads(Path(sys.argv[2]).read_text())
archive_dir = Path(sys.argv[3])
manifest_path = Path(sys.argv[4])
actions_log = Path(sys.argv[5])

items = []
for row in report.get("delete_candidates", []):
    item_path = Path(row["path"])
    if not item_path.exists():
        continue
    tar_path = archive_dir / f"worktree-{item_path.name}.tgz"
    with tarfile.open(tar_path, "w:gz") as tf:
        tf.add(str(item_path), arcname=item_path.name)
    items.append({
        "kind": "worktree",
        "path": str(item_path),
        "archive": str(tar_path),
        "branch": row.get("branch"),
    })
for row in report.get("temp_clone_delete_candidates", []):
    item_path = Path(row["path"])
    if not item_path.exists():
        continue
    tar_path = archive_dir / f"temp-clone-{item_path.name}.tgz"
    with tarfile.open(tar_path, "w:gz") as tf:
        tf.add(str(item_path), arcname=item_path.name)
    items.append({
        "kind": "temp_clone",
        "path": str(item_path),
        "archive": str(tar_path),
        "branch": row.get("branch"),
    })
for row in report.get("stash_delete_candidates", []):
    ref = str(row.get("ref") or "").strip()
    commit = str(row.get("commit") or "").strip()
    if not ref or not commit:
        continue
    stash_dir = archive_dir / f"stash-{commit[:12]}"
    stash_dir.mkdir(parents=True, exist_ok=True)
    patch_path = stash_dir / "stash.patch"
    metadata_path = stash_dir / "metadata.json"
    patch = subprocess.run(["git", "-C", str(repo), "stash", "show", "-p", ref], text=True, capture_output=True)
    if patch.returncode != 0:
        with actions_log.open("a", encoding="utf-8") as f:
            f.write(f"skip_archive_stash={ref}|show_failed|{(patch.stderr or patch.stdout).strip()}\n")
        continue
    patch_path.write_text(patch.stdout, encoding="utf-8")
    metadata = {
        "kind": "stash",
        "ref": ref,
        "commit": commit,
        "branch": row.get("branch"),
        "subject": row.get("subject"),
        "message": row.get("message"),
        "age_hours": row.get("age_hours"),
        "issues": row.get("issues") or [],
        "warnings": row.get("warnings") or [],
    }
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
    items.append({
        "kind": "stash",
        "path": ref,
        "ref": ref,
        "commit": commit,
        "archive": str(stash_dir),
        "branch": row.get("branch"),
    })

manifest = {
    "archive_dir": str(archive_dir),
    "items": items,
}
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
with actions_log.open("a", encoding="utf-8") as f:
    f.write(f"archive_created={manifest_path}\n")
    for item in items:
        f.write(f"archived={item['kind']}|{item['path']}|{item['archive']}\n")
PY
fi

if [[ "$MODE" == "delete" ]]; then
  if [[ "$EXPLICIT_TOKEN" -ne 1 ]]; then
    echo "FAIL: delete mode requires explicit token ($DELETE_TOKEN_ENV=$DELETE_TOKEN_VALUE or --token)" >&2
    exit 1
  fi

  if [[ "$REQUIRE_RECEIPT_GATE_FOR_RUN" == "true" ]]; then
    if [[ ! -x "$RECEIPT_CRUMB_LOCK" ]]; then
      echo "FAIL: delete mode requires receipt crumb lock: $RECEIPT_CRUMB_LOCK" >&2
      exit 1
    fi
    "$RECEIPT_CRUMB_LOCK" --policy enforce
  fi

  if [[ "$REQUIRE_ARCHIVE" == "true" ]]; then
    if [[ -z "$MANIFEST" ]]; then
      MANIFEST="$ARCHIVE_MANIFEST"
    fi
    if [[ ! -f "$MANIFEST" ]]; then
      echo "FAIL: delete mode requires archive manifest (--manifest)" >&2
      exit 1
    fi
  fi

  python3 - "$TARGET_ROOT" "$REPORT_JSON" "$MANIFEST" "$REQUIRE_ARCHIVE" "$ACTIONS_LOG" "$REQUIRE_CLEAN_WORKTREE_DELETE" "$REQUIRE_CLEAN_TEMP_CLONE_DELETE" <<'PY'
import json, shutil, sys, subprocess
from pathlib import Path

repo = Path(sys.argv[1]).resolve()
report = json.loads(Path(sys.argv[2]).read_text())
manifest_path = Path(sys.argv[3]) if sys.argv[4].lower() == "true" else None
require_archive = sys.argv[4].lower() == "true"
actions = Path(sys.argv[5])
require_clean = sys.argv[6].lower() == "true"
require_clean_temp_clone = sys.argv[7].lower() == "true"

archived = {}
if require_archive and manifest_path and manifest_path.exists():
    m = json.loads(manifest_path.read_text())
    for item in m.get("items", []):
        if item.get("kind") == "stash":
            archived[(item.get("kind"), item.get("commit"))] = item.get("archive")
        else:
            archived[(item.get("kind"), item.get("path"))] = item.get("archive")


def current_stash_refs(repo_root: Path):
    proc = subprocess.run(
        ["git", "-C", str(repo_root), "stash", "list", "--format=%gd%x09%H"],
        text=True,
        capture_output=True,
    )
    mapping = {}
    if proc.returncode != 0:
        return mapping
    for raw in (proc.stdout or "").splitlines():
        line = raw.strip()
        if not line:
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        ref, commit = parts
        mapping[commit.strip()] = ref.strip()
    return mapping


def drop_stash_by_commit(repo_root: Path, commit: str):
    refs = current_stash_refs(repo_root)
    ref = refs.get(commit)
    if not ref:
        return None, "missing_or_shifted_ref"

    verify = subprocess.run(
        ["git", "-C", str(repo_root), "rev-parse", "--verify", ref],
        text=True,
        capture_output=True,
    )
    if verify.returncode != 0:
        return ref, f"ref_resolution_failed|{(verify.stderr or verify.stdout).strip()}"

    resolved = (verify.stdout or "").strip()
    if resolved != commit:
        return ref, "stale_or_mismatched_ref"

    drop = subprocess.run(["git", "-C", str(repo_root), "stash", "drop", ref], text=True, capture_output=True)
    if drop.returncode != 0:
        return ref, f"drop_failed|{(drop.stderr or drop.stdout).strip()}"

    return ref, None


def lease_only_dirty(path: str):
    proc = subprocess.run(
        ["git", "-C", path, "status", "--porcelain", "--untracked-files=all"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    lines = [line.strip() for line in (proc.stdout or "").splitlines() if line.strip()]
    return bool(lines) and all(line == "?? .spine-lane-lease.yaml" for line in lines)

with actions.open("a", encoding="utf-8") as log:
    for item in report.get("delete_candidates", []):
        wt = item["path"]
        br = item.get("branch") or ""
        if require_archive and ("worktree", wt) not in archived:
            log.write(f"skip={wt}|not_archived\n")
            continue

        if require_clean:
            st = subprocess.run(
                ["git", "-C", wt, "status", "--porcelain", "--untracked-files=all"],
                text=True,
                capture_output=True,
            )
            if st.returncode != 0:
                log.write(f"skip={wt}|status_check_failed|{(st.stderr or st.stdout).strip()}\n")
                continue
            if (st.stdout or "").strip():
                lease_only = lease_only_dirty(wt)
                if lease_only is None:
                    log.write(f"skip={wt}|status_check_failed|lease_only_probe_failed\n")
                    continue
                if not lease_only:
                    log.write(f"skip={wt}|dirty_worktree\n")
                    continue
                log.write(f"allow={wt}|lease_only_residue\n")

        rm = subprocess.run(["git", "-C", str(repo), "worktree", "remove", "--force", wt], text=True, capture_output=True)
        if rm.returncode != 0:
            log.write(f"skip={wt}|remove_failed|{(rm.stderr or rm.stdout).strip()}\n")
            continue
        log.write(f"deleted_worktree={wt}|{br}\n")

        if br and br != "<detached>":
            d = subprocess.run(["git", "-C", str(repo), "branch", "-d", br], text=True, capture_output=True)
            if d.returncode == 0:
                log.write(f"deleted_branch={br}\n")
        else:
            log.write(f"skip_branch={br}|branch_not_deleted\n")

    for item in report.get("temp_clone_delete_candidates", []):
        clone_path = item["path"]
        if require_archive and ("temp_clone", clone_path) not in archived:
            log.write(f"skip={clone_path}|not_archived\n")
            continue

        if require_clean_temp_clone:
            st = subprocess.run(["git", "-C", clone_path, "status", "--porcelain"], text=True, capture_output=True)
            if st.returncode != 0:
                log.write(f"skip={clone_path}|status_check_failed|{(st.stderr or st.stdout).strip()}\n")
                continue
            if (st.stdout or "").strip():
                log.write(f"skip={clone_path}|dirty_temp_clone\n")
                continue

        try:
            shutil.rmtree(clone_path)
        except Exception as exc:
            log.write(f"skip={clone_path}|remove_failed|{exc}\n")
            continue
        log.write(f"deleted_temp_clone={clone_path}|{item.get('branch') or '<detached>'}\n")

    for item in report.get("stash_delete_candidates", []):
        commit = str(item.get("commit") or "").strip()
        if not commit:
            log.write("skip_stash=<unknown>|missing_commit\n")
            continue
        if require_archive and ("stash", commit) not in archived:
            log.write(f"skip_stash={commit}|not_archived\n")
            continue
        ref, reason = drop_stash_by_commit(repo, commit)
        if reason:
            log.write(f"skip_stash={commit}|{reason}\n")
            continue
        log.write(f"deleted_stash={ref}|{commit}|{item.get('branch') or '<unknown>'}\n")

    root_action = report.get("root_normalization", {}).get("candidate")
    if root_action:
        switch = subprocess.run(
            ["git", "-C", str(repo), "switch", root_action.get("to_branch") or "main"],
            text=True,
            capture_output=True,
        )
        if switch.returncode == 0:
            log.write(
                f"normalized_root={root_action.get('path')}|{root_action.get('from_branch')}->{root_action.get('to_branch')}\n"
            )
        else:
            log.write(f"skip_root={root_action.get('path')}|{(switch.stderr or switch.stdout).strip()}\n")
PY

  POST_REPORT_JSON="$ARTIFACT_DIR/post-report.json"
  SPINE_TARGET_REPO="$TARGET_ROOT" "$RECONCILE_SCRIPT" --json > "$POST_REPORT_JSON"
fi

if [[ "$JSON_MODE" -eq 1 ]]; then
  python3 - "$MODE" "$REPORT_JSON" "${POST_REPORT_JSON:-}" "$REPORT_MD" "$ARCHIVE_MANIFEST" "$ACTIONS_LOG" <<'PY'
import json
import sys
from pathlib import Path

mode = sys.argv[1]
pre_report_path = Path(sys.argv[2])
post_report_arg = sys.argv[3]
report_md = Path(sys.argv[4])
archive_manifest = Path(sys.argv[5])
actions_log = Path(sys.argv[6])

pre_report = json.loads(pre_report_path.read_text(encoding="utf-8"))
post_report_path = Path(post_report_arg) if post_report_arg else None
payload = pre_report
if post_report_path and post_report_path.exists():
    payload = json.loads(post_report_path.read_text(encoding="utf-8"))
    payload["pre_cleanup_summary"] = pre_report.get("summary", {})

action_counts = {}
actions = []
if actions_log.exists():
    for raw in actions_log.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        key = line.split("=", 1)[0].split("|", 1)[0]
        action_counts[key] = action_counts.get(key, 0) + 1
        actions.append(line)

payload["cleanup_run"] = {
    "mode": mode,
    "pre_report_json": str(pre_report_path),
    "post_report_json": str(post_report_path) if post_report_path and post_report_path.exists() else "",
    "report_md": str(report_md),
    "archive_manifest": str(archive_manifest) if archive_manifest.exists() else "",
    "actions_log": str(actions_log),
    "action_counts": action_counts,
    "actions": actions[:200],
}
print(json.dumps(payload, indent=2))
PY
else
  echo "worktree.lifecycle.cleanup"
  echo "mode=$MODE"
  echo "artifact.report_md=$REPORT_MD"
  echo "artifact.report_json=$REPORT_JSON"
  if [[ -n "${POST_REPORT_JSON:-}" && -f "$POST_REPORT_JSON" ]]; then
    echo "artifact.post_report_json=$POST_REPORT_JSON"
  fi
  echo "artifact.archive_manifest=${ARCHIVE_MANIFEST:-none}"
  echo "artifact.actions=$ACTIONS_LOG"
fi
