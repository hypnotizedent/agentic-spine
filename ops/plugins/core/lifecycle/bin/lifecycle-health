#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
source "$ROOT/ops/plugins/core/lifecycle/lib/lifecycle-rules.sh"

JOINED_STATE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/spine-engine-joined-state"
[[ -x "$JOINED_STATE_BIN" ]] || {
  echo "FAIL: joined-state surface unavailable: $JOINED_STATE_BIN" >&2
  exit 1
}

JOINED_JSON="$(mktemp "${SPINE_TMP:-/tmp}/lifecycle-health-joined.XXXXXX.json")"
trap 'rm -f "$JOINED_JSON"' EXIT
"$JOINED_STATE_BIN" --json > "$JOINED_JSON"

echo "=== LIFECYCLE HEALTH DASHBOARD ==="
echo ""
python3 - "$JOINED_JSON" "$(health_orphan_check)" <<'PY'
import json
import sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
show_orphans = sys.argv[2].strip().lower() == "true"

summary = payload.get("summary", {})
loops = payload.get("loops", {}).get("open", [])
gaps_payload = payload.get("gaps", {}) if isinstance(payload.get("gaps"), dict) else {}
gaps = gaps_payload.get("open", []) if isinstance(gaps_payload.get("open"), list) else []
orphans = gaps_payload.get("orphaned", []) if isinstance(gaps_payload.get("orphaned"), list) else []
gap_authority_status = str(gaps_payload.get("status") or summary.get("gap_authority_status") or "ok").strip().lower()
gap_authority_message = str(gaps_payload.get("message") or "").strip()
handoffs = payload.get("handoffs", {}).get("active", [])
blocked_worktrees = payload.get("worktrees", {}).get("blocked", [])
waves = payload.get("waves", {}).get("active", [])
overrides = payload.get("override_signals", {})
verify = payload.get("verify", {}).get("latest_fast", {})
engine = payload.get("engine_coherence", {})

print("--- Joined State Surface ---")
print(f"path: {payload.get('paths', {}).get('joined_state_path', '')}")
print(f"generated: {payload.get('generated_at_utc', '')}")
print("")

print("--- Gap Summary ---")
if gap_authority_status == "ok" and summary.get("open_gaps") is not None:
    print(f"Open gaps: {summary.get('open_gaps', 0)}")
    print(f"Orphaned gaps: {summary.get('orphaned_gaps', 0)}")
    for row in gaps[:5]:
        desc = row.get("description", "")
        suffix = f" - {desc}" if desc else ""
        print(f"  {row.get('id', '')} [{row.get('severity', 'medium')}]{suffix}")
else:
    print("Open gaps: unknown (authority degraded)")
    print("Orphaned gaps: unknown")
    if gap_authority_message:
        print(f"Gap authority: degraded - {gap_authority_message}")
print("")

print("--- Open Loops ---")
for row in loops:
    next_action = row.get("next_action", "")
    suffix = f" next={next_action}" if next_action else ""
    print(f"  {row.get('loop_id', '')} [{row.get('priority', 'n/a')}] scope={row.get('scope', '')}{suffix}")
print(f"Count: {summary.get('open_loops', 0)}")
print("")

print("--- Active Handoffs ---")
for row in handoffs[:8]:
    expires = row.get("expires_at_utc", "")
    suffix = f" expires={expires}" if expires else ""
    print(f"  {row.get('id', '')} [{row.get('state', '')}]{suffix}")
print(f"Count: {summary.get('active_handoffs', 0)}")
print("")

print("--- Worktree Status ---")
print(f"Blocked: {summary.get('blocked_worktrees', 0)}")
if blocked_worktrees:
    reasons = {}
    for row in blocked_worktrees:
        for issue in row.get("issues", []):
            reasons[issue] = reasons.get(issue, 0) + 1
    for issue, count in sorted(reasons.items(), key=lambda item: (-item[1], item[0])):
        print(f"  {issue}: {count}")
print("")

print("--- Wave Status ---")
for row in waves:
    print(
        "  "
        + f"{row.get('wave_id', '')} loop={row.get('loop_id', '')} "
        + f"role={row.get('current_role', '')} dispatches={row.get('dispatch_count', 0)}"
    )
print(f"Active: {summary.get('active_waves', 0)}")
print("")

print("--- Override Signals (7d) ---")
print(f"Force-close: {summary.get('recent_force_closes', 0)}")
print(f"DoD override: {summary.get('recent_dod_overrides', 0)}")
print(f"Main override: {summary.get('recent_main_overrides', 0)}")
for row in (overrides.get("force_close", []) or [])[:3]:
    print(f"  force_close: {row.get('wave_id', '')} -> {row.get('path', '')}")
for row in (overrides.get("dod_override", []) or [])[:3]:
    print(f"  dod_override: {row.get('wave_id', '')} -> {row.get('path', '')}")
for row in (overrides.get("main_override", []) or [])[:3]:
    print(f"  main_override: {row.get('capability', '')} -> {row.get('receipt_path', '')}")
print("")

print("--- Fast Verify ---")
print(
    f"Latest fast verify: {verify.get('status', 'unknown')} "
    + f"(pass={verify.get('wrapper_pass', 0)} fail={verify.get('wrapper_fail', 0)} warn={verify.get('wrapper_warn', 0)})"
)
if verify.get("receipt_path"):
    print(f"Receipt: {verify.get('receipt_path', '')}")
print("")

print("--- Engine Coherence ---")
print(f"Needs attention: {engine.get('needs_attention', False)}")
print(f"Signal gaps: {len(engine.get('open_gap_signals', []))}")
print(f"Recent force-close: {engine.get('recent_force_close_count', 0)}")
print(f"Recent DoD override: {engine.get('recent_dod_override_count', 0)}")
print("")

if show_orphans:
    print("--- Orphan Check ---")
    if gap_authority_status != "ok":
        print("  Unknown (gap authority degraded)")
    elif orphans:
        for row in orphans:
            print(
                f"  {row.get('id', '')} parent={row.get('parent_loop', '')} "
                + f"status={row.get('parent_loop_status', '')}"
            )
    else:
        print("  None")
    print("")
PY

if [[ "$(health_aging_advisory)" == "true" ]]; then
  echo "--- Aging Advisory ---"
  "$ROOT/ops/plugins/core/lifecycle/bin/gaps-aging" 2>/dev/null || echo "  (aging check unavailable)"
  echo ""
fi
