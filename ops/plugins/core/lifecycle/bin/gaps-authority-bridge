#!/usr/bin/env python3
"""CLI bridge for gaps SQLite authority operations.

Shell scripts (gaps-file, gaps-close, gaps-reparent) call this instead of
mutating operational.gaps.yaml directly with yq. This script:
  1. Performs the SQLite mutation (upsert/close/reparent)
  2. Returns status to the calling shell script

YAML projection is NOT triggered on mutation. Refresh on demand:
  gaps-authority-bridge project

This bridge governs capability-mediated mutation only. Raw file writes to
externalized runtime state files remain outside its enforcement envelope and
must be handled by the separate read-only / write-scope controls.

Usage:
  gaps-authority-bridge upsert --json '{"id":"GAP-OP-1234",...}'
  gaps-authority-bridge close --id GAP-OP-1234 --status fixed [--fixed-in ref] [--completion-level slice_complete]
  gaps-authority-bridge reparent --id GAP-OP-1234 --parent-loop LOOP-NEW
  gaps-authority-bridge bootstrap
  gaps-authority-bridge project
  gaps-authority-bridge next-id
  gaps-authority-bridge parity
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

# Resolve lib path relative to this script.
SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import gaps_sql_authority as gsa

# ── Mutation ceremony ────────────────────────────────────────────
# Write operations require governed execution (SPINE_CAP_RUN_KEY set by cap.sh).
# Read operations are always allowed.

MUTATING_COMMANDS = frozenset({"upsert", "close", "reparent"})
READ_COMMANDS = frozenset({"query", "bootstrap", "project", "next-id", "parity"})
CONTROL_TERMINAL_ROLE = "SPINE-CONTROL-01"


def check_mutation_ceremony(command: str, args: argparse.Namespace) -> tuple[str | None, str]:
    """Verify mutation ceremony for write operations.

    Returns (run_key, mutation_source) on success.
    Prints error and calls sys.exit(1) if blocked.
    """
    if command not in MUTATING_COMMANDS:
        return None, "read"

    run_key = os.environ.get("SPINE_CAP_RUN_KEY", "").strip()
    ungoverned = getattr(args, "ungoverned_override", False)
    override_reason = getattr(args, "reason", None) or ""

    if run_key:
        print(
            f"mutation-ceremony: governed (run_key={run_key})",
            file=sys.stderr,
        )
        mutation_source = "governed"
    elif ungoverned and override_reason.strip():
        print(
            f"mutation-ceremony: override (reason={override_reason.strip()})",
            file=sys.stderr,
        )
        print(
            "WARNING: ungoverned mutation — no SPINE_CAP_RUN_KEY audit trail",
            file=sys.stderr,
        )
        mutation_source = "override"
    else:
        print(
            "MUTATION BLOCKED: gaps-authority-bridge requires governed execution "
            "(SPINE_CAP_RUN_KEY not set). "
            "Run through: ./bin/ops cap run gaps.file|gaps.close",
            file=sys.stderr,
        )
        if ungoverned and not override_reason.strip():
            print(
                "  --ungoverned-override requires --reason",
                file=sys.stderr,
            )
        sys.exit(1)

    terminal_role = (
        os.environ.get("OPS_TERMINAL_ROLE", "").strip()
        or os.environ.get("SPINE_TERMINAL_ROLE", "").strip()
    )
    if terminal_role != CONTROL_TERMINAL_ROLE:
        print(
            "MUTATION BLOCKED: gaps-authority-bridge requires controller terminal "
            f"role {CONTROL_TERMINAL_ROLE} for mutating commands "
            f"(got {terminal_role or 'unset'})",
            file=sys.stderr,
        )
        sys.exit(1)

    return run_key or None, mutation_source


def resolve_root() -> Path:
    # Anchor to the checkout this bridge was launched from instead of trusting
    # ambient SPINE_ROOT/SPINE_CODE, which may still point at a stale worktree.
    candidate = SCRIPT_DIR
    for _ in range(10):
        if (candidate / "ops" / "bindings" / "operational.gaps.yaml").exists():
            return candidate
        candidate = candidate.parent
    raise RuntimeError("Cannot resolve SPINE_ROOT")


def cmd_upsert(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("upsert", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = json.loads(args.json)
    gap_id = gap.get("id", "")

    old = gsa.get_gap(conn, gap_id)
    gsa.upsert_gap(conn, gap)
    gsa.insert_event(
        conn,
        gap_id=gap_id,
        event_type="upsert",
        from_status=old["status"] if old else None,
        to_status=gap.get("status", "open"),
        reason="Filed via gaps-authority-bridge upsert",
        actor=args.actor or "gaps.file",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "gap_id": gap_id}), file=sys.stdout)
    print("YAML projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_close(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("close", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    # Validate completion level if provided.
    if args.completion_level:
        ok, msg = gsa.validate_completion_level(args.completion_level)
        if not ok:
            print(json.dumps({"ok": False, "error": msg}))
            sys.exit(1)

    gap = gsa.close_gap(
        conn,
        args.id,
        status=args.status,
        fixed_in=args.fixed_in,
        completion_level=args.completion_level,
        actor=args.actor or "gaps.close",
        reason=args.reason,
        run_key=run_key,
        mutation_source=mutation_source,
    )
    if gap is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    # Apply notes if provided.
    if args.notes:
        gap["notes"] = args.notes
        gsa.upsert_gap(conn, gap)

    # Apply regression_lock_id if provided.
    if args.regression_lock_id:
        gap["regression_lock_id"] = args.regression_lock_id
        gsa.upsert_gap(conn, gap)

    if args.evidence:
        gap["evidence"] = args.evidence
        gsa.upsert_gap(conn, gap)
    if args.owner:
        gap["owner"] = args.owner
        gsa.upsert_gap(conn, gap)
    if args.expiry_check:
        gap["expiry_check"] = args.expiry_check
        gsa.upsert_gap(conn, gap)
    if args.root_cause:
        gap["root_cause"] = args.root_cause
        gsa.upsert_gap(conn, gap)

    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "gap_id": args.id, "status": args.status}), file=sys.stdout)
    print("YAML projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_reparent(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("reparent", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = gsa.get_gap(conn, args.id)
    if gap is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    old_parent = gap.get("parent_loop")
    gap["parent_loop"] = args.parent_loop
    gsa.upsert_gap(conn, gap)
    gsa.insert_event(
        conn,
        gap_id=args.id,
        event_type="reparent",
        from_status=None,
        to_status=None,
        reason=f"Reparented from {old_parent} to {args.parent_loop}",
        actor=args.actor or "gaps.reparent",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "gap_id": args.id, "old_parent": old_parent, "new_parent": args.parent_loop}), file=sys.stdout)
    print("YAML projection skipped (on-demand only via 'project' subcommand)", file=sys.stderr)


def cmd_bootstrap(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    imported = gsa.bootstrap_from_yaml(conn, gaps_yaml)
    total = gsa.gap_count(conn)
    ok, msg = gsa.integrity_check(conn)
    conn.close()
    print(json.dumps({"ok": ok, "imported": imported, "total": total, "integrity": msg}))


def cmd_project(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    result = gsa.project_to_yaml(conn, gaps_yaml)
    conn.close()
    print(json.dumps({"ok": True, "projection": result}))


def cmd_next_id(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    nid = gsa.next_gap_id(conn)
    conn.close()
    print(nid)


def cmd_parity(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    snapshot = gsa.db_parity_snapshot(conn, gaps_yaml)
    conn.close()
    print(json.dumps(snapshot, indent=2))


def cmd_query(args: argparse.Namespace) -> None:
    """Query a single gap from SQLite authority. Returns JSON with exists/status/severity."""
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = gsa.get_gap(conn, args.id)
    conn.close()

    if gap is None:
        print(json.dumps({"exists": False, "gap_id": args.id}))
    else:
        print(json.dumps({
            "exists": True,
            "gap_id": gap.get("id", args.id),
            "status": gap.get("status", ""),
            "severity": gap.get("severity", ""),
            "regression_lock_id": gap.get("regression_lock_id", ""),
            "parent_loop": gap.get("parent_loop", ""),
        }))


def main() -> None:
    parser = argparse.ArgumentParser(description="Gaps SQLite authority bridge")
    sub = parser.add_subparsers(dest="command", required=True)

    # -- Shared override flags for mutating subcommands --
    def add_mutation_override_flags(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--ungoverned-override",
            action="store_true",
            default=False,
            help="Allow mutation without SPINE_CAP_RUN_KEY (emergency/bootstrap). Requires --reason.",
        )

    p_upsert = sub.add_parser("upsert")
    p_upsert.add_argument("--json", required=True)
    p_upsert.add_argument("--actor", default="")
    p_upsert.add_argument("--reason", default=None)
    add_mutation_override_flags(p_upsert)

    p_close = sub.add_parser("close")
    p_close.add_argument("--id", required=True)
    p_close.add_argument("--status", required=True)
    p_close.add_argument("--fixed-in", default=None)
    p_close.add_argument("--notes", default=None)
    p_close.add_argument("--regression-lock-id", default=None)
    p_close.add_argument("--completion-level", default=None)
    p_close.add_argument("--evidence", default=None)
    p_close.add_argument("--owner", default=None)
    p_close.add_argument("--expiry-check", default=None)
    p_close.add_argument("--root-cause", default=None)
    p_close.add_argument("--reason", default=None)
    p_close.add_argument("--actor", default="")
    add_mutation_override_flags(p_close)

    p_reparent = sub.add_parser("reparent")
    p_reparent.add_argument("--id", required=True)
    p_reparent.add_argument("--parent-loop", required=True)
    p_reparent.add_argument("--actor", default="")
    p_reparent.add_argument("--reason", default=None)
    add_mutation_override_flags(p_reparent)

    p_query = sub.add_parser("query")
    p_query.add_argument("--id", required=True)

    sub.add_parser("bootstrap")
    sub.add_parser("project")
    sub.add_parser("next-id")
    sub.add_parser("parity")

    args = parser.parse_args()
    cmd_map = {
        "upsert": cmd_upsert,
        "close": cmd_close,
        "reparent": cmd_reparent,
        "query": cmd_query,
        "bootstrap": cmd_bootstrap,
        "project": cmd_project,
        "next-id": cmd_next_id,
        "parity": cmd_parity,
    }
    cmd_map[args.command](args)


if __name__ == "__main__":
    main()
