#!/usr/bin/env python3
"""Thin SQLite authority bridge for gap lifecycle operations.

This restores the governed gap mutation surface expected by closeout callers.
Mutations write to SQLite authority first and project the YAML surface after.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import gaps_sql_authority as gsa

MUTATING = frozenset({"upsert", "close", "reparent", "sync"})


def resolve_root() -> Path:
    candidate = SCRIPT_DIR
    for _ in range(10):
        if (candidate / "bin" / "ops").exists() and (candidate / "ops" / "bindings" / "gate.registry.yaml").exists():
            return candidate
        candidate = candidate.parent
    raise RuntimeError("Cannot resolve SPINE_ROOT")


def mutation_context(command: str, args: argparse.Namespace) -> tuple[str | None, str]:
    if command not in MUTATING:
        return None, "read"

    run_key = os.environ.get("SPINE_CAP_RUN_KEY", "").strip() or None
    if run_key:
        return run_key, "governed"
    if getattr(args, "ungoverned_override", False) and (getattr(args, "reason", "") or "").strip():
        return None, "override"

    print(
        "MUTATION BLOCKED: governed gap mutation requires SPINE_CAP_RUN_KEY "
        "or --ungoverned-override with --reason",
        file=sys.stderr,
    )
    sys.exit(1)


def open_authority():
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    return root, conn, gaps_yaml


def project(conn, gaps_yaml: Path, *, no_archive: bool = False, archive_path: str | None = None) -> dict:
    archive = Path(archive_path).expanduser() if archive_path else None
    return gsa.project_to_yaml(
        conn,
        gaps_yaml,
        archive_closed=not no_archive,
        archive_path=archive,
    )


def cmd_upsert(args: argparse.Namespace) -> None:
    run_key, mutation_source = mutation_context("upsert", args)
    _, conn, gaps_yaml = open_authority()
    try:
        gap = json.loads(args.json)
        gap_id = str(gap.get("id", "")).strip()
        if not gap_id:
            raise RuntimeError("gap id required")
        prior = gsa.get_gap(conn, gap_id)
        gsa.upsert_gap(conn, gap)
        gsa.insert_event(
            conn,
            gap_id=gap_id,
            event_type="upsert",
            from_status=prior.get("status") if prior else None,
            to_status=str(gap.get("status") or "open"),
            reason=args.reason or "Filed via gaps-authority-bridge upsert",
            actor=args.actor or "gaps.file",
            run_key=run_key,
            mutation_source=mutation_source,
        )
        conn.commit()
        projection = project(conn, gaps_yaml)
        print(json.dumps({"ok": True, "gap_id": gap_id, "projection": projection}))
    finally:
        conn.close()


def cmd_close(args: argparse.Namespace) -> None:
    run_key, mutation_source = mutation_context("close", args)
    _, conn, gaps_yaml = open_authority()
    try:
        ok, msg = gsa.validate_completion_level(args.completion_level)
        if not ok:
            raise RuntimeError(msg)
        gap = gsa.close_gap(
            conn,
            args.id,
            status=args.status,
            fixed_in=args.fixed_in,
            completion_level=args.completion_level,
            actor=args.actor or "gaps.close",
            reason=args.reason,
            run_key=run_key,
            mutation_source=mutation_source,
        )
        if gap is None:
            raise RuntimeError(f"{args.id} not found")
        for field, value in (
            ("notes", args.notes),
            ("regression_lock_id", args.regression_lock_id),
            ("evidence", args.evidence),
            ("owner", args.owner),
            ("expiry_check", args.expiry_check),
            ("root_cause", args.root_cause),
        ):
            if value:
                gap[field] = value
        gsa.upsert_gap(conn, gap)
        conn.commit()
        payload = {"ok": True, "gap_id": args.id, "status": args.status}
        if args.defer_sync:
            payload["sync"] = "deferred"
        else:
            payload["projection"] = project(conn, gaps_yaml)
        print(json.dumps(payload))
    finally:
        conn.close()


def cmd_reparent(args: argparse.Namespace) -> None:
    run_key, mutation_source = mutation_context("reparent", args)
    _, conn, gaps_yaml = open_authority()
    try:
        gap = gsa.get_gap(conn, args.id)
        if gap is None:
            raise RuntimeError(f"{args.id} not found")
        old_parent = gap.get("parent_loop")
        gap["parent_loop"] = args.parent_loop
        gsa.upsert_gap(conn, gap)
        gsa.insert_event(
            conn,
            gap_id=args.id,
            event_type="reparent",
            reason=args.reason or f"Reparented from {old_parent} to {args.parent_loop}",
            actor=args.actor or "gaps.reparent",
            run_key=run_key,
            mutation_source=mutation_source,
        )
        conn.commit()
        projection = project(conn, gaps_yaml)
        print(json.dumps({"ok": True, "gap_id": args.id, "old_parent": old_parent, "new_parent": args.parent_loop, "projection": projection}))
    finally:
        conn.close()


def cmd_bootstrap(_: argparse.Namespace) -> None:
    _, conn, _ = open_authority()
    try:
        ok, msg = gsa.integrity_check(conn)
        print(json.dumps({"ok": ok, "total": gsa.gap_count(conn), "integrity": msg}))
    finally:
        conn.close()


def cmd_project(args: argparse.Namespace) -> None:
    _, conn, gaps_yaml = open_authority()
    try:
        print(json.dumps({"ok": True, "projection": project(conn, gaps_yaml, no_archive=args.no_archive, archive_path=args.archive_path)}))
    finally:
        conn.close()


def cmd_sync(args: argparse.Namespace) -> None:
    mutation_context("sync", args)
    _, conn, gaps_yaml = open_authority()
    try:
        print(json.dumps({"ok": True, "context": args.context, "projection": project(conn, gaps_yaml)}))
    finally:
        conn.close()


def cmd_next_id(_: argparse.Namespace) -> None:
    _, conn, _ = open_authority()
    try:
        print(gsa.next_gap_id(conn))
    finally:
        conn.close()


def cmd_parity(_: argparse.Namespace) -> None:
    _, conn, gaps_yaml = open_authority()
    try:
        print(json.dumps(gsa.db_parity_snapshot(conn, gaps_yaml), indent=2))
    finally:
        conn.close()


def cmd_query(args: argparse.Namespace) -> None:
    _, conn, _ = open_authority()
    try:
        gap = gsa.get_gap(conn, args.id)
        if gap is None:
            print(json.dumps({"exists": False, "gap_id": args.id}))
        else:
            print(json.dumps({"exists": True, "gap_id": gap.get("id", args.id), "status": gap.get("status", ""), "severity": gap.get("severity", ""), "parent_loop": gap.get("parent_loop", "")}))
    finally:
        conn.close()


def add_override_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--reason", default=None)
    parser.add_argument("--ungoverned-override", action="store_true", default=False)


def main() -> None:
    parser = argparse.ArgumentParser(description="Gaps SQLite authority bridge")
    sub = parser.add_subparsers(dest="command", required=True)

    p_upsert = sub.add_parser("upsert")
    p_upsert.add_argument("--json", required=True)
    p_upsert.add_argument("--actor", default="")
    add_override_flags(p_upsert)

    p_close = sub.add_parser("close")
    p_close.add_argument("--id", required=True)
    p_close.add_argument("--status", required=True)
    p_close.add_argument("--fixed-in", default=None)
    p_close.add_argument("--notes", default=None)
    p_close.add_argument("--regression-lock-id", default=None)
    p_close.add_argument("--completion-level", default=None)
    p_close.add_argument("--evidence", default=None)
    p_close.add_argument("--owner", default=None)
    p_close.add_argument("--expiry-check", default=None)
    p_close.add_argument("--root-cause", default=None)
    p_close.add_argument("--actor", default="")
    p_close.add_argument("--defer-sync", action="store_true", default=False)
    add_override_flags(p_close)

    p_reparent = sub.add_parser("reparent")
    p_reparent.add_argument("--id", required=True)
    p_reparent.add_argument("--parent-loop", required=True)
    p_reparent.add_argument("--actor", default="")
    add_override_flags(p_reparent)

    p_query = sub.add_parser("query")
    p_query.add_argument("--id", required=True)

    sub.add_parser("bootstrap")

    p_project = sub.add_parser("project")
    p_project.add_argument("--no-archive", action="store_true", default=False)
    p_project.add_argument("--archive-path", default=None)

    p_sync = sub.add_parser("sync")
    p_sync.add_argument("--context", default="gaps.authority.sync")
    add_override_flags(p_sync)

    sub.add_parser("next-id")
    sub.add_parser("parity")

    commands = {
        "upsert": cmd_upsert,
        "close": cmd_close,
        "reparent": cmd_reparent,
        "bootstrap": cmd_bootstrap,
        "project": cmd_project,
        "sync": cmd_sync,
        "next-id": cmd_next_id,
        "parity": cmd_parity,
        "query": cmd_query,
    }
    args = parser.parse_args()
    commands[args.command](args)


if __name__ == "__main__":
    main()
