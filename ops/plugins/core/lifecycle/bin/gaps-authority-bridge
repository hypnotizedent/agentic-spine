#!/usr/bin/env python3
"""CLI bridge for gaps SQLite authority operations.

Shell scripts (gaps-file, gaps-close, gaps-reparent) call this instead of
mutating operational.gaps.yaml directly with yq. This script:
  1. Performs the SQLite mutation (upsert/close/reparent)
  2. Projects runtime state when required by the mutation path
  3. Returns structured status to the calling shell script

Close now auto-syncs the live lifecycle surfaces by default:
  SQLite authority -> operational.gaps.yaml -> joined-state runtime surface

When sync cannot complete, the command exits nonzero with a structured
partial-state payload instead of silently drifting.

This bridge governs capability-mediated mutation only. Raw file writes to
externalized runtime state files remain outside its enforcement envelope and
must be handled by the separate read-only / write-scope controls.

Usage:
  gaps-authority-bridge upsert --json '{"id":"GAP-OP-1234",...}'
  gaps-authority-bridge close --id GAP-OP-1234 --status fixed [--fixed-in ref] [--completion-level slice_complete]
  gaps-authority-bridge reparent --id GAP-OP-1234 --parent-loop LOOP-NEW
  gaps-authority-bridge bootstrap
  gaps-authority-bridge project
  gaps-authority-bridge sync [--context gaps.close.batch] [--expect-closed GAP-OP-1234 ...]
  gaps-authority-bridge next-id
  gaps-authority-bridge parity
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
import yaml

# Resolve lib path relative to this script.
SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

import gaps_sql_authority as gsa
import posture_guard

# ── Mutation ceremony ────────────────────────────────────────────
# Write operations require governed execution (SPINE_CAP_RUN_KEY set by cap.sh).
# Read operations are always allowed.

MUTATING_COMMANDS = frozenset({"upsert", "close", "reparent", "sync"})
READ_COMMANDS = frozenset({"query", "bootstrap", "project", "next-id", "parity"})
CONTROL_TERMINAL_ROLE = "SPINE-CONTROL-01"
PARTIAL_EXIT_CODE = 3


def resolve_controller_terminal_role() -> str:
    contract_path = resolve_root() / "ops" / "bindings" / "terminal.role.contract.yaml"
    if contract_path.exists():
        try:
            contract = yaml.safe_load(contract_path.read_text(encoding="utf-8")) or {}
            roles = contract.get("roles") or []
            for entry in roles:
                if not isinstance(entry, dict):
                    continue
                if str(entry.get("id", "")).strip() == CONTROL_TERMINAL_ROLE:
                    return CONTROL_TERMINAL_ROLE
            control_roles = [
                entry for entry in roles
                if isinstance(entry, dict) and str(entry.get("type", "")).strip() == "control-plane"
            ]
            control_roles.sort(key=lambda item: int(item.get("sort_order", 999999)))
            if control_roles:
                fallback_id = str(control_roles[0].get("id", "")).strip()
                if fallback_id:
                    return fallback_id
        except Exception:
            pass
    return CONTROL_TERMINAL_ROLE


def check_mutation_ceremony(command: str, args: argparse.Namespace) -> tuple[str | None, str]:
    """Verify mutation ceremony for write operations.

    Returns (run_key, mutation_source) on success.
    Prints error and calls sys.exit(1) if blocked.
    """
    if command not in MUTATING_COMMANDS:
        return None, "read"

    run_key = os.environ.get("SPINE_CAP_RUN_KEY", "").strip()
    ungoverned = getattr(args, "ungoverned_override", False)
    override_reason = getattr(args, "reason", None) or ""

    if run_key:
        print(
            f"mutation-ceremony: governed (run_key={run_key})",
            file=sys.stderr,
        )
        mutation_source = "governed"
    elif ungoverned and override_reason.strip():
        print(
            f"mutation-ceremony: override (reason={override_reason.strip()})",
            file=sys.stderr,
        )
        print(
            "WARNING: ungoverned mutation — no SPINE_CAP_RUN_KEY audit trail",
            file=sys.stderr,
        )
        mutation_source = "override"
    else:
        print(
            "MUTATION BLOCKED: gaps-authority-bridge requires governed execution "
            "(SPINE_CAP_RUN_KEY not set). "
            "Run through: ./bin/ops cap run gaps.file|gaps.close",
            file=sys.stderr,
        )
        if ungoverned and not override_reason.strip():
            print(
                "  --ungoverned-override requires --reason",
                file=sys.stderr,
            )
        sys.exit(1)

    terminal_role = (
        os.environ.get("OPS_TERMINAL_ROLE", "").strip()
        or os.environ.get("SPINE_TERMINAL_ROLE", "").strip()
    )
    controller_role = resolve_controller_terminal_role()
    if not terminal_role and run_key:
        terminal_role = controller_role
        print(
            f"mutation-ceremony: terminal-role fallback ({terminal_role})",
            file=sys.stderr,
        )
    if terminal_role != controller_role:
        print(
            "MUTATION BLOCKED: gaps-authority-bridge requires controller terminal "
            f"role {controller_role} for mutating commands "
            f"(got {terminal_role or 'unset'})",
            file=sys.stderr,
        )
        sys.exit(1)

    return run_key or None, mutation_source


def resolve_root() -> Path:
    # Anchor to the checkout this bridge was launched from instead of trusting
    # ambient SPINE_ROOT/SPINE_CODE, which may still point at a stale worktree.
    candidate = SCRIPT_DIR
    for _ in range(10):
        if (candidate / "ops" / "bindings" / "operational.gaps.yaml").exists():
            return candidate
        candidate = candidate.parent
    raise RuntimeError("Cannot resolve SPINE_ROOT")


def resolve_joined_state_path(root: Path) -> Path:
    state_root = Path(
        os.environ.get("SPINE_STATE")
        or str(root.parent / ".runtime" / "spine" / "state")
    )
    return Path(
        os.environ.get("SPINE_ENGINE_JOINED_STATE_PATH")
        or str(state_root / "domain-state" / "spine" / "SPINE_ENGINE_JOINED_STATE.yaml")
    )


def passive_friction_enabled() -> bool:
    disabled = os.environ.get("OPS_PASSIVE_FRICTION_DISABLED", "").strip().lower()
    return disabled not in {"1", "true", "yes", "on"} and not os.environ.get("OPS_TEST_MODE") and not os.environ.get("CI")


def auto_file_passive_friction(
    root: Path,
    *,
    capability: str,
    expected: str,
    actual: str,
    severity: str = "medium",
) -> None:
    if not passive_friction_enabled():
        return
    friction_ingest = root / "ops" / "plugins" / "core" / "lifecycle" / "bin" / "friction-ingest"
    if not friction_ingest.exists():
        return
    try:
        subprocess.Popen(
            [
                str(friction_ingest),
                "--capability",
                capability,
                "--expected",
                expected,
                "--actual",
                actual,
                "--severity",
                severity,
                "--source",
                "passive_capture",
                "--auto-reconcile",
                "--json",
            ],
            cwd=str(root),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        return


def projection_deferred_notice(root: Path, *, command: str) -> str:
    next_step = "./bin/ops cap run state.shared.reconcile -- --fix && ./bin/ops cap run lifecycle.health"
    actual = (
        f"{command} updated SQLite authority but deferred YAML/joined-state sync; "
        f"operator must run {next_step}"
    )
    auto_file_passive_friction(
        root,
        capability="gaps.authority.projection.deferred",
        expected="shared-authority mutations should either sync lifecycle surfaces immediately or expose an explicit governed remedy",
        actual=actual,
        severity="low",
    )
    return next_step


def refresh_joined_state(root: Path, gaps_yaml: Path) -> tuple[bool, dict[str, Any] | None, str]:
    script = root / "ops" / "plugins" / "core" / "lifecycle" / "bin" / "spine-engine-joined-state"
    env = os.environ.copy()
    env["SPINE_GAPS_FILE"] = str(gaps_yaml)
    proc = subprocess.run(
        [str(script), "--json"],
        cwd=str(root),
        text=True,
        capture_output=True,
        check=False,
        env=env,
    )
    text = proc.stdout.strip() or proc.stderr.strip()
    if proc.returncode != 0:
        return False, None, text or f"joined-state refresh failed with rc={proc.returncode}"
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        return False, None, f"joined-state refresh returned invalid json: {exc}"
    return True, payload, ""


def partial_sync_payload(
    *,
    context: str,
    stage: str,
    reason: str,
    next_step: str,
    expected_closed_gap_ids: list[str],
    gaps_yaml: Path,
    joined_state_path: Path,
    projection: dict[str, Any] | None = None,
    joined_state_payload: dict[str, Any] | None = None,
    contradicting_gap_ids: list[str] | None = None,
) -> dict[str, Any]:
    joined_summary = {}
    if isinstance(joined_state_payload, dict):
        joined_summary = joined_state_payload.get("summary", {}) if isinstance(joined_state_payload.get("summary"), dict) else {}
    return {
        "ok": False,
        "status": "partial",
        "partial_state": {
            "marker": "gap_sync_partial",
            "context": context,
            "stage": stage,
            "reason": reason,
            "next_step": next_step,
            "expected_closed_gap_ids": expected_closed_gap_ids,
            "contradicting_gap_ids": contradicting_gap_ids or [],
            "authority_committed": True,
            "projection_completed": projection is not None,
            "joined_state_refreshed": joined_state_payload is not None,
        },
        "sync": {
            "status": "partial",
            "context": context,
            "gaps_yaml_path": str(gaps_yaml),
            "joined_state_path": str(joined_state_path),
            "projection": projection or {},
            "joined_state_summary": joined_summary,
        },
    }


def sync_gap_runtime(
    conn,
    *,
    root: Path,
    gaps_yaml: Path,
    context: str,
    expected_closed_gap_ids: list[str],
) -> dict[str, Any]:
    joined_state_path = resolve_joined_state_path(root)
    try:
        projection = gsa.project_to_yaml(conn, gaps_yaml)
    except Exception as exc:
        next_step = "./bin/ops cap run state.shared.reconcile -- --fix && ./bin/ops cap run lifecycle.health"
        reason = f"gap projection failed: {exc}"
        auto_file_passive_friction(
            root,
            capability="gaps.close.partial_state",
            expected="gap close should complete authority, projection, and joined-state refresh in one governed command",
            actual=reason,
            severity="medium",
        )
        return partial_sync_payload(
            context=context,
            stage="projection",
            reason=reason,
            next_step=next_step,
            expected_closed_gap_ids=expected_closed_gap_ids,
            gaps_yaml=gaps_yaml,
            joined_state_path=joined_state_path,
        )

    joined_ok, joined_payload, joined_reason = refresh_joined_state(root, gaps_yaml)
    if not joined_ok:
        next_step = "./bin/ops cap run lifecycle.health"
        reason = f"joined-state refresh failed: {joined_reason}"
        auto_file_passive_friction(
            root,
            capability="gaps.close.partial_state",
            expected="gap close should complete authority, projection, and joined-state refresh in one governed command",
            actual=reason,
            severity="medium",
        )
        return partial_sync_payload(
            context=context,
            stage="joined_state_refresh",
            reason=reason,
            next_step=next_step,
            expected_closed_gap_ids=expected_closed_gap_ids,
            gaps_yaml=gaps_yaml,
            joined_state_path=joined_state_path,
            projection=projection,
        )

    open_rows = joined_payload.get("gaps", {}).get("open", []) if isinstance(joined_payload.get("gaps"), dict) else []
    open_gap_ids = {
        str(row.get("id") or "").strip()
        for row in open_rows
        if isinstance(row, dict) and str(row.get("id") or "").strip()
    }
    contradicting_gap_ids = sorted(set(expected_closed_gap_ids) & open_gap_ids)
    if contradicting_gap_ids:
        next_step = "./bin/ops cap run lifecycle.health"
        reason = (
            "joined-state still reports recently closed gap(s) as open: "
            + ", ".join(contradicting_gap_ids)
        )
        auto_file_passive_friction(
            root,
            capability="gaps.close.partial_state",
            expected="gap close should complete authority, projection, and joined-state refresh in one governed command",
            actual=reason,
            severity="medium",
        )
        auto_file_passive_friction(
            root,
            capability="gaps.close.staleness",
            expected="lifecycle queries should reflect recent gap mutations within the same command window",
            actual=reason,
            severity="low",
        )
        return partial_sync_payload(
            context=context,
            stage="joined_state_contradiction",
            reason=reason,
            next_step=next_step,
            expected_closed_gap_ids=expected_closed_gap_ids,
            gaps_yaml=gaps_yaml,
            joined_state_path=joined_state_path,
            projection=projection,
            joined_state_payload=joined_payload,
            contradicting_gap_ids=contradicting_gap_ids,
        )

    return {
        "ok": True,
        "status": "ok",
        "sync": {
            "status": "ok",
            "context": context,
            "gaps_yaml_path": str(gaps_yaml),
            "joined_state_path": str(joined_state_path),
            "projection": projection,
            "joined_state_summary": joined_payload.get("summary", {}) if isinstance(joined_payload.get("summary"), dict) else {},
        },
    }


def cmd_upsert(args: argparse.Namespace) -> None:
    posture_guard.check_posture_guard("upsert", bridge_name="gaps-authority-bridge")
    run_key, mutation_source = check_mutation_ceremony("upsert", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = json.loads(args.json)
    gap_id = gap.get("id", "")

    old = gsa.get_gap(conn, gap_id)
    gsa.upsert_gap(conn, gap)
    gsa.insert_event(
        conn,
        gap_id=gap_id,
        event_type="upsert",
        from_status=old["status"] if old else None,
        to_status=gap.get("status", "open"),
        reason="Filed via gaps-authority-bridge upsert",
        actor=args.actor or "gaps.file",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "gap_id": gap_id}), file=sys.stdout)
    next_step = projection_deferred_notice(root, command="gaps-authority-bridge upsert")
    print(
        "YAML projection deferred (SQLite authority updated only). "
        f"Next step: {next_step}",
        file=sys.stderr,
    )


def cmd_close(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("close", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    # Validate completion level if provided.
    if args.completion_level:
        ok, msg = gsa.validate_completion_level(args.completion_level)
        if not ok:
            print(json.dumps({"ok": False, "error": msg}))
            sys.exit(1)

    gap = gsa.close_gap(
        conn,
        args.id,
        status=args.status,
        fixed_in=args.fixed_in,
        completion_level=args.completion_level,
        actor=args.actor or "gaps.close",
        reason=args.reason,
        run_key=run_key,
        mutation_source=mutation_source,
    )
    if gap is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    # Apply notes if provided.
    if args.notes:
        gap["notes"] = args.notes
        gsa.upsert_gap(conn, gap)

    # Apply regression_lock_id if provided.
    if args.regression_lock_id:
        gap["regression_lock_id"] = args.regression_lock_id
        gsa.upsert_gap(conn, gap)

    if args.evidence:
        gap["evidence"] = args.evidence
        gsa.upsert_gap(conn, gap)
    if args.owner:
        gap["owner"] = args.owner
        gsa.upsert_gap(conn, gap)
    if args.expiry_check:
        gap["expiry_check"] = args.expiry_check
        gsa.upsert_gap(conn, gap)
    if args.root_cause:
        gap["root_cause"] = args.root_cause
        gsa.upsert_gap(conn, gap)

    conn.commit()

    if getattr(args, "defer_sync", False):
        next_step = projection_deferred_notice(root, command="gaps-authority-bridge close --defer-sync")
        conn.close()
        print(
            json.dumps(
                {
                    "ok": True,
                    "gap_id": args.id,
                    "status": args.status,
                    "sync": {
                        "status": "deferred",
                        "context": "gaps.authority.close",
                        "next_step": next_step,
                    },
                }
            ),
            file=sys.stdout,
        )
        print(
            "YAML/joined-state sync deferred by request. "
            f"Next step: {next_step}",
            file=sys.stderr,
        )
        return

    sync_result = sync_gap_runtime(
        conn,
        root=root,
        gaps_yaml=gaps_yaml,
        context="gaps.authority.close",
        expected_closed_gap_ids=[args.id],
    )
    conn.close()
    if not sync_result.get("ok"):
        payload = {
            "ok": False,
            "gap_id": args.id,
            "gap_status": args.status,
            **sync_result,
        }
        print(json.dumps(payload), file=sys.stdout)
        sys.exit(PARTIAL_EXIT_CODE)

    print(
        json.dumps(
            {
                "ok": True,
                "gap_id": args.id,
                "status": args.status,
                "sync": sync_result.get("sync", {}),
            }
        ),
        file=sys.stdout,
    )


def cmd_reparent(args: argparse.Namespace) -> None:
    run_key, mutation_source = check_mutation_ceremony("reparent", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = gsa.get_gap(conn, args.id)
    if gap is None:
        print(json.dumps({"ok": False, "error": f"{args.id} not found"}))
        sys.exit(1)

    old_parent = gap.get("parent_loop")
    gap["parent_loop"] = args.parent_loop
    gsa.upsert_gap(conn, gap)
    gsa.insert_event(
        conn,
        gap_id=args.id,
        event_type="reparent",
        from_status=None,
        to_status=None,
        reason=f"Reparented from {old_parent} to {args.parent_loop}",
        actor=args.actor or "gaps.reparent",
        run_key=run_key,
        mutation_source=mutation_source,
    )
    conn.commit()
    conn.close()
    print(json.dumps({"ok": True, "gap_id": args.id, "old_parent": old_parent, "new_parent": args.parent_loop}), file=sys.stdout)
    next_step = projection_deferred_notice(root, command="gaps-authority-bridge reparent")
    print(
        "YAML projection deferred (SQLite authority updated only). "
        f"Next step: {next_step}",
        file=sys.stderr,
    )


def cmd_bootstrap(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    imported = gsa.bootstrap_from_yaml(conn, gaps_yaml)
    total = gsa.gap_count(conn)
    ok, msg = gsa.integrity_check(conn)
    conn.close()
    print(json.dumps({"ok": ok, "imported": imported, "total": total, "integrity": msg}))


def cmd_project(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    archive_closed = not getattr(args, "no_archive", False)
    archive_path = None
    if getattr(args, "archive_path", None):
        archive_path = Path(args.archive_path)
    result = gsa.project_to_yaml(conn, gaps_yaml, archive_closed=archive_closed, archive_path=archive_path)
    conn.close()
    print(json.dumps({"ok": True, "projection": result}))


def cmd_sync(args: argparse.Namespace) -> None:
    check_mutation_ceremony("sync", args)

    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    result = sync_gap_runtime(
        conn,
        root=root,
        gaps_yaml=gaps_yaml,
        context=str(args.context or "gaps.authority.sync").strip() or "gaps.authority.sync",
        expected_closed_gap_ids=[str(item).strip() for item in (args.expect_closed or []) if str(item).strip()],
    )
    conn.close()
    print(json.dumps(result), file=sys.stdout)
    if not result.get("ok"):
        sys.exit(PARTIAL_EXIT_CODE)


def cmd_next_id(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    nid = gsa.next_gap_id(conn)
    conn.close()
    print(nid)


def cmd_parity(args: argparse.Namespace) -> None:
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)
    snapshot = gsa.db_parity_snapshot(conn, gaps_yaml)
    conn.close()
    print(json.dumps(snapshot, indent=2))


def cmd_query(args: argparse.Namespace) -> None:
    """Query a single gap from SQLite authority. Returns JSON with exists/status/severity."""
    root = resolve_root()
    db_path, gaps_yaml = gsa.resolve_paths(root)
    conn = gsa.connect(db_path)
    gsa.ensure_schema(conn)
    gsa.bootstrap_from_yaml(conn, gaps_yaml)

    gap = gsa.get_gap(conn, args.id)
    conn.close()

    if gap is None:
        print(json.dumps({"exists": False, "gap_id": args.id}))
    else:
        print(json.dumps({
            "exists": True,
            "gap_id": gap.get("id", args.id),
            "status": gap.get("status", ""),
            "severity": gap.get("severity", ""),
            "regression_lock_id": gap.get("regression_lock_id", ""),
            "parent_loop": gap.get("parent_loop", ""),
        }))


def main() -> None:
    parser = argparse.ArgumentParser(description="Gaps SQLite authority bridge")
    sub = parser.add_subparsers(dest="command", required=True)

    # -- Shared override flags for mutating subcommands --
    def add_mutation_override_flags(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--ungoverned-override",
            action="store_true",
            default=False,
            help="Allow mutation without SPINE_CAP_RUN_KEY (emergency/bootstrap). Requires --reason.",
        )

    p_upsert = sub.add_parser("upsert")
    p_upsert.add_argument("--json", required=True)
    p_upsert.add_argument("--actor", default="")
    p_upsert.add_argument("--reason", default=None)
    add_mutation_override_flags(p_upsert)

    p_close = sub.add_parser("close")
    p_close.add_argument("--id", required=True)
    p_close.add_argument("--status", required=True)
    p_close.add_argument("--fixed-in", default=None)
    p_close.add_argument("--notes", default=None)
    p_close.add_argument("--regression-lock-id", default=None)
    p_close.add_argument("--completion-level", default=None)
    p_close.add_argument("--evidence", default=None)
    p_close.add_argument("--owner", default=None)
    p_close.add_argument("--expiry-check", default=None)
    p_close.add_argument("--root-cause", default=None)
    p_close.add_argument("--reason", default=None)
    p_close.add_argument("--actor", default="")
    p_close.add_argument(
        "--defer-sync",
        action="store_true",
        default=False,
        help="Internal: commit authority close but defer YAML/joined-state sync to a later governed sync step.",
    )
    add_mutation_override_flags(p_close)

    p_reparent = sub.add_parser("reparent")
    p_reparent.add_argument("--id", required=True)
    p_reparent.add_argument("--parent-loop", required=True)
    p_reparent.add_argument("--actor", default="")
    p_reparent.add_argument("--reason", default=None)
    add_mutation_override_flags(p_reparent)

    p_query = sub.add_parser("query")
    p_query.add_argument("--id", required=True)

    sub.add_parser("bootstrap")
    p_project = sub.add_parser("project")
    p_project.add_argument(
        "--no-archive",
        action="store_true",
        default=False,
        help="Disable archive split — write all gaps (including fixed/closed) to main YAML.",
    )
    p_project.add_argument(
        "--archive-path",
        default=None,
        help="Override the archive output path (default: ops/archive/operational.gaps.archive.yaml).",
    )
    sub.add_parser("next-id")
    sub.add_parser("parity")
    p_sync = sub.add_parser("sync")
    p_sync.add_argument("--context", default="gaps.authority.sync")
    p_sync.add_argument(
        "--expect-closed",
        action="append",
        default=[],
        help="Gap IDs that must not remain open in the refreshed joined-state surface.",
    )
    add_mutation_override_flags(p_sync)

    args = parser.parse_args()
    cmd_map = {
        "upsert": cmd_upsert,
        "close": cmd_close,
        "reparent": cmd_reparent,
        "query": cmd_query,
        "bootstrap": cmd_bootstrap,
        "project": cmd_project,
        "sync": cmd_sync,
        "next-id": cmd_next_id,
        "parity": cmd_parity,
    }
    cmd_map[args.command](args)


if __name__ == "__main__":
    main()
