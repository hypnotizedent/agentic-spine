#!/usr/bin/env python3
"""Friction disposition — closes friction items with structured disposition
+ evidence_refs, so packets can retire friction through the engine instead
of leaving resolved/superseded items as packet prose.

Authority: shared_authority.db (friction + friction_events tables) via
the existing close_friction lib hook. Encodes disposition + evidence_refs
+ free reason text as JSON in the closed_reason column (additive — no
schema migration; legacy plain-text closed_reason still readable).

Reasons covered:
  resolved   — packet/receipt directly fixed the named expected vs actual gap
  superseded — newer evidence/receipt makes this friction redundant
  duplicate  — same root cause already tracked under another friction_id
  invalid    — friction was misclassified or no longer applicable

Audit:
  - friction_events row recorded with event_type=<disposition> + run_key +
    payload_json containing evidence_refs.
  - friction.queue.status surfaces by_disposition counts post-close.

Authority boundary: this cap can only mark a friction item terminal. It
does not invent friction, modify gap state, or grant any other authority.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import gaps_sql_authority as authority  # noqa: E402


VALID_DISPOSITIONS = ("resolved", "superseded", "duplicate", "invalid")


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _pack_closed_reason(disposition: str, evidence_refs: list[str], reason: str) -> str:
    """Pack disposition + evidence_refs + reason into JSON for closed_reason.

    Stable shape so friction.queue.status / future readers can parse it
    without ambiguity. Free-text reason is preserved verbatim. Legacy
    rows that hold plain-text closed_reason still parse cleanly under
    the readers' try/except fallback.
    """
    return json.dumps(
        {
            "disposition": disposition,
            "evidence_refs": evidence_refs,
            "reason": reason,
            "disposed_at_utc": utc_now(),
        },
        sort_keys=True,
    )


def _unique_ordered(values: list[str]) -> list[str]:
    seen: set[str] = set()
    out: list[str] = []
    for value in values:
        text = str(value or "").strip()
        if not text or text in seen:
            continue
        seen.add(text)
        out.append(text)
    return out


def _dispose_many(
    conn,
    *,
    friction_ids: list[str],
    disposition: str,
    evidence_refs: list[str],
    reason: str,
    actor: str,
    force: bool,
    run_key: str | None,
) -> dict[str, Any]:
    friction_ids = _unique_ordered(friction_ids)
    if not friction_ids:
        return {"status": "error", "errors": ["at least one --friction-id is required"]}

    preflight: list[dict[str, Any]] = []
    errors: list[str] = []
    for friction_id in friction_ids:
        existing = authority.get_friction(conn, friction_id)
        if existing is None:
            errors.append(f"friction_id not found: {friction_id}")
            continue
        if existing.get("status") == "closed" and not force:
            errors.append(f"friction_id already closed: {friction_id} (use --force to re-dispose)")
            continue
        preflight.append({"friction_id": friction_id, "existing": existing})

    if errors:
        return {"status": "error", "errors": errors, "count": 0, "items": []}

    items: list[dict[str, Any]] = []
    packed_reason = _pack_closed_reason(disposition, evidence_refs, reason)
    for row in preflight:
        friction_id = row["friction_id"]
        existing = row["existing"]
        item = authority.close_friction(
            conn,
            friction_id,
            reason=packed_reason,
            actor=actor,
            run_key=run_key,
            mutation_source="governed",
        )
        if item is None:
            errors.append(f"close_friction returned None for {friction_id}")
            continue

        authority.insert_friction_event(
            conn,
            friction_id=friction_id,
            event_type=disposition,
            from_status=existing.get("status", "unknown"),
            to_status="closed",
            reason=reason,
            actor=actor,
            run_key=run_key,
            mutation_source="governed",
            payload={"evidence_refs": evidence_refs},
        )
        items.append(
            {
                "friction_id": friction_id,
                "disposition": disposition,
                "from_status": existing.get("status"),
                "to_status": "closed",
            }
        )

    if errors:
        conn.rollback()
        return {"status": "error", "errors": errors, "count": 0, "items": []}

    conn.commit()
    return {
        "status": "ok",
        "count": len(items),
        "items": items,
    }


def self_check() -> int:
    for fn in ("close_friction", "get_friction", "ensure_schema", "connect", "resolve_paths", "insert_friction_event"):
        if not hasattr(authority, fn):
            print(f"friction.dispose self-check FAIL: missing authority.{fn}", file=sys.stderr)
            return 1

    with tempfile.TemporaryDirectory(prefix="friction-dispose-self-check-") as td:
        db_path = Path(td) / "shared_authority.db"
        db_path.touch()
        conn = authority.connect(db_path)
        try:
            authority.ensure_schema(conn)
            now = utc_now()
            for friction_id in ("FR-DISPOSE-BATCH-1", "FR-DISPOSE-BATCH-2"):
                authority.upsert_friction(
                    conn,
                    {
                        "friction_id": friction_id,
                        "fingerprint": friction_id.lower(),
                        "capability": "friction.dispose.self_check",
                        "expected": "batch disposition closes each requested friction id",
                        "actual": "queued",
                        "severity": "medium",
                        "status": "queued",
                        "first_seen_utc": now,
                        "last_seen_utc": now,
                        "updated_at_utc": now,
                        "created_at_utc": now,
                        "hit_count": 1,
                        "sources": ["LOOP-FRICTION-DISPOSE-SELF-CHECK"],
                    },
                )
            conn.commit()

            result = _dispose_many(
                conn,
                friction_ids=["FR-DISPOSE-BATCH-1", "FR-DISPOSE-BATCH-2"],
                disposition="resolved",
                evidence_refs=["self-check"],
                reason="Verify batch disposition.",
                actor="friction.dispose.self_check",
                force=False,
                run_key="CAP-SELF-CHECK",
            )
            if result.get("status") != "ok" or result.get("count") != 2:
                print(f"friction.dispose self-check FAIL: batch result wrong: {result!r}", file=sys.stderr)
                return 1
            for friction_id in ("FR-DISPOSE-BATCH-1", "FR-DISPOSE-BATCH-2"):
                item = authority.get_friction(conn, friction_id)
                if not item or item.get("status") != "closed":
                    print(f"friction.dispose self-check FAIL: {friction_id} not closed", file=sys.stderr)
                    return 1
            duplicate = _dispose_many(
                conn,
                friction_ids=["FR-DISPOSE-BATCH-1"],
                disposition="resolved",
                evidence_refs=["self-check"],
                reason="Verify closed rows reject without force.",
                actor="friction.dispose.self_check",
                force=False,
                run_key="CAP-SELF-CHECK",
            )
            if duplicate.get("status") != "error":
                print("friction.dispose self-check FAIL: closed row accepted without force", file=sys.stderr)
                return 1

            authority.upsert_friction(
                conn,
                {
                    "friction_id": "FR-DISPOSE-BATCH-3",
                    "fingerprint": "fr-dispose-batch-3",
                    "capability": "friction.dispose.self_check",
                    "expected": "bad batch preflight leaves valid rows open",
                    "actual": "queued",
                    "severity": "medium",
                    "status": "queued",
                    "first_seen_utc": now,
                    "last_seen_utc": now,
                    "updated_at_utc": now,
                    "created_at_utc": now,
                    "hit_count": 1,
                    "sources": ["LOOP-FRICTION-DISPOSE-SELF-CHECK"],
                },
            )
            conn.commit()
            bad_batch = _dispose_many(
                conn,
                friction_ids=["FR-DISPOSE-BATCH-3", "FR-DISPOSE-MISSING"],
                disposition="resolved",
                evidence_refs=["self-check"],
                reason="Verify failed batch does not partially close valid rows.",
                actor="friction.dispose.self_check",
                force=False,
                run_key="CAP-SELF-CHECK",
            )
            if bad_batch.get("status") != "error":
                print("friction.dispose self-check FAIL: missing id batch unexpectedly succeeded", file=sys.stderr)
                return 1
            item = authority.get_friction(conn, "FR-DISPOSE-BATCH-3")
            if not item or item.get("status") != "queued":
                print("friction.dispose self-check FAIL: failed batch partially closed a valid row", file=sys.stderr)
                return 1
        finally:
            conn.close()

    print("friction.dispose self-check PASS")
    return 0


def main() -> int:
    # Bypass required-args enforcement when --self-check is passed standalone.
    if "--self-check" in sys.argv[1:]:
        return self_check()

    parser = argparse.ArgumentParser(
        description="Per-id friction disposition with evidence_refs to the proof receipt."
    )
    parser.add_argument(
        "--friction-id",
        action="append",
        dest="friction_ids",
        required=True,
        help="Friction id (repeatable for a governed batch disposition).",
    )
    parser.add_argument(
        "--disposition", required=True, choices=VALID_DISPOSITIONS,
        help="resolved | superseded | duplicate | invalid",
    )
    parser.add_argument(
        "--evidence-ref", action="append", default=[],
        help="Run key, packet id, or receipt path. Repeatable.",
    )
    parser.add_argument("--reason", required=True, help="Operator-readable reason text.")
    parser.add_argument(
        "--actor", default="friction.dispose",
        help="Actor identity for the close event (default: cap name).",
    )
    parser.add_argument(
        "--force", action="store_true", default=False,
        help="Re-dispose an already-closed friction (default: refuse)."
    )
    parser.add_argument("--json", action="store_true", dest="json_output")
    args = parser.parse_args()

    db_path, _ = authority.resolve_paths(ROOT)
    conn = authority.connect(db_path)
    try:
        authority.ensure_schema(conn)

        run_key = os.environ.get("SPINE_CAP_RUN_KEY", "").strip() or None
        evidence_refs = [str(r).strip() for r in (args.evidence_ref or []) if str(r).strip()]

        result = _dispose_many(
            conn,
            friction_ids=args.friction_ids,
            disposition=args.disposition,
            evidence_refs=evidence_refs,
            reason=args.reason,
            actor=args.actor,
            force=args.force,
            run_key=run_key,
        )
        if result.get("status") != "ok":
            errors = result.get("errors") or ["friction.dispose failed"]
            payload = {
                "status": "error",
                "error": "; ".join(errors),
                "errors": errors,
            }
            print(json.dumps(payload, indent=2) if args.json_output else "FAIL: " + "; ".join(payload["errors"]), file=sys.stderr)
            return 1

        payload = {
            "status": "ok",
            "disposition": args.disposition,
            "evidence_refs": evidence_refs,
            "actor": args.actor,
            "run_key": run_key,
            "count": result["count"],
            "items": result["items"],
        }
        if result["count"] == 1:
            payload["friction_id"] = result["items"][0]["friction_id"]
            payload["from_status"] = result["items"][0]["from_status"]
            payload["to_status"] = "closed"
        if args.json_output:
            print(json.dumps(payload, indent=2))
        else:
            print("friction.dispose")
            print(f"count: {result['count']}")
            print(f"disposition: {args.disposition}")
            for item in result["items"]:
                print(f"  - {item['friction_id']}: {item['from_status']} -> closed")
            print(f"evidence_refs: {', '.join(evidence_refs) or '<none>'}")
            print(f"reason: {args.reason}")
        return 0
    finally:
        conn.close()


if __name__ == "__main__":
    raise SystemExit(main())
