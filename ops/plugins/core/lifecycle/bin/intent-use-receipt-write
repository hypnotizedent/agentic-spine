#!/usr/bin/env python3
"""intent-use-receipt-write — write HI -> work usage receipt."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import intent_use_receipts as iur


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="intent-use-receipt-write",
        description="Write an intent-use receipt into shared_authority.db.",
    )
    parser.add_argument("--human-intent-ref", required=False)
    parser.add_argument("--used-as", required=False)
    parser.add_argument("--destination-type", required=False)
    parser.add_argument("--destination-ref", required=False)
    parser.add_argument("--reason", required=False)
    parser.add_argument("--proof-ref", default="")
    parser.add_argument("--source-ref", default="")
    parser.add_argument("--capture-mode", default="agent_declared")
    parser.add_argument("--created-by", default="")
    parser.add_argument("--json", action="store_true", dest="json_output")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args()

    if args.self_check:
        try:
            conn = iur.connect(iur.db_path())
            iur.ensure_schema(conn)
            conn.close()
            print("intent.use.receipt.write self-check PASS")
            return 0
        except Exception as exc:
            print(f"intent.use.receipt.write self-check FAIL: {exc}", file=sys.stderr)
            return 1

    created_by = args.created_by or os.environ.get("CAP_RUN_KEY") or os.environ.get("OPS_TERMINAL_ID", "")
    try:
        conn = iur.connect(iur.db_path())
        iur.ensure_schema(conn)
        receipt = iur.write_receipt(
            conn,
            human_intent_ref=args.human_intent_ref or "",
            used_as=args.used_as or "",
            destination_type=args.destination_type or "",
            destination_ref=args.destination_ref or "",
            reason=args.reason or "",
            proof_ref=args.proof_ref,
            capture_mode=args.capture_mode,
            source_ref=args.source_ref,
            created_by=created_by,
        )
        conn.commit()
        conn.close()
    except Exception as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"intent.use.receipt.write FAIL: {exc}", file=sys.stderr)
        return 1

    payload = {"status": "written", "receipt": receipt}
    if args.json_output:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("intent.use.receipt.write")
        print(f"id: {receipt['id']}")
        print(f"human_intent_ref: {receipt['human_intent_ref']}")
        print(f"used_as: {receipt['used_as']}")
        print(f"destination: {receipt['destination_type']}:{receipt['destination_ref']}")
        if receipt.get("proof_ref"):
            print(f"proof_ref: {receipt['proof_ref']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
