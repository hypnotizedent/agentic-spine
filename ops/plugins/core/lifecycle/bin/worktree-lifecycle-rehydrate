#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
CONTRACT="$ROOT/ops/bindings/worktree.lifecycle.contract.yaml"

REPO_PATH="$ROOT"
BRANCH=""
LANE=""
OWNER="${SPINE_TERMINAL_ID:-${OPS_TERMINAL_ID:-${OPS_TERMINAL_ROLE:-SPINE-CONTROL-01}}}"
FORCE=0
SELF_CHECK=0

lane_policy_hint() {
  printf '%s\n' "explicit lane id (WAVE-... or PACKET-...)"
}

lane_policy_accepts() {
  local lane="${1:-}"
  [[ "$lane" =~ ^WAVE-[A-Z0-9._-]+$ || "$lane" =~ ^PACKET-[A-Za-z0-9._-]+$ ]]
}

derive_lane_from_branch() {
  local branch="${1:-}"
  local lane=""
  if [[ "$branch" == codex/* ]]; then
    lane="${branch#codex/}"
  elif [[ "$branch" == orchestration/* ]]; then
    lane="${branch#orchestration/}"
  elif [[ "$branch" == *PACKET-* ]]; then
    lane="PACKET-${branch#*PACKET-}"
    lane="$(printf '%s' "$lane" | sed -E 's/-20[0-9]{6}$//')"
  else
    lane="${branch//\//-}"
  fi
  printf '%s\n' "$lane"
}

resolve_enforced_prefix() {
  local repo_path="${1:-$ROOT}"
  spine_canonical_worktree_prefix "$repo_path" "$CONTRACT"
}

path_policy_block() {
  local detail="${1:-unknown path policy violation}"
  local allowed_prefix=""
  allowed_prefix="$(resolve_enforced_prefix "$REPO_PATH")"
  cat >&2 <<EOF
WORKTREE PATH POLICY BLOCK: $detail
Allowed worktree path: ${allowed_prefix}<LANE_ID>
Allowed lane ids: WAVE-... or PACKET-...
Remediation:
  ./bin/ops wave start <WAVE_ID> --objective "<objective>" --repo /Users/ronnyworks/code/agentic-spine
  ./bin/ops cap run worktree.lifecycle.rehydrate -- --branch codex/<WAVE_ID> --lane <WAVE_ID> --repo /Users/ronnyworks/code/agentic-spine
  ./bin/ops cap run worktree.lifecycle.rehydrate -- --branch runtime/<PACKET-ID>-<slug>-YYYYMMDD --lane <PACKET-ID>-<slug> --repo /Users/ronnyworks/code/agentic-spine
EOF
  exit 1
}

usage() {
  cat <<'USAGE'
worktree-lifecycle-rehydrate

Usage:
  worktree-lifecycle-rehydrate --branch <branch> [--lane <lane>] [--repo <path>] [--owner <id>] [--force]

Behavior:
  - Recreates missing canonical worktree path under the governed worktree root for an existing branch.
  - Accepts explicit WAVE-* lanes and packet-shaped PACKET-* lanes.
  - Writes/refreshes lane lease metadata.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --branch) BRANCH="${2:-}"; shift 2 ;;
    --lane) LANE="${2:-}"; shift 2 ;;
    --repo) REPO_PATH="${2:-}"; shift 2 ;;
    --owner) OWNER="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --self-check) SELF_CHECK=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ "$SELF_CHECK" -eq 1 ]]; then
  for accepted in \
    "WAVE-WORKFLOW-PAIN-SUBTRACTION-20260505" \
    "PACKET-1298-WORKFLOW-PAIN-SUBTRACTION" \
    "PACKET-1297-routine-telemetry-subtraction"
  do
    lane_policy_accepts "$accepted" || {
      echo "worktree.lifecycle.rehydrate self-check FAIL: rejected valid lane $accepted" >&2
      exit 1
    }
  done
  for rejected in \
    "TASK-1298-WORKFLOW-PAIN-SUBTRACTION" \
    "packet-1298-workflow-pain-subtraction" \
    "WAVE-workflow-pain-subtraction"
  do
    if lane_policy_accepts "$rejected"; then
      echo "worktree.lifecycle.rehydrate self-check FAIL: accepted invalid lane $rejected" >&2
      exit 1
    fi
  done
  [[ "$(derive_lane_from_branch "runtime/PACKET-1297-routine-telemetry-subtraction-20260505")" == "PACKET-1297-routine-telemetry-subtraction" ]] || {
    echo "worktree.lifecycle.rehydrate self-check FAIL: packet branch derivation changed" >&2
    exit 1
  }
  echo "worktree.lifecycle.rehydrate self-check PASS ($(lane_policy_hint))"
  exit 0
fi

if [[ -z "$BRANCH" ]]; then
  echo "--branch is required" >&2
  usage
  exit 2
fi

REPO_ROOT="$(spine_git_common_root "$REPO_PATH")"
if [[ -z "$REPO_ROOT" ]]; then
  echo "FAIL: --repo is not a git repository path: $REPO_PATH" >&2
  exit 1
fi

CANONICAL_ROOT="$(spine_canonical_worktree_root "$REPO_ROOT" "$CONTRACT")"
LEASE_FILENAME=".spine-lane-lease.yaml"
LEASE_TTL_HOURS="24"
if command -v yq >/dev/null 2>&1 && [[ -f "$CONTRACT" ]]; then
  LEASE_FILENAME="$(yq e -r '.policy.lease_filename // ".spine-lane-lease.yaml"' "$CONTRACT" 2>/dev/null || echo "$LEASE_FILENAME")"
  LEASE_TTL_HOURS="$(yq e -r '.policy.lease_ttl_hours_default // 24' "$CONTRACT" 2>/dev/null || echo "$LEASE_TTL_HOURS")"
fi

if [[ -z "$LANE" ]]; then
  LANE="$(derive_lane_from_branch "$BRANCH")"
fi

if [[ "${LANE^^}" == WAVE-* ]]; then
  LANE="${LANE^^}"
fi
lane_policy_accepts "$LANE" || path_policy_block "lane '$LANE' must be an $(lane_policy_hint)"

REPO_NAME="$(basename "$REPO_ROOT")"
TARGET_WT="$CANONICAL_ROOT/$REPO_NAME/$LANE"
ENFORCED_PREFIX="$(resolve_enforced_prefix "$REPO_ROOT")"
NOW="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

[[ "$TARGET_WT" != *"/.worktrees/"* ]] || path_policy_block "legacy .worktrees target denied: $TARGET_WT"
[[ "$TARGET_WT" != "$REPO_ROOT" && "$TARGET_WT" != "$REPO_ROOT/"* ]] || path_policy_block "main checkout path denied: $TARGET_WT"
[[ "$TARGET_WT" == "${ENFORCED_PREFIX}"* ]] || path_policy_block "target '$TARGET_WT' is outside enforced prefix '$ENFORCED_PREFIX'"

# Ensure branch exists locally, or materialize from origin if present.
if ! git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git -C "$REPO_ROOT" branch "$BRANCH" "origin/$BRANCH" >/dev/null
  else
    echo "FAIL: branch not found locally or on origin: $BRANCH" >&2
    exit 1
  fi
fi

OCCUPIED_WT="$(python3 - "$REPO_ROOT" "$BRANCH" <<'PY'
import sys
from pathlib import Path
import subprocess
repo = Path(sys.argv[1]).resolve()
branch = sys.argv[2]
proc = subprocess.run(["git","-C",str(repo),"worktree","list","--porcelain"], text=True, capture_output=True, check=True)
wt = ""
for raw in proc.stdout.splitlines():
    ln = raw.strip()
    if ln.startswith("worktree "):
        wt = ln.split(" ",1)[1].strip()
    elif ln.startswith("branch refs/heads/"):
        b = ln.split("refs/heads/",1)[1].strip()
        if b == branch:
            print(wt)
            break
PY
)"

if [[ -n "$OCCUPIED_WT" && "$OCCUPIED_WT" != "$TARGET_WT" && "$FORCE" -ne 1 ]]; then
  echo "worktree.lifecycle.rehydrate reused existing branch worktree"
  echo "branch=$BRANCH"
  echo "worktree=$OCCUPIED_WT"
  exit 0
fi

if [[ -n "$OCCUPIED_WT" && "$OCCUPIED_WT" != "$TARGET_WT" && "$FORCE" -eq 1 ]]; then
  git -C "$REPO_ROOT" worktree remove --force "$OCCUPIED_WT"
fi

if git -C "$TARGET_WT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  CURRENT_BRANCH="$(git -C "$TARGET_WT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  if [[ "$CURRENT_BRANCH" != "$BRANCH" ]]; then
    echo "FAIL: target worktree exists with different branch ($CURRENT_BRANCH): $TARGET_WT" >&2
    exit 1
  fi
else
  mkdir -p "$(dirname "$TARGET_WT")"
  git -C "$REPO_ROOT" worktree add "$TARGET_WT" "$BRANCH" >/dev/null
fi

LEASE_PATH="$TARGET_WT/$LEASE_FILENAME"
TMP_LEASE="$(mktemp "${LEASE_PATH}.tmp.XXXXXX")"
cat > "$TMP_LEASE" <<LEASE
---
version: 1
status: active
owner: "$OWNER"
loop_or_wave_id: "$LANE"
repo: "$REPO_ROOT"
worktree: "$TARGET_WT"
branch: "$BRANCH"
created_at: "$NOW"
heartbeat_at: "$NOW"
ttl_hours: $LEASE_TTL_HOURS
---
LEASE
mv "$TMP_LEASE" "$LEASE_PATH"
spine_ensure_git_exclude "$TARGET_WT" "$LEASE_FILENAME"

echo "worktree.lifecycle.rehydrate done"
echo "repo=$REPO_ROOT"
echo "branch=$BRANCH"
echo "lane=$LANE"
echo "worktree=$TARGET_WT"
echo "lease=$LEASE_PATH"
