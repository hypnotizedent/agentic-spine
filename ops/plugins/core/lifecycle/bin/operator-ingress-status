#!/usr/bin/env python3
"""operator-ingress-status — CLI for operator_ingress.status capability."""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request
import urllib.error
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import operator_ingress as oi


MEANING_TRANSLATION_PATH = (
    Path(os.environ.get("SPINE_STATE", "/Users/ronnyworks/code/.runtime/spine/state"))
    / "domain-state/spine/PACKET-531-OI-PAGE-MEANING-FULL-RAW-TRANSLATION-DRAFT-V3-20260430.json"
)
MEANING_SYNTHESIS_PATH = (
    Path(os.environ.get("SPINE_STATE", "/Users/ronnyworks/code/.runtime/spine/state"))
    / "domain-state/spine/PACKET-531-OI-PAGE-MEANING-OUTCOME-SYNTHESIS-20260430.md"
)


OPERATING_SEMANTICS = {
    "authority": "operator ingress is raw human notepad/context, not workflow authority",
    "paths": [
        {
            "name": "capture_idea",
            "steps": [
                "Ronny submits raw thought/conversation/note",
                "operator.ingress.submit preserves raw_content without execution authority",
                "operator.ingress.metabolize classifies meaning and assigns a bounded disposition",
                "operator.ingress.status shows whether it is shelf, no-op, attached, deferred, or candidate",
            ],
        },
        {
            "name": "build_spec",
            "steps": [
                "raw OI/HI remains evidence",
                "membrane/readback identifies the existing seam or asks for Ronny clarification",
                "a governed loop/packet is born only when there is a bounded objective and acceptance",
                "the packet produces an artifact, receipt, and closeout; raw OI never becomes execution by itself",
            ],
        },
        {
            "name": "work_in_spine",
            "steps": [
                "start from ops status and current aperture",
                "use governed capability surfaces when they exist",
                "mutate repos only in managed worktrees",
                "prove completion with verify.engine.run, spine.verify, receipts, and closed loop/packet state",
            ],
        },
    ],
    "hard_lines": [
        "packet_candidate is not a queue item",
        "domain_agent:* is not proof of routing or completion",
        "chat/mobile/Codex text is capture/request context, not authority",
        "loops, packets, waves, and receipts are expert/control-plane machinery, not the operator notepad",
    ],
}


VIEWPORT_CONTRACT = {
    "authority_boundary": "chat, mobile, shell, browser, and remote agents are viewports; spine readbacks decide authority",
    "required_context_before_action": [
        "current aperture from AGENTS.md",
        "public orientation from session.v3.attach or ops status",
        "bounded work object when execution is requested",
        "existing canonical home for the subject",
        "allowed mutation class and required proof",
    ],
    "action_ladder": [
        {"class": "A", "name": "capture_context", "allowed": "preserve raw input; no execution"},
        {"class": "B", "name": "meaning_translation", "allowed": "slim source and state confidence; no mutation"},
        {"class": "C", "name": "bounded_spec", "allowed": "create or amend governed packet/loop when acceptance exists"},
        {"class": "D", "name": "implementation", "allowed": "mutate only through existing governed homes and worktrees"},
        {"class": "E", "name": "closure", "allowed": "verify, receipt, and closeout through canonical surfaces"},
    ],
    "hard_lines": [
        "viewport text is never authority by itself",
        "wrapper state is never proof that page meaning is satisfied",
        "low-confidence meaning translation cannot activate work",
        "Ronny confirmation is escalation, not a default paperwork queue",
    ],
}


def _read_json(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def _meaning_items() -> list[dict[str, Any]]:
    data = _read_json(MEANING_TRANSLATION_PATH)
    items = data.get("items")
    return items if isinstance(items, list) else []


def _confidence(item: dict[str, Any]) -> dict[str, Any]:
    conf = item.get("agent_understanding_confidence")
    return conf if isinstance(conf, dict) else {}


def _meaning_outcomes(oi_filter: str = "", min_confidence: str = "") -> dict[str, Any]:
    order = {"low": 0, "medium": 1, "high": 2}
    min_score = order.get(min_confidence, -1)
    rows: list[dict[str, Any]] = []
    confidence_counts = {"high": 0, "medium": 0, "low": 0, "unknown": 0}
    for item in _meaning_items():
        oi_id = str(item.get("oi") or "")
        if oi_filter and oi_id != oi_filter:
            continue
        conf = _confidence(item)
        level = str(conf.get("level") or "unknown")
        confidence_counts[level] = confidence_counts.get(level, 0) + 1
        if min_score >= 0 and order.get(level, -1) < min_score:
            continue
        outcome = item.get("outcome_this_asks_for") or []
        proof = item.get("proof_should_satisfy") or []
        saying = item.get("what_doc_is_saying") or []
        rows.append(
            {
                "oi": oi_id,
                "raw_words": item.get("raw_words"),
                "raw_sha256": item.get("raw_sha256"),
                "confidence": conf,
                "what_doc_is_saying": saying,
                "outcome_this_asks_for": outcome,
                "proof_should_satisfy": proof,
                "activation_state": (
                    "eligible_for_synthesis"
                    if level == "high"
                    else "review_before_activation"
                    if level == "medium"
                    else "blocked_until_corrected"
                ),
                "source_ref": item.get("source_ref"),
            }
        )
    return {
        "status": "ok" if rows or oi_filter else "ok",
        "capability": "operator.ingress.status",
        "mode": "meaning_outcomes",
        "translation_artifact": str(MEANING_TRANSLATION_PATH),
        "synthesis_artifact": str(MEANING_SYNTHESIS_PATH),
        "confidence_counts": confidence_counts,
        "rows": rows,
    }


def _source_ledger() -> dict[str, Any]:
    source_ids = {
        "OI-20260429-023749-71e6",
        "OI-20260429-023802-a5eb",
        "OI-20260429-023806-49c4",
        "OI-20260429-023825-ccce",
        "OI-20260429-023747-3a9c",
    }
    rows = []
    for item in _meaning_items():
        if item.get("oi") not in source_ids:
            continue
        conf = _confidence(item)
        rows.append(
            {
                "oi": item.get("oi"),
                "source_ref": item.get("source_ref"),
                "raw_sha256": item.get("raw_sha256"),
                "confidence": conf,
                "slimmed_machine_content": item.get("slimmed_machine_content") or [],
                "retrieval_status": "source_preserved_in_operator_ingress",
                "canonical_home": "operator ingress raw source + rag.direct retrieval/source-card lane",
                "usage_receipt_status": "required_before_execution",
                "activation_state": "eligible_for_source_synthesis"
                if conf.get("level") == "high"
                else "review_before_activation",
            }
        )
    return {
        "status": "ok",
        "capability": "operator.ingress.status",
        "mode": "source_ledger",
        "packet": "PACKET-535-SOURCE-KNOWLEDGE-CONTINUITY-LEDGER",
        "rows": rows,
    }


def _print_operating_semantics() -> None:
    print("Operating semantics:")
    print(f"  authority: {OPERATING_SEMANTICS['authority']}")
    for path in OPERATING_SEMANTICS["paths"]:
        print(f"  {path['name']}:")
        for idx, step in enumerate(path["steps"], start=1):
            print(f"    {idx}. {step}")
    print("  hard lines:")
    for line in OPERATING_SEMANTICS["hard_lines"]:
        print(f"    - {line}")


def _print_viewport_contract() -> None:
    print("Operating surface viewport contract:")
    print(f"  authority_boundary: {VIEWPORT_CONTRACT['authority_boundary']}")
    print("  required_context_before_action:")
    for item in VIEWPORT_CONTRACT["required_context_before_action"]:
        print(f"    - {item}")
    print("  action_ladder:")
    for row in VIEWPORT_CONTRACT["action_ladder"]:
        print(f"    {row['class']}. {row['name']}: {row['allowed']}")
    print("  hard_lines:")
    for item in VIEWPORT_CONTRACT["hard_lines"]:
        print(f"    - {item}")


def _print_meaning_outcomes(payload: dict[str, Any]) -> None:
    print("Meaning-to-outcome readback:")
    print(f"  translation_artifact: {payload['translation_artifact']}")
    print(f"  confidence_counts: {json.dumps(payload['confidence_counts'], sort_keys=True)}")
    for row in payload["rows"]:
        conf = row.get("confidence") or {}
        print(f"- {row['oi']}  confidence={conf.get('level', 'unknown')}({conf.get('score', 'n/a')})  {row['activation_state']}")
        for line in (row.get("what_doc_is_saying") or [])[:2]:
            print(f"    says: {line}")
        for line in (row.get("outcome_this_asks_for") or [])[:2]:
            print(f"    outcome: {line}")
        for line in (row.get("proof_should_satisfy") or [])[:2]:
            print(f"    proof: {line}")


def _print_source_ledger(payload: dict[str, Any]) -> None:
    print("Source knowledge continuity ledger:")
    for row in payload["rows"]:
        conf = row.get("confidence") or {}
        print(f"- {row['oi']}  confidence={conf.get('level', 'unknown')}  {row['activation_state']}")
        print(f"    source: {row['source_ref']}")
        print(f"    home:   {row['canonical_home']}")
        print(f"    usage:  {row['usage_receipt_status']}")


def _load_yaml(path: Path) -> dict[str, Any]:
    try:
        import yaml

        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _operator_route(path: str) -> str:
    contract = _load_yaml(ROOT / "ops/bindings/operator.cockpit.contract.yaml")
    authority = contract.get("authority") if isinstance(contract.get("authority"), dict) else {}
    base = os.environ.get("OPERATOR_COCKPIT_URL") or str(authority.get("public_operator_url") or "").strip()
    if not base:
        raise RuntimeError("operator cockpit URL missing; set OPERATOR_COCKPIT_URL or restore operator.cockpit.contract.yaml")
    return base.rstrip("/") + "/" + path.lstrip("/")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="operator-ingress-status",
        description="List recent OI/HI human-intent lifecycle objects.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=20,
        help="Maximum items to return (default: 20).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_output",
        help="Emit JSON output.",
    )
    parser.add_argument(
        "--guide",
        action="store_true",
        help="Show the unambiguous operator-ingress operating model and exit.",
    )
    parser.add_argument(
        "--viewport-contract",
        action="store_true",
        help="Show the operating-surface viewport contract derived from Packet 532.",
    )
    parser.add_argument(
        "--meaning-outcomes",
        action="store_true",
        help="Show confidence-gated meaning-to-outcome readback derived from Packet 533.",
    )
    parser.add_argument(
        "--source-ledger",
        action="store_true",
        help="Show source knowledge continuity rows derived from Packet 535.",
    )
    parser.add_argument(
        "--oi",
        default="",
        help="Filter meaning/source readbacks to one OI id.",
    )
    parser.add_argument(
        "--min-confidence",
        choices=["low", "medium", "high"],
        default="",
        help="Minimum confidence for meaning-outcomes rows.",
    )
    parser.add_argument(
        "--remote",
        action="store_true",
        help="Read from canonical remote root (ai-consolidation) via API.",
    )
    parser.add_argument(
        "--remote-url",
        default=None,
        help="Canonical remote readback URL (default: operator.cockpit.contract.yaml public_operator_url + /ingress.json).",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="Verify dependencies and exit.",
    )

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            sample = {
                "ingress_id": "OI-SELF-CHECK",
                "lifecycle_state": "submitted",
                "disposition": "awaiting_classification",
                "human_intent": {
                    "intent_id": "HI-SELF-CHECK",
                    "status": "captured",
                    "statement": "self-check",
                },
            }
            lifecycle = oi.build_intent_chain_readback(sample, state_root="/tmp")
            if lifecycle["source"]["human_intent_id"] != "HI-SELF-CHECK":
                raise RuntimeError("OI/HI readback chain omitted human_intent_id")
            if "capture_idea" not in {row["name"] for row in OPERATING_SEMANTICS["paths"]}:
                raise RuntimeError("operator-ingress operating semantics omitted capture_idea path")
            if not _meaning_items():
                raise RuntimeError("operator-ingress meaning outcome artifact missing or empty")
            print("operator.ingress.status self-check PASS")
            return 0
        except ImportError as exc:
            print(f"operator.ingress.status self-check FAIL: {exc}", file=sys.stderr)
            return 1
        except Exception as exc:
            print(f"operator.ingress.status self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()
    if args.guide:
        if args.json_output:
            print(json.dumps({"operating_semantics": OPERATING_SEMANTICS}, indent=2))
        else:
            _print_operating_semantics()
        return 0
    if args.viewport_contract:
        payload = {"viewport_contract": VIEWPORT_CONTRACT}
        if args.json_output:
            print(json.dumps(payload, indent=2))
        else:
            _print_viewport_contract()
        return 0
    if args.meaning_outcomes:
        payload = _meaning_outcomes(oi_filter=args.oi, min_confidence=args.min_confidence)
        if args.json_output:
            print(json.dumps(payload, indent=2))
        else:
            _print_meaning_outcomes(payload)
        return 0
    if args.source_ledger:
        payload = _source_ledger()
        if args.oi:
            payload["rows"] = [row for row in payload["rows"] if row.get("oi") == args.oi]
        if args.json_output:
            print(json.dumps(payload, indent=2))
        else:
            _print_source_ledger(payload)
        return 0

    # --- Remote readback: fetch from canonical root via /ingress.json ---
    if args.remote:
        headers = {
            "Accept": "application/json",
            "User-Agent": "operator-ingress-status/1.0",
        }
        cf_id = os.environ.get("CF_ACCESS_CLIENT_ID", "")
        cf_secret = os.environ.get("CF_ACCESS_CLIENT_SECRET", "")
        if cf_id and cf_secret:
            headers["CF-Access-Client-Id"] = cf_id
            headers["CF-Access-Client-Secret"] = cf_secret

        try:
            remote_url = args.remote_url or _operator_route("/ingress.json")
        except Exception as exc:
            print(f"operator.ingress.status FAIL (remote): {exc}", file=sys.stderr)
            return 1

        req = urllib.request.Request(remote_url, headers=headers, method="GET")
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                result = json.loads(resp.read().decode("utf-8"))
        except Exception as exc:
            if args.json_output:
                print(json.dumps({"status": "error", "error": f"remote readback failed: {exc}"}, indent=2))
            else:
                print(f"operator.ingress.status FAIL (remote): {exc}", file=sys.stderr)
            return 1

        read_root = result.get("state_root", "canonical (remote)")
        if args.json_output:
            result["operating_semantics"] = OPERATING_SEMANTICS
            result["viewport_contract"] = VIEWPORT_CONTRACT
            result["meaning_outcome_summary"] = _meaning_outcomes(min_confidence="high")["confidence_counts"]
            print(json.dumps(result, indent=2))
        else:
            _print_operating_semantics()
            print("")
            if not result.get("items"):
                print(f"No ingress items.  [root: {read_root}]")
            else:
                print(f"Items ({result.get('count', '?')}):  [root: {read_root}]")
                for item in result["items"]:
                    adoption = item.get("adoption_state", "")
                    adoption_ref = item.get("adoption_ref", "")
                    adoption_col = f"  {adoption}" if adoption else ""
                    ref_col = f"  → {adoption_ref}" if adoption_ref else ""
                    chain = item.get("intent_chain_readback", {}) if isinstance(item.get("intent_chain_readback"), dict) else {}
                    proof = chain.get("proof_receipt", {}) if isinstance(chain.get("proof_receipt"), dict) else {}
                    missing = chain.get("next_missing_seam", "")
                    hi = item.get("human_intent_id", "")
                    canonical_state = item.get("canonical_state", "")
                    print(
                        f"  {item['ingress_id']}  {hi or 'HI pending'}  {item.get('content_type', ''):18s}  "
                        f"OI={item.get('lifecycle_state', ''):10s}  HI={canonical_state or item.get('human_intent_status', '')}  {item.get('disposition', '')}"
                        f"{adoption_col}{ref_col}"
                    )
                    if proof.get("ref") or missing:
                        proof_ref = proof.get("ref") or "n/a"
                        print(f"    proof: {proof_ref}  missing: {missing or 'none'}")
        return 0

    # --- Local readback ---
    state_root = os.environ.get("SPINE_STATE", "")
    if not state_root:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"operator.ingress.status FAIL: {msg}", file=sys.stderr)
        return 1

    result = oi.list_operator_ingress(state_root=state_root, limit=args.limit)

    if args.json_output:
        result["state_root"] = state_root
        result["operating_semantics"] = OPERATING_SEMANTICS
        result["viewport_contract"] = VIEWPORT_CONTRACT
        result["meaning_outcome_summary"] = _meaning_outcomes(min_confidence="high")["confidence_counts"]
        print(json.dumps(result, indent=2))
    else:
        _print_operating_semantics()
        print("")
        if not result["items"]:
            print(f"No ingress items.  [root: {state_root} (local)]")
        else:
            print(f"Items ({result['count']}):  [root: {state_root} (local)]")
            for item in result["items"]:
                adoption = item.get("adoption_state", "")
                adoption_ref = item.get("adoption_ref", "")
                adoption_col = f"  {adoption}" if adoption else ""
                ref_col = f"  → {adoption_ref}" if adoption_ref else ""
                chain = item.get("intent_chain_readback", {}) if isinstance(item.get("intent_chain_readback"), dict) else {}
                proof = chain.get("proof_receipt", {}) if isinstance(chain.get("proof_receipt"), dict) else {}
                missing = chain.get("next_missing_seam", "")
                hi = item.get("human_intent_id", "")
                canonical_state = item.get("canonical_state", "")
                print(
                    f"  {item['ingress_id']}  {hi or 'HI pending'}  {item['content_type']:18s}  "
                    f"OI={item['lifecycle_state']:10s}  HI={canonical_state or item.get('human_intent_status', '')}  {item['disposition']}"
                    f"{adoption_col}{ref_col}"
                )
                if proof.get("ref") or missing:
                    proof_ref = proof.get("ref") or "n/a"
                    print(f"    proof: {proof_ref}  missing: {missing or 'none'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
