#!/usr/bin/env python3
"""operator-ingress-status — CLI for operator_ingress.status capability."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import operator_ingress as oi


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="operator-ingress-status",
        description="List recent operator ingress objects.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=20,
        help="Maximum items to return (default: 20).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        dest="json_output",
        help="Emit JSON output.",
    )
    parser.add_argument(
        "--self-check",
        action="store_true",
        help="Verify dependencies and exit.",
    )

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            print("operator.ingress.status self-check PASS")
            return 0
        except ImportError as exc:
            print(f"operator.ingress.status self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()

    state_root = os.environ.get("SPINE_STATE", "")
    if not state_root:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"operator.ingress.status FAIL: {msg}", file=sys.stderr)
        return 1

    result = oi.list_operator_ingress(state_root=state_root, limit=args.limit)

    # Always fetch metabolizer status for the summary
    try:
        metabolizer = oi.operator_ingress_auto_metabolizer_status(state_root)
    except oi.OperatorIngressError:
        metabolizer = None

    if args.json_output:
        if metabolizer:
            result["metabolizer"] = {
                "status": metabolizer["status"],
                "queue": metabolizer["queue"],
                "worker_pid_alive": metabolizer["worker"]["pid_alive"],
                "heartbeat_at": metabolizer["worker"]["heartbeat_at"],
                "heartbeat_age_seconds": metabolizer["worker"]["heartbeat_age_seconds"],
                "heartbeat_stale": metabolizer["worker"].get("heartbeat_stale", False),
            }
        print(json.dumps(result, indent=2))
    else:
        # Metabolizer health summary
        if metabolizer:
            q = metabolizer["queue"]
            w = metabolizer["worker"]
            status = metabolizer["status"]
            age = w.get("heartbeat_age_seconds")
            if status == "running":
                label = "HEALTHY"
            elif status == "recent":
                label = "IDLE"
            elif status == "stale":
                label = "STALE"
            elif w.get("heartbeat_at"):
                label = "DEAD"
            else:
                label = "NEVER_RUN"
            age_str = ""
            if age is not None:
                if age < 60:
                    age_str = f" ({age}s ago)"
                elif age < 3600:
                    age_str = f" ({age // 60}m ago)"
                else:
                    age_str = f" ({age // 3600}h {(age % 3600) // 60}m ago)"
            print(f"Metabolizer: {label}  heartbeat: {w['heartbeat_at'] or 'never'}{age_str}")
            print(f"Queue: {q['pending']} pending / {q['classified']} classified / {q['routed']} routed / {q['total']} total")
            print()

        # Items listing
        print(f"Recent items ({result['count']}):")
        for item in result["items"]:
            state_tag = item['lifecycle_state']
            disp_tag = item['disposition']
            print(
                f"  {item['ingress_id']}  {item['content_type']:18s}  "
                f"{state_tag:12s}  {disp_tag}"
            )
            if item["operator_hint"]:
                print(f"    hint: {item['operator_hint']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
