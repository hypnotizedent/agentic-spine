#!/usr/bin/env bash
set -euo pipefail

# state.shared.reconcile — Shared authority reconcile with integrity check and snapshot rollback.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
RECONCILE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/planning-plans-reconcile"
REVIEW_SWEEP_BIN="$ROOT/ops/plugins/core/lifecycle/bin/planning-plans-review-sweep"
GAPS_PROJECT_BIN="$ROOT/ops/plugins/core/lifecycle/bin/gaps-authority-bridge"

MODE="check"
JSON_MODE=0
MAX_ATTEMPTS=3

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --check) MODE="check"; shift ;;
    --fix) MODE="fix"; shift ;;
    --json) JSON_MODE=1; shift ;;
    --max-attempts) MAX_ATTEMPTS="${2:-3}"; shift 2 ;;
    -h|--help)
      cat <<'EOF'
Usage: state-shared-reconcile [--check|--fix] [--json] [--max-attempts N]

--check: run integrity + parity checks only.
--fix:   run self-healing reconcile loop with DB snapshot rollback on failure.
EOF
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ "$MAX_ATTEMPTS" =~ ^[0-9]+$ ]] || { echo "FAIL: --max-attempts must be integer" >&2; exit 2; }

DB_PATH="${PLANS_DB_PATH:-$SPINE_STATE/shared_authority.db}"
SNAPSHOT_DIR="$SPINE_STATE/plans/_snapshots"
mkdir -p "$SNAPSHOT_DIR"

file_sha256() {
  local path="${1:-}"
  [[ -n "$path" && -f "$path" ]] || return 1
  sha256sum "$path" 2>/dev/null | awk '{print $1}' || return 1
}

restore_snapshot_if_unchanged() {
  local db_path="${1:-}"
  local snapshot_path="${2:-}"
  local snapshot_hash="${3:-}"
  [[ -n "$db_path" && -n "$snapshot_path" && -n "$snapshot_hash" ]] || return 1
  python3 - "$db_path" "$snapshot_path" "$snapshot_hash" <<'PY'
import fcntl
import hashlib
import os
import shutil
import sys
import tempfile

db_path = sys.argv[1]
snapshot_path = sys.argv[2]
snapshot_hash = sys.argv[3]
lock_path = db_path + ".lock"

def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

if not os.path.exists(db_path) or not os.path.exists(snapshot_path):
    print("skip_missing")
    sys.exit(1)

lock_dir = os.path.dirname(lock_path) or "."
os.makedirs(lock_dir, exist_ok=True)
fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
try:
    fcntl.flock(fd, fcntl.LOCK_EX)
    current_hash = sha256_file(db_path)
    if current_hash != snapshot_hash:
        print("skip_changed")
        sys.exit(1)

    db_dir = os.path.dirname(db_path) or "."
    fd_tmp = None
    tmp_path = None
    try:
      fd_tmp, tmp_path = tempfile.mkstemp(prefix=".shared-authority-restore-", suffix=".db", dir=db_dir)
      with os.fdopen(fd_tmp, "wb") as dst, open(snapshot_path, "rb") as src:
          shutil.copyfileobj(src, dst)
          dst.flush()
          os.fsync(dst.fileno())
      fd_tmp = None
      os.replace(tmp_path, db_path)
      tmp_path = None
    finally:
      if fd_tmp is not None:
        try:
          os.close(fd_tmp)
        except OSError:
          pass
      if tmp_path is not None:
        try:
          os.unlink(tmp_path)
        except FileNotFoundError:
          pass
    print("restored")
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
PY
}

integrity_json="$(python3 - "$ROOT" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
sys.path.insert(0, str(root / "ops/plugins/core/lifecycle/lib"))
from plans_sql_authority import bootstrap_from_index_if_needed, connect, ensure_schema, integrity_check, resolve_paths  # type: ignore

_db_path, index_path, _plans_dir = resolve_paths(root)
conn = connect(_db_path)
ensure_schema(conn)
bootstrap_from_index_if_needed(conn, index_path)
ok, msg = integrity_check(conn)
print(json.dumps({"ok": bool(ok), "message": msg, "db": str(_db_path)}))
PY
)"

integrity_ok="$(jq -r '.ok' <<<"$integrity_json")"
integrity_msg="$(jq -r '.message' <<<"$integrity_json")"

if [[ "$integrity_ok" != "true" ]]; then
  if [[ "$JSON_MODE" -eq 1 ]]; then
    jq -n --arg capability "state.shared.reconcile" --arg mode "$MODE" --arg msg "$integrity_msg" \
      '{capability:$capability, mode:$mode, status:"failed", sqlite_integrity_ok:false, error:$msg}'
  else
    echo "state.shared.reconcile"
    echo "mode: $MODE"
    echo "status: failed"
    echo "sqlite_integrity_ok: false"
    echo "error: $integrity_msg"
  fi
  exit 1
fi

snapshot_file=""
snapshot_file_hash=""
if [[ "$MODE" == "fix" && -f "$DB_PATH" ]]; then
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  snapshot_file="$SNAPSHOT_DIR/shared_authority.${ts}.db"
  # Acquire shared lock on DB during snapshot to prevent capturing a mid-write state.
  python3 -c "
import fcntl, shutil, sys, os
db_path, snap_path = sys.argv[1], sys.argv[2]
lock_path = db_path + '.lock'
os.makedirs(os.path.dirname(lock_path) or '.', exist_ok=True)
fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
try:
    fcntl.flock(fd, fcntl.LOCK_SH)
    shutil.copy2(db_path, snap_path)
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
" "$DB_PATH" "$snapshot_file"
  snapshot_file_hash="$(file_sha256 "$snapshot_file" || true)"
fi

attempt=0
fix_rc=0
check_rc=0
fix_payload="{}"
check_payload="{}"
converged=0

run_reconcile() {
  local submode="$1"
  set +e
  local out
  out="$($RECONCILE_BIN --"$submode" --json 2>/dev/null)"
  local rc=$?
  set -e
  printf '%s\n%s' "$rc" "$out"
}

if [[ "$MODE" == "check" ]]; then
  result="$(run_reconcile check)"
  check_rc="$(head -n 1 <<<"$result")"
  check_payload="$(tail -n +2 <<<"$result")"
  if [[ "$check_rc" -eq 0 ]]; then
    converged=1
  fi
else
  while (( attempt < MAX_ATTEMPTS )); do
    attempt=$((attempt + 1))

    fix_result="$(run_reconcile fix)"
    fix_rc="$(head -n 1 <<<"$fix_result")"
    fix_payload="$(tail -n +2 <<<"$fix_result")"
    if [[ "$fix_rc" -ne 0 ]]; then
      if [[ -n "$snapshot_file" && -f "$snapshot_file" ]]; then
        if restore_snapshot_if_unchanged "$DB_PATH" "$snapshot_file" "$snapshot_file_hash"; then
          :
        else
          echo "WARN: Skipping snapshot restore because shared authority DB changed during reconcile" >&2
        fi
      fi
      break
    fi

    check_result="$(run_reconcile check)"
    check_rc="$(head -n 1 <<<"$check_result")"
    check_payload="$(tail -n +2 <<<"$check_result")"
    if [[ "$check_rc" -eq 0 ]]; then
      converged=1
      break
    fi
  done
fi

# Always refresh due-review artifact on successful convergence.
review_rc=0
review_payload="{}"
if [[ "$converged" -eq 1 ]]; then
  set +e
  review_payload="$($REVIEW_SWEEP_BIN --json --write-artifact 2>/dev/null)"
  review_rc=$?
  set -e
fi

gaps_project_rc=0
gaps_project_payload="{}"
if [[ "$MODE" == "fix" && "$converged" -eq 1 ]]; then
  set +e
  gaps_project_payload="$($GAPS_PROJECT_BIN project 2>/dev/null)"
  gaps_project_rc=$?
  set -e
fi

status="done"
if [[ "$converged" -ne 1 || "$review_rc" -ne 0 || "$gaps_project_rc" -ne 0 ]]; then
  status="failed"
fi

normalize_json_payload() {
  local raw="$1"
  if [[ -z "$raw" ]]; then
    printf '{}'
    return 0
  fi
  if jq -e . >/dev/null 2>&1 <<<"$raw"; then
    printf '%s' "$raw"
  else
    printf '{}'
  fi
}

fix_payload="$(normalize_json_payload "${fix_payload:-}")"
check_payload="$(normalize_json_payload "${check_payload:-}")"
review_payload="$(normalize_json_payload "${review_payload:-}")"
gaps_project_payload="$(normalize_json_payload "${gaps_project_payload:-}")"

if [[ "$JSON_MODE" -eq 1 ]]; then
  jq -n \
    --arg capability "state.shared.reconcile" \
    --arg mode "$MODE" \
    --arg status "$status" \
    --arg db "$DB_PATH" \
    --arg integrity_msg "$integrity_msg" \
    --arg snapshot_file "$snapshot_file" \
    --argjson converged "$converged" \
    --argjson attempts "$attempt" \
    --argjson fix_rc "$fix_rc" \
    --argjson check_rc "$check_rc" \
    --argjson review_rc "$review_rc" \
    --argjson gaps_project_rc "$gaps_project_rc" \
    --argjson fix_payload "$fix_payload" \
    --argjson check_payload "$check_payload" \
    --argjson review_payload "$review_payload" \
    --argjson gaps_project_payload "$gaps_project_payload" \
    '{
      capability:$capability,
      mode:$mode,
      status:$status,
      authority_db:$db,
      sqlite_integrity_ok:true,
      sqlite_integrity_message:$integrity_msg,
      snapshot_file: (if $snapshot_file == "" then null else $snapshot_file end),
      attempts:$attempts,
      converged: ($converged == 1),
      fix_rc:$fix_rc,
      check_rc:$check_rc,
      review_rc:$review_rc,
      gaps_project_rc:$gaps_project_rc,
      fix: $fix_payload,
      check: $check_payload,
      review_sweep: $review_payload,
      gaps_projection: $gaps_project_payload
    }'
else
  echo "state.shared.reconcile"
  echo "mode: $MODE"
  echo "status: $status"
  echo "authority_db: $DB_PATH"
  echo "sqlite_integrity_ok: true"
  echo "sqlite_integrity_message: $integrity_msg"
  [[ -n "$snapshot_file" ]] && echo "snapshot_file: $snapshot_file"
  echo "attempts: $attempt"
  echo "converged: $converged"
  echo "fix_rc: $fix_rc"
  echo "check_rc: $check_rc"
  echo "review_rc: $review_rc"
  echo "gaps_project_rc: $gaps_project_rc"
fi

if [[ "$status" != "done" ]]; then
  exit 1
fi
