#!/usr/bin/env python3
"""Read-only controller-prompt packet status."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
WORKSPACE_ROOT = ROOT.parent
RUNTIME_ROOT = Path(os.environ.get("SPINE_RUNTIME_ROOT") or WORKSPACE_ROOT / ".runtime" / "spine")
STATE_ROOT = Path(os.environ.get("SPINE_STATE") or RUNTIME_ROOT / "state")
PACKET_FILENAME_GLOBS = ("CONTROLLER-PACKET-*.md", "MAILROOM-CONTROLLER-PACKET-*.md")
TERMINAL_STATUSES = {"closed", "retired"}


def _iter_packet_files(prompts_dir: Path):
    seen: set[Path] = set()
    for glob in PACKET_FILENAME_GLOBS:
        for path in sorted(prompts_dir.glob(glob)):
            if path in seen:
                continue
            seen.add(path)
            yield path


def _frontmatter(path: Path) -> dict[str, Any]:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}
    if not text.startswith("---"):
        return {}
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}
    try:
        payload = yaml.safe_load(parts[1])
    except yaml.YAMLError:
        return {}
    return payload if isinstance(payload, dict) else {}


def _packet_row(path: Path, fm: dict[str, Any]) -> dict[str, Any]:
    evidence_refs = fm.get("evidence_refs")
    if not isinstance(evidence_refs, list):
        evidence_refs = []
    return {
        "packet_id": str(fm.get("packet_id") or "").strip(),
        "status": str(fm.get("status") or "unknown").strip().lower(),
        "loop_id": str(fm.get("loop_id") or "").strip(),
        "owner": str(fm.get("owner") or "").strip(),
        "created": str(fm.get("created") or "").strip(),
        "concern": str(fm.get("concern") or "").strip(),
        "mutation_permitted": bool(fm.get("mutation_permitted")),
        "continuity_summary": str(fm.get("continuity_summary") or "").strip(),
        "next_action": str(fm.get("next_action") or "").strip(),
        "evidence_ref_count": len(evidence_refs),
        "disposition": str(fm.get("disposition") or fm.get("close_disposition") or "").strip(),
        "closed_at": str(fm.get("closed_at") or fm.get("closed_at_utc") or "").strip(),
        "path": str(path),
    }


def collect(
    *,
    packet_id: str = "",
    loop_id: str = "",
    statuses: list[str] | None = None,
    include_terminal: bool = False,
    limit: int = 20,
) -> dict[str, Any]:
    prompts_dir = STATE_ROOT / "controller-prompts"
    status_filter = {str(item).strip().lower() for item in (statuses or []) if str(item).strip()}
    rows: list[dict[str, Any]] = []
    total_seen = 0
    if prompts_dir.is_dir():
        for path in _iter_packet_files(prompts_dir):
            fm = _frontmatter(path)
            if not fm:
                continue
            row = _packet_row(path, fm)
            if not row["packet_id"]:
                continue
            total_seen += 1
            if packet_id and row["packet_id"] != packet_id:
                continue
            if loop_id and row["loop_id"] != loop_id:
                continue
            if status_filter and row["status"] not in status_filter:
                continue
            if not packet_id and not loop_id and not status_filter and not include_terminal and row["status"] in TERMINAL_STATUSES:
                continue
            rows.append(row)

    status_rank = {"draft": 0, "active": 1, "open": 2, "blocked": 3, "unknown": 4, "closed": 8, "retired": 9}
    rows.sort(key=lambda row: (status_rank.get(row["status"], 5), str(row.get("created") or ""), str(row.get("packet_id") or "")))
    bounded = rows[: max(0, limit)]
    exact_missing = bool(packet_id and not rows)
    return {
        "capability": "controller_prompt.status",
        "state_root": str(STATE_ROOT),
        "controller_prompts_dir": str(prompts_dir),
        "filters": {
            "packet_id": packet_id,
            "loop_id": loop_id,
            "status": sorted(status_filter),
            "include_terminal": include_terminal,
            "limit": max(0, limit),
        },
        "summary": {
            "total_packets_seen": total_seen,
            "matching_packets": len(rows),
            "open_packets": sum(1 for row in rows if row["status"] not in TERMINAL_STATUSES),
            "terminal_packets": sum(1 for row in rows if row["status"] in TERMINAL_STATUSES),
            "omitted_packets": max(0, len(rows) - len(bounded)),
            "exact_missing": exact_missing,
        },
        "packets": bounded,
        "drilldown": "Use --packet-id PACKET-NN-SLUG for exact state, --loop-id LOOP-ID for loop packets, or --all for terminal history.",
    }


def render_human(data: dict[str, Any]) -> None:
    summary = data.get("summary") if isinstance(data.get("summary"), dict) else {}
    filters = data.get("filters") if isinstance(data.get("filters"), dict) else {}
    print("controller_prompt.status")
    print()
    print(f"  matching packets:  {summary.get('matching_packets', 0)}")
    print(f"  open packets:      {summary.get('open_packets', 0)}")
    print(f"  terminal packets:  {summary.get('terminal_packets', 0)}")
    if summary.get("omitted_packets"):
        print(f"  omitted packets:   {summary.get('omitted_packets')}")
    if filters.get("packet_id"):
        print(f"  packet filter:     {filters.get('packet_id')}")
    if filters.get("loop_id"):
        print(f"  loop filter:       {filters.get('loop_id')}")
    print()
    packets = data.get("packets") if isinstance(data.get("packets"), list) else []
    if not packets:
        print("  no matching controller-prompt packets")
        return
    print(f"{'STATUS':10s} {'PACKET':42s} LOOP")
    print("-" * 96)
    for row in packets:
        packet = str(row.get("packet_id") or "")[:42]
        loop = str(row.get("loop_id") or "")
        print(f"{str(row.get('status') or '')[:10]:10s} {packet:42s} {loop}")
        concern = str(row.get("concern") or "")
        if concern:
            print(f"  concern: {concern[:120]}")
        next_action = str(row.get("next_action") or "")
        if next_action:
            print(f"  next:    {next_action[:120]}")
        print(f"  path:    {row.get('path')}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only controller-prompt packet status.")
    parser.add_argument("--packet-id", default="", help="Exact packet id, e.g. PACKET-1297-ROUTINE-TELEMETRY-SUBTRACTION")
    parser.add_argument("--loop-id", default="", help="Filter packets by loop id")
    parser.add_argument("--status", action="append", default=[], help="Filter by packet status; repeatable")
    parser.add_argument("--all", action="store_true", help="Include terminal packets when no exact filter is supplied")
    parser.add_argument("--limit", type=int, default=20, help="Maximum packet rows to emit")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    parser.add_argument("--self-check", action="store_true", help="Verify imports and exit")
    args = parser.parse_args()

    if args.self_check:
        if not isinstance(PACKET_FILENAME_GLOBS, tuple) or not PACKET_FILENAME_GLOBS:
            print("controller_prompt.status self-check FAIL: packet globs missing", file=sys.stderr)
            return 1
        print("controller_prompt.status self-check PASS")
        return 0

    data = collect(
        packet_id=args.packet_id.strip(),
        loop_id=args.loop_id.strip(),
        statuses=args.status,
        include_terminal=args.all,
        limit=args.limit,
    )
    if data["summary"].get("exact_missing"):
        if args.json:
            print(json.dumps({"status": "error", "error": f"packet not found: {args.packet_id}", **data}, indent=2, sort_keys=True))
        else:
            render_human(data)
            print(f"ERROR: packet not found: {args.packet_id}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        render_human(data)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
