#!/usr/bin/env python3
# Authority: shared_authority.db -> friction table
# NDJSON write: projection only -- remove after full migration
from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
import yaml

ROOT = Path(__file__).resolve().parents[5]
GAPS_DEDUPE = ROOT / "ops/plugins/core/loops/bin/gaps-dedupe"
GAPS_FILE = ROOT / "ops/plugins/core/loops/bin/gaps-file"
OP_GAPS_FILE = ROOT / "ops/bindings/operational.gaps.yaml"

# ── SQLite authority (conditional) ────────────────────────────────
sys.path.insert(0, str(ROOT / "ops/plugins/core/lifecycle/lib"))
try:
    from gaps_sql_authority import (
        resolve_paths as _gsa_resolve_paths,
        connect as _gsa_connect,
        ensure_schema as _gsa_ensure_schema,
        get_gap as _gsa_get_gap,
    )
    from gaps_sql_authority import (
        ensure_friction_schema,
        upsert_friction,
        fetch_friction_by_status,
        fetch_all_friction,
    )
    SQLITE_AVAILABLE = True
except ImportError:
    SQLITE_AVAILABLE = False


def _sqlite_conn():
    """Open and return a ready SQLite connection, or None if unavailable."""
    if not SQLITE_AVAILABLE:
        return None
    try:
        db_path, _ = _gsa_resolve_paths(ROOT)
        conn = _gsa_connect(db_path)
        _gsa_ensure_schema(conn)
        ensure_friction_schema(conn)
        return conn
    except Exception:
        return None


def default_state_root() -> Path:
    override = os.environ.get("SPINE_STATE", "").strip()
    if override:
        return Path(override).expanduser()
    contract = ROOT / "ops/bindings/mailroom.runtime.contract.yaml"
    if contract.exists():
        try:
            doc = yaml.safe_load(contract.read_text(encoding="utf-8")) or {}
            runtime_root_raw = str(doc.get("runtime_root") or "").strip()
            if runtime_root_raw:
                runtime_root = Path(os.path.expanduser(runtime_root_raw))
                if not runtime_root.is_absolute():
                    runtime_root = (ROOT / runtime_root).resolve()
                return runtime_root / "state"
        except Exception:
            pass
    return (ROOT.parent / ".runtime/spine/state").resolve()


DEFAULT_STATE_ROOT = default_state_root()
DEFAULT_QUEUE = DEFAULT_STATE_ROOT / "friction-queue.ndjson"
DEFAULT_LOCK = DEFAULT_STATE_ROOT / "locks/friction-queue.lock"


def utc_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_queue(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    rows: list[dict[str, Any]] = []
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            rows.append(obj)
    return rows


def write_queue(path: Path, rows: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, sort_keys=True))
            fh.write("\n")


@contextmanager
def queue_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def build_description(item: dict[str, Any]) -> str:
    return "\n".join(
        [
            "Agent friction intake item:",
            f"friction_id: {item.get('friction_id', '')}",
            f"capability: {item.get('capability', '')}",
            f"expected: {item.get('expected', '')}",
            f"actual: {item.get('actual', '')}",
            f"severity: {item.get('severity', 'medium')}",
            f"fingerprint: {item.get('fingerprint', '')}",
            f"first_seen_utc: {item.get('first_seen_utc', '')}",
            f"hit_count: {item.get('hit_count', 1)}",
        ]
    )


def yaml_quote(value: str) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def build_batch_yaml(items: list[dict[str, Any]]) -> str:
    lines = ["gaps:"]
    for item in items:
        lines.append("  - id: auto")
        lines.append(f"    type: {item['type']}")
        lines.append(f"    severity: {item['severity']}")
        lines.append(f"    discovered_by: {yaml_quote(str(item['discovered_by']))}")
        lines.append(f"    doc: {yaml_quote(str(item['doc']))}")
        lines.append("    description: |")
        for row in str(item["description"]).splitlines() or [""]:
            lines.append(f"      {row}")
    return "\n".join(lines) + "\n"


def run_json(cmd: list[str]) -> dict[str, Any]:
    proc = subprocess.run(cmd, cwd=str(ROOT), text=True, capture_output=True, check=False)
    text = (proc.stdout or "").strip() or (proc.stderr or "").strip()
    if not text:
        return {}
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return {}


def find_open_gap_by_exact_marker(marker: str) -> str:
    m = str(marker or "").strip()
    if not m:
        return ""
    m_escaped = m.replace("\\", "\\\\").replace('"', '\\"')
    proc = subprocess.run(
        [
            "yq",
            "e",
            "-r",
            f'.gaps[] | select(.status == "open") | select((.description // "") | contains("{m_escaped}")) | .id',
            str(OP_GAPS_FILE),
        ],
        cwd=str(ROOT),
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        return ""
    for raw in (proc.stdout or "").splitlines():
        gid = raw.strip()
        if gid.startswith("GAP-OP-"):
            return gid
    return ""


def map_severity(value: str) -> str:
    sev = str(value or "").strip().lower()
    if sev in {"low", "medium", "high", "critical"}:
        return sev
    return "medium"


def main() -> int:
    # Strip whitespace-only args injected by shell backslash-continuations
    argv = [a for a in sys.argv[1:] if a.strip()]
    ap = argparse.ArgumentParser(description="Reconcile friction queue into existing gaps surfaces")
    ap.add_argument("--queue", default=str(DEFAULT_QUEUE))
    ap.add_argument("--lock-file", default=str(DEFAULT_LOCK))
    ap.add_argument("--loop-id", help="Parent loop ID (e.g. LOOP-EXAMPLE-20260303). Falls back to SPINE_LOOP_ID.")
    ap.add_argument("--dedupe-threshold", type=float, default=0.85)
    ap.add_argument("--lane-safe", action="store_true", help="Queue governed gap mutations instead of requiring direct git mutation in the current lane")
    ap.add_argument("--lane-safe-loop-id", help="Explicit parent loop for lane-safe gap requests (falls back to --loop-id/SPINE_LOOP_ID)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    loop_id = str(args.loop_id or os.environ.get("SPINE_LOOP_ID", "")).strip()
    if not loop_id:
        raise SystemExit("friction.reconcile FAIL: --loop-id required (or set SPINE_LOOP_ID)")

    if not GAPS_DEDUPE.exists() or not GAPS_FILE.exists():
        raise SystemExit("friction.reconcile FAIL: required gaps scripts missing")
    if not OP_GAPS_FILE.exists():
        raise SystemExit(f"friction.reconcile FAIL: missing gaps registry: {OP_GAPS_FILE}")

    queue_path = Path(args.queue).expanduser()
    lock_path = Path(args.lock_file).expanduser()

    # Open SQLite if available — used for reading queued items and writing status updates.
    sqlite_conn = _sqlite_conn()

    with queue_lock(lock_path):
        rows = load_queue(queue_path)
        now = utc_iso()

        # ── Source queued items: SQLite-first, NDJSON fallback ──
        queued_items = [r for r in rows if str(r.get("status", "queued")).strip().lower() == "queued"]

        matched_count = 0
        filed_count = 0
        filing_mode = "none"
        fallback_used = False
        pending_batch: list[dict[str, Any]] = []
        pending_indices: list[int] = []
        # Track friction items that need SQLite status updates
        sqlite_status_updates: list[dict[str, Any]] = []

        for idx, item in enumerate(rows):
            status = str(item.get("status", "queued")).strip().lower()
            if status != "queued":
                continue

            # Exact marker match first (fingerprint/friction_id), then fuzzy dedupe.
            exact_gap_id = ""
            fingerprint = str(item.get("fingerprint", "")).strip()
            friction_id = str(item.get("friction_id", "")).strip()
            if fingerprint:
                exact_gap_id = find_open_gap_by_exact_marker(f"fingerprint: {fingerprint}")
            if not exact_gap_id and friction_id:
                exact_gap_id = find_open_gap_by_exact_marker(f"friction_id: {friction_id}")
            if exact_gap_id:
                item["status"] = "matched"
                item["matched_gap_id"] = exact_gap_id
                item["matched_at_utc"] = now
                item["updated_at_utc"] = now
                sqlite_status_updates.append(item)
                matched_count += 1
                continue

            desc = build_description(item)
            dedupe = run_json(
                [
                    str(GAPS_DEDUPE),
                    "--description",
                    desc,
                    "--threshold",
                    str(args.dedupe_threshold),
                    "--status",
                    "open",
                    "--json",
                ]
            )
            matches = dedupe.get("matches", []) if isinstance(dedupe, dict) else []

            if matches:
                top = matches[0]
                gap_id = str(top.get("id", "")).strip()
                if gap_id:
                    item["status"] = "matched"
                    item["matched_gap_id"] = gap_id
                    item["matched_at_utc"] = now
                    item["updated_at_utc"] = now
                    sqlite_status_updates.append(item)
                    matched_count += 1
                    continue

            pending_batch.append(
                {
                    "id": "auto",
                    "type": "agent-behavior",
                    "severity": map_severity(str(item.get("severity", "medium"))),
                    "discovered_by": loop_id,
                    "doc": "mailroom/state/friction-queue.ndjson",
                    "description": desc,
                }
            )
            pending_indices.append(idx)

        filed_ids: list[str] = []
        filed_request_paths: list[str] = []
        skipped_duplicate_ids: list[str] = []
        if pending_batch and not args.dry_run:
            with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False, encoding="utf-8") as tmp:
                tmp.write(build_batch_yaml(pending_batch))
                tmp_path = Path(tmp.name)
            direct_cmd = [str(GAPS_FILE), "--batch", str(tmp_path), "--loop-id", loop_id]
            lane_safe_loop_id = str(args.lane_safe_loop_id or loop_id).strip()
            lane_safe_cmd = direct_cmd + ["--lane-safe", "--lane-safe-loop-id", lane_safe_loop_id]

            proc = subprocess.run(
                lane_safe_cmd if args.lane_safe else direct_cmd,
                cwd=str(ROOT),
                text=True,
                capture_output=True,
                check=False,
            )
            output = (proc.stdout or "") + "\n" + (proc.stderr or "")

            if proc.returncode != 0 and not args.lane_safe:
                fallback_used = True
                proc = subprocess.run(
                    lane_safe_cmd,
                    cwd=str(ROOT),
                    text=True,
                    capture_output=True,
                    check=False,
                )
                output = (proc.stdout or "") + "\n" + (proc.stderr or "")

            tmp_path.unlink(missing_ok=True)

            for line in output.splitlines():
                line = line.strip()
                if line.startswith("FILED:"):
                    filed_ids.append(line.split(":", 1)[1].strip())
                elif line.startswith("SKIPPED_DUPLICATE:"):
                    skipped_duplicate_ids.append(line.split(":", 1)[1].strip())
                elif "LANE_SAFE_QUEUED:" in line:
                    filed_request_paths.append(line.split("LANE_SAFE_QUEUED:", 1)[1].strip())

            if proc.returncode != 0:
                raise SystemExit(f"friction.reconcile FAIL: gaps.file batch failed\n{output.strip()}")

            if filed_request_paths:
                filing_mode = "lane_safe_request"
            elif filed_ids:
                filing_mode = "direct"

        if args.dry_run:
            filed_count = len(pending_batch)
        else:
            if filed_ids:
                filed_count = min(len(pending_indices), len(filed_ids))
            elif filed_request_paths:
                filed_count = len(pending_indices)
            else:
                filed_count = 0
            matched_from_idempotent_skip = 0
            if filed_ids:
                for pos, gap_id in enumerate(filed_ids[: len(pending_indices)]):
                    row_index = pending_indices[pos]
                    rows[row_index]["status"] = "filed"
                    rows[row_index]["filing_mode"] = "direct"
                    rows[row_index]["filed_gap_id"] = gap_id
                    rows[row_index]["filed_at_utc"] = now
                    rows[row_index]["updated_at_utc"] = now
                    sqlite_status_updates.append(rows[row_index])
            else:
                request_path = filed_request_paths[0] if filed_request_paths else ""
                for row_index in pending_indices:
                    rows[row_index]["status"] = "filed"
                    rows[row_index]["filing_mode"] = "lane_safe_request"
                    rows[row_index]["filed_request_path"] = request_path
                    rows[row_index]["filed_at_utc"] = now
                    rows[row_index]["updated_at_utc"] = now
                    sqlite_status_updates.append(rows[row_index])
            # gaps-file can idempotently skip semantically-equivalent open gaps.
            # Treat these as matched so queue entries don't remain permanently queued.
            offset = filed_count
            for pos, gap_id in enumerate(skipped_duplicate_ids[: max(0, len(pending_indices) - offset)]):
                row_index = pending_indices[offset + pos]
                rows[row_index]["status"] = "matched"
                rows[row_index]["matched_gap_id"] = gap_id
                rows[row_index]["matched_at_utc"] = now
                rows[row_index]["updated_at_utc"] = now
                sqlite_status_updates.append(rows[row_index])
                matched_from_idempotent_skip += 1
            matched_count += matched_from_idempotent_skip

        # ── Write status updates to SQLite authority ──
        if sqlite_conn and not args.dry_run:
            for updated_item in sqlite_status_updates:
                upsert_friction(sqlite_conn, updated_item)
            sqlite_conn.commit()

        if not args.dry_run:
            # NDJSON write: projection only -- remove after full migration
            write_queue(queue_path, rows)

    authority = "sqlite" if sqlite_conn else "ndjson"
    if sqlite_conn:
        sqlite_conn.close()

    payload = {
        "capability": "friction.reconcile",
        "status": "ok",
        "authority": authority,
        "queue": str(queue_path),
        "loop_id": loop_id,
        "queued_before": len(queued_items),
        "matched": matched_count,
        "filed": filed_count,
        "filing_mode": filing_mode,
        "fallback_used": fallback_used,
        "dry_run": args.dry_run,
        "filed_gap_ids": filed_ids,
        "filed_request_paths": filed_request_paths,
    }

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("friction.reconcile")
        print(f"authority: {authority}")
        print("status: ok")
        print(f"queue: {queue_path}")
        print(f"loop_id: {args.loop_id}")
        print(f"queued_before: {len(queued_items)}")
        print(f"matched: {matched_count}")
        print(f"filed: {filed_count}")
        print(f"filing_mode: {filing_mode}")
        print(f"fallback_used: {str(fallback_used).lower()}")
        print(f"dry_run: {str(args.dry_run).lower()}")
        if filed_ids:
            print("filed_gap_ids:")
            for gid in filed_ids:
                print(f"  - {gid}")
        if filed_request_paths:
            print("filed_request_paths:")
            for path in filed_request_paths:
                print(f"  - {path}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
