#!/usr/bin/env bash
set -euo pipefail

CONTROL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
TARGET_ROOT="${SPINE_TARGET_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "${SPINE_REPO:-$PWD}")}"
export SPINE_CODE="${SPINE_CODE:-$CONTROL_ROOT}"
export SPINE_REPO="$TARGET_ROOT"
source "$CONTROL_ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
CONTRACT="$CONTROL_ROOT/ops/bindings/worktree.lifecycle.contract.yaml"
DISPOSITION_CONTRACT="$CONTROL_ROOT/ops/bindings/closeout.disposition.contract.yaml"
HANDOFF_CONFIG="$CONTROL_ROOT/ops/bindings/handoff.config.yaml"

MODE="report"
JSON_MODE=0
BRIEF_MODE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --json) JSON_MODE=1; shift ;;
    --gate) MODE="gate"; shift ;;
    --lane) MODE="lane"; shift ;;
    --brief) BRIEF_MODE=1; shift ;;
    -h|--help)
      cat <<'USAGE'
worktree-lifecycle-reconcile

Usage:
  worktree-lifecycle-reconcile [--json] [--brief]
  worktree-lifecycle-reconcile --gate [--brief]
  worktree-lifecycle-reconcile --lane [--brief]

Notes:
  - Read-only classifier for worktree lifecycle hygiene.
  - --gate emits D48-style PASS/FAIL and exits non-zero on any lifecycle issue (controller/global).
  - --lane emits D48-style PASS/FAIL and exits non-zero only on current-lane issues (worker commit).
USAGE
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

MAIN_BRANCH="main"
CANONICAL_WORKTREE_ROOT="${SPINE_WORKTREE_LIFECYCLE_WORKTREE_ROOT:-$SPINE_TMP/worktrees}"
CANONICAL_TEMP_CLONE_ROOT="${SPINE_WORKTREE_LIFECYCLE_TEMP_CLONE_ROOT:-$SPINE_TMP/clones}"
MANAGED_WORKTREE_PATHS_CSV="${SPINE_WORKTREE_LIFECYCLE_MANAGED_WORKTREE_PATHS:-}"
LEASE_FILENAME=".spine-lane-lease.yaml"
LEASE_TTL_HOURS="24"
PREFIX_CSV="codex/,orchestration/"
MERGED_GRACE_HOURS="24"
CLOSED_OWNER_GRACE_HOURS="6"
UNOWNED_LOCAL_GRACE_HOURS="168"
TEMP_CLONE_GRACE_HOURS="24"
MAIN_STASH_WARN_HOURS="${SPINE_WORKTREE_LIFECYCLE_MAIN_STASH_WARN_HOURS:-24}"
MAIN_STASH_FAIL_HOURS="${SPINE_WORKTREE_LIFECYCLE_MAIN_STASH_FAIL_HOURS:-72}"
FAIL_ON_DETACHED="true"
FAIL_ON_DIRTY_CLOSED="true"
WARN_ON_DIRTY_ACTIVE="true"
FAIL_ON_DIRTY_TEMP_CLONE="true"
FAIL_ON_MISSING_TEMP_CLONE_ORIGIN="true"
FAIL_ON_ROOT_NON_MAIN="true"
FAIL_ON_ROOT_DIRTY="true"
WAVES_DIR="$SPINE_STATE/waves"
LOOPS_SCOPE_DIR="$SPINE_STATE/loop-scopes"
HANDOFFS_DIR="$SPINE_STATE/handoffs"
ALLOWED_DISPOSITIONS_CSV="landed,deferred,superseded,abandoned"
FAIL_ON_CLOSED_OWNER_MISSING_DISPOSITION="true"
FAIL_ON_CLOSED_OWNER_INVALID_DISPOSITION="true"

if [[ -f "$CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
  MAIN_BRANCH="$(yq e -r '.policy.main_branch // "main"' "$CONTRACT" 2>/dev/null || echo main)"
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_WORKTREE_ROOT:-}" ]]; then
    CANONICAL_WORKTREE_ROOT="$(yq e -r '.policy.canonical_worktree_root // ""' "$CONTRACT" 2>/dev/null || echo "$CANONICAL_WORKTREE_ROOT")"
    [[ -n "$CANONICAL_WORKTREE_ROOT" && "$CANONICAL_WORKTREE_ROOT" != "null" ]] || CANONICAL_WORKTREE_ROOT="$SPINE_TMP/worktrees"
  fi
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_TEMP_CLONE_ROOT:-}" ]]; then
    CANONICAL_TEMP_CLONE_ROOT="$(yq e -r '.policy.canonical_temp_clone_root // ""' "$CONTRACT" 2>/dev/null || echo "$CANONICAL_TEMP_CLONE_ROOT")"
    [[ -n "$CANONICAL_TEMP_CLONE_ROOT" && "$CANONICAL_TEMP_CLONE_ROOT" != "null" ]] || CANONICAL_TEMP_CLONE_ROOT="$SPINE_TMP/clones"
  fi
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_MANAGED_WORKTREE_PATHS:-}" ]]; then
    managed_paths_accum=""
    while IFS= read -r managed_path; do
      [[ -n "$managed_path" && "$managed_path" != "null" ]] || continue
      if [[ -n "$managed_paths_accum" ]]; then
        managed_paths_accum+=",${managed_path}"
      else
        managed_paths_accum="$managed_path"
      fi
    done < <(yq e -r '.policy.managed_worktree_paths[]?' "$CONTRACT" 2>/dev/null || true)
    if [[ -n "$managed_paths_accum" ]]; then
      MANAGED_WORKTREE_PATHS_CSV="$managed_paths_accum"
    fi
  fi
  LEASE_FILENAME="$(yq e -r '.policy.lease_filename // ".spine-lane-lease.yaml"' "$CONTRACT" 2>/dev/null || echo "$LEASE_FILENAME")"
  LEASE_TTL_HOURS="$(yq e -r '.policy.lease_ttl_hours_default // 24' "$CONTRACT" 2>/dev/null || echo 24)"
  MERGED_GRACE_HOURS="$(yq e -r '.policy.merged_branch_grace_hours // 24' "$CONTRACT" 2>/dev/null || echo 24)"
  CLOSED_OWNER_GRACE_HOURS="$(yq e -r '.policy.closed_owner_grace_hours // 6' "$CONTRACT" 2>/dev/null || echo 6)"
  UNOWNED_LOCAL_GRACE_HOURS="$(yq e -r '.policy.unowned_local_branch_grace_hours // 168' "$CONTRACT" 2>/dev/null || echo 168)"
  TEMP_CLONE_GRACE_HOURS="$(yq e -r '.policy.temp_clone_grace_hours // 24' "$CONTRACT" 2>/dev/null || echo 24)"
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_MAIN_STASH_WARN_HOURS:-}" ]]; then
    MAIN_STASH_WARN_HOURS="$(yq e -r '.policy.main_stash_warn_hours // 24' "$CONTRACT" 2>/dev/null || echo 24)"
  fi
  if [[ -z "${SPINE_WORKTREE_LIFECYCLE_MAIN_STASH_FAIL_HOURS:-}" ]]; then
    MAIN_STASH_FAIL_HOURS="$(yq e -r '.policy.main_stash_fail_hours // 72' "$CONTRACT" 2>/dev/null || echo 72)"
  fi
  FAIL_ON_DETACHED="$(yq e -r '.policy.fail_on_detached_head // true' "$CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_DIRTY_CLOSED="$(yq e -r '.policy.fail_on_dirty_when_owner_closed // true' "$CONTRACT" 2>/dev/null || echo true)"
  WARN_ON_DIRTY_ACTIVE="$(yq e -r '.policy.warn_on_dirty_when_owner_active // true' "$CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_DIRTY_TEMP_CLONE="$(yq e -r '.policy.fail_on_dirty_temp_clone // true' "$CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_MISSING_TEMP_CLONE_ORIGIN="$(yq e -r '.policy.fail_on_missing_temp_clone_origin // true' "$CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_ROOT_NON_MAIN="$(yq e -r '.policy.fail_on_root_non_main // true' "$CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_ROOT_DIRTY="$(yq e -r '.policy.fail_on_root_dirty // true' "$CONTRACT" 2>/dev/null || echo true)"
  if [[ -z "${SPINE_STATE:-}" ]]; then
    WAVES_DIR="$(yq e -r '.runtime.waves_state_dir // ""' "$CONTRACT" 2>/dev/null || echo "$WAVES_DIR")"
    [[ -n "$WAVES_DIR" && "$WAVES_DIR" != "null" ]] || WAVES_DIR="$SPINE_STATE/waves"
    LOOPS_SCOPE_DIR="$(yq e -r '.runtime.loops_scope_dir // ""' "$CONTRACT" 2>/dev/null || echo "$LOOPS_SCOPE_DIR")"
    [[ -n "$LOOPS_SCOPE_DIR" && "$LOOPS_SCOPE_DIR" != "null" ]] || LOOPS_SCOPE_DIR="$SPINE_STATE/loop-scopes"
  fi

  prefix_accum=""
  while IFS= read -r prefix; do
    [[ -n "$prefix" && "$prefix" != "null" ]] || continue
    if [[ -n "$prefix_accum" ]]; then
      prefix_accum+=" ,${prefix}"
    else
      prefix_accum="$prefix"
    fi
  done < <(yq e -r '.policy.local_branch_prefixes_allow_no_remote[]?' "$CONTRACT" 2>/dev/null || true)
  if [[ -n "$prefix_accum" ]]; then
    PREFIX_CSV="${prefix_accum// ,/,}"
  fi
fi

if [[ -f "$DISPOSITION_CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
  disposition_accum=""
  while IFS= read -r disposition; do
    [[ -n "$disposition" && "$disposition" != "null" ]] || continue
    if [[ -n "$disposition_accum" ]]; then
      disposition_accum+=",$disposition"
    else
      disposition_accum="$disposition"
    fi
  done < <(yq e -r '.terminal_dispositions.allowed[]?' "$DISPOSITION_CONTRACT" 2>/dev/null || true)
  [[ -n "$disposition_accum" ]] && ALLOWED_DISPOSITIONS_CSV="$disposition_accum"
  FAIL_ON_CLOSED_OWNER_MISSING_DISPOSITION="$(yq e -r '.enforcement.fail_worktree_reconcile_when_closed_owner_missing_disposition // true' "$DISPOSITION_CONTRACT" 2>/dev/null || echo true)"
  FAIL_ON_CLOSED_OWNER_INVALID_DISPOSITION="$(yq e -r '.enforcement.fail_worktree_reconcile_when_closed_owner_invalid_disposition // true' "$DISPOSITION_CONTRACT" 2>/dev/null || echo true)"
fi

if [[ -f "$HANDOFF_CONFIG" ]] && command -v yq >/dev/null 2>&1; then
  handoff_dir_rel="$(yq e -r '.storage.directory // ""' "$HANDOFF_CONFIG" 2>/dev/null || true)"
  if [[ -n "$handoff_dir_rel" && "$handoff_dir_rel" != "null" ]]; then
    HANDOFFS_DIR="$(spine_resolve_mailroom_path "$handoff_dir_rel")"
  fi
fi

python3 - "$TARGET_ROOT" "$MAIN_BRANCH" "$CANONICAL_WORKTREE_ROOT" "$CANONICAL_TEMP_CLONE_ROOT" "$MANAGED_WORKTREE_PATHS_CSV" "$LEASE_FILENAME" "$LEASE_TTL_HOURS" "$PREFIX_CSV" "$MERGED_GRACE_HOURS" "$CLOSED_OWNER_GRACE_HOURS" "$UNOWNED_LOCAL_GRACE_HOURS" "$TEMP_CLONE_GRACE_HOURS" "$MAIN_STASH_WARN_HOURS" "$MAIN_STASH_FAIL_HOURS" "$FAIL_ON_DETACHED" "$FAIL_ON_DIRTY_CLOSED" "$WARN_ON_DIRTY_ACTIVE" "$FAIL_ON_DIRTY_TEMP_CLONE" "$FAIL_ON_MISSING_TEMP_CLONE_ORIGIN" "$FAIL_ON_ROOT_NON_MAIN" "$FAIL_ON_ROOT_DIRTY" "$WAVES_DIR" "$LOOPS_SCOPE_DIR" "$HANDOFFS_DIR" "$ALLOWED_DISPOSITIONS_CSV" "$FAIL_ON_CLOSED_OWNER_MISSING_DISPOSITION" "$FAIL_ON_CLOSED_OWNER_INVALID_DISPOSITION" "$MODE" "$JSON_MODE" "$BRIEF_MODE" <<'PY'
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
import yaml

root = Path(sys.argv[1]).resolve()
main_branch = sys.argv[2]
canonical_worktree_root = Path(os.path.expanduser(sys.argv[3])).resolve()
canonical_temp_clone_root = Path(os.path.expanduser(sys.argv[4])).resolve()
managed_worktree_paths = [Path(os.path.expanduser(p)).resolve() for p in sys.argv[5].split(",") if p]
lease_filename = sys.argv[6]
lease_ttl_h = float(sys.argv[7])
local_prefixes = [p for p in sys.argv[8].split(",") if p]
merged_grace_h = float(sys.argv[9])
closed_owner_grace_h = float(sys.argv[10])
unowned_local_grace_h = float(sys.argv[11])
temp_clone_grace_h = float(sys.argv[12])
main_stash_warn_h = float(sys.argv[13])
main_stash_fail_h = float(sys.argv[14])
fail_on_detached = sys.argv[15].lower() == "true"
fail_on_dirty_closed = sys.argv[16].lower() == "true"
warn_on_dirty_active = sys.argv[17].lower() == "true"
fail_on_dirty_temp_clone = sys.argv[18].lower() == "true"
fail_on_missing_temp_clone_origin = sys.argv[19].lower() == "true"
fail_on_root_non_main = sys.argv[20].lower() == "true"
fail_on_root_dirty = sys.argv[21].lower() == "true"
waves_dir = Path(os.path.expanduser(sys.argv[22]))
loops_scope_rel = sys.argv[23]
handoffs_dir = Path(os.path.expanduser(sys.argv[24]))
allowed_dispositions = {item.strip() for item in sys.argv[25].split(",") if item.strip()}
fail_on_closed_owner_missing_disposition = sys.argv[26].lower() == "true"
fail_on_closed_owner_invalid_disposition = sys.argv[27].lower() == "true"
mode = sys.argv[28]
json_mode = sys.argv[29] == "1"
brief_mode = sys.argv[30] == "1"

now_epoch = time.time()


def _clean_git_env():
    """Return env dict with GIT_DIR/GIT_WORK_TREE removed.

    When running inside a git hook, GIT_DIR is set to the current
    worktree's gitdir.  This leaks into any ``git -C <other-path>``
    call and forces git to resolve the *hook's* worktree instead of the
    target path.  Stripping these variables lets ``-C`` work correctly
    when inspecting foreign worktrees or the primary checkout.
    """
    env = os.environ.copy()
    env.pop("GIT_DIR", None)
    env.pop("GIT_WORK_TREE", None)
    env.pop("GIT_INDEX_FILE", None)
    return env


def sh(args, check=True, cwd=None):
    is_git = args and args[0] == "git"
    proc = subprocess.run(
        args, text=True, capture_output=True, cwd=cwd,
        env=_clean_git_env() if is_git else None,
    )
    if check and proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "command failed")
    return proc.returncode, proc.stdout


def parse_bool(value):
    return str(value).lower() in {"1", "true", "yes", "on"}


def parse_iso_epoch(value):
    if not value:
        return None
    text = str(value).strip()
    if not text:
        return None
    try:
        dt = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except Exception:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()


def parse_frontmatter(path: Path):
    data = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except Exception:
        return data
    if not lines or lines[0].strip() != "---":
        return data
    for line in lines[1:]:
        if line.strip() == "---":
            break
        if ":" not in line:
            continue
        key, val = line.split(":", 1)
        data[key.strip()] = val.strip().strip('"')
    return data


def parse_lease(path: Path):
    if not path.exists():
        return {"present": False}
    kv = {}
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return {"present": True, "path": str(path), "status": "unreadable", "active": False}
    for ln in text.splitlines():
        s = ln.strip()
        if not s or s == "---" or ":" not in s:
            continue
        k, v = s.split(":", 1)
        kv[k.strip()] = v.strip().strip('"')
    ttl = float(kv.get("ttl_hours") or lease_ttl_h)
    heartbeat_at = kv.get("heartbeat_at")
    age_h = None
    if heartbeat_at:
        parsed = parse_iso_epoch(heartbeat_at)
        if parsed is not None:
            age_h = max(0.0, (now_epoch - parsed) / 3600.0)
    status = (kv.get("status") or "").strip().lower() or "unknown"
    active = False
    if status in {"active", "running"}:
        if age_h is None:
            active = True
        else:
            active = age_h <= ttl
    return {
        "present": True,
        "path": str(path),
        "status": status,
        "owner": kv.get("owner"),
        "loop_or_wave_id": kv.get("loop_or_wave_id"),
        "heartbeat_at": heartbeat_at,
        "ttl_hours": ttl,
        "age_hours": age_h,
        "active": active,
    }


def load_yaml(path: Path):
    if not path.exists():
        return None
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def parse_worktrees(repo_root: Path):
    _, out = sh(["git", "-C", str(repo_root), "worktree", "list", "--porcelain"])
    entries = []
    current = {}
    for raw in out.splitlines():
        line = raw.strip()
        if not line:
            if current:
                entries.append(current)
                current = {}
            continue
        if " " not in line:
            continue
        key, value = line.split(" ", 1)
        current[key] = value.strip()
    if current:
        entries.append(current)

    parsed = []
    for entry in entries:
        wt = entry.get("worktree")
        if not wt:
            continue
        branch = entry.get("branch", "")
        parsed.append((Path(wt).resolve(), branch.strip()))
    return parsed


def merged_into_main(repo_root: Path, branch: str):
    rc, out = sh(["git", "-C", str(repo_root), "branch", "--merged", main_branch, "--list", branch], check=False)
    return bool((out or "").strip()) and rc == 0


def has_origin_branch(repo_root: Path, branch: str):
    rc, _ = sh(["git", "-C", str(repo_root), "rev-parse", "--verify", "--quiet", f"origin/{branch}"], check=False)
    return rc == 0


def branch_head_epoch(repo_root: Path, branch: str):
    rc, out = sh(["git", "-C", str(repo_root), "show", "-s", "--format=%ct", branch], check=False)
    if rc != 0:
        return None
    text = (out or "").strip()
    if not text.isdigit():
        return None
    return float(text)


def branch_age_hours(repo_root: Path, branch: str):
    epoch = branch_head_epoch(repo_root, branch)
    if epoch is None:
        return None
    return max(0.0, (now_epoch - epoch) / 3600.0)


def is_local_prefix(branch: str):
    for prefix in local_prefixes:
        if branch.startswith(prefix):
            return True
    return False


def is_stable_runtime_branch(branch: str):
    return branch.startswith("runtime/") or branch.startswith("managed/")


def git_branch(path: Path):
    rc, out = sh(["git", "-C", str(path), "symbolic-ref", "--short", "HEAD"], check=False)
    return (out or "").strip() if rc == 0 else "<detached>"


def git_status_dirty(path: Path):
    rc, out = sh(["git", "-C", str(path), "status", "--porcelain"], check=False)
    return rc == 0 and bool((out or "").strip())


def git_status_summary(path: Path):
    rc, out = sh(["git", "-C", str(path), "status", "--porcelain"], check=False)
    lines = [ln for ln in (out or "").splitlines() if ln.strip()]
    has_staged = False
    has_unstaged = False
    for line in lines:
        if len(line) < 2:
            continue
        x = line[0]
        y = line[1]
        if x not in {" ", "?"}:
            has_staged = True
        if y != " " or line.startswith("??"):
            has_unstaged = True
    mode = "clean"
    if has_staged and has_unstaged:
        mode = "mixed"
    elif has_staged:
        mode = "staged_only"
    elif has_unstaged:
        mode = "unstaged_only"
    return {
        "dirty": bool(lines),
        "has_staged_changes": has_staged,
        "has_unstaged_changes": has_unstaged,
        "dirty_mode": mode,
    }


def git_head(path: Path, ref: str = "HEAD"):
    rc, out = sh(["git", "-C", str(path), "rev-parse", "--verify", "--quiet", ref], check=False)
    return (out or "").strip() if rc == 0 else ""


def git_origin_url(path: Path):
    rc, out = sh(["git", "-C", str(path), "remote", "get-url", "origin"], check=False)
    return (out or "").strip() if rc == 0 else ""


def normalize_remote_url(raw: str, cwd: Path):
    text = (raw or "").strip()
    if not text:
        return ""
    if text.startswith("file://"):
        text = text[7:]
    if "://" in text or re.match(r"^[^@]+@[^:]+:.*", text):
        return text[:-4] if text.endswith(".git") else text
    path = Path(text).expanduser()
    if not path.is_absolute():
        path = (cwd / path).resolve()
    else:
        path = path.resolve()
    return str(path)


def repo_activity_age_hours(path: Path):
    rc, out = sh(["git", "-C", str(path), "rev-parse", "--git-dir"], check=False)
    if rc != 0:
        return None
    git_dir = Path((out or "").strip())
    if not git_dir.is_absolute():
        git_dir = (path / git_dir).resolve()
    candidates = [
        path,
        git_dir / "HEAD",
        git_dir / "FETCH_HEAD",
        git_dir / "logs" / "HEAD",
    ]
    mtimes = []
    for candidate in candidates:
        try:
            if candidate.exists():
                mtimes.append(candidate.stat().st_mtime)
        except Exception:
            continue
    if not mtimes:
        return None
    return max(0.0, (now_epoch - max(mtimes)) / 3600.0)


def path_is_git_repo(path: Path):
    rc, _ = sh(["git", "-C", str(path), "rev-parse", "--git-dir"], check=False)
    return rc == 0


def path_under(path: Path, parent: Path):
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except Exception:
        return False


def is_managed_worktree(path: Path):
    resolved = path.resolve()
    return any(resolved == managed_path for managed_path in managed_worktree_paths)


def discover_session_loop_id(worktree: Path):
    session_root = worktree / "docs" / "sessions"
    if not session_root.exists():
        return None
    candidates = sorted(
        [p for p in session_root.glob("*/SESSION_LOG.md") if p.is_file()],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    for cand in candidates:
        fm = parse_frontmatter(cand)
        loop_id = (fm.get("loop_id") or "").strip()
        if loop_id.startswith("LOOP-"):
            return loop_id
    return None


def parse_stash_subject(subject: str):
    text = (subject or "").strip()
    lowered = text.lower()
    prefixes = [
        ("on ", 3),
        ("wip on ", 7),
    ]
    for prefix, length in prefixes:
        if lowered.startswith(prefix):
            remainder = text[length:]
            if ":" in remainder:
                branch, message = remainder.split(":", 1)
            else:
                branch, message = remainder, ""
            return branch.strip(), message.strip()
    return "", text


repo_root = Path(subprocess.check_output(["git", "-C", str(root), "rev-parse", "--show-toplevel"], text=True, env=_clean_git_env()).strip()).resolve()
_all_wt_entries = parse_worktrees(repo_root)
main_checkout_path = _all_wt_entries[0][0] if _all_wt_entries else repo_root
is_root_context = (repo_root == main_checkout_path)
current_branch = git_branch(repo_root)
repo_origin = normalize_remote_url(git_origin_url(repo_root), repo_root)
repo_identity = {str(repo_root)}
if repo_origin:
    repo_identity.add(repo_origin)
main_branch_head = git_head(repo_root, f"refs/heads/{main_branch}")

# Lane-vs-global enforcement: identify the main checkout path (first entry in
# git worktree list is always the main working tree) and whether we are running
# from the main checkout or from a linked worktree.
_all_wt_entries = parse_worktrees(repo_root)
main_checkout_path = _all_wt_entries[0][0] if _all_wt_entries else repo_root
is_root_context = (repo_root == main_checkout_path)
current_branch = git_branch(repo_root)

# Loop scopes (authoritative owner state)
loop_scopes = {}
loops_scope_dir = (repo_root / loops_scope_rel).resolve()
if loops_scope_dir.exists():
    for scope in loops_scope_dir.glob("*.scope.md"):
        fm = parse_frontmatter(scope)
        loop_id = (fm.get("loop_id") or scope.name.replace(".scope.md", "")).strip()
        status = (fm.get("status") or "").strip().lower()
        loop_scopes[loop_id] = {
            "status": status,
            "disposition": (fm.get("disposition") or "").strip().lower(),
            "mtime": scope.stat().st_mtime,
            "path": str(scope),
        }

contract_doc = load_yaml(repo_root / "ops/bindings/worktree.lifecycle.contract.yaml") or {}
policy_doc = contract_doc.get("policy") if isinstance(contract_doc, dict) else {}
plan_linkage_required = True
branch_memory_terminal_statuses = {"retired", "canceled"}
if isinstance(policy_doc, dict):
    raw_required = policy_doc.get("require_plan_linkage_for_unmerged_nonactive_local_branches")
    if raw_required is not None:
        plan_linkage_required = bool(raw_required)
    raw_terminal = policy_doc.get("branch_memory_terminal_statuses")
    if isinstance(raw_terminal, list):
        branch_memory_terminal_statuses = {str(v).strip().lower() for v in raw_terminal if str(v).strip()}

plans_index_path = loops_scope_dir.parent / "plans/index.yaml"
branch_plan_index = {}
worktree_plan_index = {}
branch_handoff_index = {}
worktree_handoff_index = {}
plans_doc = load_yaml(plans_index_path)
if isinstance(plans_doc, dict):
    plan_rows = plans_doc.get("plans") or []
    if isinstance(plan_rows, list):
        for plan in plan_rows:
            if not isinstance(plan, dict):
                continue
            plan_id = str(plan.get("plan_id") or "").strip()
            plan_status = str(plan.get("status") or "").strip().lower() or "deferred"
            branch_ref = str(plan.get("branch_ref") or "").strip()
            worktree_path = str(plan.get("worktree_path") or "").strip()
            plan_row = {
                "plan_id": plan_id,
                "status": plan_status,
                "review_date": str(plan.get("review_date") or "").strip(),
                "source_loop_id": str(plan.get("source_loop_id") or "").strip(),
            }
            if branch_ref:
                branch_plan_index.setdefault(branch_ref, []).append(plan_row)
            if worktree_path:
                try:
                    resolved_wt = str(Path(worktree_path).expanduser().resolve())
                except Exception:
                    resolved_wt = worktree_path
                worktree_plan_index.setdefault(resolved_wt, []).append(plan_row)

if handoffs_dir.exists():
    for handoff_file in sorted(handoffs_dir.glob("HO-*.yaml")):
        handoff = load_yaml(handoff_file)
        if not isinstance(handoff, dict):
            continue
        if str(handoff.get("kind") or "").strip() != "parked_lane":
            continue
        state = str(handoff.get("state") or "").strip().lower()
        if state not in {"active", "parked"}:
            continue
        parking = handoff.get("parking")
        if not isinstance(parking, dict):
            continue
        handoff_row = {
            "handoff_id": str(handoff.get("id") or handoff_file.stem).strip(),
            "state": state,
            "review_date": str(parking.get("review_date") or "").strip(),
            "loops": [str(item).strip() for item in (handoff.get("loops") or []) if str(item).strip()],
        }
        for branch_ref in parking.get("branch_refs") or []:
            ref = str(branch_ref or "").strip()
            if ref:
                branch_handoff_index.setdefault(ref, []).append(handoff_row)
        for worktree_path in parking.get("worktree_paths") or []:
            raw_path = str(worktree_path or "").strip()
            if not raw_path:
                continue
            try:
                resolved_wt = str(Path(raw_path).expanduser().resolve())
            except Exception:
                resolved_wt = raw_path
            worktree_handoff_index.setdefault(resolved_wt, []).append(handoff_row)


def linked_plans_for(branch: str, wt_path: str):
    linked = []
    seen = set()
    for plan in branch_plan_index.get(branch, []):
        pid = plan.get("plan_id")
        if pid and pid not in seen:
            linked.append(plan)
            seen.add(pid)
    for plan in worktree_plan_index.get(wt_path, []):
        pid = plan.get("plan_id")
        if pid and pid not in seen:
            linked.append(plan)
            seen.add(pid)
    return linked


def linked_handoffs_for(branch: str, wt_path: str):
    linked = []
    seen = set()
    for handoff in branch_handoff_index.get(branch, []):
        hid = handoff.get("handoff_id")
        if hid and hid not in seen:
            linked.append(handoff)
            seen.add(hid)
    for handoff in worktree_handoff_index.get(wt_path, []):
        hid = handoff.get("handoff_id")
        if hid and hid not in seen:
            linked.append(handoff)
            seen.add(hid)
    return linked

# Wave workspace owners (runtime state)
wave_worktrees = {}
if waves_dir.exists():
    for state_file in waves_dir.glob("*/state.json"):
        try:
            state = json.loads(state_file.read_text(encoding="utf-8"))
        except Exception:
            continue
        workspace = state.get("workspace") or {}
        wt = workspace.get("worktree")
        if not wt:
            continue
        wave_worktrees[str(Path(wt).resolve())] = {
            "wave_id": state.get("wave_id"),
            "status": (state.get("status") or "").strip().lower(),
            "closed_at": state.get("closed_at"),
            "created_at": state.get("created_at"),
        }

worktree_rows = []
temp_clone_rows = []
issues = []
warnings = []

for wt, raw_branch in parse_worktrees(repo_root):
    # Always skip the main checkout — it gets root-style checks in the
    # root_checkout section below.  When running FROM a linked worktree,
    # the current worktree is now processed here so its issues can be
    # classified as lane-scoped.
    if wt == main_checkout_path:
        continue

    branch = (raw_branch or "").strip()
    if branch.startswith("refs/heads/"):
        branch = branch.replace("refs/heads/", "", 1)
    if not branch:
        rc, out = sh(["git", "-C", str(wt), "symbolic-ref", "--short", "HEAD"], check=False)
        branch = (out or "").strip() if rc == 0 else "<detached>"

    row = {
        "path": str(wt),
        "branch": branch,
        "kind": "worktree",
        "managed_worktree": is_managed_worktree(wt),
        "owner_type": "none",
        "owner_id": None,
        "owner_state": "unknown",
        "owner_disposition": None,
        "owner_age_hours": None,
        "has_origin": None,
        "merged_into_main": False,
        "branch_age_hours": None,
        "branch_memory_linked": False,
        "linked_plan_refs": [],
        "linked_plan_statuses": [],
        "linked_handoff_refs": [],
        "linked_handoff_states": [],
        "canonical_root_ok": path_under(wt, canonical_worktree_root),
        "lease": parse_lease(wt / lease_filename),
        "dirty": False,
        "issues": [],
        "warnings": [],
    }

    if row["managed_worktree"]:
        row["owner_type"] = "managed"
        row["owner_id"] = wt.name
        row["owner_state"] = "active"

    wave = wave_worktrees.get(str(wt))
    loop_id = None
    if row["managed_worktree"]:
        pass
    elif wave:
        row["owner_type"] = "wave"
        row["owner_id"] = wave.get("wave_id")
        wave_status = wave.get("status") or "unknown"
        row["owner_state"] = "closed" if wave_status == "closed" else "active" if wave_status == "active" else wave_status
        row["owner_disposition"] = (wave.get("disposition") or "").strip().lower() or None
        closed_epoch = parse_iso_epoch(wave.get("closed_at"))
        if closed_epoch is not None:
            row["owner_age_hours"] = max(0.0, (now_epoch - closed_epoch) / 3600.0)
    else:
        if branch.startswith("codex/LOOP-"):
            loop_id = branch.split("codex/", 1)[1]
        elif branch.startswith("LOOP-"):
            loop_id = branch.split("/", 1)[0]
        else:
            m = re.search(r"/orchestration/(LOOP-[^/]+)/", str(wt))
            if m:
                loop_id = m.group(1)
            else:
                loop_id = discover_session_loop_id(wt)

        if loop_id:
            row["owner_type"] = "loop"
            row["owner_id"] = loop_id
            scope = loop_scopes.get(loop_id)
            if scope:
                status = scope.get("status") or "unknown"
                row["owner_disposition"] = (scope.get("disposition") or "").strip().lower() or None
                if status == "closed":
                    row["owner_state"] = "closed"
                    row["owner_age_hours"] = max(0.0, (now_epoch - scope["mtime"]) / 3600.0)
                elif status in {"active", "planned", "draft", "open"}:
                    row["owner_state"] = "active"
                else:
                    row["owner_state"] = status
            else:
                row["owner_state"] = "unknown"

    if branch == "<detached>":
        if fail_on_detached:
            row["issues"].append("detached_head")
    else:
        row["merged_into_main"] = merged_into_main(repo_root, branch)
        row["has_origin"] = has_origin_branch(repo_root, branch)
        row["branch_age_hours"] = branch_age_hours(repo_root, branch)
        linked_plans = linked_plans_for(branch, row["path"])
        linked_handoffs = linked_handoffs_for(branch, row["path"])
        row["branch_memory_linked"] = bool(linked_plans or linked_handoffs)
        row["linked_plan_refs"] = [plan["plan_id"] for plan in linked_plans if plan.get("plan_id")]
        row["linked_plan_statuses"] = [plan["status"] for plan in linked_plans if plan.get("status")]
        row["linked_handoff_refs"] = [handoff["handoff_id"] for handoff in linked_handoffs if handoff.get("handoff_id")]
        row["linked_handoff_states"] = [handoff["state"] for handoff in linked_handoffs if handoff.get("state")]

        if not row["has_origin"] and not row["managed_worktree"]:
            owner_active = row["owner_type"] in {"loop", "wave"} and row["owner_state"] not in {"closed", "unknown"}
            if owner_active:
                pass
            elif is_stable_runtime_branch(branch):
                pass
            elif is_local_prefix(branch):
                row["warnings"].append("local_branch_no_remote")
            else:
                row["issues"].append("orphan_branch_no_remote")

        if row["merged_into_main"] and not row["managed_worktree"] and not is_stable_runtime_branch(branch):
            age = row["branch_age_hours"]
            if age is not None and age >= merged_grace_h:
                row["issues"].append("merged_branch_past_grace")
            else:
                row["warnings"].append("merged_branch_within_grace")

        if row["owner_type"] == "none" and is_local_prefix(branch):
            age = row["branch_age_hours"]
            if age is not None and age >= unowned_local_grace_h:
                row["issues"].append("unowned_local_branch_past_grace")
        if (
            plan_linkage_required
            and not row["managed_worktree"]
            and not row["merged_into_main"]
            and not is_stable_runtime_branch(branch)
            and row["owner_state"] != "active"
        ):
            if not row["branch_memory_linked"]:
                row["issues"].append("branch_missing_plan_linkage")
            elif row["linked_plan_statuses"] and all(status in branch_memory_terminal_statuses for status in row["linked_plan_statuses"]):
                row["warnings"].append("branch_linked_only_to_terminal_plan")

        if row["managed_worktree"] and main_branch_head and git_head(wt) != main_branch_head:
            row["issues"].append("managed_worktree_not_at_main")

    dirty_rc, dirty_out = sh(["git", "-C", str(wt), "status", "--porcelain"], check=False)
    row["dirty"] = bool((dirty_out or "").strip())
    if row["dirty"]:
        if row["managed_worktree"]:
            row["issues"].append("dirty_managed_worktree")
        elif row["owner_state"] == "closed" and fail_on_dirty_closed:
            row["issues"].append("dirty_closed_owner")
        elif row["owner_state"] == "active" and warn_on_dirty_active:
            row["warnings"].append("dirty_active_owner")
        else:
            row["warnings"].append("dirty_unowned")

    if row["owner_state"] == "closed":
        disposition = row.get("owner_disposition")
        if not disposition:
            code = "closed_owner_missing_disposition"
            if fail_on_closed_owner_missing_disposition:
                row["issues"].append(code)
            else:
                row["warnings"].append(code)
        elif allowed_dispositions and disposition not in allowed_dispositions:
            code = "closed_owner_invalid_disposition"
            if fail_on_closed_owner_invalid_disposition:
                row["issues"].append(code)
            else:
                row["warnings"].append(code)
        age = row["owner_age_hours"]
        if age is not None and age >= closed_owner_grace_h:
            row["issues"].append(f"closed_{row['owner_type']}_zombie")
        else:
            row["warnings"].append(f"closed_{row['owner_type']}_within_grace")

    worktree_rows.append(row)
    for code in row["issues"]:
        issues.append({
            "kind": "worktree",
            "path": row["path"],
            "branch": row["branch"],
            "code": code,
            "owner_type": row["owner_type"],
            "owner_id": row["owner_id"],
            "owner_state": row["owner_state"],
        })
    for code in row["warnings"]:
        warnings.append({
            "kind": "worktree",
            "path": row["path"],
            "branch": row["branch"],
            "code": code,
            "owner_type": row["owner_type"],
            "owner_id": row["owner_id"],
            "owner_state": row["owner_state"],
        })

represented_branches = {
    row["branch"]
    for row in worktree_rows
    if row.get("branch") and row["branch"] != "<detached>"
}
local_branch_rows = []
_, local_branch_out = sh(
    ["git", "-C", str(repo_root), "for-each-ref", "--format=%(refname:short)", "refs/heads"],
    check=False,
)
for raw_branch in [ln.strip() for ln in local_branch_out.splitlines() if ln.strip()]:
    if raw_branch == main_branch or raw_branch in represented_branches:
        continue
    row = {
        "kind": "local_branch",
        "path": str(repo_root),
        "branch": raw_branch,
        "has_origin": has_origin_branch(repo_root, raw_branch),
        "merged_into_main": merged_into_main(repo_root, raw_branch),
        "branch_age_hours": branch_age_hours(repo_root, raw_branch),
        "branch_memory_linked": False,
        "linked_plan_refs": [],
        "linked_plan_statuses": [],
        "linked_handoff_refs": [],
        "linked_handoff_states": [],
        "issues": [],
        "warnings": [],
    }
    linked_plans = linked_plans_for(raw_branch, "")
    linked_handoffs = linked_handoffs_for(raw_branch, "")
    row["branch_memory_linked"] = bool(linked_plans or linked_handoffs)
    row["linked_plan_refs"] = [plan["plan_id"] for plan in linked_plans if plan.get("plan_id")]
    row["linked_plan_statuses"] = [plan["status"] for plan in linked_plans if plan.get("status")]
    row["linked_handoff_refs"] = [handoff["handoff_id"] for handoff in linked_handoffs if handoff.get("handoff_id")]
    row["linked_handoff_states"] = [handoff["state"] for handoff in linked_handoffs if handoff.get("state")]

    if not row["has_origin"]:
        if is_local_prefix(raw_branch):
            row["warnings"].append("local_branch_no_remote")
        else:
            row["issues"].append("orphan_branch_no_remote")

    if row["merged_into_main"] and not is_stable_runtime_branch(raw_branch):
        age = row["branch_age_hours"]
        if age is not None and age >= merged_grace_h:
            row["issues"].append("merged_branch_past_grace")
        else:
            row["warnings"].append("merged_branch_within_grace")
    elif (
        plan_linkage_required
        and not is_stable_runtime_branch(raw_branch)
    ):
        if not row["branch_memory_linked"]:
            row["issues"].append("branch_missing_plan_linkage")
        elif row["linked_plan_statuses"] and all(status in branch_memory_terminal_statuses for status in row["linked_plan_statuses"]):
            row["warnings"].append("branch_linked_only_to_terminal_plan")

    local_branch_rows.append(row)
    for code in row["issues"]:
        issues.append({
            "kind": "local_branch",
            "path": row["path"],
            "branch": row["branch"],
                "code": code,
                "owner_type": "branch_memory",
                "owner_id": ",".join(row["linked_plan_refs"] + row["linked_handoff_refs"]) if (row["linked_plan_refs"] or row["linked_handoff_refs"]) else None,
                "owner_state": "linked" if row["branch_memory_linked"] else "unlinked",
            })
    for code in row["warnings"]:
        warnings.append({
            "kind": "local_branch",
            "path": row["path"],
            "branch": row["branch"],
                "code": code,
                "owner_type": "branch_memory",
                "owner_id": ",".join(row["linked_plan_refs"] + row["linked_handoff_refs"]) if (row["linked_plan_refs"] or row["linked_handoff_refs"]) else None,
                "owner_state": "linked" if row["branch_memory_linked"] else "unlinked",
            })

if canonical_temp_clone_root.exists():
    for clone_path in sorted(canonical_temp_clone_root.iterdir()):
        if not clone_path.is_dir() or not path_is_git_repo(clone_path):
            continue
        origin_raw = git_origin_url(clone_path)
        origin_url = normalize_remote_url(origin_raw, clone_path)
        if origin_url not in repo_identity:
            continue
        is_remote_origin = bool(origin_raw) and ("://" in origin_raw or re.match(r"^[^@]+@[^:]+:.*", origin_raw))
        origin_kind = "remote" if is_remote_origin else "local_path"
        origin_exists = True if is_remote_origin else Path(origin_url).exists()
        row = {
            "path": str(clone_path.resolve()),
            "branch": git_branch(clone_path),
            "kind": "temp_clone",
            "origin_url": origin_raw,
            "origin_kind": origin_kind,
            "origin_exists": origin_exists,
            "age_hours": repo_activity_age_hours(clone_path),
            "dirty": git_status_dirty(clone_path),
            "issues": [],
            "warnings": [],
        }

        if row["dirty"]:
            if fail_on_dirty_temp_clone:
                row["issues"].append("dirty_temp_clone")
            else:
                row["warnings"].append("dirty_temp_clone")

        if origin_kind == "local_path" and not origin_exists:
            if fail_on_missing_temp_clone_origin:
                row["issues"].append("temp_clone_origin_missing")
            else:
                row["warnings"].append("temp_clone_origin_missing")

        age = row["age_hours"]
        if age is not None and age >= temp_clone_grace_h:
            row["issues"].append("temp_clone_past_grace")

        temp_clone_rows.append(row)
        for code in row["issues"]:
            issues.append({
                "kind": "temp_clone",
                "path": row["path"],
                "branch": row["branch"],
                "code": code,
                "owner_type": "temp_clone",
                "owner_id": None,
                "owner_state": "n/a",
            })
        for code in row["warnings"]:
            warnings.append({
                "kind": "temp_clone",
                "path": row["path"],
                "branch": row["branch"],
                "code": code,
                "owner_type": "temp_clone",
                "owner_id": None,
                "owner_state": "n/a",
            })

root_checkout = {
    "checked": False,
    "path": str(main_checkout_path),
    "branch": git_branch(main_checkout_path),
    "main_branch": main_branch,
    "main_exists": bool(git_head(main_checkout_path, f"refs/heads/{main_branch}")),
    "head": git_head(main_checkout_path, "HEAD"),
    "main_head": git_head(main_checkout_path, f"refs/heads/{main_branch}"),
    "head_matches_main": False,
    "normalizable": False,
    "issues": [],
    "warnings": [],
}
root_checkout.update(git_status_summary(main_checkout_path))
root_checkout["head_matches_main"] = bool(
    root_checkout["head"] and root_checkout["main_head"] and root_checkout["head"] == root_checkout["main_head"]
)

# Always check the main checkout for root-specific issues, regardless of
# whether we are running from the root or from a linked worktree.
if not path_under(main_checkout_path, canonical_worktree_root) and not path_under(main_checkout_path, canonical_temp_clone_root):
    root_checkout["checked"] = True
    if root_checkout["branch"] == "<detached>":
        root_checkout["issues"].append("root_checkout_detached")
    elif root_checkout["branch"] != main_branch:
        code = "root_checkout_matches_main_but_branch_not_main" if root_checkout["head_matches_main"] else "root_checkout_not_main"
        if fail_on_root_non_main:
            root_checkout["issues"].append(code)
        else:
            root_checkout["warnings"].append(code)
    if root_checkout["dirty"]:
        if root_checkout["dirty_mode"] == "staged_only":
            root_checkout["warnings"].append("root_checkout_staged_only")
        elif fail_on_root_dirty:
            root_checkout["issues"].append("root_checkout_dirty")
        else:
            root_checkout["warnings"].append("root_checkout_dirty")
    root_checkout["normalizable"] = (
        root_checkout["branch"] not in {"", "<detached>", main_branch}
        and not root_checkout["dirty"]
        and root_checkout["main_exists"]
        and root_checkout["head_matches_main"]
    )
    for code in root_checkout["issues"]:
        issues.append({
            "kind": "root_checkout",
            "path": root_checkout["path"],
            "branch": root_checkout["branch"],
            "code": code,
            "owner_type": "root_checkout",
            "owner_id": None,
            "owner_state": "n/a",
        })
    for code in root_checkout["warnings"]:
        warnings.append({
            "kind": "root_checkout",
            "path": root_checkout["path"],
            "branch": root_checkout["branch"],
            "code": code,
            "owner_type": "root_checkout",
            "owner_id": None,
            "owner_state": "n/a",
        })

# Stash audit
stash_rows = []
stash_issues = []
stash_warnings = []
_, stash_out = sh(
    ["git", "-C", str(repo_root), "stash", "list", "--format=%gd%x09%H%x09%ct%x09%gs"],
    check=False,
)
stash_lines = [ln.strip() for ln in stash_out.splitlines() if ln.strip()]
for line in stash_lines:
    parts = line.split("\t", 3)
    ref = parts[0].strip() if len(parts) > 0 else ""
    commit = parts[1].strip() if len(parts) > 1 else ""
    commit_epoch = float(parts[2]) if len(parts) > 2 and parts[2].strip().isdigit() else None
    subject = parts[3].strip() if len(parts) > 3 else ""
    stash_branch, stash_message = parse_stash_subject(subject)
    age_hours = None if commit_epoch is None else max(0.0, (now_epoch - commit_epoch) / 3600.0)
    row = {
        "ref": ref,
        "commit": commit,
        "subject": subject,
        "message": stash_message,
        "branch": stash_branch,
        "age_hours": age_hours,
        "issues": [],
        "warnings": [],
        "cleanup_candidate": False,
    }

    if stash_branch in {"main", "master"}:
        if age_hours is not None and age_hours >= main_stash_fail_h:
            row["issues"].append("main_stash_past_fail_grace")
        elif age_hours is not None and age_hours >= main_stash_warn_h:
            row["warnings"].append("main_stash_past_warn_grace")
    elif stash_branch:
        rc, _ = sh(["git", "-C", str(repo_root), "rev-parse", "--verify", "--quiet", f"refs/heads/{stash_branch}"], check=False)
        exists = rc == 0
        if not exists:
            row["issues"].append("stash_branch_gone")
        elif merged_into_main(repo_root, stash_branch):
            row["issues"].append("stash_branch_merged")
        elif is_local_prefix(stash_branch):
            row["warnings"].append("stash_local_branch")

    row["cleanup_candidate"] = any(
        code in {"stash_branch_gone", "stash_branch_merged", "main_stash_past_fail_grace"}
        for code in row["issues"]
    ) or any(code in {"main_stash_past_warn_grace"} for code in row["warnings"])
    stash_rows.append(row)

    for code in row["issues"]:
        stash_issues.append(
            {
                "ref": ref,
                "commit": commit,
                "branch": stash_branch,
                "subject": subject,
                "age_hours": age_hours,
                "code": code,
            }
        )
    for code in row["warnings"]:
        stash_warnings.append(
            {
                "ref": ref,
                "commit": commit,
                "branch": stash_branch,
                "subject": subject,
                "age_hours": age_hours,
                "code": code,
            }
        )

# ── Lane-vs-global scope classification ──────────────────────────────
# Each issue is classified as "lane" (blocks current worker commit) or
# "global" (blocks controller/root operations, informational for workers).

def _issue_scope(item):
    kind = item.get("kind", "")
    path = item.get("path", "")
    branch = item.get("branch", "")
    if kind == "root_checkout":
        return "lane" if is_root_context else "global"
    if kind == "worktree":
        return "lane" if path == str(repo_root) else "global"
    if kind == "local_branch":
        return "lane" if branch == current_branch else "global"
    return "global"  # temp_clone and anything else

lane_issues = [i for i in issues if _issue_scope(i) == "lane"]
global_issues = [i for i in issues if _issue_scope(i) == "global"]
lane_warnings = [w for w in warnings if _issue_scope(w) == "lane"]
global_warnings = [w for w in warnings if _issue_scope(w) == "global"]
# Stash issues are always global (never block a lane commit).
lane_issue_count = len(lane_issues)
global_issue_count = len(global_issues) + len(stash_issues)

# ── Lane-vs-global scope classification ──────────────────────────────
# Each issue is classified as "lane" (blocks current worker commit) or
# "global" (blocks controller/root operations, informational for workers).

def _issue_scope(item):
    kind = item.get("kind", "")
    path = item.get("path", "")
    branch = item.get("branch", "")
    if kind == "root_checkout":
        return "lane" if is_root_context else "global"
    if kind == "worktree":
        return "lane" if path == str(repo_root) else "global"
    if kind == "local_branch":
        return "lane" if branch == current_branch else "global"
    return "global"  # temp_clone and anything else

lane_issues = [i for i in issues if _issue_scope(i) == "lane"]
global_issues = [i for i in issues if _issue_scope(i) == "global"]
lane_warnings = [w for w in warnings if _issue_scope(w) == "lane"]
global_warnings = [w for w in warnings if _issue_scope(w) == "global"]
# Stash issues are always global (never block a lane commit).
lane_issue_count = len(lane_issues)
global_issue_count = len(global_issues) + len(stash_issues)

summary = {
    "repo": str(repo_root),
    "checked_worktrees": len(worktree_rows),
    "checked_local_branches": len(local_branch_rows),
    "checked_temp_clones": len(temp_clone_rows),
    "checked_root_checkout": 1 if root_checkout["checked"] else 0,
    "worktree_issue_count": len(issues),
    "worktree_warning_count": len(warnings),
    "stash_count": len(stash_lines),
    "stash_cleanup_candidate_count": sum(1 for row in stash_rows if row["cleanup_candidate"]),
    "stash_issue_count": len(stash_issues),
    "stash_warning_count": len(stash_warnings),
    "total_issue_count": len(issues) + len(stash_issues),
    "total_warning_count": len(warnings) + len(stash_warnings),
    "lane_issue_count": lane_issue_count,
    "global_issue_count": global_issue_count,
    "policy": {
        "main_branch": main_branch,
        "canonical_worktree_root": str(canonical_worktree_root),
        "canonical_temp_clone_root": str(canonical_temp_clone_root),
        "managed_worktree_paths": [str(p) for p in managed_worktree_paths],
        "lease_filename": lease_filename,
        "lease_ttl_hours_default": lease_ttl_h,
        "local_branch_prefixes_allow_no_remote": local_prefixes,
        "merged_branch_grace_hours": merged_grace_h,
        "closed_owner_grace_hours": closed_owner_grace_h,
        "unowned_local_branch_grace_hours": unowned_local_grace_h,
        "temp_clone_grace_hours": temp_clone_grace_h,
        "main_stash_warn_hours": main_stash_warn_h,
        "main_stash_fail_hours": main_stash_fail_h,
    },
}

payload = {
    "summary": summary,
    "worktrees": worktree_rows,
    "local_branches": local_branch_rows,
    "temp_clones": temp_clone_rows,
    "root_checkout": root_checkout,
    "issues": issues,
    "warnings": warnings,
    "lane_issues": lane_issues,
    "global_issues": global_issues,
    "stashes": stash_rows,
    "stash_issues": stash_issues,
    "stash_warnings": stash_warnings,
}

def format_item(item):
    kind = item.get("kind") or "worktree"
    path = item.get("path") or "<unknown>"
    branch = item.get("branch") or "<unknown>"
    code = item.get("code") or "unknown"
    if kind == "worktree":
        owner = item.get("owner_id") or "none"
        disposition = item.get("owner_disposition") or "n/a"
        return f"{path}: {branch} -> {code} (owner={item.get('owner_type')}:{owner} state={item.get('owner_state')} disposition={disposition})"
    return f"{kind} {path}: {branch} -> {code}"


def format_stash_item(item):
    age_hours = item.get("age_hours")
    age_fragment = ""
    if isinstance(age_hours, (int, float)):
        age_fragment = f", age={age_hours:.1f}h"
    return f"stash {item.get('ref')} ({item.get('branch') or '<unknown>'}{age_fragment}): {item.get('code')}"

if json_mode:
    print(json.dumps(payload, indent=2))
else:
    if brief_mode:
        status = "FAIL" if summary["total_issue_count"] > 0 else "PASS"
        print(
            f"{status} issues={summary['total_issue_count']} warnings={summary['total_warning_count']} "
            f"worktrees={summary['checked_worktrees']} temp_clones={summary['checked_temp_clones']} "
            f"root={summary['checked_root_checkout']} stashes={summary['stash_count']}"
        )
    elif mode == "gate":
        if summary["total_issue_count"] > 0:
            print("D48 FAIL: worktree lifecycle issues detected")
            for item in issues:
                print(f"  - {format_item(item)}")
            for item in stash_issues:
                print(f"  - {format_stash_item(item)}")
            if warnings:
                print("  WARNINGS:")
                for item in warnings:
                    print(f"    - {format_item(item)}")
            if stash_warnings:
                for item in stash_warnings:
                    print(f"    - {format_stash_item(item)}")
        else:
            print(
                "D48 PASS: lifecycle clean "
                f"(worktrees={summary['checked_worktrees']} temp_clones={summary['checked_temp_clones']} "
                f"root={summary['checked_root_checkout']} warnings={summary['total_warning_count']} "
                f"stashes={summary['stash_count']})"
            )
    elif mode == "lane":
        if lane_issue_count > 0:
            print("D48 FAIL (lane): current lane has lifecycle issues")
            for item in lane_issues:
                print(f"  - {format_item(item)}")
            if global_issues or stash_issues:
                print("  GLOBAL (non-blocking):")
                for item in global_issues:
                    print(f"    - {format_item(item)}")
                for item in stash_issues:
                    print(f"    - {format_stash_item(item)}")
            if lane_warnings:
                print("  WARNINGS (lane):")
                for item in lane_warnings:
                    print(f"    - {format_item(item)}")
        else:
            print(
                f"D48 PASS (lane): current lane clean "
                f"(global_issues={global_issue_count} warnings={summary['total_warning_count']} "
                f"stashes={summary['stash_count']})"
            )
    elif mode == "lane":
        if lane_issue_count > 0:
            print("D48 FAIL (lane): current lane has lifecycle issues")
            for item in lane_issues:
                print(f"  - {format_item(item)}")
            if global_issues or stash_issues:
                print("  GLOBAL (non-blocking):")
                for item in global_issues:
                    print(f"    - {format_item(item)}")
                for item in stash_issues:
                    print(f"    - {format_stash_item(item)}")
            if lane_warnings:
                print("  WARNINGS (lane):")
                for item in lane_warnings:
                    print(f"    - {format_item(item)}")
        else:
            print(
                f"D48 PASS (lane): current lane clean "
                f"(global_issues={global_issue_count} warnings={summary['total_warning_count']} "
                f"stashes={summary['stash_count']})"
            )
    else:
        print("worktree.lifecycle.reconcile")
        print(f"repo: {summary['repo']}")
        print(f"checked_worktrees: {summary['checked_worktrees']}")
        print(f"checked_temp_clones: {summary['checked_temp_clones']}")
        print(f"checked_root_checkout: {summary['checked_root_checkout']}")
        print(f"issues: {summary['total_issue_count']}")
        print(f"warnings: {summary['total_warning_count']}")
        print(f"stashes: {summary['stash_count']}")

        if issues:
            print("issue_details:")
            for item in issues:
                print(f"  - {format_item(item)}")
        if warnings:
            print("warning_details:")
            for item in warnings:
                print(f"  - {format_item(item)}")
        if stash_issues:
            print("stash_issues:")
            for item in stash_issues:
                print(f"  - {format_stash_item(item)}")
        if stash_warnings:
            print("stash_warnings:")
            for item in stash_warnings:
                print(f"  - {format_stash_item(item)}")

if mode == "gate" and summary["total_issue_count"] > 0:
    sys.exit(1)
if mode == "lane" and lane_issue_count > 0:
    sys.exit(1)
