#!/usr/bin/env bash
# deploy-translator-service — Deploy translator-node to VM 207 via SSH/Tailscale
# Governed capability: translator.deploy
# Target: 100.71.17.29 (vm-207-ai-consolidation)
set -euo pipefail

# ── Parse args ────────────────────────────────────────────────────────
ACTION="${1:-status}"
VM_HOST="100.71.17.29"
VM_USER="ronny"
SERVICE_NAME="translator-node"
SERVICE_PORT="8400"
WORKBENCH_SRC="${WORKBENCH_ROOT:-$HOME/code/workbench}/agents/translator-node"

usage() {
  cat <<'USAGE'
Usage: deploy-translator-service <action>

Actions:
  status    — Check service health on VM 207
  deploy    — rsync source + restart service on VM 207
  logs      — Tail service logs from VM 207
  stop      — Stop the service on VM 207
USAGE
  exit 1
}

case "$ACTION" in
  -h|--help) usage ;;
  --) shift ;;
esac

# ── Status ────────────────────────────────────────────────────────────
cmd_status() {
  echo "translator.deploy.status"
  echo "target: ${VM_USER}@${VM_HOST}:${SERVICE_PORT}"
  echo ""

  # Health check via Tailscale
  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 \
    "http://${VM_HOST}:${SERVICE_PORT}/health" 2>/dev/null || echo "000")

  if [[ "$HTTP_CODE" == "200" ]]; then
    echo "status: healthy"
    curl -s "http://${VM_HOST}:${SERVICE_PORT}/health" 2>/dev/null | python3 -m json.tool 2>/dev/null || true
  else
    echo "status: unreachable (HTTP ${HTTP_CODE})"
  fi
}

# ── Deploy ────────────────────────────────────────────────────────────
cmd_deploy() {
  echo "translator.deploy"
  echo "source: ${WORKBENCH_SRC}"
  echo "target: ${VM_USER}@${VM_HOST}:/opt/services/${SERVICE_NAME}"
  echo ""

  if [[ ! -d "$WORKBENCH_SRC" ]]; then
    echo "ERROR: Source directory not found: ${WORKBENCH_SRC}"
    exit 1
  fi

  # rsync source to VM
  echo "==> Syncing source..."
  rsync -avz --delete \
    --exclude '__pycache__' \
    --exclude '*.pyc' \
    --exclude '.git' \
    "${WORKBENCH_SRC}/" \
    "${VM_USER}@${VM_HOST}:/opt/services/${SERVICE_NAME}/"

  # Install deps + restart service
  echo "==> Installing dependencies and restarting..."
  ssh "${VM_USER}@${VM_HOST}" bash <<'REMOTE'
    cd /opt/services/translator-node
    python3 -m pip install -r requirements.txt --quiet 2>/dev/null

    # Stop existing if running
    if pgrep -f "uvicorn app.main:app.*8400" >/dev/null 2>&1; then
      pkill -f "uvicorn app.main:app.*8400" || true
      sleep 2
    fi

    # Start with nohup
    nohup uvicorn app.main:app --host 0.0.0.0 --port 8400 \
      > /var/log/translator-node.log 2>&1 &

    sleep 2
    if pgrep -f "uvicorn app.main:app.*8400" >/dev/null 2>&1; then
      echo "status: running"
      echo "pid: $(pgrep -f 'uvicorn app.main:app.*8400')"
    else
      echo "status: failed to start"
      tail -20 /var/log/translator-node.log
      exit 1
    fi
REMOTE

  echo ""
  echo "==> Verifying health endpoint..."
  sleep 1
  cmd_status
}

# ── Logs ──────────────────────────────────────────────────────────────
cmd_logs() {
  echo "translator.deploy.logs"
  ssh "${VM_USER}@${VM_HOST}" "tail -100 /var/log/translator-node.log"
}

# ── Stop ──────────────────────────────────────────────────────────────
cmd_stop() {
  echo "translator.deploy.stop"
  ssh "${VM_USER}@${VM_HOST}" bash <<'REMOTE'
    if pgrep -f "uvicorn app.main:app.*8400" >/dev/null 2>&1; then
      pkill -f "uvicorn app.main:app.*8400"
      echo "status: stopped"
    else
      echo "status: not running"
    fi
REMOTE
}

# ── Dispatch ──────────────────────────────────────────────────────────
case "$ACTION" in
  status) cmd_status ;;
  deploy) cmd_deploy ;;
  logs)   cmd_logs ;;
  stop)   cmd_stop ;;
  *)      usage ;;
esac
