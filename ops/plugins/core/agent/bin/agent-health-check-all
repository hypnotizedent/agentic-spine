#!/usr/bin/env bash
set -euo pipefail

# agent-health-check-all — Probe configured agent endpoints and report aggregate health.
#
# Usage:
#   agent-health-check-all [--agents "id1,id2"] [--timeout 3] [--strict] [--json]

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
ROOT="${SPINE_TARGET_REPO:-${SPINE_REPO:-$ROOT}}"
source "$ROOT/ops/lib/endpoint-resolve.sh"
REGISTRY="${SPINE_AGENTS_REGISTRY:-$ROOT/ops/bindings/agents.registry.yaml}"
CAPABILITY="agent.health.check-all"

AGENTS_FILTER=""
TIMEOUT=3
STRICT=0
JSON=0

usage() {
  cat <<'USAGE'
agent-health-check-all

Usage:
  agent-health-check-all [--agents "id1,id2"] [--timeout 3] [--strict] [--json]
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agents) AGENTS_FILTER="${2:?--agents requires value}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout requires value}"; shift 2 ;;
    --strict) STRICT=1; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "FAIL: unknown arg: $1" >&2; exit 2 ;;
  esac
done

command -v yq >/dev/null 2>&1 || { echo "FAIL: yq required" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "FAIL: jq required" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "FAIL: curl required" >&2; exit 2; }
[[ -f "$REGISTRY" ]] || { echo "FAIL: missing registry: $REGISTRY" >&2; exit 1; }

FILTER_JSON='[]'
if [[ -n "$AGENTS_FILTER" ]]; then
  FILTER_JSON="$(printf '%s' "$AGENTS_FILTER" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sed '/^$/d' | jq -Rsc 'split("\n") | map(select(length>0))')"
fi

in_filter() {
  local agent_id="$1"
  jq -e --arg id "$agent_id" '. | index($id) != null' <<<"$FILTER_JSON" >/dev/null 2>&1
}

resolve_endpoint_url() {
  local health_id="$1"
  local explicit_url="$2"
  local service_ref="$3"
  local endpoint_kind="$4"
  local url_suffix="$5"
  local base_url resolved

  if [[ -n "$explicit_url" ]]; then
    printf '%s\n' "$explicit_url"
    return 0
  fi

  [[ -n "$service_ref" ]] || service_ref="$health_id"
  [[ -n "$service_ref" ]] || return 1
  [[ -n "$endpoint_kind" ]] || endpoint_kind="agent_health_url"

  case "$endpoint_kind" in
    lan_base_url) base_url="$(endpoint_resolve_lan_base_url "$service_ref" || true)" ;;
    lan_health_url) base_url="$(endpoint_resolve_lan_health_url "$service_ref" || true)" ;;
    tailscale_base_url) base_url="$(endpoint_resolve_tailscale_base_url "$service_ref" || true)" ;;
    tailscale_health_url) base_url="$(endpoint_resolve_tailscale_health_url "$service_ref" || true)" ;;
    operator_base_url) base_url="$(endpoint_resolve_operator_base_url "$service_ref" || true)" ;;
    operator_health_url) base_url="$(endpoint_resolve_operator_health_url "$service_ref" || true)" ;;
    agent_base_url) base_url="$(endpoint_resolve_agent_base_url "$service_ref" || true)" ;;
    agent_health_url|"") base_url="$(endpoint_resolve_agent_health_url "$service_ref" || true)" ;;
    public_base_url) base_url="$(endpoint_resolve_public_base_url "$service_ref" || true)" ;;
    *) return 1 ;;
  esac

  [[ -n "$base_url" ]] || return 1
  if [[ -n "$url_suffix" ]]; then
    if [[ "$url_suffix" == /* ]]; then
      resolved="${base_url%/}${url_suffix}"
    else
      resolved="${base_url%/}/$url_suffix"
    fi
    printf '%s\n' "$resolved"
    return 0
  fi
  printf '%s\n' "$base_url"
}

probes='[]'
checked=0
healthy=0
unhealthy=0

while IFS= read -r endpoint_row; do
  [[ -n "$endpoint_row" ]] || continue

  agent_id="$(jq -r '.agent_id // ""' <<<"$endpoint_row")"
  endpoint_name="$(jq -r '.endpoint_name // ""' <<<"$endpoint_row")"
  health_id="$(jq -r '.health_id // ""' <<<"$endpoint_row")"
  endpoint_url="$(jq -r '.url // ""' <<<"$endpoint_row")"
  service_ref="$(jq -r '.service_ref // ""' <<<"$endpoint_row")"
  endpoint_kind="$(jq -r '.endpoint_kind // ""' <<<"$endpoint_row")"
  url_suffix="$(jq -r '.url_suffix // ""' <<<"$endpoint_row")"
  expected_codes_json="$(jq -c '.expected_http_codes // []' <<<"$endpoint_row")"

  [[ -z "$agent_id" || -z "$endpoint_name" ]] && continue

  if [[ -n "$AGENTS_FILTER" ]] && ! in_filter "$agent_id"; then
    continue
  fi

  endpoint_url="$(resolve_endpoint_url "$health_id" "$endpoint_url" "$service_ref" "$endpoint_kind" "$url_suffix" || true)"
  [[ -n "$endpoint_url" ]] || continue

  if [[ -z "${expected_codes_json:-}" || "$expected_codes_json" == "null" ]]; then
    expected_codes_json='[]'
  fi
  if ! jq -e . <<<"$expected_codes_json" >/dev/null 2>&1; then
    expected_codes_json='[]'
  fi

  checked=$((checked + 1))
  http_code=""
  state="unhealthy"
  health_policy="default_2xx_3xx"
  expected_len="$(jq -r 'length' <<<"$expected_codes_json")"
  [[ "$expected_len" =~ ^[0-9]+$ ]] || expected_len=0
  if (( expected_len > 0 )); then
    health_policy="expected_http_codes"
  fi

  if http_code="$(curl -sS -L --max-time "$TIMEOUT" -o /dev/null -w '%{http_code}' "$endpoint_url" 2>/dev/null || true)"; then
    :
  fi

  if [[ "$http_code" =~ ^[0-9]{3}$ ]]; then
    if (( expected_len > 0 )); then
      if jq -e --arg code "$http_code" 'map(tostring) | index($code) != null' <<<"$expected_codes_json" >/dev/null 2>&1; then
        state="healthy"
        healthy=$((healthy + 1))
      else
        unhealthy=$((unhealthy + 1))
      fi
    elif (( http_code >= 200 && http_code < 400 )); then
      state="healthy"
      healthy=$((healthy + 1))
    else
      unhealthy=$((unhealthy + 1))
    fi
  else
    http_code="000"
    unhealthy=$((unhealthy + 1))
  fi

  probe="$(jq -n \
    --arg agent_id "$agent_id" \
    --arg endpoint "$endpoint_name" \
    --arg url "$endpoint_url" \
    --arg state "$state" \
    --arg http_code "$http_code" \
    --arg health_policy "$health_policy" \
    --argjson expected_http_codes "$expected_codes_json" \
    '{agent_id:$agent_id,endpoint:$endpoint,url:$url,state:$state,http_code:$http_code,health_policy:$health_policy,expected_http_codes:$expected_http_codes}')"
  probes="$(jq --argjson p "$probe" '. + [$p]' <<<"$probes")"
done < <(
  python3 - "$REGISTRY" <<'PY'
import json
import sys

import yaml

payload = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
for agent in payload.get("agents", []) or []:
    endpoints = (agent or {}).get("endpoints") or {}
    for endpoint_name, endpoint in endpoints.items():
        row = endpoint or {}
        print(json.dumps({
            "agent_id": (agent or {}).get("id", ""),
            "endpoint_name": endpoint_name,
            "health_id": row.get("health_id", ""),
            "url": row.get("url", ""),
            "service_ref": row.get("service_ref", ""),
            "endpoint_kind": row.get("endpoint_kind", ""),
            "url_suffix": row.get("url_suffix", ""),
            "expected_http_codes": row.get("expected_http_codes", []),
        }))
PY
)

status="ok"
if (( checked == 0 )); then
  status="no-probes"
elif (( unhealthy > 0 )); then
  status="degraded"
fi

data="$(jq -n \
  --arg registry "$REGISTRY" \
  --argjson checked "$checked" \
  --argjson healthy "$healthy" \
  --argjson unhealthy "$unhealthy" \
  --argjson strict "$([[ "$STRICT" -eq 1 ]] && echo true || echo false)" \
  --argjson filters "$FILTER_JSON" \
  --argjson probes "$probes" \
  '{registry:$registry,checked:$checked,healthy:$healthy,unhealthy:$unhealthy,strict:$strict,agents_filter:$filters,probes:$probes}')"

if [[ "$JSON" -eq 1 ]]; then
  jq -n \
    --arg capability "$CAPABILITY" \
    --arg schema_version "1.0" \
    --arg status "$status" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson data "$data" \
    '{capability:$capability,schema_version:$schema_version,status:$status,generated_at:$generated_at,data:$data}'
else
  echo "$CAPABILITY"
  echo "status: $status"
  echo "checked: $checked"
  echo "healthy: $healthy"
  echo "unhealthy: $unhealthy"
fi

if [[ "$STRICT" -eq 1 && "$status" != "ok" ]]; then
  exit 1
fi
