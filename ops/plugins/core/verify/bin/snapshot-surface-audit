#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


SCRIPT_PATH = Path(__file__).resolve()
DEFAULT_ROOT = SCRIPT_PATH.parents[5]
DEFAULT_CONTRACT = Path("ops/bindings/snapshot.surface.contract.yaml")
DEFAULT_CAPABILITIES = Path("ops/capabilities.yaml")
DEFAULT_ROUTING = Path("ops/bindings/routing.dispatch.yaml")
DEFAULT_LAUNCHD_RUNTIME_CONTRACT = Path("ops/bindings/launchd.runtime.contract.yaml")

TARGET_REPO_MARKERS = (
    "snapshot_surface_init",
    "ha_snapshot_init",
    "spine_resolve_target_repo",
)
FORBIDDEN_GIT_PATTERNS = (
    re.compile(r"git\s+add\b.*ops/bindings", re.MULTILINE),
    re.compile(r"git\s+commit\b", re.MULTILINE),
    re.compile(r"git\s+push\b", re.MULTILINE),
    re.compile(r"git\s+diff\b[^\n]*ops/bindings", re.MULTILINE),
)
FORBIDDEN_MANAGED_RUNTIME_PROMOTION_PATTERNS = (
    re.compile(r"\bcap\s+run\b[^\n]*\bsnapshot\.projection\.apply\b", re.MULTILINE),
    re.compile(r"\bcap\s+run\b[^\n]*--\s+--apply\b", re.MULTILINE),
)


def load_yaml(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def canonicalize_repoish(raw: str) -> Path:
    expanded = Path(raw).expanduser()
    if expanded.exists():
        try:
            result = subprocess.run(
                ["git", "-C", str(expanded), "rev-parse", "--show-toplevel"],
                check=True,
                capture_output=True,
                text=True,
            )
            return Path(result.stdout.strip()).resolve()
        except subprocess.CalledProcessError:
            return expanded.resolve()
    return expanded


def resolve_root(explicit_root: str | None) -> Path:
    if explicit_root:
        return canonicalize_repoish(explicit_root)

    explicit_target = os.environ.get("SPINE_TARGET_REPO")
    if explicit_target:
        return canonicalize_repoish(explicit_target)

    try:
        result = subprocess.run(
            ["git", "-C", str(Path.cwd()), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
        return Path(result.stdout.strip()).resolve()
    except subprocess.CalledProcessError:
        pass

    for key in ("SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(key)
        if value:
            return canonicalize_repoish(value)

    return DEFAULT_ROOT


def rel_runtime_output(tracked_binding: str) -> str:
    return f"runtime/domain-state/snapshots/{Path(tracked_binding).name}"


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def load_plist(path: Path) -> dict[str, Any]:
    with path.open("rb") as handle:
        data = plistlib.load(handle)
    return data if isinstance(data, dict) else {}


def resolve_launchd_wrapper(root: Path, plist_path: Path) -> Path | None:
    data = load_plist(plist_path)
    args = data.get("ProgramArguments")
    if not isinstance(args, list):
        return None

    for raw in args[1:]:
        if not isinstance(raw, str) or not raw.strip():
            continue
        candidate = Path(raw).expanduser()
        if not candidate.is_absolute():
            candidate = root / candidate
        candidate = candidate.resolve(strict=False)
        if candidate.suffix in {".sh", ".py"} or candidate.name.endswith((".sh", ".py")):
            return candidate
        if candidate.exists() and candidate.is_file():
            return candidate
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit governed snapshot surfaces for runtime-first contract compliance.")
    parser.add_argument("--root", help="Override target repo root.")
    parser.add_argument("--json", action="store_true", help="Emit JSON.")
    parser.add_argument("--brief", action="store_true", help="Emit single-line summary.")
    args = parser.parse_args()

    root = resolve_root(args.root)
    contract_path = root / DEFAULT_CONTRACT
    capabilities_path = root / DEFAULT_CAPABILITIES
    routing_path = root / DEFAULT_ROUTING
    launchd_runtime_contract_path = root / DEFAULT_LAUNCHD_RUNTIME_CONTRACT

    missing = [str(path) for path in (contract_path, capabilities_path, routing_path) if not path.exists()]
    if missing:
        msg = {
            "status": "FAIL",
            "root": str(root),
            "issues_total": len(missing),
            "issues": [{"code": "missing_required_file", "path": item} for item in missing],
        }
        if args.json:
            print(json.dumps(msg, sort_keys=True))
        elif args.brief:
            print(f"FAIL issues={len(missing)} root={root}")
        else:
            print("snapshot.surface.audit")
            print(f"root: {root}")
            print("status: FAIL")
            for item in missing:
                print(f"ISSUE missing_required_file path={item}")
        return 1

    contract = load_yaml(contract_path)
    capabilities_doc = load_yaml(capabilities_path)
    routing_doc = load_yaml(routing_path)
    launchd_runtime_contract = load_yaml(launchd_runtime_contract_path) if launchd_runtime_contract_path.exists() else {}
    capabilities = capabilities_doc.get("capabilities") if isinstance(capabilities_doc, dict) else None
    routing = routing_doc.get("dispatch") if isinstance(routing_doc, dict) else None
    if not isinstance(capabilities, dict):
        capabilities = capabilities_doc if isinstance(capabilities_doc, dict) else {}
    if not isinstance(routing, dict):
        routing = routing_doc if isinstance(routing_doc, dict) else {}

    governed = contract.get("governed_surfaces") or []
    automation = contract.get("automation_surfaces") or []
    prefix = str(((contract.get("policy") or {}).get("description_prefix")) or "Read-only by default:")
    suffix = str(((contract.get("policy") or {}).get("promotion_suffix")) or "tracked promotion requires --apply.")

    issues: list[dict[str, Any]] = []

    for row in governed:
        if not isinstance(row, dict):
            continue
        capability_id = str(row.get("capability") or "").strip()
        tracked_binding = str(row.get("tracked_binding") or "").strip()
        if not capability_id or not tracked_binding:
            issues.append(
                {
                    "code": "invalid_contract_surface",
                    "capability": capability_id,
                    "tracked_binding": tracked_binding,
                }
            )
            continue

        capability_row = capabilities.get(capability_id)
        routing_row = routing.get(capability_id)
        runtime_output = rel_runtime_output(tracked_binding)

        if not isinstance(capability_row, dict):
            issues.append({"code": "missing_capability", "capability": capability_id})
            continue
        if not isinstance(routing_row, dict):
            issues.append({"code": "missing_routing", "capability": capability_id})
            continue

        capability_desc = str(capability_row.get("description") or "")
        routing_desc = str(routing_row.get("description") or "")
        expected_tokens = (prefix, runtime_output, suffix)
        for token in expected_tokens:
            if token not in capability_desc:
                issues.append(
                    {
                        "code": "capability_description_drift",
                        "capability": capability_id,
                        "missing": token,
                    }
                )
            if token not in routing_desc:
                issues.append(
                    {
                        "code": "routing_description_drift",
                        "capability": capability_id,
                        "missing": token,
                    }
                )

        if capability_desc != routing_desc:
            issues.append({"code": "capability_routing_description_mismatch", "capability": capability_id})

        if str(capability_row.get("safety") or "") != "read-only":
            issues.append({"code": "capability_safety_not_read_only", "capability": capability_id})
        if str(routing_row.get("safety") or "") != "read-only":
            issues.append({"code": "routing_safety_not_read_only", "capability": capability_id})

        script_path = Path(str(capability_row.get("script_path") or "")).expanduser()
        if not script_path.is_absolute():
            script_path = root / script_path
        if not script_path.exists():
            issues.append({"code": "missing_script_path", "capability": capability_id, "path": str(script_path)})
            continue

        script_text = read_text(script_path)

        helper_based = any(marker in script_text for marker in TARGET_REPO_MARKERS)

        if not helper_based:
            issues.append({"code": "target_repo_resolution_missing", "capability": capability_id, "path": str(script_path)})

        if not helper_based and ("--apply" not in script_text or "--check" not in script_text):
            issues.append({"code": "apply_check_split_missing", "capability": capability_id, "path": str(script_path)})

        if tracked_binding in script_text and "runtime/domain-state/snapshots" not in script_text and "snapshot_surface_init" not in script_text and "ha_snapshot_init" not in script_text:
            issues.append({"code": "tracked_default_writepath", "capability": capability_id, "path": str(script_path)})

        for pattern in FORBIDDEN_GIT_PATTERNS:
            if pattern.search(script_text):
                issues.append(
                    {
                        "code": "implicit_tracked_git_mutation",
                        "capability": capability_id,
                        "path": str(script_path),
                        "pattern": pattern.pattern,
                    }
                )

    for row in automation:
        if not isinstance(row, dict):
            continue
        rel_path = str(row.get("path") or "").strip()
        if not rel_path:
            continue
        path = root / rel_path
        if not path.exists():
            issues.append({"code": "missing_automation_surface", "path": rel_path})
            continue
        text = read_text(path)
        for pattern in FORBIDDEN_GIT_PATTERNS:
            if pattern.search(text):
                issues.append(
                    {
                        "code": "automation_implicit_tracked_git_mutation",
                        "path": rel_path,
                        "pattern": pattern.pattern,
                    }
                )

    managed_runtime = launchd_runtime_contract.get("managed_runtime_worktree") or {}
    launchd_paths = launchd_runtime_contract.get("paths") or {}
    managed_labels = managed_runtime.get("required_for_labels") or []
    launchd_source_dir = Path(str(launchd_paths.get("source_dir") or "ops/plugins/infra/host/launchd")).expanduser()
    if not launchd_source_dir.is_absolute():
        launchd_source_dir = root / launchd_source_dir

    for raw_label in managed_labels:
        label = str(raw_label or "").strip()
        if not label:
            continue

        plist_path = launchd_source_dir / f"{label}.plist"
        if not plist_path.exists():
            issues.append({"code": "managed_runtime_launchd_missing_plist", "label": label, "path": str(plist_path)})
            continue

        try:
            wrapper_path = resolve_launchd_wrapper(root, plist_path)
        except Exception as exc:  # pragma: no cover - defensive parsing guard
            issues.append(
                {
                    "code": "managed_runtime_launchd_invalid_plist",
                    "label": label,
                    "path": str(plist_path),
                    "detail": str(exc),
                }
            )
            continue

        if wrapper_path is None:
            issues.append(
                {
                    "code": "managed_runtime_launchd_missing_wrapper",
                    "label": label,
                    "path": str(plist_path),
                }
            )
            continue

        if not wrapper_path.exists():
            issues.append(
                {
                    "code": "managed_runtime_launchd_missing_wrapper",
                    "label": label,
                    "path": str(wrapper_path),
                }
            )
            continue

        wrapper_text = read_text(wrapper_path)
        for pattern in FORBIDDEN_MANAGED_RUNTIME_PROMOTION_PATTERNS:
            if pattern.search(wrapper_text):
                issues.append(
                    {
                        "code": "managed_runtime_launchd_tracked_promotion",
                        "label": label,
                        "path": str(wrapper_path),
                        "pattern": pattern.pattern,
                    }
                )

    payload = {
        "capability": "snapshot.surface.audit",
        "root": str(root),
        "contract": str(contract_path),
        "governed_surfaces": len(governed),
        "automation_surfaces": len(automation),
        "issues_total": len(issues),
        "status": "PASS" if not issues else "FAIL",
        "issues": issues,
    }

    if args.json:
        print(json.dumps(payload, sort_keys=True))
    elif args.brief:
        print(
            f"{payload['status']} issues={payload['issues_total']} governed={payload['governed_surfaces']} "
            f"automation={payload['automation_surfaces']} root={payload['root']}"
        )
    else:
        print("snapshot.surface.audit")
        print(f"root: {payload['root']}")
        print(f"contract: {payload['contract']}")
        print(f"governed_surfaces: {payload['governed_surfaces']}")
        print(f"automation_surfaces: {payload['automation_surfaces']}")
        print(f"issues: {payload['issues_total']}")
        print(f"status: {payload['status']}")
        for issue in issues:
            details = " ".join(f"{key}={value}" for key, value in issue.items() if key != "code")
            print(f"ISSUE {issue['code']} {details}".rstrip())

    return 0 if not issues else 1


if __name__ == "__main__":
    sys.exit(main())
