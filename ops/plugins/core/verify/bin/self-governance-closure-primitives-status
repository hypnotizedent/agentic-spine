#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path
from typing import Any


def expand(raw: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(raw)))).resolve()


DEFAULT_ROOT = expand(Path(__file__).resolve().parents[5])


def git_top_level(start: Path) -> Path | None:
    probe = start if start.is_dir() else start.parent
    proc = subprocess.run(
        ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    stdout = proc.stdout.strip()
    return Path(stdout).resolve() if stdout else None


def resolve_target_root(explicit: str | None = None) -> Path:
    if explicit:
        return expand(explicit)
    cwd_root = git_top_level(Path.cwd())
    if cwd_root is not None:
        return cwd_root
    script_root = git_top_level(Path(__file__).resolve())
    if script_root is not None:
        return script_root
    for env_name in ("SPINE_TARGET_REPO", "SPINE_ROOT", "SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(env_name)
        if value:
            return expand(value)
    return DEFAULT_ROOT


ROOT = DEFAULT_ROOT


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="self-governance-closure-primitives-status")
    parser.add_argument("--root", help="Target checkout root.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--brief", action="store_true")
    parser.add_argument("--strict", action="store_true")
    return parser.parse_args()


def run_checked(command: list[str], *, cwd: Path, root: Path) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["SPINE_TARGET_REPO"] = str(root)
    env["SPINE_ROOT"] = str(root)
    env["SPINE_REPO"] = str(root)
    env["SPINE_CODE"] = str(root)
    return subprocess.run(command, cwd=str(cwd), text=True, capture_output=True, env=env)


def main() -> None:
    args = parse_args()
    root = resolve_target_root(args.root)

    checks: list[dict[str, str]] = []
    fail_count = 0
    warn_count = 0

    def record(name: str, status: str, detail: str) -> None:
        nonlocal fail_count, warn_count
        checks.append({"name": name, "status": status, "detail": detail})
        if status == "FAIL":
            fail_count += 1
        elif status == "WARN":
            warn_count += 1

    def run_script(name: str, command: list[str], *, expect_warn_prefix: str | None = None) -> None:
        proc = run_checked(command, cwd=root, root=root)
        stdout = (proc.stdout or "").strip()
        stderr = (proc.stderr or "").strip()
        detail = stdout or stderr or "ok"
        if proc.returncode != 0:
            record(name, "FAIL", detail.splitlines()[0] if detail else "failed")
            return
        if expect_warn_prefix and stdout.startswith(expect_warn_prefix):
            record(name, "WARN", stdout.splitlines()[0])
            return
        record(name, "PASS", detail.splitlines()[0] if detail else "ok")

    run_script(
        "topology_closure",
        ["bash", "ops/plugins/infra/bin/closure-topology-status", "--json"],
    )
    run_script(
        "endpoint_catalog_projection",
        ["python3", "ops/plugins/infra/bin/service-endpoint-catalog-build", "--root", str(root), "--check"],
    )
    run_script(
        "backup_locality_projection",
        ["python3", "ops/plugins/core/authority/bin/backup-locality-projection-build", "--root", str(root), "--check"],
    )
    run_script(
        "backup_locality_audit",
        ["python3", "ops/plugins/infra/bin/backup-locality-audit", "--root", str(root), "--brief", "--strict"],
    )
    run_script(
        "relocation_projection",
        ["python3", "ops/plugins/infra/bin/service-relocation-closure-build", "--check"],
    )
    run_script(
        "relocation_audit",
        ["python3", "ops/plugins/infra/bin/service-closure-audit", "--format", "text", "--strict"],
    )
    run_script(
        "lifecycle_projection",
        ["python3", "ops/plugins/core/authority/bin/service-data-lifecycle-projection-build", "--check", "--verify"],
    )
    run_script(
        "self_governance_projection",
        ["python3", "ops/plugins/core/authority/bin/spine-self-governance-projection-build", "--root", str(root), "--check"],
    )
    run_script(
        "self_governance_status",
        ["python3", "ops/plugins/core/verify/bin/spine-self-governance-status", "--root", str(root), "--brief", "--strict"],
        expect_warn_prefix="WARN ",
    )
    run_script(
        "tenant_profile",
        ["bash", "ops/plugins/core/authority/bin/tenant-profile-validate", "--root", str(root), "--profile", "ops/bindings/tenant.profile.yaml"],
    )
    run_script(
        "tenant_storage",
        ["bash", "ops/plugins/core/authority/bin/tenant-storage-audit", "--root", str(root)],
    )

    overall = "PASS" if fail_count == 0 else "FAIL"
    if fail_count == 0 and warn_count > 0:
        overall = "WARN"

    if args.json:
        print(
            json.dumps(
                {
                    "capability": "self-governance.closure.primitives.status",
                    "status": overall.lower(),
                    "fail": fail_count,
                    "warn": warn_count,
                    "checks": checks,
                },
                indent=2,
                sort_keys=False,
            )
        )
        raise SystemExit(1 if args.strict and fail_count > 0 else (1 if fail_count > 0 else 0))

    if args.brief:
        print(f"{overall} issues={fail_count} warnings={warn_count} checks={len(checks)}")
        raise SystemExit(1 if fail_count > 0 else 0)

    print("self-governance.closure.primitives.status")
    print(f"status: {overall}")
    print(f"fail: {fail_count}")
    print(f"warn: {warn_count}")
    for check in checks:
        print(f"[{check['status']}] {check['name']}: {check['detail']}")
    raise SystemExit(1 if fail_count > 0 else 0)


if __name__ == "__main__":
    main()
