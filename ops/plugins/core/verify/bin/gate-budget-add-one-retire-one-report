#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
from datetime import date, datetime, timezone
from pathlib import Path

import yaml


def fail(message: str) -> None:
    raise SystemExit(f"gate-budget-add-one-retire-one-report FAIL: {message}")


def load_yaml(path: Path) -> dict:
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception as exc:
        fail(f"unable to parse yaml {path}: {exc}")
    if not isinstance(data, dict):
        fail(f"yaml root must be map: {path}")
    return data


def resolve_path(root: Path, raw: str, fallback: Path) -> Path:
    text = str(raw).strip()
    if not text:
        return fallback
    candidate = Path(text)
    return candidate if candidate.is_absolute() else root / candidate


def parse_date(value: str) -> date | None:
    text = (value or "").strip()
    if not text:
        return None
    try:
        return date.fromisoformat(text[:10])
    except ValueError:
        return None


def resolve_repo_root(explicit_root: str | None) -> Path:
    if explicit_root:
        return Path(explicit_root).resolve()

    script_dir = Path(__file__).resolve().parent
    try:
        git_root = subprocess.check_output(
            ["git", "-C", str(script_dir), "rev-parse", "--show-toplevel"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        git_root = ""
    if git_root:
        return Path(git_root).resolve()

    script_root = Path(__file__).resolve().parents[5]
    if script_root.exists():
        return script_root.resolve()

    env_root = os.environ.get("SPINE_TARGET_REPO") or os.environ.get("SPINE_ROOT")
    if env_root:
        return Path(env_root).resolve()

    return script_root.resolve()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Generate gate add-one-retire-one budget evidence")
    parser.add_argument("--root", help="Optional repo root override for tests or detached audits")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    root = resolve_repo_root(args.root)
    reports_root = Path(
        os.environ.get("SPINE_VERIFY_REPORTS_ROOT")
        or (
            Path(os.environ.get("SPINE_EVIDENCE_ROOT") or (Path.home() / "code/.evidence/spine"))
            / "reports/verify"
        )
    )
    reports_root.mkdir(parents=True, exist_ok=True)
    contract_path = root / "ops/bindings/gate.budget.add_one_retire_one.contract.yaml"
    if not contract_path.exists():
        fail(f"missing contract: {contract_path}")

    contract = load_yaml(contract_path)
    sources = contract.get("sources", {}) if isinstance(contract.get("sources"), dict) else {}
    baseline = contract.get("baseline", {}) if isinstance(contract.get("baseline"), dict) else {}
    report_cfg = contract.get("report", {}) if isinstance(contract.get("report"), dict) else {}
    coverage = contract.get("coverage", {}) if isinstance(contract.get("coverage"), dict) else {}
    mode = str(contract.get("mode", "report-only")).strip() or "report-only"

    registry_path = resolve_path(root, str(sources.get("gate_registry", "")), root / "ops/bindings/gate.registry.yaml")
    rec_json_path = resolve_path(
        root,
        str(sources.get("recommendations_json", "")),
        reports_root / "W67_GATE_PORTFOLIO_RECOMMENDATIONS.json",
    )
    triage_path = resolve_path(
        root,
        str(sources.get("triage_yaml", "")),
        root / "ops/bindings/gate.portfolio.triage.yaml",
    )
    report_path = resolve_path(
        root,
        str(report_cfg.get("markdown_path", "")),
        reports_root / "W67_GATE_BUDGET_REPORT.md",
    )

    if not registry_path.exists():
        fail(f"missing gate registry: {registry_path}")

    registry = load_yaml(registry_path)
    gates = registry.get("gates", [])
    if not isinstance(gates, list):
        fail("gate registry malformed (gates must be list)")

    current_active_invariants = sum(
        1 for gate in gates if gate.get("gate_class") == "invariant" and not bool(gate.get("retired", False))
    )
    baseline_active_invariants = int(baseline.get("active_invariant_count", current_active_invariants))
    delta = current_active_invariants - baseline_active_invariants
    invariants_added = max(delta, 0)
    invariants_retired = max(-delta, 0)

    recommendations: list[dict] = []
    rec_parse_note = "recommendations source available"
    recommendations_available = False
    if rec_json_path.exists():
        try:
            rec_obj = json.loads(rec_json_path.read_text(encoding="utf-8"))
            rec_list = rec_obj.get("recommendations", [])
            if isinstance(rec_list, list):
                recommendations = [row for row in rec_list if isinstance(row, dict)]
                recommendations_available = True
            else:
                rec_parse_note = "recommendations source malformed (recommendations must be list)"
        except Exception:
            rec_parse_note = "recommendations source unreadable"
    else:
        rec_parse_note = "recommendations source missing"

    triage_exists = triage_path.exists()
    triage_note = "triage source available" if triage_exists else "triage source missing"
    triage_entries: list[dict] = []
    triage_updated = ""
    triage_recommendations_file = ""
    if triage_exists:
        triage = load_yaml(triage_path)
        triage_updated = str(triage.get("updated", "")).strip()
        triage_entries = triage.get("triage_entries", []) if isinstance(triage.get("triage_entries"), list) else []
        triage_recommendations_file = str(
            (triage.get("source_recommendations", {}) or {}).get("file", "")
        ).strip()

    coverage_decisions = {
        str(x).strip()
        for x in coverage.get("triage_decisions_count_as_plan", [])
        if str(x).strip()
    }
    actionable_plan_count = sum(
        1
        for row in triage_entries
        if isinstance(row, dict) and str(row.get("triage_decision", "")).strip() in coverage_decisions
    )

    today = datetime.now(timezone.utc).date()
    overdue_count = 0
    for row in triage_entries:
        if not isinstance(row, dict):
            continue
        due_date = parse_date(str(row.get("due", "")).strip())
        if due_date and due_date < today:
            overdue_count += 1

    triage_recommendations_valid = bool(triage_recommendations_file) and resolve_path(
        root, triage_recommendations_file, rec_json_path
    ) == rec_json_path
    triage_status = "current"
    if not triage_exists:
        triage_status = "missing"
    elif overdue_count > 0:
        triage_status = "overdue"
    elif not triage_recommendations_valid:
        triage_status = "invalid_source"

    budget_violations = max(0, invariants_added - actionable_plan_count)
    enforcement_failures: list[str] = []
    if not recommendations_available:
        enforcement_failures.append("recommendations_missing")
    if not triage_exists:
        enforcement_failures.append("triage_missing")
    elif not triage_recommendations_valid:
        enforcement_failures.append("triage_source_invalid")
    elif overdue_count > 0:
        enforcement_failures.append("triage_overdue")
    if budget_violations > 0:
        enforcement_failures.append("budget_coverage_missing")

    generated = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    report_path.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# W67 Gate Budget Report",
        "",
        f"Generated: {generated}",
        f"Contract: `{contract_path}`",
        f"Registry: `{registry_path}`",
        f"Recommendations: `{rec_json_path}` ({rec_parse_note})",
        f"Triage: `{triage_path}` ({triage_note})",
        "",
        "## Metrics",
        "",
        f"- baseline_active_invariants: **{baseline_active_invariants}**",
        f"- current_active_invariants: **{current_active_invariants}**",
        f"- invariants_added: **{invariants_added}**",
        f"- invariants_retired: **{invariants_retired}**",
        f"- delta: **{delta}**",
        f"- actionable_plan_count: **{actionable_plan_count}**",
        f"- budget_violations: **{budget_violations}**",
        f"- triage_status: **{triage_status}**",
        f"- triage_entries: **{len(triage_entries)}**",
        f"- triage_overdue_entries: **{overdue_count}**",
        "",
        "## Enforcement",
        "",
        f"- mode: **{mode}**",
        f"- failures: **{', '.join(enforcement_failures) or 'none'}**",
    ]
    report_path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    print("verify.gate_budget.report")
    print(f"baseline_active_invariants: {baseline_active_invariants}")
    print(f"current_active_invariants: {current_active_invariants}")
    print(f"invariants_added: {invariants_added}")
    print(f"invariants_retired: {invariants_retired}")
    print(f"delta: {delta}")
    print(f"actionable_plan_count: {actionable_plan_count}")
    print(f"budget_violations: {budget_violations}")
    print(f"triage_status: {triage_status}")
    print(f"triage_overdue_entries: {overdue_count}")
    print(f"enforcement_failures: {','.join(enforcement_failures) or 'none'}")
    print(f"report_md: {report_path}")

    if mode == "enforce" and enforcement_failures:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
