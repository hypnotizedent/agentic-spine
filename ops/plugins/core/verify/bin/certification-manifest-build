#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml


DEFAULT_REPOS = [
    ("agentic-spine", "/Users/ronnyworks/code/agentic-spine"),
    ("agentic-foundation", "/Users/ronnyworks/code/agentic-foundation"),
]

SCRIPT = Path(__file__).resolve()
ROOT = SCRIPT.parents[5]
BASELINE_BIN = ROOT / "ops/plugins/core/verify/bin/certification-baseline-inventory"
IGNORE_PREFIXES = (
    "docs/reference/generated/certification/",
)


def _repo_specs(raw: list[str] | None) -> list[tuple[str, Path]]:
    if not raw:
        return [(label, Path(path).expanduser().resolve()) for label, path in DEFAULT_REPOS]
    specs: list[tuple[str, Path]] = []
    for item in raw:
        if "=" not in item:
            raise SystemExit(f"invalid --repo value: {item!r}")
        label, raw_path = item.split("=", 1)
        specs.append((label, Path(raw_path).expanduser().resolve()))
    return specs


def _run_baseline(repo_specs: list[tuple[str, Path]]) -> dict[str, Any]:
    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as handle:
        baseline_path = Path(handle.name)
    try:
        cmd = [str(BASELINE_BIN), "--json-out", str(baseline_path)]
        for label, path in repo_specs:
            cmd.extend(["--repo", f"{label}={path}"])
        subprocess.run(cmd, check=True)
        return json.loads(baseline_path.read_text(encoding="utf-8"))
    finally:
        baseline_path.unlink(missing_ok=True)


def _role_for(record: dict[str, Any]) -> str:
    classification = str(record.get("classification", "other"))
    path = str(record.get("path", "")).replace("\\", "/").lower()
    if classification in {"projection", "generated"}:
        return "projection"
    if path.startswith("docs/evidence/") or path.startswith("fixtures/") or path.endswith(".receipt.md"):
        return "evidence"
    if path.startswith("docs/governance/") or path.startswith("docs/core/") or path.startswith("docs/contracts/") or path.startswith("docs/product/") or path.startswith("docs/agents/"):
        return "authority"
    return "runtime"


def _status_for(record: dict[str, Any]) -> str:
    path = str(record.get("path", "")).replace("\\", "/").lower()
    if path.startswith("docs/archive/") or path.startswith("ops/archive/") or path.endswith(".deprecated.yaml") or "tombstoned" in path:
        return "deprecated"
    if "shim" in path or "compat" in path or "legacy" in path:
        return "compatibility"
    return "active"


def _policy_for(role: str) -> str:
    return "allowed" if role in {"projection", "evidence"} else "forbidden"


def _rationale_for(record: dict[str, Any], role: str, status: str) -> str:
    if status == "deprecated":
        return "deprecated or archived surface kept for history; no inline certification expected"
    if status == "compatibility":
        return "compatibility surface retained for transition; inline certification discouraged"
    if role == "projection":
        return "projection surface; explicit projection markers are part of the certification contract"
    if role == "evidence":
        return "evidence/report surface; generated evidence can carry inline markers"
    if role == "authority":
        return "authoritative surface; certification is manifest-covered, not inline-authoritative"
    return "runtime/helper surface; manifest-covered, not inline-certified"


def _manifest_entry(record: dict[str, Any]) -> dict[str, Any]:
    role = _role_for(record)
    status = _status_for(record)
    inline_present = bool(record["inline_certification_present"])
    inline_allowed = bool(record["inline_certification_allowed"])
    coverage_basis = "inline" if inline_allowed and inline_present else "manifest"
    return {
        "repo": record["repo"],
        "repo_root": record["repo_root"],
        "path": record["path"],
        "top_folder": record["top_folder"],
        "subfolder": record["subfolder"],
        "classification": record["classification"],
        "status": status,
        "certification_role": role,
        "inline_certification_policy": _policy_for(role),
        "inline_certification_allowed": inline_allowed,
        "inline_certification_present": inline_present,
        "coverage_basis": coverage_basis,
        "rationale": _rationale_for(record, role, status),
        "marker_hits": list(record.get("marker_hits") or []),
    }


def _repo_manifest(repo_summary: dict[str, Any], files: list[dict[str, Any]]) -> dict[str, Any]:
    basis_counts = {"inline": 0, "manifest": 0}
    for row in files:
        basis_counts[row["coverage_basis"]] += 1
    return {
        "label": repo_summary["label"],
        "repo_root": repo_summary["repo_root"],
        "tracked_files": repo_summary["tracked_files"],
        "counts": {
            "top_folders": repo_summary["top_folders"],
            "subfolders": repo_summary["subfolders"],
            "classification_counts": repo_summary["classification_counts"],
            "inline_certification_allowed": repo_summary["inline_certification_allowed"],
            "inline_certification_present": repo_summary["inline_certification_present"],
            "inline_certification_blocked": repo_summary["inline_certification_blocked"],
            "coverage_basis_counts": basis_counts,
        },
        "files": files,
    }


def _render_counts_table(title: str, counts: dict[str, Any]) -> list[str]:
    lines = ["", f"### {title}", "", "| Item | Count |", "|---|---:|"]
    for key, value in sorted(counts.items()):
        lines.append(f"| {key} | {value} |")
    return lines


def _render_markdown(payload: dict[str, Any]) -> str:
    lines = [
        "# Certification Manifest",
        "",
        f"- Generated at: `{payload['generated_at']}`",
        f"- Baseline source: `{payload['baseline_source']}`",
        f"- Repos covered: `{len(payload['repos'])}`",
        "",
        "## Coverage Summary",
        "",
        "| Repo | Tracked | Inline policy allowed | Inline present | Blocked |",
        "|---|---:|---:|---:|---:|",
    ]
    for repo in payload["repos"]:
        counts = repo["counts"]
        lines.append(
            f"| {repo['label']} | {repo['tracked_files']} | {counts['inline_certification_allowed']} | "
            f"{counts['inline_certification_present']} | {counts['inline_certification_blocked']} |"
        )
    for repo in payload["repos"]:
        counts = repo["counts"]
        lines.extend(
            [
                "",
                f"## Repo: {repo['label']}",
                "",
                f"- Repo root: `{repo['repo_root']}`",
                f"- Tracked files: `{repo['tracked_files']}`",
                f"- Inline cert allowed: `{counts['inline_certification_allowed']}`",
                f"- Inline cert present: `{counts['inline_certification_present']}`",
                f"- Inline cert blocked: `{counts['inline_certification_blocked']}`",
            ]
        )
        lines.extend(_render_counts_table("Classification Counts", counts["classification_counts"]))
        lines.extend(_render_counts_table("Top Folders", counts["top_folders"]))
        lines.extend(_render_counts_table("Subfolders", counts["subfolders"]))
        lines.extend(_render_counts_table("Coverage Basis", counts["coverage_basis_counts"]))
    lines.extend(["", "## Roles", "", "| Role | Count |", "|---|---:|"])
    role_counts: dict[str, int] = {}
    basis_counts: dict[str, int] = {"inline": 0, "manifest": 0}
    for repo in payload["repos"]:
        for row in repo["files"]:
            role_counts[row["certification_role"]] = role_counts.get(row["certification_role"], 0) + 1
            basis_counts[row["coverage_basis"]] = basis_counts.get(row["coverage_basis"], 0) + 1
    for role, count in sorted(role_counts.items()):
        lines.append(f"| {role} | {count} |")
    lines.extend(["", "## Coverage Basis", "", "| Basis | Count |", "|---|---:|"])
    for basis, count in sorted(basis_counts.items()):
        lines.append(f"| {basis} | {count} |")
    lines.extend(
        [
            "",
            "## Notes",
            "",
            "- Manifest coverage is file-level and can be checked without hand-editing tracked files.",
            "- Certification artifacts are expected to use their own manifest rules and do not require recursive coverage.",
        ]
    )
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Build manifest-backed certification baseline")
    parser.add_argument("--repo", action="append", metavar="LABEL=PATH")
    parser.add_argument("--yaml-out", required=True)
    parser.add_argument("--markdown-out", required=True)
    parser.add_argument("--manifest-title", default="CERTIFICATION_MANIFEST")
    args = parser.parse_args()

    repo_specs = _repo_specs(args.repo)
    baseline = _run_baseline(repo_specs)
    repos_by_label = {repo["label"]: repo for repo in baseline["repos"]}
    files_by_repo: dict[str, list[dict[str, Any]]] = {label: [] for label, _ in repo_specs}
    for record in baseline["files"]:
        rel = str(record["path"]).replace("\\", "/")
        if any(rel.startswith(prefix) for prefix in IGNORE_PREFIXES):
            continue
        files_by_repo[record["repo"]].append(_manifest_entry(record))

    repos = [_repo_manifest(repos_by_label[label], files_by_repo[label]) for label, _ in repo_specs]
    payload = {
        "manifest_title": args.manifest_title,
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "baseline_source": "ops/plugins/core/verify/bin/certification-baseline-inventory",
        "coverage_exclusions": list(IGNORE_PREFIXES),
        "repos": repos,
    }

    yaml_path = Path(args.yaml_out).expanduser()
    md_path = Path(args.markdown_out).expanduser()
    yaml_path.parent.mkdir(parents=True, exist_ok=True)
    md_path.parent.mkdir(parents=True, exist_ok=True)
    yaml_path.write_text(yaml.safe_dump(payload, sort_keys=False, allow_unicode=False), encoding="utf-8")
    md_path.write_text(_render_markdown(payload), encoding="utf-8")
    print(f"certification-manifest-build PASS: {yaml_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
