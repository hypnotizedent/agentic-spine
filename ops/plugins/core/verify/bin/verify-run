#!/usr/bin/env bash
set -euo pipefail

_VR_COMPUTED="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
if [[ -n "${SPINE_ROOT:-}" && "${SPINE_ROOT}" != "$_VR_COMPUTED" ]]; then
  echo "WARN: ambient SPINE_ROOT=$SPINE_ROOT disagrees with computed=$_VR_COMPUTED (using computed)" >&2
fi
ROOT="$_VR_COMPUTED"

VERIFY_TOPOLOGY="$ROOT/ops/plugins/core/verify/bin/verify-topology"
VERIFY_ENGINE="$ROOT/ops/plugins/core/verify/bin/verify-engine"
VERIFY_ENGINE_HONESTY="$ROOT/ops/plugins/core/verify/bin/verify-engine-honesty"
VERIFY_SPINE_SCOPE_HELPER="$ROOT/ops/plugins/core/verify/lib/spine_scope_gate_set.py"
RECOVERY_DISPATCH="$ROOT/ops/plugins/core/recovery/bin/recovery-dispatch"
RAG_DIRECT="$ROOT/ops/plugins/infra/rag/bin/rag-direct"
VERIFY_BASH_BIN="${SPINE_VERIFY_BASH_BIN:-}"
if [[ -z "$VERIFY_BASH_BIN" ]]; then
  if [[ -x /opt/homebrew/bin/bash ]]; then
    VERIFY_BASH_BIN="/opt/homebrew/bin/bash"
  else
    VERIFY_BASH_BIN="$(command -v bash)"
  fi
fi

fail() {
  echo "verify.run FAIL: $*" >&2
  exit 1
}

[[ -x "$VERIFY_TOPOLOGY" ]] || fail "missing verify runtime: $VERIFY_TOPOLOGY"
[[ -x "$VERIFY_ENGINE" ]] || fail "missing engine verify: $VERIFY_ENGINE"
[[ -x "$VERIFY_ENGINE_HONESTY" ]] || fail "missing engine honesty verify: $VERIFY_ENGINE_HONESTY"

usage() {
  cat <<'USAGE'
verify.run

Usage:
  verify-run engine [--json]                  Fast platform engine smoke (spine truth)
  verify-run honesty [--json]                 Engine orchestration proof (spine truth)
  verify-run spine [--json]                   Honest spine-only verify scope (spine truth)
  verify-run infra [--json] [--shadow]        Preferred estate/workload health scope
  verify-run domain <domain_id> [--json]      Domain-scoped infrastructure gates (estate health)
  verify-run release [--json] [--shadow]      Full infrastructure gate set (estate health)

Scopes:
  engine  => platform engine smoke test; answers spine/object truth
  honesty => engine orchestration proof; answers spine/object truth
  spine   => curated spine-only executable set + engine/honesty surfaces
  infra   => infrastructure workload baseline; answers estate/workload health only
  domain  => estate/workload health gates for one domain
  release => full estate/workload health gate set

Flags:
  --alias-source <name>  internal compatibility marker for deprecated alias surfaces
  --shadow   accepted for compatibility and ignored by spine-lite
  --recover  on fail, execute matching recovery-dispatch for D### failures when available
  --json     emit machine-readable JSON output
USAGE
}

json_mode=0
shadow_mode=0
recover_mode=0
alias_source=""

if [[ "${1:-}" == "--" ]]; then
  shift
fi

scope="${1:-}"
shift || true

case "$scope" in
  engine|honesty|spine|infra|domain|release) ;;
  -h|--help|"") usage; exit 0 ;;
  fast) fail "scope 'fast' has been removed; use 'infra' instead" ;;
  *) fail "unknown scope '$scope' (expected engine|honesty|spine|infra|domain|release)" ;;
esac

target_domain=""
if [[ "$scope" == "domain" ]]; then
  [[ $# -ge 1 ]] || fail "domain scope requires <domain_id>"
  target_domain="$1"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --alias-source)
      alias_source="${2:-}"
      [[ -n "$alias_source" ]] || fail "--alias-source requires <name>"
      shift 2
      ;;
    --json) json_mode=1 ;;
    --shadow) shadow_mode=1 ;;
    --recover) recover_mode=1 ;;
    *) fail "unknown argument: $1" ;;
  esac
  shift
done

surface_recovery() {
  local scope_name="$1"
  local result_json="$2"
  local fail_id=""
  local failure_class="deterministic"

  fail_id="$(jq -r '.blocking_fail_ids[0] // .failing_ids[0] // empty' <<<"$result_json" 2>/dev/null || true)"
  [[ "$fail_id" == D* ]] || {
    echo "recovery.dispatch hint: scope=$scope_name fail_id=${fail_id:-none} (no D### match on this verify surface)" >&2
    return 0
  }

  echo "recovery.dispatch hint: ops cap run recovery.dispatch -- --gate-id $fail_id --failure-class $failure_class" >&2
  [[ "$recover_mode" -eq 1 ]] || return 0
  [[ -x "$RECOVERY_DISPATCH" ]] || fail "missing recovery dispatch: $RECOVERY_DISPATCH"
  echo "recovery.dispatch: scope=$scope_name gate_id=$fail_id failure_class=$failure_class" >&2
  "$RECOVERY_DISPATCH" --gate-id "$fail_id" --failure-class "$failure_class"
}

scope_truth_plane() {
  local mode="$1"
  case "$mode" in
    engine|honesty|spine) echo "spine_truth" ;;
    infra|release|domain:*) echo "estate_health" ;;
    *) echo "unknown" ;;
  esac
}

scope_reading() {
  local mode="$1"
  case "$mode" in
    engine|honesty|spine)
      echo "Spine/object truth surface. Reads engine, governance, entry, orchestration, and spine-only execution truth."
      ;;
    infra|release|domain:*)
      echo "Estate/workload health surface. Reads runtime host, workload, service, backup, and network state; does not answer packet, loop, or governance truth."
      ;;
    *)
      echo "Unknown scope reading."
      ;;
  esac
}

scope_may_block_spine_truth() {
  local mode="$1"
  case "$mode" in
    engine|honesty|spine) echo true ;;
    infra|release|domain:*) echo false ;;
    *) echo false ;;
  esac
}

preferred_scope_for_alias() {
  local source="$1"
  [[ -n "$source" ]] || return 0
  echo "infra"
}

preferred_capability_for_alias() {
  local source="$1"
  [[ -n "$source" ]] || return 0
  echo "verify.infra.run"
}

emit_alias_deprecation_note() {
  local source="$1"
  [[ -n "$source" ]] || return 0
  echo "verify.run deprecation: '$source' is a compatibility alias for estate/workload health. Prefer 'infra' or 'verify.infra.run'." >&2
}

emit_scope_note() {
  local mode="$1"
  case "$mode" in
    engine|honesty|spine)
      echo "verify.run note: $mode answers spine/object truth." >&2
      ;;
    infra|release|domain:*)
      echo "verify.run note: $mode answers estate/workload health only; do not treat it as packet/loop/governance truth." >&2
      ;;
  esac
}

run_and_wrap_json() {
  local mode="$1"
  shift
  local output rc truth_plane reading may_block_spine_truth preferred_scope preferred_capability
  truth_plane="$(scope_truth_plane "$mode")"
  reading="$(scope_reading "$mode")"
  may_block_spine_truth="$(scope_may_block_spine_truth "$mode")"
  preferred_scope="$(preferred_scope_for_alias "$alias_source")"
  preferred_capability="$(preferred_capability_for_alias "$alias_source")"

  set +e
  output="$("$@" 2>/dev/null)"
  rc=$?
  set -e

  if [[ -z "$output" ]] || ! jq -e . >/dev/null 2>&1 <<<"$output"; then
    output='{"total":0,"pass":0,"fail":1,"warn":0,"skipped_inline":0,"skipped_retired":0,"skipped_network":0,"receipt_integrity_warnings":0,"failing_ids":[],"warning_ids":[],"blocking_fail_ids":[],"non_blocking_fail_ids":[]}'
    rc=1
  fi

  jq -n \
    --arg mode "$mode" \
    --arg truth_plane "$truth_plane" \
    --arg scope_reading "$reading" \
    --arg alias_source "$alias_source" \
    --arg preferred_scope "$preferred_scope" \
    --arg preferred_capability "$preferred_capability" \
    --argjson may_block_spine_truth "$may_block_spine_truth" \
    --argjson shadow_mode "$shadow_mode" \
    --argjson result "$output" \
    '{
      mode: $mode,
      truth_plane: $truth_plane,
      scope_reading: $scope_reading,
      alias_source: (if $alias_source == "" then null else $alias_source end),
      deprecated_alias_used: ($alias_source != ""),
      preferred_scope: (if $preferred_scope == "" then null else $preferred_scope end),
      preferred_capability: (if $preferred_capability == "" then null else $preferred_capability end),
      may_block_spine_truth: $may_block_spine_truth,
      shadow_mode_ignored: ($shadow_mode == 1),
      total: ($result.total // 0),
      pass: ($result.pass // 0),
      fail: ($result.fail // 0),
      warn: ($result.warn // 0),
      skipped_inline: ($result.skipped_inline // 0),
      skipped_retired: ($result.skipped_retired // 0),
      skipped_network: ($result.skipped_network // 0),
      receipt_integrity_warnings: ($result.receipt_integrity_warnings // 0),
      failing_ids: ($result.failing_ids // []),
      warning_ids: ($result.warning_ids // []),
      blocking_fail_ids: ($result.blocking_fail_ids // []),
      non_blocking_fail_ids: ($result.non_blocking_fail_ids // [])
    }'

  return "$rc"
}

run_scope() {
  local mode="$1"; shift
  local rc=0

  if [[ "$json_mode" -eq 1 ]]; then
    local result
    set +e; result="$(run_and_wrap_json "$mode" "$@" --json)"; rc=$?; set -e
    [[ "$rc" -eq 0 ]] || surface_recovery "$mode" "$result"
    printf '%s\n' "$result"
    return "$rc"
  fi

  emit_alias_deprecation_note "$alias_source"
  emit_scope_note "$mode"

  # Subshell scopes EXIT trap — no leak into caller.
  # Shell functions (surface_recovery etc.) inherited by (...) subshell.
  (
    _tmpout="$(mktemp)"
    trap 'rm -f "$_tmpout"' EXIT

    set +e; "$@" 2>&1 | tee "$_tmpout"; rc=${PIPESTATUS[0]}; set -e

    if [[ "$rc" -ne 0 ]]; then
      local fail_ids json_arr
      # Extract D### gate IDs only (recovery dispatch only handles D-series)
      fail_ids="$(grep -oE 'D[0-9]+' "$_tmpout" | sort -u || true)"
      if [[ -n "$fail_ids" ]]; then
        json_arr="$(printf '%s\n' $fail_ids | jq -R . | jq -sc .)"
        surface_recovery "$mode" "$(jq -n --argjson ids "$json_arr" '{blocking_fail_ids: $ids}')"
      fi
    fi
    exit "$rc"
  )
  return $?
}

run_rag_domain_scope() {
  local mode="domain:rag"
  local health_rc=0 quality_rc=0 overall_rc=0
  local health_json quality_json health_summary quality_summary failing_json

  [[ -x "$RAG_DIRECT" ]] || fail "missing RAG runtime: $RAG_DIRECT"

  if [[ "$json_mode" -eq 0 ]]; then
    emit_scope_note "$mode"
    echo "verify.run domain rag"
    echo "  direct RAG health: rag.direct.health"
    echo "  direct RAG quality: rag.direct.quality"
  fi

  set +e
  health_json="$("$RAG_DIRECT" health --json 2>/dev/null)"
  health_rc=$?
  quality_json="$("$RAG_DIRECT" quality --json 2>/dev/null)"
  quality_rc=$?
  set -e

  jq -e . >/dev/null 2>&1 <<<"$health_json" || {
    health_json='{"ok":false,"error":"rag.direct.health did not emit valid JSON"}'
    health_rc=1
  }
  jq -e . >/dev/null 2>&1 <<<"$quality_json" || {
    quality_json='{"ok":false,"error":"rag.direct.quality did not emit valid JSON"}'
    quality_rc=1
  }

  [[ "$health_rc" -eq 0 ]] || overall_rc=1
  [[ "$quality_rc" -eq 0 ]] || overall_rc=1

  health_summary="$(jq -c --argjson rc "$health_rc" '. + {capability:"rag.direct.health", exit_code:$rc}' <<<"$health_json")"
  quality_summary="$(jq -c --argjson rc "$quality_rc" '. + {capability:"rag.direct.quality", exit_code:$rc}' <<<"$quality_json")"
  failing_json="$(jq -n \
    --argjson health_rc "$health_rc" \
    --argjson quality_rc "$quality_rc" \
    '[
      (if $health_rc == 0 then empty else "rag.direct.health" end),
      (if $quality_rc == 0 then empty else "rag.direct.quality" end)
    ]')"

  if [[ "$json_mode" -eq 1 ]]; then
    jq -n \
      --arg mode "$mode" \
      --arg truth_plane "estate_health" \
      --arg scope_reading "$(scope_reading "$mode")" \
      --argjson may_block_spine_truth false \
      --argjson total 2 \
      --argjson pass "$((2 - $(jq 'length' <<<"$failing_json")))" \
      --argjson fail "$(jq 'length' <<<"$failing_json")" \
      --argjson failing_ids "$failing_json" \
      --argjson health "$health_summary" \
      --argjson quality "$quality_summary" \
      '{
        mode: $mode,
        truth_plane: $truth_plane,
        scope_reading: $scope_reading,
        may_block_spine_truth: $may_block_spine_truth,
        total: $total,
        pass: $pass,
        fail: $fail,
        warn: 0,
        skipped_inline: 0,
        skipped_retired: 0,
        skipped_network: 0,
        receipt_integrity_warnings: 0,
        failing_ids: $failing_ids,
        warning_ids: [],
        blocking_fail_ids: [],
        non_blocking_fail_ids: $failing_ids,
        checks: [$health, $quality]
      }'
    return "$overall_rc"
  fi

  if [[ "$health_rc" -eq 0 ]]; then
    echo "  PASS rag.direct.health"
  else
    echo "  FAIL rag.direct.health"
    jq -r '(.error // .message // "health failed") | "    " + .' <<<"$health_json"
  fi

  if [[ "$quality_rc" -eq 0 ]]; then
    echo "  PASS rag.direct.quality"
  else
    echo "  FAIL rag.direct.quality"
    jq -r '(.error // .message // "quality failed") | "    " + .' <<<"$quality_json"
  fi

  return "$overall_rc"
}

run_timed_shell() {
  local timeout_sec="$1"
  local cmd="$2"
  local tmp="$3"
  local elapsed=0
  local pid rc

  (
    cd "$ROOT"
    "$VERIFY_BASH_BIN" -lc "$cmd"
  ) >"$tmp" 2>&1 &
  pid=$!

  while kill -0 "$pid" >/dev/null 2>&1; do
    if [[ "$elapsed" -ge "$timeout_sec" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      return 124
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  wait "$pid"
  rc=$?
  return "$rc"
}

json_array() {
  if [[ "$#" -eq 0 ]]; then
    printf '[]\n'
    return 0
  fi
  printf '%s\n' "$@" | jq -R -s 'split("\n") | map(select(length > 0))'
}

estate_health_check_status() {
  local check_id="$1"
  local output_path="$2"
  local rc="$3"

  if [[ "$rc" -eq 124 ]]; then
    echo "warn"
    return 0
  fi
  if [[ "$rc" -ne 0 ]]; then
    echo "warn"
    return 0
  fi

  case "$check_id" in
    backup-estate)
      if grep -q '"status"[[:space:]]*:[[:space:]]*"partial"' "$output_path"; then
        echo "warn"
      else
        echo "pass"
      fi
      ;;
    payload-custody)
      if grep -q '"stale_or_unproved"[[:space:]]*:[[:space:]]*[1-9]' "$output_path"; then
        echo "warn"
      else
        echo "pass"
      fi
      ;;
    *)
      echo "pass"
      ;;
  esac
}

run_estate_health_scope() {
  local mode="infra"
  local timeout_sec="${SPINE_VERIFY_INFRA_TIMEOUT_SEC:-40}"
  local tmpdir check_line check_id label cmd output_path rc status reason
  local pass_count=0 warn_count=0 fail_count=0 total_count=0
  local warning_ids=() failing_ids=()
  local check_json_lines=()

  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN

  local checks=(
    "node-recovery-pve-r620|node recovery and power control readback|./ops/plugins/infra/bin/node-recovery-status --node pve-r620 --json"
    "payload-custody|storage/payload custody readback|./ops/plugins/infra/bin/payload-custody-status --json"
    "backup-estate|backup estate readback|./ops/plugins/core/bin/backup-estate-readback-status --json"
    "infra-core-slo|infra-core service SLO readback|$VERIFY_BASH_BIN ./ops/plugins/infra/observability/bin/infra-core-slo-status"
    "services-health|service endpoint health readback|$VERIFY_BASH_BIN ./ops/plugins/infra/services/bin/services-health-status"
    "secrets-auth|secrets auth presence readback|$VERIFY_BASH_BIN ./ops/plugins/infra/secrets/bin/secrets-auth-status"
  )

  if [[ "$json_mode" -eq 0 ]]; then
    emit_alias_deprecation_note "$alias_source"
    emit_scope_note "$mode"
    echo "verify.infra.run"
    echo "  scoped estate/workload health readback"
    echo "  note: G1-G17 gate pack is retired; this surface composes first-class readbacks and does not answer spine truth"
  fi

  for check_line in "${checks[@]}"; do
    IFS='|' read -r check_id label cmd <<<"$check_line"
    output_path="$tmpdir/$check_id.out"
    total_count=$((total_count + 1))

    set +e
    run_timed_shell "$timeout_sec" "$cmd" "$output_path"
    rc=$?
    set -e

    status="$(estate_health_check_status "$check_id" "$output_path" "$rc")"
    reason="ok"
    if [[ "$rc" -eq 124 ]]; then
      reason="timeout_after_${timeout_sec}s"
    elif [[ "$rc" -ne 0 ]]; then
      reason="nonzero_exit_${rc}"
    elif [[ "$status" == "warn" ]]; then
      reason="scoped_attention"
    fi

    case "$status" in
      pass)
        pass_count=$((pass_count + 1))
        [[ "$json_mode" -eq 0 ]] && printf "  PASS  %-22s %s\n" "$check_id" "$label"
        ;;
      warn)
        warn_count=$((warn_count + 1))
        warning_ids+=("$check_id")
        [[ "$json_mode" -eq 0 ]] && printf "  WARN  %-22s %s (%s)\n" "$check_id" "$label" "$reason"
        ;;
      *)
        fail_count=$((fail_count + 1))
        failing_ids+=("$check_id")
        [[ "$json_mode" -eq 0 ]] && printf "  FAIL  %-22s %s (%s)\n" "$check_id" "$label" "$reason"
        ;;
    esac

    check_json_lines+=("$(jq -n \
      --arg id "$check_id" \
      --arg label "$label" \
      --arg status "$status" \
      --arg reason "$reason" \
      --argjson exit_code "$rc" \
      '{id:$id,label:$label,status:$status,reason:$reason,exit_code:$exit_code}')")
  done

  if [[ "$json_mode" -eq 1 ]]; then
    local checks_json warnings_json failures_json
    checks_json="$(printf '%s\n' "${check_json_lines[@]}" | jq -s '.')"
    warnings_json="$(json_array "${warning_ids[@]}")"
    failures_json="$(json_array "${failing_ids[@]}")"
    jq -n \
      --arg mode "$mode" \
      --arg truth_plane "estate_health" \
      --arg scope_reading "$(scope_reading "$mode")" \
      --argjson may_block_spine_truth false \
      --argjson total "$total_count" \
      --argjson pass "$pass_count" \
      --argjson warn "$warn_count" \
      --argjson fail "$fail_count" \
      --argjson warning_ids "$warnings_json" \
      --argjson failing_ids "$failures_json" \
      --argjson checks "$checks_json" \
      '{
        mode: $mode,
        truth_plane: $truth_plane,
        scope_reading: $scope_reading,
        may_block_spine_truth: $may_block_spine_truth,
        total: $total,
        pass: $pass,
        fail: $fail,
        warn: $warn,
        skipped_inline: 0,
        skipped_retired: 17,
        skipped_network: 0,
        receipt_integrity_warnings: 0,
        failing_ids: $failing_ids,
        warning_ids: $warning_ids,
        blocking_fail_ids: [],
        non_blocking_fail_ids: ($warning_ids + $failing_ids),
        retired_gate_family: "G1-G17",
        checks: $checks
      }'
  else
    echo
    echo "Estate health classification:"
    echo "  total: $total_count"
    echo "  pass:  $pass_count"
    echo "  warn:  $warn_count"
    echo "  fail:  $fail_count"
    echo "  retired gate family: G1-G17"
    echo "  may block spine truth: false"
  fi

  # Estate health attention is intentionally non-blocking for spine truth.
  return 0
}

load_spine_helper_json() {
  [[ -f "$VERIFY_SPINE_SCOPE_HELPER" ]] || fail "missing spine scope helper: $VERIFY_SPINE_SCOPE_HELPER"

  local output rc
  set +e
  output="$(python3 "$VERIFY_SPINE_SCOPE_HELPER" --json 2>&1)"
  rc=$?
  set -e

  [[ "$rc" -eq 0 ]] || fail "spine scope helper failed (exit $rc): ${output:0:400}"
  jq -e . >/dev/null 2>&1 <<<"$output" || fail "spine scope helper did not emit valid JSON"
  printf '%s\n' "$output"
}

run_spine_scope() {
  local helper_json declared_json executed_json already_json missing_json stale_json out_json helper_exec_paths_json component_json
  local overall_rc=0
  local engine_rc=0 gate_rc=0
  local spine_surfaces=()

  helper_json="$(load_spine_helper_json)"
  declared_json="$(jq -c '.declared_core_gate_ids' <<<"$helper_json")"
  executed_json="$(jq -c '.executable_now_gate_ids' <<<"$helper_json")"
  already_json="$(jq -c '.already_covered_gate_ids' <<<"$helper_json")"
  missing_json="$(jq -c '.missing_implementation_gate_ids' <<<"$helper_json")"
  stale_json="$(jq -c '.stale_target_gate_ids' <<<"$helper_json")"
  out_json="$(jq -c '.out_of_spine_scope_gate_ids' <<<"$helper_json")"
  helper_exec_paths_json="$(jq -c --arg root "$ROOT" '[.executable_surfaces[] | (.path // .check_script // .surface_id) | if startswith("/") then . else ($root + "/" + .) end]' <<<"$helper_json")"
  component_json="$(jq -n \
    --argjson helper_exec "$helper_exec_paths_json" \
    --arg engine "$VERIFY_ENGINE" \
    '$helper_exec + [$engine]')"

  if [[ "$json_mode" -eq 1 ]]; then
    set +e
    "$VERIFY_ENGINE" --json >/dev/null 2>&1
    engine_rc=$?
    set -e
  else
    echo "verify.run spine"
    echo "  foundational spine-only verify scope"
    echo "  note: spine answers spine/object truth; for orchestration proof use: verify-run honesty"
    echo "  engine: $VERIFY_ENGINE"
    echo "  executable surfaces:"
    echo "$component_json" | jq -r '.[]' | sed 's/^/    - /'

    set +e
    "$VERIFY_ENGINE"
    engine_rc=$?
    set -e
  fi

  [[ "$engine_rc" -eq 0 ]] || overall_rc=1

  # Build warn-only surface path set from gate registry metadata
  local warn_only_paths
  warn_only_paths="$(jq -r --arg root "$ROOT" \
    '[.executable_surfaces[] | select(.warn_only == true) | (.path // .check_script) | if startswith("/") then . else ($root + "/" + .) end] | .[]' \
    <<<"$helper_json")"

  mapfile -t spine_surfaces < <(jq -r '.[]' <<<"$helper_exec_paths_json")

  for surface in "${spine_surfaces[@]}"; do
    [[ -n "$surface" ]] || continue
    if [[ ! -x "$surface" ]]; then
      echo "verify.run spine FAIL: non-executable surface: $surface" >&2
      overall_rc=1
      continue
    fi

    if [[ "$json_mode" -eq 1 ]]; then
      set +e
      "$surface" </dev/null >/dev/null 2>&1
      gate_rc=$?
      set -e
    else
      set +e
      "$surface" </dev/null
      gate_rc=$?
      set -e
    fi

    if [[ "$gate_rc" -ne 0 ]]; then
      if echo "$warn_only_paths" | grep -qxF "$surface"; then
        [[ "$json_mode" -eq 1 ]] || echo "  (warn-only gate — not blocking spine.verify)"
      else
        overall_rc=1
      fi
    fi
  done

  if [[ "$json_mode" -eq 1 ]]; then
    jq -n \
      --arg mode "spine" \
      --arg truth_plane "spine_truth" \
      --arg scope_reading "Spine/object truth surface. Excludes estate/workload health gates unless separately routed." \
      --argjson may_block_spine_truth true \
      --argjson declared_core_gate_ids "$declared_json" \
      --argjson executed_gate_ids "$executed_json" \
      --argjson already_covered_gate_ids "$already_json" \
      --argjson missing_implementation_gate_ids "$missing_json" \
      --argjson stale_target_gate_ids "$stale_json" \
      --argjson out_of_spine_scope_gate_ids "$out_json" \
      --argjson component_surfaces_run "$component_json" \
      '{
        mode: $mode,
        truth_plane: $truth_plane,
        scope_reading: $scope_reading,
        may_block_spine_truth: $may_block_spine_truth,
        declared_core_gate_ids: $declared_core_gate_ids,
        executed_gate_ids: $executed_gate_ids,
        already_covered_gate_ids: $already_covered_gate_ids,
        missing_implementation_gate_ids: $missing_implementation_gate_ids,
        stale_target_gate_ids: $stale_target_gate_ids,
        out_of_spine_scope_gate_ids: $out_of_spine_scope_gate_ids,
        component_surfaces_run: $component_surfaces_run
      }'
  else
    echo
    echo "Spine classification:"
    echo "  declared: $(jq -r '.declared_core_gate_ids | length' <<<"$helper_json")"
    echo "  executable-now: $(jq -r '.executable_now_gate_ids | length' <<<"$helper_json")"
    echo "  already-covered: $(jq -r '.already_covered_gate_ids | length' <<<"$helper_json")"
    echo "  missing-implementation: $(jq -r '.missing_implementation_gate_ids | length' <<<"$helper_json")"
    echo "  stale-target: $(jq -r '.stale_target_gate_ids | length' <<<"$helper_json")"
    echo "  out-of-spine-scope: $(jq -r '.out_of_spine_scope_gate_ids | length' <<<"$helper_json")"
  fi

  return "$overall_rc"
}

case "$scope" in
  engine)  run_scope "engine" "$VERIFY_ENGINE" ;;
  honesty) run_scope "honesty" "$VERIFY_ENGINE_HONESTY" ;;
  spine)   run_spine_scope ;;
  infra)
    [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
    run_estate_health_scope
    ;;
  domain)
    [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
    if [[ "${target_domain,,}" == "rag" ]]; then
      run_rag_domain_scope
    else
      run_scope "domain:$target_domain" "$VERIFY_TOPOLOGY" domain "$target_domain"
    fi
    ;;
  release)
    [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
    run_scope "release" "$VERIFY_TOPOLOGY" release
    ;;
esac
