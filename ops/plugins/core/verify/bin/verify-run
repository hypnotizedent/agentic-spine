#!/usr/bin/env bash
set -euo pipefail

_VR_COMPUTED="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
if [[ -n "${SPINE_ROOT:-}" && "${SPINE_ROOT}" != "$_VR_COMPUTED" ]]; then
  echo "WARN: ambient SPINE_ROOT=$SPINE_ROOT disagrees with computed=$_VR_COMPUTED (using computed)" >&2
fi
ROOT="$_VR_COMPUTED"

VERIFY_TOPOLOGY="$ROOT/ops/plugins/core/verify/bin/verify-topology"
VERIFY_ENGINE="$ROOT/ops/plugins/core/verify/bin/verify-engine"

fail() {
  echo "verify.run FAIL: $*" >&2
  exit 1
}

[[ -x "$VERIFY_TOPOLOGY" ]] || fail "missing verify runtime: $VERIFY_TOPOLOGY"
[[ -x "$VERIFY_ENGINE" ]] || fail "missing engine verify: $VERIFY_ENGINE"

usage() {
  cat <<'USAGE'
verify.run

Usage:
  verify-run engine [--json]                  Fast platform engine smoke (seconds)
  verify-run fast [--json] [--shadow]         17-gate infrastructure baseline
  verify-run infra [--json] [--shadow]        Alias for fast (infrastructure gates)
  verify-run domain <domain_id> [--json]      Domain-scoped infrastructure gates
  verify-run release [--json] [--shadow]      Full infrastructure gate set

Scopes:
  engine  => platform execution system health (bin/ops, caps, SQLite, entry)
  fast    => 17-gate infrastructure workload baseline (alias: infra)
  infra   => same as fast
  domain  => infrastructure gates for one domain
  release => full infrastructure gate set

Flags:
  --shadow   accepted for compatibility and ignored by spine-lite
  --json     emit machine-readable JSON output
USAGE
}

json_mode=0
shadow_mode=0

if [[ "${1:-}" == "--" ]]; then
  shift
fi

scope="${1:-}"
shift || true

case "$scope" in
  engine|fast|infra|domain|release) ;;
  -h|--help|"") usage; exit 0 ;;
  *) fail "unknown scope '$scope' (expected engine|fast|infra|domain|release)" ;;
esac

# Normalize infra → fast (they are the same surface)
[[ "$scope" != "infra" ]] || scope="fast"

target_domain=""
if [[ "$scope" == "domain" ]]; then
  [[ $# -ge 1 ]] || fail "domain scope requires <domain_id>"
  target_domain="$1"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) json_mode=1 ;;
    --shadow) shadow_mode=1 ;;
    *) fail "unknown argument: $1" ;;
  esac
  shift
done

run_and_wrap_json() {
  local mode="$1"
  shift
  local output rc

  set +e
  output="$("$@" 2>/dev/null)"
  rc=$?
  set -e

  if [[ -z "$output" ]] || ! jq -e . >/dev/null 2>&1 <<<"$output"; then
    output='{"total":0,"pass":0,"fail":1,"warn":0,"skipped_inline":0,"skipped_retired":0,"skipped_network":0,"receipt_integrity_warnings":0,"failing_ids":[],"warning_ids":[],"blocking_fail_ids":[],"non_blocking_fail_ids":[]}'
    rc=1
  fi

  jq -n \
    --arg mode "$mode" \
    --argjson shadow_mode "$shadow_mode" \
    --argjson result "$output" \
    '{
      mode: $mode,
      shadow_mode_ignored: ($shadow_mode == 1),
      total: ($result.total // 0),
      pass: ($result.pass // 0),
      fail: ($result.fail // 0),
      warn: ($result.warn // 0),
      skipped_inline: ($result.skipped_inline // 0),
      skipped_retired: ($result.skipped_retired // 0),
      skipped_network: ($result.skipped_network // 0),
      receipt_integrity_warnings: ($result.receipt_integrity_warnings // 0),
      failing_ids: ($result.failing_ids // []),
      warning_ids: ($result.warning_ids // []),
      blocking_fail_ids: ($result.blocking_fail_ids // []),
      non_blocking_fail_ids: ($result.non_blocking_fail_ids // [])
    }'

  return "$rc"
}

case "$scope" in
  engine)
    if [[ "$json_mode" -eq 1 ]]; then
      run_and_wrap_json "engine" "$VERIFY_ENGINE" --json
    else
      exec "$VERIFY_ENGINE"
    fi
    ;;
  fast)
    if [[ "$json_mode" -eq 1 ]]; then
      run_and_wrap_json "fast" "$VERIFY_TOPOLOGY" core --json
    else
      [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
      exec "$VERIFY_TOPOLOGY" core
    fi
    ;;
  domain)
    if [[ "$json_mode" -eq 1 ]]; then
      run_and_wrap_json "domain:$target_domain" "$VERIFY_TOPOLOGY" domain "$target_domain" --json
    else
      [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
      exec "$VERIFY_TOPOLOGY" domain "$target_domain"
    fi
    ;;
  release)
    if [[ "$json_mode" -eq 1 ]]; then
      run_and_wrap_json "release" "$VERIFY_TOPOLOGY" release --json
    else
      [[ "$shadow_mode" -eq 0 ]] || echo "verify.run: --shadow ignored in spine-lite"
      exec "$VERIFY_TOPOLOGY" release
    fi
    ;;
esac
