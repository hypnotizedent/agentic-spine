#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# verify-engine - Fast platform engine smoke test
# ═══════════════════════════════════════════════════════════════════════════
#
# Checks that the spine execution system itself is healthy, not the
# infrastructure workloads it manages. Runs in seconds, not minutes.
#
# Checks:
#   E1  bin/ops entrypoint smoke (--help + cap list)
#   E2  ops status --json exits clean
#   E3  SQLite authority readable + active-state counts resolve
#   E4  read-only capability dispatch (verify.engine.run self-test)
#   E5  no dead hot-path entry references
#   E6  no dead file references in governed scripts
#   E7  no dead canonical path references in hot contracts
#   E8  MANIFEST script entries resolve on disk + narrow capability parity
#   E12 execution identity parity: by_terminal_id role overrides must produce matching posture
#   E13 cap.sh no silent widen-by-fallback to worker on missing SPINE_RUNTIME_ROLE
#   E14 researcher→worker bridge continuity (warn): active loops have delegation, packet, or handoff
#   E15 status open-loop count anchored to SQLite authority
#   E16 public entry grammar lock
#
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

_VE_COMPUTED="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
ROOT="$_VE_COMPUTED"
RUNTIME_PATHS_LIB="$ROOT/ops/lib/runtime-paths.sh"
[[ -f "$RUNTIME_PATHS_LIB" ]] || { echo "FATAL: runtime-paths.sh not found" >&2; exit 1; }
source "$RUNTIME_PATHS_LIB"
spine_runtime_resolve_paths

json_mode=0
if [[ "${1:-}" == "--" ]]; then shift; fi
while [[ $# -gt 0 ]]; do
    case "$1" in
        --json) json_mode=1 ;;
        -h|--help)
            echo "verify-engine — fast platform engine smoke test"
            echo "Usage: verify-engine [--json]"
            exit 0
            ;;
        *) ;;
    esac
    shift
done

PASS=0
FAIL=0
WARN=0
TOTAL=0
FAILING_IDS=()
WARNING_IDS=()

check() {
    local id="$1" name="$2"
    shift 2
    TOTAL=$((TOTAL + 1))
    local output rc
    set +e
    output="$("$@" 2>&1)"
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
        PASS=$((PASS + 1))
        [[ "$json_mode" -eq 1 ]] || echo "  PASS  $id  $name"
    else
        FAIL=$((FAIL + 1))
        FAILING_IDS+=("$id")
        if [[ "$json_mode" -eq 0 ]]; then
            echo "  FAIL  $id  $name"
            echo "        ${output:0:200}"
        fi
    fi
}

warn_check() {
    local id="$1" name="$2"
    shift 2
    TOTAL=$((TOTAL + 1))
    local output rc
    set +e
    output="$("$@" 2>&1)"
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
        PASS=$((PASS + 1))
        [[ "$json_mode" -eq 1 ]] || echo "  PASS  $id  $name"
    else
        WARN=$((WARN + 1))
        WARNING_IDS+=("$id")
        [[ "$json_mode" -eq 1 ]] || echo "  WARN  $id  $name"
    fi
}

[[ "$json_mode" -eq 1 ]] || echo "=== ENGINE SMOKE ==="
[[ "$json_mode" -eq 1 ]] || echo "Scope: plumbing exists (entrypoint, registry, authority). For orchestration proof, use: verify-run honesty"

# E1: bin/ops entrypoint smoke + engine-cap self-check coverage.
# PACKET-599 extension: also exercise loops.create --self-check so the
# BSD-vs-GNU sed divergence (the bug this packet retired) cannot silently
# recur. Adding new in-place sed sites to loops-create without using the
# sed_inplace wrapper will fail E1 on whichever platform isn't BSD-by-default.
# Self-checks invoked here must be: read-only, side-effect-free, sub-second.
check E1 "bin/ops entrypoint smoke" bash -c "
    '$ROOT/bin/ops' --help >/dev/null 2>&1 \
        && '$ROOT/bin/ops' cap list >/dev/null 2>&1 \
        && '$ROOT/ops/plugins/core/lifecycle/bin/loops-create' --self-check >/dev/null 2>&1
"

# E2: ops status --json exits clean
check E2 "ops status --json" bash -c "
    '$ROOT/bin/ops' status --json >/dev/null 2>&1
"

# E3: SQLite shared authority readable + active-state counts resolve
AUTHORITY_DB="$SPINE_STATE/shared_authority.db"
check E3 "SQLite shared authority readable" bash -c '
    python3 - "'"$AUTHORITY_DB"'" <<'"'"'PY'"'"'
import sqlite3
import sys
import time
from pathlib import Path

db = Path(sys.argv[1])
if not db.is_file():
    raise SystemExit(f"shared_authority.db not found at {db}")

attempts = 5
delay_s = 0.2
last_exc = None

for attempt in range(1, attempts + 1):
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5.0)
        try:
            conn.execute("PRAGMA busy_timeout = 5000;")
            count = conn.execute("SELECT count(*) FROM sqlite_master;").fetchone()[0]
        finally:
            conn.close()
        if int(count) <= 0:
            raise SystemExit("shared_authority.db has no tables")
        raise SystemExit(0)
    except sqlite3.OperationalError as exc:
        last_exc = exc
        if "locked" not in str(exc).lower() or attempt == attempts:
            break
        time.sleep(delay_s)

msg = f"sqlite authority query failed after {attempts} attempts"
if last_exc is not None:
    msg += f": {last_exc}"
raise SystemExit(msg)
PY
'

# E4: capabilities registry parseable and non-empty
check E4 "capability registry parseable" bash -c "
    cap_file='$ROOT/ops/capabilities.yaml'
    [[ -f \"\$cap_file\" ]] || exit 1
    yq e '.capabilities | length' \"\$cap_file\" 2>/dev/null | grep -qE '^[1-9]'
"

# E5: no dead hot-path entry references
check E5 "no dead entry references on hot path" bash -c "
    dead_refs=0
    for f in \
        '$ROOT/ops/bindings/entry.surface.contract.yaml' \
        '$ROOT/ops/bindings/session.admission.contract.yaml' \
        '$ROOT/ops/plugins/core/session/bin/terminal-launch-exec' \
        '$ROOT/ops/bindings/terminal.worker.catalog.yaml' \
        '$ROOT/ops/bindings/terminal.launcher.view.yaml'; do
        [[ -f \"\$f\" ]] && dead_refs=\$((dead_refs + 1))
    done
    [[ \$dead_refs -eq 0 ]]
"

# E6: no dead file references in governed scripts
# Guards against the dee8c8d5 bug class: deleting a file while live scripts
# still source/invoke it by repo-relative path.
check E6 "no dead file references in governed scripts" bash -c '
    dead=0
    scan_dirs=(
        "'"$ROOT"'/ops/commands"
        "'"$ROOT"'/ops/plugins/core/verify/bin"
        "'"$ROOT"'/ops/plugins/core/authority/bin"
        "'"$ROOT"'/ops/plugins/core/lifecycle/bin"
        "'"$ROOT"'/ops/plugins/core/orchestration/bin"
        "'"$ROOT"'/ops/plugins/core/session/bin"
        "'"$ROOT"'/ops/plugins/core/bin"
        "'"$ROOT"'/ops/plugins/core/alerting/bin"
        "'"$ROOT"'/ops/plugins/core/alerting/lib"
        "'"$ROOT"'/ops/plugins/infra/host/bin"
    )
    for dir in "${scan_dirs[@]}"; do
        [[ -d "$dir" ]] || continue
        while IFS= read -r script; do
            [[ -f "$script" ]] || continue
            while IFS= read -r line; do
                ref=""
                # Skip comment lines and lines inside quoted strings used as examples
                trimmed="${line#"${line%%[![:space:]]*}"}"
                [[ "$trimmed" == \#* ]] && continue
                # Match: source "$ROOT/path" or source "$CONTROL_ROOT/path" etc
                if [[ "$line" =~ (source|python3|bash)[[:space:]]+[\"\$]*\{?(ROOT|CONTROL_ROOT|SPINE_REPO|_VE_COMPUTED|_VEH_COMPUTED)\}?/([^\"[:space:]\$]+) ]]; then
                    ref="${BASH_REMATCH[3]}"
                fi
                [[ -n "$ref" ]] || continue
                full="'"$ROOT"'/$ref"
                if [[ ! -f "$full" && ! -d "$full" ]]; then
                    echo "DEAD: $(basename "$script") -> $ref"
                    dead=$((dead + 1))
                fi
            done < "$script"
        done < <(find "$dir" -maxdepth 1 -type f \( -name "*.sh" -o -name "*.py" -o ! -name "*.*" \) 2>/dev/null)
    done
    if [[ $dead -gt 0 ]]; then
        echo "$dead dead file reference(s) found"
        exit 1
    fi
'

# E7: no dead canonical path references in hot contracts
# Keep this narrow and cheap: only check the boot/runtime and terminal-worker
# projection contracts that recently pointed at deleted canonical surfaces.
check E7 "no dead canonical path references in hot contracts" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
from pathlib import Path
import sys
import yaml

root = Path(sys.argv[1])

STRICT_SUFFIXES = (".yaml", ".yml", ".sh", ".py", ".json", ".md")

checks = [
    {
        "contract": root / "ops/bindings/runtime.bootstrap.contract.yaml",
        "paths": [
            ("authority.canonical_boot_surface", ["authority", "canonical_boot_surface"], False),
            ("bootstrap_preconditions.required_contracts[]", ["bootstrap_preconditions", "required_contracts"], False),
        ],
    },
    {
        "contract": root / "ops/bindings/terminal.worker.projection.contract.yaml",
        "paths": [
            ("policy.authority_binding", ["policy", "authority_binding"], False),
            ("governed_surfaces[].wrapper", ["governed_surfaces", "wrapper"], False),
            ("governed_surfaces[].tracked_output", ["governed_surfaces", "tracked_output"], False),
            ("generator.path", ["generator", "path"], False),
        ],
    },
    {
        "contract": root / "ops/bindings/gate.execution.topology.yaml",
        "paths": [
            # path_triggers mixes real paths with prefix-matchers (e.g. surfaces/verify/d140-);
            # only hard-check entries that end in a concrete file suffix.
            ("domain_metadata[].path_triggers[]", ["domain_metadata", "path_triggers"], True),
        ],
    },
]

def iter_values(node, path):
    if not path:
        yield node
        return
    head, *tail = path
    if isinstance(node, list):
        for item in node:
            yield from iter_values(item, path)
        return
    if not isinstance(node, dict) or head not in node:
        return
    value = node[head]
    if head == "path" and isinstance(node, dict):
        status = str(node.get("status") or "").strip().lower()
        if status == "retired":
            return
    yield from iter_values(value, tail)

missing = []
for entry in checks:
    contract = entry["contract"]
    if not contract.is_file():
        continue
    data = yaml.safe_load(contract.read_text(encoding="utf-8")) or {}
    for label, path, suffix_only in entry["paths"]:
        for raw in iter_values(data, path):
            if not isinstance(raw, str):
                continue
            rel = raw.strip()
            if not rel or rel.startswith("$") or rel.startswith("/") or "://" in rel:
                continue
            if suffix_only and not rel.lower().endswith(STRICT_SUFFIXES):
                continue
            target = root / rel
            if not target.exists():
                missing.append(f"{contract.relative_to(root)}::{label} -> {rel}")

if missing:
    print("\n".join(missing))
    raise SystemExit(1)
PY
'

# E8: every MANIFEST script entry must resolve on disk. Capability parity is
# enforced for the live registry:
#   - every capability advertised by a MANIFEST plugin must exist in
#     ops/capabilities.yaml
#   - every non-retired capability in ops/capabilities.yaml must be advertised
#     by at least one MANIFEST plugin
#   - every capability whose command/script_path lives under a plugin path
#     must be advertised by that exact plugin
# Retired historical registry rows are excluded from the live projection
# requirement.
check E8 "MANIFEST script parity + plugin capability parity" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
from pathlib import Path
import sys
import yaml

root = Path(sys.argv[1])
manifest_path = root / "ops/plugins/MANIFEST.yaml"
data = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}

cap_registry_path = root / "ops/capabilities.yaml"
known_caps = set()
cap_entries = {}
if cap_registry_path.is_file():
    reg = yaml.safe_load(cap_registry_path.read_text(encoding="utf-8")) or {}
    caps = reg.get("capabilities") or {}
    if isinstance(caps, dict):
        for name, payload in caps.items():
            cn = str(name).strip()
            if cn:
                known_caps.add(cn)
                cap_entries[cn] = payload if isinstance(payload, dict) else {}
    else:
        for cap in caps:
            if isinstance(cap, dict):
                name = str(cap.get("id") or cap.get("name") or "").strip()
                if name:
                    known_caps.add(name)
                    cap_entries[name] = cap

missing_scripts = []
missing_caps = []
missing_registry_advertisements = []
missing_plugin_advertisements = []
duplicate_advertisements = []
plugins = []
advertised_caps = set()
cap_to_plugins = {}
for plugin in data.get("plugins") or []:
    if not isinstance(plugin, dict):
        continue
    plugin_name = str(plugin.get("name") or plugin.get("id") or "").strip()
    plugin_path = str(plugin.get("path") or "").strip()
    base = root / plugin_path
    plugins.append((plugin_name, Path(plugin_path), plugin))
    for rel in plugin.get("scripts") or []:
        script_rel = str(rel or "").strip()
        if not script_rel:
            continue
        candidate = base / script_rel
        if not candidate.exists():
            missing_scripts.append(str(candidate.relative_to(root)))
    for cap_name in plugin.get("capabilities") or []:
        cn = str(cap_name or "").strip()
        if not cn:
            continue
        advertised_caps.add(cn)
        cap_to_plugins.setdefault(cn, set()).add(plugin_name)
        if cn not in known_caps:
            missing_caps.append(f"{plugin_name}::{cn}")


def plugin_for_cap(cap_payload):
    best = None
    best_len = -1
    for field in ("script_path", "command"):
        raw = cap_payload.get(field)
        if not isinstance(raw, str):
            continue
        candidate = raw.strip()
        if candidate.startswith("./"):
            candidate = candidate[2:]
        if not candidate.startswith("ops/plugins/"):
            continue
        candidate_path = Path(candidate)
        for plugin_name, plugin_path, _plugin in plugins:
            try:
                candidate_path.relative_to(plugin_path)
            except Exception:
                continue
            if len(plugin_path.parts) > best_len:
                best = plugin_name
                best_len = len(plugin_path.parts)
    return best


plugin_scoped_caps = {}
for cap_name, payload in cap_entries.items():
    if not isinstance(payload, dict):
        continue
    plugin_name = plugin_for_cap(payload)
    if not plugin_name:
        continue
    plugin_scoped_caps.setdefault(plugin_name, set()).add(cap_name)

for plugin_name, _plugin_path, plugin in plugins:
    advertised = {
        str(cap_name).strip()
        for cap_name in (plugin.get("capabilities") or [])
        if str(cap_name).strip()
    }
    real = plugin_scoped_caps.get(plugin_name, set())
    for cap_name in sorted(real - advertised):
        missing_plugin_advertisements.append(f"{plugin_name}::{cap_name}")

live_caps = {
    cap_name
    for cap_name, payload in cap_entries.items()
    if str((payload or {}).get("lifecycle") or "ready").strip().lower() != "retired"
}
for cap_name in sorted(live_caps - advertised_caps):
    missing_registry_advertisements.append(cap_name)

for cap_name, owners in sorted(cap_to_plugins.items()):
    if len(owners) > 1:
        duplicate_advertisements.append(cap_name + "::" + ",".join(sorted(owners)))

errs = []
if missing_scripts:
    errs.append("MISSING SCRIPTS:\n" + "\n".join(missing_scripts))
if missing_caps:
    errs.append("UNRESOLVED CAPABILITIES:\n" + "\n".join(missing_caps))
if missing_registry_advertisements:
    errs.append("LIVE CAPABILITIES MISSING FROM MANIFEST:\n" + "\n".join(missing_registry_advertisements))
if missing_plugin_advertisements:
    errs.append("PLUGIN-SCOPED CAPABILITIES MISSING FROM THEIR OWN MANIFEST ROW:\n" + "\n".join(missing_plugin_advertisements))
if duplicate_advertisements:
    errs.append("DUPLICATE MANIFEST CAPABILITY ADVERTISEMENTS:\n" + "\n".join(duplicate_advertisements))

if errs:
    print("\n\n".join(errs))
    raise SystemExit(1)
PY
'

check E12 "execution identity parity (no split role/posture)" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
import subprocess, sys, os

root = sys.argv[1]
contract = os.path.join(root, "ops/bindings/terminal.role.contract.yaml")
posture_lib = os.path.join(root, "ops/plugins/core/lifecycle/lib/session_posture.sh")

if not os.path.isfile(contract) or not os.path.isfile(posture_lib):
    print("SKIP: contract or posture lib missing")
    raise SystemExit(0)

# Read terminal IDs and their by_terminal_id role overrides
import json
try:
    ids_raw = subprocess.check_output(
        ["yq", "-r", ".runtime_role_defaults.by_terminal_id | to_entries[] | .key + \"=\" + .value", contract],
        text=True, stderr=subprocess.DEVNULL
    ).strip()
except Exception:
    ids_raw = ""

if not ids_raw:
    raise SystemExit(0)

# For each terminal with an explicit role override, verify posture agrees
role_to_expected_posture = {
    "worker": "worker",
    "qc": "membrane",
    "close": "controller",
    "librarian": "controller",
}

failures = []
for line in ids_raw.splitlines():
    if "=" not in line:
        continue
    terminal_id, role = line.split("=", 1)
    expected = role_to_expected_posture.get(role)
    if not expected:
        continue

    # Run session_posture_resolve via bash and capture result
    test_script = f"""
        source "{posture_lib}"
        session_posture_resolve "{terminal_id}" "" "{role}" 2>/dev/null
        printf "%s" "$__SP_POSTURE"
    """
    try:
        actual = subprocess.check_output(
            ["bash", "-c", test_script], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except Exception:
        actual = "error"

    if actual != expected:
        failures.append(f"{terminal_id}: role={role} posture={actual} expected_posture={expected}")

if failures:
    print("Split identity detected:")
    for f in failures:
        print(f"  {f}")
    raise SystemExit(1)
PY
'

# E13: cap.sh must not silently widen to worker on missing SPINE_RUNTIME_ROLE
check E13 "cap.sh no silent widen-by-fallback to worker" bash -c '
    cap_sh="'"$ROOT"'/ops/commands/cap.sh"
    if [ ! -f "$cap_sh" ]; then
        echo "SKIP: cap.sh not found"
        exit 0
    fi
    widen_count=$(grep -c "SPINE_RUNTIME_ROLE:-worker" "$cap_sh" 2>/dev/null || echo 0)
    if [ "$widen_count" -gt 0 ]; then
        echo "cap.sh has $widen_count instance(s) of SPINE_RUNTIME_ROLE:-worker (silent widen to mutating role)"
        grep -n "SPINE_RUNTIME_ROLE:-worker" "$cap_sh"
        exit 1
    fi
'

# E14 is warning-only. Runtime custody can be proven by delegation/packet/handoff
# or by current wave/worktree/heartbeat evidence.
# When E14 fires, per-loop diagnostic names which custody classes were checked
# (all checked classes were absent for the listed loop). Operators read the
# per-loop output to learn which seam would clear the warn.
warn_check E14 "active-loop custody seam absent (no delegation, packet, handoff, wave, worktree, or heartbeat for at least one active loop)" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
import json, os, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path

root = Path(sys.argv[1])
spine_state = os.environ.get("SPINE_STATE", "")
if not spine_state:
    home = os.environ.get("HOME", "")
    spine_state = os.path.join(home, "code/.runtime/spine/state")

state = Path(spine_state)
prompts_dir = state / "controller-prompts"
handoffs_dir = state / "handoffs"
waves_dir = state.parent / "waves"
loop_heartbeat_dir = state / "loop-heartbeats"
db_path = state / "shared_authority.db"

if not db_path.is_file():
    raise SystemExit(0)

import sqlite3
conn = sqlite3.connect(str(db_path))
conn.row_factory = sqlite3.Row
rows = conn.execute(
    "SELECT loop_id, data_json FROM loops WHERE status IN (?, ?)", ["active", "open"]
).fetchall()
conn.close()

if not rows:
    raise SystemExit(0)

# PACKET-620 custody exemption: a loop may be intentionally exempt from the
# E14 custody-scaffolding check (observation-only or otherwise exempt). The
# exemption + reason live in data_json (set via loops.amend --custody-exempt
# true --exempt-reason "..."). Exempt loops are reported in a separate
# Exempt section and do NOT trigger the warn.
active_loops = set()
exempt_loops = {}
for r in rows:
    lid = r["loop_id"]
    active_loops.add(lid)
    raw = r["data_json"] or ""
    if not raw:
        continue
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        continue
    if isinstance(parsed, dict) and parsed.get("custody_exempt"):
        exempt_loops[lid] = str(parsed.get("custody_exempt_reason") or "(no reason recorded)")

def clean_scalar(value):
    return value.strip().strip(chr(34) + chr(39))

def parse_iso_utc(value):
    value = str(value or "").strip()
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None

# Check which loops have at least one packet
# Dual glob: canonical CONTROLLER-PACKET-*.md and legacy MAILROOM-CONTROLLER-PACKET-*.md.
# Legacy prefix retired by LOOP-VOCABULARY-READBACK-SUBTRACTION-SLICE-1.
loops_with_packet = set()
if prompts_dir.is_dir():
    _packet_paths = []
    _seen_paths = set()
    for _glob in ("CONTROLLER-PACKET-*.md", "MAILROOM-CONTROLLER-PACKET-*.md"):
        for _p in prompts_dir.glob(_glob):
            if _p in _seen_paths:
                continue
            _seen_paths.add(_p)
            _packet_paths.append(_p)
    for p in _packet_paths:
        try:
            text = p.read_text(encoding="utf-8", errors="ignore")
            for line in text.splitlines()[:30]:
                if line.startswith("loop_id:"):
                    lid = clean_scalar(line.split(":", 1)[1])
                    if lid in active_loops:
                        loops_with_packet.add(lid)
                    break
        except Exception:
            pass

# Check which loops have at least one active handoff
loops_with_handoff = set()
valid_states = set(["active", "parked"])
if handoffs_dir.is_dir():
    for h in handoffs_dir.glob("HO-*.yaml"):
        try:
            text = h.read_text(encoding="utf-8", errors="ignore")
            in_loops = False
            for line in text.splitlines():
                if line.startswith("state:"):
                    s = clean_scalar(line.split(":", 1)[1])
                    if s not in valid_states:
                        break
                if line.strip() == "loops:":
                    in_loops = True
                    continue
                if in_loops:
                    if line.startswith("  - ") or line.startswith("- "):
                        lid = clean_scalar(line.strip().lstrip("- "))
                        if lid in active_loops:
                            loops_with_handoff.add(lid)
                    else:
                        in_loops = False
        except Exception:
            pass

# Check which loops have at least one active delegation
loops_with_delegation = set()
delegations_dir = state / "delegations"
if delegations_dir.is_dir():
    terminal_states = {"landed", "needs_review", "cancelled"}
    for d in delegations_dir.glob("DEL-*.yaml"):
        try:
            text = d.read_text(encoding="utf-8", errors="ignore")
            for line in text.splitlines():
                if line.startswith("delegation_state:"):
                    ds = clean_scalar(line.split(":", 1)[1])
                    if ds in terminal_states:
                        break
                if line.startswith("loop_id:"):
                    lid = clean_scalar(line.split(":", 1)[1])
                    if lid in active_loops:
                        loops_with_delegation.add(lid)
                    break
        except Exception:
            pass

# Check active wave state for loop custody.
loops_with_wave = set()
if waves_dir.is_dir():
    active_states = {"active", "running", "open", "executing"}
    terminal_states = {"closed", "landed", "cancelled", "canceled", "abandoned", "deferred"}
    for sf in waves_dir.glob("WAVE-*/state.json"):
        try:
            data = json.loads(sf.read_text(encoding="utf-8", errors="ignore"))
            if not isinstance(data, dict):
                continue
            state_value = str(data.get("lifecycle_state") or data.get("status") or "").strip().lower()
            if state_value in terminal_states:
                continue
            if state_value and state_value not in active_states:
                continue
            packet = data.get("packet") if isinstance(data.get("packet"), dict) else {}
            lid = str(data.get("loop_id") or packet.get("loop_id") or "").strip()
            if lid in active_loops:
                loops_with_wave.add(lid)
        except Exception:
            pass

# Check worktree lease custody. A live worktree lease is continuity even when
# older delegation/packet/handoff surfaces are absent.
loops_with_worktree = set()
try:
    proc = subprocess.run(
        ["git", "-C", str(root), "worktree", "list", "--porcelain"],
        text=True,
        capture_output=True,
    )
    worktree_paths = []
    if proc.returncode == 0:
        for raw in proc.stdout.splitlines():
            if raw.startswith("worktree "):
                worktree_paths.append(Path(raw.split(" ", 1)[1].strip()))
    for wt in worktree_paths:
        lease = wt / ".spine-lane-lease.yaml"
        if not lease.is_file():
            continue
        text = lease.read_text(encoding="utf-8", errors="ignore")
        lid = ""
        status = ""
        for line in text.splitlines():
            if line.startswith("loop_or_wave_id:"):
                lid = clean_scalar(line.split(":", 1)[1])
            elif line.startswith("status:"):
                status = clean_scalar(line.split(":", 1)[1]).lower()
        if lid in active_loops and status in {"active", "claimed", "open"}:
            loops_with_worktree.add(lid)
except Exception:
    pass

# Check fresh loop heartbeat custody.
loops_with_heartbeat = set()
now = datetime.now(timezone.utc)
if loop_heartbeat_dir.is_dir():
    for lid in active_loops:
        hb_file = loop_heartbeat_dir / ("%s.yaml" % lid.replace("/", "_"))
        if not hb_file.is_file():
            continue
        try:
            heartbeat_raw = ""
            ttl_minutes = 15.0
            text = hb_file.read_text(encoding="utf-8", errors="ignore")
            for line in text.splitlines():
                if line.startswith("last_heartbeat_utc:"):
                    heartbeat_raw = clean_scalar(line.split(":", 1)[1])
                elif line.startswith("heartbeat_ttl_minutes:"):
                    raw_ttl = clean_scalar(line.split(":", 1)[1])
                    ttl_minutes = float(raw_ttl or ttl_minutes)
            dt = parse_iso_utc(heartbeat_raw)
            if dt is not None and (now - dt).total_seconds() <= ttl_minutes * 60:
                loops_with_heartbeat.add(lid)
        except Exception:
            pass

# Loops with no known continuity evidence. This remains a warning.
covered = (
    loops_with_delegation
    | loops_with_packet
    | loops_with_handoff
    | loops_with_wave
    | loops_with_worktree
    | loops_with_heartbeat
)
uncovered = active_loops - covered
# Partition uncovered into exempt + truly-uncovered. Exempt loops report
# in a separate section and do NOT trigger the warn (operator vocabulary:
# "custody OR clearly classified as exempt").
truly_uncovered = uncovered - set(exempt_loops.keys())
exempt_in_scope = sorted(uncovered & set(exempt_loops.keys()))
if exempt_in_scope:
    print("%d active loop(s) custody-exempt (reported, not failing):" % len(exempt_in_scope))
    for lid in exempt_in_scope:
        print("  %s — exempt; reason: %s" % (lid, exempt_loops[lid]))
if truly_uncovered:
    print("%d active loop(s) with no custody seam (checked: delegation, packet, handoff, wave, worktree, heartbeat):" % len(truly_uncovered))
    for lid in sorted(truly_uncovered):
        absent = []
        if lid not in loops_with_delegation:
            absent.append("delegation")
        if lid not in loops_with_packet:
            absent.append("packet")
        if lid not in loops_with_handoff:
            absent.append("handoff")
        if lid not in loops_with_wave:
            absent.append("wave")
        if lid not in loops_with_worktree:
            absent.append("worktree")
        if lid not in loops_with_heartbeat:
            absent.append("heartbeat")
        # By construction `absent` lists every checked class, since `lid in truly_uncovered`
        # means no class matched. Spelling them out makes the trigger class explicit.
        print("  %s — absent: %s" % (lid, ", ".join(absent)))
    raise SystemExit(1)
PY
'

check E15 "status open-loop count matches SQLite authority" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
spine_state = os.environ.get("SPINE_STATE", "")
if not spine_state:
    home = os.environ.get("HOME", "")
    spine_state = os.path.join(home, "code/.runtime/spine/state")

db_path = Path(spine_state) / "shared_authority.db"
if not db_path.is_file():
    print(f"shared_authority.db not found at {db_path}")
    raise SystemExit(1)

conn = sqlite3.connect(str(db_path))
try:
    sqlite_open = conn.execute(
        "SELECT COUNT(*) FROM loops WHERE status IN (?, ?, ?)",
        ["active", "draft", "open"],
    ).fetchone()[0]
finally:
    conn.close()

proc = subprocess.run(
    [str(root / "bin" / "ops"), "status", "--json"],
    capture_output=True,
    text=True,
    cwd=str(root),
)
if proc.returncode != 0:
    print(f"ops status --json exited {proc.returncode}")
    if proc.stderr.strip():
        print(proc.stderr.strip())
    raise SystemExit(1)

try:
    payload = json.loads(proc.stdout)
except json.JSONDecodeError as exc:
    print(f"status json parse failed: {exc}")
    raise SystemExit(1)

status_open = int(((payload.get("counts") or {}).get("open_loops", 0)) or 0)
if status_open != sqlite_open:
    print(f"open loop count mismatch: sqlite={sqlite_open} status={status_open}")
    raise SystemExit(1)
PY
'

check E16 "public entry grammar lock" bash -c '
    python3 - "'"$ROOT"'" <<'"'"'PY'"'"'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
home = Path.home()

# Public/operator-facing surfaces only. Engine internals, archive, runtime
# evidence, and expert command implementations are intentionally outside this
# grammar lock.
files = [
    root / "AGENTS.md",
    root / "NORTH_STAR.md",
    root / "docs/governance/SPINE.md",
    root / "docs/governance/SESSION_PROTOCOL.md",
    root / "docs/governance/LOCAL_CONTROL_PLANE_CONTRACT.md",
    root / "docs/governance/TRANSLATOR_AUTHORITY_DOCTRINE_V1.md",
    root / "docs/core/CORE_LOCK.md",
    root / "bin/ops",
    root / "ops/commands/status.sh",
    root / "ops/commands/verify.sh",
    root / "ops/capabilities.yaml",
    home / ".claude/CLAUDE.md",
    home / ".config/opencode/OPENCODE.md",
    root.parent / "workbench/dotfiles/opencode/OPENCODE.md",
    root.parent / "workbench/dotfiles/macbook/README.md",
    root.parent / "workbench/dotfiles/hammerspoon/.hammerspoon/init.lua",
]

generated_worker_usage = root / "docs/reference/generated/worker-usage"
if generated_worker_usage.exists():
    files.extend(sorted(generated_worker_usage.glob("*.md")))
boot_entry = root / "docs/reference/generated/BOOT_ENTRY_SURFACE.md"
if boot_entry.exists():
    files.append(boot_entry)

raycast_dir = root.parent / "workbench/dotfiles/raycast"
if raycast_dir.exists():
    files.extend(sorted(raycast_dir.glob("*.sh")))

opencode_commands = root.parent / "workbench/dotfiles/opencode/commands"
if opencode_commands.exists():
    files.extend(sorted(opencode_commands.glob("*.md")))

def classify_context(line: str) -> str:
    lower = line.lower()
    expert_terms = (
        "expert",
        "surgery",
        "drilldown",
        "drill down",
        "internal",
        "orientation",
        "read-only",
        "not admission",
        "compat",
        "deprecated",
        "historical",
        "retired",
        "machine-readable",
        "json output",
        "capability discovery",
        "unknown capability",
        "use --expert",
    )
    if any(term in lower for term in expert_terms):
        return "allowed"
    return "public"

rules = [
    (
        "startup_status_json",
        re.compile(r"ops status --json|status --json"),
        "Public startup/readback must teach ops status, not ops status --json.",
    ),
    (
        "startup_cap_list",
        re.compile(r"ops cap list|cap list"),
        "Public startup must not require capability listing.",
    ),
    (
        "ops_verify_public",
        re.compile(r"ops verify(?!\\.engine\\.run)"),
        "Public verify must teach verify.engine.run + spine.verify, not ops verify.",
    ),
    (
        "attach_as_entry",
        re.compile(r"(canonical session entry|session attach|session entry).*session\\.v3\\.attach|session\\.v3\\.attach.*(canonical session entry|session attach|session entry)"),
        "session.v3.attach may be orientation/expert only, not canonical entry.",
    ),
    (
        "normal_wave_loops_delegation",
        re.compile(r"ops wave|ops loops|delegation\\.status|orchestration\\.wave\\.status"),
        "Wave/loops/delegation surfaces must be expert/drilldown language only.",
    ),
    (
        "character_picker",
        re.compile(r"terminal character|character picker|choose terminal character"),
        "Public human entry must not teach terminal-character picking.",
    ),
    (
        "retired_hotkeys",
        re.compile(r"mailroom hotkey|handoff hotkey|friction hotkey|Ctrl\\+Shift\\+T|Ctrl\\+Shift\\+E|Ctrl\\+Shift\\+R"),
        "Mailroom/handoff/friction hotkeys must not be public entry grammar.",
    ),
]

violations = []
seen = set()
for path in files:
    if not path.is_file():
        continue
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        continue
    for lineno, line in enumerate(lines, 1):
        if classify_context(line) == "allowed":
            continue
        for rule_id, pattern, message in rules:
            if not pattern.search(line):
                continue
            key = (str(path), lineno, rule_id)
            if key in seen:
                continue
            seen.add(key)
            try:
                rel = str(path.relative_to(root))
            except ValueError:
                rel = str(path)
            violations.append(f"{rel}:{lineno}: {rule_id}: {message} :: {line.strip()[:180]}")

if violations:
    print("public entry grammar drift:")
    for item in violations[:80]:
        print("  " + item)
    remaining = len(violations) - 80
    if remaining > 0:
        print(f"  ... {remaining} more")
    raise SystemExit(1)
PY
'

if [[ "$json_mode" -eq 1 ]]; then
    # Build JSON arrays
    fail_json="[]"
    warn_json="[]"
    if [[ ${#FAILING_IDS[@]} -gt 0 ]]; then
        fail_json="$(printf '%s\n' "${FAILING_IDS[@]}" | jq -R . | jq -s .)"
    fi
    if [[ ${#WARNING_IDS[@]} -gt 0 ]]; then
        warn_json="$(printf '%s\n' "${WARNING_IDS[@]}" | jq -R . | jq -s .)"
    fi
    jq -n \
        --argjson total "$TOTAL" \
        --argjson pass "$PASS" \
        --argjson fail "$FAIL" \
        --argjson warn "$WARN" \
        --argjson failing_ids "$fail_json" \
        --argjson warning_ids "$warn_json" \
        '{
            total: $total,
            pass: $pass,
            fail: $fail,
            warn: $warn,
            skipped_inline: 0,
            skipped_retired: 0,
            skipped_network: 0,
            receipt_integrity_warnings: 0,
            failing_ids: $failing_ids,
            warning_ids: $warning_ids,
            blocking_fail_ids: $failing_ids,
            non_blocking_fail_ids: []
        }'
else
    echo ""
    echo "Engine smoke: $PASS/$TOTAL pass, $FAIL fail, $WARN warn"
fi

