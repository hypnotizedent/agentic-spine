#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path
from typing import Any

import yaml


def expand(raw: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(raw)))).resolve()


DEFAULT_ROOT = expand(Path(__file__).resolve().parents[5])


def git_top_level(start: Path) -> Path | None:
    probe = start if start.is_dir() else start.parent
    proc = subprocess.run(
        ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    stdout = proc.stdout.strip()
    return Path(stdout).resolve() if stdout else None


def resolve_target_root(explicit: str | None = None) -> Path:
    if explicit:
        return expand(explicit)
    cwd_root = git_top_level(Path.cwd())
    if cwd_root is not None:
        return cwd_root
    script_root = git_top_level(Path(__file__).resolve())
    if script_root is not None:
        return script_root
    for env_name in ("SPINE_TARGET_REPO", "SPINE_ROOT", "SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(env_name)
        if value:
            return expand(value)
    return DEFAULT_ROOT


ROOT = DEFAULT_ROOT
CONTRACT = ROOT / "ops/bindings/spine.self-governance.lifecycle.contract.yaml"
PROJECTED = ROOT / "ops/bindings/spine.self-governance.lifecycle.projected.yaml"
CATALOG = ROOT / "ops/bindings/workflow.vocabulary.catalog.yaml"
WORKFLOW_CONTRACT = ROOT / "ops/bindings/workflow.vocabulary.contract.yaml"
MEMORY_CONTRACT = ROOT / "ops/bindings/memory.continuity.contract.yaml"
TELEMETRY_CONTRACT = ROOT / "ops/bindings/spine.surface.usage.telemetry.contract.yaml"
PROJECTION_BUILD = ROOT / "ops/plugins/core/authority/bin/spine-self-governance-projection-build"
WORKFLOW_ROUTE = ROOT / "ops/plugins/core/orchestration/bin/workflow-route"
USAGE_TELEMETRY = ROOT / "ops/plugins/core/evidence/bin/spine-surface-usage-telemetry"
SESSION_START = ROOT / "ops/plugins/core/session/bin/session-start"
WORKTREE_RECONCILE = ROOT / "ops/plugins/core/lifecycle/bin/worktree-lifecycle-reconcile"
LOOP_CLOSEOUT = ROOT / "ops/plugins/core/loops/bin/loop-closeout-finalize"
LOOP_ID = "LOOP-SPINE-SELF-GOVERNANCE-LIFECYCLE-CANONICALIZATION-20260321"


def fail(message: str, code: int = 1) -> None:
    print(f"spine.self-governance.status FAIL: {message}", file=os.sys.stderr)
    raise SystemExit(code)


def load_yaml(path: Path) -> dict[str, Any]:
    if not path.is_file():
        fail(f"missing YAML file: {path}")
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        fail(f"expected mapping root: {path}")
    return data


def load_markdown_frontmatter(path: Path) -> dict[str, Any]:
    if not path.is_file():
        fail(f"missing markdown file: {path}")
    lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    if not lines or lines[0].strip() != "---":
        fail(f"missing YAML frontmatter: {path}")
    body: list[str] = []
    for line in lines[1:]:
        if line.strip() == "---":
            break
        body.append(line)
    data = yaml.safe_load("\n".join(body)) or {}
    if not isinstance(data, dict):
        fail(f"expected mapping frontmatter: {path}")
    return data


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="spine-self-governance-status")
    parser.add_argument("--root", help="Target checkout root.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--brief", action="store_true")
    parser.add_argument("--strict", action="store_true")
    return parser.parse_args()


def configure_root(root: Path) -> None:
    global ROOT, CONTRACT, PROJECTED, CATALOG, WORKFLOW_CONTRACT, MEMORY_CONTRACT
    global TELEMETRY_CONTRACT
    global PROJECTION_BUILD, WORKFLOW_ROUTE, USAGE_TELEMETRY, SESSION_START
    global WORKTREE_RECONCILE, LOOP_CLOSEOUT

    ROOT = root
    CONTRACT = ROOT / "ops/bindings/spine.self-governance.lifecycle.contract.yaml"
    PROJECTED = ROOT / "ops/bindings/spine.self-governance.lifecycle.projected.yaml"
    CATALOG = ROOT / "ops/bindings/workflow.vocabulary.catalog.yaml"
    WORKFLOW_CONTRACT = ROOT / "ops/bindings/workflow.vocabulary.contract.yaml"
    MEMORY_CONTRACT = ROOT / "ops/bindings/memory.continuity.contract.yaml"
    TELEMETRY_CONTRACT = ROOT / "ops/bindings/spine.surface.usage.telemetry.contract.yaml"
    PROJECTION_BUILD = ROOT / "ops/plugins/core/authority/bin/spine-self-governance-projection-build"
    WORKFLOW_ROUTE = ROOT / "ops/plugins/core/orchestration/bin/workflow-route"
    USAGE_TELEMETRY = ROOT / "ops/plugins/core/evidence/bin/spine-surface-usage-telemetry"
    SESSION_START = ROOT / "ops/plugins/core/session/bin/session-start"
    WORKTREE_RECONCILE = ROOT / "ops/plugins/core/lifecycle/bin/worktree-lifecycle-reconcile"
    LOOP_CLOSEOUT = ROOT / "ops/plugins/core/loops/bin/loop-closeout-finalize"


def run_checked(command: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["SPINE_TARGET_REPO"] = str(ROOT)
    env["SPINE_ROOT"] = str(ROOT)
    env["SPINE_REPO"] = str(ROOT)
    env["SPINE_CODE"] = str(ROOT)
    return subprocess.run(command, text=True, capture_output=True, cwd=str(cwd or ROOT), env=env)


def resolve_state_root() -> Path:
    env_state = os.environ.get("SPINE_STATE")
    if env_state:
        return Path(env_state).expanduser().resolve()
    direct = (ROOT / ".runtime/spine/state").resolve()
    if direct.exists():
        return direct
    candidate = ROOT.resolve()
    for parent in (candidate, *candidate.parents):
        probe = (parent / ".runtime/spine/state").resolve()
        if probe.exists():
            return probe
    return (ROOT.parent / ".runtime/spine/state").resolve()


def parse_scope_status(scope_path: Path) -> tuple[bool, str]:
    if not scope_path.is_file():
        return False, f"missing loop scope: {scope_path}"
    data = load_markdown_frontmatter(scope_path)
    status = str(data.get("status") or "").strip().lower()
    owner = str(data.get("owner") or "").strip()
    if status != "active":
        return False, f"loop scope status is {status or 'unset'}"
    if not owner:
        return False, "loop scope owner missing"
    return True, f"active scope owned by {owner}"


def parse_loop_scope_authority(scope_path: Path, provenance_contracts: list[Path]) -> tuple[bool, str]:
    scope_ok, scope_detail = parse_scope_status(scope_path)
    if scope_ok:
        return scope_ok, scope_detail

    introduced_by: dict[str, list[str]] = {}
    for contract_path in provenance_contracts:
        if not contract_path.is_file():
            continue
        data = load_yaml(contract_path)
        loop_id = str(data.get("introduced_by") or "").strip()
        if not loop_id:
            continue
        introduced_by.setdefault(loop_id, []).append(contract_path.name)

    historical_sources = introduced_by.get(LOOP_ID) or []
    if historical_sources:
        historical_sources.sort()
        source_list = ", ".join(historical_sources)
        return True, f"historical provenance anchored by {LOOP_ID} in {source_list}; active loop scope not required"

    return False, scope_detail


def main() -> None:
    args = parse_args()
    configure_root(resolve_target_root(args.root))
    checks: list[dict[str, str]] = []
    fail_count = 0
    warn_count = 0
    missing_required = False

    def record(name: str, status: str, detail: str) -> None:
        nonlocal fail_count, warn_count
        checks.append({"name": name, "status": status, "detail": detail})
        if status == "FAIL":
            fail_count += 1
        elif status == "WARN":
            warn_count += 1

    for required in (CONTRACT, WORKFLOW_CONTRACT, MEMORY_CONTRACT, TELEMETRY_CONTRACT, PROJECTED, CATALOG):
        if required.is_file():
            record(required.name, "PASS", "present")
        else:
            record(required.name, "FAIL", "missing")
            missing_required = True

    if missing_required:
        overall = "FAIL"
        if args.json:
            print(json.dumps({
                "capability": "spine.self-governance.status",
                "status": overall.lower(),
                "fail": fail_count,
                "warn": warn_count,
                "checks": checks,
            }, indent=2, sort_keys=False))
            raise SystemExit(1)
        if args.brief:
            print(f"{overall} issues={fail_count} warnings={warn_count} workflow_concepts=0 capability_dormant=0 gate_dormant=0 binding_low_ref=0")
            raise SystemExit(1)
        print("spine.self-governance.status")
        print(f"status: {overall}")
        print(f"fail: {fail_count}")
        print(f"warn: {warn_count}")
        for check in checks:
            print(f"[{check['status']}] {check['name']}: {check['detail']}")
        raise SystemExit(1)

    projection_proc = run_checked(["python3", str(PROJECTION_BUILD), "--root", str(ROOT), "--check"])
    if projection_proc.returncode == 0:
        record("projection_parity", "PASS", "self-governance projections are in sync")
    else:
        detail = projection_proc.stdout.strip() or projection_proc.stderr.strip() or "projection drift"
        record("projection_parity", "FAIL", detail)

    workflow_contract = load_yaml(WORKFLOW_CONTRACT)
    workflow_catalog = load_yaml(CATALOG)
    required_concepts = [str(item) for item in (workflow_contract.get("required_core_concepts") or [])]
    concept_rows = workflow_catalog.get("concepts") or {}
    missing_routes = []
    for concept in required_concepts:
        row = concept_rows.get(concept) or {}
        if not row or not row.get("route_ready"):
            missing_routes.append(concept)
    if missing_routes:
        record("workflow_vocabulary", "FAIL", f"concepts not route-ready: {', '.join(missing_routes)}")
    else:
        record("workflow_vocabulary", "PASS", f"{len(required_concepts)} core concepts are route-ready")

    route_proc = run_checked(["python3", str(WORKFLOW_ROUTE), "loop", "--json"], cwd=ROOT)
    if route_proc.returncode == 0:
        record("workflow_route_command", "PASS", "workflow.route resolves canonical concepts")
    else:
        record("workflow_route_command", "FAIL", route_proc.stderr.strip() or "workflow.route failed")

    help_proc = run_checked([str(SESSION_START), "--help"], cwd=ROOT)
    help_text = (help_proc.stdout or "") + (help_proc.stderr or "")
    if "fast|full|degraded" in help_text or "fast|full|degraded" in help_text.replace(" ", ""):
        record("session_start_degraded", "PASS", "session.start advertises degraded mode")
    else:
        record("session_start_degraded", "FAIL", "session.start help does not advertise degraded mode")

    memory_contract = load_yaml(MEMORY_CONTRACT)
    fallback_layers = memory_contract.get("fallback_layers") or []
    non_anything_fallbacks = [row for row in fallback_layers if isinstance(row, dict) and row.get("id") != "anythingllm"]
    if len(non_anything_fallbacks) >= 3:
        record("memory_continuity", "PASS", f"{len(non_anything_fallbacks)} non-AnythingLLM fallback layers declared")
    else:
        record("memory_continuity", "FAIL", "fewer than 3 non-AnythingLLM fallback layers declared")

    usage_proc = run_checked(["python3", str(USAGE_TELEMETRY), "--root", str(ROOT), "--json"])
    if usage_proc.returncode != 0:
        record("usage_telemetry", "FAIL", usage_proc.stderr.strip() or "usage telemetry failed")
        telemetry = {}
    else:
        telemetry = json.loads(usage_proc.stdout or "{}")
        record("usage_telemetry", "PASS", "usage telemetry surface executed")

    residue_proc = run_checked([str(WORKTREE_RECONCILE), "--lane", "--brief"], cwd=ROOT)
    residue_out = (residue_proc.stdout or "").strip()
    residue_detail = residue_out.splitlines()[0] if residue_out else (residue_proc.stderr.strip() or "worktree lifecycle check completed")
    if residue_proc.returncode == 0:
        if residue_out.startswith("WARN "):
            record("worktree_residue", "WARN", residue_detail)
        else:
            record("worktree_residue", "PASS", residue_detail)
    else:
        record("worktree_residue", "FAIL", residue_detail)

    scope_ok, scope_detail = parse_loop_scope_authority(
        resolve_state_root() / "loop-scopes" / f"{LOOP_ID}.scope.md",
        [WORKFLOW_CONTRACT, MEMORY_CONTRACT, TELEMETRY_CONTRACT],
    )
    record("loop_scope_authority", "PASS" if scope_ok else "FAIL", scope_detail)

    closeout_proc = run_checked([str(LOOP_CLOSEOUT), "--self-check"], cwd=ROOT)
    closeout_out = (closeout_proc.stdout or "").strip()
    closeout_detail = closeout_out.splitlines()[0] if closeout_out else (closeout_proc.stderr.strip() or "loop closeout self-check completed")
    if closeout_proc.returncode == 0:
        record("loop_closeout_authority", "PASS", closeout_detail)
    else:
        record("loop_closeout_authority", "FAIL", closeout_detail)

    capability_dormant = len(((telemetry.get("capabilities") or {}).get("dormant_candidates") or []))
    gate_dormant = len(((telemetry.get("gates") or {}).get("dormant_candidates") or []))
    binding_low_ref = len(((telemetry.get("bindings") or {}).get("low_reference_candidates") or []))
    if capability_dormant or gate_dormant or binding_low_ref:
        record(
            "dormancy_candidates",
            "WARN",
            f"capabilities={capability_dormant}, gates={gate_dormant}, bindings={binding_low_ref}",
        )
    else:
        record("dormancy_candidates", "PASS", "no dormant candidate surfaces in current telemetry window")

    overall = "PASS" if fail_count == 0 else "FAIL"
    if fail_count == 0 and warn_count > 0:
        overall = "WARN"

    if args.json:
        print(json.dumps({
            "capability": "spine.self-governance.status",
            "status": overall.lower(),
            "fail": fail_count,
            "warn": warn_count,
            "checks": checks,
        }, indent=2, sort_keys=False))
        raise SystemExit(1 if (args.strict and fail_count > 0) else (1 if fail_count > 0 else 0))

    if args.brief:
        issues = fail_count
        residue_status = next((check["status"] for check in checks if check["name"] == "worktree_residue"), "UNK")
        closeout_status = next((check["status"] for check in checks if check["name"] == "loop_closeout_authority"), "UNK")
        scope_status = next((check["status"] for check in checks if check["name"] == "loop_scope_authority"), "UNK")
        print(
            f"{overall} issues={issues} warnings={warn_count} "
            f"workflow_concepts={len(required_concepts)} "
            f"capability_dormant={capability_dormant} gate_dormant={gate_dormant} binding_low_ref={binding_low_ref} "
            f"worktree_residue={residue_status} loop_scope={scope_status} loop_closeout={closeout_status}"
        )
        raise SystemExit(1 if fail_count > 0 else 0)

    print("spine.self-governance.status")
    print(f"status: {overall}")
    print(f"fail: {fail_count}")
    print(f"warn: {warn_count}")
    for check in checks:
        print(f"[{check['status']}] {check['name']}: {check['detail']}")
    raise SystemExit(1 if fail_count > 0 else 0)


if __name__ == "__main__":
    main()
