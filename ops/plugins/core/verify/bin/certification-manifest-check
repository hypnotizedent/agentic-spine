#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import tempfile
from collections import Counter
from pathlib import Path
from typing import Any

import yaml


DEFAULT_REPOS = [
    ("agentic-spine", "/Users/ronnyworks/code/agentic-spine"),
    ("agentic-foundation", "/Users/ronnyworks/code/agentic-foundation"),
]

SCRIPT = Path(__file__).resolve()
ROOT = SCRIPT.parents[5]
BASELINE_BIN = ROOT / "ops/plugins/core/verify/bin/certification-baseline-inventory"
DEFAULT_IGNORE_PREFIXES = ("docs/reference/generated/certification/",)


def _repo_specs(raw: list[str] | None) -> list[tuple[str, Path]]:
    if not raw:
        return [(label, Path(path).expanduser().resolve()) for label, path in DEFAULT_REPOS]
    specs: list[tuple[str, Path]] = []
    for item in raw:
        if "=" not in item:
            raise SystemExit(f"invalid --repo value: {item!r}")
        label, raw_path = item.split("=", 1)
        specs.append((label, Path(raw_path).expanduser().resolve()))
    return specs


def _run_baseline(repo_specs: list[tuple[str, Path]]) -> dict[str, Any]:
    with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as handle:
        baseline_path = Path(handle.name)
    try:
        cmd = [str(BASELINE_BIN), "--json-out", str(baseline_path)]
        for label, path in repo_specs:
            cmd.extend(["--repo", f"{label}={path}"])
        subprocess.run(cmd, check=True)
        return json.loads(baseline_path.read_text(encoding="utf-8"))
    finally:
        baseline_path.unlink(missing_ok=True)


def _ignore_prefixes(manifest: dict[str, Any]) -> tuple[str, ...]:
    prefixes = list(DEFAULT_IGNORE_PREFIXES)
    prefixes.extend(str(item) for item in manifest.get("coverage_exclusions", []) if item)
    return tuple(dict.fromkeys(prefixes))


def _load_manifest(path: Path) -> dict[str, Any]:
    payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise SystemExit("manifest payload must be a mapping")
    return payload


def _manifest_index(manifest: dict[str, Any]) -> dict[tuple[str, str], dict[str, Any]]:
    index: dict[tuple[str, str], dict[str, Any]] = {}
    repos = manifest.get("repos", [])
    if not isinstance(repos, list):
        raise SystemExit("manifest.repos must be a list")
    for repo in repos:
        if not isinstance(repo, dict):
            raise SystemExit("manifest repo entry must be a mapping")
        label = str(repo.get("label", ""))
        for row in repo.get("files", []):
            if not isinstance(row, dict):
                raise SystemExit("manifest file entry must be a mapping")
            key = (label, str(row.get("path", "")))
            index[key] = row
    return index


def _should_ignore(rel: str, prefixes: tuple[str, ...]) -> bool:
    rel = rel.replace("\\", "/")
    return any(rel.startswith(prefix) for prefix in prefixes)


def main() -> int:
    parser = argparse.ArgumentParser(description="Check manifest-backed certification coverage")
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--repo", action="append", metavar="LABEL=PATH")
    args = parser.parse_args()

    repo_specs = _repo_specs(args.repo)
    manifest = _load_manifest(Path(args.manifest).expanduser())
    prefixes = _ignore_prefixes(manifest)
    baseline = _run_baseline(repo_specs)
    manifest_index = _manifest_index(manifest)

    missing: list[str] = []
    manifest_only: list[str] = []
    mismatched: list[str] = []
    coverage_counts: Counter[str] = Counter()

    for record in baseline["files"]:
        rel = str(record["path"]).replace("\\", "/")
        if _should_ignore(rel, prefixes):
            continue
        key = (record["repo"], rel)
        inline_present = bool(record["inline_certification_present"])
        manifest_row = manifest_index.get(key)
        if manifest_row is None:
            if inline_present:
                coverage_counts["inline"] += 1
                continue
            missing.append(f"{record['repo']}:{rel}")
            continue
        coverage_counts[str(manifest_row.get("coverage_basis", "manifest"))] += 1
        if str(manifest_row.get("classification", "")) != str(record["classification"]):
            mismatched.append(
                f"{record['repo']}:{rel} classification {manifest_row.get('classification')!r} != {record['classification']!r}"
            )
        if bool(manifest_row.get("inline_certification_present")) != inline_present:
            mismatched.append(
                f"{record['repo']}:{rel} inline_certification_present {manifest_row.get('inline_certification_present')!r} != {inline_present!r}"
            )
        if bool(manifest_row.get("inline_certification_allowed")) != bool(record["inline_certification_allowed"]):
            mismatched.append(
                f"{record['repo']}:{rel} inline_certification_allowed {manifest_row.get('inline_certification_allowed')!r} != {record['inline_certification_allowed']!r}"
            )

    actual_keys = {
        (record["repo"], str(record["path"]).replace("\\", "/"))
        for record in baseline["files"]
        if not _should_ignore(str(record["path"]), prefixes)
    }
    for key, row in manifest_index.items():
        if key not in actual_keys:
            manifest_only.append(f"{key[0]}:{key[1]}")
        if not row.get("rationale"):
            mismatched.append(f"{key[0]}:{key[1]} missing rationale")

    if missing or manifest_only or mismatched:
        print("certification-manifest-check FAIL")
        if missing:
            print(f"  missing coverage: {len(missing)}")
            for item in missing[:20]:
                print(f"    - {item}")
        if manifest_only:
            print(f"  stale manifest entries: {len(manifest_only)}")
            for item in manifest_only[:20]:
                print(f"    - {item}")
        if mismatched:
            print(f"  mismatched rows: {len(mismatched)}")
            for item in mismatched[:20]:
                print(f"    - {item}")
        return 1

    print("certification-manifest-check PASS")
    print(f"  manifest_covered_or_inline: {sum(coverage_counts.values())}")
    print(f"  coverage_basis_counts: {dict(sorted(coverage_counts.items()))}")
    print(f"  repos_checked: {len(repo_specs)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
