#!/usr/bin/env bash
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
ROUTING_DISPATCH="$ROOT/ops/bindings/routing.dispatch.yaml"
CAPABILITY_MAP="$ROOT/ops/bindings/capability_map.yaml"

usage() {
  cat <<'USAGE'
gate-mutation-trailers

Usage:
  gate-mutation-trailers \
    --capability <gate.registry.add|gate.registry.update|gate.topology.assign|gate.topology.validate|domain.onboard.new|projection.reconcile> \
    [--mutation <text>] \
    [--run-key <CAP-...>] \
    [--json]

  gate-mutation-trailers --auto [--run-key <CAP-...>] [--json]
    Infer capability from staged gate files and emit D128 trailers.
    Mapping:
      - gate.registry.yaml (or both files): gate.registry.update
      - gate.execution.topology.yaml only: gate.topology.assign

Emits D128-required commit trailers for gate contract mutations.
USAGE
}

fail() {
  echo "gate.mutation.trailers FAIL: $*" >&2
  exit 1
}

command -v yq >/dev/null 2>&1 || fail "missing required tool: yq"
[[ -f "$ROUTING_DISPATCH" ]] || fail "missing routing authority: $ROUTING_DISPATCH"
[[ -f "$CAPABILITY_MAP" ]] || fail "missing capability authority: $CAPABILITY_MAP"
yq e '.' "$ROUTING_DISPATCH" >/dev/null 2>&1 || fail "invalid YAML: $ROUTING_DISPATCH"
yq e '.' "$CAPABILITY_MAP" >/dev/null 2>&1 || fail "invalid YAML: $CAPABILITY_MAP"

CAPABILITY=""
MUTATION="capability"
RUN_KEY="${SPINE_CAP_RUN_KEY:-manual}"
JSON_MODE="false"
AUTO_MODE="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --capability) CAPABILITY="${2:-}"; shift 2 ;;
    --mutation) MUTATION="${2:-}"; shift 2 ;;
    --run-key) RUN_KEY="${2:-}"; shift 2 ;;
    --json) JSON_MODE="true"; shift ;;
    --auto) AUTO_MODE="true"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

infer_capability_from_staged() {
  local staged_files
  staged_files="$(git -C "$ROOT" diff --cached --name-only 2>/dev/null || true)"
  local has_registry=0
  local has_topology=0
  if echo "$staged_files" | grep -q "ops/bindings/gate\\.registry\\.yaml"; then
    has_registry=1
  fi
  if echo "$staged_files" | grep -q "ops/bindings/gate\\.execution\\.topology\\.yaml"; then
    has_topology=1
  fi

  if [[ "$has_registry" -eq 1 ]]; then
    echo "gate.registry.update"
    return
  fi
  if [[ "$has_topology" -eq 1 ]]; then
    echo "gate.topology.assign"
    return
  fi
  echo ""
}

script_allowed_for_d128() {
  case "$1" in
    gate-registry-add|gate-registry-update|gate-topology-assign|gate-topology-validate|domain-onboard-new|projection-reconcile)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

capability_allowed() {
  local capability="$1"
  local routing_script=""
  routing_script="$(yq e -r ".\"$capability\".target.script // \"\"" "$ROUTING_DISPATCH" 2>/dev/null || true)"
  [[ -n "$routing_script" ]] || return 1
  script_allowed_for_d128 "$routing_script" || return 1

  local map_type=""
  map_type="$(yq e -r ".\"$capability\" | type" "$CAPABILITY_MAP" 2>/dev/null || true)"
  [[ "$map_type" == "!!map" ]] || return 1

  return 0
}

if [[ "$AUTO_MODE" == "true" ]]; then
  CAPABILITY="$(infer_capability_from_staged)"
  [[ -n "$CAPABILITY" ]] || fail "--auto could not infer capability from staged gate files"
fi

[[ -n "$CAPABILITY" ]] || fail "--capability is required (or use --auto)"
[[ -n "$MUTATION" ]] || fail "--mutation requires a value"
[[ -n "$RUN_KEY" ]] || fail "--run-key requires a value"

if ! capability_allowed "$CAPABILITY"; then
  fail "capability '$CAPABILITY' is not allowed by live routing/capability authorities"
fi

if [[ "$JSON_MODE" == "true" ]]; then
  command -v jq >/dev/null 2>&1 || fail "missing required tool: jq"
  jq -n \
    --arg mutation "$MUTATION" \
    --arg capability "$CAPABILITY" \
    --arg run_key "$RUN_KEY" \
    '{GateMutation: $mutation, GateCapability: $capability, GateRunKey: $run_key}'
  exit 0
fi

cat <<EOF
Gate-Mutation: $MUTATION
Gate-Capability: $CAPABILITY
Gate-Run-Key: $RUN_KEY
EOF
