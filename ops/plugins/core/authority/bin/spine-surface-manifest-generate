def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def resolve_root() -> Path:
    env = (os.environ.get("SPINE_CODE") or "").strip()
    if env:
        root = Path(env).expanduser().resolve()
        if (root / "ops" / "capabilities.yaml").exists():
            return root
    return Path(__file__).resolve().parents[5]


def workspace_root(root: Path) -> Path:
    env = (os.environ.get("SPINE_WORKSPACE_ROOT") or "").strip()
    if env:
        return Path(env).expanduser().resolve()
    return root.parent


def state_root(root: Path) -> Path:
    env = (os.environ.get("SPINE_STATE") or "").strip()
    if env:
        return Path(env).expanduser().resolve()
    return workspace_root(root) / ".runtime" / "spine" / "state"


def runtime_root(root: Path) -> Path:
    env = (os.environ.get("SPINE_RUNTIME_ROOT") or "").strip()
    if env:
        return Path(env).expanduser().resolve()
    return state_root(root).parent


def evidence_root(root: Path) -> Path:
    env = (os.environ.get("SPINE_EVIDENCE_ROOT") or "").strip()
    if env:
        return Path(env).expanduser().resolve()
    return workspace_root(root) / ".evidence" / "spine"


def repo_head(root: Path) -> str:
    proc = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=str(root),
        text=True,
        capture_output=True,
        check=False,
    )
    value = proc.stdout.strip()
    return value if proc.returncode == 0 and value else "unknown"


def repo_is_dirty(root: Path) -> bool:
    proc = subprocess.run(
        ["git", "status", "--short"],
        cwd=str(root),
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        return False
    return bool(proc.stdout.strip())


def repo_anchor(root: Path) -> str:
    head = repo_head(root)
    return f"{head}-dirty" if head != "unknown" and repo_is_dirty(root) else head


def path_exists(path: str | Path | None) -> bool:
    return bool(path) and Path(path).exists()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def existing_generated_at(path: Path) -> str | None:
    if not path.exists():
        return None
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    value = str(payload.get("generated_at_utc") or "").strip()
    return value or None


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def yaml_text(data: Any) -> str:
    return yaml.safe_dump(data, sort_keys=False, allow_unicode=False)


def surface_row(
    *,
    surface_id: str,
    path: Path,
    surface_kind: str,
    authority_class: str,
    lifecycle_state: str,
    materialization_class: str,
    scope_class: str,
    entry_role: str,
    family: str | None = None,
    contract: Path | None = None,
    loop: str | None = None,
    receipt: Path | None = None,
    generated_from: list[str] | None = None,
    supersedes: list[str] | None = None,
    depends_on: list[str] | None = None,
    regenerated_by_surface_id: str | None = None,
    regenerated_by_command: str | None = None,
    verify_scope_refs: list[str] | None = None,
    notes: str = "",
) -> dict[str, Any]:
    row = {
        "surface_id": surface_id,
        "path": str(path),
        "surface_kind": surface_kind,
        "authority_class": authority_class,
        "lifecycle_state": lifecycle_state,
        "materialization_class": materialization_class,
        "scope_class": scope_class,
        "node_scope": "spine_only",
        "entry_role": entry_role,
        "governed_by": {
            "family": family,
            "contract": str(contract) if contract else None,
            "loop": loop,
            "receipt": str(receipt) if receipt else None,
        },
        "generated_from": generated_from or [],
        "supersedes": supersedes or [],
        "depends_on": depends_on or [],
        "regenerated_by": {
            "surface_id": regenerated_by_surface_id,
            "command": regenerated_by_command,
        },
        "verify_scope_refs": verify_scope_refs or [],
        "notes": notes,
    }
    row["knowledge"] = infer_surface_knowledge(row)
    return row


def infer_surface_knowledge(row: dict[str, Any]) -> dict[str, Any]:
    surface_kind = str(row.get("surface_kind") or "").strip()
    authority_class = str(row.get("authority_class") or "").strip()
    lifecycle_state = str(row.get("lifecycle_state") or "").strip()
    entry_role = str(row.get("entry_role") or "").strip()
    notes = str(row.get("notes") or "").strip()
    family = str((row.get("governed_by") or {}).get("family") or "").strip()
    path = str(row.get("path") or "").strip()
    generated_from = row.get("generated_from") if isinstance(row.get("generated_from"), list) else []
    depends_on = row.get("depends_on") if isinstance(row.get("depends_on"), list) else []
    regenerated_by = row.get("regenerated_by") if isinstance(row.get("regenerated_by"), dict) else {}
    regenerated_by_surface = str(regenerated_by.get("surface_id") or "").strip()
    regenerated_by_command = str(regenerated_by.get("command") or "").strip()

    does = notes
    if not does:
        if surface_kind == "entry_surface":
            does = "Defines a canonical entry or runtime-read surface for spine operation."
        elif surface_kind == "binding_contract":
            does = "Defines governed contract truth for a spine runtime concern."
        elif surface_kind == "command":
            does = "Acts as an operator-facing command surface for governed spine work."
        elif surface_kind == "runtime_surface":
            does = "Implements a runtime helper or governed execution seam inside spine scope."
        elif surface_kind == "state_authority":
            does = "Stores live authoritative runtime state for a spine concern."
        elif surface_kind == "generated_projection":
            does = "Projects readable state from an authoritative spine surface."
        elif surface_kind == "archive_surface":
            does = "Retains archived historical material for continuity only."
        else:
            does = "Participates in the spine-only authority graph."

    answers: list[str] = []
    if entry_role == "canonical_first_read":
        answers.append("Which surface must be read first before any spine work begins.")
    elif entry_role == "session_attach":
        answers.append("Which runtime attach surface is used at terminal birth.")
    elif entry_role == "runtime_read":
        answers.append("Which live surface should be read directly for current spine truth.")
    elif entry_role == "operator_only":
        answers.append("Which operator-facing projection or wrapper to use for this concern.")

    if family:
        answers.append(f"Which `{family}` family or lifecycle concern this surface governs or serves.")
    elif surface_kind == "binding_contract":
        answers.append("Which contract path is authoritative for this spine concern.")
    elif surface_kind == "state_authority":
        answers.append("Where the live authoritative state for this concern is stored.")
    elif surface_kind == "generated_projection":
        answers.append("Where the readable derived state for this concern is projected.")
    elif surface_kind in {"command", "runtime_surface"}:
        answers.append("Which command or runtime surface handles this spine concern.")
    else:
        answers.append("How this surface fits into the spine-only authority graph.")

    if generated_from:
        answers.append(f"Which source surfaces materially feed this surface: {', '.join(generated_from)}.")
    elif depends_on:
        answers.append(f"Which supporting surfaces this surface depends on: {', '.join(depends_on)}.")

    lacks: list[str] = []
    if authority_class != "authoritative":
        lacks.append("It is not authoritative by itself; read its upstream authoritative surface for final truth.")
    if surface_kind == "generated_projection":
        lacks.append("It does not replace its source authority and may lag until regeneration runs.")
    elif surface_kind == "command":
        lacks.append("It does not prove success on its own without receipts, state mutation, or verify output.")
    elif surface_kind == "runtime_surface":
        lacks.append("It does not define policy by itself; its governing contract or caller still owns policy truth.")
    elif surface_kind == "state_authority":
        lacks.append("It does not explain operator workflow on its own without the governing contract or entry surface.")
    elif surface_kind in {"archive_surface", "historical_reference"}:
        lacks.append("It is not live authority and must not be treated as first-read truth.")

    lacks.append("It does not answer domain or L3 workload truth outside the current spine-only aperture.")

    if lifecycle_state in {"archived", "retired"}:
        obsoletes_when = "Already historical; retained only until archive policy or explicit retirement cleanup removes it."
    elif regenerated_by_command or regenerated_by_surface:
        source = regenerated_by_command or regenerated_by_surface
        obsoletes_when = f"When `{source}` regenerates or supersedes this surface with newer authoritative output."
    elif authority_class == "authoritative":
        obsoletes_when = "When a governed successor authoritative surface explicitly supersedes this path and the manifest relations are updated."
    else:
        obsoletes_when = "When its upstream authoritative surface or governed wrapper supersedes its current role."

    return {
        "what_it_does": does,
        "what_it_answers": answers,
        "what_it_lacks": lacks,
        "obsoletes_when": obsoletes_when,
    }


