def validate_manifest(data: dict[str, Any]) -> dict[str, Any]:
    surfaces = data["surfaces"]
    families = data["workflow_families"]
    verify_sets = data["verify_sets"]
    entry_chain = data["entry_chain"]
    surface_ids = [row["surface_id"] for row in surfaces]
    family_ids = [row["family_id"] for row in families]
    entry_lookup = {row["surface_id"]: row for row in surfaces}
    issues: list[str] = []

    if len(surface_ids) != len(set(surface_ids)):
        issues.append("duplicate surface_id detected")
    if len(family_ids) != len(set(family_ids)):
        issues.append("duplicate family_id detected")

    missing_families = [family for family in REQUIRED_FAMILIES if family not in family_ids]
    if missing_families:
        issues.append(f"missing required workflow families: {', '.join(missing_families)}")

    verify_matches = [row for row in verify_sets if row["scope"] == "spine_only" and bool(row["authoritative"])]
    if len(verify_matches) != 1:
        issues.append(f"expected exactly one authoritative spine_only verify set, found {len(verify_matches)}")

    for surface_id in entry_chain:
        row = entry_lookup.get(surface_id)
        if not row:
            issues.append(f"entry_chain references missing surface_id {surface_id}")
            continue
        if row["authority_class"] in {"historical", "residue"}:
            issues.append(f"entry_chain contains non-live surface {surface_id}")

    for row in surfaces:
        requires_regeneration = row["surface_id"] == "spine_surface_manifest_yaml" or (
            row["authority_class"] in {"authoritative", "supporting"} and row["surface_kind"] == "generated_projection"
        )
        if requires_regeneration and not (row["regenerated_by"]["surface_id"] or row["regenerated_by"]["command"]):
            issues.append(f"generated/projected surface missing regeneration story: {row['surface_id']}")

    missing_knowledge = []
    for row in surfaces:
        live_authoritative = row["authority_class"] == "authoritative" and row["lifecycle_state"] in {"live", "generated_live"}
        if not live_authoritative:
            continue
        knowledge = row.get("knowledge") if isinstance(row.get("knowledge"), dict) else {}
        does = str(knowledge.get("what_it_does") or "").strip()
        answers = knowledge.get("what_it_answers") if isinstance(knowledge.get("what_it_answers"), list) else []
        lacks = knowledge.get("what_it_lacks") if isinstance(knowledge.get("what_it_lacks"), list) else []
        obsoletes_when = str(knowledge.get("obsoletes_when") or "").strip()
        if not does or not answers or not lacks or not obsoletes_when:
            missing_knowledge.append(row["surface_id"])
    if missing_knowledge:
        issues.append(
            "live authoritative surfaces missing knowledge fields: " + ", ".join(sorted(missing_knowledge))
        )

    family_map = {row["family_id"]: row for row in families}
    if family_map.get("gap", {}).get("container_role") == "work_container":
        issues.append("gap must never be marked as a primary work container")
    if family_map.get("friction", {}).get("container_role") == "work_container":
        issues.append("friction must never be marked as a primary work container")
    if "idea" in family_ids:
        issues.append("idea must never appear as a governed family")

    checks = {
        "unique_surface_ids": "pass" if len(surface_ids) == len(set(surface_ids)) else "fail",
        "required_family_ids_present": "pass" if not missing_families else "fail",
        "authoritative_spine_verify_set": "pass" if len(verify_matches) == 1 else "fail",
        "spine_verify_commands_present": "pass" if any(cmd == "./bin/ops verify --spine" for row in verify_sets for cmd in row["canonical_commands"]) and any(cmd == "./bin/ops cap run verify.run -- spine" for row in verify_sets for cmd in row["canonical_commands"]) else "fail",
        "entry_chain_live_only": "pass" if all(entry_lookup.get(sid, {}).get("authority_class") not in {"historical", "residue"} for sid in entry_chain) else "fail",
        "generated_surfaces_regenerable": "pass" if not [row for row in surfaces if (row["surface_id"] == "spine_surface_manifest_yaml" or (row["authority_class"] in {"authoritative", "supporting"} and row["surface_kind"] == "generated_projection")) and not (row["regenerated_by"]["surface_id"] or row["regenerated_by"]["command"])] else "fail",
        "live_authoritative_surfaces_have_knowledge": "pass" if not missing_knowledge else "fail",
        "gap_friction_not_work_container": "pass" if family_map.get("gap", {}).get("container_role") != "work_container" and family_map.get("friction", {}).get("container_role") != "work_container" else "fail",
        "idea_not_family": "pass" if "idea" not in family_ids else "fail",
    }

    return {
        "status": "pass" if not issues else "fail",
        "checks": checks,
        "surface_count": len(surfaces),
        "live_authority_or_supporting_surface_count": sum(1 for row in surfaces if row["authority_class"] in {"authoritative", "supporting"} and row["lifecycle_state"] in {"live", "generated_live"}),
        "historical_surface_count": sum(1 for row in surfaces if row["authority_class"] == "historical"),
        "workflow_family_count": len(families),
        "relation_count": len(data["relations"]),
        "issues": issues,
        "coverage_mode": "curated_spine_core_v1",
        "coverage_note": "This manifest is spine-scope only and intentionally excludes domain workload surfaces outside current packet scope. Spine-only verify is curated and classification-backed.",
    }


def build_markdown(data: dict[str, Any]) -> str:
    lines = [
        f"# {MANIFEST_ID}",
        "",
        f"- Scope: `{data['scope']}`",
        f"- Status: `{data['status']}`",
        f"- Generated: `{data['generated_at_utc']}`",
        f"- Commit: `{data['authoritative_as_of_commit']}`",
        f"- Generator surface: `{data['generator_surface']}`",
        "",
        "## Entry Chain",
    ]
    for surface_id in data["entry_chain"]:
        lines.append(f"- `{surface_id}`")
    lines.extend(["", "## Workflow Families"])
    for row in data["workflow_families"]:
        lines.append(f"- `{row['family_id']}`: role=`{row['container_role']}` authority_home=`{row['authority_home']}`")
    lines.extend(["", "## Verify Sets"])
    for row in data["verify_sets"]:
        cmd_text = ", ".join(f"`{cmd}`" for cmd in row["canonical_commands"])
        excludes_text = ", ".join(f"`{item}`" for item in row["excludes"])
        lines.append(f"- `{row['verify_set_id']}`: authoritative=`{str(row['authoritative']).lower()}` source=`{row['source_of_truth']}` commands={cmd_text}")
        lines.append(f"  - excludes: {excludes_text}")
    lines.extend(["", "## Surface Inventory"])
    for row in data["surfaces"]:
        lines.append(f"- `{row['surface_id']}`: `{row['authority_class']}` / `{row['surface_kind']}` / `{row['lifecycle_state']}` / `{row['path']}`")
        knowledge = row.get("knowledge") if isinstance(row.get("knowledge"), dict) else {}
        does = str(knowledge.get("what_it_does") or "").strip()
        answers = knowledge.get("what_it_answers") if isinstance(knowledge.get("what_it_answers"), list) else []
        lacks = knowledge.get("what_it_lacks") if isinstance(knowledge.get("what_it_lacks"), list) else []
        obsoletes_when = str(knowledge.get("obsoletes_when") or "").strip()
        if does:
            lines.append(f"  - does: {does}")
        if answers:
            lines.append(f"  - answers: {answers[0]}")
        if len(answers) > 1:
            for item in answers[1:]:
                lines.append(f"    - {item}")
        if lacks:
            lines.append(f"  - lacks: {lacks[0]}")
        if len(lacks) > 1:
            for item in lacks[1:]:
                lines.append(f"    - {item}")
        if obsoletes_when:
            lines.append(f"  - obsoletes_when: {obsoletes_when}")
    parity = data.get("parity_surfaces", {})
    if parity:
        lines.extend(["", "## Parity Surfaces"])
        xref = parity.get("capability_gate_cross_reference", {})
        if xref:
            lines.append(f"- capability_gate_cross_reference: `{xref.get('authority_home', '')}` field=`{xref.get('field_name', '')}`")
        vocab = parity.get("capability_domain_vocabulary", {})
        if vocab:
            lines.append(f"- capability_domain_vocabulary: `{vocab.get('authority_home', '')}` enforcement=`{vocab.get('enforcement_surface', '')}`")
        coherence = parity.get("binding_coherence_surfaces", {})
        if coherence:
            lines.append(f"- binding_coherence: `{coherence.get('primary', '')}`")
            for v in coherence.get("validates", []):
                lines.append(f"  - validates: {v}")
    validation = data["validation"]
    lines.extend(["", "## Validation", f"- Status: `{validation['status']}`", f"- Surface count: `{validation['surface_count']}`", f"- Workflow family count: `{validation['workflow_family_count']}`", f"- Relation count: `{validation['relation_count']}`"])
    for issue in validation["issues"]:
        lines.append(f"- Issue: {issue}")
    return "\n".join(lines) + "\n"


def build_parity_surfaces() -> dict[str, Any]:
    """Capability-gate parity and domain vocabulary cross-reference surfaces."""
    return {
        "capability_gate_cross_reference": {
            "authority_home": "ops/bindings/gate.registry.yaml",
            "field_name": "capability_refs",
            "meaning": "capability IDs that directly enforce, own, or implement the gate concern",
            "reciprocal_in_capabilities": False,
        },
        "capability_domain_vocabulary": {
            "authority_home": "ops/bindings/capability.domain.catalog.yaml",
            "enforcement_surface": "ops/plugins/core/authority/bin/capability-register",
        },
        "binding_coherence_surfaces": {
            "primary": "ops/plugins/core/verify/bin/verify-binding-coherence",
            "validates": [
                "binding contract capability refs against capabilities.yaml",
                "gate capability_refs against capabilities.yaml",
                "capability domain normalization against capability.domain.catalog.yaml",
            ],
        },
    }


def _load_verify_target_helper(root: Path) -> Any | None:
    """Import the verify target manifest helper if available."""
    helper_path = root / "ops/plugins/core/verify/lib/spine_verify_target_manifest.py"
    if not helper_path.is_file():
        return None
    try:
        spec = importlib.util.spec_from_file_location(
            "spine_verify_target_manifest", str(helper_path),
        )
        if spec is None or spec.loader is None:
            return None
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


def build_verify_target_data(root: Path) -> dict[str, Any] | None:
    """Build verify target manifest data using the helper, or None if unavailable."""
    mod = _load_verify_target_helper(root)
    if mod is None:
        return None
    try:
        return mod.build_manifest()  # type: ignore[no-any-return]
    except Exception:
        return None


def build_verify_target_markdown(data: dict[str, Any]) -> str:
    """Render the verify target manifest as human-readable markdown."""
    lines = [
        f"# {VTM_MANIFEST_ID}",
        "",
        f"- Scope: `{data.get('scope', '')}`",
        f"- Status: `{data.get('status', '')}`",
        f"- Generated: `{data.get('generated_at_utc', '')}`",
        f"- Commit: `{data.get('authoritative_as_of_commit', '')}`",
        f"- Generator surface: `{data.get('generator_surface', '')}`",
    ]

    targets = data.get("targets")
    if isinstance(targets, list):
        lines.extend(["", "## Targets"])
        for target in targets:
            if not isinstance(target, dict):
                continue
            tid = target.get("target_id", "unknown")
            lines.append(f"")
            lines.append(f"### {tid}")
            lines.append(f"- coverage_status: `{target.get('coverage_status', '')}`")
            lines.append(f"- gate_ids: `{target.get('gate_ids', [])}`")
            lines.append(f"- capability_ids: `{target.get('capability_ids', [])}`")
            notes = target.get("coverage_notes", "")
            if notes:
                lines.append(f"- coverage_notes: {notes}")
    elif isinstance(targets, dict):
        lines.extend(["", "## Targets"])
        for target_id, target_info in targets.items():
            lines.append(f"")
            lines.append(f"### {target_id}")
            if isinstance(target_info, dict):
                for key, value in target_info.items():
                    lines.append(f"- {key}: `{value}`")

    coverage = data.get("coverage_summary")
    if isinstance(coverage, dict):
        lines.extend(["", "## Coverage Summary"])
        for key, value in coverage.items():
            lines.append(f"- {key}: `{value}`")

    executable = data.get("executable_spine_gate_ids")
    if isinstance(executable, list) and executable:
        lines.extend(["", "## Executable Spine Gate IDs"])
        for gate_id in executable:
            lines.append(f"- `{gate_id}`")

    already_covered = data.get("already_covered_gate_ids")
    if isinstance(already_covered, list) and already_covered:
        lines.extend(["", "## Already Covered Gate IDs"])
        for gate_id in already_covered:
            lines.append(f"- `{gate_id}`")

    unmapped_gates = data.get("unmapped_gate_ids")
    if isinstance(unmapped_gates, list) and unmapped_gates:
        lines.extend(["", "## Unmapped Gate IDs"])
        for gate_id in unmapped_gates:
            lines.append(f"- `{gate_id}`")

    unmapped_caps = data.get("unmapped_capability_refs")
    if isinstance(unmapped_caps, list) and unmapped_caps:
        lines.extend(["", "## Unmapped Capability Refs"])
        for cap_ref in unmapped_caps:
            lines.append(f"- `{cap_ref}`")

    issues = data.get("issues")
    if isinstance(issues, list) and issues:
        lines.extend(["", "## Issues"])
        for issue in issues:
            lines.append(f"- {issue}")

    return "\n".join(lines) + "\n"


def build_manifest(root: Path, *, generated_at_utc: str) -> dict[str, Any]:
    state = state_root(root)
    runtime = runtime_root(root)
    evidence = evidence_root(root)
    domain_state = state / "domain-state"
    manifest = {
        "manifest_id": MANIFEST_ID,
        "scope": "spine_only",
        "status": "authoritative_generated",
        "generated_at_utc": generated_at_utc,
        "authoritative_as_of_commit": repo_anchor(root),
        "generator_surface": GENERATOR_SURFACE_ID,
        "sources": {"repo_root": str(root), "runtime_root": str(state)},
        "entry_chain": ["agents_md", "north_star_md", "spine_md", "session_protocol_md", "session_v3_attach"],
        "workflow_families": build_workflow_families(root, state, runtime, evidence),
        "surfaces": build_surfaces(root, state, runtime, evidence),
        "verify_sets": build_verify_sets(root),
        "relations": build_relations(),
        "parity_surfaces": build_parity_surfaces(),
        "verify_target_manifest": {
            "yaml": str(domain_state / "SPINE_VERIFY_TARGET_MANIFEST.yaml"),
            "markdown": str(domain_state / "SPINE_VERIFY_TARGET_MANIFEST.md"),
            "generator_relationship": "emitted by spine.surface.manifest.generate",
            "status": "authoritative_generated",
        },
        "validation": {},
    }
    manifest["validation"] = validate_manifest(manifest)
    return manifest


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Fail if generated output differs from disk.")
    args = parser.parse_args()

    root = resolve_root()
    state = state_root(root)
    domain_state = state / "domain-state"
    manifest_path = domain_state / "SPINE_SURFACE_MANIFEST.yaml"
    projection_path = domain_state / "SPINE_SURFACE_MANIFEST.md"
    vtm_yaml_path = domain_state / "SPINE_VERIFY_TARGET_MANIFEST.yaml"
    vtm_md_path = domain_state / "SPINE_VERIFY_TARGET_MANIFEST.md"

    generated_at = existing_generated_at(manifest_path) or utc_now() if args.check else utc_now()
    manifest = build_manifest(root, generated_at_utc=generated_at)
    yaml_out = yaml_text(manifest)
    md_out = build_markdown(manifest)

    # Build verify target manifest (graceful skip if helper unavailable)
    vtm_data = build_verify_target_data(root)
    vtm_yaml_out: str | None = None
    vtm_md_out: str | None = None
    if vtm_data is not None:
        vtm_data.pop("_hard_fail", None)
        vtm_manifest: dict[str, Any] = {
            "manifest_id": VTM_MANIFEST_ID,
            "scope": "spine_only",
            "status": "authoritative_generated",
            "generated_at_utc": generated_at,
            "authoritative_as_of_commit": repo_anchor(root),
            "generator_surface": GENERATOR_SURFACE_ID,
            **vtm_data,
        }
        vtm_yaml_out = yaml_text(vtm_manifest)
        vtm_md_out = build_verify_target_markdown(vtm_manifest)

    if args.check:
        fail = False
        if read_text(manifest_path) != yaml_out or read_text(projection_path) != md_out:
            print("spine.surface.manifest.generate FAIL: manifest drift", file=sys.stderr)
            fail = True
        if vtm_yaml_out is not None and vtm_md_out is not None:
            if read_text(vtm_yaml_path) != vtm_yaml_out or read_text(vtm_md_path) != vtm_md_out:
                print("spine.surface.manifest.generate FAIL: verify target manifest drift", file=sys.stderr)
                fail = True
        if fail:
            return 1
        print(f"spine.surface.manifest.generate PASS: {manifest_path}")
        if vtm_yaml_out is not None:
            print(f"spine.surface.manifest.generate PASS: {vtm_yaml_path}")
        return 0

    atomic_write(manifest_path, yaml_out)
    atomic_write(projection_path, md_out)
    print(f"spine.surface.manifest.generate PASS: {manifest_path}")
    print(f"spine.surface.manifest.generate PASS: {projection_path}")

    if vtm_yaml_out is not None and vtm_md_out is not None:
        atomic_write(vtm_yaml_path, vtm_yaml_out)
        atomic_write(vtm_md_path, vtm_md_out)
        print(f"spine.surface.manifest.generate PASS: {vtm_yaml_path}")
        print(f"spine.surface.manifest.generate PASS: {vtm_md_path}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
