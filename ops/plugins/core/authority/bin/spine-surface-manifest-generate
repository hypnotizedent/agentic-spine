    domain_state = state / "domain-state"
    verify_reports = evidence / "reports" / "verify"
    rows = [
        surface_row(surface_id="agents_md", path=root / "AGENTS.md", surface_kind="entry_surface", authority_class="authoritative", lifecycle_state="live", materialization_class="hand_authored", scope_class="spine_governance", entry_role="canonical_first_read", contract=root / "ops" / "bindings" / "root.authority.contract.yaml", verify_scope_refs=[VERIFY_SET_ID], notes="Canonical aperture and first-read entry surface."),
        surface_row(surface_id="north_star_md", path=root / "NORTH_STAR.md", surface_kind="entry_surface", authority_class="supporting", lifecycle_state="live", materialization_class="hand_authored", scope_class="spine_governance", entry_role="runtime_read", contract=root / "AGENTS.md", verify_scope_refs=[VERIFY_SET_ID], notes="Platform identity and invariant surface."),
        surface_row(surface_id="spine_md", path=root / "docs" / "governance" / "SPINE.md", surface_kind="entry_surface", authority_class="authoritative", lifecycle_state="live", materialization_class="hand_authored", scope_class="spine_governance", entry_role="runtime_read", contract=root / "AGENTS.md", verify_scope_refs=[VERIFY_SET_ID], notes="Minimal operating contract for the repo runtime."),
        surface_row(surface_id="session_protocol_md", path=root / "docs" / "governance" / "SESSION_PROTOCOL.md", surface_kind="entry_surface", authority_class="authoritative", lifecycle_state="live", materialization_class="hand_authored", scope_class="spine_governance", entry_role="runtime_read", contract=root / "AGENTS.md", verify_scope_refs=[VERIFY_SET_ID], notes="Session attach and runtime behavior protocol."),
