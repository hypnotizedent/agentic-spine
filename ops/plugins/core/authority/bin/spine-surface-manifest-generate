        surface_row(surface_id="root_authority_contract", path=root / "ops" / "bindings" / "root.authority.contract.yaml", surface_kind="binding_contract", authority_class="authoritative", lifecycle_state="live", materialization_class="hand_authored", scope_class="spine_governance", entry_role="runtime_read", verify_scope_refs=[VERIFY_SET_ID], notes="Canonical root taxonomy for platform, runtime, and residue paths."),
