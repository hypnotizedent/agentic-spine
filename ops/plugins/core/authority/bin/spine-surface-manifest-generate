#!/usr/bin/env python3
"""Generate the canonical spine-only surface manifest in runtime state."""

from __future__ import annotations

import argparse
import datetime as dt
import importlib.util
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


MANIFEST_ID = "SPINE_SURFACE_MANIFEST"
VTM_MANIFEST_ID = "SPINE_VERIFY_TARGET_MANIFEST"
GENERATOR_SURFACE_ID = "spine_surface_manifest_generate"
