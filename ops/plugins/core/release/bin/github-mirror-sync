#!/usr/bin/env bash
set -euo pipefail

# github-mirror-sync — Transform and push canonical Gitea repo to public GitHub mirror
#
# Usage: github-mirror-sync [--dry-run] [--execute] [--json] [--keep-workdir]
#
# Creates a temporary working copy, applies content transformations and file
# exclusions from the mirror governance contracts, validates the output is
# clean, and pushes to the GitHub remote.
#
# DEFAULT IS DRY-RUN. Use --execute to actually push.
#
# Created: 2026-03-24
# Loop: LOOP-SPINE-PRODUCTIZATION-20260324
# Contract: ops/bindings/github.mirror.contract.yaml

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init

RULES_FILE="$ROOT/ops/bindings/github.mirror.sanitization.rules.yaml"
EXCLUSIONS_FILE="$ROOT/ops/bindings/github.mirror.file.exclusions.yaml"
SANITIZATION_AUDIT="$ROOT/ops/plugins/core/release/bin/sanitization-audit"

DRY_RUN=1
JSON_OUTPUT=0
KEEP_WORKDIR=0
GITHUB_REMOTE="github"
TARGET_BRANCH="main"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --dry-run)       DRY_RUN=1; shift ;;
    --execute)       DRY_RUN=0; shift ;;
    --json)          JSON_OUTPUT=1; shift ;;
    --keep-workdir)  KEEP_WORKDIR=1; shift ;;
    --remote)        GITHUB_REMOTE="${2:?--remote requires a value}"; shift 2 ;;
    -h|--help)
      echo "Usage: github-mirror-sync [--dry-run] [--execute] [--json] [--keep-workdir]"
      echo ""
      echo "Transform and push canonical Gitea repo to public GitHub mirror."
      echo "Default is --dry-run. Use --execute to push."
      echo ""
      echo "Options:"
      echo "  --dry-run       Transform and validate, but do not push (default)"
      echo "  --execute       Actually push to GitHub remote"
      echo "  --json          Machine-consumable output"
      echo "  --keep-workdir  Do not clean up temp directory after sync"
      echo "  --remote NAME   GitHub remote name (default: github)"
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

# ── Preflight checks ───────────────────────────────────────────────
log() { [[ "$JSON_OUTPUT" -eq 1 ]] || echo "$@" >&2; }

log "═══════════════════════════════════════════════════════════"
log "  GITHUB MIRROR SYNC — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
log "  Mode: $([ "$DRY_RUN" -eq 1 ] && echo 'DRY-RUN' || echo 'EXECUTE')"
log "═══════════════════════════════════════════════════════════"
log ""

# Check contracts exist
for f in "$RULES_FILE" "$EXCLUSIONS_FILE"; do
  [[ -f "$f" ]] || { log "FAIL: missing contract: $f"; exit 1; }
done

# Check working tree is clean
if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]]; then
  log "FAIL: working tree is dirty. Commit or stash changes before mirror sync."
  exit 1
fi

# Check GitHub remote exists (only if executing)
if [[ "$DRY_RUN" -eq 0 ]]; then
  if ! git -C "$ROOT" remote get-url "$GITHUB_REMOTE" &>/dev/null; then
    log "FAIL: remote '$GITHUB_REMOTE' not configured."
    log "  Add it: git remote add $GITHUB_REMOTE https://github.com/<org>/agentic-spine.git"
    exit 1
  fi
fi

SOURCE_SHA="$(git -C "$ROOT" rev-parse HEAD)"
log "Source: origin/main @ $SOURCE_SHA"

# ── Create temporary working directory ──────────────────────────────
WORKDIR="$(mktemp -d)"
trap '[[ "$KEEP_WORKDIR" -eq 1 ]] || rm -rf "$WORKDIR"' EXIT
log "Workdir: $WORKDIR"

# Export repo content via git archive (only tracked files, deterministic)
log ""
log "── Phase 1: Export tracked files ─────────────────────────"
git -C "$ROOT" archive HEAD | tar -x -C "$WORKDIR"
FILE_COUNT_BEFORE="$(find "$WORKDIR" -type f | wc -l | tr -d ' ')"
log "  Exported: $FILE_COUNT_BEFORE files"

# ── Phase 2: File exclusions ───────────────────────────────────────
log ""
log "── Phase 2: Apply file exclusions ────────────────────────"
EXCLUDED_COUNT=0

# Directory exclusions (Go-yq v4 compatible)
while IFS= read -r dir; do
  [[ -n "$dir" && "$dir" != "null" ]] || continue
  if [[ -d "$WORKDIR/$dir" ]]; then
    rm -rf "${WORKDIR:?}/$dir"
    (( EXCLUDED_COUNT++ )) || true
    log "  excluded dir: $dir"
  fi
done < <(yq eval '.excluded_directories[].path | select(. != null)' "$EXCLUSIONS_FILE" 2>/dev/null)

# File exclusions
while IFS= read -r file; do
  [[ -n "$file" && "$file" != "null" ]] || continue
  if [[ -f "$WORKDIR/$file" ]]; then
    rm -f "$WORKDIR/$file"
    (( EXCLUDED_COUNT++ )) || true
    log "  excluded file: $file"
  fi
done < <(yq eval '.excluded_files[].path | select(. != null)' "$EXCLUSIONS_FILE" 2>/dev/null)

# Pattern exclusions
while IFS= read -r pattern; do
  [[ -n "$pattern" && "$pattern" != "null" ]] || continue
  while IFS= read -r match; do
    [[ -n "$match" ]] || continue
    rm -f "$match"
    (( EXCLUDED_COUNT++ )) || true
    log "  excluded pattern match: ${match#$WORKDIR/}"
  done < <(find "$WORKDIR" -name "$pattern" -type f 2>/dev/null)
done < <(yq eval '.excluded_patterns[].pattern | select(. != null)' "$EXCLUSIONS_FILE" 2>/dev/null)

log "  Total exclusions: $EXCLUDED_COUNT"

# ── Phase 2b: Inject template replacements ────────────────────────
TEMPLATE_DIR="$ROOT/ops/plugins/core/release/templates"
TEMPLATES_INJECTED=0
if [[ -d "$TEMPLATE_DIR" ]]; then
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "null" ]] || continue
    original="$(echo "$line" | yq eval '.original' -)"
    template="$(echo "$line" | yq eval '.template' -)"
    [[ -n "$original" && -n "$template" ]] || continue
    # Source: flat lookup in templates dir (basename only)
    src="$TEMPLATE_DIR/$(basename "$template")"
    if [[ -f "$src" ]]; then
      dest_dir="$(dirname "$WORKDIR/$template")"
      mkdir -p "$dest_dir"
      cp "$src" "$WORKDIR/$template"
      (( TEMPLATES_INJECTED++ )) || true
      log "  injected template: $template (replaces $original)"
    fi
  done < <(yq eval '.replaced_with_template[] | @json' "$EXCLUSIONS_FILE" 2>/dev/null)
fi
if [[ "$TEMPLATES_INJECTED" -gt 0 ]]; then
  log "  Templates injected: $TEMPLATES_INJECTED"
fi

# ── Phase 3: Content transformations ───────────────────────────────
log ""
log "── Phase 3: Apply content transformations ────────────────"

# Use Python for content transformation — handles complex regex patterns
# (alternation groups, word boundaries) that break sed delimiter escaping.
TRANSFORM_COUNT="$(python3 - "$RULES_FILE" "$WORKDIR" <<'PYEOF'
import os, re, sys, yaml

rules_file = sys.argv[1]
workdir = sys.argv[2]

with open(rules_file) as f:
    data = yaml.safe_load(f)

# Build compiled regex rules in order
compiled_rules = []
for rule in data.get('rules', []):
    if rule.get('scope') != 'content':
        continue
    try:
        compiled_rules.append((re.compile(rule['pattern']), rule['replacement']))
    except re.error:
        pass

transform_count = 0

for dirpath, dirnames, filenames in os.walk(workdir):
    # Skip .git directory
    dirnames[:] = [d for d in dirnames if d != '.git']
    for fname in filenames:
        fpath = os.path.join(dirpath, fname)
        try:
            with open(fpath, 'r', encoding='utf-8', errors='ignore') as f:
                content = f.read()
        except (OSError, UnicodeDecodeError):
            continue

        # Skip likely binary files
        if '\0' in content[:8192]:
            continue

        new_content = content
        for pattern, replacement in compiled_rules:
            new_content = pattern.sub(replacement, new_content)

        if new_content != content:
            with open(fpath, 'w', encoding='utf-8') as f:
                f.write(new_content)
            transform_count += 1

print(transform_count)
PYEOF
)"

log "  Files transformed: $TRANSFORM_COUNT"

FILE_COUNT_AFTER="$(find "$WORKDIR" -type f ! -path '*/.git/*' | wc -l | tr -d ' ')"
log "  Files in output: $FILE_COUNT_AFTER"

# ── Phase 4: Validation ────────────────────────────────────────────
log ""
log "── Phase 4: Validate output ──────────────────────────────"

# Run a lightweight check for remaining sensitive patterns
VALIDATION_FAILURES=0

# Helper: count grep matches safely (pipefail-safe — subshell absorbs grep exit 1)
count_matches() { (grep "$@" 2>/dev/null || true) | wc -l | tr -d ' '; }

check_residual() {
  local label="$1"; shift
  local count
  count="$(count_matches "$@")"
  if [[ "$count" -gt 0 ]]; then
    log "  WARN: $count lines still contain $label"
    (( VALIDATION_FAILURES += count )) || true
  fi
}

check_residual "hardcoded paths"          -r  --exclude-dir=.git '/Users/ronnyworks' "$WORKDIR"
check_residual "internal domains"         -rE --exclude-dir=.git '\bronny\.works\b|\bmintprints\.(com|co)\b' "$WORKDIR"
check_residual "Tailscale IPs"            -rE --exclude-dir=.git '100\.(6[4-9]|[7-9][0-9]|1[0-2][0-9])\.[0-9]+\.[0-9]+' "$WORKDIR"
check_residual "private LAN IPs"          -rE --exclude-dir=.git '192\.168\.[0-9]+\.[0-9]+|10\.(0|10)\.[0-9]+\.[0-9]+' "$WORKDIR"
check_residual "personal emails"          -rE --exclude-dir=.git 'hypnotizedent@gmail\.com|ronny@[a-z.]+\.(com|works|co)' "$WORKDIR"
check_residual "container registry refs"  -r  --exclude-dir=.git 'ghcr.io/hypnotizedent/' "$WORKDIR"
check_residual "infrastructure hostnames" -rE --exclude-dir=.git '\b(md1400|r730xd|PM8072|UDR[67])\b' "$WORKDIR"
check_residual "secret manager URIs"      -r  --exclude-dir=.git 'infisical://' "$WORKDIR"
check_residual "github identity"          -rw --exclude-dir=.git 'hypnotizedent' "$WORKDIR"

if [[ "$VALIDATION_FAILURES" -gt 0 ]]; then
  log ""
  log "  VALIDATION: $VALIDATION_FAILURES residual sensitive patterns detected."
  log "  Review and update github.mirror.sanitization.rules.yaml."
  if [[ "$DRY_RUN" -eq 0 ]]; then
    log "  ABORT: will not push with residual findings. Fix rules first."
    exit 1
  fi
else
  log "  VALIDATION: PASS — 0 residual sensitive patterns"
fi

# ── Phase 5: Commit and push ───────────────────────────────────────
log ""
log "── Phase 5: Commit mirror state ──────────────────────────"

cd "$WORKDIR"
git init -q
git checkout -q -b "$TARGET_BRANCH"
git add -A
MIRROR_COMMIT="$(git commit -q -m "mirror: sync from gitea @ $SOURCE_SHA ($(date -u +%Y-%m-%d))" 2>&1 && git rev-parse HEAD)"
MIRROR_SHA="$(git rev-parse HEAD 2>/dev/null || echo 'none')"
log "  Mirror commit: $MIRROR_SHA"

if [[ "$DRY_RUN" -eq 1 ]]; then
  log ""
  log "═══════════════════════════════════════════════════════════"
  log "  DRY-RUN COMPLETE"
  log "  Source SHA:         $SOURCE_SHA"
  log "  Files before:       $FILE_COUNT_BEFORE"
  log "  Files excluded:     $EXCLUDED_COUNT"
  log "  Files transformed:  $TRANSFORM_COUNT"
  log "  Files in output:    $FILE_COUNT_AFTER"
  log "  Validation:         $VALIDATION_FAILURES residual findings"
  log "  Mirror SHA:         $MIRROR_SHA"
  if [[ "$KEEP_WORKDIR" -eq 1 ]]; then
    log "  Workdir preserved:  $WORKDIR"
  fi
  log ""
  log "  To push: re-run with --execute"
  log "═══════════════════════════════════════════════════════════"
else
  # Add GitHub remote and push
  GITHUB_URL="$(git -C "$ROOT" remote get-url "$GITHUB_REMOTE")"
  git remote add target "$GITHUB_URL"
  git push --force target "$TARGET_BRANCH" 2>&1
  log ""
  log "═══════════════════════════════════════════════════════════"
  log "  PUSH COMPLETE"
  log "  Source SHA:         $SOURCE_SHA"
  log "  Mirror SHA:         $MIRROR_SHA"
  log "  Target:             $GITHUB_URL ($TARGET_BRANCH)"
  log "  Files:              $FILE_COUNT_AFTER"
  log "═══════════════════════════════════════════════════════════"
fi

if [[ "$JSON_OUTPUT" -eq 1 ]]; then
  printf '{"source_sha":"%s","mirror_sha":"%s","files_before":%d,"files_excluded":%d,"files_transformed":%d,"files_after":%d,"validation_failures":%d,"dry_run":%s}\n' \
    "$SOURCE_SHA" "$MIRROR_SHA" "$FILE_COUNT_BEFORE" "$EXCLUDED_COUNT" "$TRANSFORM_COUNT" "$FILE_COUNT_AFTER" "$VALIDATION_FAILURES" \
    "$([ "$DRY_RUN" -eq 1 ] && echo 'true' || echo 'false')"
fi
