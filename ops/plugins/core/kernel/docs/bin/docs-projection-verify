#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DEFAULT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd "$SCRIPT_DIR/../../../../.." && pwd))"
ROOT="${SPINE_CODE:-${SPINE_ROOT:-$ROOT_DEFAULT}}"

"$ROOT/ops/plugins/core/authority/bin/gen-entry-surface-gate-metadata.sh" --check
"$ROOT/ops/plugins/core/authority/bin/gen-boot-entry-surface.sh" --check
bash "$ROOT/ops/plugins/core/authority/bin/authority-concerns-projection-build" --check
python3 "$ROOT/ops/plugins/core/authority/bin/service-registry-projection-build" --check --verify
bash "$ROOT/surfaces/verify/d-intake-master-projection-lineage-lock.sh"
bash "$ROOT/surfaces/verify/d-projection-generated-only-discipline-lock.sh"
bash "$ROOT/surfaces/verify/d406-concern-projection-registration-completeness-lock.sh"

echo "docs.projection.verify"
echo "status: OK"
