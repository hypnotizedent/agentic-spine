#!/usr/bin/env python3
"""operator-surface-watchdog — bounded surface repair plus exception-birth poll.

Runs the bounded V1 standing-program exception birth check, triggers a surface
regenerate pass so the payload stays current, then checks the local operator
surface leaf endpoints on :8900. If any fail, restart the server service,
trigger another regenerate pass, and poll for recovery.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path
from urllib import error, request


SERVER_SERVICE = "com.ronny.operator-surface-server.service"
REGENERATE_SERVICE = "com.ronny.operator-surface-regenerate.service"
DEFAULT_ENDPOINTS = ("/", "/mobile.json", "/payload.json")
ROOT = Path(__file__).resolve().parents[5]
STANDING_PROGRAM_BIRTH_BIN = (
    ROOT / "ops" / "plugins" / "core" / "lifecycle" / "bin" / "standing-program-intervention-birth"
)


def fail(message: str) -> "NoReturn":
    print(f"operator-surface-watchdog FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def run_systemctl(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["systemctl", "--user", *args],
        capture_output=True,
        text=True,
        check=False,
    )


def probe(host: str, port: int, endpoints: tuple[str, ...], timeout: float) -> tuple[bool, list[str]]:
    lines: list[str] = []
    for endpoint in endpoints:
        url = f"http://{host}:{port}{endpoint}"
        try:
            with request.urlopen(url, timeout=timeout) as response:
                status = int(response.status)
                content_type = str(response.headers.get("Content-Type", ""))
        except error.HTTPError as exc:
            lines.append(f"{endpoint} -> HTTP {exc.code}")
            return False, lines
        except Exception as exc:
            lines.append(f"{endpoint} -> ERROR {exc}")
            return False, lines

        lines.append(f"{endpoint} -> {status} {content_type}".strip())
        if status != 200:
            return False, lines
    return True, lines


def service_state(name: str) -> str:
    proc = run_systemctl("is-active", name)
    return (proc.stdout or proc.stderr or "unknown").strip()


def restart_services() -> None:
    restart = run_systemctl("restart", SERVER_SERVICE)
    if restart.returncode != 0:
        detail = (restart.stderr or restart.stdout or "unknown error").strip()
        fail(f"failed to restart {SERVER_SERVICE}: {detail}")

    regenerate = run_systemctl("start", REGENERATE_SERVICE)
    if regenerate.returncode != 0:
        detail = (regenerate.stderr or regenerate.stdout or "unknown error").strip()
        fail(f"failed to start {REGENERATE_SERVICE}: {detail}")


def run_birth_check() -> tuple[bool, dict[str, object]]:
    proc = subprocess.run(
        ["python3", str(STANDING_PROGRAM_BIRTH_BIN), "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    stdout = (proc.stdout or "").strip()
    if stdout:
        try:
            data = json.loads(stdout)
            ok = proc.returncode == 0 and str(data.get("status") or "ok") != "error"
            return ok, data if isinstance(data, dict) else {"status": "error", "stdout": stdout}
        except Exception:
            pass
    return False, {
        "status": "error",
        "stdout": stdout,
        "stderr": (proc.stderr or "").strip(),
        "returncode": proc.returncode,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Repair operator surface if the public leaf stops serving")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8900)
    parser.add_argument("--probe-timeout", type=float, default=5.0)
    parser.add_argument("--repair-wait-seconds", type=float, default=30.0)
    parser.add_argument("--poll-interval-seconds", type=float, default=2.0)
    parser.add_argument(
        "--paths",
        nargs="*",
        default=list(DEFAULT_ENDPOINTS),
        help="endpoints to probe in order",
    )
    args = parser.parse_args()

    birth_ok, birth_data = run_birth_check()
    birth_error = ""
    print("operator-surface-watchdog")
    if birth_ok:
        print(
            "exception_birth: "
            f"evaluated={birth_data.get('evaluated', 0)} "
            f"birthed={birth_data.get('birthed', 0)} "
            f"locked={birth_data.get('locked', 0)}"
        )
        regenerate = run_systemctl("start", REGENERATE_SERVICE)
        if regenerate.returncode != 0:
            birth_ok = False
            birth_error = (regenerate.stderr or regenerate.stdout or "unknown error").strip()
            print(f"exception_birth: regenerate start failed: {birth_error}")
    else:
        birth_error = str(
            birth_data.get("error")
            or birth_data.get("stderr")
            or birth_data.get("stdout")
            or "birth check failed"
        )
        print(f"exception_birth: FAIL {birth_error}")

    endpoints = tuple(str(path) for path in args.paths)
    ok, lines = probe(args.host, args.port, endpoints, args.probe_timeout)
    print(f"server_service: {SERVER_SERVICE} ({service_state(SERVER_SERVICE)})")
    print(f"regenerate_service: {REGENERATE_SERVICE} ({service_state(REGENERATE_SERVICE)})")
    for line in lines:
        print(f"probe: {line}")

    if ok:
        if not birth_ok:
            fail(f"surface healthy but autonomous exception birth degraded: {birth_error}")
        print("status: PASS")
        return 0

    print("repair: restarting server + triggering regenerate")
    restart_services()

    deadline = time.time() + args.repair_wait_seconds
    while time.time() < deadline:
        time.sleep(args.poll_interval_seconds)
        ok, lines = probe(args.host, args.port, endpoints, args.probe_timeout)
        for line in lines:
            print(f"reprobe: {line}")
        if ok:
            print(f"server_service: {SERVER_SERVICE} ({service_state(SERVER_SERVICE)})")
            print(f"regenerate_service: {REGENERATE_SERVICE} ({service_state(REGENERATE_SERVICE)})")
            if not birth_ok:
                fail(f"surface repaired but autonomous exception birth degraded: {birth_error}")
            print("status: REPAIRED")
            return 0

    fail(
        "surface still unhealthy after repair attempt; "
        f"{SERVER_SERVICE}={service_state(SERVER_SERVICE)} "
        f"{REGENERATE_SERVICE}={service_state(REGENERATE_SERVICE)}"
    )


if __name__ == "__main__":
    raise SystemExit(main())
