#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path

import yaml


def main() -> int:
    root = Path(__file__).resolve().parents[5]
    contract = yaml.safe_load((root / "ops/bindings/surface.readonly.contract.yaml").read_text()) or {}
    caps = yaml.safe_load((root / "ops/capabilities.yaml").read_text()) or {}
    registry = (caps.get("capabilities") or {})
    missing = []
    for key, surface in ((contract.get("surfaces") or {}).items()):
        capability = (surface or {}).get("capability")
        if capability and capability not in registry:
            missing.append({"surface": key, "capability": capability})
    payload = {"capability": "surface.readonly.audit", "status": "ok" if not missing else "fail", "missing_capabilities": missing}
    print(json.dumps(payload, indent=2))
    return 0 if not missing else 1


if __name__ == "__main__":
    raise SystemExit(main())
