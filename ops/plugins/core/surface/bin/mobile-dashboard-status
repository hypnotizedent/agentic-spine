#!/usr/bin/env python3
"""T3 Mobile Read Surface — phone-facing operator supervision dashboard.

Answers 5 questions in under 30 seconds:
  1. Is the spine alive?
  2. Is the state projection fresh enough to trust?
  3. What currently needs operator attention?
  4. What loop or handoff should be opened next?
  5. Is this read-only, or am I being tempted into laptop work?

Payload is ordered for phone readability:
  spine_now → projection_freshness → attention_now → active_loops →
  active_handoffs → read_only_posture → _secondary
"""
from __future__ import annotations

import json
import os
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path


def run_json(cmd: list[str]) -> dict:
    proc = subprocess.run(cmd, text=True, capture_output=True, check=False)
    try:
        return json.loads(proc.stdout) if proc.stdout.strip() else {"status": "fail", "error": proc.stderr.strip()}
    except Exception:
        return {"status": "fail", "stdout": proc.stdout.strip(), "stderr": proc.stderr.strip()}


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def classify_freshness(age_seconds: float) -> str:
    if age_seconds < 0:
        return "unknown"
    if age_seconds < 300:
        return "current"
    if age_seconds < 1800:
        return "aging"
    return "stale"


def collect_spine_now(spine_json: dict) -> dict:
    counts = spine_json.get("counts", {})
    return {
        "verify_status": counts.get("verify_status", "unknown"),
        "anomaly_count": counts.get("anomalies", 0),
        "open_loop_count": counts.get("open_loops", 0),
        "open_gap_count": counts.get("open_gaps", 0),
        "active_wave_count": counts.get("active_waves", 0),
        "coherence_ok": not counts.get("coherence_attention", False),
    }


def collect_projection_freshness(state_root: Path) -> dict:
    now = time.time()
    db_path = state_root / "shared_authority.db"
    sync_marker = state_root / ".last_sync_utc"

    result: dict = {
        "source": "unknown",
        "age_seconds": -1,
        "freshness": "unknown",
        "sync_marker_utc": None,
        "state_db_mtime_utc": None,
    }

    if sync_marker.is_file():
        try:
            marker_text = sync_marker.read_text().strip()
            result["sync_marker_utc"] = marker_text
            marker_dt = datetime.fromisoformat(marker_text.replace("Z", "+00:00"))
            age = now - marker_dt.timestamp()
            result["age_seconds"] = int(age)
            result["freshness"] = classify_freshness(age)
            result["source"] = "sync_marker"
        except Exception:
            pass

    if db_path.is_file():
        try:
            mtime = db_path.stat().st_mtime
            mtime_utc = datetime.fromtimestamp(mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            result["state_db_mtime_utc"] = mtime_utc
            if result["source"] == "unknown":
                age = now - mtime
                result["age_seconds"] = int(age)
                result["freshness"] = classify_freshness(age)
                result["source"] = "db_mtime"
        except Exception:
            pass

    return result


def collect_attention_now(spine_json: dict) -> list[dict]:
    items: list[dict] = []

    for anomaly in spine_json.get("anomalies", []):
        items.append({
            "type": "anomaly",
            "summary": str(anomaly) if isinstance(anomaly, str) else anomaly.get("message", str(anomaly)),
            "priority": "high",
        })

    for gap in spine_json.get("open_gaps", []):
        items.append({
            "type": "gap",
            "id": gap.get("gap_id", ""),
            "summary": gap.get("description", ""),
            "priority": gap.get("severity", "medium"),
        })

    for loop in spine_json.get("open_loops", []):
        if loop.get("blocked_by"):
            items.append({
                "type": "blocked_loop",
                "id": loop.get("loop_id", ""),
                "summary": f"Blocked: {loop.get('blocked_by', '')}",
                "priority": "high",
            })

    counts = spine_json.get("counts", {})
    if counts.get("orphaned_waves", 0) > 0:
        items.append({
            "type": "orphaned_waves",
            "summary": f"{counts['orphaned_waves']} orphaned wave(s)",
            "priority": "medium",
        })

    return items[:5]


def collect_active_loops(spine_json: dict) -> dict:
    open_loops = spine_json.get("open_loops", [])
    return {
        "count": len(open_loops),
        "items": [
            {
                "id": loop.get("loop_id", ""),
                "title": loop.get("title", "")[:120],
                "status": loop.get("status", ""),
                "horizon": loop.get("horizon", ""),
                "readiness": loop.get("execution_readiness", ""),
            }
            for loop in open_loops[:5]
        ],
    }


def collect_active_handoffs(root: Path) -> dict:
    handoff_script = root / "ops" / "plugins" / "core" / "session" / "bin" / "session-handoff"
    if not handoff_script.is_file():
        return {"count": 0, "items": []}

    proc = subprocess.run(
        ["python3", str(handoff_script), "list", "--state", "active"],
        text=True, capture_output=True, check=False,
    )
    try:
        data = json.loads(proc.stdout)
    except Exception:
        return {"count": 0, "items": [], "error": "handoff list failed"}

    items = data.get("items", [])
    return {
        "count": data.get("count", len(items)),
        "items": [
            {
                "id": h.get("id", ""),
                "summary": h.get("summary", "")[:120],
                "loops": h.get("loops", []),
            }
            for h in items[-3:]
        ],
    }


def collect_secondary(root: Path, spine_json: dict) -> dict:
    proposals = run_json([f"{root}/bin/ops", "cap", "run", "proposals.status", "--", "--json"])
    counts = spine_json.get("counts", {})
    completion = counts.get("completion_state", {})
    return {
        "proposals": {
            "pending": proposals.get("pending", 0),
            "total": proposals.get("total", 0),
        },
        "completion_state": {
            "total_specimens": completion.get("total_specimens", 0),
            "delivered": completion.get("delivered", 0),
            "open": completion.get("open", 0),
            "parked": completion.get("parked", 0),
        },
        "inbox_active": spine_json.get("inbox_active", 0),
        "comms_queue_pending": spine_json.get("comms_queue", {}).get("pending", 0),
    }


def main() -> int:
    root = Path(__file__).resolve().parents[5]
    state_root = Path(
        os.environ.get(
            "SPINE_STATE",
            str(Path.home() / "code" / ".runtime" / "spine" / "state"),
        )
    )

    spine_json = run_json([f"{root}/bin/ops", "status", "--json"])

    payload = {
        "capability": "surface.mobile.dashboard.status",
        "version": 2,
        "generated_utc": utcnow(),
        "spine_now": collect_spine_now(spine_json),
        "projection_freshness": collect_projection_freshness(state_root),
        "attention_now": collect_attention_now(spine_json),
        "active_loops": collect_active_loops(spine_json),
        "active_handoffs": collect_active_handoffs(root),
        "read_only_posture": {
            "surface_type": "supervision",
            "mutation_allowed": False,
            "guidance": "Read-only phone surface. Use MBP or SSH terminal for mutations.",
        },
        "_secondary": collect_secondary(root, spine_json),
    }
    print(json.dumps(payload, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
