#!/usr/bin/env python3
"""T3 Mobile Read Surface — phone-facing compact leaf of the operator overview.

This is a LEAF, not a root. It consumes the shared operator-overview-payload
and renders a phone-priority compact view. Same truth, same timestamps,
same attention ordering as the desktop cockpit — different density.

Three questions only:
  1. What needs me right now?  → attention_now + what_is_waiting_on_me + active_handoffs
  2. What did I just submit?   → recent_ingress (pending only)
  3. Is the spine alive?       → spine_now (one-line health)

Everything else is background — available in _secondary for drill-down,
not surfaced in the primary payload.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

# Import the shared payload generator (no .py extension)
_payload_path = Path(__file__).resolve().parent / "operator-overview-payload"
_loader = importlib.machinery.SourceFileLoader("operator_overview_payload", str(_payload_path))
_spec = importlib.util.spec_from_loader("operator_overview_payload", _loader)
_mod = importlib.util.module_from_spec(_spec)
_loader.exec_module(_mod)
build_payload = _mod.build_payload


def main() -> int:
    root = build_payload(compact=True)

    # --- Primary: what needs the operator RIGHT NOW --------------------------
    ov = root.get("operator_vision", {})
    waiting = ov.get("what_is_waiting_on_me", {})
    recent_ingress = ov.get("recent_ingress", [])
    mhw = ov.get("my_human_work_now", {})

    # Only show ingress items that actually need operator action
    pending_ingress = [
        {
            "ingress_id": i.get("ingress_id", ""),
            "operator_hint": i.get("operator_hint", ""),
            "lifecycle_state": i.get("lifecycle_state", "submitted"),
        }
        for i in recent_ingress
        if i.get("disposition") == "awaiting_classification"
           or i.get("lifecycle_state") in ("submitted", "preserved")
    ]

    # One-line spine health
    spine = root["spine_now"]
    if spine["verify_status"] != "pass":
        health = "degraded"
    elif spine["anomaly_count"] > 0:
        health = "mixed"
    else:
        health = "healthy"

    payload = {
        "capability": "surface.mobile.dashboard.status",
        "version": root["version"],
        "generated_utc": root["generated_utc"],
        "health": health,
        "attention_now": root["attention"][:5],
        "what_is_waiting_on_me": {
            "parked_without_lifecycle": waiting.get("parked_without_lifecycle", 0),
            "floating_items": waiting.get("floating_items", 0),
            "pending_ingress": waiting.get("pending_ingress", 0),
        },
        "active_handoffs": {
            "count": root["active_handoffs"]["count"],
            "items": [
                {"id": h.get("id", ""), "summary": h.get("summary", "")}
                for h in root["active_handoffs"]["items"][:3]
            ],
        },
        "pending_ingress": pending_ingress[:5],
        "read_only_posture": {
            "surface_type": "supervision",
            "mutation_allowed": False,
            "guidance": "Read-only phone surface. Use MBP or SSH terminal for mutations.",
        },
        "_secondary": {
            "open_loops": root["active_loops"]["count"],
            "open_gaps": spine["open_gap_count"],
            "active_waves": spine["active_wave_count"],
            "verify_status": spine["verify_status"],
            "anomaly_count": spine["anomaly_count"],
            "projection_freshness": root["projection_freshness"]["freshness"],
            "proposals_pending": root["proposals"]["pending"],
            "completion_state": root["work_state"]["completion_state"],
            "inbox_active": root["work_state"]["inbox_active"],
            "comms_queue_pending": root["work_state"]["comms_queue"]["pending"],
            "total_raw_inputs": mhw.get("total_raw_inputs", 0),
            "delivered_packets": mhw.get("delivered_packets", 0),
        },
    }
    print(json.dumps(payload, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
