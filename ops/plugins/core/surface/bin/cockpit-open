#!/usr/bin/env bash
# cockpit.open — regenerate and open the operator cockpit.
#
# Usage: ./bin/ops cap run cockpit.open
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
OUTPUT="${SPINE_STATE:-$HOME/code/.runtime/spine/state}/domain-state/SPINE_COCKPIT.html"

# Regenerate
python3 "$REPO/ops/plugins/core/surface/bin/cockpit-generate"

# Open
open "$OUTPUT"
