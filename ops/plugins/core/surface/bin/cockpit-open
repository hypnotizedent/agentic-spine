#!/usr/bin/env bash
# cockpit.open — regenerate and open the server-backed operator cockpit.
#
# Usage: ./bin/ops cap run cockpit.open
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
OUTPUT="${SPINE_STATE:-$HOME/code/.runtime/spine/state}/domain-state/SPINE_COCKPIT.html"
STATE_ROOT="${SPINE_STATE:-$HOME/code/.runtime/spine/state}"
SURFACE_DIR="$STATE_ROOT/operator-surface"
URL="${OPERATOR_COCKPIT_URL:-http://100.71.17.29:8900/}"
PORT="${OPERATOR_COCKPIT_PORT:-8900}"
LOG="$SURFACE_DIR/server.log"
PIDFILE="$SURFACE_DIR/server.pid"
ALLOW_LOCAL_COMPAT="${OPERATOR_COCKPIT_ALLOW_LOCAL_COMPAT:-0}"

# Regenerate
python3 "$REPO/ops/plugins/core/surface/bin/operator-surface-regenerate"

# Prefer the durable operator-surface server. The MacBook/operator_console is a
# client; it must not silently become the unattended daemon host.
if ! curl -fsS "$URL" >/dev/null 2>&1 && [[ "$ALLOW_LOCAL_COMPAT" == "1" ]]; then
  mkdir -p "$SURFACE_DIR"
  nohup python3 -u "$REPO/ops/plugins/core/surface/bin/operator-surface-server" \
    --port "$PORT" \
    --dir "$SURFACE_DIR" \
    > "$LOG" 2>&1 < /dev/null &
  echo "$!" > "$PIDFILE"
  disown || true
  for _ in 1 2 3 4 5; do
    if curl -fsS "$URL" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
fi

# Open
if curl -fsS "$URL" >/dev/null 2>&1; then
  open "$URL"
else
  echo "cockpit.open: durable cockpit URL unavailable: $URL" >&2
  echo "cockpit.open: opening static compatibility snapshot; no local daemon started" >&2
  echo "cockpit.open: set OPERATOR_COCKPIT_ALLOW_LOCAL_COMPAT=1 for explicit temporary local server fallback" >&2
  open "$OUTPUT"
fi
