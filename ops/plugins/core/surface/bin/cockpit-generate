.foot{font-size:.5rem;color:var(--t);opacity:.25;text-align:center;margin-top:2rem;line-height:1.6}

@media (max-width:860px){
  .stats,.rel{grid-template-columns:repeat(2,1fr)}
  .front-door{grid-template-columns:repeat(2,1fr)}
  .nr{flex-direction:column}
  .today-line{grid-template-columns:72px 1fr}
  .today-line-sub{grid-column:2}
}

@media (max-width:560px){
  body{padding:1rem}
  .stats,.rel{grid-template-columns:1fr}
  .front-door{grid-template-columns:1fr}
  .top-bar{flex-direction:column;align-items:flex-start;gap:.35rem}
  .surface-nav{margin-top:.15rem}
  .top-bar .beacon{margin-left:0}
  .today-line{grid-template-columns:1fr}
  .today-line-sub{grid-column:auto}
}
"""

JS = """
(function() {
  var root = (location.protocol === 'file:') ? '""" + _FILE_FALLBACK_ROOT + """' : '';
  document.querySelectorAll('[data-surface-link]').forEach(function(el) {
    el.href = root + el.getAttribute('data-surface-link');
  });
})();
""" + r"""
function filterCaps(e, domain) {
  var rows = document.querySelectorAll('.cap[data-domain]');
  var btns = document.querySelectorAll('.cap-f');
  btns.forEach(function(b) { b.classList.remove('active'); });
  e.currentTarget.classList.add('active');
  rows.forEach(function(r) {
    r.style.display = (domain === 'all' || r.dataset.domain === domain) ? '' : 'none';
  });
}
"""


def operator_vision_section(ov: dict, directional_boundary: dict, temporal_standing: dict) -> str:
    """Build the operator-vision contribution surface — the lead story."""
    if not ov:
        return ""

    mhw = ov.get("my_human_work_now", {})
    chain = ov.get("chain_status", {})
    traces = ov.get("what_became_of_my_input", [])
    built = ov.get("what_my_ideas_built", {})
    waiting = ov.get("what_is_waiting_on_me", {})
    recent = ov.get("recent_ingress", [])
    op_to_agents = directional_boundary.get("operator_to_agents", {})
    agents_to_operator = directional_boundary.get("agents_to_operator", {})
    temporal_summary = temporal_standing.get("summary", {})
    temporal_projection = temporal_standing.get("projection", {})
    temporal_ingress = temporal_standing.get("operator_to_agents", {})
    temporal_handoffs = temporal_standing.get("agents_to_operator", {})
    temporal_parked = temporal_standing.get("parked_inventory", {})
    temporal_completion = temporal_standing.get("completion_snapshot", {})

    # Summary stats
    total = mhw.get("total_raw_inputs", 0)
    recent_count = mhw.get("recent_ingress", 0)
    pending_ingress = mhw.get("pending_ingress", 0)
    advanced = mhw.get("advanced_to_contract", 0)
    adj_ev = mhw.get("adjacent_evidence", 0)
    parked_p = mhw.get("parked_prep", 0)
    parked_nl = mhw.get("parked_no_lifecycle", 0)
    oos = mhw.get("out_of_spine", 0)
    floats = mhw.get("float_risk_count", 0)
    delivered = mhw.get("delivered_packets", 0)
    contracts = mhw.get("contracts", 0)
    derived = mhw.get("derived_conclusions", 0)

    # Primary: only actionable counts. Background counts available in detail sections below.
    stats = f"""
    <div class="stats" style="grid-template-columns:repeat(4,1fr)">
      <div class="stat"><div class="stat-v">{pending_ingress}</div><div class="stat-l">Pending</div><div class="stat-sub">awaiting membrane</div></div>
      <div class="stat{'  style=\"border-color:var(--ylw)\"' if floats > 0 else ''}"><div class="stat-v" style="{'color:var(--ylw)' if floats > 0 else ''}">{floats}</div><div class="stat-l">Float Risk</div><div class="stat-sub">needs lifecycle</div></div>
      <div class="stat"><div class="stat-v">{delivered}</div><div class="stat-l">Delivered</div><div class="stat-sub">packets</div></div>
      <div class="stat"><div class="stat-v">{total}</div><div class="stat-l">Total Inputs</div><div class="stat-sub">{advanced} advanced · {parked_p} parked</div></div>
    </div>"""

    split_html = f"""
    <details>
      <summary>Traffic Split <span class="det-count">two one-way lanes</span></summary>
      <div class="det-body">
        <div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(op_to_agents.get("label", "Ronny -> agents"))}</span>
            <span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;background:rgba(42,52,68,.75);color:var(--cyn)">{_h(op_to_agents.get("surface", "recent_ingress"))}</span>
          </div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{op_to_agents.get("count", 0)} visible submissions · {op_to_agents.get("pending_classification", 0)} pending classification</div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(op_to_agents.get("rule", ""))}</div>
        </div>
        <div style="padding:.35rem 0">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(agents_to_operator.get("label", "Agents -> Ronny"))}</span>
            <span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;background:rgba(42,52,68,.75);color:var(--ylw)">{_h(" + ".join(agents_to_operator.get("surfaces", [])) or "handoffs + attention")}</span>
          </div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{agents_to_operator.get("handoff_count", 0)} active handoff(s) · {agents_to_operator.get("attention_count", 0)} surfaced attention item(s)</div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(agents_to_operator.get("rule", ""))}</div>
        </div>
      </div>
    </details>"""

    parked_review = temporal_parked.get("review_summary", {})
    parked_items = temporal_parked.get("items", [])[:5]
    parked_rows = ""
    for item in parked_items:
        review_state = item.get("review_state", "unknown")
        due = item.get("next_review") or item.get("time_evidence_at") or "unscheduled"
        parked_rows += (
            f'<div style="padding:.3rem 0;border-bottom:1px solid rgba(26,35,50,.35)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.52rem;color:var(--tb);flex:1">{_h(item.get("name", ""))}</span>'
            f'{_temporal_badge(review_state)}'
            f'</div>'
            f'<div style="font-size:.48rem;color:var(--tm);margin-top:.1rem">{_h(due)}</div>'
            f'</div>'
        )
    if not parked_rows:
        parked_rows = '<div style="font-size:.55rem;color:var(--tm)">no parked runtime items found</div>'

    handoff_rows = ""
    for item in temporal_handoffs.get("items", [])[:3]:
        created_age = _age_label(item.get("time_age_seconds"))
        handoff_rows += (
            f'<div style="padding:.3rem 0;border-bottom:1px solid rgba(26,35,50,.35)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.52rem;color:var(--tb);flex:1">{_h(item.get("id", ""))}</span>'
            f'{_temporal_badge(item.get("temporal_state", "unknown"))}'
            f'</div>'
            f'<div style="font-size:.48rem;color:var(--tm);margin-top:.1rem">{_h(item.get("summary", ""))}</div>'
            f'<div style="font-size:.48rem;color:var(--tm);margin-top:.1rem">{_h(str(item.get("created_at_utc", "") or created_age))}</div>'
            f'</div>'
        )
    if not handoff_rows:
        handoff_rows = '<div style="font-size:.55rem;color:var(--tm)">no active handoffs</div>'

    temporal_html = f"""
    <details>
      <summary>Temporal Standing <span class="det-count">same root across cockpit + mobile</span></summary>
      <div class="det-body">
        <div class="stats" style="grid-template-columns:repeat(6,1fr);margin-bottom:.35rem">
          <div class="stat"><div class="stat-v">{temporal_summary.get("now", 0)}</div><div class="stat-l">Now</div></div>
          <div class="stat"><div class="stat-v">{temporal_summary.get("recent", 0)}</div><div class="stat-l">Recent</div></div>
          <div class="stat"><div class="stat-v">{temporal_summary.get("stale", 0)}</div><div class="stat-l">Stale</div></div>
          <div class="stat"><div class="stat-v">{temporal_summary.get("parked", 0)}</div><div class="stat-l">Parked</div></div>
          <div class="stat"><div class="stat-v">{temporal_summary.get("closed", 0)}</div><div class="stat-l">Closed</div></div>
          <div class="stat"><div class="stat-v">{temporal_summary.get("unknown", 0)}</div><div class="stat-l">Unknown</div></div>
        </div>
        <div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">Projection freshness</span>
            {_temporal_badge(temporal_projection.get("temporal_state", "unknown"))}
          </div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(temporal_projection.get("source", "unknown"))} · {_h(_age_label(temporal_projection.get("age_seconds")))}</div>
        </div>
        <div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">Ronny -&gt; agents</span>
            <span style="font-size:.48rem;color:var(--tm)">{temporal_ingress.get("summary", {}).get("now", 0)} now · {temporal_ingress.get("summary", {}).get("recent", 0)} recent · {temporal_ingress.get("summary", {}).get("stale", 0)} stale</span>
          </div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{temporal_ingress.get("summary", {}).get("unknown", 0)} unknown timestamps</div>
        </div>
        <div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">Agents -&gt; Ronny</span>
            <span style="font-size:.48rem;color:var(--tm)">{temporal_handoffs.get("summary", {}).get("now", 0)} now · {temporal_handoffs.get("summary", {}).get("recent", 0)} recent · {temporal_handoffs.get("summary", {}).get("stale", 0)} stale</span>
          </div>
          <div style="margin-top:.15rem">{handoff_rows}</div>
        </div>
        <div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">Parked runtime inventory</span>
            <span style="font-size:.48rem;color:var(--tm)">{temporal_parked.get("count", 0)} parked · {parked_review.get("stale", 0)} overdue · {parked_review.get("unknown", 0)} unscheduled</span>
          </div>
          <div style="margin-top:.15rem">{parked_rows}</div>
        </div>
        <div style="padding:.35rem 0">
          <div style="display:flex;align-items:baseline;gap:.4rem">
            <span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">Completion snapshot</span>
            {_temporal_badge(temporal_completion.get("temporal_state", "unknown"))}
          </div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{temporal_completion.get("closed_count", 0)} closed · {temporal_completion.get("open_count", 0)} open · {temporal_completion.get("parked_count", 0)} parked</div>
          <div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(temporal_completion.get("snapshot_timestamp", "") or "unknown snapshot")} · {_h(_age_label(temporal_completion.get("snapshot_age_seconds")))}</div>
        </div>
      </div>
    </details>"""

    # Chain status
    chain_rows = ""
    chain_labels = {
        "ronny_drops": "Ronny drops",
        "translated_to_machine": "Translated",
        "organized_sorted": "Organized/sorted",
        "moved_to_next_stage": "Moved to next stage",
        "visible_trace": "Visible trace",
        "readback_surface": "Readback surface",
    }
    for key, label in chain_labels.items():
        val = chain.get(key, "unknown")
        if val == "standing":
            dot, css = "g", "var(--grn)"
        elif val == "partial":
            dot, css = "y", "var(--ylw)"
        elif val == "this_surface":
            dot, css = "g", "var(--cyn)"
        else:
            dot, css = "r", "var(--red)"
        chain_rows += (
            f'<div style="display:flex;align-items:center;gap:.5rem;padding:.25rem 0">'
            f'<span class="sdot {dot}"></span>'
            f'<span style="font-size:.6rem;color:var(--tm);min-width:130px">{_h(label)}</span>'
            f'<span style="font-family:var(--m);font-size:.55rem;color:{css}">{_h(val)}</span>'
            f'</div>'
        )
    chain_html = f"""
    <details>
      <summary>Contribution Chain <span class="det-count">5-step operator &rarr; spine</span></summary>
      <div class="det-body">{chain_rows}</div>
    </details>"""

    recent_rows = ""
    state_colors = {
        "submitted": "var(--ylw)",
        "classified": "var(--blu)",
        "routed": "var(--grn)",
    }
    for item in recent:
        hint = item.get("operator_hint", "")
        detail = item.get("disposition_detail", "")
        ts = item.get("submitted_at", "")
        ctype = item.get("content_type", "")
        lstate = item.get("lifecycle_state", "submitted")
        lcolor = state_colors.get(lstate, "var(--ylw)")
        classification = item.get("classification", "")
        next_stage = item.get("next_stage", "")
        downstream = item.get("downstream_refs", [])
        activation = item.get("activation_conditions", "")

        # Metabolization detail line
        meta_parts = []
        if classification:
            meta_parts.append(classification)
        if next_stage:
            meta_parts.append(f"→ {next_stage}")
        meta_line = ""
        if meta_parts:
            meta_line = (
                f'<div style="font-family:var(--m);font-size:.45rem;color:var(--cyn);margin-top:.1rem">'
                f'{_h(" · ".join(meta_parts))}</div>'
            )
        downstream_line = ""
        if downstream:
            ds_items = " → ".join(_h(str(d)) for d in downstream)
            downstream_line = f'<div style="font-family:var(--m);font-size:.45rem;color:var(--cyn);margin-top:.1rem;opacity:.7">↳ {ds_items}</div>'
        activation_line = ""
        if activation:
            activation_line = f'<div style="font-size:.45rem;color:var(--prp);margin-top:.1rem">⏳ {_h(activation)}</div>'

        recent_rows += (
            f'<div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(item["ingress_id"])}</span>'
            f'{_temporal_badge(item.get("temporal_state", "unknown"))}'
            f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;'
            f'background:rgba(42,52,68,.75);color:{lcolor}">{_h(lstate)}</span>'
            f'</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(ctype)} · {_h(ts)}</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(hint or detail)}</div>'
            f'{meta_line}{downstream_line}{activation_line}'
            f'</div>'
        )
    if not recent_rows:
        recent_rows = '<div style="font-size:.6rem;color:var(--t)">no live operator ingress objects yet</div>'
    recent_html = f"""
    <details>
      <summary>Recent Ingress <span class="det-count">{len(recent)} visible</span></summary>
      <div class="det-body">{recent_rows}</div>
    </details>"""

    # Per-input lineage
    disp_colors = {
        "advanced_to_contract": ("var(--grn)", "ADV"),
        "adjacent_evidence": ("var(--blu)", "ADJ"),
        "parked_prep": ("var(--prp)", "PREP"),
        "parked_no_lifecycle": ("var(--ylw)", "PARK"),
        "out_of_spine": ("var(--t)", "OUT"),
        "staged": ("var(--t)", "STG"),
    }

    trace_rows = ""
    current_batch = ""
    for t in traces:
        batch = t.get("batch", "")
        if batch != current_batch:
            current_batch = batch
            trace_rows += (
                f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;'
                f'color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">'
                f'Batch {_h(batch)}</div>'
            )
        disp = t.get("disposition", "staged")
        color, tag = disp_colors.get(disp, ("var(--t)", "?"))
        detail = t.get("detail", "")
        downstream = t.get("downstream", [])
        downstream_html = ""
        if downstream:
            ds_items = " → ".join(_h(str(d)) for d in downstream)
            downstream_html = f'<div style="font-family:var(--m);font-size:.45rem;color:var(--cyn);margin-top:.1rem;opacity:.7">↳ {ds_items}</div>'

        trace_rows += (
            f'<div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(t["file"])}</span>'
            f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;'
            f'background:rgba(42,52,68,.75);color:{color}">{tag}</span>'
            f'</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(detail)}</div>'
            f'{downstream_html}'
            f'</div>'
        )

    trace_html = f"""
    <details>
      <summary>What Became of My Input <span class="det-count">{len(traces)} inputs traced</span></summary>
      <div class="det-body">{trace_rows}</div>
    </details>"""

    # What my ideas built
    built_rows = ""
    for c in built.get("contracts", []):
        built_rows += f'<div class="attn-item"><div class="attn-dot" style="background:var(--grn)"></div>Contract: {_h(c)}</div>'
    for p in built.get("delivered_packets", []):
        built_rows += f'<div class="attn-item"><div class="attn-dot" style="background:var(--blu)"></div>{_h(p)}</div>'
    for r in built.get("retired_packets", []):
        built_rows += f'<div class="attn-item"><div class="attn-dot" style="background:var(--t)"></div>{_h(r)}</div>'
    for d in built.get("derived_conclusions", []):
        built_rows += f'<div class="attn-item"><div class="attn-dot" style="background:var(--prp)"></div>Derived: {_h(d)}</div>'

    built_html = ""
    if built_rows:
        built_html = f"""
    <details>
      <summary>What My Ideas Built <span class="det-count">{delivered} packets · {contracts} contracts</span></summary>
      <div class="det-body">{built_rows}</div>
    </details>"""

    return f"""
    <div class="sh">Operator Vision</div>
    {stats}
    {split_html}
    {temporal_html}
    {chain_html}
    {recent_html}
    {trace_html}
    {built_html}
    """


def operator_front_door_section(fd: dict) -> str:
    """Render the four-verb operator front door as a compact grid."""
    if not fd:
        return ""

    inspect = fd.get("inspect", {})
    approve = fd.get("approve", {})
    intervene = fd.get("intervene", {})
    execute = fd.get("execute", {})

    # Color logic: inspect
    if int(inspect.get("degraded_standing", 0) or 0) > 0 or str(inspect.get("terminal_telemetry_status", "") or "") != "ok":
        inspect_css = "fd-cell-ylw"
    else:
        inspect_css = "fd-cell-grn"

    # Color logic: approve
    if int(approve.get("total", 0) or 0) > 0:
        approve_css = "fd-cell-ylw"
    else:
        approve_css = "fd-cell-grn"

    # Color logic: intervene
    if int(intervene.get("total", 0) or 0) > 0:
        intervene_css = "fd-cell-red"
    else:
        intervene_css = "fd-cell-grn"

    # Color logic: execute
    if int(execute.get("total", 0) or 0) > 0:
        execute_css = "fd-cell-blu"
    else:
        execute_css = "fd-cell-grn"

    # Build count lines
    healthy = int(inspect.get("healthy_standing", 0) or 0)
    degraded = int(inspect.get("degraded_standing", 0) or 0)
    loops = int(inspect.get("open_loops", 0) or 0)
    inspect_parts = []
    if healthy:
        inspect_parts.append(f"{healthy} healthy")
    if degraded:
        inspect_parts.append(f"{degraded} degraded")
    inspect_parts.append(f"{loops} loops")
    telemetry_status = str(inspect.get("terminal_telemetry_status", "") or "")
    if telemetry_status and telemetry_status != "ok":
        inspect_parts.append(f"telemetry {telemetry_status}")
    inspect_count = " &middot; ".join(inspect_parts)

    pending_i = int(approve.get("pending_ingress", 0) or 0)
    pending_h = int(approve.get("pending_handoffs", 0) or 0)
    pending_reviews = int(approve.get("needs_review", 0) or 0)
    approve_total = int(approve.get("total", 0) or 0)
    if approve_total == 0:
        approve_count = "nothing pending"
    else:
        ap = []
        if pending_i:
            ap.append(f"{pending_i} ingress")
        if pending_h:
            ap.append(f"{pending_h} handoff{'s' if pending_h != 1 else ''}")
        if pending_reviews:
            ap.append(f"{pending_reviews} review{'s' if pending_reviews != 1 else ''}")
        approve_count = " &middot; ".join(ap)

    active_int = int(intervene.get("active_interventions", 0) or 0)
    open_gaps = int(intervene.get("open_gaps", 0) or 0)
    if int(intervene.get("total", 0) or 0) == 0:
        intervene_count = "all clear"
    else:
        ip = []
        if active_int:
            ip.append(f"{active_int} intervention{'s' if active_int != 1 else ''}")
        ip.append(f"{open_gaps} gaps")
        intervene_count = " &middot; ".join(ip)

    waves = int(execute.get("active_waves", 0) or 0)
    active_delegations = int(execute.get("active_delegations", 0) or 0)
    executing = int(execute.get("executing", 0) or 0)
    picked_up = int(execute.get("picked_up", 0) or 0)
    if int(execute.get("total", 0) or 0) == 0:
        execute_count = "idle"
    else:
        ep = []
        if waves:
            ep.append(f"{waves} wave{'s' if waves != 1 else ''}")
        if active_delegations:
            ep.append(f"{active_delegations} delegation{'s' if active_delegations != 1 else ''}")
        if executing:
            ep.append(f"{executing} executing")
        elif picked_up:
            ep.append(f"{picked_up} picked up")
        execute_count = " &middot; ".join(ep)

    return f"""
  <div class="fd-sh">Operator</div>
  <div class="front-door">
    <div class="fd-cell {inspect_css}">
      <div class="fd-verb">Inspect</div>
      <div class="fd-count">{inspect_count}</div>
    </div>
    <div class="fd-cell {approve_css}">
      <div class="fd-verb">Approve</div>
      <div class="fd-count">{approve_count}</div>
    </div>
    <div class="fd-cell {intervene_css}">
      <div class="fd-verb">Intervene</div>
      <div class="fd-count">{intervene_count}</div>
    </div>
    <div class="fd-cell {execute_css}">
      <div class="fd-verb">Execute</div>
      <div class="fd-count">{execute_count}</div>
    </div>
  </div>"""


def standing_exception_section(payload: dict) -> str:
    sph = payload.get("standing_program_health", {}) if isinstance(payload, dict) else {}
    specimens = list(sph.get("v1_exception_specimens", []) or [])
    if not specimens:
        return ""

    badge = {
        "standing_healthy": ("var(--grn)", "HEALTHY"),
        "standing_stale_or_degraded": ("var(--ylw)", "DRIFT"),
        "auto_birthed_intervention_active": ("var(--red)", "INTERVENTION"),
        "human_born_only": ("var(--blu)", "HUMAN"),
    }
    rows = ""
    active = 0
    for item in specimens:
        state = str(item.get("operator_state") or "standing_healthy")
        color, tag = badge.get(state, ("var(--t)", "UNKNOWN"))
        label = str(item.get("label") or "").replace("com.ronny.", "")
        active_triggers = ", ".join(item.get("active_trigger_types") or []) or "none"
        if item.get("intervention_active"):
            active += 1
            governable = (
                f"{item.get('intervention_id', '')} · "
                f"{item.get('delegation_state', 'not_delegated')}"
            )
        elif item.get("drift_present"):
            governable = "drift present · no intervention packet yet"
        else:
            governable = "no active exception packet"
        rows += (
            f'<div style="padding:.45rem 0;border-bottom:1px solid rgba(26,35,50,.5)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(label)}</span>'
            f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;'
            f'background:rgba(42,52,68,.75);color:{color}">{tag}</span>'
            f'</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">enabled: {_h(", ".join(item.get("enabled_trigger_types") or []))}</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">active drift: {_h(active_triggers)}</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(governable)}</div>'
            f'</div>'
        )

    return f"""
    <section id="standing-exceptions-drilldown">
      <div class="sh">Standing Exceptions</div>
      <details open>
        <summary>{len(specimens)} specimen(s) <span class="det-count">{active} intervention-active</span></summary>
        <div class="det-body">{rows}</div>
      </details>
    </section>"""


def generate(payload: dict | None = None) -> str:
    p = payload if isinstance(payload, dict) else build_payload(compact=False)

    caps_data = p.get("capabilities", {"caps": {}, "count": 0})
    inv_counts = p.get("invocation_counts", {})
    gates_data = p.get("gates", {})
    manifest_data = p.get("manifest", {"available": False, "surfaces": [], "count": 0, "families": []})
    git_log = p.get("git_log", [])

    source_stamps = [
        f"shared payload v{p['version']}",
        f"git log: {len(git_log)} entries",
        f"capabilities: {caps_data.get('count', 0)} caps",
        f"gates: {gates_data.get('total', 0)} gates",
        f"manifest: {'ok' if manifest_data.get('available') else 'unavailable'}",
        f"github: {'ok' if p['git_refs']['github_ok'] else 'unavailable'}",
        f"freshness: {p['projection_freshness']['freshness']}",
    ]

    # Build sections
    sec_front_door = operator_front_door_section(p.get("operator_front_door", {}))
    sec_board = board_section(p)
    sec_standing_exceptions = standing_exception_section(p)
    sec_waiting = waiting_section(p)
    sec_vision = operator_vision_section(
        p.get("operator_vision", {}),
        p.get("directional_boundary", {}),
        p.get("temporal_standing", {}),
    )
    sec_temporal = temporal_truth_section(p)
    sec_fresh = freshness_card(p)
    sec_roles = node_role_card(p["node_roles"])
    sec_exec = execution_host_section(p["node_roles"])
    sec_birth = birth_mode_section(p.get("birth_mode_audit", {}))
    sec_terminal = terminal_telemetry_section(p.get("terminal_telemetry", {}))
    sec_comms = comms_incident_card(p["work_state"]["comms_queue"])
    sec_timeline = timeline_section(git_log, p.get("continuity", {}))
    sec_caps = capability_atlas(caps_data, inv_counts)
    sec_gates = gate_watch(gates_data)
    sec_auth = authority_explorer(manifest_data)
    sec_work = work_state_section(p["work_state"], p.get("active_loops", {}), p.get("active_handoffs", {}))
    sec_release = release_posture(p["git_refs"])
    sec_infra = (
        '<section id="infrastructure-drilldown">'
        '<details>'
        '<summary>Infrastructure <span class="det-count">machine + telemetry + projection + release posture</span></summary>'
        '<div class="det-body">'
        f'{sec_comms}{sec_fresh}{sec_temporal}{sec_roles}{sec_exec}{sec_terminal}{sec_birth}{sec_release}'
        '</div>'
        '</details>'
        '</section>'
    )
    stamps_str = _h(" \u00b7 ".join(source_stamps))

    # Top-bar beacon
    verify = p["spine_now"]["verify_status"]
    anomalies = p["spine_now"]["anomaly_count"]
    if verify == "pass" and anomalies == 0:
        beacon_css, beacon_text = "grn", "Healthy"
    elif verify != "pass":
        beacon_css, beacon_text = "red", "Degraded"
    else:
        beacon_css, beacon_text = "ylw", "Mixed"
    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spine Cockpit</title>
<style>{CSS}</style>
</head>
<body>
<div class="c">
  <div class="top-bar">
    <div class="top-id">
      <div class="top-eyebrow">Operator Surface Family</div>
      <h1>spine.ronny.works</h1>
    </div>
    <div class="surface-nav" aria-label="Operator surface tabs">
      <span class="surface-tab active">Board <span class="surface-tab-hint">you are here</span></span>
      <a class="surface-tab" data-surface-link="/submit">Submit <span class="surface-tab-hint">operator ingress</span></a>
      <a class="surface-tab" data-surface-link="/ingress">Submissions <span class="surface-tab-hint">readback</span></a>
    </div>
    <div class="beacon">
      <div class="beacon-dot {beacon_css}"></div>
      <span class="beacon-label">{_h(beacon_text)}</span>
    </div>
    <span class="ts">{_h(p['generated_utc'])}</span>
  </div>

  <!-- Operator front door: four-verb model -->
  {sec_front_door}

  <!-- Board: the glanceable operator surface -->
  {sec_board}
  {sec_standing_exceptions}

  <!-- Drilldown: everything else, collapsed -->
  <hr class="drilldown-sep">
  <div class="drilldown-label">Drilldown</div>
  {sec_waiting}
  {sec_timeline}
  <section id="workstate-drilldown"><div class="sh">Work State</div>{sec_work}</section>
  {sec_vision}
  {sec_infra}
  {sec_caps}
  {sec_gates}
  {sec_auth}

  <div class="foot">
    cockpit.generate v4 \u00b7 shared operator-overview-payload \u00b7 static snapshot<br>
    sources: {stamps_str}
  </div>
</div>
<script>{JS}</script>
</body>
</html>"""


def main() -> int:
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    content = generate()
    OUTPUT.write_text(content, encoding="utf-8")
    print(f"cockpit generated → {OUTPUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
