JS = r"""
function filterCaps(e, domain) {
  var rows = document.querySelectorAll('.cap[data-domain]');
  var btns = document.querySelectorAll('.cap-f');
  btns.forEach(function(b) { b.classList.remove('active'); });
  e.currentTarget.classList.add('active');
  rows.forEach(function(r) {
    r.style.display = (domain === 'all' || r.dataset.domain === domain) ? '' : 'none';
  });
}
"""


def generate() -> str:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    refs = collect_refs()
    status = collect_status()
    roles = collect_node_roles(status)
    log = collect_git_log(30)
    caps_data = collect_capabilities()
    invocation_counts = collect_invocation_counts()
    gates = collect_gates()
    manifest = collect_manifest()

    source_stamps = [
        f"ops status --json: {'ok' if status else 'fail'}",
        f"git log: {len(log)} entries",
        f"capabilities.yaml: {caps_data['count']} caps",
        f"gate.registry.yaml: {gates['total']} gates",
        f"SPINE_SURFACE_MANIFEST: {'ok' if manifest['available'] else 'unavailable'} ({manifest['count']} surfaces)",
        f"github remote: {'ok' if refs['github_ok'] else 'unavailable'}",
    ]

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spine Cockpit</title>
<style>{CSS}</style>
</head>
<body>
<div class="c">
  <div class="top">
    <h1>Spine Cockpit</h1>
    <span>generated {_h(now)}</span>
  </div>

  {engine_posture(status, refs)}
  {node_role_card(roles)}
  {execution_host_section(roles)}
  {comms_incident_card(status)}
  {attention_section(status, refs)}
  {timeline_section(log)}
  {capability_atlas(caps_data, invocation_counts)}
  {gate_watch(gates)}
  {authority_explorer(manifest)}
  {work_state(status)}
  {release_posture(refs)}

  <div class="foot">
    cockpit.generate v1 · static snapshot · manual refresh<br>
    sources: {_h(' · '.join(source_stamps))}
  </div>
</div>
<script>{JS}</script>
</body>
</html>"""


def main() -> int:
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    content = generate()
    OUTPUT.write_text(content, encoding="utf-8")
    print(f"cockpit generated → {OUTPUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
