#!/usr/bin/env python3
"""cockpit.generate — desktop-facing dense leaf of the operator overview.

This is a LEAF, not a root. It consumes the shared operator-overview-payload
and renders a desktop-first dense HTML cockpit with drilldown. Same truth,
same timestamps, same attention ordering as the mobile surface — different
density and interaction.

Produces a static HTML snapshot at $SPINE_STATE/domain-state/SPINE_COCKPIT.html.
No mutation, no server, no auto-refresh.

    ./bin/ops cap run cockpit.generate
"""
from __future__ import annotations

import html
import importlib.machinery
import importlib.util
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

# Import the shared payload generator (no .py extension)
_payload_path = Path(__file__).resolve().parent / "operator-overview-payload"
_loader = importlib.machinery.SourceFileLoader("operator_overview_payload", str(_payload_path))
_spec = importlib.util.spec_from_loader("operator_overview_payload", _loader)
_mod = importlib.util.module_from_spec(_spec)
_loader.exec_module(_mod)
build_payload = _mod.build_payload

RUNTIME_STATE = Path(os.environ.get("SPINE_STATE", Path.home() / "code" / ".runtime" / "spine" / "state"))
OUTPUT = RUNTIME_STATE / "domain-state" / "SPINE_COCKPIT.html"
_FILE_FALLBACK_ROOT = "http://127.0.0.1:8900"  # JS rewrites relative hrefs when opened as file://


def _h(s: str) -> str:
    return html.escape(str(s)) if s else ""


def _age_label(seconds: int | None) -> str:
    if seconds is None or seconds < 0:
        return "unknown"
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h {(seconds % 3600) // 60}m ago"
    return f"{seconds // 86400}d {(seconds % 86400) // 3600}h ago"


def _temporal_badge(state: str) -> str:
    palette = {
        "now": ("var(--grn)", "NOW"),
        "recent": ("var(--cyn)", "RECENT"),
        "stale": ("var(--red)", "STALE"),
        "parked": ("var(--prp)", "PARKED"),
        "closed": ("var(--tb)", "CLOSED"),
        "unknown": ("var(--ylw)", "UNKNOWN"),
    }
    color, label = palette.get(state, palette["unknown"])
    return (
        f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;'
        f'border-radius:3px;background:rgba(42,52,68,.75);color:{color}">{label}</span>'
    )


def _continuity_summary(continuity: dict) -> tuple[str, bool]:
    last_generated = str(continuity.get("last_generated_utc") or "")
    commits_since = int(continuity.get("commits_since", 0) or 0)
    loops_changed = list(continuity.get("loops_changed", []) or [])
    if not last_generated:
        return "First check from this board", False
    if commits_since == 0 and not loops_changed:
        return "Nothing changed since last check", False
    parts: list[str] = []
    if commits_since:
        parts.append(f"{commits_since} commit{'s' if commits_since != 1 else ''}")
    if loops_changed:
        parts.append(f"{len(loops_changed)} loop{'s' if len(loops_changed) != 1 else ''} changed")
    return " \u00b7 ".join(parts), True


# ---------------------------------------------------------------------------
# Section builders — consume the shared payload
# ---------------------------------------------------------------------------

def engine_posture(payload: dict) -> str:
    spine = payload["spine_now"]
    refs = payload["git_refs"]
    attention = payload["attention"]

    verify = spine["verify_status"]
    has_anomalies = spine["anomaly_count"] > 0

    if verify != "pass":
        color, label, css = "red", "Degraded", "red"
    elif has_anomalies or not refs["github_ok"] or refs["is_dirty"]:
        color, label, css = "yellow", "Mixed", "ylw"
    else:
        color, label, css = "green", "Healthy", "grn"

    reasons = []
    if verify != "pass":
        reasons.append(f"verify: {verify}")
    if has_anomalies:
        reasons.append(f"{spine['anomaly_count']} anomal{'y' if spine['anomaly_count']==1 else 'ies'}")
    if not refs["github_ok"]:
        reasons.append("github mirror diverged/unavailable")
    if refs["is_dirty"]:
        reasons.append("repo dirty")
    if not reasons:
        reasons.append("all signals nominal")

    return f"""
    <div class="posture {css}">
      <div class="p-dot"></div>
      <div>
        <div class="p-text">{_h(label)}</div>
        <div class="p-sub">{_h(' · '.join(reasons))}</div>
      </div>
    </div>"""


def board_section(payload: dict) -> str:
    """The main visual board — zones for NOW / WAITING / BACKGROUND."""
    spine = payload["spine_now"]
    work = payload["work_state"]
    refs = payload["git_refs"]
    loops_data = payload.get("active_loops", {})
    loops = loops_data.get("items", [])
    focus = loops_data.get("focus", {}) if isinstance(loops_data.get("focus"), dict) else {}
    handoffs = int(payload.get("active_handoffs", {}).get("count", 0) or 0)
    attention = payload.get("attention", [])
    posture = payload.get("current_posture", {}) if isinstance(payload.get("current_posture"), dict) else {}
    aperture = payload.get("aperture", {}) if isinstance(payload.get("aperture"), dict) else {}
    continuity = payload.get("continuity", {}) if isinstance(payload.get("continuity"), dict) else {}
    ov = payload.get("operator_vision", {})
    mhw = ov.get("my_human_work_now", {}) if isinstance(ov, dict) else {}

    pending_ingress = int(mhw.get("pending_ingress", 0) or 0)
    actionable_attention = [a for a in attention if a.get("priority") in {"high", "medium"}]
    waiting_count = handoffs + len(actionable_attention) + pending_ingress
    continuity_text, continuity_active = _continuity_summary(continuity)

    # Engine status
    verify = spine.get("verify_status", "unknown")
    anomalies = int(spine.get("anomaly_count", 0) or 0)
    gaps = int(work.get("open_gaps", 0) or 0)
    waves = int(work.get("active_waves", 0) or 0)

    healthy_engine = verify == "pass" and anomalies == 0 and gaps == 0 and waves == 0
    if verify != "pass":
        engine_css = "red"
        engine_label = "Engine degraded"
    else:
        engine_css = "ylw"
        engine_label = "Engine mixed"

    engine_bits = f"verify {verify} \u00b7 {gaps} gaps \u00b7 {anomalies} anomalies"

    # System status line (repo dirty, mirror diverged — not operator work)
    sys_parts = []
    if refs.get("is_dirty"):
        sys_parts.append("repo dirty")
    if not refs.get("github_ok"):
        sys_parts.append("mirror unavailable")
    elif refs.get("local_head") != refs.get("github_head") and refs.get("github_ok"):
        sys_parts.append("mirror diverged")
    sys_line = ""
    if sys_parts:
        sys_line = f'<div class="engine-subtle-note">{_h(" \u00b7 ".join(sys_parts))}</div>'

    # NOW zone ��� hero loop(s)
    if loops:
        primary_id = str(focus.get("primary", "") or "")
        primary = next((l for l in loops if l.get("id") == primary_id), None)
        if primary is None:
            primary = loops[0]
        secondary_ids = [str(lid) for lid in (focus.get("secondary") or []) if str(lid or "").strip()]
        secondaries = [l for l in loops if l.get("id") in secondary_ids]

        loop_title = primary.get("title") or primary.get("id") or "Open loop"

        # Why line (humanized)
        why_human = str(focus.get("why_human", "") or "").strip()
        why_html = ""
        if why_human:
            why_html = f'<div class="focus-why">{_h(why_human)}</div>'

        # Confidence badge (keep only low confidence; medium is noise)
        confidence = str(focus.get("confidence", "") or "").strip().lower()
        confidence_html = ""
        if confidence == "low":
            confidence_html = (
                '<div class="hero-loop-meta-wrap">'
                '<span class="focus-confidence focus-confidence-low">low confidence</span>'
                '</div>'
            )

        # Next move — operator intent primary, machine suggestion fallback only
        next_action = str(primary.get("next_action", "") or "").strip()
        next_move_html = ""
        if next_action:
            next_move_html = (
                f'<div class="next-move">'
                f'<span class="next-move-label">Next move</span>'
                f'<span class="next-move-text">{_h(next_action)}</span>'
                f'</div>'
            )
        else:
            routing_action = str(posture.get("recommended_action", "") or "").strip()
            if routing_action:
                next_move_html = (
                    f'<div class="next-move next-move-suggested">'
                    f'<span class="next-move-label">Suggested next move</span>'
                    f'<span class="next-move-text">{_h(routing_action)}</span>'
                    f'</div>'
                )

        # System constraint note (blocked, ambiguous posture)
        constraint_parts = []
        if primary.get("blocked_by"):
            constraint_parts.append(f"blocked by {_h(primary['blocked_by'])}")
        if posture.get("available") and posture.get("routing_state") == "ambiguous":
            constraint_parts.append("session posture is ambiguous")
        constraint_html = ""
        if constraint_parts:
            constraint_html = (
                f'<div class="system-note">'
                f'{" \u00b7 ".join(constraint_parts)}'
                f'</div>'
            )

        hero_html = f'''
        <div class="hero-loop">
          <div class="hero-loop-title">{_h(loop_title)}</div>
          {confidence_html}
          {why_html}
          {next_move_html}
          {constraint_html}
        </div>'''

        # Also live — compressed secondary loops
        also_live_html = ""
        if secondaries:
            also_items = []
            for sl in secondaries[:5]:
                sl_title = sl.get("title") or sl.get("id") or "loop"
                sl_meta = " \u00b7 ".join(bit for bit in (
                    sl.get("status"), sl.get("readiness"), sl.get("horizon"), sl.get("severity"),
                ) if bit)
                also_items.append(
                    f'<div class="also-live-item">'
                    f'<div class="also-live-title">{_h(sl_title)}</div>'
                    f'<div class="also-live-meta">{_h(sl_meta)}</div>'
                    f'</div>'
                )
            also_live_html = (
                f'<div class="also-live">'
                f'<div class="also-live-label">Also live</div>'
                f'{"".join(also_items)}'
                f'</div>'
            )

        hero_html += also_live_html
        now_css = "zone-now"
    else:
        hero_html = (
            '<div class="hero-loop">'
            '<div class="hero-loop-none">No live work</div>'
            '<div class="hero-loop-cta-wrap">'
            '<a class="hero-loop-cta" data-surface-link="/submit">Submit a note</a>'
            '<span class="hero-loop-cta-sub">park raw operator ingress</span>'
            '</div>'
            '</div>'
        )
        now_css = "zone-now zone-idle"

    if healthy_engine:
        engine_line = f'''
    <div class="engine-line engine-line-ok">
      <div class="engine-dot grn"></div>
      <div class="engine-text">Engine ok</div>
      {sys_line}
    </div>'''
    else:
        engine_line = f'''
    <div class="engine-line">
      <div class="engine-dot {engine_css}"></div>
      <div class="engine-text">{_h(engine_label)} \u2014 {_h(engine_bits)}</div>
      {sys_line}
    </div>'''

    # Current Posture block
    posture_html = ""
    if posture.get("available"):
        routing = _h(posture.get("routing_state", ""))
        container = _h(posture.get("container", ""))
        p_why = _h(posture.get("why", ""))
        posture_html = f'''
    <div class="posture-block">
      <div class="posture-block-label">Current Posture <span class="posture-block-sub">if you attached now</span></div>
      <div class="posture-block-row"><span class="posture-field">Route</span> <span class="posture-value">{routing}</span></div>
      <div class="posture-block-row"><span class="posture-field">Container</span> <span class="posture-value">{container}</span></div>
      <div class="posture-block-row"><span class="posture-field">Why</span> <span class="posture-value">{p_why}</span></div>
    </div>'''
    elif aperture.get("available"):
        posture_html = '''
    <div class="posture-block posture-block-fallback">
      <div class="posture-block-label">Current Posture <span class="posture-block-sub">routing unavailable \u2014 aperture only</span></div>
    </div>'''

    # Aperture block
    aperture_html = ""
    if aperture.get("available"):
        ap_name = _h(aperture.get("name", ""))
        legal_items = aperture.get("legal", [])[:4]
        illegal_items = aperture.get("illegal", [])[:3]
        legal_html = "".join(
            f'<div class="aperture-item aperture-legal">{_h(item)}</div>'
            for item in legal_items
        )
        illegal_html = "".join(
            f'<div class="aperture-item aperture-illegal">{_h(item)}</div>'
            for item in illegal_items
        )
        aperture_html = f'''
    <div class="aperture-block">
      <div class="aperture-block-label">Aperture <span class="aperture-name">{ap_name}</span></div>
      {legal_html}
      {illegal_html}
    </div>'''

    now_zone = f'''
    <div class="zone {now_css}">
      <div class="zone-label">{"Today" if loops else "Now \u2014 idle"}</div>
      {hero_html}
      {engine_line}
      {posture_html}
      {aperture_html}
      <div class="status-ribbon">
        <a class="ribbon-badge {"ribbon-badge-active" if waiting_count else "ribbon-badge-ok"}" href="#waiting-drilldown">{waiting_count} waiting</a>
        <a class="ribbon-badge {"ribbon-badge-active" if continuity_active else "ribbon-badge-ok"}" href="#changes-drilldown">{_h(continuity_text)}</a>
        <a class="ribbon-badge {"ribbon-badge-ok" if healthy_engine else "ribbon-badge-active"}" href="#infrastructure-drilldown">{"engine ok" if healthy_engine else "engine needs attention"}</a>
        <a class="ribbon-badge {"ribbon-badge-active" if refs.get("is_dirty") else "ribbon-badge-ok"}" href="#infrastructure-drilldown">{"repo dirty" if refs.get("is_dirty") else "repo clean"}</a>
        <a class="ribbon-badge {"ribbon-badge-ok" if refs.get("local_full") == refs.get("origin_full") and refs.get("github_ok") and refs.get("local_head") == refs.get("github_head") else "ribbon-badge-active"}" href="#infrastructure-drilldown">{_h("origin synced" if refs.get("local_full") == refs.get("origin_full") else "origin diverged")} · {_h("mirror synced" if refs.get("github_ok") and refs.get("local_head") == refs.get("github_head") else ("mirror unavailable" if not refs.get("github_ok") else "mirror diverged"))}</a>
      </div>
    </div>'''

    # WAITING zone — only real operator asks, not system noise
    return f'''
    <div class="board">
      {now_zone}
    </div>'''


def freshness_card(payload: dict) -> str:
    f = payload["projection_freshness"]
    freshness = f["freshness"]
    age = f["age_seconds"]
    source = f["source"]

    if freshness == "current":
        css = "grn"
    elif freshness == "aging":
        css = "ylw"
    elif freshness == "stale":
        css = "red"
    else:
        css = "ylw"

    if age >= 0:
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age // 60}m ago"
        else:
            age_str = f"{age // 3600}h {(age % 3600) // 60}m ago"
    else:
        age_str = "unknown"

    return f"""
    <div class="posture {css}" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Projection: {_h(freshness)}</div>
        <div class="p-sub">{_h(age_str)} · source: {_h(source)}</div>
      </div>
    </div>"""


def _node_posture_badge(posture: str) -> str:
    palette = {
        "live": ("var(--grn)", "LIVE"),
        "defined_not_delivered": ("var(--ylw)", "DEFINED"),
        "defined_not_local": ("var(--cyn)", "DEFINED"),
        "taxonomy_only": ("var(--tb)", "TAXONOMY"),
    }
    color, label = palette.get(posture or "", ("var(--tb)", (posture or "UNKNOWN").replace("_", " ").upper()))
    return (
        f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;'
        f'border-radius:3px;background:rgba(42,52,68,.75);color:{color}">{_h(label)}</span>'
    )


def node_role_card(roles: dict) -> str:
    local_role = roles.get("local_role") or "unknown"
    exec_target = roles.get("execution_host_target") or ""
    local_label = local_role.replace("_", " ")
    exec_posture = roles.get("execution_host_posture") or "unknown"
    exec_active = int(roles.get("execution_host_active_workload_count", roles.get("execution_host_workload_count", 0)) or 0)
    exec_intended = int(roles.get("execution_host_intended_workload_count", exec_active) or 0)
    exec_parked = int(roles.get("execution_host_parked_workload_count", 0) or 0)
    verification = roles.get("verification_node", {}) if isinstance(roles.get("verification_node"), dict) else {}
    storage = roles.get("storage_evidence_node", {}) if isinstance(roles.get("storage_evidence_node"), dict) else {}
    control = roles.get("control_node", {}) if isinstance(roles.get("control_node"), dict) else {}

    def _node_row(label: str, value: str, sub: str, posture: str) -> str:
        return (
            f'<div class="nr-row">'
            f'<div class="nr-label">{_h(label)}</div>'
            f'<div class="nr-value">{_h(value)}'
            f'<span class="nr-sub">{_h(sub)}</span>'
            f'<span style="margin-left:.45rem">{_node_posture_badge(posture)}</span>'
            f'</div></div>'
        )

    exec_value = exec_target or "defined role"
    exec_sub = f"{exec_active} active / {exec_intended} intended"
    if exec_parked:
        exec_sub += f" / {exec_parked} parked"

    verification_sub = f"{int(verification.get('intended_workload_count', 0) or 0)} mapped workload(s)"
    storage_sub = (
        f"{int(storage.get('active_workload_count', 0) or 0)} mapped active / "
        f"{int(storage.get('intended_workload_count', 0) or 0)} mapped intended"
    )
    control_sub = "future taxonomy · not promoted"

    return f"""
    <div class="nr">
      <div class="nr-row">
        <div class="nr-label">this machine</div>
        <div class="nr-value">{_h(local_label)}</div>
      </div>
      {_node_row("execution host", exec_value, exec_sub, exec_posture)}
      {_node_row("verification node", "defined role", verification_sub, str(verification.get("posture", "defined_not_delivered") or "defined_not_delivered"))}
      {_node_row("storage evidence", "defined role", storage_sub, str(storage.get("posture", "defined_not_delivered") or "defined_not_delivered"))}
      {_node_row("control node", "taxonomy only", control_sub, str(control.get("posture", "taxonomy_only") or "taxonomy_only"))}
    </div>"""


def temporal_truth_section(payload: dict) -> str:
    temporal = payload.get("temporal_truth", {})
    verify = temporal.get("verify", {}) if isinstance(temporal, dict) else {}
    comms = temporal.get("comms_queue", {}) if isinstance(temporal, dict) else {}
    daemons = temporal.get("daemons", {}) if isinstance(temporal, dict) else {}
    cards: list[str] = []

    verify_class = str(verify.get("temporal_class") or "")
    if verify_class:
        verify_css = "ylw" if verify_class == "inherited_still_current" else ("grn" if verify.get("status") == "pass" else "red")
        gates = list(verify.get("current_blocking_fail_ids") or [])
        gate_text = ", ".join(gates[:4])
        if len(gates) > 4:
            gate_text += ", ..."
        verify_bits = [verify_class]
        if verify.get("known_since_utc"):
            verify_bits.append(f"since {verify['known_since_utc']}")
        standing = int(verify.get("standing_evidence_count", 0) or 0)
        if standing:
            verify_bits.append(f"{standing} corroborating receipt(s)")
        if gate_text:
            verify_bits.append(gate_text)
        cards.append(
            f"""
    <div class="posture {verify_css}" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Verify Standing</div>
        <div class="p-sub">{_h(' · '.join(verify_bits))}</div>
      </div>
    </div>"""
        )

    comms_class = str(comms.get("temporal_class") or "")
    if comms_class:
        evidence = comms.get("evidence", {}) if isinstance(comms.get("evidence"), dict) else {}
        comms_bits = [
            comms_class,
            f"pending={int(evidence.get('pending', 0) or 0)}",
            f"oldest={int(evidence.get('oldest_age_seconds', 0) or 0)}s",
        ]
        if comms.get("operator_treatment"):
            comms_bits.append(str(comms.get("operator_treatment")))
        cards.append(
            f"""
    <div class="posture grn" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Comms Queue Side Surface</div>
        <div class="p-sub">{_h(' · '.join(comms_bits))}</div>
      </div>
    </div>"""
        )

    daemon_class = str(daemons.get("temporal_class") or "")
    if daemon_class:
        evidence = daemons.get("evidence", {}) if isinstance(daemons.get("evidence"), dict) else {}
        daemon_bits = [
            daemon_class,
            f"non_local={int(evidence.get('non_local_deferred', 0) or 0)}",
            f"elsewhere={int(evidence.get('active_elsewhere', 0) or 0)}",
            f"parked={int(evidence.get('parked_required', 0) or 0)}",
            f"exempt={int(evidence.get('locality_exempt', 0) or 0)}",
        ]
        if daemons.get("operator_treatment"):
            daemon_bits.append(str(daemons.get("operator_treatment")))
        cards.append(
            f"""
    <div class="posture grn" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Daemon Locality</div>
        <div class="p-sub">{_h(' · '.join(daemon_bits))}</div>
      </div>
    </div>"""
        )

    return "".join(cards)


def execution_host_section(roles: dict) -> str:
    exec_target = roles.get("execution_host_target") or ""
    if not exec_target:
        return ""

    exec_count = int(roles.get("execution_host_active_workload_count", roles.get("execution_host_workload_count", 0)) or 0)
    exec_intended = int(roles.get("execution_host_intended_workload_count", exec_count) or 0)
    exec_parked = int(roles.get("execution_host_parked_workload_count", 0) or 0)
    exec_labels = roles.get("execution_host_active_workload_labels", roles.get("execution_host_workload_labels", []))
    exec_access = roles.get("execution_host_access") or ""
    exec_purposes = roles.get("execution_host_active_workload_purposes", roles.get("execution_host_workload_purposes", {}))
    parked_labels = roles.get("execution_host_parked_workload_labels", [])
    parked_purposes = roles.get("execution_host_parked_workload_purposes", {})

    workload_rows = ""
    for lbl in sorted(exec_labels):
        short = lbl.replace("com.ronny.", "")
        purpose = exec_purposes.get(lbl, "")
        purpose_html = f'<div class="eh-purpose">{_h(purpose)}</div>' if purpose else ""
        workload_rows += f'<div class="eh-lbl">{_h(short)}{purpose_html}</div>'
    if workload_rows:
        workload_rows = (
            f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5">'
            f'active delivered ({exec_count})</div>'
            + workload_rows
        )
    else:
        workload_rows = '<div class="eh-lbl eh-other">no active delivered workloads</div>'

    other_rows = ""
    if parked_labels:
        parked_rows = ""
        for lbl in sorted(parked_labels):
            short = lbl.replace("com.ronny.", "")
            purpose = parked_purposes.get(lbl, "")
            purpose_html = f'<div class="eh-purpose">{_h(purpose)}</div>' if purpose else ""
            parked_rows += f'<div class="eh-lbl eh-other">{_h(short)}{purpose_html}</div>'
        other_rows += (
            f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;'
            f'border-top:1px solid var(--b);margin-top:.25rem">parked inventory ({len(parked_labels)})</div>'
            + parked_rows
        )

    access_line = f'<div class="eh-access">{_h(exec_access)}</div>' if exec_access else ""
    detail_bits = [f"{exec_count} active", f"{exec_intended} intended"]
    if exec_parked:
        detail_bits.append(f"{exec_parked} parked")
    detail_summary = " · ".join(detail_bits)

    return f"""
    <div class="sh">Execution Host</div>
    <details>
      <summary>{_h(exec_target)} <span class="det-count">{_h(detail_summary)}</span></summary>
      <div class="det-body">
        {access_line}
        {workload_rows}
        {other_rows}
      </div>
    </details>"""


def birth_mode_section(audit: dict) -> str:
    if not audit:
        return ""
    ok = audit.get("ok", True)
    violations = audit.get("violations", [])
    summary = audit.get("summary", {})
    total = audit.get("total_labels", 0)

    mode_parts = [f'{_h(m)}: {c}' for m, c in sorted(summary.items())]
    mode_line = " · ".join(mode_parts) if mode_parts else "none classified"

    if ok:
        badge = (
            '<span style="color:var(--grn);font-weight:600;font-size:.5rem;'
            'padding:.1rem .3rem;border-radius:3px;background:rgba(42,52,68,.75)">'
            'ALL HONEST</span>'
        )
        detail_body = f'<div style="font-size:.5rem;color:var(--t);opacity:.7">{_h(mode_line)}</div>'
    else:
        badge = (
            f'<span style="color:var(--red);font-weight:600;font-size:.5rem;'
            f'padding:.1rem .3rem;border-radius:3px;background:rgba(42,52,68,.75)">'
            f'{len(violations)} VIOLATION{"S" if len(violations) != 1 else ""}</span>'
        )
        rows = ""
        for v in violations:
            rows += (
                f'<div style="font-size:.5rem;color:var(--red);padding:.15rem 0">'
                f'{_h(v.get("label",""))}: {_h(v.get("issue",""))}</div>'
            )
        detail_body = rows

    return f"""
    <div class="sh">Birth Mode Audit</div>
    <details{"" if ok else ' open'}>
      <summary>{total} labels {badge}</summary>
      <div class="det-body">{detail_body}</div>
    </details>"""


def terminal_telemetry_section(telemetry: dict) -> str:
    if not telemetry or not telemetry.get("available", False):
        return ""

    status = str(telemetry.get("status", "unknown") or "unknown")
    fresh = int(telemetry.get("fresh_terminals", 0) or 0)
    custody = int(telemetry.get("fresh_custody_terminals", 0) or 0)
    observed = int(telemetry.get("observed_terminals", 0) or 0)
    mapped = int(telemetry.get("mapped_open_loops", 0) or 0)
    unmapped = int(telemetry.get("unmapped_open_loops", 0) or 0)
    hidden = int(telemetry.get("hidden_terminal_count", 0) or 0)
    window = int(telemetry.get("observation_window_hours", 0) or 0)

    if status == "ok":
        badge_color = "var(--grn)"
        badge_label = "OK"
    elif status == "degraded":
        badge_color = "var(--ylw)"
        badge_label = "DEGRADED"
    elif status in {"stale", "unavailable"}:
        badge_color = "var(--red)"
        badge_label = status.upper()
    else:
        badge_color = "var(--ylw)"
        badge_label = status.upper()

    badge = (
        f'<span style="color:{badge_color};font-weight:600;font-size:.5rem;'
        f'padding:.1rem .3rem;border-radius:3px;background:rgba(42,52,68,.75)">'
        f'{_h(badge_label)}</span>'
    )

    rows: list[str] = []
    for item in telemetry.get("focus_terminals", []) or []:
        terminal_id = str(item.get("terminal_id", "") or "unknown")
        loop_id = str(item.get("loop_id", "") or "")
        role = " / ".join(
            bit for bit in (str(item.get("role", "") or ""), str(item.get("runtime_role", "") or "")) if bit
        ) or "role unknown"
        meta_bits = [role]
        if item.get("lane_type"):
            meta_bits.append(str(item.get("lane_type", "")))
        if item.get("branch"):
            meta_bits.append(str(item.get("branch", "")))
        if item.get("last_capability"):
            meta_bits.append(str(item.get("last_capability", "")))
        status_bits = []
        status_bits.append("live" if item.get("liveness_fresh") else "stale")
        status_bits.append("custody" if item.get("custody_fresh") else "no custody")
        if loop_id:
            status_bits.append(loop_id)
        rows.append(
            f'<div style="padding:.35rem 0;border-bottom:1px solid rgba(26,35,50,.5)">'
            f'<div style="display:flex;align-items:baseline;gap:.4rem">'
            f'<span style="font-family:var(--m);font-size:.55rem;color:var(--tb);flex:1">{_h(terminal_id)}</span>'
            f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;border-radius:3px;'
            f'background:rgba(42,52,68,.75);color:{badge_color}">{_h(" · ".join(status_bits))}</span>'
            f'</div>'
            f'<div style="font-size:.5rem;color:var(--tm);margin-top:.1rem">{_h(" · ".join(meta_bits))}</div>'
            f'</div>'
        )
    if hidden:
        rows.append(
            f'<div style="font-size:.5rem;color:var(--t);opacity:.7;padding-top:.35rem">'
            f'+ {hidden} older terminal record{"s" if hidden != 1 else ""} hidden'
            f'</div>'
        )

    details_body = (
        f'<div style="font-size:.5rem;color:var(--tm);padding-bottom:.45rem">'
        f'{fresh} fresh live heartbeat{"s" if fresh != 1 else ""} · '
        f'{custody} fresh custody record{"s" if custody != 1 else ""} · '
        f'{mapped}/{mapped + unmapped} open loops mapped · '
        f'{observed} observed in last {window}h'
        f'</div>'
        f'{"".join(rows) if rows else "<div style=\"font-size:.5rem;color:var(--t)\">no terminal records visible</div>"}'
    )

    return f"""
    <div class="sh">Terminal Telemetry</div>
    <details{"" if status == "ok" else ' open'}>
      <summary>{_h(telemetry.get("coverage_summary", "telemetry"))} <span class="det-count">{badge}</span></summary>
      <div class="det-body">{details_body}</div>
    </details>"""


def comms_incident_card(cq: dict) -> str:
    slo = cq.get("slo_status", "ok")
    pending = int(cq.get("pending", 0) or 0)
    oldest = int(cq.get("oldest_age_seconds", 0) or 0)
    escalations = int(cq.get("escalations", 0) or 0)
    if slo == "ok" or (pending == 0 and oldest == 0 and escalations == 0):
        return ""

    drain_state = cq.get("drain_state", "unknown")

    if oldest >= 86400:
        age_str = f"{oldest // 86400}d {(oldest % 86400) // 3600}h"
    elif oldest >= 3600:
        age_str = f"{oldest // 3600}h {(oldest % 3600) // 60}m"
    else:
        age_str = f"{oldest // 60}m"

    state_css = "ylw" if drain_state == "draining" else "red"
    state_label = drain_state if drain_state in ("draining", "blocked") else "unknown"

    return f"""
    <div class="cq cq-{state_css}">
      <div class="cq-head">
        <span class="cq-title">Comms Queue</span>
        <span class="cq-state cq-s-{state_css}">{_h(slo)} · {_h(state_label)}</span>
      </div>
      <div class="cq-evidence">{pending} pending · oldest {_h(age_str)}</div>
    </div>"""


def attention_section(attention: list[dict]) -> str:
    if not attention:
        return ""
    rows = []
    for item in attention:
        color = "r" if item.get("priority") == "high" else "y"
        text = item.get("summary", "")
        rows.append(f'<div class="attn-item"><div class="attn-dot {color}"></div>{_h(text)}</div>')
    return f'<div class="attn">{"".join(rows)}</div>'


def waiting_section(payload: dict) -> str:
    active_handoffs = payload.get("active_handoffs", {}) if isinstance(payload.get("active_handoffs"), dict) else {}
    handoff_items = active_handoffs.get("items", []) or []
    operator_vision = payload.get("operator_vision", {}) if isinstance(payload.get("operator_vision"), dict) else {}
    pending_ingress = int(operator_vision.get("my_human_work_now", {}).get("pending_ingress", 0) or 0)
    attention_items = [
        item for item in (payload.get("attention", []) or [])
        if item.get("priority") in {"high", "medium"}
    ]
    total = int(active_handoffs.get("count", 0) or 0) + pending_ingress + len(attention_items)
    rows: list[str] = []
    if handoff_items:
        for item in handoff_items[:5]:
            summary = str(item.get("summary", "") or item.get("id", ""))
            route = " → ".join(bit for bit in (item.get("from_role", ""), item.get("to_role", "")) if bit)
            meta = " · ".join(bit for bit in (route, item.get("created_at_utc", "")) if bit)
            rows.append(
                f'<div class="attn-item"><div class="attn-dot y"></div>'
                f'<div><div>{_h(summary)}</div><div class="waiting-meta">{_h(meta)}</div></div></div>'
            )
    if pending_ingress:
        rows.append(
            f'<div class="attn-item"><div class="attn-dot y"></div>'
            f'<div><div>{pending_ingress} pending ingress</div>'
            f'<div class="waiting-meta">awaiting membrane or classification</div></div></div>'
        )
    for item in attention_items[:5]:
        color = "r" if item.get("priority") == "high" else "y"
        rows.append(f'<div class="attn-item"><div class="attn-dot {color}"></div>{_h(item.get("summary", ""))}</div>')
    if not rows:
        rows.append('<div class="waiting-empty">Nothing waiting on you.</div>')
    return f"""
    <div class="sh">Waiting on You</div>
    <details id="waiting-drilldown"{" open" if total else ""}>
      <summary>Operator asks <span class="det-count">{total} active</span></summary>
      <div class="det-body">{"".join(rows)}</div>
    </details>"""


def timeline_section(log: list[dict], continuity: dict) -> str:
    if not log:
        return '<div class="sh">What Changed</div><p style="font-size:.6rem;color:var(--t)">unavailable</p>'
    continuity_text, continuity_active = _continuity_summary(continuity)
    loops_changed = list(continuity.get("loops_changed", []) or [])
    days: dict[str, list[dict]] = {}
    for entry in log:
        d = entry["date"]
        days.setdefault(d, []).append(entry)

    rows = []
    if continuity_text:
        rows.append(f'<div class="timeline-lead">{_h(continuity_text)}</div>')
    if loops_changed:
        rows.append(
            '<div class="timeline-loop-changes">'
            f'<div class="timeline-loop-label">loop status changes</div>'
            + "".join(f'<div class="timeline-loop-item">{_h(loop_id)}</div>' for loop_id in loops_changed)
            + '</div>'
        )
    for day, commits in days.items():
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">{_h(day)}</div>')
        for c in commits:
            rows.append(
                f'<div class="commit">'
                f'<span class="c-hash">{_h(c["short"])}</span>'
                f'<span class="c-msg">{_h(c["subject"])}</span>'
                f'</div>'
            )
    body = "\n".join(rows)
    return f"""
    <div class="sh">What Changed</div>
    <details id="changes-drilldown"{" open" if continuity_active else ""}>
      <summary>Timeline <span class="det-count">{len(log)} commits</span></summary>
      <div class="det-body">{body}</div>
    </details>"""


def capability_atlas(caps_data: dict, invocation_counts: dict[str, int]) -> str:
    caps = caps_data["caps"]
    if not caps:
        return '<div class="sh">Capability Atlas</div><p style="font-size:.6rem;color:var(--t)">unavailable</p>'

    domains = sorted(set(c.get("domain", "unknown") for c in caps.values()))
    filters = ['<button class="cap-f active" onclick="filterCaps(event,\'all\')">all</button>']
    for d in domains:
        filters.append(f'<button class="cap-f" onclick="filterCaps(event,\'{_h(d)}\')">{_h(d)}</button>')

    rows = []
    for name in sorted(caps.keys()):
        c = caps[name]
        safety = c.get("safety", "unknown")
        domain = c.get("domain", "unknown")
        desc = c.get("description", "")
        inv_count = invocation_counts.get(name, 0)
        safety_cls = "cap-ro" if safety == "read-only" else "cap-mut"
        safety_label = "RO" if safety == "read-only" else "MUT"
        rows.append(
            f'<div class="cap" data-domain="{_h(domain)}">'
            f'<span class="cap-name">{_h(name)}<span class="cap-count">{inv_count}</span></span>'
            f'<span class="cap-desc">{_h(desc)}</span>'
            f'<span class="cap-tag {safety_cls}">{safety_label}</span>'
            f'</div>'
        )

    ro_count = sum(1 for c in caps.values() if c.get("safety") == "read-only")
    mut_count = len(caps) - ro_count

    return f"""
    <div class="sh">Capability Atlas</div>
    <details>
      <summary>Capabilities <span class="det-count">{len(caps)} total · {ro_count} read-only · {mut_count} mutation</span></summary>
      <div class="det-body">
        <div class="cap-filter">{"".join(filters)}</div>
        {"".join(rows)}
      </div>
    </details>"""


def gate_watch(gates: dict) -> str:
    stats = f"""
    <div class="stats" style="grid-template-columns:repeat(5,1fr)">
      <div class="stat"><div class="stat-v">{gates['total']}</div><div class="stat-l">Total</div></div>
      <div class="stat"><div class="stat-v">{gates['active']}</div><div class="stat-l">Active</div></div>
      <div class="stat"><div class="stat-v">{gates['retired']}</div><div class="stat-l">Retired</div></div>
      <div class="stat"><div class="stat-v">{gates['blocking']}</div><div class="stat-l">Blocking</div></div>
      <div class="stat"><div class="stat-v">{gates['report']}</div><div class="stat-l">Report</div></div>
    </div>"""

    core_ids = set(gates.get("core_ids", []))
    gate_map = {g["id"]: g for g in gates.get("gates", []) if "id" in g}

    core_rows = []
    for gid in sorted(core_ids):
        g = gate_map.get(gid, {})
        name = g.get("name", "unknown")
        core_rows.append(
            f'<div class="gate">'
            f'<span class="gate-id">{_h(gid)}</span>'
            f'<span class="gate-name">{_h(name)}</span>'
            f'<span class="gate-mode gate-enforce">listed</span>'
            f'</div>'
        )

    core_body = "".join(core_rows) if core_rows else '<div style="font-size:.6rem;color:var(--t)">no core gates found</div>'

    cat_counts: dict[str, int] = {}
    for g in gates.get("gates", []):
        if not g.get("retired", False):
            cat = g.get("category", "uncategorized")
            cat_counts[cat] = cat_counts.get(cat, 0) + 1

    cat_rows = []
    for cat, cnt in sorted(cat_counts.items()):
        cat_rows.append(f'<div class="attn-item"><div class="attn-dot y"></div>{_h(cat)}: {cnt} active</div>')

    return f"""
    <div class="sh">Gate Watch</div>
    {stats}
    <details>
      <summary>Core Gates <span class="det-count">{len(core_ids)} gates</span></summary>
      <div class="det-body">{core_body}</div>
    </details>
    <details>
      <summary>Category Summary <span class="det-count">{len(cat_counts)} categories</span></summary>
      <div class="det-body">{"".join(cat_rows)}</div>
    </details>"""


def authority_explorer(manifest: dict) -> str:
    if not manifest["available"]:
        return '<div class="sh">Authority Explorer</div><p style="font-size:.6rem;color:var(--t)">manifest unavailable</p>'

    surfaces = manifest["surfaces"]
    families = manifest.get("families", [])

    by_kind: dict[str, list[dict]] = {}
    for s in surfaces:
        k = s.get("surface_kind", "unknown")
        by_kind.setdefault(k, []).append(s)

    rows = []
    for kind in sorted(by_kind.keys()):
        items = by_kind[kind]
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">{_h(kind)} ({len(items)})</div>')
        for s in sorted(items, key=lambda x: x.get("surface_id", "")):
            sid = s.get("surface_id", "unknown")
            auth_cls = s.get("authority_class", "")
            source = s.get("path", "")
            purpose = ""
            knowledge = s.get("knowledge", {})
            if isinstance(knowledge, dict):
                purpose = knowledge.get("what_it_does", "")
            regen = s.get("regenerated_by", {}) or {}
            gen_surface = regen.get("command", "") or regen.get("surface_id", "") or ""

            tag_cls = "surf-auth" if auth_cls == "authoritative" else ("surf-supp" if auth_cls == "supporting" else "surf-hist")
            tag_label = auth_cls[:4].upper() if auth_cls else "\u2014"

            meta_parts = []
            if source:
                meta_parts.append(str(source))
            if gen_surface:
                meta_parts.append(f"gen: {gen_surface}")

            rows.append(
                f'<div class="surf">'
                f'<div class="surf-top">'
                f'<span class="surf-name">{_h(sid)}</span>'
                f'<span class="surf-purpose">{_h(purpose)}</span>'
                f'<span class="surf-tag {tag_cls}">{_h(tag_label)}</span>'
                f'</div>'
                f'<div class="surf-meta">{_h(" · ".join(meta_parts))}</div>'
                f'</div>'
            )

    if families:
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">workflow_families ({len(families)})</div>')
        for fam in families:
            fid = fam.get("family_id", "unknown")
            role = fam.get("container_role", "")
            home = fam.get("authority_home", "")
            notes = fam.get("notes", "")
            rows.append(
                f'<div class="surf">'
                f'<div class="surf-top">'
                f'<span class="surf-name">{_h(fid)}</span>'
                f'<span class="surf-purpose">{_h(notes or role)}</span>'
                f'<span class="surf-tag surf-supp">FAM</span>'
                f'</div>'
                f'<div class="surf-meta">{_h(home)}</div>'
                f'</div>'
            )

    body = "".join(rows)
    return f"""
    <div class="sh">Authority Explorer</div>
    <details>
      <summary>Surface Manifest <span class="det-count">{len(surfaces)} surfaces · {len(families)} families</span></summary>
      <div class="det-body">{body}</div>
    </details>"""


def work_state_section(ws: dict, active_loops: dict, active_handoffs: dict) -> str:
    items = [
        ("Loops", str(ws["open_loops"]), "open"),
        ("Gaps", str(ws["open_gaps"]), "open"),
        ("Waves", str(ws["active_waves"]), f"active · {ws['orphaned_waves']} orphaned"),
        ("Inbox", str(ws.get("inbox_lanes", {}).get("parked", 0)), f"parked · {ws.get('inbox_lanes', {}).get('done', 0)} done"),
    ]
    if ws["inbox_active"] > 0:
        items.append(("Active", str(ws["inbox_active"]), "inbox active"))

    stat_cards = ""
    for label, val, sub in items:
        stat_cards += f'<div class="stat"><div class="stat-v">{_h(val)}</div><div class="stat-l">{_h(label)}</div><div class="stat-sub">{_h(sub)}</div></div>'

    live_rows = []
    for item in (active_loops.get("items", []) or [])[:3]:
        detail = " · ".join(
            bit
            for bit in (
                item.get("status"),
                item.get("readiness"),
                item.get("horizon"),
                item.get("severity"),
            )
            if bit
        )
        live_rows.append(
            f'<div class="today-line">'
            f'<span class="today-line-k">loop</span>'
            f'<span class="today-line-v">{_h(item.get("title", item.get("id", "")))}</span>'
            f'<span class="today-line-sub">{_h(detail)}</span>'
            f'</div>'
        )

    handoff_count = int(active_handoffs.get("count", 0) or 0)
    if handoff_count:
        live_rows.append(
            f'<div class="today-line">'
            f'<span class="today-line-k">handoffs</span>'
            f'<span class="today-line-v">{handoff_count} active</span>'
            f'<span class="today-line-sub">agent asks/blockers waiting on operator</span>'
            f'</div>'
        )
    else:
        live_rows.append(
            '<div class="today-line">'
            '<span class="today-line-k">handoffs</span>'
            '<span class="today-line-v">0 active</span>'
            '<span class="today-line-sub">no agent-side asks waiting right now</span>'
            '</div>'
        )

    handoff_count = int(active_handoffs.get("count", 0) or 0)
    orphaned = int(ws.get("orphaned_waves", 0) or 0)
    summary_parts = [
        f"{int(ws['open_loops'])} loops",
        f"{int(ws['open_gaps'])} gaps",
        f"{int(ws['active_waves'])} waves",
    ]
    if orphaned:
        summary_parts.append(f"{orphaned} orphaned")
    if handoff_count:
        summary_parts.append(f"{handoff_count} handoffs")

    return f"""
    <details>
      <summary>Execution Ledger <span class="det-count">{_h(' \u00b7 '.join(summary_parts))}</span></summary>
      <div class="det-body">
        <div class="stats" style="margin-top:.5rem">{stat_cards}</div>
        <div class="today-list">{''.join(live_rows)}</div>
      </div>
    </details>"""


def release_posture(refs: dict) -> str:
    origin_parity = "in sync" if refs["local_full"] == refs["origin_full"] else "diverged"
    github_parity = "unavailable"
    if refs["github_ok"]:
        github_parity = "in sync" if refs["local_head"] == refs["github_head"] else "diverged"

    origin_dot = "g" if origin_parity == "in sync" else "y"
    github_dot = "y" if github_parity != "in sync" else "g"
    dirty_dot = "y" if refs["is_dirty"] else "g"

    return f"""
