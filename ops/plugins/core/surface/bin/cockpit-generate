#!/usr/bin/env python3
"""cockpit.generate — desktop-facing dense leaf of the operator overview.

This is a LEAF, not a root. It consumes the shared operator-overview-payload
and renders a desktop-first dense HTML cockpit with drilldown. Same truth,
same timestamps, same attention ordering as the mobile surface — different
density and interaction.

Produces a static HTML snapshot at $SPINE_STATE/domain-state/SPINE_COCKPIT.html.
No mutation, no server, no auto-refresh.

    ./bin/ops cap run cockpit.generate
"""
from __future__ import annotations

import html
import importlib.machinery
import importlib.util
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

# Import the shared payload generator (no .py extension)
_payload_path = Path(__file__).resolve().parent / "operator-overview-payload"
_loader = importlib.machinery.SourceFileLoader("operator_overview_payload", str(_payload_path))
_spec = importlib.util.spec_from_loader("operator_overview_payload", _loader)
_mod = importlib.util.module_from_spec(_spec)
_loader.exec_module(_mod)
build_payload = _mod.build_payload

RUNTIME_STATE = Path(os.environ.get("SPINE_STATE", Path.home() / "code" / ".runtime" / "spine" / "state"))
OUTPUT = RUNTIME_STATE / "domain-state" / "SPINE_COCKPIT.html"


def _h(s: str) -> str:
    return html.escape(str(s)) if s else ""


def _age_label(seconds: int | None) -> str:
    if seconds is None or seconds < 0:
        return "unknown"
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h {(seconds % 3600) // 60}m ago"
    return f"{seconds // 86400}d {(seconds % 86400) // 3600}h ago"


def _temporal_badge(state: str) -> str:
    palette = {
        "now": ("var(--grn)", "NOW"),
        "recent": ("var(--cyn)", "RECENT"),
        "stale": ("var(--red)", "STALE"),
        "parked": ("var(--prp)", "PARKED"),
        "closed": ("var(--tb)", "CLOSED"),
        "unknown": ("var(--ylw)", "UNKNOWN"),
    }
    color, label = palette.get(state, palette["unknown"])
    return (
        f'<span style="font-size:.45rem;font-weight:600;padding:.1rem .3rem;'
        f'border-radius:3px;background:rgba(42,52,68,.75);color:{color}">{label}</span>'
    )


# ---------------------------------------------------------------------------
# Section builders — consume the shared payload
# ---------------------------------------------------------------------------

def engine_posture(payload: dict) -> str:
    spine = payload["spine_now"]
    refs = payload["git_refs"]
    attention = payload["attention"]

    verify = spine["verify_status"]
    has_anomalies = spine["anomaly_count"] > 0

    if verify != "pass":
        color, label, css = "red", "Degraded", "red"
    elif has_anomalies or not refs["github_ok"] or refs["is_dirty"]:
        color, label, css = "yellow", "Mixed", "ylw"
    else:
        color, label, css = "green", "Healthy", "grn"

    reasons = []
    if verify != "pass":
        reasons.append(f"verify: {verify}")
    if has_anomalies:
        reasons.append(f"{spine['anomaly_count']} anomal{'y' if spine['anomaly_count']==1 else 'ies'}")
    if not refs["github_ok"]:
        reasons.append("github mirror diverged/unavailable")
    if refs["is_dirty"]:
        reasons.append("repo dirty")
    if not reasons:
        reasons.append("all signals nominal")

    return f"""
    <div class="posture {css}">
      <div class="p-dot"></div>
      <div>
        <div class="p-text">{_h(label)}</div>
        <div class="p-sub">{_h(' · '.join(reasons))}</div>
      </div>
    </div>"""


def freshness_card(payload: dict) -> str:
    f = payload["projection_freshness"]
    freshness = f["freshness"]
    age = f["age_seconds"]
    source = f["source"]

    if freshness == "current":
        css = "grn"
    elif freshness == "aging":
        css = "ylw"
    elif freshness == "stale":
        css = "red"
    else:
        css = "ylw"

    if age >= 0:
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age // 60}m ago"
        else:
            age_str = f"{age // 3600}h {(age % 3600) // 60}m ago"
    else:
        age_str = "unknown"

    return f"""
    <div class="posture {css}" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Projection: {_h(freshness)}</div>
        <div class="p-sub">{_h(age_str)} · source: {_h(source)}</div>
      </div>
    </div>"""


def node_role_card(roles: dict) -> str:
    local_role = roles.get("local_role") or "unknown"
    exec_target = roles.get("execution_host_target") or ""
    exec_count = roles.get("execution_host_workload_count", 0)
    local_label = local_role.replace("_", " ")

    exec_html = ""
    if exec_target:
        exec_html = (
            f'<div class="nr-row">'
            f'<div class="nr-label">execution host</div>'
            f'<div class="nr-value">{_h(exec_target)}'
            f'<span class="nr-sub">{exec_count} workload{"s" if exec_count != 1 else ""}</span>'
            f'</div></div>'
        )

    return f"""
    <div class="nr">
      <div class="nr-row">
        <div class="nr-label">this machine</div>
        <div class="nr-value">{_h(local_label)}</div>
      </div>
      {exec_html}
    </div>"""


def temporal_truth_section(payload: dict) -> str:
    temporal = payload.get("temporal_truth", {})
    verify = temporal.get("verify", {}) if isinstance(temporal, dict) else {}
    comms = temporal.get("comms_queue", {}) if isinstance(temporal, dict) else {}
    daemons = temporal.get("daemons", {}) if isinstance(temporal, dict) else {}
    cards: list[str] = []

    verify_class = str(verify.get("temporal_class") or "")
    if verify_class:
        verify_css = "ylw" if verify_class == "inherited_still_current" else ("grn" if verify.get("status") == "pass" else "red")
        gates = list(verify.get("current_blocking_fail_ids") or [])
        gate_text = ", ".join(gates[:4])
        if len(gates) > 4:
            gate_text += ", ..."
        verify_bits = [verify_class]
        if verify.get("known_since_utc"):
            verify_bits.append(f"since {verify['known_since_utc']}")
        standing = int(verify.get("standing_evidence_count", 0) or 0)
        if standing:
            verify_bits.append(f"{standing} corroborating receipt(s)")
        if gate_text:
            verify_bits.append(gate_text)
        cards.append(
            f"""
    <div class="posture {verify_css}" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Verify Standing</div>
        <div class="p-sub">{_h(' · '.join(verify_bits))}</div>
      </div>
    </div>"""
        )

    comms_class = str(comms.get("temporal_class") or "")
    if comms_class:
        evidence = comms.get("evidence", {}) if isinstance(comms.get("evidence"), dict) else {}
        comms_bits = [
            comms_class,
            f"pending={int(evidence.get('pending', 0) or 0)}",
            f"oldest={int(evidence.get('oldest_age_seconds', 0) or 0)}s",
        ]
        if comms.get("operator_treatment"):
            comms_bits.append(str(comms.get("operator_treatment")))
        cards.append(
            f"""
    <div class="posture grn" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Comms Queue Side Surface</div>
        <div class="p-sub">{_h(' · '.join(comms_bits))}</div>
      </div>
    </div>"""
        )

    daemon_class = str(daemons.get("temporal_class") or "")
    if daemon_class:
        evidence = daemons.get("evidence", {}) if isinstance(daemons.get("evidence"), dict) else {}
        daemon_bits = [
            daemon_class,
            f"non_local={int(evidence.get('non_local_deferred', 0) or 0)}",
            f"elsewhere={int(evidence.get('active_elsewhere', 0) or 0)}",
            f"parked={int(evidence.get('parked_required', 0) or 0)}",
            f"exempt={int(evidence.get('locality_exempt', 0) or 0)}",
        ]
        if daemons.get("operator_treatment"):
            daemon_bits.append(str(daemons.get("operator_treatment")))
        cards.append(
            f"""
    <div class="posture grn" style="padding:.6rem .9rem;margin-bottom:.25rem">
      <div class="p-dot"></div>
      <div>
        <div class="p-text" style="font-size:.65rem">Daemon Locality</div>
        <div class="p-sub">{_h(' · '.join(daemon_bits))}</div>
      </div>
    </div>"""
        )

    return "".join(cards)


def execution_host_section(roles: dict) -> str:
    exec_target = roles.get("execution_host_target") or ""
    if not exec_target:
        return ""

    exec_count = roles.get("execution_host_workload_count", 0)
    exec_labels = roles.get("execution_host_workload_labels", [])
    exec_access = roles.get("execution_host_access") or ""
    exec_purposes = roles.get("execution_host_workload_purposes", {})
    non_local = roles.get("non_local_deferred", [])
    breakdown = roles.get("non_local_breakdown", {}) or {}
    parked = breakdown.get("parked_required", []) if isinstance(breakdown, dict) else []
    locality_exempt = breakdown.get("locality_exempt", []) if isinstance(breakdown, dict) else []
    active_elsewhere = breakdown.get("active_elsewhere", []) if isinstance(breakdown, dict) else non_local

    workload_rows = ""
    for lbl in sorted(exec_labels):
        short = lbl.replace("com.ronny.", "")
        purpose = exec_purposes.get(lbl, "")
        purpose_html = f'<div class="eh-purpose">{_h(purpose)}</div>' if purpose else ""
        workload_rows += f'<div class="eh-lbl">{_h(short)}{purpose_html}</div>'

    other_rows = ""
    if active_elsewhere:
        for lbl in sorted(active_elsewhere):
            short = lbl.replace("com.ronny.", "")
            other_rows += f'<div class="eh-lbl eh-other">{_h(short)}</div>'
        other_rows = (
            f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;'
            f'border-top:1px solid var(--b);margin-top:.25rem">active elsewhere ({len(active_elsewhere)})</div>'
            + other_rows
        )
    if parked:
        parked_rows = ""
        for lbl in sorted(parked):
            short = lbl.replace("com.ronny.", "")
            parked_rows += f'<div class="eh-lbl eh-other">{_h(short)}</div>'
        other_rows += (
            f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;'
            f'border-top:1px solid var(--b);margin-top:.25rem">parked required ({len(parked)})</div>'
            + parked_rows
        )
    if locality_exempt:
        exempt_rows = ""
        for lbl in sorted(locality_exempt):
            short = lbl.replace("com.ronny.", "")
            exempt_rows += f'<div class="eh-lbl eh-other">{_h(short)}</div>'
        other_rows += (
            f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;'
            f'border-top:1px solid var(--b);margin-top:.25rem">locality exempt ({len(locality_exempt)})</div>'
            + exempt_rows
        )

    access_line = f'<div class="eh-access">{_h(exec_access)}</div>' if exec_access else ""
    detail_bits = [f"{exec_count} workloads"]
    if active_elsewhere:
        detail_bits.append(f"{len(active_elsewhere)} elsewhere")
    if parked:
        detail_bits.append(f"{len(parked)} parked")
    if locality_exempt:
        detail_bits.append(f"{len(locality_exempt)} locality-exempt")
    detail_summary = " · ".join(detail_bits)

    return f"""
    <div class="sh">Execution Host</div>
    <details>
      <summary>{_h(exec_target)} <span class="det-count">{_h(detail_summary)}</span></summary>
      <div class="det-body">
        {access_line}
        {workload_rows}
        {other_rows}
      </div>
    </details>"""


def comms_incident_card(cq: dict) -> str:
    slo = cq.get("slo_status", "ok")
    pending = int(cq.get("pending", 0) or 0)
    oldest = int(cq.get("oldest_age_seconds", 0) or 0)
    escalations = int(cq.get("escalations", 0) or 0)
    if slo == "ok" or (pending == 0 and oldest == 0 and escalations == 0):
        return ""

    drain_state = cq.get("drain_state", "unknown")

    if oldest >= 86400:
        age_str = f"{oldest // 86400}d {(oldest % 86400) // 3600}h"
    elif oldest >= 3600:
        age_str = f"{oldest // 3600}h {(oldest % 3600) // 60}m"
    else:
        age_str = f"{oldest // 60}m"

    state_css = "ylw" if drain_state == "draining" else "red"
    state_label = drain_state if drain_state in ("draining", "blocked") else "unknown"

    return f"""
    <div class="cq cq-{state_css}">
      <div class="cq-head">
        <span class="cq-title">Comms Queue</span>
        <span class="cq-state cq-s-{state_css}">{_h(slo)} · {_h(state_label)}</span>
      </div>
      <div class="cq-evidence">{pending} pending · oldest {_h(age_str)}</div>
    </div>"""


def attention_section(attention: list[dict]) -> str:
    if not attention:
        return ""
    rows = []
    for item in attention:
        color = "r" if item.get("priority") == "high" else "y"
        text = item.get("summary", "")
        rows.append(f'<div class="attn-item"><div class="attn-dot {color}"></div>{_h(text)}</div>')
    return f'<div class="attn">{"".join(rows)}</div>'


def timeline_section(log: list[dict]) -> str:
    if not log:
        return '<div class="sh">Recent Timeline</div><p style="font-size:.6rem;color:var(--t)">unavailable</p>'
    days: dict[str, list[dict]] = {}
    for entry in log:
        d = entry["date"]
        days.setdefault(d, []).append(entry)

    rows = []
    for day, commits in days.items():
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">{_h(day)}</div>')
        for c in commits:
            rows.append(
                f'<div class="commit">'
                f'<span class="c-hash">{_h(c["short"])}</span>'
                f'<span class="c-msg">{_h(c["subject"])}</span>'
                f'</div>'
            )
    body = "\n".join(rows)
    return f"""
    <div class="sh">Recent Timeline</div>
    <details>
      <summary>Git History <span class="det-count">{len(log)} commits</span></summary>
      <div class="det-body">{body}</div>
    </details>"""


def capability_atlas(caps_data: dict, invocation_counts: dict[str, int]) -> str:
    caps = caps_data["caps"]
    if not caps:
        return '<div class="sh">Capability Atlas</div><p style="font-size:.6rem;color:var(--t)">unavailable</p>'

    domains = sorted(set(c.get("domain", "unknown") for c in caps.values()))
    filters = ['<button class="cap-f active" onclick="filterCaps(event,\'all\')">all</button>']
    for d in domains:
        filters.append(f'<button class="cap-f" onclick="filterCaps(event,\'{_h(d)}\')">{_h(d)}</button>')

    rows = []
    for name in sorted(caps.keys()):
        c = caps[name]
        safety = c.get("safety", "unknown")
        domain = c.get("domain", "unknown")
        desc = c.get("description", "")
        inv_count = invocation_counts.get(name, 0)
        safety_cls = "cap-ro" if safety == "read-only" else "cap-mut"
        safety_label = "RO" if safety == "read-only" else "MUT"
        rows.append(
            f'<div class="cap" data-domain="{_h(domain)}">'
            f'<span class="cap-name">{_h(name)}<span class="cap-count">{inv_count}</span></span>'
            f'<span class="cap-desc">{_h(desc)}</span>'
            f'<span class="cap-tag {safety_cls}">{safety_label}</span>'
            f'</div>'
        )

    ro_count = sum(1 for c in caps.values() if c.get("safety") == "read-only")
    mut_count = len(caps) - ro_count

    return f"""
    <div class="sh">Capability Atlas</div>
    <details>
      <summary>Capabilities <span class="det-count">{len(caps)} total · {ro_count} read-only · {mut_count} mutation</span></summary>
      <div class="det-body">
        <div class="cap-filter">{"".join(filters)}</div>
        {"".join(rows)}
      </div>
    </details>"""


def gate_watch(gates: dict) -> str:
    stats = f"""
    <div class="stats" style="grid-template-columns:repeat(5,1fr)">
      <div class="stat"><div class="stat-v">{gates['total']}</div><div class="stat-l">Total</div></div>
      <div class="stat"><div class="stat-v">{gates['active']}</div><div class="stat-l">Active</div></div>
      <div class="stat"><div class="stat-v">{gates['retired']}</div><div class="stat-l">Retired</div></div>
      <div class="stat"><div class="stat-v">{gates['blocking']}</div><div class="stat-l">Blocking</div></div>
      <div class="stat"><div class="stat-v">{gates['report']}</div><div class="stat-l">Report</div></div>
    </div>"""

    core_ids = set(gates.get("core_ids", []))
    gate_map = {g["id"]: g for g in gates.get("gates", []) if "id" in g}

    core_rows = []
    for gid in sorted(core_ids):
        g = gate_map.get(gid, {})
        name = g.get("name", "unknown")
        core_rows.append(
            f'<div class="gate">'
            f'<span class="gate-id">{_h(gid)}</span>'
            f'<span class="gate-name">{_h(name)}</span>'
            f'<span class="gate-mode gate-enforce">listed</span>'
            f'</div>'
        )

    core_body = "".join(core_rows) if core_rows else '<div style="font-size:.6rem;color:var(--t)">no core gates found</div>'

    cat_counts: dict[str, int] = {}
    for g in gates.get("gates", []):
        if not g.get("retired", False):
            cat = g.get("category", "uncategorized")
            cat_counts[cat] = cat_counts.get(cat, 0) + 1

    cat_rows = []
    for cat, cnt in sorted(cat_counts.items()):
        cat_rows.append(f'<div class="attn-item"><div class="attn-dot y"></div>{_h(cat)}: {cnt} active</div>')

    return f"""
    <div class="sh">Gate Watch</div>
    {stats}
    <details>
      <summary>Core Gates <span class="det-count">{len(core_ids)} gates</span></summary>
      <div class="det-body">{core_body}</div>
    </details>
    <details>
      <summary>Category Summary <span class="det-count">{len(cat_counts)} categories</span></summary>
      <div class="det-body">{"".join(cat_rows)}</div>
    </details>"""


def authority_explorer(manifest: dict) -> str:
    if not manifest["available"]:
        return '<div class="sh">Authority Explorer</div><p style="font-size:.6rem;color:var(--t)">manifest unavailable</p>'

    surfaces = manifest["surfaces"]
    families = manifest.get("families", [])

    by_kind: dict[str, list[dict]] = {}
    for s in surfaces:
        k = s.get("surface_kind", "unknown")
        by_kind.setdefault(k, []).append(s)

    rows = []
    for kind in sorted(by_kind.keys()):
        items = by_kind[kind]
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">{_h(kind)} ({len(items)})</div>')
        for s in sorted(items, key=lambda x: x.get("surface_id", "")):
            sid = s.get("surface_id", "unknown")
            auth_cls = s.get("authority_class", "")
            source = s.get("path", "")
            purpose = ""
            knowledge = s.get("knowledge", {})
            if isinstance(knowledge, dict):
                purpose = knowledge.get("what_it_does", "")
            regen = s.get("regenerated_by", {}) or {}
            gen_surface = regen.get("command", "") or regen.get("surface_id", "") or ""

            tag_cls = "surf-auth" if auth_cls == "authoritative" else ("surf-supp" if auth_cls == "supporting" else "surf-hist")
            tag_label = auth_cls[:4].upper() if auth_cls else "\u2014"

            meta_parts = []
            if source:
                meta_parts.append(str(source))
            if gen_surface:
                meta_parts.append(f"gen: {gen_surface}")

            rows.append(
                f'<div class="surf">'
                f'<div class="surf-top">'
                f'<span class="surf-name">{_h(sid)}</span>'
                f'<span class="surf-purpose">{_h(purpose)}</span>'
                f'<span class="surf-tag {tag_cls}">{_h(tag_label)}</span>'
                f'</div>'
                f'<div class="surf-meta">{_h(" · ".join(meta_parts))}</div>'
                f'</div>'
            )

    if families:
        rows.append(f'<div style="padding:.35rem 0 .15rem;font-size:.5rem;font-weight:600;color:var(--t);opacity:.5;border-top:1px solid var(--b);margin-top:.25rem">workflow_families ({len(families)})</div>')
        for fam in families:
            fid = fam.get("family_id", "unknown")
            role = fam.get("container_role", "")
            home = fam.get("authority_home", "")
            notes = fam.get("notes", "")
            rows.append(
                f'<div class="surf">'
                f'<div class="surf-top">'
                f'<span class="surf-name">{_h(fid)}</span>'
                f'<span class="surf-purpose">{_h(notes or role)}</span>'
                f'<span class="surf-tag surf-supp">FAM</span>'
                f'</div>'
                f'<div class="surf-meta">{_h(home)}</div>'
                f'</div>'
            )

    body = "".join(rows)
    return f"""
    <div class="sh">Authority Explorer</div>
    <details>
      <summary>Surface Manifest <span class="det-count">{len(surfaces)} surfaces · {len(families)} families</span></summary>
      <div class="det-body">{body}</div>
    </details>"""


def work_state_section(ws: dict) -> str:
    items = [
        ("Loops", str(ws["open_loops"]), "open"),
        ("Gaps", str(ws["open_gaps"]), "open"),
        ("Waves", str(ws["active_waves"]), f"active · {ws['orphaned_waves']} orphaned"),
        ("Inbox", str(ws.get("inbox_lanes", {}).get("parked", 0)), f"parked · {ws.get('inbox_lanes', {}).get('done', 0)} done"),
    ]
    if ws["inbox_active"] > 0:
        items.append(("Active", str(ws["inbox_active"]), "inbox active"))

    stat_cards = ""
    for label, val, sub in items:
        stat_cards += f'<div class="stat"><div class="stat-v">{_h(val)}</div><div class="stat-l">{_h(label)}</div><div class="stat-sub">{_h(sub)}</div></div>'

    return f"""
    <div class="sh">Work State</div>
    <div class="stats">{stat_cards}</div>"""


def release_posture(refs: dict) -> str:
    origin_parity = "in sync" if refs["local_full"] == refs["origin_full"] else "diverged"
    github_parity = "unavailable"
    if refs["github_ok"]:
        github_parity = "in sync" if refs["local_head"] == refs["github_head"] else "diverged"

    origin_dot = "g" if origin_parity == "in sync" else "y"
    github_dot = "y" if github_parity != "in sync" else "g"
    dirty_dot = "y" if refs["is_dirty"] else "g"

    return f"""
    <div class="sh">Release Posture</div>
    <div class="rel">
      <div class="rel-c"><div class="rel-l">Local HEAD</div><div class="rel-v" style="font-size:.55rem">{_h(refs['local_head'])}</div></div>
      <div class="rel-c"><div class="rel-l">Origin</div><div class="rel-v"><span class="sdot {origin_dot}"></span>{_h(origin_parity)}</div></div>
      <div class="rel-c"><div class="rel-l">GitHub</div><div class="rel-v"><span class="sdot {github_dot}"></span>{_h(github_parity)}</div></div>
      <div class="rel-c"><div class="rel-l">Tree</div><div class="rel-v"><span class="sdot {dirty_dot}"></span>{"dirty" if refs["is_dirty"] else "clean"}</div></div>
    </div>
    <div style="font-size:.5rem;color:var(--t);opacity:.4">Commits: {_h(refs['commit_count'])} · Baseline: {_h(refs['baseline'])} (from AGENTS.md)</div>"""


