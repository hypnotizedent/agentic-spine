#!/usr/bin/env python3
"""operator-surface-status — read-only cockpit service route probe."""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from urllib import error, request
from urllib.parse import urljoin


DEFAULT_URL = os.environ.get("OPERATOR_COCKPIT_URL", "http://100.71.17.29:8900/")
DEFAULT_PATHS = ("/", "/submit", "/ingress", "/payload.json", "/mobile.json")


def probe_url(base_url: str, paths: list[str], timeout: float) -> list[dict[str, object]]:
    results: list[dict[str, object]] = []
    for path in paths:
        url = urljoin(base_url.rstrip("/") + "/", path.lstrip("/"))
        result: dict[str, object] = {
            "path": path,
            "url": url,
            "ok": False,
        }
        try:
            with request.urlopen(url, timeout=timeout) as response:
                status = int(response.status)
                result.update(
                    {
                        "status": status,
                        "content_type": str(response.headers.get("Content-Type", "")),
                        "ok": status == 200,
                    }
                )
        except error.HTTPError as exc:
            result.update({"status": int(exc.code), "error": str(exc)})
        except Exception as exc:
            result.update({"error": str(exc)})
        results.append(result)
    return results


def remote_systemd(host: str, units: list[str]) -> dict[str, object]:
    if not host:
        return {"checked": False, "reason": "no systemd host supplied"}

    cmd = ["ssh", host, "systemctl", "--user", "is-active", *units]
    proc = subprocess.run(cmd, text=True, capture_output=True, check=False)
    states = (proc.stdout or "").strip().splitlines()
    return {
        "checked": True,
        "host": host,
        "ok": proc.returncode == 0,
        "units": dict(zip(units, states)),
        "stderr": (proc.stderr or "").strip(),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Probe the operator surface server routes")
    parser.add_argument("--url", default=DEFAULT_URL)
    parser.add_argument("--path", action="append", dest="paths")
    parser.add_argument("--timeout", type=float, default=5.0)
    parser.add_argument("--systemd-host", default="")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    paths = args.paths or list(DEFAULT_PATHS)
    route_results = probe_url(args.url, paths, args.timeout)
    routes_ok = all(bool(item.get("ok")) for item in route_results)
    systemd = remote_systemd(
        args.systemd_host,
        [
            "com.ronny.operator-surface-server.service",
            "com.ronny.operator-surface-watchdog.timer",
        ],
    )
    systemd_ok = bool(systemd.get("ok", True)) if systemd.get("checked") else True
    ok = routes_ok and systemd_ok

    payload = {
        "capability": "surface.operator.status",
        "url": args.url,
        "ok": ok,
        "routes": route_results,
        "systemd": systemd,
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("operator-surface.status")
        print(f"url: {args.url}")
        for item in route_results:
            status = item.get("status", "ERR")
            state = "PASS" if item.get("ok") else "FAIL"
            detail = item.get("content_type") or item.get("error") or ""
            print(f"route: {item['path']} {state} {status} {detail}".rstrip())
        if systemd.get("checked"):
            print(f"systemd_host: {systemd.get('host')}")
            for unit, state in dict(systemd.get("units", {})).items():
                print(f"systemd: {unit}={state}")
        print(f"status: {'PASS' if ok else 'FAIL'}")

    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
