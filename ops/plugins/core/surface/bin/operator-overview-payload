)
SURFACE_OUTPUT_DIR = STATE_ROOT / "operator-surface"
COCKPIT_CONTRACT = REPO / "ops" / "bindings" / "operator.cockpit.contract.yaml"

TEMPORAL_NOW_SECONDS = 6 * 60 * 60
TEMPORAL_RECENT_SECONDS = 72 * 60 * 60
TEMPORAL_REVIEW_SOON_SECONDS = 7 * 24 * 60 * 60
_YAML_FENCE = re.compile(r"```ya?ml\s*\n(.*?)```", re.DOTALL | re.IGNORECASE)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _run(cmd: list[str]) -> tuple[str, bool]:
    try:
        proc = subprocess.run(
            cmd, text=True, capture_output=True, check=False,
            cwd=str(REPO), timeout=30,
        )
        return proc.stdout.strip(), proc.returncode == 0
    except Exception as e:
        return str(e), False


def _run_json(cmd: list[str]) -> dict:
    out, ok = _run(cmd)
    if not ok:
        return {"status": "fail", "error": out}
    try:
        return json.loads(out) if out else {"status": "fail", "error": "empty output"}
    except Exception:
        return {"status": "fail", "stdout": out}


def _read_scope_frontmatter(path: str | Path) -> dict:
    """Parse YAML frontmatter from a loop scope file."""
    try:
        text = Path(path).read_text()
    except Exception:
        return {}
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end < 0:
        return {}
    data: dict[str, str] = {}
    for raw in text[3:end].strip().splitlines():
        if ":" not in raw:
            continue
        key, value = raw.split(":", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def _load_previous_operator_payload() -> dict:
    path = SURFACE_OUTPUT_DIR / "payload.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


