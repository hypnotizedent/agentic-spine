#!/usr/bin/env python3
"""operator-overview-payload — shared root for all operator read surfaces.

One compiled operator-state payload. Both the desktop cockpit and the mobile
supervision surface consume this as their single source of truth.

Same roots, same truth, same timestamps, same attention ordering.
Different density and interaction happen downstream in the leaves.

Usage:
    python3 operator-overview-payload              # full JSON to stdout
    python3 operator-overview-payload --compact    # phone-priority subset
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path


REPO = Path(__file__).resolve().parents[5]
STATE_ROOT = Path(
    os.environ.get(
        "SPINE_STATE",
        str(Path.home() / "code" / ".runtime" / "spine" / "state"),
    )
)
EVIDENCE_ROOT = Path(
    os.environ.get(
        "SPINE_EVIDENCE_ROOT",
        str(Path.home() / "code" / ".evidence" / "spine"),
    )
)

TEMPORAL_NOW_SECONDS = 6 * 60 * 60
TEMPORAL_RECENT_SECONDS = 72 * 60 * 60
TEMPORAL_REVIEW_SOON_SECONDS = 7 * 24 * 60 * 60
_YAML_FENCE = re.compile(r"```ya?ml\s*\n(.*?)```", re.DOTALL | re.IGNORECASE)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _run(cmd: list[str]) -> tuple[str, bool]:
    try:
        proc = subprocess.run(
            cmd, text=True, capture_output=True, check=False,
            cwd=str(REPO), timeout=30,
        )
        return proc.stdout.strip(), proc.returncode == 0
    except Exception as e:
        return str(e), False


def _run_json(cmd: list[str]) -> dict:
    out, ok = _run(cmd)
    if not ok:
        return {"status": "fail", "error": out}
    try:
        return json.loads(out) if out else {"status": "fail", "error": "empty output"}
    except Exception:
        return {"status": "fail", "stdout": out}


def _read_scope_frontmatter(path: str | Path) -> dict:
    """Parse YAML frontmatter from a loop scope file."""
    try:
        text = Path(path).read_text()
    except Exception:
        return {}
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end < 0:
        return {}
    try:
        import yaml
        return yaml.safe_load(text[3:end]) or {}
    except Exception:
        return {}


def _yaml_load(path: Path) -> dict | list | None:
    try:
        import yaml
        with open(path) as f:
            return yaml.safe_load(f)
    except Exception:
        return None


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _parse_utc(value: object) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except Exception:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    else:
        parsed = parsed.astimezone(timezone.utc)
    return parsed


def _seconds_since(value: object, now_dt: datetime) -> int | None:
    parsed = _parse_utc(value)
    if parsed is None:
        return None
    return int((now_dt - parsed).total_seconds())


def _seconds_until(value: object, now_dt: datetime) -> int | None:
    parsed = _parse_utc(value)
    if parsed is None:
        return None
    return int((parsed - now_dt).total_seconds())


def classify_temporal_age(age_seconds: int | None) -> str:
    if age_seconds is None or age_seconds < 0:
        return "unknown"
    if age_seconds < TEMPORAL_NOW_SECONDS:
        return "now"
    if age_seconds < TEMPORAL_RECENT_SECONDS:
        return "recent"
    return "stale"


def classify_due_window(seconds_until: int | None) -> str:
    if seconds_until is None:
        return "unknown"
    if seconds_until < 0:
        return "stale"
    if seconds_until < 24 * 60 * 60:
        return "now"
    if seconds_until < TEMPORAL_REVIEW_SOON_SECONDS:
        return "recent"
    return "recent"


def summarize_temporal_states(items: list[dict], field: str = "temporal_state") -> dict[str, int]:
    summary = {"now": 0, "recent": 0, "stale": 0, "parked": 0, "closed": 0, "unknown": 0}
    for item in items:
        state = str(item.get(field, "unknown") or "unknown")
        if state not in summary:
            state = "unknown"
        summary[state] += 1
    return summary


# ---------------------------------------------------------------------------
# Shared root sections
# ---------------------------------------------------------------------------

def classify_freshness(age_seconds: float) -> str:
    if age_seconds < 0:
        return "unknown"
    if age_seconds < 300:
        return "current"
    if age_seconds < 1800:
        return "aging"
    return "stale"


def collect_projection_freshness() -> dict:
    now = time.time()
    db_path = STATE_ROOT / "shared_authority.db"
    sync_marker = STATE_ROOT / ".last_sync_utc"

    result: dict = {
        "source": "unknown",
        "age_seconds": -1,
        "freshness": "unknown",
        "sync_marker_utc": None,
        "state_db_mtime_utc": None,
    }

    if sync_marker.is_file():
        try:
            marker_text = sync_marker.read_text().strip()
            result["sync_marker_utc"] = marker_text
            marker_dt = datetime.fromisoformat(marker_text.replace("Z", "+00:00"))
            age = now - marker_dt.timestamp()
            result["age_seconds"] = int(age)
            result["freshness"] = classify_freshness(age)
            result["source"] = "sync_marker"
        except Exception:
            pass

    if db_path.is_file():
        try:
            mtime = db_path.stat().st_mtime
            mtime_utc = datetime.fromtimestamp(mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            result["state_db_mtime_utc"] = mtime_utc
            if result["source"] == "unknown":
                age = now - mtime
                result["age_seconds"] = int(age)
                result["freshness"] = classify_freshness(age)
                result["source"] = "db_mtime"
        except Exception:
            pass

    freshness_map = {
        "current": "now",
        "aging": "recent",
        "stale": "stale",
    }
    result["temporal_state"] = freshness_map.get(result["freshness"], "unknown")
    return result


def collect_spine_now(status: dict) -> dict:
    counts = status.get("counts", {})
    temporal_verify = (
        status.get("temporal_truth", {}).get("verify", {})
        if isinstance(status.get("temporal_truth"), dict)
        else {}
    )
    verify_status_raw = counts.get("verify_status", "unknown")
    verify_temporal_class = str(temporal_verify.get("temporal_class", "") or "")
    return {
        "verify_status": verify_status_raw,
        "verify_status_raw": verify_status_raw,
        "verify_temporal_class": verify_temporal_class,
        "anomaly_count": counts.get("anomalies", 0),
        "open_loop_count": counts.get("open_loops", 0),
        "open_gap_count": counts.get("open_gaps", 0),
        "active_wave_count": counts.get("active_waves", 0),
        "orphaned_wave_count": counts.get("orphaned_waves", 0),
        "coherence_ok": not counts.get("coherence_attention", False),
    }


def collect_temporal_truth(status: dict) -> dict:
    temporal = status.get("temporal_truth", {})
    if not isinstance(temporal, dict):
        temporal = {}
    return {
        "verify": temporal.get("verify", {}) if isinstance(temporal.get("verify"), dict) else {},
        "comms_queue": temporal.get("comms_queue", {}) if isinstance(temporal.get("comms_queue"), dict) else {},
        "daemons": temporal.get("daemons", {}) if isinstance(temporal.get("daemons"), dict) else {},
    }


def collect_attention(status: dict, refs: dict) -> list[dict]:
    items: list[dict] = []

    for anomaly in status.get("anomalies", []):
        text = str(anomaly) if isinstance(anomaly, str) else anomaly.get("message", str(anomaly))
        items.append({"type": "anomaly", "summary": text, "priority": "high"})

    for gap in status.get("open_gaps", []):
        items.append({
            "type": "gap",
            "id": gap.get("gap_id", ""),
            "summary": gap.get("description", ""),
            "priority": gap.get("severity", "medium"),
        })

    for loop in status.get("open_loops", []):
        if loop.get("blocked_by"):
            items.append({
                "type": "blocked_loop",
                "id": loop.get("loop_id", ""),
                "summary": f"Blocked: {loop.get('blocked_by', '')}",
                "priority": "high",
            })

    counts = status.get("counts", {})
    if counts.get("orphaned_waves", 0) > 0:
        items.append({
            "type": "orphaned_waves",
            "summary": f"{counts['orphaned_waves']} orphaned wave(s)",
            "priority": "medium",
        })

    if not refs.get("github_ok", True):
        items.append({"type": "mirror_diverged", "summary": "GitHub mirror diverged/unavailable", "priority": "low"})

    if refs.get("is_dirty", False):
        items.append({"type": "repo_dirty", "summary": "Repo has uncommitted changes", "priority": "low"})

    return items[:10]


def collect_active_loops(status: dict) -> dict:
    open_loops = status.get("open_loops", [])
    items = []
    for loop in open_loops[:10]:
        scope_file = loop.get("file", "")
        front = _read_scope_frontmatter(scope_file) if scope_file else {}
        items.append({
            "id": loop.get("loop_id", ""),
            "title": loop.get("title", "")[:120],
            "status": loop.get("status", ""),
            "horizon": loop.get("horizon", ""),
            "readiness": loop.get("execution_readiness", ""),
            "severity": loop.get("severity", ""),
            "owner": loop.get("owner", ""),
            "execution_mode": loop.get("execution_mode", ""),
            "blocked_by": loop.get("blocked_by", ""),
            "operator_note": loop.get("operator_note", ""),
            "last_heartbeat_utc": loop.get("last_heartbeat_utc", ""),
            "next_action": str(front.get("next_action") or "").strip(),
            "file": scope_file,
        })
    # Focus selection deferred until posture is available (see build_payload).
    return {
        "count": len(open_loops),
        "items": items,
    }


def _select_focus(loops: list[dict], router_primary_id: str = "") -> dict:
    """Deterministic focus selector — pick today's primary loop.

    When the router provides a primary loop ID (from compute_routing),
    that loop is used as the canonical focus. This ensures the cockpit
    and a fresh session.v3.attach always agree on which loop is primary.

    When no router result is available, falls back to local severity
    ranking as a best-effort approximation.
    """
    if not loops:
        return {"primary": None, "secondary": [], "why": ["no open loops"],
                "why_human": "No open loops", "confidence": "none"}

    primary = None
    if router_primary_id:
        primary = next((l for l in loops if l.get("id") == router_primary_id), None)

    if primary is None:
        # Fallback: local sort by severity then alphabetical id.
        _prio = {"critical": 0, "high": 1, "medium": 2, "low": 3}
        scored = sorted(loops, key=lambda l: (_prio.get(l.get("severity", ""), 99), l.get("id", "")))
        primary = scored[0]

    primary_id = primary.get("id", "")
    secondary = [l for l in loops if l.get("id") != primary_id]

    # Build human-readable why fragments (descriptive only)
    why_parts: list[str] = []
    if router_primary_id:
        why_parts.append("router primary")
    if primary.get("blocked_by"):
        why_parts.append(f"blocked by {primary['blocked_by']}")
    if primary.get("readiness") == "runnable":
        why_parts.append("Runnable now")
    elif primary.get("readiness") == "ready":
        why_parts.append("Ready")
    if primary.get("severity") and primary["severity"] != "-":
        why_parts.append(f"{primary['severity']} severity")
    if primary.get("owner") == "@ronny":
        why_parts.append("assigned to you")
    if len(loops) > 1:
        why_parts.append(f"outranks {len(loops) - 1} other loop{'s' if len(loops) > 2 else ''}")
    if not why_parts:
        why_parts.append("only open loop" if len(loops) == 1 else "highest ranked")

    confidence = "high" if router_primary_id else ("medium" if len(loops) == 1 else "low")

    return {
        "primary": primary_id,
        "secondary": [l["id"] for l in secondary],
        "why": why_parts,
        "why_human": " \u00b7 ".join(why_parts),
        "confidence": confidence,
    }


def collect_current_posture() -> dict:
    """Derive what a fresh session attach would resolve to right now."""
    try:
        import sys as _sys
        router_lib = REPO / "ops" / "plugins" / "core" / "lifecycle" / "lib"
        router_path = router_lib / "post_attach_router.py"
        if str(router_lib) not in _sys.path:
            _sys.path.insert(0, str(router_lib))
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("post_attach_router", str(router_path))
        spec = importlib.util.spec_from_loader("post_attach_router", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        # Use SPINE_RUNTIME_ROOT if set, else derive from SPINE_STATE.
        # The canonical contract (runtime-paths.sh) puts state at
        # $runtime_root/state, but SPINE_STATE can be overridden
        # independently, so we strip a trailing /state component if
        # present and fall back to the parent directory otherwise.
        runtime_root = os.environ.get("SPINE_RUNTIME_ROOT", "").strip()
        if not runtime_root:
            state_path = Path(os.environ.get("SPINE_STATE", "").strip()) if os.environ.get("SPINE_STATE") else STATE_ROOT
            if state_path.name == "state":
                runtime_root = str(state_path.parent)
            else:
                # SPINE_STATE points somewhere non-standard; runtime_root
                # is one level up (best-effort when contract diverges).
                runtime_root = str(state_path.parent)
        if not runtime_root:
            return {"available": False}
        result = mod.compute_routing(
            runtime_root=runtime_root,
            state_root=str(STATE_ROOT),
        )
        return {
            "available": True,
            "routing_state": str(result.get("routing_state", "")),
            "recommended_action": str(result.get("recommended_next_action", "")),
            "recommended_command": str(result.get("recommended_command") or ""),
            "container": str(result.get("recommended_container", "")),
            "why": str(result.get("why", "")),
        }
    except Exception:
        return {"available": False}


def collect_aperture_summary() -> dict:
    """Read the current aperture from AGENTS.md."""
    agents_path = REPO / "AGENTS.md"
    try:
        text = agents_path.read_text()
    except Exception:
        return {"available": False}
    # Extract aperture name
    name = ""
    import re as _re
    m = _re.search(r"in `([^`]+)` *\n*aperture", text)
    if m:
        name = m.group(1)
    # Extract legal/illegal work summaries (join continuation lines)
    legal: list[str] = []
    illegal: list[str] = []
    in_legal = False
    in_illegal = False
    for line in text.splitlines():
        if line.startswith("Legal work"):
            in_legal = True
            in_illegal = False
            continue
        if line.startswith("Illegal work"):
            in_illegal = True
            in_legal = False
            continue
        if line.startswith("#") or (line.strip() and not line.startswith("-") and not line.startswith(" ")):
            in_legal = False
            in_illegal = False
            continue
        if not line.strip():
            continue
        target = legal if in_legal else (illegal if in_illegal else None)
        if target is None:
            continue
        if line.startswith("- "):
            target.append(line.strip().lstrip("- ").strip())
        elif target and (line.startswith("  ") or line.startswith("\t")):
            target[-1] = target[-1] + " " + line.strip()
        else:
            target.append(line.strip())
    return {
        "available": True,
        "name": name,
        "legal": legal[:6],
        "illegal": illegal[:6],
    }


def collect_active_handoffs() -> dict:
    handoff_dir = STATE_ROOT / "handoffs"
    if not handoff_dir.is_dir():
        return {"count": 0, "items": []}
    items = []
    for path in sorted(handoff_dir.glob("HO-*.yaml")):
        data = _yaml_load(path)
        if not isinstance(data, dict):
            continue
        if str(data.get("state", "")).lower() != "active":
            continue
        items.append(
            {
                "id": data.get("id", path.stem),
                "state": data.get("state", ""),
                "summary": str(data.get("summary", ""))[:120],
                "loops": data.get("loops", []),
                "created_at_utc": str(data.get("created_at_utc", "")),
                "expires_at_utc": str(data.get("expires_at_utc", "")),
                "from_role": str(data.get("from_role", "")),
                "to_role": str(data.get("to_role", "")),
            }
        )
    return {
        "count": len(items),
        "items": items[-5:],
    }


def collect_directional_boundary(
    operator_vision: dict,
    active_handoffs: dict,
    attention: list[dict],
) -> dict:
    mhw = operator_vision.get("my_human_work_now", {})
    recent_ingress = operator_vision.get("recent_ingress", [])
    return {
        "operator_to_agents": {
            "label": "Ronny -> agents",
            "surface": "recent_ingress",
            "count": len(recent_ingress),
            "pending_classification": mhw.get("pending_ingress", 0),
            "rule": "Ingress is raw operator submission only. Agents do not write back into operator ingress.",
        },
        "agents_to_operator": {
            "label": "Agents -> Ronny",
            "surfaces": ["active_handoffs", "attention", "receipts"],
            "handoff_count": active_handoffs.get("count", 0),
            "attention_count": len(attention),
            "rule": "Agents and the system return asks, blockers, and status through handoffs, surfaced attention, and receipts, not the ingress lane.",
        },
    }


def collect_git_refs() -> dict:
    local_head, _ = _run(["git", "rev-parse", "--short=8", "HEAD"])
    local_full, _ = _run(["git", "rev-parse", "HEAD"])
    origin_head, _ = _run(["git", "rev-parse", "--short=8", "origin/main"])
    origin_full, _ = _run(["git", "rev-parse", "origin/main"])
    github_out, github_ok = _run(["git", "ls-remote", "github", "refs/heads/main"])
    github_head = ""
    if github_ok and github_out:
        github_head = github_out.split()[0][:8] if github_out.split() else ""
    commit_count, _ = _run(["git", "rev-list", "--count", "HEAD"])
    dirty_out, _ = _run(["git", "status", "--porcelain"])
    is_dirty = bool(dirty_out.strip())

    baseline = "unavailable"
    agents_path = REPO / "AGENTS.md"
    try:
        import re
        text = agents_path.read_text(encoding="utf-8")
        m = re.search(r"baseline is commit `([0-9a-f]+)`", text)
        if m:
            baseline = m.group(1)[:8]
    except Exception:
        pass

    return {
        "local_head": local_head,
        "local_full": local_full,
        "origin_head": origin_head,
        "origin_full": origin_full,
        "github_head": github_head or "unavailable",
        "github_ok": github_ok and bool(github_head),
        "commit_count": commit_count or "0",
        "is_dirty": is_dirty,
        "dirty_files": dirty_out.strip() if is_dirty else "",
        "baseline": baseline,
    }


