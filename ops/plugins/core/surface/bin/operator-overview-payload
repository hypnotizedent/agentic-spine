        "--json",
    ])
    return {
        "pending": data.get("pending", 0),
        "total": data.get("total", 0),
    }


# ---------------------------------------------------------------------------
# Operator vision contribution surface
# ---------------------------------------------------------------------------

def _classify_input(filename: str, binding_13: dict | None, binding_16: dict | None,
                    state_map: dict | None) -> dict:
    """Classify a single raw input file using the binding/state-map artifacts."""
    # Default
    result = {"file": filename, "state": "staged", "disposition": "unknown",
              "next_move": "needs classification", "downstream": []}
    return result


def collect_operator_vision() -> dict:
    """Collect operator-vision contribution lineage from runtime artifacts.

    Reads the actual staged inputs and known artifacts to produce a live
    contribution trace. Counts are derived from filesystem truth, not
    hardcoded from the forensic floor.
    """
    inputs_root = STATE_ROOT / "inputs"
    domain_state = STATE_ROOT / "domain-state"
    spine_state = domain_state / "spine"
    prompts_root = STATE_ROOT / "controller-prompts"

    # --- Raw inputs -----------------------------------------------------------
    batches: list[dict] = []
    total_raw = 0
    for batch_dir in sorted(inputs_root.glob("operator-vision-*")):
        if not batch_dir.is_dir():
            continue
        files = sorted(f.name for f in batch_dir.iterdir() if f.is_file() and not f.name.startswith("."))
        batch_id = batch_dir.name  # e.g. operator-vision-20260413
        batches.append({"batch_id": batch_id, "file_count": len(files), "files": files})
        total_raw += len(files)

    # --- Live operator ingress ------------------------------------------------
    recent_ingress: list[dict] = []
    pending_ingress = 0
    ingress_dir = inputs_root / "operator-ingress"
    if ingress_dir.is_dir():
        for path in sorted(ingress_dir.glob("OI-*.yaml"), reverse=True)[:10]:
            doc = _yaml_load(path)
            if not isinstance(doc, dict):
                continue
            lifecycle_state = str(doc.get("lifecycle_state", "submitted"))
            disposition = str(doc.get("disposition", "awaiting_classification"))
            disposition_detail = str(
                doc.get(
                    "disposition_detail",
                    "Raw input preserved; awaiting membrane classification.",
                )
            )
            item = {
                "ingress_id": str(doc.get("ingress_id", path.stem)),
                "submitted_at": str(doc.get("submitted_at", "")),
                "content_type": str(doc.get("content_type", "")),
                "operator_hint": str(doc.get("operator_hint", "")),
                "lifecycle_state": lifecycle_state,
                "disposition": disposition,
                "disposition_detail": disposition_detail,
                "source_device": str(doc.get("source_device", "")),
                "source_app": str(doc.get("source_app", "")),
            }
            # Include metabolization fields when present
            if "classification" in doc:
                item["classification"] = str(doc["classification"])
            if "next_stage" in doc:
                item["next_stage"] = str(doc["next_stage"])
            if "downstream_refs" in doc:
                item["downstream_refs"] = doc["downstream_refs"]
            if "activation_conditions" in doc:
                item["activation_conditions"] = str(doc["activation_conditions"])
            if "classified_at" in doc:
                item["classified_at"] = str(doc["classified_at"])
            if "routed_at" in doc:
                item["routed_at"] = str(doc["routed_at"])
            translator_workload = doc.get("translator_workload")
            if isinstance(translator_workload, dict):
                w1 = translator_workload.get("W1")
                if isinstance(w1, dict):
                    if "concern_class" in w1:
                        item["concern_class"] = str(w1["concern_class"])
                    if "confidence" in w1:
                        item["confidence"] = w1["confidence"]
                w2 = translator_workload.get("W2")
                if isinstance(w2, dict) and "routing_target" in w2:
                    item["routing_target"] = str(w2["routing_target"])
                w3 = translator_workload.get("W3")
                if isinstance(w3, dict) and "execution_dispatched" in w3:
                    item["execution_dispatched"] = bool(w3["execution_dispatched"])
            recent_ingress.append(item)
            if disposition == "awaiting_classification" or lifecycle_state in {
                "submitted",
                "preserved",
            }:
                pending_ingress += 1

    total_raw += len(recent_ingress)

    # --- Known reading briefs -------------------------------------------------
    briefs: list[str] = []
    for name in ["READING-BRIEF-OPERATOR-VISION-DESKTOP-NOTES-20260413.md",
                  "READING-BRIEF-OPERATOR-VISION-4.16-DROP-20260416.md"]:
        if (domain_state / name).is_file():
            briefs.append(name)

    # --- Known binding artifacts ----------------------------------------------
    bindings: list[str] = []
    for name in ["BINDING-OPERATOR-VISION-INPUTS-TO-PREP-STUBS-20260413.md",
                  "BINDING-OPERATOR-VISION-4.16-DROP-TO-EXISTING-SEAMS-20260416.md"]:
        if (domain_state / name).is_file():
            bindings.append(name)

    # --- State map ------------------------------------------------------------
    state_map_exists = (domain_state / "OPERATOR-VISION-STATE-MAP-20260416.md").is_file()

    # --- Delivered packets ----------------------------------------------------
    delivered_packets: list[dict] = []
    retired_packets: list[dict] = []
    packet_names = {
        "MAILROOM-CONTROLLER-PACKET-29-INTAKE-VOCABULARY-AND-ROUTING-20260415.md": {"id": "PACKET-29", "title": "Intake Vocabulary and Routing", "status": "delivered"},
        "MAILROOM-CONTROLLER-PACKET-30-RONNY-INTAKE-PIPELINE-20260415.md": {"id": "PACKET-30", "title": "Ronny Intake Pipeline Forensic", "status": "delivered"},
        "MAILROOM-CONTROLLER-PACKET-35-OPERATOR-HUMAN-INGRESS-MODEL-20260416.md": {"id": "PACKET-35", "title": "Operator Human Ingress Model", "status": "delivered"},
        "MAILROOM-CONTROLLER-PACKET-36-OPERATOR-REVIEW-STEWARDSHIP-DISCIPLINE-20260416.md": {"id": "PACKET-36", "title": "Operator Review Stewardship (retired)", "status": "retired"},
    }
    for fname, meta in packet_names.items():
        if (prompts_root / fname).is_file():
            if meta["status"] == "retired":
                retired_packets.append(meta)
            else:
                delivered_packets.append(meta)

    # --- Contract artifacts ---------------------------------------------------
    contracts: list[str] = []
    contract_name = "OPERATOR-HUMAN-INGRESS-MODEL-CONTRACT-20260416.md"
    if (spine_state / contract_name).is_file():
        contracts.append(contract_name)

    # --- Derived conclusions --------------------------------------------------
    derived: list[str] = []
    derived_name = "DERIVED-CONCLUSION-EXECUTION-PATTERN-VS-REASONING-PATTERN-20260415.yaml"
    if (spine_state / derived_name).is_file():
        derived.append(derived_name)

    # --- Per-input lineage (from forensic floor) ------------------------------
    # Disposition counts from the forensic floor classifications
    # These are derived from reading the binding artifacts
    advanced_to_contract = 0
    adjacent_evidence = 0
    parked_prep = 0
    parked_no_lifecycle = 0
    out_of_spine = 0
    floating = 0

    # Batch 2026-04-13: 9 files
    # 7 spine files parked via prep stubs, 2 out-of-spine
    batch_13_dir = inputs_root / "operator-vision-20260413"
    if batch_13_dir.is_dir():
        b13_files = [f.name for f in batch_13_dir.iterdir() if f.is_file() and not f.name.startswith(".")]
        for fname in b13_files:
            if fname in ("Preserving knowledge Claude.md", "The shalamat unlock.md"):
                out_of_spine += 1
            elif fname == "epistemic.posture.contract.draft.yaml":
                parked_prep += 1  # derivative, parked with parent
            else:
                parked_prep += 1

    # Batch 2026-04-16: 6 files
    batch_16_dir = inputs_root / "operator-vision-20260416"
    if batch_16_dir.is_dir():
        b16_files = [f.name for f in batch_16_dir.iterdir() if f.is_file() and not f.name.startswith(".")]
        for fname in b16_files:
            if fname in ("Agent operator human role.md", "Operator vision spec.md"):
                advanced_to_contract += 1
            elif fname in ("Depth review.md", "Operator.md"):
                adjacent_evidence += 1
            elif fname in ("Epidemic system.md", "Regeime thinking.md"):
                parked_no_lifecycle += 1
                floating += 1

    # --- Per-input trace for readback -----------------------------------------
    input_traces: list[dict] = []

    # Batch 2026-04-13
    if batch_13_dir.is_dir():
        b13_map = {
            "epistemic postures.md": {"disposition": "parked_prep", "detail": "Prep surface 1 (philosophical values)", "downstream": ["epistemic.posture.contract.draft.yaml"]},
            "epistemic.posture.contract.draft.yaml": {"disposition": "parked_prep", "detail": "Draft contract derived from epistemic postures", "downstream": []},
            "Epistemology.md": {"disposition": "parked_prep", "detail": "Prep surface 2 (philosophical values review)", "downstream": []},
            "Node class architecture.md": {"disposition": "parked_prep", "detail": "Prep surface 4 (node class reduction)", "downstream": []},
            "Node master.md": {"disposition": "parked_prep", "detail": "Prep surface 4 (raw 77-row taxonomy)", "downstream": []},
            "Taxonomy pillar.md": {"disposition": "parked_prep", "detail": "Prep surface 3 (adjacent ontologies)", "downstream": []},
            "Topology entropy.md": {"disposition": "parked_prep", "detail": "Prep surface 3-4 (system physics models)", "downstream": []},
            "Preserving knowledge Claude.md": {"disposition": "out_of_spine", "detail": "Knowledge domain (Islamic knowledge preservation)", "downstream": []},
            "The shalamat unlock.md": {"disposition": "out_of_spine", "detail": "Knowledge domain (Shamela database)", "downstream": []},
        }
        for fname in sorted(f.name for f in batch_13_dir.iterdir() if f.is_file() and not f.name.startswith(".")):
            meta = b13_map.get(fname, {"disposition": "staged", "detail": "unclassified", "downstream": []})
            input_traces.append({
                "file": fname, "batch": "2026-04-13",
                "state": "translated" if fname in b13_map else "staged",
                "disposition": meta["disposition"],
                "detail": meta["detail"],
                "downstream": meta["downstream"],
            })

    # Batch 2026-04-16
    if batch_16_dir.is_dir():
        b16_map = {
            "Agent operator human role.md": {
                "disposition": "advanced_to_contract", "detail": "Cluster 1 → Packet 35 → Ingress Model Contract",
                "downstream": ["PACKET-35", "OPERATOR-HUMAN-INGRESS-MODEL-CONTRACT-20260416.md"],
            },
            "Operator vision spec.md": {
                "disposition": "advanced_to_contract", "detail": "Cluster 1 → Packet 35 → Ingress Model Contract",
                "downstream": ["PACKET-35", "OPERATOR-HUMAN-INGRESS-MODEL-CONTRACT-20260416.md"],
            },
            "Depth review.md": {
                "disposition": "adjacent_evidence", "detail": "Cluster 2 → reclassified after Packet 36 retirement → sharpens Packets 06/08",
                "downstream": ["PACKET-36 (retired)"],
            },
            "Operator.md": {
                "disposition": "adjacent_evidence", "detail": "Cluster 2 → reclassified → sharpens Packets 08/11",
                "downstream": ["PACKET-36 (retired)"],
            },
            "Epidemic system.md": {
                "disposition": "parked_no_lifecycle", "detail": "Cluster 3 → parked, no activation triggers",
                "downstream": [],
            },
            "Regeime thinking.md": {
                "disposition": "parked_no_lifecycle", "detail": "Cluster 3 → parked, weak adjacent anchor (OC/Hermes)",
                "downstream": ["DERIVED-CONCLUSION-EXECUTION-PATTERN-VS-REASONING-PATTERN"],
            },
        }
        for fname in sorted(f.name for f in batch_16_dir.iterdir() if f.is_file() and not f.name.startswith(".")):
            meta = b16_map.get(fname, {"disposition": "staged", "detail": "unclassified", "downstream": []})
            input_traces.append({
                "file": fname, "batch": "2026-04-16",
                "state": "translated" if fname in b16_map else "staged",
                "disposition": meta["disposition"],
                "detail": meta["detail"],
                "downstream": meta["downstream"],
            })

    # --- Exec receipts --------------------------------------------------------
    exec_receipts = []
    for p in domain_state.glob("EXEC_RECEIPT-*OPERATOR-VISION*") if domain_state.is_dir() else []:
        exec_receipts.append(p.name)
    for p in domain_state.glob("EXEC_RECEIPT-*INTAKE*") if domain_state.is_dir() else []:
        exec_receipts.append(p.name)
    for p in domain_state.glob("EXEC_RECEIPT-*INGRESS*") if domain_state.is_dir() else []:
        exec_receipts.append(p.name)
    exec_receipts = sorted(set(exec_receipts))

    # --- Assemble -------------------------------------------------------------
    return {
        "my_human_work_now": {
            "total_raw_inputs": total_raw,
            "recent_ingress": len(recent_ingress),
            "pending_ingress": pending_ingress,
            "advanced_to_contract": advanced_to_contract,
            "adjacent_evidence": adjacent_evidence,
            "parked_prep": parked_prep,
            "parked_no_lifecycle": parked_no_lifecycle,
            "out_of_spine": out_of_spine,
            "float_risk_count": floating,
            "delivered_packets": len(delivered_packets),
            "retired_packets": len(retired_packets),
            "contracts": len(contracts),
            "derived_conclusions": len(derived),
        },
        "batches": batches,
        "recent_ingress": recent_ingress,
        "what_became_of_my_input": input_traces,
        "what_my_ideas_built": {
            "contracts": contracts,
            "delivered_packets": [p["id"] + ": " + p["title"] for p in delivered_packets],
            "retired_packets": [p["id"] + ": " + p["title"] for p in retired_packets],
            "derived_conclusions": derived,
            "reading_briefs": briefs,
            "binding_artifacts": bindings,
        },
        "what_is_waiting_on_me": {
            "parked_without_lifecycle": parked_no_lifecycle,
            "floating_items": floating,
            "pending_ingress": pending_ingress,
            "items": [
                t for t in input_traces
                if t["disposition"] in ("parked_no_lifecycle",)
            ] + [
                {
                    "file": item["ingress_id"],
                    "detail": item["disposition_detail"],
                    "disposition": item["disposition"],
                }
                for item in recent_ingress
                if item["disposition"] == "awaiting_classification"
            ],
        },
        "chain_status": {
            "ronny_drops": "standing",
            "translated_to_machine": "standing",
            "organized_sorted": "standing",
            "moved_to_next_stage": "standing" if any(
                i.get("lifecycle_state") in ("classified", "routed")
                for i in recent_ingress
            ) else "partial",
            "visible_trace": "standing" if any(
                i.get("lifecycle_state") == "routed"
                for i in recent_ingress
            ) else "partial",
            "readback_surface": "this_surface",
        },
        "state_map_exists": state_map_exists,
        "exec_receipts": exec_receipts,
    }


def _iter_yaml_docs(path: Path) -> list[dict]:
    import yaml

    try:
        text = path.read_text(errors="replace")
    except OSError:
        return []

    docs: list[dict] = []
    if path.suffix in (".yaml", ".yml"):
        try:
            parsed = yaml.safe_load(text)
        except Exception:
            return []
        if isinstance(parsed, dict):
            docs.append(parsed)
        return docs

    if path.suffix != ".md":
        return []

    for match in _YAML_FENCE.finditer(text):
        try:
            parsed = yaml.safe_load(match.group(1))
        except Exception:
            continue
        if isinstance(parsed, dict):
            docs.append(parsed)
    return docs


def _find_parked_containers(data: object) -> list[tuple[dict, dict]]:
    found: list[tuple[dict, dict]] = []
    if isinstance(data, dict):
        lifecycle = data.get("parked_lifecycle")
        if isinstance(lifecycle, dict):
            found.append((data, lifecycle))
        for value in data.values():
            found.extend(_find_parked_containers(value))
    elif isinstance(data, list):
        for value in data:
            found.extend(_find_parked_containers(value))
    return found


def _parked_item_name(path: Path, container: dict, root_doc: dict) -> str:
    candidates: list[object] = []
    for source in (container, root_doc):
        if not isinstance(source, dict):
            continue
        candidates.extend(
            [
                source.get("title"),
                source.get("name"),
                source.get("id"),
                source.get("source_file"),
            ]
        )
        artifact = source.get("artifact")
        if isinstance(artifact, dict):
            candidates.extend(
                [
                    artifact.get("title"),
                    artifact.get("name"),
                    artifact.get("id"),
                    artifact.get("source_file"),
                ]
            )
    for candidate in candidates:
        text = str(candidate or "").strip()
        if text:
            return text
    return path.stem


def _parked_location(path: Path) -> str:
    text = str(path)
    if "/domain-state/spine/" in text:
        return "runtime/spine"
    if "/domain-state/" in text:
        return "runtime/domain-state"
    return "other"


def collect_parked_inventory(now_dt: datetime) -> dict:
    items: list[dict] = []
    domain_state = STATE_ROOT / "domain-state"
    if not domain_state.is_dir():
        return {"count": 0, "review_summary": summarize_temporal_states([], "review_state"), "items": []}

    seen: set[tuple[str, str]] = set()
    for path in sorted(domain_state.rglob("*")):
        if path.is_dir() or path.suffix not in (".yaml", ".yml", ".md"):
            continue
        for parsed in _iter_yaml_docs(path):
            for container, lifecycle in _find_parked_containers(parsed):
                status = str(lifecycle.get("status", "parked") or "parked").lower()
                if status != "parked":
                    continue
                name = _parked_item_name(path, container, parsed)
                dedupe_key = (str(path), name)
                if dedupe_key in seen:
                    continue
                seen.add(dedupe_key)

                next_review = lifecycle.get("next_review")
                due_seconds = _seconds_until(next_review, now_dt)
                review_state = classify_due_window(due_seconds)
                evidence_field = "next_review" if next_review else ""
                evidence_at = str(next_review) if next_review else ""

                if not evidence_field:
                    for field in (
                        "parked_at",
                        "entered_at",
                        "created_at_utc",
                        "created_at",
                        "created",
                        "reviewed_at",
                        "closed_at",
                        "superseded_at",
                    ):
                        value = lifecycle.get(field)
                        if value:
                            evidence_field = field
                            evidence_at = str(value)
                            review_state = classify_temporal_age(_seconds_since(value, now_dt))
                            due_seconds = None
                            break

                if not evidence_field:
                    artifact = container.get("artifact") if isinstance(container.get("artifact"), dict) else {}
                    created_value = artifact.get("created") if isinstance(artifact, dict) else ""
                    if created_value:
                        evidence_field = "created"
                        evidence_at = str(created_value)
                        review_state = classify_temporal_age(_seconds_since(created_value, now_dt))

                item = {
                    "name": name,
                    "path": str(path),
                    "location": _parked_location(path),
                    "temporal_state": "parked",
                    "review_state": review_state,
                    "next_review": str(next_review) if next_review else None,
                    "time_evidence_field": evidence_field or "unknown",
                    "time_evidence_at": evidence_at or None,
                    "due_in_seconds": due_seconds,
                    "parked_reason": str(lifecycle.get("parked_reason", "")),
                }
                items.append(item)

    items.sort(key=lambda item: (item["review_state"], item["name"].lower()))
    review_summary = summarize_temporal_states(items, "review_state")
    return {
        "count": len(items),
        "review_summary": review_summary,
        "items": items,
    }


def collect_temporal_standing(
    generated_utc: str,
    projection_freshness: dict,
    operator_vision: dict,
    active_handoffs: dict,
    work_state: dict,
) -> dict:
    now_dt = _parse_utc(generated_utc) or datetime.now(timezone.utc)

    ingress_items = []
    for item in operator_vision.get("recent_ingress", []):
        evidence_field = ""
        evidence_at = ""
        for field in ("routed_at", "classified_at", "submitted_at"):
            if item.get(field):
                evidence_field = field
                evidence_at = str(item.get(field, ""))
                break
        age_seconds = _seconds_since(evidence_at, now_dt)
        temporal_state = classify_temporal_age(age_seconds)
        enriched = dict(item)
        enriched["temporal_state"] = temporal_state
        enriched["time_evidence_field"] = evidence_field or "unknown"
        enriched["time_evidence_at"] = evidence_at or None
        enriched["time_age_seconds"] = age_seconds
        ingress_items.append(enriched)
    operator_vision["recent_ingress"] = ingress_items
    ingress_summary = summarize_temporal_states(ingress_items)

    handoff_items = []
    for item in active_handoffs.get("items", []):
        created_age = _seconds_since(item.get("created_at_utc"), now_dt)
        expires_in = _seconds_until(item.get("expires_at_utc"), now_dt)
        temporal_state = classify_temporal_age(created_age)
        evidence_field = "created_at_utc"
        evidence_at = item.get("created_at_utc")
        if expires_in is not None and expires_in < 0:
            temporal_state = "stale"
            evidence_field = "expires_at_utc"
            evidence_at = item.get("expires_at_utc")
        enriched = dict(item)
        enriched["temporal_state"] = temporal_state
        enriched["time_evidence_field"] = evidence_field
        enriched["time_evidence_at"] = evidence_at or None
        enriched["time_age_seconds"] = created_age
        enriched["expires_in_seconds"] = expires_in
        handoff_items.append(enriched)
    active_handoffs["items"] = handoff_items
    handoff_summary = summarize_temporal_states(handoff_items)

    parked_inventory = collect_parked_inventory(now_dt)

    completion = work_state.get("completion_state", {})
    snapshot_timestamp = completion.get("snapshot_timestamp")
    snapshot_age_seconds = _seconds_since(snapshot_timestamp, now_dt)
    completion_snapshot = {
        "temporal_state": classify_temporal_age(snapshot_age_seconds),
        "snapshot_timestamp": str(snapshot_timestamp or ""),
        "snapshot_age_seconds": snapshot_age_seconds,
        "closed_count": int(completion.get("delivered", 0) or 0),
        "parked_count": int(completion.get("parked", 0) or 0),
        "open_count": int(completion.get("open", 0) or 0),
        "ambiguous_count": int(completion.get("ambiguous", 0) or 0),
    }

    summary = {"now": 0, "recent": 0, "stale": 0, "parked": parked_inventory["count"], "closed": completion_snapshot["closed_count"], "unknown": 0}
    for state in ("now", "recent", "stale", "unknown"):
        summary[state] += ingress_summary.get(state, 0)
        summary[state] += handoff_summary.get(state, 0)
    projection_state = str(projection_freshness.get("temporal_state", "unknown"))
    if projection_state in summary:
        summary[projection_state] += 1
    else:
        summary["unknown"] += 1
    snapshot_state = completion_snapshot["temporal_state"]
    if snapshot_state in summary:
        summary[snapshot_state] += 1
    else:
        summary["unknown"] += 1
    summary["unknown"] += parked_inventory["review_summary"].get("unknown", 0)

    return {
        "generated_utc": generated_utc,
        "model": {
            "states": ["now", "recent", "stale", "parked", "closed"],
            "unknown_state": "unknown",
            "thresholds": {
                "now_hours": TEMPORAL_NOW_SECONDS // 3600,
                "recent_hours": TEMPORAL_RECENT_SECONDS // 3600,
                "review_due_soon_days": TEMPORAL_REVIEW_SOON_SECONDS // (24 * 3600),
            },
            "rule": "Read-side only. Derived from existing timestamps and lifecycle fields already present in runtime evidence. Missing evidence stays unknown.",
        },
        "summary": summary,
        "projection": {
            "temporal_state": projection_state,
            "source": projection_freshness.get("source", "unknown"),
            "evidence_at": projection_freshness.get("sync_marker_utc")
            or projection_freshness.get("state_db_mtime_utc"),
            "age_seconds": projection_freshness.get("age_seconds"),
        },
        "operator_to_agents": {
            "count": len(ingress_items),
            "summary": ingress_summary,
            "items": ingress_items,
        },
        "agents_to_operator": {
            "count": len(handoff_items),
            "summary": handoff_summary,
            "items": handoff_items,
        },
        "parked_inventory": parked_inventory,
        "completion_snapshot": completion_snapshot,
    }


# ---------------------------------------------------------------------------
# Desktop-only extensions (not in compact mode)
# ---------------------------------------------------------------------------

def collect_git_log(n: int = 30) -> list[dict]:
    out, ok = _run(["git", "log", "--oneline", f"-n{n}", "--format=%H|%h|%ai|%s"])
    if not ok:
        return []
    entries = []
    for line in out.splitlines():
        parts = line.split("|", 3)
        if len(parts) == 4:
            entries.append({"full": parts[0], "short": parts[1], "date": parts[2][:10], "subject": parts[3]})
    return entries


def collect_capabilities() -> dict:
    data = _yaml_load(REPO / "ops" / "capabilities.yaml")
    if not data or "capabilities" not in data:
        return {"caps": {}, "count": 0}
    caps = data["capabilities"]
    return {"caps": caps, "count": len(caps)}


def collect_gates() -> dict:
    reg = _yaml_load(REPO / "ops" / "bindings" / "gate.registry.yaml")
    topo = _yaml_load(REPO / "ops" / "bindings" / "gate.execution.topology.yaml")
    result = {
        "total": 0, "active": 0, "retired": 0,
        "blocking": 0, "report": 0,
        "core_ids": [], "gates": [], "categories": [],
    }
    if reg:
        gc = reg.get("gate_count", {})
        result["total"] = gc.get("total", 0)
        result["active"] = gc.get("active", 0)
        result["retired"] = gc.get("retired", 0)
        result["blocking"] = gc.get("active_blocking", 0)
        result["report"] = gc.get("active_report", 0)
        result["categories"] = reg.get("categories", [])
        result["gates"] = reg.get("gates", [])
    if topo:
        cm = topo.get("core_mode", {})
        result["core_ids"] = cm.get("core_gate_ids", [])
    return result


def collect_manifest() -> dict:
    data = _yaml_load(STATE_ROOT / "domain-state" / "SPINE_SURFACE_MANIFEST.yaml")
    if not data:
        return {"surfaces": [], "count": 0, "families": [], "available": False}
    surfaces = data.get("surfaces", [])
    families = data.get("workflow_families", [])
    return {
        "surfaces": surfaces,
        "count": len(surfaces),
        "families": families,
        "entry_chain": data.get("entry_chain", []),
        "generated_at": data.get("generated_at_utc", ""),
        "available": True,
    }


def collect_invocation_counts() -> dict[str, int]:
    counts: dict[str, int] = {}
    sessions_root = EVIDENCE_ROOT / "sessions"
    if not sessions_root.exists():
        return counts
    for path in sessions_root.iterdir():
        if not path.is_dir():
            continue
        parts = path.name.split("__")
        if len(parts) < 3:
            continue
        counts[parts[1]] = counts.get(parts[1], 0) + 1
    return counts


# ---------------------------------------------------------------------------
# Payload assembly
# ---------------------------------------------------------------------------

def build_payload(compact: bool = False) -> dict:
    """Build the shared operator overview payload.

    compact=False: full payload for desktop cockpit (includes git log, caps, gates, manifest)
    compact=True:  phone-priority subset (spine_now through read_only_posture only)
    """
    status = _run_json([str(REPO / "bin" / "ops"), "status", "--json"])
    refs = collect_git_refs()
    generated_utc = utcnow()
    operator_vision = collect_operator_vision()
    projection_freshness = collect_projection_freshness()
    attention = collect_attention(status, refs)
    active_handoffs = collect_active_handoffs()
    work_state = collect_work_state(status)
    temporal_standing = collect_temporal_standing(
        generated_utc,
        projection_freshness,
        operator_vision,
        active_handoffs,
        work_state,
    )

    # Compute posture first — the router's primary loop drives focus selection.
    current_posture = collect_current_posture()

    active_loops = collect_active_loops(status)

    # Extract the router's recommended loop ID from posture to ensure focus
    # structurally agrees with compute_routing(), not just coincidentally.
    # Only treat the router's choice as canonical when routing_state is
    # healthy — ambiguous/degraded routing emits provisional hints that
    # must not be promoted to high-confidence focus.
    router_primary_id = ""
    routing_state = current_posture.get("routing_state", "") if current_posture.get("available") else ""
    if routing_state and routing_state not in ("ambiguous", "degraded", "error"):
        cmd = current_posture.get("recommended_command", "")
        parts = cmd.split()
        if parts and parts[-1].startswith("LOOP-"):
            router_primary_id = parts[-1]
    active_loops["focus"] = _select_focus(active_loops.get("items", []), router_primary_id)

    payload: dict = {
        "version": 3,
        "generated_utc": generated_utc,
        "operator_vision": operator_vision,
        "spine_now": collect_spine_now(status),
        "temporal_truth": collect_temporal_truth(status),
        "projection_freshness": projection_freshness,
        "attention": attention,
        "active_loops": active_loops,
        "active_handoffs": active_handoffs,
        "work_state": work_state,
        "git_refs": refs,
        "node_roles": collect_node_roles(status),
        "current_posture": current_posture,
        "aperture": collect_aperture_summary(),
        "proposals": collect_proposals(),
        "directional_boundary": collect_directional_boundary(
            operator_vision, active_handoffs, attention
        ),
        "temporal_standing": temporal_standing,
    }

    if not compact:
        payload["git_log"] = collect_git_log(30)
        payload["capabilities"] = collect_capabilities()
        payload["gates"] = collect_gates()
        payload["manifest"] = collect_manifest()
        payload["invocation_counts"] = collect_invocation_counts()

    return payload


def main() -> int:
    parser = argparse.ArgumentParser(description="Shared operator overview payload")
    parser.add_argument("--compact", action="store_true", help="Phone-priority compact subset")
    parser.add_argument("--output", type=str, default="", help="Write to file instead of stdout")
    args = parser.parse_args()

    payload = build_payload(compact=args.compact)

    output = json.dumps(payload, indent=2)
    if args.output:
        Path(args.output).parent.mkdir(parents=True, exist_ok=True)
        Path(args.output).write_text(output)
        print(f"payload written → {args.output}")
    else:
        print(output)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
