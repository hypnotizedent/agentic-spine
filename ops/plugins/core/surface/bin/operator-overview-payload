        "local_role": daemons.get("local_role", ""),
        "execution_host_target": exec_host.get("target", "") if isinstance(exec_host, dict) else "",
        "execution_host_access": exec_host.get("target_access", "") if isinstance(exec_host, dict) else "",
        "execution_host_posture": exec_host.get("delivery_posture", "") if isinstance(exec_host, dict) else "",
        "execution_host_workload_count": exec_host.get("workload_count", 0) if isinstance(exec_host, dict) else 0,
        "execution_host_workload_labels": exec_host.get("workload_labels", []) if isinstance(exec_host, dict) else [],
        "execution_host_workload_purposes": exec_host.get("workload_purposes", {}) if isinstance(exec_host, dict) else {},
        "execution_host_active_workload_count": exec_host.get("active_workload_count", 0) if isinstance(exec_host, dict) else 0,
        "execution_host_active_workload_labels": exec_host.get("active_workload_labels", []) if isinstance(exec_host, dict) else [],
        "execution_host_active_workload_purposes": exec_host.get("active_workload_purposes", {}) if isinstance(exec_host, dict) else {},
        "execution_host_intended_workload_count": exec_host.get("intended_workload_count", 0) if isinstance(exec_host, dict) else 0,
        "execution_host_intended_workload_labels": exec_host.get("intended_workload_labels", []) if isinstance(exec_host, dict) else [],
        "execution_host_intended_workload_purposes": exec_host.get("intended_workload_purposes", {}) if isinstance(exec_host, dict) else {},
        "execution_host_parked_workload_count": exec_host.get("parked_workload_count", 0) if isinstance(exec_host, dict) else 0,
        "execution_host_parked_workload_labels": exec_host.get("parked_workload_labels", []) if isinstance(exec_host, dict) else [],
        "execution_host_parked_workload_purposes": exec_host.get("parked_workload_purposes", {}) if isinstance(exec_host, dict) else {},
        "verification_node": node_roles.get("verification_node", {}) if isinstance(node_roles.get("verification_node"), dict) else {},
        "storage_evidence_node": node_roles.get("storage_evidence_node", {}) if isinstance(node_roles.get("storage_evidence_node"), dict) else {},
        "control_node": node_roles.get("control_node", {}) if isinstance(node_roles.get("control_node"), dict) else {},
        "non_local_deferred": daemons.get("non_local_deferred", []),
        "non_local_breakdown": daemons.get("non_local_breakdown", {}),
    }


def collect_birth_mode_audit() -> dict:
    """Audit scheduler registry for birth-mode truth violations.

    Surfaces workloads where declared birth_mode contradicts runtime state:
    standing_program not scheduled, human_session_only carried as active, etc.
    """
    registry_path = REPO / "ops" / "bindings" / "launchd.scheduler.registry.yaml"
    if not registry_path.is_file():
        return {"ok": False, "error": "registry not found", "violations": [], "summary": {}}

    try:
        import yaml as _yaml
        with registry_path.open() as f:
            registry = _yaml.safe_load(f)
    except Exception as e:
        return {"ok": False, "error": str(e), "violations": [], "summary": {}}

    labels = registry.get("labels", [])
    valid_modes = {
        "standing_program", "exception_only", "migration_project",
        "human_session_only", "classify_on_promotion",
    }
    violations: list[dict] = []
    mode_counts: dict[str, int] = {}

    for row in labels:
        label = row.get("label", "")
        state = row.get("state", "")
        birth_mode = row.get("birth_mode", "")
        role = row.get("intended_node_role", "")
        loaded = row.get("operator_console_launchd_loaded")

        if birth_mode:
            mode_counts[birth_mode] = mode_counts.get(birth_mode, 0) + 1

        if not birth_mode:
            violations.append({"label": label, "issue": "missing birth_mode"})
        elif birth_mode not in valid_modes:
            violations.append({"label": label, "issue": f"invalid birth_mode: {birth_mode}"})
        elif state == "active" and birth_mode == "human_session_only":
            violations.append({"label": label, "issue": "active + human_session_only (use suspended)"})
        elif birth_mode == "standing_program" and role == "operator_console" and loaded is False:
            violations.append({"label": label, "issue": "standing_program on operator_console with launchd unloaded"})
        elif state == "suspended" and birth_mode == "standing_program":
            violations.append({"label": label, "issue": "suspended + standing_program is contradictory"})

    return {
        "ok": len(violations) == 0,
        "total_labels": len(labels),
        "violations": violations,
        "violation_count": len(violations),
        "summary": mode_counts,
    }


def collect_standing_program_health(status: dict) -> dict:
    """Standing program health: prefer status proof summary, fallback to local specimen reads."""
    registry_path = REPO / "ops" / "bindings" / "launchd.scheduler.registry.yaml"
    result: dict = {
        "status": "unknown",
        "evaluated_at_utc": "",
        "summary": {
            "total": 0,
            "healthy": 0,
            "stale": 0,
            "failed": 0,
            "unreachable": 0,
            "never_run": 0,
            "unknown": 0,
        },
        "birth_modes": {},
        "active_interventions": 0,
        "intervention_labels": [],
        "v1_exception_specimens": [],
        "v1_state_counts": {},
        "v1_labels_by_state": {},
    }

    status_sph = status.get("standing_program_health", {})
    if isinstance(status_sph, dict) and isinstance(status_sph.get("summary"), dict):
        result["status"] = str(status_sph.get("status", "") or "unknown")
        result["evaluated_at_utc"] = str(status_sph.get("evaluated_at_utc", "") or "")
        result["summary"] = dict(status_sph.get("summary") or {})
        result["active_interventions"] = int(status_sph.get("active_interventions", 0) or 0)
        result["intervention_labels"] = list(status_sph.get("intervention_labels", []) or [])
        result["programs"] = list(status_sph.get("programs", []) or [])

    # --- scheduler registry ---
    if registry_path.is_file():
        try:
            import yaml as _yaml
            with registry_path.open() as f:
                registry = _yaml.safe_load(f) or {}
        except Exception:
            registry = {}

        labels = registry.get("labels", [])
        mode_counts: dict[str, int] = {}
        state_counts: dict[str, int] = {}
        for row in labels:
            bm = row.get("birth_mode", "unknown")
            mode_counts[bm] = mode_counts.get(bm, 0) + 1
            st = row.get("state", "unknown")
            state_counts[st] = state_counts.get(st, 0) + 1
        result["birth_modes"] = mode_counts
        result["state_counts"] = state_counts

    # --- intervention packets ---
    if not result["active_interventions"]:
        for doc in spx.list_open_interventions(str(STATE_ROOT)):
            result["active_interventions"] += 1
            label = str(doc.get("_source_label") or doc.get("source_label") or doc.get("label") or "")
            if label:
                result["intervention_labels"].append(label)

    try:
        evaluations = spx.evaluate_labels()
        specimens = spx.build_exception_specimen_states(evaluations, str(STATE_ROOT))
        result["v1_exception_specimens"] = specimens
        state_counts: dict[str, int] = {}
        labels_by_state: dict[str, list[str]] = {}
        for item in specimens:
            state = str(item.get("operator_state") or "unknown")
            label = str(item.get("label") or "")
            state_counts[state] = state_counts.get(state, 0) + 1
            labels_by_state.setdefault(state, []).append(label)
        result["v1_state_counts"] = state_counts
        result["v1_labels_by_state"] = labels_by_state
    except Exception as exc:
        result["v1_exception_error"] = str(exc)

    return result


def collect_operator_front_door(payload: dict) -> dict:
    """Aggregate existing payload data into an outcome-first operator model."""
    sph = payload.get("standing_program_health", {})
    delegations = payload.get("delegations", {})
    ws = payload.get("work_state", {})
    spine_now = payload.get("spine_now", {})
    human_input = payload.get("human_input", {})
    handoffs = payload.get("active_handoffs", {})
    terminal_telemetry = payload.get("terminal_telemetry", {})
    specimens = list(sph.get("v1_exception_specimens", []) or [])
    proof_summary = sph.get("summary", {}) if isinstance(sph.get("summary"), dict) else {}
    delegation_states = delegations.get("by_state", {}) if isinstance(delegations.get("by_state"), dict) else {}
    completion = ws.get("completion_state", {}) if isinstance(ws.get("completion_state"), dict) else {}

    # --- verify ---
    total_standing = int(proof_summary.get("total", 0) or 0)
    active_interventions = int(sph.get("active_interventions", 0) or 0)
    if total_standing:
        healthy = int(proof_summary.get("healthy", 0) or 0)
        specimen_degraded = sum(int(proof_summary.get(key, 0) or 0) for key in ("stale", "failed", "unreachable", "never_run", "unknown"))
        specimen_intervention_active = active_interventions
        degraded = specimen_degraded + specimen_intervention_active
    elif specimens:
        specimen_healthy = sum(1 for item in specimens if item.get("operator_state") == "standing_healthy")
        specimen_degraded = sum(1 for item in specimens if item.get("operator_state") == "standing_stale_or_degraded")
        specimen_intervention_active = sum(1 for item in specimens if item.get("operator_state") == "auto_birthed_intervention_active")
        degraded = specimen_degraded + specimen_intervention_active
        healthy = specimen_healthy
    else:
        healthy = int(proof_summary.get("healthy", 0) or 0)
        specimen_degraded = sum(int(proof_summary.get(key, 0) or 0) for key in ("stale", "failed", "unreachable", "never_run", "unknown"))
        specimen_intervention_active = active_interventions
        degraded = specimen_degraded + specimen_intervention_active
    # Count non-standing labels (human_session_only).
    birth_modes = sph.get("birth_modes", {})
    human_session_only = int(
        birth_modes.get("human_session_only", birth_modes.get("human_session", 0)) or 0
    )
    open_loops = int(ws.get("open_loops", 0) or 0)
    verify_parts = []
    if healthy:
        verify_parts.append(f"{healthy} standing healthy")
    if specimen_degraded:
        verify_parts.append(f"{specimen_degraded} degraded")
    telemetry_status = str(terminal_telemetry.get("status", "") or "")
    if telemetry_status and telemetry_status != "ok":
        verify_parts.append(f"telemetry {telemetry_status}")
    verify_status = str(spine_now.get("verify_status", "unknown") or "unknown")
    if verify_status and verify_status != "unknown":
        verify_parts.append(f"verify {verify_status}")
    verify = {
        "healthy_standing": healthy,
        "degraded_standing": degraded,
        "intervention_active": specimen_intervention_active,
        "verify_status": verify_status,
        "terminal_telemetry_status": telemetry_status or "unknown",
        "summary": ", ".join(verify_parts) if verify_parts else "verify healthy",
    }

    # --- intent ---
    intent_parts = [f"{open_loops} open work"]
    if human_session_only:
        intent_parts.append(f"{human_session_only} session-only")
    intent = {
        "open_work": open_loops,
        "human_session_only": human_session_only,
        "summary": ", ".join(intent_parts),
    }

    # --- blockers ---
    mhw = human_input.get("my_human_work_now", {}) if isinstance(human_input, dict) else {}
    pending_ingress = int(mhw.get("pending_ingress", 0) or 0)
    operator_asks = int(handoffs.get("count", 0) or 0)
    pending_reviews = int(delegation_states.get("needs_review", 0) or 0)
    open_gaps = int(ws.get("open_gaps", 0) or 0)
    blockers_total = pending_ingress + operator_asks + pending_reviews + active_interventions + open_gaps
    blockers_parts = []
    if pending_ingress:
        blockers_parts.append(f"{pending_ingress} pending ingress")
    if operator_asks:
        blockers_parts.append(f"{operator_asks} operator ask{'s' if operator_asks != 1 else ''}")
    if pending_reviews:
        blockers_parts.append(f"{pending_reviews} review{'s' if pending_reviews != 1 else ''}")
    if active_interventions:
        blockers_parts.append(f"{active_interventions} intervention{'s' if active_interventions != 1 else ''}")
    if open_gaps:
        blockers_parts.append(f"{open_gaps} gap{'s' if open_gaps != 1 else ''}")
    blockers = {
        "pending_ingress": pending_ingress,
        "operator_asks": operator_asks,
        "needs_review": pending_reviews,
        "active_interventions": active_interventions,
        "open_gaps": open_gaps,
        "total": blockers_total,
        "summary": ", ".join(blockers_parts) if blockers_parts else "all clear",
    }

    # --- progress ---
    active_waves = int(ws.get("active_waves", 0) or 0)
    active_delegations = sum(int(delegation_states.get(name, 0) or 0) for name in ("delegated", "picked_up", "executing"))
    picked_up = int(delegation_states.get("picked_up", 0) or 0)
    executing = int(delegation_states.get("executing", 0) or 0)
    progress_total = active_waves + active_delegations
    progress_parts = []
    if progress_total:
        progress_parts.append(f"{progress_total} in progress")
    progress = {
        "active_waves": active_waves,
        "active_delegations": active_delegations,
        "picked_up": picked_up,
        "executing": executing,
        "total": progress_total,
        "summary": ", ".join(progress_parts) if progress_parts else "idle",
    }

    # --- acceptance ---
    delivered = int(completion.get("delivered", 0) or 0) + int(completion.get("landed_local", 0) or 0)
    ambiguous = int(completion.get("ambiguous", 0) or 0)
    acceptance_parts = [f"{delivered} delivered"]
    if ambiguous:
        acceptance_parts.append(f"{ambiguous} ambiguous")
    acceptance = {
        "delivered": delivered,
        "ambiguous": ambiguous,
        "open": int(completion.get("open", 0) or 0),
        "parked": int(completion.get("parked", 0) or 0),
        "summary": ", ".join(acceptance_parts),
    }

    return {
        "verify": verify,
        "intent": intent,
        "blockers": blockers,
        "progress": progress,
        "acceptance": acceptance,
    }


def collect_proposals() -> dict:
    data = _run_json([
        str(REPO / "ops" / "plugins" / "core" / "proposals" / "bin" / "proposals-status"),
        "--json",
    ])
    return {
        "pending": data.get("pending", 0),
        "total": data.get("total", 0),
    }


def _collect_backup_posture_snapshot() -> dict:
    candidates = [
        STATE_ROOT / "domain-state" / "snapshots" / "backup.posture.snapshot.yaml",
        REPO / "ops" / "bindings" / "domains" / "backup" / "backup.posture.snapshot.yaml",
    ]
    path = next((candidate for candidate in candidates if candidate.is_file()), None)
    if path is None:
        return {"available": False, "source": "", "summary": {}, "degraded_rows": []}

    doc = _yaml_load(path)
    if not isinstance(doc, dict):
        return {"available": False, "source": str(path), "summary": {}, "degraded_rows": []}

    summary = doc.get("summary", {}) if isinstance(doc.get("summary"), dict) else {}
    backup_status = doc.get("backup_status", {}) if isinstance(doc.get("backup_status"), dict) else {}
    degraded_rows = backup_status.get("degraded_rows", []) if isinstance(backup_status.get("degraded_rows"), list) else []
    return {
        "available": True,
        "source": str(path.relative_to(REPO)) if str(path).startswith(str(REPO)) else str(path),
        "generated_at_utc": str(doc.get("generated_at_utc", "") or ""),
        "file_mtime_utc": _path_mtime_utc(path),
        "backup_status_run_state": str(summary.get("backup_status_run_state", "unknown") or "unknown"),
        "enabled_targets_total": int(summary.get("enabled_targets_total", 0) or 0),
        "ok_total": int(summary.get("backup_status_ok_total", 0) or 0),
        "degraded_total": int(summary.get("backup_status_degraded_total", 0) or 0),
        "context_blocked_total": int(summary.get("backup_status_context_blocked_total", 0) or 0),
        "restore_coverage_missing_total": int(summary.get("restore_coverage_missing_total", 0) or 0),
        "lane_over_budget_total": int(summary.get("lane_over_budget_total", 0) or 0),
        "lane_collect_errors_total": int(summary.get("lane_collect_errors_total", 0) or 0),
        "summary_line": str(backup_status.get("summary_line", "") or ""),
        "degraded_rows": [str(row) for row in degraded_rows[:8]],
    }


def _collect_recovery_runtime() -> dict:
    actions_file = REPO / "ops" / "bindings" / "recovery.actions.yaml"
    actions_doc = _yaml_load(actions_file)
    actions = actions_doc.get("actions", []) if isinstance(actions_doc, dict) else []
    if not isinstance(actions, list):
        actions = []

    audit_log = Path(os.environ.get("SPINE_LOGS", str(STATE_ROOT.parent / "logs"))) / "recovery-dispatch.ndjson"
    recent_audit: list[dict] = []
    last_audit_utc = ""
    if audit_log.is_file():
        try:
            lines = audit_log.read_text(encoding="utf-8", errors="replace").splitlines()[-5:]
        except Exception:
            lines = []
        for line in lines:
            try:
                item = json.loads(line)
            except Exception:
                continue
            if not isinstance(item, dict):
                continue
            recent_audit.append({
                "timestamp_utc": str(item.get("timestamp_utc", "") or ""),
                "gate_id": str(item.get("gate_id", "") or ""),
                "action_id": str(item.get("action_id", "") or ""),
                "result": str(item.get("result", "") or ""),
                "message": str(item.get("message", "") or ""),
            })
            last_audit_utc = _latest_utc(last_audit_utc, item.get("timestamp_utc"))

    attempt_dir = REPO / "ops" / "plugins" / "core" / "recovery" / "state" / "attempts"
    cooldown_dir = REPO / "ops" / "plugins" / "core" / "recovery" / "state" / "cooldown"
    attempt_count = len([p for p in attempt_dir.glob("*") if p.is_file()]) if attempt_dir.is_dir() else 0
    cooldown_count = len([p for p in cooldown_dir.glob("*") if p.is_file()]) if cooldown_dir.is_dir() else 0

    def _failure_class(item: object) -> str:
        if not isinstance(item, dict):
            return "deterministic"
        trigger = item.get("trigger", {})
        if not isinstance(trigger, dict):
            trigger = {}
        return str(trigger.get("failure_class", "deterministic") or "deterministic")

    return {
        "available": actions_file.is_file(),
        "binding_file": "ops/bindings/recovery.actions.yaml",
        "action_count": len(actions),
        "deterministic_actions": sum(1 for item in actions if _failure_class(item) == "deterministic"),
        "freshness_actions": sum(1 for item in actions if _failure_class(item) == "freshness"),
        "attempt_count": attempt_count,
        "cooldown_count": cooldown_count,
        "audit_log": str(audit_log),
        "last_audit_utc": last_audit_utc,
        "audit_mtime_utc": _path_mtime_utc(audit_log),
        "recent_audit": recent_audit,
    }


def _collect_time_machine_runtime() -> dict:
    if sys.platform != "darwin" or shutil.which("tmutil") is None:
        return {"available": False, "status": "unsupported", "running": False}

    status_out, status_ok = _run(["tmutil", "status"])
    latest_out, latest_ok = _run(["tmutil", "latestbackup"])
    running = False
    phase = ""
    percent = ""
    if status_ok:
        running = bool(re.search(r"\bRunning\s*=\s*1\b", status_out))
        phase_match = re.search(r"\b(Phase|State)\s*=\s*\"?([^\";\n]+)", status_out)
        percent_match = re.search(r"\bPercent\s*=\s*([0-9.]+)", status_out)
        phase = phase_match.group(2).strip() if phase_match else ""
        percent = percent_match.group(1).strip() if percent_match else ""

    return {
        "available": status_ok or latest_ok,
        "status": "ok" if status_ok else "unavailable",
        "running": running,
        "phase": phase,
        "percent": percent,
        "latest_backup": latest_out if latest_ok else "",
        "latest_backup_error": "" if latest_ok else latest_out,
    }


def _collect_backup_monitor_runtime() -> dict:
    state_file = STATE_ROOT / "backup-monitor.state"
    if not state_file.is_file():
        return {"available": False, "source": str(state_file), "last_run_utc": ""}
    try:
        text = state_file.read_text(encoding="utf-8", errors="replace").strip()
    except Exception:
        text = ""
    epoch_text = text.split("|", 1)[0].strip() if text else ""
    last_run_utc = ""
    try:
        last_run_utc = datetime.fromtimestamp(int(epoch_text), tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except Exception:
        last_run_utc = _path_mtime_utc(state_file)
    return {
        "available": True,
        "source": str(state_file),
        "last_run_utc": last_run_utc,
        "file_mtime_utc": _path_mtime_utc(state_file),
    }


def collect_recovery_estate(generated_utc: str, status: dict, active_loops: dict) -> dict:
    """Read-only recovery/estate posture for the generated cockpit."""
    backup = _collect_backup_posture_snapshot()
    recovery = _collect_recovery_runtime()
    time_machine = _collect_time_machine_runtime()
    backup_monitor = _collect_backup_monitor_runtime()

    loops = active_loops.get("items", []) if isinstance(active_loops.get("items"), list) else []
    recovery_terms = ("RECOVERY", "BACKUP", "RESTORE", "ESTATE")
    recovery_loops = [
        item for item in loops
        if any(term in (str(item.get("id", "")) + " " + str(item.get("title", ""))).upper() for term in recovery_terms)
    ]
    gaps = status.get("open_gaps", []) if isinstance(status.get("open_gaps"), list) else []
    recovery_gaps = [
        gap for gap in gaps
        if any(term.lower() in (str(gap.get("gap_id", "")) + " " + str(gap.get("description", ""))).lower() for term in recovery_terms)
    ]

    degraded_total = int(backup.get("degraded_total", 0) or 0)
    missing_restore = int(backup.get("restore_coverage_missing_total", 0) or 0)
    lane_over_budget = int(backup.get("lane_over_budget_total", 0) or 0)
    running = bool(time_machine.get("running", False))
    if degraded_total or missing_restore or lane_over_budget or recovery_gaps:
        posture = "attention"
    elif not backup.get("available") and not time_machine.get("available"):
        posture = "unknown"
    else:
        posture = "ok"

    last_generated_utc = _latest_utc(backup.get("generated_at_utc"), backup.get("file_mtime_utc"), generated_utc)
    last_ran_utc = _latest_utc(
        backup.get("generated_at_utc"),
        backup_monitor.get("last_run_utc"),
        recovery.get("last_audit_utc"),
        recovery.get("audit_mtime_utc"),
    )
    caption_parts = [
        f"last generated {last_generated_utc or 'unknown'}",
        f"last ran {last_ran_utc or 'unknown'}",
        f"running {'yes' if running else 'no'}",
    ]

    return {
        "posture": posture,
        "generated_utc": generated_utc,
        "caption": " · ".join(caption_parts),
        "last_generated_utc": last_generated_utc,
        "last_ran_utc": last_ran_utc,
        "running": running,
        "backup_posture": backup,
        "backup_monitor": backup_monitor,
        "recovery_runtime": recovery,
        "time_machine": time_machine,
        "open_recovery_loops": {
            "count": len(recovery_loops),
            "items": recovery_loops[:6],
        },
        "gaps": {
            "count": len(gaps),
            "recovery_count": len(recovery_gaps),
            "items": recovery_gaps[:6],
        },
    }


# ---------------------------------------------------------------------------
# Human input readback surface
# ---------------------------------------------------------------------------

def _classify_input(filename: str, binding_13: dict | None, binding_16: dict | None,
                    state_map: dict | None) -> dict:
    """Classify a single raw input file using the binding/state-map artifacts."""
    # Default
    result = {"file": filename, "state": "staged", "disposition": "unknown",
              "next_move": "needs classification", "downstream": []}
    return result


def _collect_blueprint_admission_summary() -> dict:
    """Summarize old blueprint batches from the admission matrix.

    The raw batch folders are historical source material. Public readback should
    point at the first-class admission matrix rather than recount the folders as
    a live input lane.
    """
    contract = REPO / "ops" / "bindings" / "operator.blueprint.admission.yaml"
    data = _yaml_load(contract)
    if not isinstance(data, dict):
        return {"available": False, "count": 0, "decisions": {}, "statuses": {}}
    entries = data.get("entries", [])
    if not isinstance(entries, list):
        entries = []
    decisions: dict[str, int] = {}
    statuses: dict[str, int] = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        decision = str(entry.get("decision", "unknown") or "unknown")
        status = str(entry.get("status", "unknown") or "unknown")
        decisions[decision] = decisions.get(decision, 0) + 1
        statuses[status] = statuses.get(status, 0) + 1
    return {
        "available": True,
        "count": len(entries),
        "source": "ops/bindings/operator.blueprint.admission.yaml",
        "decisions": decisions,
        "statuses": statuses,
    }


def _collect_human_intent_inventory_summary() -> dict:
    try:
        inventory = hii.build_inventory(
            repo=REPO,
            state_root=STATE_ROOT,
            evidence_root=EVIDENCE_ROOT,
            oi_limit=None,
        )
    except Exception as exc:
        return {
            "available": False,
            "error": str(exc),
            "summary": {},
            "attention": [],
        }
    summary = inventory.get("summary", {})
    attention = [
        {
            "source_id": row.get("source_id", ""),
            "source_ref": row.get("source_ref", ""),
            "canonical_state": row.get("canonical_state", ""),
            "disposition": row.get("disposition", ""),
            "capture_status": row.get("capture_status", ""),
            "review_status": row.get("review_status", ""),
            "next_missing_step": row.get("next_missing_step", ""),
        }
        for row in inventory.get("items", [])
        if row.get("disposition") == "needs_operator_decision"
        or row.get("capture_status") == "semantic_only"
        or row.get("review_status") == "source_not_linked"
        or (
            row.get("next_missing_step")
            and row.get("next_missing_step") != "none"
            and row.get("source_kind") in {"path_drop_source", "operator_ingress"}
        )
    ][:12]
    return {
        "available": True,
        "capability": "human.intent.inventory.status",
        "operator_model": "one_human_intent_lifecycle_many_source_origins",
        "summary": summary,
        "attention": attention,
    }


def collect_human_input() -> dict:
    """Collect canonical human-steward input readback.

    The public/root readback is OI/HI plus blueprint admission summary.
    Historical blueprint folders remain evidence, but they are not counted as a
    live front-door lane here.
    """
    inputs_root = STATE_ROOT / "inputs"

    # --- Live operator ingress ------------------------------------------------
    recent_ingress: list[dict] = []
    pending_ingress = 0
    ingress_dir = inputs_root / "operator-ingress"
    if ingress_dir.is_dir():
        for path in sorted(ingress_dir.glob("OI-*.yaml"), reverse=True)[:10]:
            doc = _yaml_load(path)
            if not isinstance(doc, dict):
                continue
            lifecycle_state = str(doc.get("lifecycle_state", "submitted"))
            disposition = str(doc.get("disposition", "awaiting_classification"))
            disposition_detail = str(
                doc.get(
                    "disposition_detail",
                    "Raw input preserved; awaiting membrane classification.",
                )
            )
            item = {
                "ingress_id": str(doc.get("ingress_id", path.stem)),
                "submitted_at": str(doc.get("submitted_at", "")),
                "content_type": str(doc.get("content_type", "")),
                "operator_hint": str(doc.get("operator_hint", "")),
                "lifecycle_state": lifecycle_state,
                "disposition": disposition,
                "disposition_detail": disposition_detail,
                "source_device": str(doc.get("source_device", "")),
                "source_app": str(doc.get("source_app", "")),
            }
            # Include metabolization fields when present
            if "classification" in doc:
                item["classification"] = str(doc["classification"])
            if "next_stage" in doc:
                item["next_stage"] = str(doc["next_stage"])
            if "downstream_refs" in doc:
                item["downstream_refs"] = doc["downstream_refs"]
            if "activation_conditions" in doc:
                item["activation_conditions"] = str(doc["activation_conditions"])
            if "classified_at" in doc:
                item["classified_at"] = str(doc["classified_at"])
            if "routed_at" in doc:
                item["routed_at"] = str(doc["routed_at"])
            # Adoption fields (written by reconciler, read-only here)
            for af in (
                "adoption_state", "adoption_ref", "adoption_ref_kind",
                "adopted_at", "landed_at", "reconciled_at", "reconciliation_reason",
                "operator_review", "review_reason",
            ):
                if af in doc:
                    item[af] = doc[af]
            # Human intent fields (read from nested human_intent object)
            human_intent = doc.get("human_intent")
            if isinstance(human_intent, dict):
                hi_id = human_intent.get("intent_id", "")
                if hi_id:
                    item["human_intent_id"] = str(hi_id)
                hi_stmt = human_intent.get("statement", "")
                if hi_stmt:
                    item["human_intent_statement"] = str(hi_stmt)
            translator_workload = doc.get("translator_workload")
            if isinstance(translator_workload, dict):
                w1 = translator_workload.get("W1")
                if isinstance(w1, dict):
                    if "concern_class" in w1:
                        item["concern_class"] = str(w1["concern_class"])
                    if "confidence" in w1:
                        item["confidence"] = w1["confidence"]
                w2 = translator_workload.get("W2")
                if isinstance(w2, dict) and "routing_target" in w2:
                    item["routing_target"] = str(w2["routing_target"])
                w3 = translator_workload.get("W3")
                if isinstance(w3, dict) and "execution_dispatched" in w3:
                    item["execution_dispatched"] = bool(w3["execution_dispatched"])
            item["intent_chain_readback"] = oi.build_intent_chain_readback(
                doc,
                state_root=str(STATE_ROOT),
                path=path,
            )
            recent_ingress.append(item)
            if disposition == "awaiting_classification" or lifecycle_state in {
                "submitted",
                "preserved",
            }:
                pending_ingress += 1

    blueprint_admission = _collect_blueprint_admission_summary()
    human_intent_inventory = _collect_human_intent_inventory_summary()
    inv_summary = human_intent_inventory.get("summary", {}) if human_intent_inventory.get("available") else {}
    total_raw = int(inv_summary.get("total_rows", 0) or 0) or (
        len(recent_ingress) + int(blueprint_admission.get("count", 0) or 0)
    )

    # --- Assemble -------------------------------------------------------------
    return {
        "my_human_work_now": {
            "total_raw_inputs": total_raw,
            "recent_ingress": len(recent_ingress),
            "pending_ingress": pending_ingress,
            "pending_new_submissions": pending_ingress,
            "blueprint_admission": int(blueprint_admission.get("count", 0) or 0),
            "known_input_sources": total_raw,
            "source_not_linked": int(inv_summary.get("source_not_linked", 0) or 0),
            "semantic_only": int(inv_summary.get("semantic_only", 0) or 0),
            "needs_operator_decision": int(inv_summary.get("needs_operator_decision", 0) or 0),
            "float_risk_count": 0,
        },
        "recent_ingress": recent_ingress,
        "blueprint_admission": blueprint_admission,
        "human_intent_inventory": human_intent_inventory,
        "what_is_waiting_on_me": {
            "parked_without_lifecycle": 0,
            "floating_items": 0,
            "pending_ingress": pending_ingress,
            "items": [
                {"file": item["ingress_id"], "detail": item["disposition_detail"], "disposition": item["disposition"]}
                for item in recent_ingress if item["disposition"] == "awaiting_classification"
            ],
        },
        "chain_status": {
            "ronny_drops": "standing",
            "translated_to_machine": "standing",
            "organized_sorted": "standing",
            "moved_to_next_stage": "review_required" if any(
                i.get("intent_chain_readback", {}).get("operator_review", {}).get("state") == "required"
                for i in recent_ingress
            ) else "standing" if any(
                i.get("lifecycle_state") in ("classified", "routed")
                for i in recent_ingress
            ) else "partial",
            "visible_trace": "review_required" if any(
                i.get("intent_chain_readback", {}).get("operator_review", {}).get("state") == "required"
                for i in recent_ingress
            ) else "standing" if any(
                i.get("lifecycle_state") == "routed"
                for i in recent_ingress
            ) else "partial",
            "readback_surface": "this_surface",
        },
    }


def _iter_yaml_docs(path: Path) -> list[dict]:
    import yaml

    try:
        text = path.read_text(errors="replace")
    except OSError:
        return []

    docs: list[dict] = []
    if path.suffix in (".yaml", ".yml"):
        try:
            parsed = yaml.safe_load(text)
        except Exception:
            return []
        if isinstance(parsed, dict):
            docs.append(parsed)
        return docs

    if path.suffix != ".md":
        return []

    for match in _YAML_FENCE.finditer(text):
        try:
            parsed = yaml.safe_load(match.group(1))
        except Exception:
            continue
        if isinstance(parsed, dict):
            docs.append(parsed)
    return docs


def _find_parked_containers(data: object) -> list[tuple[dict, dict]]:
    found: list[tuple[dict, dict]] = []
    if isinstance(data, dict):
        lifecycle = data.get("parked_lifecycle")
        if isinstance(lifecycle, dict):
            found.append((data, lifecycle))
        for value in data.values():
            found.extend(_find_parked_containers(value))
    elif isinstance(data, list):
        for value in data:
            found.extend(_find_parked_containers(value))
    return found


def _parked_item_name(path: Path, container: dict, root_doc: dict) -> str:
    candidates: list[object] = []
    for source in (container, root_doc):
        if not isinstance(source, dict):
            continue
        candidates.extend(
            [
                source.get("title"),
                source.get("name"),
                source.get("id"),
                source.get("source_file"),
            ]
        )
        artifact = source.get("artifact")
        if isinstance(artifact, dict):
            candidates.extend(
                [
                    artifact.get("title"),
                    artifact.get("name"),
                    artifact.get("id"),
                    artifact.get("source_file"),
                ]
            )
    for candidate in candidates:
        text = str(candidate or "").strip()
        if text:
            return text
    return path.stem


def _parked_location(path: Path) -> str:
    text = str(path)
    if "/domain-state/spine/" in text:
        return "runtime/spine"
    if "/domain-state/" in text:
        return "runtime/domain-state"
    return "other"


def collect_parked_inventory(now_dt: datetime) -> dict:
    items: list[dict] = []
    domain_state = STATE_ROOT / "domain-state"
    if not domain_state.is_dir():
        return {"count": 0, "review_summary": summarize_temporal_states([], "review_state"), "items": []}

    seen: set[tuple[str, str]] = set()
    for path in sorted(domain_state.rglob("*")):
        if path.is_dir() or path.suffix not in (".yaml", ".yml", ".md"):
            continue
        for parsed in _iter_yaml_docs(path):
            for container, lifecycle in _find_parked_containers(parsed):
                status = str(lifecycle.get("status", "parked") or "parked").lower()
                if status != "parked":
                    continue
                name = _parked_item_name(path, container, parsed)
                dedupe_key = (str(path), name)
                if dedupe_key in seen:
                    continue
                seen.add(dedupe_key)

                next_review = lifecycle.get("next_review")
                due_seconds = _seconds_until(next_review, now_dt)
                review_state = classify_due_window(due_seconds)
                evidence_field = "next_review" if next_review else ""
                evidence_at = str(next_review) if next_review else ""

                if not evidence_field:
                    for field in (
                        "parked_at",
                        "entered_at",
                        "created_at_utc",
                        "created_at",
                        "created",
                        "reviewed_at",
                        "closed_at",
                        "superseded_at",
                    ):
                        value = lifecycle.get(field)
                        if value:
                            evidence_field = field
                            evidence_at = str(value)
                            review_state = classify_temporal_age(_seconds_since(value, now_dt))
                            due_seconds = None
                            break

                if not evidence_field:
                    artifact = container.get("artifact") if isinstance(container.get("artifact"), dict) else {}
                    created_value = artifact.get("created") if isinstance(artifact, dict) else ""
                    if created_value:
                        evidence_field = "created"
                        evidence_at = str(created_value)
                        review_state = classify_temporal_age(_seconds_since(created_value, now_dt))

                item = {
                    "name": name,
                    "path": str(path),
                    "location": _parked_location(path),
                    "temporal_state": "parked",
                    "review_state": review_state,
                    "next_review": str(next_review) if next_review else None,
                    "time_evidence_field": evidence_field or "unknown",
                    "time_evidence_at": evidence_at or None,
                    "due_in_seconds": due_seconds,
                    "parked_reason": str(lifecycle.get("parked_reason", "")),
                }
                items.append(item)

    items.sort(key=lambda item: (item["review_state"], item["name"].lower()))
    review_summary = summarize_temporal_states(items, "review_state")
    return {
        "count": len(items),
        "review_summary": review_summary,
        "items": items,
    }


def collect_temporal_standing(
    generated_utc: str,
    projection_freshness: dict,
    human_input: dict,
    active_handoffs: dict,
    work_state: dict,
) -> dict:
    now_dt = _parse_utc(generated_utc) or datetime.now(timezone.utc)

    ingress_items = []
    for item in human_input.get("recent_ingress", []):
        evidence_field = ""
        evidence_at = ""
        for field in ("routed_at", "classified_at", "submitted_at"):
            if item.get(field):
                evidence_field = field
                evidence_at = str(item.get(field, ""))
                break
        age_seconds = _seconds_since(evidence_at, now_dt)
        temporal_state = classify_temporal_age(age_seconds)
        enriched = dict(item)
        enriched["temporal_state"] = temporal_state
        enriched["time_evidence_field"] = evidence_field or "unknown"
        enriched["time_evidence_at"] = evidence_at or None
        enriched["time_age_seconds"] = age_seconds
        ingress_items.append(enriched)
    human_input["recent_ingress"] = ingress_items
    ingress_summary = summarize_temporal_states(ingress_items)

    handoff_items = []
    for item in active_handoffs.get("items", []):
        created_age = _seconds_since(item.get("created_at_utc"), now_dt)
        expires_in = _seconds_until(item.get("expires_at_utc"), now_dt)
        temporal_state = classify_temporal_age(created_age)
        evidence_field = "created_at_utc"
        evidence_at = item.get("created_at_utc")
        if expires_in is not None and expires_in < 0:
            temporal_state = "stale"
            evidence_field = "expires_at_utc"
            evidence_at = item.get("expires_at_utc")
        enriched = dict(item)
        enriched["temporal_state"] = temporal_state
        enriched["time_evidence_field"] = evidence_field
        enriched["time_evidence_at"] = evidence_at or None
        enriched["time_age_seconds"] = created_age
        enriched["expires_in_seconds"] = expires_in
        handoff_items.append(enriched)
    active_handoffs["items"] = handoff_items
    handoff_summary = summarize_temporal_states(handoff_items)

    parked_inventory = collect_parked_inventory(now_dt)

    completion = work_state.get("completion_state", {})
    snapshot_timestamp = completion.get("snapshot_timestamp")
    snapshot_age_seconds = _seconds_since(snapshot_timestamp, now_dt)
    completion_snapshot = {
        "temporal_state": classify_temporal_age(snapshot_age_seconds),
        "snapshot_timestamp": str(snapshot_timestamp or ""),
        "snapshot_age_seconds": snapshot_age_seconds,
        "closed_count": int(completion.get("delivered", 0) or 0),
        "parked_count": int(completion.get("parked", 0) or 0),
        "open_count": int(completion.get("open", 0) or 0),
        "ambiguous_count": int(completion.get("ambiguous", 0) or 0),
    }

    summary = {"now": 0, "recent": 0, "stale": 0, "parked": parked_inventory["count"], "closed": completion_snapshot["closed_count"], "unknown": 0}
    for state in ("now", "recent", "stale", "unknown"):
        summary[state] += ingress_summary.get(state, 0)
        summary[state] += handoff_summary.get(state, 0)
    projection_state = str(projection_freshness.get("temporal_state", "unknown"))
    if projection_state in summary:
        summary[projection_state] += 1
    else:
        summary["unknown"] += 1
    snapshot_state = completion_snapshot["temporal_state"]
    if snapshot_state in summary:
        summary[snapshot_state] += 1
    else:
        summary["unknown"] += 1
    summary["unknown"] += parked_inventory["review_summary"].get("unknown", 0)

    return {
        "generated_utc": generated_utc,
        "model": {
            "states": ["now", "recent", "stale", "parked", "closed"],
            "unknown_state": "unknown",
            "thresholds": {
                "now_hours": TEMPORAL_NOW_SECONDS // 3600,
                "recent_hours": TEMPORAL_RECENT_SECONDS // 3600,
                "review_due_soon_days": TEMPORAL_REVIEW_SOON_SECONDS // (24 * 3600),
            },
            "rule": "Read-side only. Derived from existing timestamps and lifecycle fields already present in runtime evidence. Missing evidence stays unknown.",
        },
        "summary": summary,
        "projection": {
            "temporal_state": projection_state,
            "source": projection_freshness.get("source", "unknown"),
            "evidence_at": projection_freshness.get("sync_marker_utc")
            or projection_freshness.get("state_db_mtime_utc"),
            "age_seconds": projection_freshness.get("age_seconds"),
        },
        "operator_to_agents": {
            "count": len(ingress_items),
            "summary": ingress_summary,
            "items": ingress_items,
        },
        "agents_to_operator": {
            "count": len(handoff_items),
            "summary": handoff_summary,
            "items": handoff_items,
        },
        "parked_inventory": parked_inventory,
        "completion_snapshot": completion_snapshot,
    }


# ---------------------------------------------------------------------------
# Desktop-only extensions (not in compact mode)
# ---------------------------------------------------------------------------

def collect_git_log(n: int = 30) -> list[dict]:
    out, ok = _run(["git", "log", "--oneline", f"-n{n}", "--format=%H|%h|%ai|%s"])
    if not ok:
        return []
    entries = []
    for line in out.splitlines():
        parts = line.split("|", 3)
        if len(parts) == 4:
            entries.append({"full": parts[0], "short": parts[1], "date": parts[2][:10], "subject": parts[3]})
    return entries


def collect_capabilities() -> dict:
    data = _yaml_load(REPO / "ops" / "capabilities.yaml")
    if not data or "capabilities" not in data:
        return {"caps": {}, "count": 0}
    caps = data["capabilities"]
    return {"caps": caps, "count": len(caps)}


def collect_gates() -> dict:
    reg = _yaml_load(REPO / "ops" / "bindings" / "gate.registry.yaml")
    topo = _yaml_load(REPO / "ops" / "bindings" / "gate.execution.topology.yaml")
    result = {
        "total": 0, "active": 0, "retired": 0,
        "blocking": 0, "report": 0,
        "core_ids": [], "gates": [], "categories": [],
    }
    if reg:
        gc = reg.get("gate_count", {})
        result["total"] = gc.get("total", 0)
        result["active"] = gc.get("active", 0)
        result["retired"] = gc.get("retired", 0)
        result["blocking"] = gc.get("active_blocking", 0)
        result["report"] = gc.get("active_report", 0)
        result["categories"] = reg.get("categories", [])
        result["gates"] = reg.get("gates", [])
    if topo:
        cm = topo.get("core_mode", {})
        result["core_ids"] = cm.get("core_gate_ids", [])
    return result


def collect_manifest() -> dict:
    data = _yaml_load(STATE_ROOT / "domain-state" / "SPINE_SURFACE_MANIFEST.yaml")
    if not data:
        return {"surfaces": [], "count": 0, "families": [], "available": False}
    surfaces = data.get("surfaces", [])
    families = data.get("workflow_families", [])
    return {
        "surfaces": surfaces,
        "count": len(surfaces),
        "families": families,
        "entry_chain": data.get("entry_chain", []),
        "generated_at": data.get("generated_at_utc", ""),
        "available": True,
    }


def collect_invocation_counts() -> dict[str, int]:
    counts: dict[str, int] = {}
    sessions_root = EVIDENCE_ROOT / "sessions"
    if not sessions_root.exists():
        return counts
    for path in sessions_root.iterdir():
        if not path.is_dir():
            continue
        parts = path.name.split("__")
        if len(parts) < 3:
            continue
        counts[parts[1]] = counts.get(parts[1], 0) + 1
    return counts


# ---------------------------------------------------------------------------
# Evidence reviews
# ---------------------------------------------------------------------------

def collect_evidence_reviews() -> list[dict]:
    """Scan .evidence/spine/reviews/ for review-meta.yaml files."""
    def _int_field(value) -> int:
        try:
            return int(value or 0)
        except (TypeError, ValueError):
            return 0

    reviews_dir = EVIDENCE_ROOT / "reviews"
    if not reviews_dir.is_dir():
        return []
    items: list[dict] = []
    for meta_path in sorted(reviews_dir.glob("*/review-meta.yaml"), reverse=True):
        doc = _yaml_load(meta_path)
        if not isinstance(doc, dict):
            continue
        cs = doc.get("claim_summary", {})
        if not isinstance(cs, dict):
            cs = {}
        source_files = doc.get("source_files", [])
        if not isinstance(source_files, list):
            source_files = []
        downstream_refs = doc.get("downstream_refs", [])
        if isinstance(downstream_refs, str):
            downstream_refs = [ref.strip() for ref in downstream_refs.split(",") if ref.strip()]
        elif not isinstance(downstream_refs, list):
            downstream_refs = []
        items.append({
            "review_id": doc.get("review_id", meta_path.parent.name),
            "bundle_slug": doc.get("bundle_slug", ""),
            "context_domain": doc.get("context_domain", ""),
            "created_at": doc.get("created_at", ""),
            "actor_source": doc.get("actor_source", "unknown"),
            "bundle_file_count": _int_field(doc.get("bundle_file_count", 0)),
            "source_files": [str(path) for path in source_files],
            "operator_note": doc.get("operator_note", ""),
            "claim_summary": {
                "reviewed": _int_field(cs.get("reviewed", 0)),
                "adopted": _int_field(cs.get("adopted", 0)),
                "parked": _int_field(cs.get("parked", 0)),
                "residue": _int_field(cs.get("residue", 0)),
                "followup": _int_field(cs.get("followup", 0)),
                "tension": _int_field(cs.get("tension", 0)),
            },
            "downstream_refs": [str(ref) for ref in downstream_refs],
        })
    return items[:10]


# ---------------------------------------------------------------------------
# Payload assembly
# ---------------------------------------------------------------------------

def build_payload(compact: bool = False) -> dict:
    """Build the shared operator overview payload.

    compact=False: full payload for desktop cockpit (includes git log, caps, gates, manifest)
    compact=True:  phone-priority subset (spine_now through read_only_posture only)
    """
    status = _run_json([str(REPO / "bin" / "ops"), "status", "--json"])
    refs = collect_git_refs()
    generated_utc = utcnow()
    previous_payload = _load_previous_operator_payload()
    human_input = collect_human_input()
    projection_freshness = collect_projection_freshness()
    attention = collect_attention(status, refs)
    active_handoffs = collect_active_handoffs()
    work_state = collect_work_state(status)
    terminal_telemetry = collect_terminal_telemetry(status)
    delegations = collect_delegations(status)
    temporal_standing = collect_temporal_standing(
        generated_utc,
        projection_freshness,
        human_input,
        active_handoffs,
        work_state,
    )

    # Compute posture first — the router's primary loop drives focus selection.
    current_posture = collect_current_posture()

    active_loops = collect_active_loops(status)

    # Extract the router's recommended loop ID from posture to ensure focus
    # structurally agrees with compute_routing(), not just coincidentally.
    # Only treat the router's choice as canonical when routing_state is
    # healthy — ambiguous/degraded routing emits provisional hints that
    # must not be promoted to high-confidence focus.
    router_primary_id = ""
    routing_state = current_posture.get("routing_state", "") if current_posture.get("available") else ""
    if routing_state and routing_state not in ("ambiguous", "degraded", "error"):
        cmd = current_posture.get("recommended_command", "")
        parts = cmd.split()
        if parts and parts[-1].startswith("LOOP-"):
            router_primary_id = parts[-1]
    active_loops["focus"] = _select_focus(active_loops.get("items", []), router_primary_id)
    continuity = collect_continuity(previous_payload, active_loops.get("items", []))
    recovery_estate = collect_recovery_estate(generated_utc, status, active_loops)
    operator_cockpit = collect_operator_cockpit_contract(generated_utc)

    payload: dict = {
        "version": 5,
        "generated_utc": generated_utc,
        "operator_cockpit": operator_cockpit,
        "continuity": continuity,
        "human_input": human_input,
        "spine_now": collect_spine_now(status),
        "temporal_truth": collect_temporal_truth(status),
        "projection_freshness": projection_freshness,
        "attention": attention,
        "active_loops": active_loops,
        "active_handoffs": active_handoffs,
        "work_state": work_state,
        "terminal_telemetry": terminal_telemetry,
        "delegations": delegations,
        "git_refs": refs,
        "node_roles": collect_node_roles(status),
        "current_posture": current_posture,
        "aperture": collect_aperture_summary(),
        "proposals": collect_proposals(),
        "birth_mode_audit": collect_birth_mode_audit(),
        "standing_program_health": collect_standing_program_health(status),
        "directional_boundary": collect_directional_boundary(
            human_input, active_handoffs, attention
        ),
        "temporal_standing": temporal_standing,
        "recovery_estate": recovery_estate,
        "evidence_reviews": collect_evidence_reviews(),
    }

    # Front door aggregation — reads from the payload built above
    payload["operator_front_door"] = collect_operator_front_door(payload)

    if not compact:
        payload["git_log"] = collect_git_log(30)
        payload["capabilities"] = collect_capabilities()
        payload["gates"] = collect_gates()
        payload["manifest"] = collect_manifest()
        payload["invocation_counts"] = collect_invocation_counts()

    return payload


def main() -> int:
    parser = argparse.ArgumentParser(description="Shared operator overview payload")
    parser.add_argument("--compact", action="store_true", help="Phone-priority compact subset")
    parser.add_argument("--output", type=str, default="", help="Write to file instead of stdout")
    args = parser.parse_args()

    payload = build_payload(compact=args.compact)

    output = json.dumps(payload, indent=2)
    if args.output:
        Path(args.output).parent.mkdir(parents=True, exist_ok=True)
        Path(args.output).write_text(output)
        print(f"payload written → {args.output}")
    else:
        print(output)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
