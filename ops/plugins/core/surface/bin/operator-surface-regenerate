#!/usr/bin/env python3
"""operator-surface-regenerate — compile shared payload and write both leaves.

Generates:
  $SPINE_STATE/operator-surface/index.html     (cockpit, desktop-first)
  $SPINE_STATE/operator-surface/mobile.json    (compact phone view)
  $SPINE_STATE/operator-surface/payload.json   (full shared payload)

Called by a timer, not by the server.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
REPO = BIN.parents[4]
STATE_ROOT = Path(
    os.environ.get(
        "SPINE_STATE",
        str(Path.home() / "code" / ".runtime" / "spine" / "state"),
    )
)
OUTPUT_DIR = STATE_ROOT / "operator-surface"


def _load_module(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def main() -> int:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    # Load shared payload generator
    payload_mod = _load_module("operator_overview_payload", BIN / "operator-overview-payload")

    # Generate full payload
    full_payload = payload_mod.build_payload(compact=False)
    (OUTPUT_DIR / "payload.json").write_text(json.dumps(full_payload, indent=2))

    # Generate compact mobile payload via mobile-dashboard-status leaf
    mobile_mod = _load_module("mobile_dashboard_status", BIN / "mobile-dashboard-status")
    # mobile-dashboard-status.main() prints to stdout; call build logic directly
    compact_payload = payload_mod.build_payload(compact=True)
    ov = compact_payload.get("operator_vision", {})
    mhw = ov.get("my_human_work_now", {})
    chain = ov.get("chain_status", {})
    waiting = ov.get("what_is_waiting_on_me", {})
    recent_ingress = ov.get("recent_ingress", [])
    traces = ov.get("what_became_of_my_input", [])
    compact_traces = [
        {"file": t["file"], "batch": t["batch"], "disposition": t["disposition"],
         "detail": t["detail"][:100]}
        for t in traces
    ]
    built = ov.get("what_my_ideas_built", {})
    directional_boundary = compact_payload.get("directional_boundary", {})
    temporal_standing = compact_payload.get("temporal_standing", {})
    temporal_truth = compact_payload.get("temporal_truth", {})
    verify_temporal = temporal_truth.get("verify", {}) if isinstance(temporal_truth, dict) else {}
    comms_temporal = temporal_truth.get("comms_queue", {}) if isinstance(temporal_truth, dict) else {}
    daemon_temporal = temporal_truth.get("daemons", {}) if isinstance(temporal_truth, dict) else {}
    node_roles = compact_payload.get("node_roles", {})
    breakdown = node_roles.get("non_local_breakdown", {}) if isinstance(node_roles, dict) else {}
    daemon_locality = {
        "local_role": node_roles.get("local_role", ""),
        "actionable_local_missing": 0,
        "execution_host": node_roles.get("execution_host_target", ""),
        "temporal_class": daemon_temporal.get("temporal_class", ""),
        "operator_treatment": daemon_temporal.get("operator_treatment", ""),
        "summary": {
            "active_elsewhere": len(breakdown.get("active_elsewhere", [])),
            "parked_required": len(breakdown.get("parked_required", [])),
            "locality_exempt": len(breakdown.get("locality_exempt", [])),
            "other": len(breakdown.get("other", [])),
        },
    }
    spine_now = dict(compact_payload["spine_now"])
    spine_now["verify_temporal_class"] = verify_temporal.get("temporal_class", "")
    spine_now["verify_known_since_utc"] = verify_temporal.get("known_since_utc", "")
    spine_now["verify_standing_evidence_count"] = verify_temporal.get("standing_evidence_count", 0)
    mobile = {
        "capability": "surface.mobile.dashboard.status",
        "version": compact_payload["version"],
        "generated_utc": compact_payload["generated_utc"],
        "my_human_work_now": {
            "total_raw_inputs": mhw.get("total_raw_inputs", 0),
            "recent_ingress": mhw.get("recent_ingress", 0),
            "pending_ingress": mhw.get("pending_ingress", 0),
            "advanced_to_contract": mhw.get("advanced_to_contract", 0),
            "adjacent_evidence": mhw.get("adjacent_evidence", 0),
            "parked_prep": mhw.get("parked_prep", 0),
            "parked_no_lifecycle": mhw.get("parked_no_lifecycle", 0),
            "out_of_spine": mhw.get("out_of_spine", 0),
            "float_risk_count": mhw.get("float_risk_count", 0),
            "delivered_packets": mhw.get("delivered_packets", 0),
            "contracts": mhw.get("contracts", 0),
        },
        "recent_ingress": recent_ingress[:10],
        "directional_boundary": directional_boundary,
        "temporal_standing": temporal_standing,
        "chain_status": chain,
        "what_became_of_my_input": compact_traces,
        "what_my_ideas_built": {
            "contracts": built.get("contracts", []),
            "delivered_packets": built.get("delivered_packets", []),
            "derived_conclusions": built.get("derived_conclusions", []),
        },
        "what_is_waiting_on_me": {
            "parked_without_lifecycle": waiting.get("parked_without_lifecycle", 0),
            "floating_items": waiting.get("floating_items", 0),
            "pending_ingress": waiting.get("pending_ingress", 0),
        },
        "spine_now": spine_now,
        "temporal_truth": temporal_truth,
        "projection_freshness": compact_payload["projection_freshness"],
        "attention_now": compact_payload["attention"][:5],
        "active_loops": {
            "count": compact_payload["active_loops"]["count"],
            "items": compact_payload["active_loops"]["items"][:5],
        },
        "active_handoffs": {
            "count": compact_payload["active_handoffs"]["count"],
            "items": compact_payload["active_handoffs"]["items"][:3],
        },
        "read_only_posture": {
            "surface_type": "supervision",
            "mutation_allowed": False,
            "guidance": "Read-only phone surface. Use MBP or SSH terminal for mutations.",
        },
        "daemon_locality": daemon_locality,
        "_secondary": {
            "proposals": compact_payload["proposals"],
            "completion_state": compact_payload["work_state"]["completion_state"],
            "inbox_active": compact_payload["work_state"]["inbox_active"],
            "comms_queue_pending": compact_payload["work_state"]["comms_queue"]["pending"],
            "comms_queue_temporal_class": comms_temporal.get("temporal_class", ""),
            "daemon_temporal_class": daemon_temporal.get("temporal_class", ""),
        },
    }
    (OUTPUT_DIR / "mobile.json").write_text(json.dumps(mobile, indent=2))

    # Generate cockpit HTML
    cockpit_mod = _load_module("cockpit_generate", BIN / "cockpit-generate")
    cockpit_html = cockpit_mod.generate(full_payload)
    (OUTPUT_DIR / "index.html").write_text(cockpit_html, encoding="utf-8")

    print(f"regenerated → {OUTPUT_DIR}/  (index.html, mobile.json, payload.json)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
