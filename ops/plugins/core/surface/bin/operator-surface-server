    .surface-tab.active {{ border-color:rgba(52,211,153,.35); background:rgba(52,211,153,.08); color:var(--g); }}
    .surface-tab-hint {{ font-size:.68rem; font-weight:500; letter-spacing:0; text-transform:none; color:var(--m); }}
    .card {{ background:var(--s); border:1px solid var(--b); border-radius:14px; padding:1rem; }}
    h1 {{ margin:0 0 .5rem; font-size:1rem; }}
