#!/usr/bin/env python3
"""operator-surface-server — tiny operator surface server.

Serves precomputed cockpit HTML and mobile JSON from a static directory, plus
bounded operator ingress form/POST and a phone-readable ingress readback page.

Dynamic paths:
  GET  /submit   → render operator ingress form
  POST /submit   → create non-authoritative operator ingress object
  GET  /ingress  → phone-readable readback of recent ingress objects
"""
from __future__ import annotations

import argparse
import html as html_mod
import json
import os
import subprocess
import sys
import threading
from functools import partial
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path
from urllib.parse import parse_qs, urlparse, quote


STATE_ROOT = Path(
    os.environ.get(
        "SPINE_STATE",
        str(Path.home() / "code" / ".runtime" / "spine" / "state"),
    )
)
DEFAULT_DIR = STATE_ROOT / "operator-surface"
DEFAULT_PORT = 8900
ROOT = Path(__file__).resolve().parents[5]
sys.path.insert(0, str(ROOT / "ops" / "plugins" / "core" / "lifecycle" / "lib"))

import operator_ingress as oi

_H = html_mod.escape
_REGEN_LOCK = threading.Lock()
_REGEN_THREAD: threading.Thread | None = None
_REGEN_PENDING = False


def _run_surface_regenerate() -> None:
    try:
        proc = subprocess.run(
            ["python3", str(ROOT / "ops" / "plugins" / "core" / "surface" / "bin" / "operator-surface-regenerate")],
            text=True,
            capture_output=True,
            check=False,
            timeout=90,
            env=os.environ.copy(),
        )
    except Exception as exc:
        print(f"warning: operator-surface-regenerate exception: {exc}", file=sys.stderr)
        return

    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        print(f"warning: operator-surface-regenerate failed: {err}", file=sys.stderr)


def _surface_regenerate_worker() -> None:
    global _REGEN_PENDING, _REGEN_THREAD

    while True:
        with _REGEN_LOCK:
            if not _REGEN_PENDING:
                _REGEN_THREAD = None
                return
            _REGEN_PENDING = False

        _run_surface_regenerate()


def _request_surface_regenerate_background() -> None:
    global _REGEN_PENDING, _REGEN_THREAD

    with _REGEN_LOCK:
        _REGEN_PENDING = True
        if _REGEN_THREAD is not None and _REGEN_THREAD.is_alive():
            return
        _REGEN_THREAD = threading.Thread(
            target=_surface_regenerate_worker,
            daemon=True,
        )
        _REGEN_THREAD.start()


def _surface_tab(label: str, href: str, hint: str, active: bool = False) -> str:
    if active:
        return (
            f'<span class="surface-tab active">{_H(label)}'
            f' <span class="surface-tab-hint">{_H(hint)}</span></span>'
        )
    return (
        f'<a class="surface-tab" href="{_H(href)}">{_H(label)}'
        f' <span class="surface-tab-hint">{_H(hint)}</span></a>'
    )


def _surface_nav(active: str) -> str:
    tabs = [
        _surface_tab("Board", "/", "glance view", active == "board"),
        _surface_tab("Submit", "/submit", "operator ingress", active == "submit"),
        _surface_tab("Submissions", "/ingress", "readback", active == "ingress"),
    ]
    return f'<div class="surface-nav" aria-label="Operator surface tabs">{"".join(tabs)}</div>'


def _render_page(title: str, body: str, *, active: str, eyebrow: str = "Operator Surface Family", subtitle: str = "") -> str:
    subtitle_html = f'<div class="page-subtitle">{_H(subtitle)}</div>' if subtitle else ""
    nav = _surface_nav(active)
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <style>
    :root {{
      --bg:#070b12; --s:#0f1622; --b:#223047; --t:#d8e2ee; --m:#9aabc0;
      --c:#22d3ee; --g:#34d399; --y:#fbbf24; --r:#f87171;
    }}
    * {{ box-sizing:border-box; }}
    body {{ margin:0; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif;
      background:var(--bg); color:var(--t); padding:1rem; }}
