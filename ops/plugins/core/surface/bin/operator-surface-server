    .helper-chip {{ display:inline-flex; align-items:center; gap:.35rem; padding:.38rem .58rem; border:1px solid var(--b); border-radius:999px; background:#0a111b; color:var(--m); font-size:.74rem; text-decoration:none; }}
    label {{ display:block; font-size:.85rem; font-weight:600; margin:.8rem 0 .35rem; }}
    input, select, textarea {{
      width:100%; background:#0a111b; color:var(--t); border:1px solid var(--b);
      border-radius:10px; padding:.75rem; font:inherit; font-size:16px;
    }}
    textarea {{ min-height:220px; resize:vertical; }}
    .btn {{
      display:block; width:100%; background:var(--c); color:#001017; border:none;
      border-radius:10px; padding:.9rem 1rem; font-weight:700; font-size:1rem;
      cursor:pointer; margin-top:1rem; -webkit-appearance:none;
    }}
    .btn:disabled {{ opacity:.5; cursor:not-allowed; }}
    .ok {{ border-color:rgba(52,211,153,.35); }}
    .err {{ border-color:rgba(248,113,113,.35); }}
