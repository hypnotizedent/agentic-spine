        {subtitle_html}
      </div>
      {nav}
    </div>
    {body}
  </div>
</body>
</html>"""


def _submit_form_html(error: str = "", values: dict[str, str] | None = None) -> str:
    values = values or {}
    error_html = f'<div class="flash err">{_H(error)}</div>' if error else ""
    content_type = values.get("content_type", "note")
    hint = _H(values.get("operator_hint", ""))
    raw_content = _H(values.get("raw_content", ""))
    body = f"""
    <div class="card {'err' if error else ''}">
      <div class="section-lead">Submit human-steward input here. It stays non-authoritative until classified or routed through the existing lifecycle.</div>
      {error_html}
      <form method="post" action="/submit" id="submitForm">
        <input type="hidden" name="source_app" value="browser">
        <label for="content_type">Type</label>
        <select name="content_type" id="content_type">
          <option value="note" {'selected' if content_type == 'note' else ''}>note</option>
          <option value="conversation" {'selected' if content_type == 'conversation' else ''}>conversation</option>
          <option value="url" {'selected' if content_type == 'url' else ''}>url</option>
          <option value="voice_transcript" {'selected' if content_type == 'voice_transcript' else ''}>voice_transcript</option>
        </select>
        <label for="operator_hint">Hint (optional)</label>
        <input type="text" name="operator_hint" id="operator_hint" value="{hint}" placeholder="One-line intent signal">
        <label for="raw_content">Content</label>
        <textarea name="raw_content" id="raw_content" placeholder="Paste thought, note, conversation, transcript, or URL here.">{raw_content}</textarea>
        <button class="btn" type="submit" id="submitBtn">Submit</button>
      </form>
      <div class="helper-row">
        <span class="helper-chip">raw capture only</span>
        <span class="helper-chip">no authority promotion here</span>
        <a class="helper-chip" href="/ingress">see recent submissions</a>
      </div>
    </div>
    <script>
    (function(){{
      var form=document.getElementById('submitForm');
      var btn=document.getElementById('submitBtn');
      form.addEventListener('submit',function(e){{
        e.preventDefault();
        if(btn.disabled) return;
        btn.disabled=true;
        btn.textContent='Submitting\u2026';
        var body=new URLSearchParams(new FormData(form)).toString();
        var ctrl=new AbortController();
        var timer=setTimeout(function(){{ ctrl.abort(); }},15000);
        fetch('/submit',{{
          method:'POST',
          headers:{{'Content-Type':'application/x-www-form-urlencoded'}},
          body:body,
          signal:ctrl.signal
        }}).then(function(r){{
          clearTimeout(timer);
          if(r.redirected){{ window.location.href=r.url; return; }}
          if(r.ok||r.status===303){{
            var loc=r.headers.get('Location');
            if(loc){{ window.location.href=loc; return; }}
          }}
          return r.text().then(function(t){{ throw new Error('Server error ('+r.status+')'); }});
        }}).catch(function(err){{
          clearTimeout(timer);
          btn.disabled=false;
          btn.textContent='Submit';
          var msg=err.name==='AbortError'?'Request timed out. Tap to retry.':err.message||'Network error. Tap to retry.';
          var flash=document.createElement('div');
          flash.className='flash err';
          flash.textContent=msg;
          var old=form.parentNode.querySelector('.flash.err');
          if(old) old.remove();
          form.parentNode.insertBefore(flash,form);
        }});
      }});
    }})();
    </script>
    """
    return _render_page(
        "Submit Operator Ingress",
        body,
        active="submit",
        subtitle="Capture notes, conversations, links, or transcripts into the governed operator-ingress lane.",
    )


def _ingress_readback_html(state_root: str, submitted_id: str = "") -> str:
    """Phone-readable readback of recent operator ingress objects."""
    data = oi.list_operator_ingress(state_root=state_root, limit=20)
    items = data.get("items", [])

    success_html = ""
    if submitted_id:
        success_html = f'<div class="flash ok">Accepted: <strong>{_H(submitted_id)}</strong></div>'

    rows = ""
    for item in items:
        iid = _H(str(item.get("ingress_id", "")))
        state = str(item.get("lifecycle_state", "submitted"))
        hint = _H(str(item.get("operator_hint", "")))
        ctype = _H(str(item.get("content_type", "")))
        submitted = _H(str(item.get("submitted_at", "")))
        disposition = _H(str(item.get("disposition", "awaiting_classification")))
        classification = _H(str(item.get("classification", "")))
        disposition_detail = _H(str(item.get("disposition_detail", "")))
        next_stage = _H(str(item.get("next_stage", "")))
        adoption_state = str(item.get("adoption_state", ""))
        adoption_ref = _H(str(item.get("adoption_ref", "")))
        reconciliation_reason = _H(str(item.get("reconciliation_reason", "")))
        chain = item.get("intent_chain_readback", {}) if isinstance(item.get("intent_chain_readback"), dict) else {}
        proof = chain.get("proof_receipt", {}) if isinstance(chain.get("proof_receipt"), dict) else {}
        proof_ref = _H(str(proof.get("ref", "")))
        next_missing = _H(str(chain.get("next_missing_seam", "")))

        # Badge: adoption_state is prominent when present, lifecycle_state secondary
        if adoption_state:
            badge_cls = f"badge-{adoption_state}"
            badge_label = adoption_state
        else:
            badge_cls = f"badge-{state}" if state in ("submitted", "classified", "routed") else ""
            badge_label = state

        # Outcome detail line: shows disposition and classification
        outcome_parts = []
        if disposition:
            outcome_parts.append(disposition)
        if classification:
            outcome_parts.append(classification)
        outcome_line = " · ".join(outcome_parts)

        # Adoption line (prominent when present)
        adoption_line = ""
        if adoption_state and adoption_ref:
            adoption_line = f"<div class='item-meta'><strong>{_H(adoption_state)}</strong> via {adoption_ref}</div>"
            if reconciliation_reason:
                adoption_line += f"<div class='item-meta'>{reconciliation_reason}</div>"
        elif adoption_state:
            adoption_line = f"<div class='item-meta'><strong>{_H(adoption_state)}</strong></div>"
            if reconciliation_reason:
                adoption_line += f"<div class='item-meta'>{reconciliation_reason}</div>"

        # Next stage / detail line
        detail_line = ""
        if not adoption_line:
            if next_stage:
                detail_line = f"<div class='item-meta'>→ {next_stage}</div>"
            elif disposition_detail:
                detail_line = f"<div class='item-meta'>{disposition_detail}</div>"

        proof_line = ""
        if proof_ref:
            proof_line = f"<div class='item-meta'>proof: {proof_ref}</div>"
        elif next_missing and next_missing != "none":
            proof_line = f"<div class='item-meta'>next missing: {next_missing}</div>"

        # Membrane badge (secondary when adoption is present)
        membrane_badge = ""
        if adoption_state:
            membrane_badge = f"<span class='badge badge-{state}' style='font-size:0.7em;opacity:0.7'>{_H(state)}</span>"

        rows += f"""
        <div class="item">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="item-id">{iid}</span>
            <span class="badge {badge_cls}">{_H(badge_label)}</span>
          </div>
          {"<div class='item-hint'>" + hint + "</div>" if hint else ""}
          {adoption_line}
          <div class="item-meta">{outcome_line}{(' ' + membrane_badge) if membrane_badge else ''}</div>
          {detail_line}
          {proof_line}
          <div class="item-meta">{ctype} · {submitted}</div>
        </div>
        """
    if not rows:
        rows = '<div class="item"><div class="item-meta">No submissions yet.</div></div>'

    state_root_display = _H(str(state_root))

    body = f"""
    <div class="card">
      <div class="section-lead">Recent operator-ingress objects with their current lifecycle state. This is readback, not authority.</div>
      {success_html}
      {rows}
      <div class="helper-row">
        <a class="helper-chip" href="/submit">submit another note</a>
        <span class="helper-chip">20 most recent items</span>
      </div>
      <div class="item-meta" style="margin-top:.5rem;font-size:.7rem;opacity:.5">reading from {state_root_display}</div>
    </div>
    """
    return _render_page(
        "Operator Ingress Readback",
        body,
        active="ingress",
        subtitle="Read the latest submissions and see whether they are still submitted, classified, or already routed.",
    )


class QuietHandler(SimpleHTTPRequestHandler):
    """Serve static operator surfaces plus bounded operator ingress submit."""

    def log_message(self, format, *args):
        # Only log errors, not every request
        if args and isinstance(args[0], str) and (args[0].startswith("4") or args[0].startswith("5")):
            super().log_message(format, *args)

    def _send_html(self, status: int, html: str) -> None:
        body = html.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _parse_submit_body(self) -> dict[str, str]:
        length = int(self.headers.get("Content-Length", "0") or "0")
        if length <= 0:
            raise oi.OperatorIngressError("request body is empty")
        if length > 200_000:
            raise oi.OperatorIngressError("request body too large")
        raw = self.rfile.read(length)
        ctype = self.headers.get("Content-Type", "")
        if "application/json" in ctype:
            try:
                data = json.loads(raw.decode("utf-8"))
            except Exception as exc:
                raise oi.OperatorIngressError(f"invalid JSON body: {exc}") from exc
            if not isinstance(data, dict):
                raise oi.OperatorIngressError("JSON body must be an object")
            return {
                "content_type": str(data.get("content_type", "note")),
                "operator_hint": str(data.get("operator_hint", "")),
                "raw_content": str(data.get("raw_content", "")),
                "source_app": str(data.get("source_app", "browser")),
                "source_device": str(data.get("source_device", "phone")),
            }

        fields = parse_qs(raw.decode("utf-8"), keep_blank_values=True)
        return {
            "content_type": fields.get("content_type", ["note"])[0],
            "operator_hint": fields.get("operator_hint", [""])[0],
            "raw_content": fields.get("raw_content", [""])[0],
            "source_app": fields.get("source_app", ["browser"])[0],
            "source_device": fields.get("source_device", ["phone"])[0],
        }

    def _regenerate_surfaces_background(self) -> None:
        """Queue a coalesced background regenerate without overlapping writers."""
        _request_surface_regenerate_background()

    def do_GET(self):
        parsed = urlparse(self.path)
        clean = parsed.path.rstrip("/")
        if clean == "/submit":
            self._send_html(200, _submit_form_html())
            return
        if clean == "/ingress.json":
            data = oi.list_operator_ingress(state_root=str(STATE_ROOT), limit=20)
            data["state_root"] = str(STATE_ROOT)
            self._send_json(200, data)
            return
        if clean == "/ingress":
            qs = parse_qs(parsed.query)
            submitted_id = qs.get("submitted", [""])[0]
            self._send_html(200, _ingress_readback_html(str(STATE_ROOT), submitted_id=submitted_id))
            return
        return super().do_GET()

    def _wants_json(self) -> bool:
        accept = self.headers.get("Accept", "")
        return "application/json" in accept

    def _send_json(self, status: int, data: dict) -> None:
        body = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path.rstrip("/") != "/submit":
            self.send_error(404, "Not Found")
            return

        wants_json = self._wants_json()

        try:
            payload = self._parse_submit_body()
            result = oi.create_operator_ingress(
                state_root=str(STATE_ROOT),
                raw_content=payload["raw_content"],
                content_type=payload["content_type"],
                operator_hint=payload["operator_hint"],
                operator_id="ronny",
                source_device=payload.get("source_device", "phone") or "phone",
                source_app=payload.get("source_app", "browser") or "browser",
                access_identity=self.headers.get("Cf-Access-Authenticated-User-Email", ""),
                source_ip=(self.headers.get("CF-Connecting-IP") or self.client_address[0]),
                submitted_via="operator_surface_submit",
            )
        except oi.OperatorIngressError as exc:
            if wants_json:
                self._send_json(400, {"status": "error", "error": str(exc)})
            else:
                self._send_html(400, _submit_form_html(str(exc), payload if 'payload' in locals() else None))
            return

        self._regenerate_surfaces_background()

        if wants_json:
            self._send_json(200, result)
        else:
            ingress_id = quote(result["ingress_id"])
            self.send_response(303)
            self.send_header("Location", f"/ingress?submitted={ingress_id}")
            self.send_header("Content-Length", "0")
            self.end_headers()


def main() -> int:
    parser = argparse.ArgumentParser(description="Static operator surface server")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--dir", type=str, default=str(DEFAULT_DIR))
    args = parser.parse_args()

    serve_dir = Path(args.dir)
    serve_dir.mkdir(parents=True, exist_ok=True)

    handler = partial(QuietHandler, directory=str(serve_dir))
    server = HTTPServer(("0.0.0.0", args.port), handler)
    print(f"operator-surface-server listening on :{args.port} serving {serve_dir}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
