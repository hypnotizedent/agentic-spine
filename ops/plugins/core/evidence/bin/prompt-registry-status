#!/usr/bin/env python3
"""Resolve prompt-registry lineage for one capability."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

import yaml


def load_yaml(path: Path) -> dict:
    payload = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    return payload if isinstance(payload, dict) else {}


def file_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def build_lineage(root: Path, capability: str) -> dict:
    registry_path = root / "ops" / "bindings" / "prompt.registry.yaml"
    data = load_yaml(registry_path)
    defaults = data.get("defaults", {}) if isinstance(data.get("defaults"), dict) else {}
    overrides = data.get("capability_overrides", {}) if isinstance(data.get("capability_overrides"), dict) else {}
    row = overrides.get(capability) if isinstance(overrides.get(capability), dict) else None
    resolution = "capability_override" if row else "defaults"
    active = row or defaults
    source_refs = [str(x) for x in active.get("source_refs", []) if str(x).strip()]
    source_hashes = {}
    combined = hashlib.sha256()
    found_any = False
    for ref in source_refs:
        ref_path = root / ref
        if ref_path.exists():
            digest = file_sha256(ref_path)
            source_hashes[ref] = digest
            combined.update(digest.encode("utf-8"))
            found_any = True
        else:
            source_hashes[ref] = "missing"
    source_hash = combined.hexdigest() if found_any else "none"
    return {
        "prompt_set_id": str(active.get("prompt_set_id") or ""),
        "version": str(active.get("version") or ""),
        "source_refs": source_refs,
        "source_hash": source_hash,
        "source_hashes": source_hashes,
        "registry_path": "ops/bindings/prompt.registry.yaml",
        "resolution": resolution,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--capability", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[5]
    lineage = build_lineage(root, args.capability)
    ok = all(
        [
            lineage["prompt_set_id"],
            lineage["version"],
            isinstance(lineage["source_refs"], list),
            lineage["registry_path"],
            lineage["resolution"],
        ]
    )
    payload = {
        "capability": "prompt.registry.status",
        "summary": {
            "status": "ok" if ok else "error",
            "requested_capability": args.capability,
        },
        "prompt_lineage": lineage,
    }
    if args.json:
        print(json.dumps(payload))
    else:
        print("prompt.registry.status")
        print(f"requested_capability: {args.capability}")
        print(f"status: {payload['summary']['status']}")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
