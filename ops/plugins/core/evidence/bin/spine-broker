#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sqlite3
from pathlib import Path


def state_root() -> Path:
    return Path(os.environ.get("SPINE_STATE", str(Path.home() / "code" / ".runtime" / "spine" / "state")))


def query_latest(conn: sqlite3.Connection) -> dict | None:
    row = conn.execute("SELECT loop_id, status, objective FROM loops ORDER BY created_at_utc DESC LIMIT 1").fetchone()
    return dict(row) if row else None


def query_loop(conn: sqlite3.Connection, loop_id: str) -> dict | None:
    row = conn.execute("SELECT * FROM loops WHERE loop_id = ?", (loop_id,)).fetchone()
    return dict(row) if row else None


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_latest = sub.add_parser("latest-loop")
    p_latest.add_argument("--include-closed", action="store_true")
    p_status = sub.add_parser("loop-status")
    p_status.add_argument("--loop-id", default="")
    p_status.add_argument("--latest", action="store_true")
    p_progress = sub.add_parser("loop-progress")
    p_progress.add_argument("--loop-id", default="")
    p_progress.add_argument("--latest", action="store_true")
    p_att = sub.add_parser("request-attestation")
    p_att.add_argument("--request-id", required=True)
    args = parser.parse_args()

    db = state_root() / "shared_authority.db"
    conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    if args.cmd == "latest-loop":
        payload = query_latest(conn) or {}
    elif args.cmd in {"loop-status", "loop-progress"}:
        loop_id = args.loop_id
        if args.latest or not loop_id:
            latest = query_latest(conn) or {}
            loop_id = latest.get("loop_id", "")
        payload = query_loop(conn, loop_id) or {}
    else:
        evidence_root = Path(os.environ.get("SPINE_EVIDENCE_ROOT", str(Path.home() / "code" / ".evidence" / "spine")))
        payload = {"request_id": args.request_id, "matches": [str(p) for p in list(evidence_root.glob(f"**/*{args.request_id}*"))[:20]]}
    conn.close()
    print(json.dumps(payload, indent=2, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
