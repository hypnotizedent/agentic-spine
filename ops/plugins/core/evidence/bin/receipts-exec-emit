#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
SCHEMA_PATH="$ROOT/ops/bindings/orchestration.exec_receipt.schema.json"

usage() {
  cat <<'USAGE'
receipts-exec-emit

Emit schema-compatible EXEC_RECEIPT JSON with evidence_refs linkage.

Usage:
  receipts-exec-emit \
    --task-id <id> \
    --terminal-id <TERMINAL-ID> \
    --lane <control|execution|audit|watcher> \
    --status <done|failed|blocked> \
    [--completion-level <slice_complete|loop_complete|domain_complete|estate_complete|readiness_complete>] \
    --files-changed <csv> \
    --run-keys <csv> \
    --ready-for-verify <true|false> \
    [--blockers <csv>] \
    [--timestamp-utc <YYYY-MM-DDTHH:MM:SSZ>] \
    [--wave-id <WAVE-ID>] [--commit-hashes <csv>] [--loop-id <LOOP-ID>] [--gap-ids <csv>] \
    [--evidence-run-keys <csv>] [--evidence-files <csv>] [--evidence-commits <csv>] \
    [--blocker-class <none|deterministic|freshness|dependency|cleanup|policy|external>] \
    [--request-id <CAP-...>] [--execution-host <host>] [--execution-mode <mode>] \
    [--runtime-role <role>] [--governance-version <version>] \
    [--entry-packet-path <path>] [--entry-packet-hash <sha256|none>] \
    [--prompt-set-id <id>] [--prompt-version <version>] [--prompt-source-refs <csv>] \
    [--prompt-source-hash <sha256|none>] [--prompt-source-hashes <ref=sha|missing,csv>] \
    [--prompt-registry-path <path>] [--prompt-resolution <capability_override|defaults|missing_registry|invalid_registry>] \
    [--attestation-json-out <path>] \
    [--json-out <path>] [--markdown-out <path>] [--no-validate]

Notes:
  - Always emits `evidence_refs` (defaults to empty refs + blocker_class=none).
  - Prints JSON to stdout unless --json-out is set.
  - --markdown-out keeps markdown compatibility during JSON rollout.
USAGE
}

TASK_ID=""
TERMINAL_ID=""
LANE=""
STATUS=""
COMPLETION_LEVEL=""
FILES_CHANGED=""
RUN_KEYS=""
BLOCKERS=""
READY_FOR_VERIFY=""
TIMESTAMP_UTC=""
WAVE_ID=""
COMMIT_HASHES=""
LOOP_ID=""
GAP_IDS=""
EVIDENCE_RUN_KEYS=""
EVIDENCE_FILES=""
EVIDENCE_COMMITS=""
BLOCKER_CLASS="none"
REQUEST_ID=""
EXECUTION_HOST=""
EXECUTION_MODE="capability"
RUNTIME_ROLE="unknown"
GOVERNANCE_VERSION=""
ENTRY_PACKET_PATH=""
ENTRY_PACKET_HASH="none"
PROMPT_SET_ID="unregistered"
PROMPT_VERSION="none"
PROMPT_SOURCE_REFS=""
PROMPT_SOURCE_HASH="none"
PROMPT_SOURCE_HASHES=""
PROMPT_REGISTRY_PATH="ops/bindings/prompt.registry.yaml"
PROMPT_RESOLUTION="missing_registry"
ATTESTATION_JSON_OUT=""
JSON_OUT=""
MARKDOWN_OUT=""
VALIDATE=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --task-id) TASK_ID="${2:-}"; shift 2 ;;
    --terminal-id) TERMINAL_ID="${2:-}"; shift 2 ;;
    --lane) LANE="${2:-}"; shift 2 ;;
    --status) STATUS="${2:-}"; shift 2 ;;
    --completion-level) COMPLETION_LEVEL="${2:-}"; shift 2 ;;
    --files-changed) FILES_CHANGED="${2:-}"; shift 2 ;;
    --run-keys) RUN_KEYS="${2:-}"; shift 2 ;;
    --blockers) BLOCKERS="${2:-}"; shift 2 ;;
    --ready-for-verify) READY_FOR_VERIFY="${2:-}"; shift 2 ;;
    --timestamp-utc) TIMESTAMP_UTC="${2:-}"; shift 2 ;;
    --wave-id) WAVE_ID="${2:-}"; shift 2 ;;
    --commit-hashes) COMMIT_HASHES="${2:-}"; shift 2 ;;
    --loop-id) LOOP_ID="${2:-}"; shift 2 ;;
    --gap-ids) GAP_IDS="${2:-}"; shift 2 ;;
    --evidence-run-keys) EVIDENCE_RUN_KEYS="${2:-}"; shift 2 ;;
    --evidence-files) EVIDENCE_FILES="${2:-}"; shift 2 ;;
    --evidence-commits) EVIDENCE_COMMITS="${2:-}"; shift 2 ;;
    --blocker-class) BLOCKER_CLASS="${2:-}"; shift 2 ;;
    --request-id) REQUEST_ID="${2:-}"; shift 2 ;;
    --execution-host) EXECUTION_HOST="${2:-}"; shift 2 ;;
    --execution-mode) EXECUTION_MODE="${2:-}"; shift 2 ;;
    --runtime-role) RUNTIME_ROLE="${2:-}"; shift 2 ;;
    --governance-version) GOVERNANCE_VERSION="${2:-}"; shift 2 ;;
    --entry-packet-path) ENTRY_PACKET_PATH="${2:-}"; shift 2 ;;
    --entry-packet-hash) ENTRY_PACKET_HASH="${2:-}"; shift 2 ;;
    --prompt-set-id) PROMPT_SET_ID="${2:-}"; shift 2 ;;
    --prompt-version) PROMPT_VERSION="${2:-}"; shift 2 ;;
    --prompt-source-refs) PROMPT_SOURCE_REFS="${2:-}"; shift 2 ;;
    --prompt-source-hash) PROMPT_SOURCE_HASH="${2:-}"; shift 2 ;;
    --prompt-source-hashes) PROMPT_SOURCE_HASHES="${2:-}"; shift 2 ;;
    --prompt-registry-path) PROMPT_REGISTRY_PATH="${2:-}"; shift 2 ;;
    --prompt-resolution) PROMPT_RESOLUTION="${2:-}"; shift 2 ;;
    --attestation-json-out) ATTESTATION_JSON_OUT="${2:-}"; shift 2 ;;
    --json-out) JSON_OUT="${2:-}"; shift 2 ;;
    --markdown-out) MARKDOWN_OUT="${2:-}"; shift 2 ;;
    --no-validate) VALIDATE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "FAIL: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$TASK_ID" ]] || { echo "FAIL: --task-id is required" >&2; exit 2; }
[[ -n "$TERMINAL_ID" ]] || { echo "FAIL: --terminal-id is required" >&2; exit 2; }
[[ -n "$LANE" ]] || { echo "FAIL: --lane is required" >&2; exit 2; }
[[ -n "$STATUS" ]] || { echo "FAIL: --status is required" >&2; exit 2; }
[[ -n "$RUN_KEYS" ]] || { echo "FAIL: --run-keys is required" >&2; exit 2; }
[[ -n "$READY_FOR_VERIFY" ]] || { echo "FAIL: --ready-for-verify is required" >&2; exit 2; }

python3 - "$SCHEMA_PATH" "$TASK_ID" "$TERMINAL_ID" "$LANE" "$STATUS" "$COMPLETION_LEVEL" "$FILES_CHANGED" "$RUN_KEYS" "$BLOCKERS" "$READY_FOR_VERIFY" "$TIMESTAMP_UTC" "$WAVE_ID" "$COMMIT_HASHES" "$LOOP_ID" "$GAP_IDS" "$EVIDENCE_RUN_KEYS" "$EVIDENCE_FILES" "$EVIDENCE_COMMITS" "$BLOCKER_CLASS" "$REQUEST_ID" "$EXECUTION_HOST" "$EXECUTION_MODE" "$RUNTIME_ROLE" "$GOVERNANCE_VERSION" "$ENTRY_PACKET_PATH" "$ENTRY_PACKET_HASH" "$PROMPT_SET_ID" "$PROMPT_VERSION" "$PROMPT_SOURCE_REFS" "$PROMPT_SOURCE_HASH" "$PROMPT_SOURCE_HASHES" "$PROMPT_REGISTRY_PATH" "$PROMPT_RESOLUTION" "$ATTESTATION_JSON_OUT" "$JSON_OUT" "$MARKDOWN_OUT" "$VALIDATE" <<'PY'
import datetime as dt
import hashlib
import json
import os
import re
import socket
import sys
from pathlib import Path

(
    schema_path,
    task_id,
    terminal_id,
    lane,
    status,
    completion_level_raw,
    files_changed_raw,
    run_keys_raw,
    blockers_raw,
    ready_for_verify_raw,
    timestamp_utc,
    wave_id,
    commit_hashes_raw,
    loop_id,
    gap_ids_raw,
    evidence_run_keys_raw,
    evidence_files_raw,
    evidence_commits_raw,
    blocker_class,
    request_id_raw,
    execution_host_raw,
    execution_mode_raw,
    runtime_role_raw,
    governance_version_raw,
    entry_packet_path_raw,
    entry_packet_hash_raw,
    prompt_set_id_raw,
    prompt_version_raw,
    prompt_source_refs_raw,
    prompt_source_hash_raw,
    prompt_source_hashes_raw,
    prompt_registry_path_raw,
    prompt_resolution_raw,
    attestation_json_out,
    json_out,
    markdown_out,
    validate_raw,
) = sys.argv[1:38]

validate = validate_raw == "1"


def split_csv(value: str):
    value = (value or "").strip()
    if not value:
        return []
    return [part.strip() for part in value.split(",") if part.strip()]


def split_csv_pairs(value: str):
    value = (value or "").strip()
    pairs = {}
    if not value:
        return pairs
    for part in value.split(","):
        part = part.strip()
        if not part:
            continue
        if "=" not in part:
            continue
        key, raw_val = part.split("=", 1)
        key = key.strip()
        raw_val = raw_val.strip()
        if key:
            pairs[key] = raw_val or "missing"
    return pairs


def parse_bool(value: str):
    value = (value or "").strip().lower()
    if value in {"true", "1", "yes", "y"}:
        return True
    if value in {"false", "0", "no", "n"}:
        return False
    raise ValueError("ready_for_verify must be true|false")


files_changed = split_csv(files_changed_raw)
run_keys = split_csv(run_keys_raw)
blockers = split_csv(blockers_raw)
commit_hashes = split_csv(commit_hashes_raw)
gap_ids = split_csv(gap_ids_raw)
completion_level = (completion_level_raw or "").strip()

# Evidence refs are always emitted (defaults keep compatibility deterministic).
evidence_run_keys = split_csv(evidence_run_keys_raw) or list(run_keys)
evidence_files = split_csv(evidence_files_raw) or list(files_changed)
evidence_commits = split_csv(evidence_commits_raw) or list(commit_hashes)
prompt_source_refs = split_csv(prompt_source_refs_raw)
prompt_source_hashes = split_csv_pairs(prompt_source_hashes_raw)
prompt_set_id = (prompt_set_id_raw or "").strip() or "unregistered"
prompt_version = (prompt_version_raw or "").strip() or "none"
prompt_source_hash = (prompt_source_hash_raw or "").strip() or "none"
prompt_registry_path = (prompt_registry_path_raw or "").strip() or "ops/bindings/prompt.registry.yaml"
prompt_resolution = (prompt_resolution_raw or "").strip() or "missing_registry"
for ref in prompt_source_refs:
    prompt_source_hashes.setdefault(ref, "missing")

ready_for_verify = parse_bool(ready_for_verify_raw)
if not timestamp_utc:
    timestamp_utc = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

receipt = {
    "task_id": task_id,
    "terminal_id": terminal_id,
    "lane": lane,
    "status": status,
    "files_changed": files_changed,
    "run_keys": run_keys,
    "blockers": blockers,
    "ready_for_verify": ready_for_verify,
    "timestamp_utc": timestamp_utc,
    "evidence_refs": {
        "run_key_refs": evidence_run_keys,
        "file_refs": evidence_files,
        "commit_refs": evidence_commits,
        "blocker_class": blocker_class or "none",
    },
    "prompt_lineage": {
        "prompt_set_id": prompt_set_id,
        "version": prompt_version,
        "source_refs": prompt_source_refs,
        "source_hash": prompt_source_hash,
        "source_hashes": prompt_source_hashes,
        "registry_path": prompt_registry_path,
        "resolution": prompt_resolution,
    },
}

if completion_level:
    receipt["completion_level"] = completion_level

if wave_id:
    receipt["wave_id"] = wave_id
if commit_hashes:
    receipt["commit_hashes"] = commit_hashes
if loop_id:
    receipt["loop_id"] = loop_id
if gap_ids:
    receipt["gap_ids"] = gap_ids

request_id = (request_id_raw or "").strip() or (run_keys[0] if run_keys else "")
execution_host = (execution_host_raw or "").strip() or socket.gethostname()
execution_mode = (execution_mode_raw or "").strip() or "capability"
runtime_role = (runtime_role_raw or "").strip() or "unknown"
governance_version = (governance_version_raw or "").strip() or "SPINE.md@unknown"
entry_packet_path = (entry_packet_path_raw or "").strip()
entry_packet_hash = (entry_packet_hash_raw or "").strip() or "none"

if validate:
    if not os.path.isfile(schema_path):
        raise SystemExit(f"FAIL: schema not found: {schema_path}")
    schema = json.loads(Path(schema_path).read_text(encoding="utf-8"))

    allowed_lanes = set(schema.get("properties", {}).get("lane", {}).get("enum", []))
    allowed_statuses = set(schema.get("properties", {}).get("status", {}).get("enum", []))
    run_key_pattern = schema.get("properties", {}).get("run_keys", {}).get("items", {}).get("pattern")
    evidence_blocker_enum = (
        schema.get("properties", {})
        .get("evidence_refs", {})
        .get("properties", {})
        .get("blocker_class", {})
        .get("enum", [])
    )
    prompt_resolution_enum = (
        schema.get("properties", {})
        .get("prompt_lineage", {})
        .get("properties", {})
        .get("resolution", {})
        .get("enum", [])
    )
    prompt_hash_pattern = (
        schema.get("properties", {})
        .get("prompt_lineage", {})
        .get("properties", {})
        .get("source_hash", {})
        .get("pattern", r"^([0-9a-f]{64}|none)$")
    )
    commit_pattern = (
        schema.get("properties", {})
        .get("commit_hashes", {})
        .get("items", {})
        .get("pattern", r"^[0-9a-f]{7,40}$")
    )

    if allowed_lanes and lane not in allowed_lanes:
        raise SystemExit(f"FAIL: lane invalid: {lane}")
    if allowed_statuses and status not in allowed_statuses:
        raise SystemExit(f"FAIL: status invalid: {status}")
    if status == "blocked" and not blockers:
        raise SystemExit("FAIL: blockers required when status=blocked")
    completion_level = (completion_level or "").strip()
    allowed_completion_levels = {
        "slice_complete",
        "loop_complete",
        "domain_complete",
        "estate_complete",
        "readiness_complete",
    }
    if completion_level and completion_level not in allowed_completion_levels:
        raise SystemExit(f"FAIL: completion_level invalid: {completion_level}")

    ts_pattern = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
    if not ts_pattern.match(timestamp_utc):
        raise SystemExit(f"FAIL: timestamp_utc must be UTC second precision (got {timestamp_utc})")

    if run_key_pattern:
        rk_re = re.compile(run_key_pattern)
        for rk in run_keys:
            if not rk_re.match(rk):
                raise SystemExit(f"FAIL: run key invalid: {rk}")
        for rk in evidence_run_keys:
            if not rk_re.match(rk):
                raise SystemExit(f"FAIL: evidence run key invalid: {rk}")

    commit_re = re.compile(commit_pattern)
    for c in commit_hashes + evidence_commits:
        if not commit_re.match(c):
            raise SystemExit(f"FAIL: commit ref invalid: {c}")

    if evidence_blocker_enum and receipt["evidence_refs"]["blocker_class"] not in set(evidence_blocker_enum):
        raise SystemExit(
            f"FAIL: blocker_class invalid: {receipt['evidence_refs']['blocker_class']}"
        )

    prompt_hash_re = re.compile(prompt_hash_pattern)
    if not prompt_hash_re.match(receipt["prompt_lineage"]["source_hash"]):
        raise SystemExit(f"FAIL: prompt source_hash invalid: {receipt['prompt_lineage']['source_hash']}")
    if prompt_resolution_enum and receipt["prompt_lineage"]["resolution"] not in set(prompt_resolution_enum):
        raise SystemExit(
            f"FAIL: prompt resolution invalid: {receipt['prompt_lineage']['resolution']}"
        )

payload = json.dumps(receipt, indent=2, sort_keys=False)

if json_out:
    out_path = Path(json_out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(payload + "\n", encoding="utf-8")

if markdown_out:
    md_path = Path(markdown_out)
    md_path.parent.mkdir(parents=True, exist_ok=True)
    md_lines = [
        f"# EXEC Receipt — {task_id}",
        "",
        f"- terminal_id: {terminal_id}",
        f"- lane: {lane}",
        f"- status: {status}",
    ]
    if completion_level:
        md_lines.append(f"- completion_level: {completion_level}")
    md_lines.extend([
        f"- ready_for_verify: {str(ready_for_verify).lower()}",
        f"- timestamp_utc: {timestamp_utc}",
        "",
        "## Files Changed",
    ])
    md_lines.extend([f"- {p}" for p in files_changed] or ["- (none)"])
    md_lines.extend(["", "## Run Keys"])
    md_lines.extend([f"- {rk}" for rk in run_keys] or ["- (none)"])
    md_lines.extend(["", "## Evidence Refs"])
    md_lines.extend([f"- blocker_class: {receipt['evidence_refs']['blocker_class']}"])
    md_lines.extend([f"- run_key_refs: {len(evidence_run_keys)}"])
    md_lines.extend([f"- file_refs: {len(evidence_files)}"])
    md_lines.extend([f"- commit_refs: {len(evidence_commits)}"])
    md_lines.extend(["", "## Prompt Lineage"])
    md_lines.extend([f"- prompt_set_id: {receipt['prompt_lineage']['prompt_set_id']}"])
    md_lines.extend([f"- version: {receipt['prompt_lineage']['version']}"])
    md_lines.extend([f"- source_hash: {receipt['prompt_lineage']['source_hash']}"])
    md_lines.extend([f"- resolution: {receipt['prompt_lineage']['resolution']}"])
    md_lines.extend([f"- source_refs: {len(receipt['prompt_lineage']['source_refs'])}"])
    if blockers:
        md_lines.extend(["", "## Blockers"])
        md_lines.extend([f"- {b}" for b in blockers])
    md_path.write_text("\n".join(md_lines) + "\n", encoding="utf-8")


def sha256_text_or_missing(path: Path) -> str:
    if not path.exists() or not path.is_file():
        return "missing"
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


if attestation_json_out:
    att_path = Path(attestation_json_out)
    att_path.parent.mkdir(parents=True, exist_ok=True)
    receipt_dir = att_path.parent
    receipt_md = receipt_dir / "receipt.md"
    receipt_exec = receipt_dir / "receipt.exec.json"
    output_txt = receipt_dir / "output.txt"
    checks_passed = []
    checks_failed = []
    for label, path in (
        ("receipt_markdown_present", receipt_md),
        ("receipt_exec_present", receipt_exec if json_out else att_path),
        ("output_present", output_txt),
    ):
        if path.exists():
            checks_passed.append(label)
        else:
            checks_failed.append(label)
    if status == "done":
        checks_passed.append("verdict_done")
    else:
        checks_failed.append("verdict_done")

    attestation = {
        "schema_version": "1.0",
        "request_id": request_id,
        "capability": task_id,
        "generated_at_utc": timestamp_utc,
        "loop_id": loop_id,
        "entry_packet_path": entry_packet_path,
        "entry_packet_hash": entry_packet_hash,
        "governance_version": governance_version,
        "execution_host": execution_host,
        "execution_mode": execution_mode,
        "runtime_role": runtime_role,
        "completion_level": completion_level,
        "checks_passed": checks_passed,
        "checks_failed": checks_failed,
        "receipts": {
            "markdown": {
                "path": str(receipt_md),
                "sha256": sha256_text_or_missing(receipt_md),
            },
            "exec": {
                "path": str(receipt_exec),
                "sha256": sha256_text_or_missing(receipt_exec),
            },
            "output": {
                "path": str(output_txt),
                "sha256": sha256_text_or_missing(output_txt),
            },
        },
        "evidence_refs": receipt["evidence_refs"],
        "prompt_lineage": receipt["prompt_lineage"],
        "verdict": status,
    }
    att_path.write_text(json.dumps(attestation, indent=2) + "\n", encoding="utf-8")

if not json_out:
    print(payload)
else:
    print("receipts.exec.emit")
    print(f"json_out: {json_out}")
    if attestation_json_out:
        print(f"attestation_json_out: {attestation_json_out}")
    if markdown_out:
        print(f"markdown_out: {markdown_out}")
    print(f"task_id: {task_id}")
    print(f"status: {status}")
    if completion_level:
        print(f"completion_level: {completion_level}")
PY
