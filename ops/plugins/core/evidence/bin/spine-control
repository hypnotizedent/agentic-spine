#!/usr/bin/env python3
"""spine-control

Unified control-loop surfaces:
  - spine.control.tick
  - spine.control.plan
  - spine.control.execute
  - spine.control.cycle
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
from collections import Counter
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
SCHEMA_VERSION = "1.0"
VERIFY_PASS_STATUSES = {"done", "pass", "passed", "ok", "healthy", "success"}
VERIFY_FAIL_STATUSES = {"failed", "fail", "error", "incident", "critical"}

# Observability capabilities that report incident state via exit 1 (not execution failure)
OBSERVABILITY_CAPABILITIES = {
    "stability.control.snapshot",
    "infra.core.slo.status",
    "observability.stack.status",
}


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def runtime_env() -> dict[str, str]:
    runtime_paths = resolve_runtime_paths()
    env = dict(os.environ)
    env["SPINE_TARGET_REPO"] = str(ROOT)
    env["SPINE_ROOT"] = str(ROOT)
    env["SPINE_REPO"] = str(ROOT)
    env["SPINE_CODE"] = str(ROOT)
    env["SPINE_INBOX"] = str(runtime_paths["inbox"])
    env["SPINE_OUTBOX"] = str(runtime_paths["outbox"])
    env["SPINE_STATE"] = str(runtime_paths["state"])
    env["SPINE_LOGS"] = str(runtime_paths["logs"])

    # Mark child capability launches as nested executions to bypass attach admission.
    # spine.control.cycle launches child capabilities (verify.pack.run,
    # stability.control.snapshot, etc.) which should execute as governed nested
    # actions rather than requiring fresh top-level attach packets.
    stack = env.get("OPS_CAP_STACK", "")
    env["OPS_CAP_STACK"] = f",{stack},spine.control.cycle," if stack else ",spine.control.cycle,"

    return env


def shared_workspace_root() -> Path:
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=str(ROOT),
            text=True,
            capture_output=True,
            check=False,
            env=os.environ,
        )
        if proc.returncode == 0:
            common_dir = Path(proc.stdout.strip())
            if common_dir.name == ".git":
                return common_dir.parent.parent
            return common_dir.parent
    except Exception:
        pass
    return ROOT.parent


def run_cmd(cmd: list[str], *, cwd: Path | None = None, input_text: str | None = None) -> tuple[int, str, str]:
    proc = subprocess.run(
        cmd,
        cwd=str(cwd or ROOT),
        input=input_text,
        text=True,
        capture_output=True,
        check=False,
        env=runtime_env(),
    )
    return proc.returncode, proc.stdout, proc.stderr


def parse_frontmatter(path: Path) -> dict[str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}
    front = parts[1]
    data: dict[str, str] = {}
    for line in front.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as fh:
        loaded = yaml.safe_load(fh)
    return default if loaded is None else loaded


def capability_script_path(capability_id: str, fallback_rel: str) -> Path:
    fallback = ROOT / fallback_rel
    caps_doc = load_yaml(ROOT / "ops/capabilities.yaml", {})
    capabilities = caps_doc.get("capabilities") if isinstance(caps_doc, dict) else {}
    row = capabilities.get(capability_id) if isinstance(capabilities, dict) else None
    if isinstance(row, dict):
        script_rel = str(row.get("script_path") or "").strip()
        if script_rel:
            return ROOT / script_rel.removeprefix("./")
    return fallback


def render_path_for_payload(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        workspace_root = shared_workspace_root()
        try:
            return str(path.relative_to(workspace_root))
        except ValueError:
            return str(path)


def gaps_file_path() -> Path:
    override = (os.environ.get("SPINE_GAPS_FILE") or "").strip()
    if override:
        return Path(override)
    return ROOT / "ops/bindings/operational.gaps.yaml"


def resolve_runtime_paths() -> dict[str, Path]:
    contract = load_yaml(ROOT / "ops/bindings/mailroom.runtime.contract.yaml", {})
    runtime_active = bool(contract.get("active"))
    runtime_root = str(contract.get("runtime_root", "")).strip()
    mailroom_root = str(contract.get("mailroom_root", "")).strip()
    state_root = str(contract.get("state_root", "")).strip()
    logs_root = str(contract.get("logs_root", "")).strip()

    inbox = os.environ.get("SPINE_INBOX")
    outbox = os.environ.get("SPINE_OUTBOX")
    state = os.environ.get("SPINE_STATE")
    logs = os.environ.get("SPINE_LOGS")

    if runtime_active and runtime_root:
        mr = mailroom_root or f"{runtime_root}/mailroom"
        inbox = inbox or f"{mr}/inbox"
        outbox = outbox or f"{mr}/outbox"
        state = state or state_root or f"{runtime_root}/state"
        logs = logs or logs_root or f"{runtime_root}/logs"

    inbox = inbox or str(ROOT / "mailroom/inbox")
    outbox = outbox or str(ROOT / "mailroom/outbox")
    state = state or str(ROOT / "mailroom/state")
    logs = logs or str(ROOT / "mailroom/logs")

    return {
        "inbox": Path(inbox),
        "outbox": Path(outbox),
        "state": Path(state),
        "logs": Path(logs),
    }


def severity_rank(value: str) -> int:
    order = {"critical": 0, "high": 1, "medium": 2, "low": 3}
    return order.get((value or "").strip().lower(), 4)


def gap_numeric_id(value: str) -> int:
    m = re.search(r"(\d+)$", value or "")
    return int(m.group(1)) if m else 999_999


def collect_open_loops() -> list[dict[str, Any]]:
    rc, out, _ = run_cmd([str(ROOT / "bin/ops"), "loops", "list", "--open"], cwd=ROOT)
    if rc != 0:
        return []

    open_ids: list[str] = []
    for line in out.splitlines():
        m = re.search(r"(LOOP-[A-Z0-9-]+)", line)
        if m:
            open_ids.append(m.group(1))

    loop_dir = resolve_runtime_paths()["state"] / "loop-scopes"
    rows: list[dict[str, Any]] = []
    for loop_id in open_ids:
        path = loop_dir / f"{loop_id}.scope.md"
        front = parse_frontmatter(path) if path.exists() else {}
        rows.append(
            {
                "loop_id": loop_id,
                "status": (front.get("status") or "open").strip().lower(),
                "owner": front.get("owner", ""),
                "priority": front.get("priority", ""),
                "objective": front.get("objective", ""),
                "path": render_path_for_payload(path) if path.exists() else "",
            }
        )
    return rows


def parse_created_at(front: dict[str, str], path: Path) -> dt.datetime:
    created = (front.get("created") or "").strip()
    if created:
        try:
            if len(created) == 10:
                return dt.datetime.fromisoformat(created + "T00:00:00+00:00")
            parsed = dt.datetime.fromisoformat(created.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=dt.timezone.utc)
            return parsed.astimezone(dt.timezone.utc)
        except ValueError:
            pass
    return dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc)


def loop_scope_rows() -> list[dict[str, Any]]:
    loop_dir = resolve_runtime_paths()["state"] / "loop-scopes"
    rows: list[dict[str, Any]] = []
    if not loop_dir.exists():
        return rows

    for path in sorted(loop_dir.glob("*.scope.md")):
        front = parse_frontmatter(path)
        loop_id = (front.get("loop_id") or path.name.replace(".scope.md", "")).strip()
        if not loop_id.startswith("LOOP-"):
            continue
        status = (front.get("status") or "unknown").strip().lower()
        rows.append(
            {
                "loop_id": loop_id,
                "status": status,
                "owner": front.get("owner", ""),
                "priority": front.get("priority", ""),
                "objective": front.get("objective", ""),
                "created": front.get("created", ""),
                "scope": front.get("scope", ""),
                "path": render_path_for_payload(path),
                "created_at_utc": parse_created_at(front, path).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "updated_at_utc": dt.datetime.fromtimestamp(path.stat().st_mtime, tz=dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            }
        )

    rows.sort(key=lambda row: (row.get("created_at_utc", ""), row.get("loop_id", "")), reverse=True)
    return rows


def loop_is_open(status: str) -> bool:
    return (status or "").strip().lower() in {"active", "open", "draft", "planned"}


def latest_loop_row(include_closed: bool = False) -> dict[str, Any] | None:
    for row in loop_scope_rows():
        if include_closed or loop_is_open(str(row.get("status", ""))):
            return row
    return None


def resolve_loop_row(loop_id: str | None = None, *, latest: bool = False, include_closed: bool = True) -> dict[str, Any] | None:
    if latest:
        return latest_loop_row(include_closed=include_closed)
    if not loop_id:
        return None
    for row in loop_scope_rows():
        if str(row.get("loop_id", "")) == loop_id:
            return row
    return None


def collect_open_gaps() -> list[dict[str, Any]]:
    data = load_yaml(gaps_file_path(), {})
    rows = []
    for item in data.get("gaps", []):
        status = str(item.get("status", "")).strip().lower()
        if status not in {"open", "active"}:
            continue
        desc = str(item.get("description", "")).strip()
        desc = re.sub(r"\s+", " ", desc)
        rows.append(
            {
                "id": item.get("id", ""),
                "severity": item.get("severity", "medium"),
                "status": status,
                "parent_loop": item.get("parent_loop", ""),
                "description": desc,
                "doc": item.get("doc", ""),
            }
        )
    rows.sort(key=lambda r: (severity_rank(r.get("severity", "")), gap_numeric_id(r.get("id", ""))))
    return rows


def collect_loop_gap_progress(loop_id: str) -> dict[str, Any]:
    data = load_yaml(gaps_file_path(), {})
    linked = [g for g in data.get("gaps", []) if str(g.get("parent_loop", "")).strip() == loop_id]
    total = len(linked)
    by_status = Counter(str(g.get("status", "unknown")).strip().lower() or "unknown" for g in linked)
    resolved = int(by_status.get("fixed", 0)) + int(by_status.get("closed", 0))
    open_rows = []
    for gap in linked:
        if str(gap.get("status", "")).strip().lower() != "open":
            continue
        description = re.sub(r"\s+", " ", str(gap.get("description", "")).strip())
        open_rows.append(
            {
                "gap_id": str(gap.get("id", "")).strip(),
                "severity": str(gap.get("severity", "medium")).strip(),
                "description": description,
                "doc": str(gap.get("doc", "")).strip(),
            }
        )
    open_rows.sort(key=lambda row: (severity_rank(row.get("severity", "")), gap_numeric_id(row.get("gap_id", ""))))
    progress_pct = int((resolved / total) * 100) if total else 0
    return {
        "loop_id": loop_id,
        "linked_gaps": total,
        "resolved_gaps": resolved,
        "open_gaps": len(open_rows),
        "progress_percent": progress_pct,
        "by_status": dict(by_status),
        "open_gap_rows": open_rows,
    }


def governance_version() -> str:
    front = parse_frontmatter(ROOT / "docs/governance/SPINE.md")
    verified = (front.get("last_verified") or "unknown").strip() or "unknown"
    return f"SPINE.md@{verified}"


def sha256_for_path(path: Path) -> str:
    if not path.exists() or not path.is_file():
        return "missing"
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def markdown_receipt_field(path: Path, field: str) -> str:
    if not path.exists():
        return ""
    text = path.read_text(encoding="utf-8", errors="replace")
    pattern = rf"\|\s*{re.escape(field)}\s*\|\s*`?([^`|]+)`?\s*\|"
    match = re.search(pattern, text)
    return match.group(1).strip() if match else ""


def receipts_root() -> Path:
    override = (os.environ.get("SPINE_RECEIPTS") or "").strip()
    if override:
        return Path(override)
    return shared_workspace_root() / ".evidence" / "spine" / "sessions"


def request_receipt_dir(request_id: str) -> Path:
    cleaned = request_id.strip()
    if cleaned.startswith("R"):
        return receipts_root() / cleaned
    return receipts_root() / f"R{cleaned}"


def synthesize_request_attestation(request_id: str, receipt_dir: Path) -> dict[str, Any]:
    receipt_md = receipt_dir / "receipt.md"
    receipt_exec = receipt_dir / "receipt.exec.json"
    output_txt = receipt_dir / "output.txt"
    exec_payload = load_yaml(receipt_exec, {}) if receipt_exec.exists() else {}

    capability = str(exec_payload.get("task_id") or markdown_receipt_field(receipt_md, "Capability") or "unknown")
    verdict = str(exec_payload.get("status") or markdown_receipt_field(receipt_md, "Status") or "unknown").strip().lower()
    generated = str(exec_payload.get("timestamp_utc") or markdown_receipt_field(receipt_md, "Generated") or utc_now())
    loop_id = str(exec_payload.get("loop_id") or "").strip()
    prompt_lineage = exec_payload.get("prompt_lineage") if isinstance(exec_payload, dict) else {}
    evidence_refs = exec_payload.get("evidence_refs") if isinstance(exec_payload, dict) else {}
    checks_passed = []
    checks_failed = []

    for label, path in (
        ("receipt_markdown_present", receipt_md),
        ("receipt_exec_present", receipt_exec),
        ("output_present", output_txt),
    ):
        if path.exists():
            checks_passed.append(label)
        else:
            checks_failed.append(label)
    if verdict == "done":
        checks_passed.append("verdict_done")
    else:
        checks_failed.append("verdict_done")

    attestation = {
        "schema_version": "1.0",
        "request_id": request_id,
        "capability": capability,
        "generated_at_utc": generated,
        "loop_id": loop_id,
        "entry_packet_path": str(exec_payload.get("entry_packet_path") or ""),
        "entry_packet_hash": str(exec_payload.get("entry_packet_hash") or "none"),
        "governance_version": str(exec_payload.get("governance_version") or governance_version()),
        "execution_host": str(exec_payload.get("execution_host") or socket.gethostname()),
        "execution_mode": str(exec_payload.get("execution_mode") or "capability"),
        "runtime_role": str(exec_payload.get("runtime_role") or "unknown"),
        "checks_passed": checks_passed,
        "checks_failed": checks_failed,
        "receipts": {
            "markdown": {
                "path": str(receipt_md),
                "sha256": sha256_for_path(receipt_md),
            },
            "exec": {
                "path": str(receipt_exec),
                "sha256": sha256_for_path(receipt_exec),
            },
            "output": {
                "path": str(output_txt),
                "sha256": sha256_for_path(output_txt),
            },
        },
        "evidence_refs": evidence_refs if isinstance(evidence_refs, dict) else {},
        "prompt_lineage": prompt_lineage if isinstance(prompt_lineage, dict) else {},
        "verdict": verdict,
    }
    return attestation


def load_request_attestation(request_id: str) -> dict[str, Any] | None:
    receipt_dir = request_receipt_dir(request_id)
    if not receipt_dir.exists():
        return None
    attestation_path = receipt_dir / "receipt.attestation.json"
    if attestation_path.exists():
        payload = load_yaml(attestation_path, {})
        if isinstance(payload, dict) and payload:
            return payload
    cleaned = request_id[1:] if request_id.startswith("R") else request_id
    return synthesize_request_attestation(cleaned, receipt_dir)


def broker_envelope(capability: str, status: str, data: dict[str, Any]) -> dict[str, Any]:
    return {
        "capability": capability,
        "schema_version": SCHEMA_VERSION,
        "status": status,
        "generated_at": utc_now(),
        "data": data,
    }


def latest_loop_payload(*, include_closed: bool = False) -> dict[str, Any]:
    row = latest_loop_row(include_closed=include_closed)
    if row is None:
        return broker_envelope("spine.broker.get_latest_loop", "not_found", {"message": "no matching loops found"})
    progress = collect_loop_gap_progress(str(row["loop_id"]))
    return broker_envelope(
        "spine.broker.get_latest_loop",
        "done",
        {
            "loop": row,
            "progress": {
                "linked_gaps": progress["linked_gaps"],
                "resolved_gaps": progress["resolved_gaps"],
                "open_gaps": progress["open_gaps"],
                "progress_percent": progress["progress_percent"],
            },
        },
    )


def loop_status_payload(loop_id: str | None, *, latest: bool = False) -> dict[str, Any]:
    row = resolve_loop_row(loop_id, latest=latest)
    if row is None:
        return broker_envelope("spine.broker.get_loop_status", "not_found", {"loop_id": loop_id or "", "message": "loop not found"})
    progress = collect_loop_gap_progress(str(row["loop_id"]))
    return broker_envelope(
        "spine.broker.get_loop_status",
        "done",
        {
            "loop": row,
            "linked_gaps": progress["linked_gaps"],
            "resolved_gaps": progress["resolved_gaps"],
            "open_gaps": progress["open_gaps"],
        },
    )


def loop_progress_payload(loop_id: str | None, *, latest: bool = False) -> dict[str, Any]:
    row = resolve_loop_row(loop_id, latest=latest)
    if row is None:
        return broker_envelope("spine.broker.get_loop_progress", "not_found", {"loop_id": loop_id or "", "message": "loop not found"})
    progress = collect_loop_gap_progress(str(row["loop_id"]))
    return broker_envelope(
        "spine.broker.get_loop_progress",
        "done",
        {
            "loop": row,
            "progress": progress,
        },
    )


def request_attestation_payload(request_id: str) -> dict[str, Any]:
    attestation = load_request_attestation(request_id)
    if attestation is None:
        return broker_envelope(
            "spine.broker.get_request_attestation",
            "not_found",
            {"request_id": request_id, "message": "request attestation not found"},
        )
    return broker_envelope(
        "spine.broker.get_request_attestation",
        "done",
        {
            "request_id": request_id,
            "attestation": attestation,
        },
    )


def parse_proposals_summary() -> dict[str, int]:
    script = ROOT / "ops/plugins/core/proposals/bin/proposals-status"
    if not script.exists():
        return {
            "total": 0,
            "pending": 0,
            "applied": 0,
            "superseded": 0,
            "draft_hold": 0,
            "draft": 0,
            "read_only": 0,
            "invalid": 0,
            "sla_breaches": 0,
        }

    rc, out, err = run_cmd([str(script)], cwd=ROOT)
    text = out if out.strip() else err
    summary = {
        "total": 0,
        "pending": 0,
        "applied": 0,
        "superseded": 0,
        "draft_hold": 0,
        "draft": 0,
        "read_only": 0,
        "invalid": 0,
        "sla_breaches": 0,
    }
    patterns = {
        "total": r"Total:\s+(\d+)",
        "pending": r"Pending:\s+(\d+)",
        "applied": r"Applied:\s+(\d+)",
        "superseded": r"Superseded:\s+(\d+)",
        "draft_hold": r"Draft Hold:\s+(\d+)",
        "draft": r"Draft:\s+(\d+)",
        "read_only": r"Read-only:\s+(\d+)",
        "invalid": r"Invalid:\s+(\d+)",
        "sla_breaches": r"SLA breaches:\s+(\d+)",
    }
    for key, pattern in patterns.items():
        m = re.search(pattern, text)
        if m:
            summary[key] = int(m.group(1))
    if rc != 0 and summary["total"] == 0:
        summary["invalid"] = max(summary["invalid"], 1)
    return summary


def parse_json_output(script: Path, args: list[str]) -> tuple[int, dict[str, Any]]:
    rc, out, err = run_cmd([str(script)] + args, cwd=ROOT)
    text = out.strip() or err.strip()
    if not text:
        return rc, {}
    try:
        payload = json.loads(text)
    except json.JSONDecodeError:
        payload = {"status": "error", "error": {"message": text}}
    return rc, payload


def collect_calendar_status() -> dict[str, Any]:
    script = ROOT / "ops/plugins/domains/calendar/bin/calendar-status"
    if not script.exists():
        return {"status": "error", "error": {"message": "calendar-status script not found"}}
    _, payload = parse_json_output(script, ["--json"])
    if not payload:
        return {"status": "error", "error": {"message": "calendar-status returned no payload"}}
    data = payload.get("data", {})
    return {
        "status": payload.get("status", "unknown"),
        "binding_valid": bool(data.get("binding_valid")),
        "missing_count": len(data.get("missing", []) or []),
        "stale_count": len(data.get("stale", []) or []),
        "missing": data.get("missing", []) or [],
        "stale": data.get("stale", []) or [],
    }


def collect_alert_status() -> dict[str, Any]:
    script = ROOT / "ops/plugins/core/alerting/bin/alerting-status"
    if not script.exists():
        return {
            "status": "error",
            "active_alerts": 0,
            "active_warn_alerts": 0,
            "active_incident_alerts": 0,
            "total_alerts": 0,
            "active_domains": [],
        }
    _, payload = parse_json_output(script, ["--json"])
    domains = payload.get("domains", []) if isinstance(payload, dict) else []
    active = []
    total_alerts = 0
    active_alerts = 0
    active_warn_alerts = 0
    active_incident_alerts = 0
    for d in domains:
        total_alerts += int(d.get("alerts_total", d.get("alerts", 0)) or 0)
        active_count = int(d.get("active_alerts", 0) or 0)
        if active_count <= 0:
            # Backward-compat fallback for older alerting-status payloads.
            legacy_alerts = int(d.get("alerts", 0) or 0)
            if legacy_alerts > 0:
                active_count = legacy_alerts
        if active_count > 0:
            active.append(d.get("domain", ""))
            active_alerts += active_count
        active_warn_alerts += int(d.get("active_warn_alerts", 0) or 0)
        active_incident_alerts += int(d.get("active_incident_alerts", 0) or 0)
    alert_status = "ok"
    if active_incident_alerts > 0:
        alert_status = "error"
    elif active_alerts > 0:
        alert_status = "warn"
    return {
        "status": alert_status,
        "active_alerts": active_alerts,
        "active_warn_alerts": active_warn_alerts,
        "active_incident_alerts": active_incident_alerts,
        "total_alerts": total_alerts,
        "active_domains": active,
        "domains": domains,
    }


def collect_handoff_status() -> dict[str, Any]:
    script = ROOT / "ops/plugins/core/handoff/bin/session-handoff-status"
    if not script.exists():
        return {"active": 0, "closed": 0, "expired": 0}
    _, payload = parse_json_output(script, ["--json"])
    return {
        "active": int(payload.get("active", 0) or 0),
        "closed": int(payload.get("closed", 0) or 0),
        "expired": int(payload.get("expired", 0) or 0),
    }


def collect_forge_pull_requests() -> dict[str, Any]:
    script = ROOT / "ops/plugins/providers/gitea/bin/gitea-pr-list"
    if not script.exists():
        return {
            "status": "unavailable",
            "repo": "",
            "open_pull_requests": 0,
            "merge_candidates": [],
            "message": f"missing script: {script}",
        }

    rc, payload = parse_json_output(script, ["--state", "open", "--limit", "20", "--json"])
    if rc != 0:
        message = ""
        if isinstance(payload, dict):
            error = payload.get("error", {})
            if isinstance(error, dict):
                message = str(error.get("message", "")).strip()
        return {
            "status": "unavailable",
            "repo": "",
            "open_pull_requests": 0,
            "merge_candidates": [],
            "message": message or "gitea.pr.list failed",
        }

    repo = str(payload.get("repo", "")).strip() if isinstance(payload, dict) else ""
    rows = payload.get("pull_requests", []) if isinstance(payload, dict) else []
    if not isinstance(rows, list):
        rows = []

    candidates: list[dict[str, Any]] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        number = row.get("number")
        if not isinstance(number, int):
            continue
        state = str(row.get("state", "")).strip().lower()
        draft = bool(row.get("draft", False))
        merged = bool(row.get("merged", False))
        mergeable = row.get("mergeable")
        base_ref = str(row.get("base_ref", "")).strip()
        base = str(row.get("base", "")).strip()
        targets_main = base_ref == "main" or base == "main" or base.endswith(":main")
        if state != "open" or draft or merged or mergeable is not True or not targets_main:
            continue
        candidates.append(
            {
                "number": number,
                "title": str(row.get("title", "")).strip(),
                "head": str(row.get("head", "")).strip(),
                "head_ref": str(row.get("head_ref", "")).strip(),
                "head_sha": str(row.get("head_sha", "")).strip(),
                "base": base,
                "base_ref": base_ref,
                "url": str(row.get("url", "")).strip(),
            }
        )

    candidates.sort(key=lambda item: (int(item.get("number", 0) or 0), str(item.get("title", ""))))
    return {
        "status": "ok",
        "repo": repo,
        "open_pull_requests": len(rows),
        "merge_candidates": candidates,
        "message": "",
    }


def collect_aof_contract_status() -> dict[str, Any]:
    script = capability_script_path("aof.contract.status", "ops/plugins/core/kernel/aof/bin/contract-read-check.sh")
    if not script.exists():
        return {
            "status": "unavailable",
            "marker_state": "unknown",
            "contract_file": "",
            "marker_file": "",
        }

    rc, out, err = run_cmd([str(script), "--status"], cwd=ROOT)
    text = out.strip() or err.strip()
    status = "current"
    marker_state = "unknown"
    contract_file = ""
    marker_file = ""

    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("contract_file:"):
            contract_file = line.split(":", 1)[1].strip()
        elif line.startswith("marker_file:"):
            marker_file = line.split(":", 1)[1].strip()
        elif line.startswith("marker_state:"):
            marker_state = line.split(":", 1)[1].strip()

    if rc != 0:
        status = "error"
    elif marker_state in {"missing", "stale"}:
        status = "warn"
    elif marker_state == "current":
        status = "ok"

    return {
        "status": status,
        "marker_state": marker_state,
        "contract_file": contract_file,
        "marker_file": marker_file,
    }


def normalize_run_status(value: Any) -> str:
    status = str(value or "").strip().lower()
    if status in VERIFY_PASS_STATUSES:
        return "done"
    if status in VERIFY_FAIL_STATUSES:
        return "failed"
    return status or "unknown"


def summarize_verify_health(events: list[dict[str, Any]]) -> dict[str, Any]:
    verify_events = [e for e in events if str(e.get("capability", "")).startswith("verify.")]
    verify_failed = [e for e in verify_events if normalize_run_status(e.get("status", "")) == "failed"]

    latest_by_capability: dict[str, dict[str, Any]] = {}
    for event in verify_events:
        capability = str(event.get("capability", "")).strip()
        if capability and capability not in latest_by_capability:
            latest_by_capability[capability] = event

    current_failed_caps: list[dict[str, str]] = []
    for capability, event in latest_by_capability.items():
        normalized = normalize_run_status(event.get("status", ""))
        if normalized != "failed":
            continue
        current_failed_caps.append(
            {
                "capability": capability,
                "created_at": str(event.get("created_at", "")),
                "status": str(event.get("status", "")),
                "summary": str(event.get("summary", "")),
            }
        )
    current_failed_caps.sort(key=lambda row: (row.get("created_at", ""), row.get("capability", "")), reverse=True)

    latest_verify = verify_events[0] if verify_events else {}
    core_latest = next((e for e in verify_events if str(e.get("capability", "")) == "verify.core.run"), {})
    core_latest_status = normalize_run_status(core_latest.get("status", "")) if core_latest else "unknown"

    return {
        "verify_total_runs": len(verify_events),
        "verify_failed_runs": len(verify_failed),
        "verify_current_failed_runs": len(current_failed_caps),
        "verify_current_failed_capabilities": current_failed_caps,
        "verify_latest_status": normalize_run_status(latest_verify.get("status", "")) if latest_verify else "unknown",
        "verify_latest_capability": str(latest_verify.get("capability", "")) if latest_verify else "",
        "verify_latest_created_at": str(latest_verify.get("created_at", "")) if latest_verify else "",
        "core_verify_latest_status": core_latest_status,
        "core_verify_latest_created_at": str(core_latest.get("created_at", "")) if core_latest else "",
        "core_verify_needs_attention": core_latest_status == "failed",
    }


def collect_timeline(window_hours: int) -> dict[str, Any]:
    script = ROOT / "ops/plugins/core/evidence/bin/spine-timeline-query"
    if not script.exists():
        return {
            "event_count": 0,
            "verify_total_runs": 0,
            "verify_failed_runs": 0,
            "verify_current_failed_runs": 0,
            "verify_current_failed_capabilities": [],
            "verify_latest_status": "unknown",
            "verify_latest_capability": "",
            "verify_latest_created_at": "",
            "core_verify_latest_status": "unknown",
            "core_verify_latest_created_at": "",
            "core_verify_needs_attention": False,
            "recent_failures": [],
        }
    rc, payload = parse_json_output(script, ["--since", f"{window_hours}h", "--limit", "200", "--format", "json"])
    if rc != 0 and "events" not in payload:
        return {
            "event_count": 0,
            "verify_total_runs": 0,
            "verify_failed_runs": 0,
            "verify_current_failed_runs": 0,
            "verify_current_failed_capabilities": [],
            "verify_latest_status": "unknown",
            "verify_latest_capability": "",
            "verify_latest_created_at": "",
            "core_verify_latest_status": "unknown",
            "core_verify_latest_created_at": "",
            "core_verify_needs_attention": False,
            "recent_failures": [],
        }

    events = payload.get("events", []) if isinstance(payload, dict) else []
    verify_health = summarize_verify_health(events)
    all_failed = [e for e in events if str(e.get("status", "")).lower() == "failed"]
    cap_counts = Counter(str(e.get("capability", "")) for e in events if e.get("capability"))

    return {
        "window_hours": window_hours,
        "event_count": len(events),
        "verify_total_runs": verify_health.get("verify_total_runs", 0),
        "verify_failed_runs": verify_health.get("verify_failed_runs", 0),
        "verify_current_failed_runs": verify_health.get("verify_current_failed_runs", 0),
        "verify_current_failed_capabilities": verify_health.get("verify_current_failed_capabilities", []),
        "verify_latest_status": verify_health.get("verify_latest_status", "unknown"),
        "verify_latest_capability": verify_health.get("verify_latest_capability", ""),
        "verify_latest_created_at": verify_health.get("verify_latest_created_at", ""),
        "core_verify_latest_status": verify_health.get("core_verify_latest_status", "unknown"),
        "core_verify_latest_created_at": verify_health.get("core_verify_latest_created_at", ""),
        "core_verify_needs_attention": bool(verify_health.get("core_verify_needs_attention", False)),
        "recent_failures": [
            {
                "created_at": e.get("created_at", ""),
                "capability": e.get("capability", ""),
                "status": e.get("status", ""),
                "summary": e.get("summary", ""),
            }
            for e in all_failed[:10]
        ],
        "top_capabilities": [{"capability": k, "count": v} for k, v in cap_counts.most_common(10)],
        "source_counts": payload.get("source_counts", {}),
    }


def collect_graph_summary() -> dict[str, Any]:
    script = ROOT / "ops/plugins/core/evidence/bin/spine-graph-show"
    if not script.exists():
        return {"status": "error", "view_id": "", "node_count": 0, "edge_count": 0}

    rc, payload = parse_json_output(script, ["--format", "json"])
    if rc != 0 and not payload:
        return {"status": "error", "view_id": "", "node_count": 0, "edge_count": 0}

    nodes = payload.get("nodes", []) if isinstance(payload, dict) else []
    edges = payload.get("edges", []) if isinstance(payload, dict) else []
    view = payload.get("view", {}) if isinstance(payload, dict) else {}
    return {
        "status": "ok" if isinstance(payload, dict) else "error",
        "view_id": view.get("id", ""),
        "node_count": len(nodes),
        "edge_count": len(edges),
    }


def collect_comms_queue_status() -> dict[str, Any]:
    script = ROOT / "ops/plugins/domains/communications/bin/communications-alerts-runtime-status"
    if not script.exists():
        return {
            "slo_status": "unknown",
            "queue_pending_count": 0,
            "queue_oldest_age_seconds": 0,
            "escalation_recommended": False,
            "pending_escalation_task_count": 0,
            "oneliner": "",
        }
    _, payload = parse_json_output(script, ["--json"])
    if not payload:
        return {
            "slo_status": "unknown",
            "queue_pending_count": 0,
            "queue_oldest_age_seconds": 0,
            "escalation_recommended": False,
            "pending_escalation_task_count": 0,
            "oneliner": "",
        }
    data = payload.get("data", {})
    return {
        "slo_status": str(data.get("slo_status", "unknown")),
        "queue_pending_count": int(data.get("queue_pending_count", 0) or 0),
        "queue_oldest_age_seconds": int(data.get("queue_oldest_age_seconds", 0) or 0),
        "escalation_recommended": bool(data.get("escalation_recommended", False)),
        "pending_escalation_task_count": int(data.get("pending_escalation_task_count", 0) or 0),
        "last_escalation_at": str(data.get("last_escalation_at", "")),
        "last_escalation_fingerprint": str(data.get("last_escalation_fingerprint", "")),
        "oneliner": str(data.get("oneliner", "")),
    }


