#!/usr/bin/env python3
"""
Receipt Aggregation Status

Implements mechanical completion determination for delegated and multi-lane work
based on role.runtime.control.contract.yaml aggregation schemas.

Reads receipt index and linkage artifacts to produce authoritative completion verdicts.

Usage:
  receipt-aggregation-status --parent-run-key <CAP-*|S-*>
  receipt-aggregation-status --wave-id <WAVE-*>
  receipt-aggregation-status --loop-id <LOOP-*>
  receipt-aggregation-status --list-delegated
"""

import argparse
import datetime as dt
import json
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional

# ── Path Bootstrap ───────────────────────────────────────────────────────────

SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parents[5]

import os

def get_paths():
    """Get spine paths, respecting environment overrides"""
    # Check environment first (for testing)
    if os.getenv("SPINE_STATE"):
        spine_state = Path(os.getenv("SPINE_STATE"))
        spine_evidence_root = Path(os.getenv("SPINE_EVIDENCE_ROOT", str(Path.home() / "code/.evidence/spine")))
        spine_verify_root = Path(os.getenv("SPINE_VERIFY_ROOT", str(spine_evidence_root / "reports/verify")))
    else:
        # Try runtime_paths_py
        sys.path.insert(0, str(ROOT / "ops/lib"))
        try:
            from runtime_paths_py import spine_runtime_resolve_paths
            paths = spine_runtime_resolve_paths()
            spine_state = Path(paths["SPINE_STATE"])
            spine_evidence_root = Path(paths["SPINE_EVIDENCE_ROOT"])
            spine_verify_root = Path(paths["SPINE_VERIFY_ROOT"])
        except ImportError:
            # Fallback if runtime_paths_py not available
            spine_state = Path.home() / "code/.runtime/spine/state"
            spine_evidence_root = Path.home() / "code/.evidence/spine"
            spine_verify_root = spine_evidence_root / "reports/verify"

    return {
        "SPINE_STATE": spine_state,
        "SPINE_EVIDENCE_ROOT": spine_evidence_root,
        "SPINE_VERIFY_ROOT": spine_verify_root,
    }


# Initialize paths - will be overridden in main() if needed
_paths = get_paths()
SPINE_STATE = _paths["SPINE_STATE"]
SPINE_EVIDENCE_ROOT = _paths["SPINE_EVIDENCE_ROOT"]
SPINE_VERIFY_ROOT = _paths["SPINE_VERIFY_ROOT"]

RECEIPT_INDEX_FILE = SPINE_VERIFY_ROOT / "indexes/receipt-index.yaml"
DISPATCH_LINKAGE_DIR = SPINE_STATE / "dispatch/linkage"
DISPATCH_COMPLETION_DIR = SPINE_STATE / "dispatch/completion"
DISPATCH_AGGREGATION_DIR = SPINE_STATE / "dispatch/aggregation"

# ── YAML/JSON Helpers ────────────────────────────────────────────────────────

def load_yaml(path: Path) -> dict:
    """Load YAML file via yq and return as dict"""
    if not path.exists():
        return {}
    try:
        raw = subprocess.check_output(
            ["yq", "-o=json", ".", str(path)],
            text=True,
            stderr=subprocess.DEVNULL
        )
        return json.loads(raw)
    except Exception:
        return {}


def save_yaml(path: Path, data: dict):
    """Save dict as YAML via yq"""
    path.parent.mkdir(parents=True, exist_ok=True)
    json_str = json.dumps(data, indent=2)
    subprocess.run(
        ["yq", "-P", "."],
        input=json_str,
        text=True,
        stdout=open(path, "w"),
        check=True
    )


# ── Receipt Index ────────────────────────────────────────────────────────────

def load_receipt_index(receipt_index_file: Path = None) -> List[dict]:
    """Load receipt index entries"""
    index_file = receipt_index_file or RECEIPT_INDEX_FILE
    if not index_file.exists():
        return []
    index_data = load_yaml(index_file)
    return index_data.get("entries", [])


def find_receipt_by_run_key(run_key: str, receipt_index_file: Path = None) -> Optional[dict]:
    """Find receipt entry by run_key in index"""
    entries = load_receipt_index(receipt_index_file)
    for entry in entries:
        if entry.get("run_id") == run_key:
            return entry
    return None


# ── Completion Determination ─────────────────────────────────────────────────

def determine_completion_status(
    parent_run_key: str,
    child_run_keys_expected: List[str],
    timeout_utc: Optional[str] = None,
    receipt_index_file: Path = None
) -> dict:
    """
    Determine completion status for delegated work.

    Returns dict with:
      - completion_status: complete | awaiting_delegated_receipt | blocked_delegated | timeout_delegated
      - child_run_keys_actual: list of child run keys found in receipt index
      - child_run_keys_missing: list of expected but not found
      - completion_determined_at_utc: ISO8601 timestamp
      - timeout_exceeded: bool
    """
    now_utc = dt.datetime.now(dt.timezone.utc)
    now_iso = now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")

    # Find actual child receipts
    child_run_keys_actual = []
    child_run_keys_missing = []
    child_statuses = {}

    for expected_key in child_run_keys_expected:
        receipt = find_receipt_by_run_key(expected_key, receipt_index_file)
        if receipt:
            child_run_keys_actual.append(expected_key)
            child_statuses[expected_key] = receipt.get("status", "unknown")
        else:
            child_run_keys_missing.append(expected_key)

    # Check timeout
    timeout_exceeded = False
    if timeout_utc:
        try:
            timeout_dt = dt.datetime.fromisoformat(timeout_utc.replace("Z", "+00:00"))
            timeout_exceeded = now_utc > timeout_dt
        except Exception:
            pass

    # Determine status based on criteria from role.runtime.control.contract.yaml
    if len(child_run_keys_missing) == 0:
        # All child receipts received
        # Check if any failed
        failed_children = [k for k, status in child_statuses.items() if status != "done"]
        if failed_children:
            completion_status = "blocked_delegated"
        else:
            completion_status = "complete"
    elif timeout_exceeded:
        completion_status = "timeout_delegated"
    else:
        completion_status = "awaiting_delegated_receipt"

    return {
        "parent_run_key": parent_run_key,
        "completion_status": completion_status,
        "child_run_keys_expected_count": len(child_run_keys_expected),
        "child_run_keys_actual_count": len(child_run_keys_actual),
        "child_run_keys_missing_count": len(child_run_keys_missing),
        "child_run_keys_actual": child_run_keys_actual,
        "child_run_keys_missing": child_run_keys_missing,
        "child_statuses": child_statuses,
        "timeout_exceeded": timeout_exceeded,
        "completion_determined_at_utc": now_iso,
    }


# ── Linkage Management ───────────────────────────────────────────────────────

def load_linkage(parent_run_key: str, linkage_dir: Path = None) -> Optional[dict]:
    """Load linkage artifact for parent run key"""
    link_dir = linkage_dir or DISPATCH_LINKAGE_DIR
    linkage_file = link_dir / f"{parent_run_key}.linkage.yaml"
    return load_yaml(linkage_file) if linkage_file.exists() else None


def save_linkage(linkage_data: dict, linkage_dir: Path = None):
    """Save linkage artifact"""
    link_dir = linkage_dir or DISPATCH_LINKAGE_DIR
    parent_run_key = linkage_data["parent_run_key"]
    linkage_file = link_dir / f"{parent_run_key}.linkage.yaml"
    save_yaml(linkage_file, linkage_data)


def save_completion(completion_data: dict, completion_dir: Path = None):
    """Save completion artifact"""
    comp_dir = completion_dir or DISPATCH_COMPLETION_DIR
    parent_run_key = completion_data["parent_run_key"]
    completion_file = comp_dir / f"{parent_run_key}.completion.yaml"
    save_yaml(completion_file, completion_data)


# ── Wave Aggregation ─────────────────────────────────────────────────────────

def load_orchestration_packet(loop_id: str, state_dir: Path = None) -> Optional[dict]:
    """Load orchestration packet for loop"""
    spine_state = state_dir or SPINE_STATE
    packet_file = spine_state / "orchestration" / loop_id / "packet.yaml"
    return load_yaml(packet_file) if packet_file.exists() else None


def determine_wave_aggregation_status(
    wave_id: str,
    lane_statuses: List[dict],
    timeout_utc: Optional[str] = None
) -> dict:
    """
    Determine wave aggregation status from lane completion states.

    Returns dict with:
      - aggregation_status: incomplete | complete | blocked | partial
      - lane_count: total lanes
      - lanes_complete: count of completed lanes
      - lanes_blocked: count of blocked lanes
      - timeout_exceeded: bool
    """
    now_utc = dt.datetime.now(dt.timezone.utc)
    now_iso = now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")

    # Count lane states
    total_lanes = len(lane_statuses)
    lanes_complete = 0
    lanes_blocked = 0
    lanes_incomplete = 0

    # Terminal states from orchestration: CLOSED, FAILED, REJECTED
    # Non-terminal: DISPATCHED, EXECUTING, VALIDATED, TICKET_ISSUED, ENTRY_READY
    terminal_complete_states = ["CLOSED", "closed"]
    terminal_failed_states = ["FAILED", "failed", "REJECTED", "rejected", "BLOCKED", "blocked"]
    non_terminal_states = ["DISPATCHED", "dispatched", "EXECUTING", "executing",
                          "VALIDATED", "validated", "TICKET_ISSUED", "ticket-issued",
                          "ENTRY_READY", "entry-ready", "open"]

    for lane in lane_statuses:
        status = lane.get("lane_status", "unknown")
        if status in terminal_complete_states:
            lanes_complete += 1
        elif status in terminal_failed_states:
            lanes_blocked += 1
        else:
            lanes_incomplete += 1

    # Check timeout
    timeout_exceeded = False
    if timeout_utc:
        try:
            timeout_dt = dt.datetime.fromisoformat(timeout_utc.replace("Z", "+00:00"))
            timeout_exceeded = now_utc > timeout_dt
        except Exception:
            pass

    # Determine aggregation status per role.runtime.control.contract.yaml
    if lanes_complete == total_lanes:
        aggregation_status = "complete"
    elif lanes_blocked > 0:
        aggregation_status = "blocked"
    elif timeout_exceeded and lanes_incomplete > 0:
        aggregation_status = "partial"
    else:
        aggregation_status = "incomplete"

    return {
        "wave_id": wave_id,
        "aggregation_status": aggregation_status,
        "total_lanes": total_lanes,
        "lanes_complete": lanes_complete,
        "lanes_blocked": lanes_blocked,
        "lanes_incomplete": lanes_incomplete,
        "timeout_exceeded": timeout_exceeded,
        "aggregation_determined_at_utc": now_iso,
    }


def save_aggregation(aggregation_data: dict, aggregation_dir: Path = None):
    """Save wave or loop aggregation artifact"""
    agg_dir = aggregation_dir or DISPATCH_AGGREGATION_DIR
    wave_or_loop_id = aggregation_data.get("wave_id") or aggregation_data.get("loop_id")
    aggregation_file = agg_dir / f"{wave_or_loop_id}.aggregation.yaml"
    save_yaml(aggregation_file, aggregation_data)


def query_wave_aggregation(
    wave_id: str,
    loop_id: Optional[str] = None,
    json_output: bool = False,
    state_dir: Path = None,
    aggregation_dir: Path = None
) -> dict:
    """
    Query wave aggregation status.

    Reads orchestration packet to find wave lane statuses,
    derives aggregation verdict, and saves artifact.
    """
    spine_state = state_dir or SPINE_STATE

    # If loop_id provided, load packet directly
    if loop_id:
        packet = load_orchestration_packet(loop_id, spine_state)
        if not packet:
            result = {
                "wave_id": wave_id,
                "loop_id": loop_id,
                "packet_found": False,
                "aggregation_status": "unknown",
                "message": f"No orchestration packet found for loop {loop_id}",
            }
            if json_output:
                print(json.dumps(result, indent=2))
            else:
                print(f"wave_id: {wave_id}")
                print(f"loop_id: {loop_id}")
                print(f"packet_found: False")
                print(f"message: {result['message']}")
            return result

        # Find wave in packet
        wave_plan = packet.get("wave_plan", [])
        wave_entry = None
        for wave in wave_plan:
            if wave.get("wave_id") == wave_id:
                wave_entry = wave
                break

        if not wave_entry:
            result = {
                "wave_id": wave_id,
                "loop_id": loop_id,
                "wave_found": False,
                "aggregation_status": "unknown",
                "message": f"Wave {wave_id} not found in loop {loop_id} packet",
            }
            if json_output:
                print(json.dumps(result, indent=2))
            else:
                print(f"wave_id: {wave_id}")
                print(f"message: {result['message']}")
            return result

        # Get lane outcomes
        lane_outcomes = packet.get("lane_outcomes", [])
        timeout_utc = packet.get("deadline_utc") or packet.get("timeout_utc")

        aggregation = determine_wave_aggregation_status(wave_id, lane_outcomes, timeout_utc)
        aggregation["loop_id"] = loop_id
        aggregation["aggregation_type"] = "wave"
        aggregation["lane_statuses"] = lane_outcomes

        # Save aggregation artifact
        save_aggregation(aggregation, aggregation_dir)

        result = {
            "wave_id": wave_id,
            "loop_id": loop_id,
            "packet_found": True,
            **aggregation
        }
    else:
        # No loop_id: try to find wave in any orchestration packet
        result = {
            "wave_id": wave_id,
            "aggregation_status": "unknown",
            "message": "Wave aggregation requires --loop-id parameter (wave lookup across loops not yet implemented)",
        }

    if json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"wave_id: {result['wave_id']}")
        if result.get("packet_found"):
            print(f"loop_id: {result['loop_id']}")
            print(f"aggregation_status: {result['aggregation_status']}")
            print(f"total_lanes: {result['total_lanes']}")
            print(f"lanes_complete: {result['lanes_complete']}")
            print(f"lanes_blocked: {result['lanes_blocked']}")
            print(f"lanes_incomplete: {result['lanes_incomplete']}")
        else:
            print(f"message: {result.get('message', 'unknown')}")

    return result


# ── Loop Aggregation ─────────────────────────────────────────────────────────

def determine_loop_aggregation_status(
    loop_id: str,
    wave_statuses: List[dict]
) -> dict:
    """
    Determine loop aggregation status from wave aggregation states.

    Returns dict with:
      - loop_aggregation_status: in_progress | complete | blocked
      - total_waves: count
      - waves_complete: count
      - waves_blocked: count
    """
    now_utc = dt.datetime.now(dt.timezone.utc)
    now_iso = now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")

    total_waves = len(wave_statuses)
    waves_complete = 0
    waves_blocked = 0
    waves_incomplete = 0

    for wave in wave_statuses:
        status = wave.get("aggregation_status", "unknown")
        if status == "complete":
            waves_complete += 1
        elif status in ["blocked", "partial"]:
            waves_blocked += 1
        else:
            waves_incomplete += 1

    # Determine loop status per role.runtime.control.contract.yaml
    if waves_complete == total_waves:
        loop_aggregation_status = "complete"
    elif waves_blocked > 0:
        loop_aggregation_status = "blocked"
    else:
        loop_aggregation_status = "in_progress"

    return {
        "loop_id": loop_id,
        "loop_aggregation_status": loop_aggregation_status,
        "total_waves": total_waves,
        "waves_complete": waves_complete,
        "waves_blocked": waves_blocked,
        "waves_incomplete": waves_incomplete,
        "aggregation_determined_at_utc": now_iso,
    }


def query_loop_aggregation(
    loop_id: str,
    json_output: bool = False,
    state_dir: Path = None,
    aggregation_dir: Path = None
) -> dict:
    """
    Query loop aggregation status.

    Reads orchestration packet to find all waves,
    aggregates wave statuses to loop verdict.
    """
    spine_state = state_dir or SPINE_STATE
    packet = load_orchestration_packet(loop_id, spine_state)

    if not packet:
        result = {
            "loop_id": loop_id,
            "packet_found": False,
            "loop_aggregation_status": "unknown",
            "message": f"No orchestration packet found for loop {loop_id}",
        }
        if json_output:
            print(json.dumps(result, indent=2))
        else:
            print(f"loop_id: {loop_id}")
            print(f"packet_found: False")
            print(f"message: {result['message']}")
        return result

    wave_plan = packet.get("wave_plan", [])

    # Aggregate wave statuses
    wave_statuses = []
    for wave_entry in wave_plan:
        wave_id = wave_entry.get("wave_id")
        # Determine wave status from lane_outcomes
        lane_outcomes = packet.get("lane_outcomes", [])
        timeout_utc = packet.get("deadline_utc") or packet.get("timeout_utc")
        wave_agg = determine_wave_aggregation_status(wave_id, lane_outcomes, timeout_utc)
        wave_statuses.append(wave_agg)

    # Determine loop status
    loop_agg = determine_loop_aggregation_status(loop_id, wave_statuses)
    loop_agg["aggregation_type"] = "loop"
    loop_agg["wave_statuses"] = wave_statuses

    # Save aggregation artifact
    save_aggregation(loop_agg, aggregation_dir)

    result = {
        "loop_id": loop_id,
        "packet_found": True,
        **loop_agg
    }

    if json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"loop_id: {result['loop_id']}")
        print(f"loop_aggregation_status: {result['loop_aggregation_status']}")
        print(f"total_waves: {result['total_waves']}")
        print(f"waves_complete: {result['waves_complete']}")
        print(f"waves_blocked: {result['waves_blocked']}")
        print(f"waves_incomplete: {result['waves_incomplete']}")

    return result


# ── Query Commands ───────────────────────────────────────────────────────────

def query_parent_completion(
    parent_run_key: str,
    json_output: bool = False,
    receipt_index_file: Path = None,
    linkage_dir: Path = None,
    completion_dir: Path = None
) -> dict:
    """Query completion status for a parent run key"""
    linkage = load_linkage(parent_run_key, linkage_dir)

    if not linkage:
        # No linkage artifact means this is not delegated work or linkage not yet created
        result = {
            "parent_run_key": parent_run_key,
            "linkage_found": False,
            "completion_status": "unknown",
            "message": "No linkage artifact found. Either work is not delegated or linkage not yet created.",
        }
    else:
        child_run_keys_expected = linkage.get("child_run_keys_expected", [])
        timeout_utc = linkage.get("timeout_utc")

        completion = determine_completion_status(
            parent_run_key,
            child_run_keys_expected,
            timeout_utc,
            receipt_index_file
        )

        # Save completion artifact
        save_completion(completion, completion_dir)

        result = {
            "parent_run_key": parent_run_key,
            "linkage_found": True,
            **completion
        }

    if json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"parent_run_key: {result['parent_run_key']}")
        print(f"linkage_found: {result['linkage_found']}")
        if result["linkage_found"]:
            print(f"completion_status: {result['completion_status']}")
            print(f"child_run_keys_expected: {result['child_run_keys_expected_count']}")
            print(f"child_run_keys_actual: {result['child_run_keys_actual_count']}")
            print(f"child_run_keys_missing: {result['child_run_keys_missing_count']}")
            if result["child_run_keys_missing"]:
                print("missing_keys:")
                for key in result["child_run_keys_missing"]:
                    print(f"  - {key}")
            if result.get("child_statuses"):
                print("child_statuses:")
                for key, status in result["child_statuses"].items():
                    print(f"  - {key}: {status}")
        else:
            print(f"message: {result['message']}")

    return result


def list_delegated_work(
    json_output: bool = False,
    receipt_index_file: Path = None,
    linkage_dir: Path = None
):
    """List all linkage artifacts (delegated work)"""
    link_dir = linkage_dir or DISPATCH_LINKAGE_DIR
    if not link_dir.exists():
        if json_output:
            print(json.dumps({"delegated_work": []}))
        else:
            print("No delegated work found (no linkage directory)")
        return

    linkage_files = list(link_dir.glob("*.linkage.yaml"))

    results = []
    for linkage_file in sorted(linkage_files):
        linkage = load_yaml(linkage_file)
        parent_run_key = linkage.get("parent_run_key", linkage_file.stem.replace(".linkage", ""))

        child_run_keys_expected = linkage.get("child_run_keys_expected", [])
        timeout_utc = linkage.get("timeout_utc")

        completion = determine_completion_status(
            parent_run_key,
            child_run_keys_expected,
            timeout_utc,
            receipt_index_file
        )

        results.append({
            "parent_run_key": parent_run_key,
            "completion_status": completion["completion_status"],
            "child_count_expected": len(child_run_keys_expected),
            "child_count_actual": completion["child_run_keys_actual_count"],
            "child_count_missing": completion["child_run_keys_missing_count"],
        })

    if json_output:
        print(json.dumps({"delegated_work": results}, indent=2))
    else:
        print(f"Delegated work items: {len(results)}")
        print()
        for item in results:
            print(f"parent_run_key: {item['parent_run_key']}")
            print(f"  completion_status: {item['completion_status']}")
            print(f"  children: {item['child_count_actual']}/{item['child_count_expected']} (missing: {item['child_count_missing']})")
            print()


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    global SPINE_STATE, SPINE_EVIDENCE_ROOT, SPINE_VERIFY_ROOT
    global RECEIPT_INDEX_FILE, DISPATCH_LINKAGE_DIR, DISPATCH_COMPLETION_DIR, DISPATCH_AGGREGATION_DIR

    # Refresh paths to pick up environment overrides
    _paths = get_paths()
    SPINE_STATE = _paths["SPINE_STATE"]
    SPINE_EVIDENCE_ROOT = _paths["SPINE_EVIDENCE_ROOT"]
    SPINE_VERIFY_ROOT = _paths["SPINE_VERIFY_ROOT"]

    RECEIPT_INDEX_FILE = SPINE_VERIFY_ROOT / "indexes/receipt-index.yaml"
    DISPATCH_LINKAGE_DIR = SPINE_STATE / "dispatch/linkage"
    DISPATCH_COMPLETION_DIR = SPINE_STATE / "dispatch/completion"
    DISPATCH_AGGREGATION_DIR = SPINE_STATE / "dispatch/aggregation"

    parser = argparse.ArgumentParser(
        description="Receipt aggregation status - mechanical completion determination for delegated work"
    )
    parser.add_argument("--parent-run-key", help="Query completion status for parent run key (CAP-* or S-*)")
    parser.add_argument("--wave-id", help="Query aggregation status for wave")
    parser.add_argument("--loop-id", help="Query aggregation status for loop (required with --wave-id for wave queries)")
    parser.add_argument("--list-delegated", action="store_true", help="List all delegated work items")
    parser.add_argument("--json", action="store_true", help="Output JSON format")
    parser.add_argument("--receipt-index", help="Override receipt index path (for testing)")
    parser.add_argument("--linkage-dir", help="Override linkage directory path (for testing)")
    parser.add_argument("--completion-dir", help="Override completion directory path (for testing)")
    parser.add_argument("--state-dir", help="Override SPINE_STATE directory (for testing)")
    parser.add_argument("--aggregation-dir", help="Override aggregation directory path (for testing)")

    args = parser.parse_args()

    # Apply overrides if provided (for testing)
    if args.receipt_index:
        RECEIPT_INDEX_FILE = Path(args.receipt_index)
    if args.linkage_dir:
        DISPATCH_LINKAGE_DIR = Path(args.linkage_dir)
    if args.completion_dir:
        DISPATCH_COMPLETION_DIR = Path(args.completion_dir)
    if args.state_dir:
        SPINE_STATE = Path(args.state_dir)
    if args.aggregation_dir:
        DISPATCH_AGGREGATION_DIR = Path(args.aggregation_dir)

    if not any([args.parent_run_key, args.wave_id, args.loop_id, args.list_delegated]):
        parser.print_help()
        sys.exit(1)

    if args.list_delegated:
        list_delegated_work(args.json, RECEIPT_INDEX_FILE, DISPATCH_LINKAGE_DIR)
        return

    if args.parent_run_key:
        query_parent_completion(
            args.parent_run_key,
            args.json,
            RECEIPT_INDEX_FILE,
            DISPATCH_LINKAGE_DIR,
            DISPATCH_COMPLETION_DIR
        )
        return

    if args.wave_id:
        if not args.loop_id:
            print("ERROR: --wave-id requires --loop-id parameter", file=sys.stderr)
            sys.exit(2)
        query_wave_aggregation(
            args.wave_id,
            args.loop_id,
            args.json,
            SPINE_STATE,
            DISPATCH_AGGREGATION_DIR
        )
        return

    if args.loop_id:
        query_loop_aggregation(
            args.loop_id,
            args.json,
            SPINE_STATE,
            DISPATCH_AGGREGATION_DIR
        )
        return


if __name__ == "__main__":
    main()
