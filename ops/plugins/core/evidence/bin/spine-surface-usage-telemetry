#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

import yaml


def expand(raw: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(raw)))).resolve()


DEFAULT_ROOT = expand(Path(__file__).resolve().parents[5])


def git_top_level(start: Path) -> Path | None:
    probe = start if start.is_dir() else start.parent
    proc = subprocess.run(
        ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    stdout = proc.stdout.strip()
    return Path(stdout).resolve() if stdout else None


def resolve_target_root(explicit: str | None = None) -> Path:
    if explicit:
        return expand(explicit)
    cwd_root = git_top_level(Path.cwd())
    if cwd_root is not None:
        return cwd_root
    script_root = git_top_level(Path(__file__).resolve())
    if script_root is not None:
        return script_root
    for env_name in ("SPINE_TARGET_REPO", "SPINE_ROOT", "SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(env_name)
        if value:
            return expand(value)
    return DEFAULT_ROOT


ROOT = DEFAULT_ROOT
CONTRACT = ROOT / "ops/bindings/spine.surface.usage.telemetry.contract.yaml"
CAPABILITIES = ROOT / "ops/capabilities.yaml"
GATE_REGISTRY = ROOT / "ops/bindings/gate.registry.yaml"
NOW = datetime.now(timezone.utc)


def fail(message: str, code: int = 1) -> None:
    print(f"spine.surface.usage.telemetry FAIL: {message}", file=os.sys.stderr)
    raise SystemExit(code)


def load_yaml(path: Path) -> dict[str, Any]:
    if not path.is_file():
        fail(f"missing YAML file: {path}")
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        fail(f"expected mapping root: {path}")
    return data


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="spine-surface-usage-telemetry")
    parser.add_argument("--root", help="Target checkout root.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--brief", action="store_true")
    return parser.parse_args()


def configure_root(root: Path) -> None:
    global ROOT, CONTRACT, CAPABILITIES, GATE_REGISTRY

    ROOT = root
    CONTRACT = ROOT / "ops/bindings/spine.surface.usage.telemetry.contract.yaml"
    CAPABILITIES = ROOT / "ops/capabilities.yaml"
    GATE_REGISTRY = ROOT / "ops/bindings/gate.registry.yaml"


def receipt_capability_counts(receipts_root: Path, cutoff: datetime) -> dict[str, int]:
    counts: dict[str, int] = {}
    if not receipts_root.exists():
        return counts
    for receipt_dir in receipts_root.glob("RCAP-*__*__*"):
        try:
            modified = datetime.fromtimestamp(receipt_dir.stat().st_mtime, tz=timezone.utc)
        except FileNotFoundError:
            continue
        if modified < cutoff:
            continue
        parts = receipt_dir.name.split("__")
        if len(parts) < 3:
            continue
        capability = parts[1]
        counts[capability] = counts.get(capability, 0) + 1
    return counts


def recent_verify_outputs(receipts_root: Path, cutoff: datetime, allowed_caps: list[str]) -> list[str]:
    outputs: list[str] = []
    if not receipts_root.exists():
        return outputs
    for capability in allowed_caps:
        for receipt_dir in receipts_root.glob(f"RCAP-*__{capability}__*"):
            try:
                modified = datetime.fromtimestamp(receipt_dir.stat().st_mtime, tz=timezone.utc)
            except FileNotFoundError:
                continue
            if modified < cutoff:
                continue
            output_path = receipt_dir / "output.txt"
            if output_path.is_file():
                outputs.append(output_path.read_text(encoding="utf-8", errors="replace"))
    return outputs


def binding_reference_count(root: Path, relative_path: str, scan_roots: list[str]) -> int:
    target = relative_path.strip()
    count = 0
    for scan_root in scan_roots:
        base = root / scan_root
        if not base.exists():
            continue
        for path in base.rglob("*"):
            if not path.is_file():
                continue
            if path.resolve() == (root / target).resolve():
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                continue
            if target in text:
                count += 1
    return count


def main() -> None:
    args = parse_args()
    configure_root(resolve_target_root(args.root))
    contract = load_yaml(CONTRACT)
    capabilities = load_yaml(CAPABILITIES)
    gate_registry = load_yaml(GATE_REGISTRY)

    windows = contract.get("telemetry_windows") or {}
    recent_days = int(windows.get("recent_days", 30))
    dormant_capability_days = int(windows.get("dormant_capability_days", recent_days))
    dormant_gate_days = int(windows.get("dormant_gate_days", recent_days))
    top_n = int(windows.get("top_n", 10))
    cutoff_recent = NOW - timedelta(days=recent_days)
    cutoff_cap = NOW - timedelta(days=dormant_capability_days)
    cutoff_gate = NOW - timedelta(days=dormant_gate_days)

    receipts_root = expand((contract.get("receipt_surfaces") or {}).get("root") or ROOT.parent / ".evidence/spine/sessions")
    capability_counts = receipt_capability_counts(receipts_root, cutoff_cap)
    verify_outputs = recent_verify_outputs(
        receipts_root,
        cutoff_gate,
        [str(item) for item in ((contract.get("receipt_surfaces") or {}).get("gate_receipt_capabilities") or [])],
    )

    cap_rows = (capabilities.get("capabilities") or {}) if isinstance(capabilities, dict) else {}
    dormant_capabilities = []
    for capability_id, row in cap_rows.items():
        row = row if isinstance(row, dict) else {}
        lifecycle = str(row.get("lifecycle") or "ready")
        if lifecycle in {"experimental", "incubating"}:
            continue
        count = capability_counts.get(capability_id, 0)
        if count == 0:
            dormant_capabilities.append({"capability": capability_id, "usage_30d": 0})
    dormant_capabilities = sorted(dormant_capabilities, key=lambda row: row["capability"])[:top_n]

    active_gates = [
        row for row in ((gate_registry.get("gates") or []) if isinstance(gate_registry, dict) else [])
        if isinstance(row, dict) and not row.get("retired", False)
    ]
    gate_hits: dict[str, int] = {}
    for output_text in verify_outputs:
        for gate in active_gates:
            gate_id = str(gate.get("id") or "").strip()
            if gate_id and gate_id in output_text:
                gate_hits[gate_id] = gate_hits.get(gate_id, 0) + 1
    dormant_gates = [
        {"gate_id": str(gate.get("id") or "").strip(), "seen_recently": gate_hits.get(str(gate.get("id") or "").strip(), 0)}
        for gate in active_gates
        if str(gate.get("id") or "").strip() and gate_hits.get(str(gate.get("id") or "").strip(), 0) == 0
    ]
    dormant_gates = sorted(dormant_gates, key=lambda row: row["gate_id"])[:top_n]

    binding_scan = contract.get("binding_reference_scan") or {}
    scan_roots = [str(item) for item in (binding_scan.get("roots") or [])]
    tracked_bindings = [str(item) for item in (binding_scan.get("tracked_bindings") or [])]
    low_reference_bindings = []
    for binding in tracked_bindings:
        refs = binding_reference_count(ROOT, binding, scan_roots)
        if refs <= 1:
            low_reference_bindings.append({"binding": binding, "reference_count": refs})
    low_reference_bindings = sorted(low_reference_bindings, key=lambda row: (row["reference_count"], row["binding"]))[:top_n]

    payload = {
        "capability": "spine.surface.usage.telemetry",
        "generated_at": NOW.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "window_days": recent_days,
        "capabilities": {
            "recently_used_count": len([cap for cap, count in capability_counts.items() if count > 0]),
            "dormant_candidates": dormant_capabilities,
        },
        "gates": {
            "active_total": len(active_gates),
            "seen_recently_count": len(gate_hits),
            "dormant_candidates": dormant_gates,
        },
        "bindings": {
            "tracked_total": len(tracked_bindings),
            "low_reference_candidates": low_reference_bindings,
        },
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=False))
        return
    if args.brief:
        print(
            "status=ok"
            f" capability_dormant={len(dormant_capabilities)}"
            f" gate_dormant={len(dormant_gates)}"
            f" binding_low_ref={len(low_reference_bindings)}"
        )
        return

    print("spine.surface.usage.telemetry")
    print(f"window_days: {recent_days}")
    print(f"capability_dormant_candidates: {len(dormant_capabilities)}")
    print(f"gate_dormant_candidates: {len(dormant_gates)}")
    print(f"binding_low_reference_candidates: {len(low_reference_bindings)}")


if __name__ == "__main__":
    main()
