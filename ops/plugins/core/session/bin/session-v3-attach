#!/usr/bin/env python3
"""session-v3-attach

Canonical terminal attach surface for Spine V3.

This command is the human-facing entry for already-open terminals. It owns:
- session bootstrap (unless explicitly skipped by launcher internals)
- loop resolution
- optional ingress sanitization
- entry packet compilation
- immediate friction snapshot

Direct human use of ``session.start`` is deprecated; it remains the bootstrap
subroutine used under this attach surface and by launcher internals.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
PROMPT_REGISTRY_PATH = ROOT / "ops/bindings/prompt.registry.yaml"
PROMPT_LIBRARY_BOOTSTRAP = ROOT / "ops/plugins/core/session/bin/prompt-library-bootstrap"


def canonical_path(raw: str | None) -> Path:
    expanded = Path(str(raw or "")).expanduser()
    try:
        return expanded.resolve(strict=False)
    except Exception:
        return expanded.absolute()


def git_toplevel(path: Path) -> Path | None:
    proc = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
        check=False,
        env=os.environ.copy(),
    )
    if proc.returncode != 0:
        return None
    root = proc.stdout.strip()
    if not root:
        return None
    return canonical_path(root)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as fh:
        loaded = yaml.safe_load(fh)
    return default if loaded is None else loaded


def resolve_state_root() -> Path:
    contract = load_yaml(ROOT / "ops/bindings/mailroom.runtime.contract.yaml", {})
    runtime_active = bool(contract.get("active"))
    runtime_root = str(contract.get("runtime_root", "")).strip()
    if os.environ.get("SPINE_STATE"):
        return Path(os.environ["SPINE_STATE"])
    if runtime_active and runtime_root:
        state_root = str(contract.get("state_root", "")).strip()
        if state_root:
            return Path(state_root)
        return Path(runtime_root) / "state"
    raise RuntimeError(
        "resolve_state_root: mailroom.runtime.contract is not active and SPINE_STATE is unset. "
        "Repo-local fallback is permanently disabled per D423/root-authority contract. "
        "Set SPINE_STATE or ensure ops/bindings/mailroom.runtime.contract.yaml has active: true."
    )


def resolve_role_prompt_set(role: str) -> dict[str, Any] | None:
    registry = load_yaml(PROMPT_REGISTRY_PATH, {})
    role_sets = registry.get("role_prompt_sets") if isinstance(registry, dict) else {}
    prompt_set = role_sets.get(role) if isinstance(role_sets, dict) else None
    if not isinstance(prompt_set, dict):
        return None
    source_refs = [
        str(ref).strip()
        for ref in (prompt_set.get("source_refs") or [])
        if str(ref).strip()
    ]
    template_refs = [ref for ref in source_refs if Path(ref).name.endswith(".context.yaml")]
    return {
        "prompt_set_id": str(prompt_set.get("prompt_set_id", "")).strip(),
        "version": str(prompt_set.get("version", "")).strip(),
        "description": str(prompt_set.get("description", "")).strip(),
        "source_refs": source_refs,
        "template_refs": template_refs,
        "registry_path": str(PROMPT_REGISTRY_PATH),
    }


def ensure_runtime_prompt_context(role: str, state_root: Path) -> dict[str, Any]:
    prompt_set = resolve_role_prompt_set(role)
    if not prompt_set:
        return {
            "status": "unregistered",
            "prompt_set_id": "",
            "version": "",
            "registry_path": str(PROMPT_REGISTRY_PATH),
            "runtime_prompts_dir": str(state_root / "prompts"),
            "refreshed": False,
            "required_runtime_refs": [],
        }

    required_runtime_refs = [state_root / "prompts" / Path(ref).name for ref in prompt_set["template_refs"]]
    needs_refresh = False
    for template_ref in prompt_set["template_refs"]:
        template_path = ROOT / template_ref
        runtime_path = state_root / "prompts" / template_path.name
        if not runtime_path.exists():
            needs_refresh = True
            break
        if template_path.exists() and template_path.stat().st_mtime > runtime_path.stat().st_mtime:
            needs_refresh = True
            break

    if needs_refresh:
        cmd = [str(PROMPT_LIBRARY_BOOTSTRAP), "--json"]
        rc, payload, stderr = run_json_command(cmd)
        if rc != 0:
            raise RuntimeError(f"prompt library bootstrap failed: {stderr or 'unknown error'}")
        return {
            "status": "refreshed",
            "prompt_set_id": prompt_set["prompt_set_id"],
            "version": prompt_set["version"],
            "registry_path": prompt_set["registry_path"],
            "runtime_prompts_dir": str(state_root / "prompts"),
            "refreshed": True,
            "bootstrap": payload,
            "required_runtime_refs": [str(path) for path in required_runtime_refs],
        }

    return {
        "status": "current",
        "prompt_set_id": prompt_set["prompt_set_id"],
        "version": prompt_set["version"],
        "registry_path": prompt_set["registry_path"],
        "runtime_prompts_dir": str(state_root / "prompts"),
        "refreshed": False,
        "required_runtime_refs": [str(path) for path in required_runtime_refs],
    }


def run_json_command(cmd: list[str], *, input_text: str | None = None) -> tuple[int, dict[str, Any], str]:
    proc = subprocess.run(
        cmd,
        text=True,
        input=input_text,
        capture_output=True,
        check=False,
        env=os.environ.copy(),
    )
    stdout = proc.stdout.strip()
    payload: dict[str, Any] = {}
    if stdout:
        payload = json.loads(stdout)
    return proc.returncode, payload, proc.stderr.strip()


def run_text_command(cmd: list[str]) -> tuple[int, str, str]:
    proc = subprocess.run(
        cmd,
        text=True,
        capture_output=True,
        check=False,
        env=os.environ.copy(),
    )
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def default_sanitized_output(state_root: Path, source_type: str, loop_id: str, input_path: str | None) -> Path:
    ingress_root = state_root / "ingress-sanitized"
    ingress_root.mkdir(parents=True, exist_ok=True)
    source_stem = Path(input_path).stem if input_path else "stdin"
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    loop_part = loop_id or "ADHOC"
    return ingress_root / f"{loop_part}__{source_type}__{source_stem}__{stamp}.yaml"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Canonical V3 terminal attach: bootstrap session, resolve loop truth, sanitize imported ingress when present, compile entry packet, and emit friction snapshot"
    )
    parser.add_argument("--loop-id")
    parser.add_argument("--latest-loop", action="store_true", help="Resolve the current loop via broker read API")
    parser.add_argument("--allow-no-loop", action="store_true", help="Compile an adhoc packet if no loop can be resolved")
    parser.add_argument("--fast-lane", action="store_true", help="Bounded work mode: skip loop registration, lane=fix, emit fast-lane receipt. For patches touching <=5 files in one domain with no hotspot mutations.")
    parser.add_argument("--role", default=os.environ.get("SPINE_RUNTIME_ROLE") or os.environ.get("SPINE_ATTACH_ROLE") or "researcher")
    parser.add_argument("--lane")
    parser.add_argument("--execution-mode", choices=["code", "operational"])
    parser.add_argument("--transport", choices=["git", "mailroom"])
    parser.add_argument("--objective")
    parser.add_argument("--done-check")
    parser.add_argument("--first-command")
    parser.add_argument("--terminal-name", default=os.environ.get("OPS_TERMINAL_ROLE") or os.environ.get("SPINE_TERMINAL_NAME", ""))
    parser.add_argument("--runtime-role", default=os.environ.get("SPINE_RUNTIME_ROLE", "unknown"))
    parser.add_argument("--worktree", default=os.getcwd())
    parser.add_argument("--repo-root", default=str(ROOT))
    parser.add_argument("--input", help="Optional imported chat/note/archive file to sanitize during attach")
    parser.add_argument("--source-type", choices=["chat", "notes", "archive", "unknown"], default="unknown")
    parser.add_argument("--sanitized-output", help="Optional path for sanitized ingress artifact")
    parser.add_argument("--skip-session-bootstrap", action="store_true", help="Internal-only launcher path: assume session.start bootstrap already ran")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--posture", choices=["discover", "converge"], default=os.environ.get("SPINE_EXECUTION_POSTURE", "discover"), help="Execution posture: discover (default, allows registry growth) or converge (closure-only, blocks new gaps/loops)")
    parser.add_argument("--emit-exports", action="store_true")
    return parser


def assert_attach_repo_identity(args: argparse.Namespace) -> dict[str, str]:
    cwd_root = git_toplevel(Path.cwd())
    requested_repo_root = canonical_path(args.repo_root)
    expected_root = cwd_root or requested_repo_root

    explicit_repo_arg = "--repo-root" in sys.argv[1:]
    if explicit_repo_arg and requested_repo_root != expected_root:
        raise RuntimeError(
            "attach repo-root mismatch: "
            f"--repo-root resolves to {requested_repo_root} but current checkout is {expected_root}"
        )

    # Auto-clean leaked ambient env vars that don't match current checkout
    cleaned_vars: list[str] = []
    for env_name in ("SPINE_REPO", "SPINE_ROOT", "SPINE_CODE", "SPINE_TARGET_REPO", "SPINE_WORKTREE"):
        raw_value = os.environ.get(env_name, "").strip()
        if not raw_value:
            continue
        resolved = canonical_path(raw_value)
        if env_name == "SPINE_WORKTREE":
            expected_path = canonical_path(args.worktree or str(Path.cwd()))
        else:
            expected_path = expected_root
        if resolved != expected_path:
            os.environ.pop(env_name, None)
            cleaned_vars.append(f"{env_name}={resolved}")

    if cleaned_vars:
        cleaned_text = ", ".join(cleaned_vars)
        print(
            f"attach: cleaned leaked ambient env ({cleaned_text}) "
            f"→ using current checkout {expected_root}",
            file=sys.stderr,
        )

    args.repo_root = str(expected_root)
    if args.worktree:
        args.worktree = str(canonical_path(args.worktree))
    return {
        "checkout_root": str(expected_root),
        "cwd_root": str(cwd_root) if cwd_root else "",
        "requested_repo_root": str(requested_repo_root),
    }


def startup_lane_for_role(role: str) -> str:
    normalized = str(role or "").strip().lower()
    if normalized == "orchestrator":
        return "coordinator"
    return "scan"


def parse_env_file(path: Path) -> dict[str, str]:
    exports: dict[str, str] = {}
    if not path.exists():
        return exports
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line.startswith("export ") or "=" not in line:
            continue
        key, value = line[len("export ") :].split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        exports[key] = value
    return exports


def shell_export_line(key: str, value: str) -> str:
    return f"export {key}={shlex.quote(str(value))}"


def merge_env_exports(path: str, exports: dict[str, str]) -> None:
    if not path:
        return
    env_path = Path(path)
    if not env_path.exists():
        return
    existing_lines = env_path.read_text(encoding="utf-8").splitlines()
    managed_keys = {key for key in exports if key}
    filtered_lines: list[str] = []
    for raw in existing_lines:
        stripped = raw.strip()
        if stripped.startswith("export ") and "=" in stripped:
            key = stripped[len("export ") :].split("=", 1)[0].strip()
            if key in managed_keys:
                continue
        filtered_lines.append(raw)
    for key, value in exports.items():
        if key:
            filtered_lines.append(shell_export_line(key, value))
    env_path.write_text("\n".join(filtered_lines).rstrip() + "\n", encoding="utf-8")


def run_session_bootstrap(args: argparse.Namespace, session_start_script: Path) -> dict[str, Any]:
    if args.skip_session_bootstrap:
        return {
            "status": "skipped",
            "lane": startup_lane_for_role(args.role),
            "session_env_file": "",
            "exports": {},
        }

    lane = startup_lane_for_role(args.role)
    env = os.environ.copy()
    proc = subprocess.run(
        [
            str(session_start_script),
            lane,
            "--allow-dirty",
            "--dirty-reason",
            "session.v3.attach canonical reattach in existing terminal",
            "--allow-main-divergence",
            "--main-divergence-reason",
            "session.v3.attach canonical reattach in existing terminal",
            "--skip-root-boring-reconcile",
            "--skip-managed-worktree-sync",
        ],
        text=True,
        capture_output=True,
        check=False,
        env=env,
    )
    output = proc.stdout or ""
    env_file = ""
    for raw in output.splitlines():
        match = re.match(r"^\s*source\s+(.*env\.sh)\s*$", raw)
        if match:
            env_file = match.group(1).strip()
    if proc.returncode != 0:
        raise RuntimeError(f"session bootstrap failed: {(proc.stderr or output).strip() or 'unknown error'}")
    if not env_file:
        raise RuntimeError("session bootstrap succeeded without emitting session env file")
    exports = parse_env_file(Path(env_file))
    return {
        "status": "done",
        "lane": lane,
        "session_env_file": env_file,
        "exports": exports,
    }


def resolve_terminal_contract_context(terminal_id: str) -> dict[str, str]:
    contract = load_yaml(ROOT / "ops/bindings/terminal.role.contract.yaml", {})
    for entry in contract.get("roles", []) or []:
        if str(entry.get("id", "")).strip() != terminal_id:
            continue
        write_scope = [str(item).strip() for item in (entry.get("write_scope") or []) if str(item).strip()]
        return {
            "terminal_type": str(entry.get("type", "")).strip(),
            "scope": ",".join(write_scope),
        }
    return {
        "terminal_type": "",
        "scope": "",
    }


def resolve_attach_heartbeat_context(args: argparse.Namespace, startup_exports: dict[str, str]) -> dict[str, str]:
    terminal_id = str(
        startup_exports.get("OPS_TERMINAL_ROLE")
        or startup_exports.get("SPINE_TERMINAL_NAME")
        or args.terminal_name
        or ""
    ).strip()
    if not terminal_id:
        raise RuntimeError("attach heartbeat failed: terminal identity unresolved after attach/bootstrap")

    runtime_role = str(startup_exports.get("SPINE_RUNTIME_ROLE") or args.runtime_role or "unknown").strip() or "unknown"
    terminal_type = str(startup_exports.get("SPINE_TERMINAL_TYPE") or "").strip()
    scope = str(startup_exports.get("SPINE_TERMINAL_SCOPE") or os.environ.get("SPINE_TERMINAL_SCOPE") or "").strip()
    scope_source = ""
    terminal_type_source = ""

    contract_context = resolve_terminal_contract_context(terminal_id)
    if terminal_type:
        terminal_type_source = "session_start_export"
    elif contract_context.get("terminal_type"):
        terminal_type = contract_context["terminal_type"]
        terminal_type_source = "terminal.role.contract"
    else:
        terminal_type = "unknown"
        terminal_type_source = "fallback_unknown"

    if scope:
        scope_source = "session_start_export"
    elif contract_context.get("scope"):
        scope = contract_context["scope"]
        scope_source = "terminal.role.contract"
    else:
        scope = "unspecified"
        scope_source = "fallback_unspecified"

    runtime_role_source = "session_start_export" if startup_exports.get("SPINE_RUNTIME_ROLE") else "attach_context"
    terminal_id_source = "session_start_export" if startup_exports.get("OPS_TERMINAL_ROLE") else "attach_context"
    return {
        "terminal_id": terminal_id,
        "terminal_type": terminal_type,
        "runtime_role": runtime_role,
        "scope": scope,
        "scope_source": scope_source,
        "terminal_type_source": terminal_type_source,
        "runtime_role_source": runtime_role_source,
        "terminal_id_source": terminal_id_source,
    }


def write_heartbeat_refresh_stamp(startup_exports: dict[str, str], heartbeat_at: str) -> str:
    session_dir = str(startup_exports.get("SPINE_SESSION_DIR", "")).strip()
    if not session_dir:
        return ""
    try:
        heartbeat_dt = dt.datetime.fromisoformat(heartbeat_at.replace("Z", "+00:00"))
    except ValueError:
        heartbeat_dt = dt.datetime.now(dt.timezone.utc)
    stamp_path = Path(session_dir) / "terminal-heartbeat-refresh.epoch"
    stamp_path.parent.mkdir(parents=True, exist_ok=True)
    stamp_path.write_text(str(int(heartbeat_dt.timestamp())), encoding="utf-8")
    return str(stamp_path)


def post_attach_heartbeat(args: argparse.Namespace, startup_exports: dict[str, str], loop_id: str) -> dict[str, Any]:
    heartbeat_script = ROOT / "ops/plugins/core/session/bin/terminal-heartbeat-post"
    if not heartbeat_script.exists():
        raise RuntimeError("attach heartbeat failed: terminal-heartbeat-post is unavailable")

    context = resolve_attach_heartbeat_context(args, startup_exports)
    cmd = [
        str(heartbeat_script),
        "--terminal-id",
        context["terminal_id"],
        "--role",
        context["terminal_type"],
        "--runtime-role",
        context["runtime_role"],
        "--owner-pid",
        str(os.getppid()),
        "--scope",
        context["scope"],
        "--repo-root",
        args.repo_root,
        "--status",
        "active",
        "--json",
    ]
    if loop_id:
        cmd.extend(["--loop-id", loop_id])

    rc, payload, stderr = run_json_command(cmd)
    if rc != 0:
        raise RuntimeError(f"attach heartbeat failed: {stderr or 'terminal-heartbeat-post returned non-zero'}")

    payload.update(
        {
            "status": "done",
            "scope_source": context["scope_source"],
            "terminal_type_source": context["terminal_type_source"],
            "runtime_role_source": context["runtime_role_source"],
            "terminal_id_source": context["terminal_id_source"],
        }
    )
    return payload


def run_stale_cleanup() -> dict[str, Any]:
    """Auto-cleanup stale worktrees/branches from closed loops."""
    cleanup_script = ROOT / "ops/plugins/core/session/bin/session-stale-cleanup"
    if not cleanup_script.exists():
        return {"status": "skipped", "message": "cleanup script not available"}

    rc, payload, stderr = run_json_command([str(cleanup_script), "--json"])
    if rc != 0:
        return {"status": "failed", "message": stderr or "stale cleanup failed"}

    return payload


def collect_friction_snapshot() -> dict[str, Any]:
    queue_script = ROOT / "ops/plugins/core/lifecycle/bin/friction-queue-status"
    lifecycle_script = ROOT / "ops/plugins/core/lifecycle/bin/worktree-lifecycle-reconcile"
    snapshot: dict[str, Any] = {}

    if queue_script.exists():
        rc, payload, stderr = run_json_command([str(queue_script), "--json"])
        snapshot["friction_queue"] = payload if rc == 0 else {"status": "failed", "message": stderr or "friction queue read failed"}

    if lifecycle_script.exists():
        rc, payload, stderr = run_json_command([str(lifecycle_script), "--json", "--brief"])
        snapshot["lifecycle"] = payload if rc == 0 else {"status": "failed", "message": stderr or "worktree lifecycle reconcile failed"}

    rc, stdout, stderr = run_text_command([str(ROOT / "bin/ops"), "status", "--brief"])
    snapshot["ops_status"] = stdout if rc == 0 else (stderr or stdout or "ops status unavailable")
    return snapshot


def collect_dirty_context(repo_path: str) -> dict[str, Any]:
    checker_script = ROOT / "ops/plugins/core/session/bin/session-context-aware-dirty-check"
    if not checker_script.exists():
        return {
            "status": "unavailable",
            "safe_to_proceed": False,
            "reason": "checker_missing",
            "context": {},
        }

    rc, payload, stderr = run_json_command(
        [str(checker_script), "--json", "--repo-path", repo_path]
    )
    if rc not in (0, 1):
        return {
            "status": "failed",
            "safe_to_proceed": False,
            "reason": "checker_failed",
            "message": stderr or "dirty context check failed",
            "context": {},
        }

    payload["status"] = "pass" if payload.get("safe_to_proceed") else "blocked"
    return payload


def collect_attach_preflight() -> dict[str, Any]:
    lifecycle_script = ROOT / "ops/plugins/core/lifecycle/bin/worktree-lifecycle-reconcile"
    d150_script = ROOT / "surfaces/verify/d150-code-root-hygiene-lock.sh"
    policy = (
        "Use worktrees when isolation helps and use exact-slice landing on main when it does not. "
        "Runtime state and evidence remain external to this checkout."
    )

    lifecycle: dict[str, Any] = {}
    if lifecycle_script.exists():
        rc, payload, stderr = run_json_command([str(lifecycle_script), "--json"])
        if rc not in (0, 1):
            raise RuntimeError(f"attach preflight lifecycle failed: {stderr or 'unknown error'}")
        lifecycle = payload

    d150 = {
        "status": "skipped",
        "blocking_at_commit": False,
        "violations": [],
        "message": "D150 preflight unavailable",
    }
    if d150_script.exists():
        rc, stdout, stderr = run_text_command([str(d150_script)])
        if rc == 0:
            d150 = {
                "status": "pass",
                "blocking_at_commit": False,
                "violations": [],
                "message": stdout or "D150 clean",
            }
        else:
            violations = []
            for line in (stderr or stdout).splitlines():
                text = line.strip()
                if text.startswith("- "):
                    violations.append(text[2:])
            d150 = {
                "status": "warn",
                "blocking_at_commit": True,
                "violations": violations,
                "message": stderr or stdout or "D150 would block commit until loose ~/code files are removed",
            }

    summary = lifecycle.get("summary", {})
    lane_issues = lifecycle.get("lane_issues", [])
    global_issues = lifecycle.get("global_issues", [])
    lane_warnings = lifecycle.get("lane_warnings", [])
    global_warnings = lifecycle.get("global_warnings", [])
    blocking_codes = [str(item.get("code", "")) for item in lane_issues if item.get("code")]
    warning_codes = [str(item.get("code", "")) for item in lane_warnings + global_warnings if item.get("code")]
    global_issue_codes = [str(item.get("code", "")) for item in global_issues if item.get("code")]
    dirty_context: dict[str, Any] = {}

    if "root_checkout_dirty" in blocking_codes:
        repo_path = str(summary.get("repo") or ROOT)
        dirty_context = collect_dirty_context(repo_path)
        if (
            dirty_context.get("status") == "pass"
            and dirty_context.get("safe_to_proceed") is True
            and dirty_context.get("reason") == "governed_operation_hotspots"
        ):
            blocking_codes = [code for code in blocking_codes if code != "root_checkout_dirty"]
            if "root_checkout_dirty_governed_hotspots" not in warning_codes:
                warning_codes.append("root_checkout_dirty_governed_hotspots")
            dirty_context["root_checkout_dirty_downgraded"] = True

    status = "pass"
    if blocking_codes:
        status = "blocked"
    elif warning_codes or global_issue_codes or d150["status"] == "warn":
        status = "warn"

    return {
        "status": status,
        "policy": policy,
        "current_lane_type": summary.get("current_lane_type", ""),
        "root_lane_status": summary.get("root_lane_status", ""),
        "controller_root_main_staged_only_window_allowed": bool(
            summary.get("controller_root_main_staged_only_window_allowed")
        ),
        "blocking_codes": blocking_codes,
        "warning_codes": warning_codes,
        "global_issue_codes": global_issue_codes,
        "dirty_context": dirty_context,
        "lifecycle": lifecycle,
        "shared_lane_contention": {
            "blocking_count": summary.get("blocking_terminal_contention_count", 0),
            "non_blocking_count": summary.get("non_blocking_terminal_coexistence_count", 0),
            "blocking": lifecycle.get("terminal_runtime", {}).get("blocking_contentions", []),
            "non_blocking": lifecycle.get("terminal_runtime", {}).get("non_blocking_coexistence", []),
        },
        "d150": d150,
    }


def collect_capability_map() -> list[str]:
    """Extract compact capability name list for agent tooling awareness."""
    rc, stdout, stderr = run_text_command([str(ROOT / "bin/ops"), "cap", "list"])
    if rc != 0:
        return []

    capabilities = []
    for line in stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("===") or line.startswith("---"):
            continue
        # Extract capability name (first token before whitespace/bracket)
        parts = line.split()
        if parts:
            cap_name = parts[0].strip()
            # Filter out noise: must contain a dot (namespace separator) or be all caps
            if cap_name and not cap_name.startswith("[") and ("." in cap_name or cap_name.isupper()):
                capabilities.append(cap_name)

    return capabilities


def resolve_loop_id(args: argparse.Namespace, broker_script: Path) -> tuple[str, str, dict[str, Any] | None]:
    if args.loop_id:
        return args.loop_id, "explicit", None

    want_latest = args.latest_loop or not args.allow_no_loop
    if not want_latest:
        return "", "adhoc", None

    rc, payload, stderr = run_json_command([str(broker_script), "latest-loop", "--json"])
    if rc != 0:
        raise RuntimeError(f"latest-loop broker read failed: {stderr or 'unknown error'}")

    loop_id = str(payload.get("data", {}).get("loop", {}).get("loop_id", "")).strip()
    if loop_id:
        return loop_id, "latest-loop", payload
    if args.allow_no_loop:
        return "", "adhoc", payload
    raise RuntimeError("no active loop resolved via broker read path")


def maybe_sanitize(
    args: argparse.Namespace,
    state_root: Path,
    sanitize_script: Path,
    loop_id: str,
) -> tuple[dict[str, Any] | None, str]:
    stdin_text = ""
    if not args.input and not sys.stdin.isatty():
        stdin_text = sys.stdin.read()

    if not args.input and not stdin_text:
        return None, ""

    input_path = str(Path(args.input).expanduser().resolve()) if args.input else ""
    out_path = (
        Path(args.sanitized_output).expanduser().resolve()
        if args.sanitized_output
        else default_sanitized_output(state_root, args.source_type, loop_id, input_path or None)
    )
    cmd = [
        str(sanitize_script),
        "--source-type",
        args.source_type,
        "--output",
        str(out_path),
        "--json",
    ]
    if input_path:
        cmd.extend(["--input", input_path])
    rc, payload, stderr = run_json_command(cmd, input_text=stdin_text or None)
    if rc not in (0, 1):
        raise RuntimeError(f"sanitize failed: {stderr or 'unknown error'}")
    return payload, str(out_path)


def compile_entry_packet(args: argparse.Namespace, entry_script: Path, loop_id: str) -> dict[str, Any]:
    cmd = [
        str(entry_script),
        "--role",
        args.role,
        "--worktree",
        args.worktree,
        "--repo-root",
        args.repo_root,
        "--terminal-name",
        args.terminal_name,
        "--runtime-role",
        args.runtime_role,
        "--json",
    ]
    if loop_id:
        cmd.extend(["--loop-id", loop_id])
    if args.lane:
        cmd.extend(["--lane", args.lane])
    if args.execution_mode:
        cmd.extend(["--execution-mode", args.execution_mode])
    if args.transport:
        cmd.extend(["--transport", args.transport])
    if args.objective:
        cmd.extend(["--objective", args.objective])
    if args.done_check:
        cmd.extend(["--done-check", args.done_check])
    if args.first_command:
        cmd.extend(["--first-command", args.first_command])

    rc, payload, stderr = run_json_command(cmd)
    if rc != 0:
        raise RuntimeError(f"entry packet compile failed: {stderr or 'unknown error'}")
    return payload


# ── Boot-Time Source Selection (GAP-OP-1704) ─────────────────────────────────


def resolve_loop_source(state_root: Path, lane: str) -> dict[str, Any]:
    """Resolve loop truth source with ordered fallback: MCP -> bridge -> files -> degraded.

    Returns dict with keys: source, degraded, open_loops, authority_path, diagnostics
    """
    diagnostics: list[str] = []

    # Step 1: Try MCP — check if MCP config exists (MCP tools are agent-side, not script-side)
    mcp_config = Path.home() / ".claude" / "mcp.json"
    # Also check project-level MCP
    project_mcp = ROOT / ".mcp.json"
    mcp_available = mcp_config.exists() or project_mcp.exists()
    if mcp_available:
        # MCP tools are available to the agent at runtime, not callable from this script.
        # We verify config exists and mark source as available for the boot snapshot.
        # The agent will use get_latest_loop MCP tool for live queries during the session.
        diagnostics.append("mcp_config_found")
    else:
        diagnostics.append("mcp_config_absent")

    # Step 2: Try HTTP bridge
    bridge_reachable = False
    try:
        import urllib.request

        req = urllib.request.Request("http://localhost:8799/health", method="GET")
        with urllib.request.urlopen(req, timeout=2) as resp:
            if resp.status == 200:
                bridge_reachable = True
                diagnostics.append("bridge_reachable")
    except Exception:
        diagnostics.append("bridge_unreachable")

    # Step 3: Try direct file read from loop-scopes
    scopes_dir = state_root / "loop-scopes"
    scope_files = sorted(scopes_dir.glob("*.scope.md")) if scopes_dir.is_dir() else []
    open_loops: list[dict[str, Any]] = []

    if scope_files:
        for sf in scope_files:
            try:
                content = sf.read_text(encoding="utf-8")
                parts = content.split("---", 2)
                if len(parts) >= 3:
                    fm = yaml.safe_load(parts[1].strip())
                    if isinstance(fm, dict):
                        status = str(fm.get("status", "")).strip().lower()
                        if status in ("active", "open", "draft"):
                            open_loops.append({
                                "loop_id": fm.get("loop_id", ""),
                                "status": status,
                                "owner": fm.get("owner", ""),
                                "scope": fm.get("scope", ""),
                                "priority": fm.get("priority", ""),
                                "objective": fm.get("objective", ""),
                            })
            except Exception:
                continue
        diagnostics.append(f"scope_files_found={len(scope_files)}")
    else:
        diagnostics.append("scope_files_absent")

    # Determine source (highest available)
    if mcp_available:
        source = "mcp"
    elif bridge_reachable:
        source = "bridge"
    elif scope_files:
        source = "files"
    else:
        source = "degraded"

    degraded = source == "degraded"

    # Loud failure for non-degraded lanes
    if degraded and lane in ("claude_code", "codex"):
        diagnostics.append("loud_failure_non_degraded_lane")

    return {
        "source": source,
        "degraded": degraded,
        "open_loops": open_loops,
        "loop_count": len(open_loops),
        "authority_path": str(scopes_dir),
        "diagnostics": diagnostics,
    }


def write_boot_snapshot(
    session_id: str, state_root: Path, source_info: dict[str, Any]
) -> str:
    """Write boot snapshot to $SPINE_STATE/sessions/$SESSION_ID/boot-snapshot.json"""
    if not session_id:
        return ""
    snapshot_dir = state_root / "sessions" / session_id
    snapshot_dir.mkdir(parents=True, exist_ok=True)
    snapshot_path = snapshot_dir / "boot-snapshot.json"
    snapshot = {
        "schema_version": "1.0",
        "generated_at_utc": utc_now(),
        "session_id": session_id,
        "source": source_info.get("source", "unknown"),
        "degraded": source_info.get("degraded", True),
        "open_loops": source_info.get("open_loops", []),
        "loop_count": source_info.get("loop_count", 0),
        "authority_path": source_info.get("authority_path", ""),
        "diagnostics": source_info.get("diagnostics", []),
    }
    snapshot_path.write_text(json.dumps(snapshot, indent=2) + "\n", encoding="utf-8")
    return str(snapshot_path)


def main() -> int:
    args = build_parser().parse_args()

    # ── Fast-lane mode ──────────────────────────────────────────────
    # Collapses ceremony to attach → do → receipt. No loop/gap/disposition.
    if args.fast_lane:
        args.allow_no_loop = True
        if not args.lane:
            args.lane = "fix"

    state_root = resolve_state_root()
    broker_script = ROOT / "ops/plugins/core/evidence/bin/spine-control"
    sanitize_script = ROOT / "ops/plugins/core/session/bin/session-ingress-sanitize"
    entry_script = ROOT / "ops/plugins/core/session/bin/session-entry-packet"
    session_start_script = Path(
        os.environ.get("SPINE_SESSION_START_BIN")
        or (ROOT / "ops/plugins/core/session/bin/session-start")
    )

    try:
        repo_identity = assert_attach_repo_identity(args)
        # V3 convergence: Auto-cleanup stale worktrees before bootstrap
        stale_cleanup = run_stale_cleanup()
        startup = run_session_bootstrap(args, session_start_script)
        startup_exports = startup.get("exports", {})
        if (not args.terminal_name) and startup_exports.get("OPS_TERMINAL_ROLE"):
            args.terminal_name = str(startup_exports.get("OPS_TERMINAL_ROLE", ""))
        if (not args.runtime_role or args.runtime_role == "unknown") and startup_exports.get("SPINE_RUNTIME_ROLE"):
            args.runtime_role = str(startup_exports.get("SPINE_RUNTIME_ROLE", ""))
        preflight = collect_attach_preflight()

        # Boot-time source selection (GAP-OP-1704)
        lane_for_source = args.lane or preflight.get("current_lane_type", "") or "claude_code"
        loop_source = resolve_loop_source(state_root, lane_for_source)
        loop_id, loop_resolution, latest_payload = resolve_loop_id(args, broker_script)
        sanitize_payload, sanitized_output_path = maybe_sanitize(args, state_root, sanitize_script, loop_id)
        prompt_library = ensure_runtime_prompt_context(str(args.role).strip().lower(), state_root)
        friction_snapshot = collect_friction_snapshot()
        capability_map = collect_capability_map()
        if preflight.get("status") == "blocked":
            payload = {
                "capability": "session.v3.attach",
                "schema_version": "1.0",
                "status": "blocked",
                "generated_at": utc_now(),
                "data": {
                    "loop": {
                        "loop_id": loop_id,
                        "resolution": loop_resolution,
                        "latest_loop": latest_payload,
                    },
                    "startup": startup,
                    "repo_identity": repo_identity,
                    "stale_cleanup": stale_cleanup,
                    "preflight": preflight,
                    "prompt_library": prompt_library,
                    "friction_snapshot": friction_snapshot,
                    "capability_map": capability_map,
                    "next_step": "Resolve attach preflight blockers before starting work.",
                },
            }
            if args.json:
                print(json.dumps(payload, indent=2))
            else:
                print("session.v3.attach")
                print("status: blocked")
                print(f"policy: {preflight.get('policy', '')}")
                print(f"lane_type: {preflight.get('current_lane_type', 'unknown')}")
                print(f"root_lane_status: {preflight.get('root_lane_status', 'unknown')}")
                if preflight.get("blocking_codes"):
                    print("blocking_codes:")
                    for code in preflight["blocking_codes"]:
                        print(f"  - {code}")
            return 1
        if sanitize_payload and sanitize_payload.get("status") == "blocked":
            payload = {
                "capability": "session.v3.attach",
                "schema_version": "1.0",
                "status": "blocked",
                "generated_at": utc_now(),
                "data": {
                    "loop": {
                        "loop_id": loop_id,
                        "resolution": loop_resolution,
                        "latest_loop": latest_payload,
                    },
                    "startup": startup,
                    "repo_identity": repo_identity,
                    "preflight": preflight,
                    "sanitize": sanitize_payload,
                    "prompt_library": prompt_library,
                    "friction_snapshot": friction_snapshot,
                    "capability_map": capability_map,
                    "sanitized_output_path": sanitized_output_path,
                    "next_step": "Resolve sanitizer findings before attach can produce an executable packet.",
                },
            }
            if args.json:
                print(json.dumps(payload, indent=2))
            else:
                print("session.v3.attach")
                print("status: blocked")
                print(f"policy: {preflight.get('policy', '')}")
                print(f"loop_id: {loop_id or 'none'}")
                print(f"resolution: {loop_resolution}")
                print(f"lane_type: {preflight.get('current_lane_type', 'unknown')}")
                print(f"root_lane_status: {preflight.get('root_lane_status', 'unknown')}")
                print(f"capability_count: {len(capability_map)}")
                print(f"sanitized_output_path: {sanitized_output_path or 'none'}")
            return 1

        entry_payload = compile_entry_packet(args, entry_script, loop_id)
        entry_data = entry_payload.get("data", {})
        packet = entry_data.get("packet", {})
        heartbeat = post_attach_heartbeat(args, startup_exports, loop_id)
        heartbeat_stamp_file = write_heartbeat_refresh_stamp(startup_exports, str(heartbeat.get("heartbeat_at", "")))
        exports = {
            "SPINE_LOOP_ID": loop_id,
            "SPINE_ENTRY_PACKET_PATH": entry_data.get("packet_path", ""),
            "SPINE_ENTRY_PACKET_HASH": entry_data.get("packet_hash", ""),
            "SPINE_EXECUTION_MODE": packet.get("execution_mode", ""),
            "SPINE_EXECUTION_POSTURE": args.posture or "discover",
            "SPINE_V3_ATTACH_RESOLUTION": loop_resolution,
            "SPINE_V3_SANITIZED_OUTPUT_PATH": sanitized_output_path,
            "SPINE_HEARTBEAT_FILE": str(heartbeat.get("heartbeat_file", "")),
            "SPINE_LOOP_HEARTBEAT_FILE": str(heartbeat.get("loop_heartbeat_file", "")),
        }
        # Boot snapshot export (GAP-OP-1704)
        session_id = startup_exports.get("SPINE_SESSION_ID", "")
        boot_snapshot_path = write_boot_snapshot(session_id, state_root, loop_source)
        exports["SPINE_LOOP_TRUTH_SOURCE"] = loop_source.get("source", "unknown")
        exports["SPINE_BOOT_SNAPSHOT_PATH"] = boot_snapshot_path

        prompt_context = packet.get("prompt_context") if isinstance(packet.get("prompt_context"), dict) else {}
        if prompt_context:
            exports.update(
                {
                    "SPINE_PROMPT_SET_ID": str(prompt_context.get("prompt_set_id", "")),
                    "SPINE_PROMPT_SET_VERSION": str(prompt_context.get("version", "")),
                    "SPINE_PROMPT_REGISTRY_PATH": str(prompt_context.get("registry_path", "")),
                    "SPINE_PROMPT_SOURCE_REFS_JSON": json.dumps(prompt_context.get("source_refs", [])),
                    "SPINE_PROMPT_RUNTIME_REFS_JSON": json.dumps(prompt_context.get("runtime_prompt_refs", [])),
                }
            )
        if args.fast_lane:
            exports["SPINE_FAST_LANE"] = "1"
        exports.update({k: v for k, v in startup_exports.items() if k})
        if startup.get("session_env_file"):
            merge_env_exports(
                str(startup.get("session_env_file", "")),
                {
                    "SPINE_LOOP_ID": loop_id,
                    "SPINE_ENTRY_PACKET_PATH": entry_data.get("packet_path", ""),
                    "SPINE_ENTRY_PACKET_HASH": entry_data.get("packet_hash", ""),
                    "SPINE_EXECUTION_MODE": packet.get("execution_mode", ""),
                    "SPINE_EXECUTION_POSTURE": args.posture or "discover",
                    "SPINE_V3_ATTACH_RESOLUTION": loop_resolution,
                    "SPINE_V3_SANITIZED_OUTPUT_PATH": sanitized_output_path,
                    "SPINE_HEARTBEAT_FILE": str(heartbeat.get("heartbeat_file", "")),
                    "SPINE_LOOP_HEARTBEAT_FILE": str(heartbeat.get("loop_heartbeat_file", "")),
                    "SPINE_LOOP_TRUTH_SOURCE": loop_source.get("source", "unknown"),
                    "SPINE_BOOT_SNAPSHOT_PATH": boot_snapshot_path,
                },
            )
        payload = {
            "capability": "session.v3.attach",
            "schema_version": "1.0",
            "status": "done",
            "generated_at": utc_now(),
            "data": {
                    "loop": {
                        "loop_id": loop_id,
                        "resolution": loop_resolution,
                        "latest_loop": latest_payload,
                    },
                    "startup": startup,
                    "repo_identity": repo_identity,
                    "stale_cleanup": stale_cleanup,
                    "preflight": preflight,
                    "sanitize": sanitize_payload,
                    "prompt_library": prompt_library,
                    "friction_snapshot": friction_snapshot,
                    "capability_map": capability_map,
                    "sanitized_output_path": sanitized_output_path,
                    "entry_packet": entry_data,
                    "heartbeat": heartbeat,
                    "heartbeat_refresh_stamp_file": heartbeat_stamp_file,
                    "loop_source": loop_source,
                    "boot_snapshot_path": boot_snapshot_path,
                    "exports": exports,
                    "next_step": packet.get("first_command", ""),
                },
        }
    except Exception as exc:
        payload = {
            "capability": "session.v3.attach",
            "schema_version": "1.0",
            "status": "failed",
            "generated_at": utc_now(),
            "data": {
                "message": str(exc),
            },
        }
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print("session.v3.attach")
            print("status: failed")
            print(f"message: {exc}")
        return 1

    if args.emit_exports:
        for key, value in exports.items():
            print(f"export {key}={value!r}")
        return 0

    if args.json:
        print(json.dumps(payload, indent=2))
        return 0

    print("session.v3.attach")
    if args.fast_lane:
        print("mode: fast-lane")
    print(f"session_id: {startup_exports.get('SPINE_SESSION_ID', 'none')}")
    print(f"startup_lane: {startup.get('lane', 'none')}")
    print(f"policy: {preflight.get('policy', '')}")
    print(f"preflight_status: {preflight.get('status', 'unknown')}")
    print(f"lane_type: {preflight.get('current_lane_type', 'unknown')}")
    print(f"root_lane_status: {preflight.get('root_lane_status', 'unknown')}")
    stale_cleaned = stale_cleanup.get('cleaned', 0) if isinstance(stale_cleanup, dict) else 0
    if stale_cleaned > 0:
        print(f"stale_cleanup: {stale_cleaned} worktree(s) removed")
    print(f"loop_id: {loop_id or 'none'}")
    print(f"resolution: {loop_resolution}")
    print(f"packet_path: {entry_data.get('packet_path', '')}")
    print(f"packet_hash: {entry_data.get('packet_hash', '')}")
    print(f"execution_mode: {packet.get('execution_mode', '')}")
    print(f"execution_posture: {args.posture or 'discover'}")
    print(f"loop_truth_source: {loop_source.get('source', 'unknown')}")
    if loop_source.get('degraded'):
        print("WARNING: loop truth source is degraded — no MCP, bridge, or scope files available")
    print(f"transport: {packet.get('transport', '')}")
    print(f"heartbeat_file: {payload['data']['heartbeat'].get('heartbeat_file', '')}")
    print(f"loop_heartbeat_file: {payload['data']['heartbeat'].get('loop_heartbeat_file', 'none') or 'none'}")
    print(f"heartbeat_scope_source: {payload['data']['heartbeat'].get('scope_source', 'unknown')}")
    queue_summary = friction_snapshot.get("friction_queue", {}).get("summary", {}) if isinstance(friction_snapshot.get("friction_queue"), dict) else {}
    lifecycle_summary = friction_snapshot.get("lifecycle", {}).get("summary", {}) if isinstance(friction_snapshot.get("lifecycle"), dict) else {}
    print(f"friction_queued: {queue_summary.get('queued', 0)}")
    print(f"lifecycle_issues: {lifecycle_summary.get('issue_count', lifecycle_summary.get('issues', 0))}")
    print(f"capability_count: {len(capability_map)}")
    print(f"sanitized_output_path: {sanitized_output_path or 'none'}")
    print("")
    print("=== DYNAMIC GOVERNANCE CONTEXT ===")
    print("")

    # Orchestration and execution mode visibility
    loop_execution_mode = "unknown"
    orchestration_state = "unknown"
    orchestration_lane_role = None
    orchestration_remedy = None

    if loop_id:
        loop_scope_path = state_root / "loop-scopes" / f"{loop_id}.scope.md"
        if loop_scope_path.exists():
            # Parse frontmatter only (between first two --- delimiters)
            try:
                content = loop_scope_path.read_text()
                parts = content.split("---", 2)
                if len(parts) >= 3:
                    frontmatter_text = parts[1].strip()
                    scope_yaml = yaml.safe_load(frontmatter_text)
                    if isinstance(scope_yaml, dict):
                        loop_execution_mode = scope_yaml.get("execution_mode", "single_worker")
            except Exception:
                pass  # Gracefully degrade if scope parsing fails

    # Check for orchestration lane evidence
    if loop_execution_mode == "orchestrator_subagents":
        # Check if terminal has valid orchestration context
        orch_context_env = os.environ.get("SPINE_ORCHESTRATION_CONTEXT")
        if orch_context_env:
            orchestration_state = "active"
            orchestration_lane_role = os.environ.get("SPINE_LANE_ROLE", "unknown")
        else:
            orchestration_state = "available_not_entered"
            # Use shared remedy generator (single source of truth)
            remedy_result = subprocess.run(
                ["bash", "-c", f"source {ROOT}/ops/lib/orchestration-remedy.sh && orchestration_remedy_worker_lane_entry '{loop_id}' 'claude'"],
                capture_output=True,
                text=True,
                check=False,
            )
            orchestration_remedy = remedy_result.stdout.strip() if remedy_result.returncode == 0 else f"./bin/ops terminal launch --loop {loop_id} --role lane-worker --lane D --tool claude"
    elif loop_execution_mode == "single_worker":
        orchestration_state = "not_applicable"

    print("## Active Loop And Orchestration State")
    print(f"loop_id: {loop_id or 'ADHOC (no loop active)'}")
    print(f"resolution: {loop_resolution}")
    print(f"execution_mode: {loop_execution_mode}")
    print(f"orchestration_state: {orchestration_state}")
    if orchestration_lane_role:
        print(f"orchestration_lane_role: {orchestration_lane_role}")
    if orchestration_remedy:
        print(f"orchestration_remedy: {orchestration_remedy}")
    if loop_id:
        loop_scope_path = state_root / "loop-scopes" / f"{loop_id}.scope.md"
        if loop_scope_path.exists():
            print(f"scope_file: {loop_scope_path}")
        if loop_execution_mode == "orchestrator_subagents" and orchestration_state == "available_not_entered":
            print("")
            print("⚠️  This loop uses orchestrator_subagents mode but terminal is not in orchestration lane.")
            print(f"   Open worker terminal: {orchestration_remedy}")
        else:
            print("action: read the loop scope before starting mutations")
    else:
        print("action: create a loop or bootstrap a governed execution lane for non-trivial mutation")
    print("")
    print("## Friction And Lifecycle State")
    print(f"friction_queued: {queue_summary.get('queued', 0)}")
    print(f"friction_filed: {queue_summary.get('filed', 0)}")
    print(f"friction_matched: {queue_summary.get('matched', 0)}")
    print(f"lifecycle_issues: {lifecycle_summary.get('issue_count', lifecycle_summary.get('issues', 0))}")
    print("")

    # Joined telemetry summary
    joined_state_path = state_root / "domain-state" / "spine" / "SPINE_ENGINE_JOINED_STATE.yaml"
    joined_state = load_yaml(joined_state_path, {})
    if isinstance(joined_state, dict) and "summary" in joined_state:
        summary = joined_state["summary"]
        gap_authority_status = str(summary.get("gap_authority_status", "ok")).strip().lower()
        open_gaps = summary.get("open_gaps", "?")
        if gap_authority_status != "ok":
            open_gaps = "unknown"
        print("## Joined Engine Telemetry")
        print(f"open_loops: {summary.get('open_loops', '?')}")
        print(f"open_gaps: {open_gaps}")
        print(f"blocked_worktrees: {summary.get('blocked_worktrees', '?')}")
        print(f"active_waves: {summary.get('active_waves', '?')}")
        print(f"recent_force_closes: {summary.get('recent_force_closes', 0)} (7d window)")
        print(f"recent_dod_overrides: {summary.get('recent_dod_overrides', 0)} (7d window)")
        coherence_needs_attention = summary.get('engine_coherence_needs_attention', False)
        print(f"engine_coherence_needs_attention: {coherence_needs_attention}")
        if coherence_needs_attention:
            print("⚠️  Engine coherence needs attention - run 'ops cap run lifecycle.health' for details")
        print("")

    print("## Governance Reminders")
    if preflight.get("current_lane_type") == "root_main_integration":
        print("- Root main is available for bounded work; use a worktree when isolation actually helps.")
    print("- Use governed capabilities first; raw shell or git fallback is last resort.")
    print("- Runtime state and evidence roots live under ~/code/.runtime/spine and ~/code/.evidence/spine outside this checkout; inspect them there and do not git add them from a worktree.")
    print("- Run verify after mutations.")
    print("- Canonical governance: docs/governance/SPINE.md")
    print("- Session protocol: docs/governance/SESSION_PROTOCOL.md")
    print("")
    ops_status_output = friction_snapshot.get("ops_status", "")
    if isinstance(ops_status_output, str) and ops_status_output.strip():
        print("## Live Ops Status")
        print("```")
        print(ops_status_output.rstrip())
        print("```")
        print("")
    print("## Entry Packet")
    print(f"packet_path: {entry_data.get('packet_path', '')}")
    print(f"packet_hash: {entry_data.get('packet_hash', '')}")
    print(f"execution_mode: {packet.get('execution_mode', '')}")
    print(f"execution_posture: {args.posture or 'discover'}")
    print(f"loop_truth_source: {loop_source.get('source', 'unknown')}")
    print(f"boot_snapshot_path: {boot_snapshot_path or 'none'}")
    print(f"transport: {packet.get('transport', '')}")
    print(f"heartbeat_file: {payload['data']['heartbeat'].get('heartbeat_file', '')}")
    print(f"loop_heartbeat_file: {payload['data']['heartbeat'].get('loop_heartbeat_file', 'none') or 'none'}")
    print("")
    print("=== AVAILABLE CAPABILITIES ===")
    for cap in capability_map:
        print(f"  {cap}")
    print("")
    print(f"next_step: {packet.get('first_command', '')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
