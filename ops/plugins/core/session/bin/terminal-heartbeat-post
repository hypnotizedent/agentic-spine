#!/usr/bin/env bash
# terminal-heartbeat-post — Write terminal ownership heartbeat for scope collision checks.
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
STATE_DIR="${SPINE_STATE}"
CONTRACT="$ROOT/ops/bindings/stabilization.mode.yaml"
HEARTBEAT_DIR="$STATE_DIR/terminal-heartbeats"
LOOP_HEARTBEAT_DIR="$STATE_DIR/loop-heartbeats"

usage() {
  cat <<'EOF'
Usage: terminal-heartbeat-post [options]

Options:
  --terminal-id <id>     Canonical terminal id (e.g. SPINE-CONTROL-01)
  --role <role>          Terminal role (default: unassigned)
  --runtime-role <role>  Runtime role resolved for the attached session (default: unknown)
  --scope <scope_csv>    Comma-separated write scope labels/paths
  --loop-id <loop_id>    Active loop/task id
  --repo-root <path>     Repo root path (default: current git root or pwd)
  --branch <name>        Branch name (default: current branch)
  --status <value>       active|idle|blocked (default: active)
  --ttl-minutes <n>      Heartbeat ttl (default from stabilization contract or 45)
  --json                 Emit JSON
EOF
}

canonical_path() {
  python3 - "$1" <<'PY'
from pathlib import Path
import sys

raw = sys.argv[1]
path = Path(raw).expanduser()
try:
    print(path.resolve(strict=False))
except Exception:
    print(path.absolute())
PY
}

iso_in_minutes() {
  local minutes="${1:-45}"
  python3 - "$minutes" <<'PY'
from datetime import datetime, timedelta, timezone
import sys

mins = int(sys.argv[1])
print((datetime.now(timezone.utc) + timedelta(minutes=mins)).strftime("%Y-%m-%dT%H:%M:%SZ"))
PY
}

repo_root_default() {
  git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || pwd
}

git_resolve_path() {
  local repo="$1" raw="$2"
  python3 - "$repo" "$raw" <<'PY'
from pathlib import Path
import sys

repo = Path(sys.argv[1]).expanduser().resolve()
raw = sys.argv[2]
path = Path(raw)
if not path.is_absolute():
    path = (repo / path).resolve()
else:
    path = path.resolve()
print(path)
PY
}

scope_csv_normalize() {
  local raw="${1:-}"
  python3 - "$raw" <<'PY'
import sys

raw = sys.argv[1]
items = []
for part in raw.split(","):
    text = part.strip()
    if not text:
        continue
    lowered = text.lower()
    if lowered in {"ops/bindings/operational.gaps.yaml", "operational.gaps.yaml"}:
        items.append("hotspot:operational-gaps")
    elif "loop-scopes" in lowered:
        items.append("hotspot:loop-scopes")
    elif "friction-queue" in lowered:
        items.append("hotspot:friction-queue")
    elif "gate-id-reservations" in lowered:
        items.append("hotspot:gate-id-reservations")
    elif "path.claims" in lowered or "path-claims" in lowered:
        items.append("hotspot:path-claims")
    else:
        items.append(text)
deduped = []
seen = set()
for item in items:
    if item in seen:
        continue
    deduped.append(item)
    seen.add(item)
print(",".join(deduped))
PY
}

extract_hotspot_scope() {
  local raw="${1:-}"
  python3 - "$raw" <<'PY'
import sys

tokens = [item.strip() for item in sys.argv[1].split(",") if item.strip()]
allowed = {
    "hotspot:operational-gaps",
    "hotspot:loop-scopes",
    "hotspot:friction-queue",
    "hotspot:gate-id-reservations",
    "hotspot:path-claims",
}
print(",".join([token for token in tokens if token in allowed]))
PY
}

terminal_id="${SPINE_TERMINAL_ID:-}"
role="${SPINE_TERMINAL_ROLE:-unassigned}"
runtime_role="${SPINE_RUNTIME_ROLE:-unknown}"
scope="${SPINE_TERMINAL_SCOPE:-unspecified}"
loop_id="${SPINE_LOOP_ID:-}"
repo_root="$(repo_root_default)"
branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "detached")"
status="active"
json_mode=0
ttl_minutes=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --terminal-id) terminal_id="${2:-}"; shift 2 ;;
    --role) role="${2:-}"; shift 2 ;;
    --runtime-role) runtime_role="${2:-}"; shift 2 ;;
    --scope) scope="${2:-}"; shift 2 ;;
    --loop-id) loop_id="${2:-}"; shift 2 ;;
    --repo-root) repo_root="${2:-}"; shift 2 ;;
    --branch) branch="${2:-}"; shift 2 ;;
    --status) status="${2:-}"; shift 2 ;;
    --ttl-minutes) ttl_minutes="${2:-}"; shift 2 ;;
    --json) json_mode=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "FAIL: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

repo_root="$(canonical_path "$repo_root")"
if [[ "$branch" == "HEAD" ]]; then
  branch="detached"
fi
main_checkout_path="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')"
[[ -n "$main_checkout_path" ]] || main_checkout_path="$repo_root"
main_checkout_path="$(canonical_path "$main_checkout_path")"

git_common_dir_raw="$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null || true)"
git_index_path_raw="$(git -C "$repo_root" rev-parse --git-path index 2>/dev/null || true)"
git_common_dir=""
git_index_path=""
if [[ -n "$git_common_dir_raw" ]]; then
  git_common_dir="$(git_resolve_path "$repo_root" "$git_common_dir_raw")"
fi
if [[ -n "$git_index_path_raw" ]]; then
  git_index_path="$(git_resolve_path "$repo_root" "$git_index_path_raw")"
fi

lane_type="managed_worktree"
if [[ "$repo_root" == "$main_checkout_path" ]]; then
  if [[ "$branch" == "main" ]]; then
    lane_type="root_main_integration"
  elif [[ "$branch" == "detached" ]]; then
    lane_type="root_checkout_detached"
  else
    lane_type="root_checkout_non_main"
  fi
fi

normalized_scope="$(scope_csv_normalize "$scope")"
protected_hotspot_scope="$(extract_hotspot_scope "$normalized_scope")"

if [[ -z "$ttl_minutes" ]]; then
  ttl_minutes="$(yq e -r '.terminal_contract.heartbeat_ttl_minutes // 45' "$CONTRACT" 2>/dev/null || echo 45)"
fi

if [[ -z "$terminal_id" ]]; then
  terminal_id="$(hostname -s | tr '[:lower:]' '[:upper:]')-LOCAL-01"
fi

mkdir -p "$HEARTBEAT_DIR"

safe_terminal_id="$(printf '%s' "$terminal_id" | tr -cs 'A-Za-z0-9._-' '_')"
heartbeat_file="$HEARTBEAT_DIR/${safe_terminal_id}.yaml"
tmp_file="${heartbeat_file}.tmp.$$"

# Keep a single active file per terminal_id even if historical filenames differ.
shopt -s nullglob
for existing in "$HEARTBEAT_DIR"/*.yaml; do
  [[ "$existing" == "$heartbeat_file" ]] && continue
  existing_terminal_id="$(yq e -r '.terminal_id // ""' "$existing" 2>/dev/null || true)"
  if [[ "$existing_terminal_id" == "$terminal_id" ]]; then
    rm -f "$existing"
  fi
done
shopt -u nullglob

heartbeat_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
expires_at="$(iso_in_minutes "$ttl_minutes")"
host_name="$(hostname -s)"

cat > "$tmp_file" <<EOF
version: 1
terminal_id: "$terminal_id"
role: "$role"
runtime_role: "$runtime_role"
scope: "$scope"
normalized_scope: "$normalized_scope"
protected_hotspot_scope: "$protected_hotspot_scope"
loop_id: "${loop_id}"
repo_root: "$repo_root"
checkout_root: "$repo_root"
branch: "$branch"
lane_type: "$lane_type"
git_common_dir: "$git_common_dir"
git_index_path: "$git_index_path"
status: "$status"
pid: $$
hostname: "$host_name"
heartbeat_at: "$heartbeat_at"
expires_at: "$expires_at"
EOF

mv "$tmp_file" "$heartbeat_file"

loop_heartbeat_file=""
if [[ -n "${loop_id:-}" ]]; then
  mkdir -p "$LOOP_HEARTBEAT_DIR"
  safe_loop_id="$(printf '%s' "$loop_id" | tr -cs 'A-Za-z0-9._-' '_')"
  loop_heartbeat_file="$LOOP_HEARTBEAT_DIR/${safe_loop_id}.yaml"
  loop_tmp_file="${loop_heartbeat_file}.tmp.$$"
  cat > "$loop_tmp_file" <<EOF
version: 1
loop_id: "$loop_id"
terminal_id: "$terminal_id"
last_heartbeat_utc: "$heartbeat_at"
heartbeat_ttl_minutes: $ttl_minutes
expires_at: "$expires_at"
terminal_status: "$status"
EOF
  mv "$loop_tmp_file" "$loop_heartbeat_file"
fi

if [[ "$json_mode" -eq 1 ]]; then
  command -v jq >/dev/null 2>&1 || {
    echo "FAIL: --json requires jq" >&2
    exit 1
  }
  jq -n \
    --arg terminal_id "$terminal_id" \
    --arg role "$role" \
    --arg runtime_role "$runtime_role" \
    --arg scope "$scope" \
    --arg loop_id "$loop_id" \
    --arg repo_root "$repo_root" \
    --arg checkout_root "$repo_root" \
    --arg branch "$branch" \
    --arg lane_type "$lane_type" \
    --arg git_common_dir "$git_common_dir" \
    --arg git_index_path "$git_index_path" \
    --arg normalized_scope "$normalized_scope" \
    --arg protected_hotspot_scope "$protected_hotspot_scope" \
    --arg status "$status" \
    --arg heartbeat_at "$heartbeat_at" \
    --arg expires_at "$expires_at" \
    --arg heartbeat_file "$heartbeat_file" \
    --arg loop_heartbeat_file "$loop_heartbeat_file" \
    '{
      terminal_id: $terminal_id,
      role: $role,
      runtime_role: $runtime_role,
      scope: $scope,
      loop_id: $loop_id,
      repo_root: $repo_root,
      checkout_root: $checkout_root,
      branch: $branch,
      lane_type: $lane_type,
      git_common_dir: $git_common_dir,
      git_index_path: $git_index_path,
      normalized_scope: $normalized_scope,
      protected_hotspot_scope: $protected_hotspot_scope,
      status: $status,
      heartbeat_at: $heartbeat_at,
      expires_at: $expires_at,
      heartbeat_file: $heartbeat_file,
      loop_heartbeat_file: $loop_heartbeat_file
    }'
  exit 0
fi

echo "terminal.heartbeat.post"
echo "terminal_id: $terminal_id"
echo "role: $role"
echo "runtime_role: $runtime_role"
echo "scope: $scope"
echo "normalized_scope: ${normalized_scope:-none}"
echo "protected_hotspot_scope: ${protected_hotspot_scope:-none}"
echo "loop_id: ${loop_id:-none}"
echo "repo_root: $repo_root"
echo "checkout_root: $repo_root"
echo "branch: $branch"
echo "lane_type: $lane_type"
echo "git_common_dir: ${git_common_dir:-none}"
echo "git_index_path: ${git_index_path:-none}"
echo "status: $status"
echo "heartbeat_at: $heartbeat_at"
echo "expires_at: $expires_at"
echo "heartbeat_file: $heartbeat_file"
if [[ -n "$loop_heartbeat_file" ]]; then
  echo "loop_heartbeat_file: $loop_heartbeat_file"
fi
