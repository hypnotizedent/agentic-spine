#!/usr/bin/env python3
"""session-ingress-sanitize

Apply the minimal Spine V3 border to imported chats, notes, and archives.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
REQUIRED_PACKET_FIELDS = [
    "objective",
    "done_check",
    "first_command",
    "allowed_actions",
    "forbidden_actions",
    "required_inputs",
    "expected_outputs",
    "execution_mode",
    "transport",
    "environment_constraints",
]


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as fh:
        loaded = yaml.safe_load(fh)
    return default if loaded is None else loaded


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def read_text(args: argparse.Namespace) -> tuple[str, str]:
    if args.input:
        path = Path(args.input).expanduser().resolve()
        return path.read_text(encoding="utf-8", errors="replace"), str(path)
    return sys.stdin.read(), ""


def field_present(field: str, text: str) -> bool:
    patterns = {
        "objective": r"\bobjective\b",
        "done_check": r"\bdone[_ -]?check\b",
        "first_command": r"\bfirst[_ -]?command\b",
        "allowed_actions": r"\ballowed[_ -]?actions\b",
        "forbidden_actions": r"\bforbidden[_ -]?actions\b",
        "required_inputs": r"\brequired[_ -]?inputs\b",
        "expected_outputs": r"\bexpected[_ -]?outputs\b",
        "execution_mode": r"\bexecution[_ -]?mode\b",
        "transport": r"\btransport\b",
        "environment_constraints": r"\benvironment[_ -]?constraints\b",
    }
    return bool(re.search(patterns[field], text, re.IGNORECASE))


def analyze_rules(text: str, rules: list[dict[str, Any]]) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    for rule in rules:
        matched: list[str] = []
        for pattern in rule.get("match", {}).get("any_substrings", []) or []:
            if pattern.lower() in text.lower():
                matched.append(pattern)
        for pattern in rule.get("match", {}).get("any_regex", []) or []:
            if re.search(pattern, text, re.IGNORECASE | re.MULTILINE):
                matched.append(pattern)
        if not matched:
            continue
        findings.append(
            {
                "rule_id": rule.get("id", "unknown"),
                "title": rule.get("title", ""),
                "severity": rule.get("severity", "medium"),
                "action": rule.get("action", "warn"),
                "matched_patterns": matched,
                "replacement": rule.get("replacement", ""),
            }
        )
    return findings


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Sanitize imported chats/notes/archives before broker or execution use")
    parser.add_argument("--input", help="Input file path; otherwise read stdin")
    parser.add_argument("--source-type", choices=["chat", "notes", "archive", "unknown"], default="unknown")
    parser.add_argument("--output", help="Optional path to write sanitized staging artifact")
    parser.add_argument("--json", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    text, input_path = read_text(args)
    deprecations = load_yaml(ROOT / "ops/deprecations.yaml", {})
    findings = analyze_rules(text, deprecations.get("rules", []) or [])
    present_fields = [field for field in REQUIRED_PACKET_FIELDS if field_present(field, text)]
    missing_fields = [field for field in REQUIRED_PACKET_FIELDS if field not in present_fields]
    blocked = any(f.get("action") == "block" for f in findings)
    output_path = ""

    if args.output:
        out_path = Path(args.output).expanduser().resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        staged = {
            "source_type": args.source_type,
            "ingested_at_utc": utc_now(),
            "input_path": input_path,
            "input_sha256": sha256_text(text),
            "trust_class": "untrusted_import",
            "decision": "blocked" if blocked else "sanitize_required",
            "findings": findings,
            "packet_requirements": {
                "present": present_fields,
                "missing": missing_fields,
            },
            "next_step": "Compile entry packet before broker dispatch; never execute imported text directly.",
            "raw_text": text,
        }
        out_path.write_text(yaml.safe_dump(staged, sort_keys=False), encoding="utf-8")
        output_path = str(out_path)

    payload = {
        "capability": "session.ingress.sanitize",
        "schema_version": "1.0",
        "status": "blocked" if blocked else "done",
        "generated_at": utc_now(),
        "data": {
            "source_type": args.source_type,
            "input_path": input_path,
            "input_sha256": sha256_text(text),
            "trust_class": "untrusted_import",
            "decision": "blocked" if blocked else "sanitize_required",
            "findings": findings,
            "packet_requirements": {
                "required": REQUIRED_PACKET_FIELDS,
                "present": present_fields,
                "missing": missing_fields,
            },
            "next_step": "Compile entry packet before broker dispatch; never execute imported text directly.",
            "sanitized_output_path": output_path,
        },
    }

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("session.ingress.sanitize")
        print(f"decision: {payload['data']['decision']}")
        print(f"source_type: {args.source_type}")
        print(f"input_path: {input_path or '(stdin)'}")
        print(f"findings: {len(findings)}")
        print(f"missing_packet_fields: {','.join(missing_fields) if missing_fields else 'none'}")
        if output_path:
            print(f"sanitized_output_path: {output_path}")

    return 1 if blocked else 0


if __name__ == "__main__":
    raise SystemExit(main())
