#!/usr/bin/env bash
set -euo pipefail

# session-execution-lane-closeout — Mark execution lane as closed with explicit state
#
# Usage:
#   session-execution-lane-closeout --lane-id <ID> --status <status> [options]
#
# Required:
#   --lane-id <LANE-ID>
#   --status <landed|deferred|abandoned|blocked|review-complete|changes-requested|findings-documented>
#
# Optional:
#   --reason "<reason>"         # Required for some statuses
#   --landing-commit <sha>      # SHA if landed
#   --friction-input <file>     # JSONL file of discovered friction items
#   --json                      # Machine-readable output
#
# Returns:
#   0 if closeout successful
#   1 if validation fails
#   2 if invalid arguments

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

CONTRACT_FILE="$ROOT/ops/bindings/session.execution.lane.contract.yaml"
STATE_ROOT="$SPINE_STATE/execution-lanes"
RECEIPT_ROOT="$SPINE_EVIDENCE_ROOT/execution-lanes"
PLAN_CREATE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/planning-plans-create"
LOOPS_CREATE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/loops-create"
LOOPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/loops-authority-bridge"
FRICTION_INGEST_BIN="${SPINE_FRICTION_INGEST_BIN:-$ROOT/ops/plugins/core/lifecycle/bin/friction-ingest}"
FRICTION_QUEUE_FILE="${SPINE_FRICTION_QUEUE_FILE:-$SPINE_STATE/friction-queue.ndjson}"

# Args
LANE_ID=""
STATUS=""
REASON=""
LANDING_COMMIT=""
PLAN_ID=""
PLAN_REVIEW_DATE=""
PLAN_DESCRIPTION=""
PLAN_LOOP_ID=""
PLAN_BRANCH_RETENTION_STATE=""
PLAN_PR_URL=""
FRICTION_INPUT=""
JSON_OUTPUT=false
FRICTION_SUMMARY_OUTPUT_JSON=""
FRICTION_RECEIPT_SUMMARY_JSON=""
LOOP_CONTINUITY_NEXT_ACTION=""
LOOP_CONTINUITY_RESULT_JSON=""
declare -a LOOP_CONTINUITY_EVIDENCE_REFS=()

TMP_FILES=()

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

cleanup_tmp_files() {
  local path
  for path in "${TMP_FILES[@]:-}"; do
    [[ -n "$path" && -e "$path" ]] && rm -f "$path"
  done
  return 0
}

register_tmp_file() {
  local path="$1"
  [[ -n "$path" ]] || return 0
  TMP_FILES+=("$path")
}

trap cleanup_tmp_files EXIT

normalize_branch_token() {
  local raw="$1"
  local normalized
  normalized="$(printf '%s' "$raw" \
    | tr '[:lower:]' '[:upper:]' \
    | sed -E 's#[/[:space:]_]+#-#g; s/[^A-Z0-9-]//g; s/-+/-/g; s/^-+//; s/-+$//')"
  while [[ "$normalized" == CODEX-* || "$normalized" == RUNTIME-* || "$normalized" == MANAGED-* || "$normalized" == WORKTREE-* ]]; do
    normalized="${normalized#*-}"
  done
  printf '%s\n' "$normalized"
}

default_review_date() {
  python3 - <<'PY'
from datetime import datetime, timedelta, timezone
print((datetime.now(timezone.utc) + timedelta(days=7)).strftime("%Y-%m-%d"))
PY
}

json_array_from_values() {
  if [[ "$#" -eq 0 ]]; then
    printf '[]\n'
    return 0
  fi

  python3 - "$@" <<'PY'
import json
import sys

items = [arg.strip() for arg in sys.argv[1:] if arg.strip()]
print(json.dumps(items))
PY
}

normalize_friction_input_file() {
  local input_file="$1"
  local output_file="$2"
  python3 - "$input_file" "$output_file" <<'PY'
import json
import sys
from pathlib import Path

VALID_SEVERITIES = {"low", "medium", "high", "critical"}


def normalize_space(value: str) -> str:
    return " ".join((value or "").strip().split())


src = Path(sys.argv[1])
dst = Path(sys.argv[2])

rows = []
for idx, raw in enumerate(src.read_text(encoding="utf-8", errors="replace").splitlines(), start=1):
    line = raw.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"malformed friction input line {idx}: {exc.msg}") from exc
    if not isinstance(obj, dict):
        raise SystemExit(f"malformed friction input line {idx}: JSON value must be an object")

    capability = normalize_space(str(obj.get("capability", "")))
    expected = normalize_space(str(obj.get("expected", "")))
    actual = normalize_space(str(obj.get("actual", "")))
    if not capability or not expected or not actual:
        raise SystemExit(f"malformed friction input line {idx}: item requires capability, expected, actual")

    severity = normalize_space(str(obj.get("severity", "medium")).lower())
    if severity not in VALID_SEVERITIES:
        severity = "medium"

    auto_reconcile = obj.get("auto_reconcile", False)
    if not isinstance(auto_reconcile, bool):
        raise SystemExit(f"malformed friction input line {idx}: auto_reconcile must be true or false")

    evidence_ref = obj.get("evidence_ref", "")
    if evidence_ref is None:
        evidence_ref = ""
    elif not isinstance(evidence_ref, str):
        raise SystemExit(f"malformed friction input line {idx}: evidence_ref must be a string when provided")

    source = obj.get("source", "")
    if source is None:
        source = ""
    elif not isinstance(source, str):
        raise SystemExit(f"malformed friction input line {idx}: source must be a string when provided")

    rows.append(
        {
            "capability": capability,
            "expected": expected,
            "actual": actual,
            "severity": severity,
            "source": normalize_space(source),
            "auto_reconcile": auto_reconcile,
            "evidence_ref": normalize_space(evidence_ref),
        }
    )

if not rows:
    raise SystemExit("friction input file contains no valid items")

with dst.open("w", encoding="utf-8") as fh:
    for row in rows:
        fh.write(json.dumps(row, separators=(",", ":")))
        fh.write("\n")
PY
}

resolve_friction_id() {
  local item_json="$1"
  local source="$2"
  python3 - "$FRICTION_QUEUE_FILE" "$item_json" "$source" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

VALID_SEVERITIES = {"low", "medium", "high", "critical"}


def normalize_space(value: str) -> str:
    return " ".join((value or "").strip().split())


queue_path = Path(sys.argv[1])
item = json.loads(sys.argv[2])
source = normalize_space(sys.argv[3]) or "manual"
severity = normalize_space(str(item.get("severity", "medium")).lower())
if severity not in VALID_SEVERITIES:
    severity = "medium"

canonical = {
    "capability": normalize_space(str(item.get("capability", ""))),
    "expected": normalize_space(str(item.get("expected", ""))),
    "actual": normalize_space(str(item.get("actual", ""))),
    "severity": severity,
    "source": source,
}
fingerprint = hashlib.sha256(
    json.dumps(canonical, sort_keys=True, separators=(",", ":")).encode("utf-8")
).hexdigest()

friction_id = ""
if queue_path.exists():
    for raw in queue_path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict) and str(obj.get("fingerprint", "")) == fingerprint:
            friction_id = str(obj.get("friction_id", "")).strip()
            if friction_id:
                break

print(json.dumps({"friction_id": friction_id, "fingerprint": fingerprint}))
PY
}

ingest_discovered_friction() {
  [[ -x "$FRICTION_INGEST_BIN" ]] || fail "friction ingest unavailable at $FRICTION_INGEST_BIN"

  local normalized_input
  normalized_input="$(mktemp)"
  register_tmp_file "$normalized_input"
  local normalize_error=""
  if ! normalize_error="$(normalize_friction_input_file "$FRICTION_INPUT" "$normalized_input" 2>&1)"; then
    fail "$normalize_error"
  fi

  local results_file
  results_file="$(mktemp)"
  register_tmp_file "$results_file"

  local -a group_keys=()
  declare -A group_files=()
  declare -A group_sources=()
  declare -A group_auto=()

  local item_json item_source auto_reconcile evidence_ref ingest_item
  local resolved_json existing_id capability group_key enriched_json
  while IFS= read -r item_json; do
    [[ -n "$item_json" ]] || continue

    item_source="$(printf '%s\n' "$item_json" | jq -r '.source // empty')"
    [[ -n "$item_source" ]] || item_source="session.execution.lane.closeout"
    auto_reconcile="$(printf '%s\n' "$item_json" | jq -r '.auto_reconcile')"
    evidence_ref="$(printf '%s\n' "$item_json" | jq -r '.evidence_ref // empty')"
    capability="$(printf '%s\n' "$item_json" | jq -r '.capability')"

    if [[ "$auto_reconcile" == "true" ]] && [[ -z "$PARENT_LOOP" ]]; then
      fail "--friction-input item for capability '$capability' requested auto_reconcile, but lane '$LANE_ID' has no parent_loop"
    fi

    ingest_item="$(printf '%s\n' "$item_json" | jq -c '{capability, expected, actual, severity}')"
    resolved_json="$(resolve_friction_id "$ingest_item" "$item_source")"
    existing_id="$(printf '%s\n' "$resolved_json" | jq -r '.friction_id // empty')"

    group_key="$(printf '%s|%s\n' "$item_source" "$auto_reconcile" | shasum -a 256 | awk '{print $1}')"
    if [[ -z "${group_files[$group_key]:-}" ]]; then
      group_files[$group_key]="$(mktemp)"
      register_tmp_file "${group_files[$group_key]}"
      group_sources[$group_key]="$item_source"
      group_auto[$group_key]="$auto_reconcile"
      group_keys+=("$group_key")
    fi

    enriched_json="$(printf '%s\n' "$item_json" | jq -c --arg existing_id "$existing_id" '
      . + {
        existing_id: (if $existing_id == "" then null else $existing_id end)
      }')"
    printf '%s\n' "$enriched_json" >> "${group_files[$group_key]}"
  done < "$normalized_input"

  local group_index=0
  local total_groups="${#group_keys[@]}"
  local ingest_output created_count reconcile_json friction_id result_json created_json deduped_json
  for group_key in "${group_keys[@]}"; do
    group_index=$((group_index + 1))
    item_source="${group_sources[$group_key]}"
    auto_reconcile="${group_auto[$group_key]}"
    local -a ingest_cmd=(
      "$FRICTION_INGEST_BIN"
      --input "${group_files[$group_key]}"
      --source "$item_source"
      --json
    )
    if [[ "$auto_reconcile" == "true" ]]; then
      ingest_cmd+=(--auto-reconcile --loop-id "$PARENT_LOOP")
    fi
    ingest_output="$("${ingest_cmd[@]}")" || fail "friction ingest failed for source '$item_source'"
    created_count="$(printf '%s\n' "$ingest_output" | jq -r '.created // 0')"
    reconcile_json="$(printf '%s\n' "$ingest_output" | jq -c '.reconcile // null')"

    while IFS= read -r item_json; do
      [[ -n "$item_json" ]] || continue
      capability="$(printf '%s\n' "$item_json" | jq -r '.capability')"
      evidence_ref="$(printf '%s\n' "$item_json" | jq -r '.evidence_ref // empty')"
      ingest_item="$(printf '%s\n' "$item_json" | jq -c '{capability, expected, actual, severity}')"
      resolved_json="$(resolve_friction_id "$ingest_item" "$item_source")"
      friction_id="$(printf '%s\n' "$resolved_json" | jq -r '.friction_id // empty')"
      [[ -n "$friction_id" ]] || fail "unable to resolve friction_id after ingest for capability '$capability'"

      created_json="$(printf '%s\n' "$item_json" | jq '(.existing_id // null) == null')"
      deduped_json="$(printf '%s\n' "$item_json" | jq '(.existing_id // null) != null')"
      result_json="$(jq -cn \
        --arg capability "$capability" \
        --arg source "$item_source" \
        --arg evidence_ref "$evidence_ref" \
        --arg friction_id "$friction_id" \
        --argjson auto_reconcile "$auto_reconcile" \
        --argjson created "$created_json" \
        --argjson deduped "$deduped_json" \
        --argjson reconcile "$reconcile_json" \
        '{
          capability: $capability,
          source: $source,
          evidence_ref: (if $evidence_ref == "" then null else $evidence_ref end),
          friction_id: $friction_id,
          auto_reconcile: $auto_reconcile,
          created: $created,
          deduped: $deduped,
          reconcile: $reconcile
        }')"
      printf '%s\n' "$result_json" >> "$results_file"
    done < "${group_files[$group_key]}"

    # friction.ingest allocates FR ids per invocation starting at 0001. Keep
    # created groups on separate second boundaries so different source groups do
    # not collide when the authority surface is reused unchanged.
    if [[ "$created_count" != "0" && "$group_index" -lt "$total_groups" ]]; then
      sleep 1
    fi
  done

  FRICTION_SUMMARY_OUTPUT_JSON="$(jq -cs '{
      provided: length,
      created: (map(if .created then 1 else 0 end) | add // 0),
      deduped: (map(if .deduped then 1 else 0 end) | add // 0),
      auto_reconcile_items: (map(select(.auto_reconcile == true)) | length),
      friction_ids: ([ .[] | .friction_id ] | unique),
      created_ids: ([ .[] | select(.created == true) | .friction_id ] | unique),
      deduped_ids: ([ .[] | select(.deduped == true) | .friction_id ] | unique),
      auto_reconcile_ids: ([ .[] | select(.auto_reconcile == true) | .friction_id ] | unique),
      items: .
    }' "$results_file")"
  FRICTION_RECEIPT_SUMMARY_JSON="$(printf '%s\n' "$FRICTION_SUMMARY_OUTPUT_JSON" | jq 'del(.items)')"
}

persist_parent_loop_continuity() {
  local continuity_requested=0
  local evidence_json=""
  local -a continuity_cmd=()

  if [[ -n "$LOOP_CONTINUITY_NEXT_ACTION" || "${#LOOP_CONTINUITY_EVIDENCE_REFS[@]}" -gt 0 ]]; then
    continuity_requested=1
  fi
  [[ "$continuity_requested" -eq 1 ]] || return 0

  [[ -n "$PARENT_LOOP" ]] || fail "loop continuity update requested, but lane '$LANE_ID' has no parent_loop"
  [[ -x "$LOOPS_BRIDGE" ]] || fail "loops authority bridge unavailable at $LOOPS_BRIDGE"

  evidence_json="$(json_array_from_values "${LOOP_CONTINUITY_EVIDENCE_REFS[@]}")"
  continuity_cmd=(
    python3 "$LOOPS_BRIDGE" continuity
    --id "$PARENT_LOOP"
    --actor "session.execution.lane.closeout"
    --reason "Persisted lane closeout continuity from ${LANE_ID}"
    --append-evidence-refs
  )
  if [[ -n "$LOOP_CONTINUITY_NEXT_ACTION" ]]; then
    continuity_cmd+=(--next-action "$LOOP_CONTINUITY_NEXT_ACTION")
  fi
  if [[ "$evidence_json" != "[]" ]]; then
    continuity_cmd+=(--evidence-refs-json "$evidence_json")
  fi

  LOOP_CONTINUITY_RESULT_JSON="$("${continuity_cmd[@]}")" || fail "failed to persist parent loop continuity for $PARENT_LOOP"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lane-id)
      LANE_ID="${2:-}"
      shift 2
      ;;
    --status)
      STATUS="${2:-}"
      shift 2
      ;;
    --reason)
      REASON="${2:-}"
      shift 2
      ;;
    --landing-commit)
      LANDING_COMMIT="${2:-}"
      shift 2
      ;;
    --plan-id)
      PLAN_ID="${2:-}"
      shift 2
      ;;
    --plan-review-date)
      PLAN_REVIEW_DATE="${2:-}"
      shift 2
      ;;
    --plan-description)
      PLAN_DESCRIPTION="${2:-}"
      shift 2
      ;;
    --plan-loop-id)
      PLAN_LOOP_ID="${2:-}"
      shift 2
      ;;
    --branch-retention-state)
      PLAN_BRANCH_RETENTION_STATE="${2:-}"
      shift 2
      ;;
    --pr-url)
      PLAN_PR_URL="${2:-}"
      shift 2
      ;;
    --friction-input)
      FRICTION_INPUT="${2:-}"
      shift 2
      ;;
    --loop-next-action)
      LOOP_CONTINUITY_NEXT_ACTION="${2:-}"
      shift 2
      ;;
    --loop-evidence-ref)
      LOOP_CONTINUITY_EVIDENCE_REFS+=("${2:-}")
      shift 2
      ;;
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    *)
      echo "ERROR: Unknown argument: $1" >&2
      echo "Usage: session-execution-lane-closeout --lane-id <ID> --status <status> [options]" >&2
      exit 2
      ;;
  esac
done

# Validation
if [[ -z "$LANE_ID" ]]; then
  echo "ERROR: --lane-id required" >&2
  exit 2
fi

if [[ -z "$STATUS" ]]; then
  echo "ERROR: --status required" >&2
  exit 2
fi

# Check if lane state file exists
LANE_STATE_FILE="$STATE_ROOT/${LANE_ID}.yaml"
if [[ ! -f "$LANE_STATE_FILE" ]]; then
  echo "ERROR: Lane state file not found: $LANE_STATE_FILE" >&2
  echo "Lane ID may be invalid or already closed" >&2
  exit 1
fi

# Read current lane state
LANE_TYPE=$(yq e '.type' "$LANE_STATE_FILE" 2>/dev/null || echo "")
CURRENT_STATUS=$(yq e '.status' "$LANE_STATE_FILE" 2>/dev/null || echo "active")
BRANCH=$(yq e '.branch' "$LANE_STATE_FILE" 2>/dev/null || echo "")
WORKTREE_PATH=$(yq e '.worktree_path' "$LANE_STATE_FILE" 2>/dev/null || echo "")
PARENT_LOOP=$(yq e '.parent_loop // ""' "$LANE_STATE_FILE" 2>/dev/null || echo "")
CREATED_BY=$(yq e '.created_by // "@ronny"' "$LANE_STATE_FILE" 2>/dev/null || echo "@ronny")

if [[ -z "$LANE_TYPE" ]]; then
  echo "ERROR: Could not read lane type from state file" >&2
  exit 1
fi

# Check if already closed
if [[ "$CURRENT_STATUS" != "active" ]]; then
  echo "ERROR: Lane $LANE_ID is already closed (status: $CURRENT_STATUS)" >&2
  exit 1
fi

if [[ -n "$LOOP_CONTINUITY_NEXT_ACTION" || "${#LOOP_CONTINUITY_EVIDENCE_REFS[@]}" -gt 0 ]]; then
  [[ -n "$PARENT_LOOP" ]] || fail "loop continuity update requested, but lane '$LANE_ID' has no parent_loop"
fi

# Validate status is allowed for this lane type
ALLOWED_STATUSES=$(yq e ".lane_types.${LANE_TYPE}.closeout_options | join(\",\")" "$CONTRACT_FILE" 2>/dev/null || echo "")
if [[ ! ",$ALLOWED_STATUSES," =~ ,"$STATUS", ]]; then
  echo "ERROR: Status '$STATUS' not allowed for $LANE_TYPE lane" >&2
  echo "Allowed: $ALLOWED_STATUSES" >&2
  exit 1
fi

# Check if reason is required
REASON_REQUIRED=$(yq e ".closeout_requirements.${LANE_TYPE}.reason_required // false" "$CONTRACT_FILE" 2>/dev/null)
if [[ "$REASON_REQUIRED" == "true" ]] && [[ -z "$REASON" ]]; then
  echo "ERROR: --reason required for $LANE_TYPE lane closeout" >&2
  exit 1
fi

if [[ -n "$FRICTION_INPUT" ]]; then
  [[ -f "$FRICTION_INPUT" ]] || fail "--friction-input file not found: $FRICTION_INPUT"
  ingest_discovered_friction
fi

if [[ "$STATUS" == "deferred" ]]; then
  if [[ -z "$BRANCH" || "$BRANCH" == "null" ]]; then
    echo "ERROR: deferred closeout requires branch metadata in lane state" >&2
    exit 1
  fi
  branch_token="$(normalize_branch_token "$BRANCH")"
  [[ -n "$branch_token" ]] || {
    echo "ERROR: could not derive deferred plan token from branch '$BRANCH'" >&2
    exit 1
  }

  [[ -n "$PLAN_ID" ]] || PLAN_ID="PLAN-${branch_token}"
  [[ -n "$PLAN_REVIEW_DATE" ]] || PLAN_REVIEW_DATE="$(default_review_date)"
  [[ -n "$PLAN_DESCRIPTION" ]] || PLAN_DESCRIPTION="Deferred lane closeout preserved branch ${BRANCH} from ${LANE_ID}; future work must resume from governed plan memory, not branch-only memory."
  [[ -n "$PLAN_BRANCH_RETENTION_STATE" ]] || PLAN_BRANCH_RETENTION_STATE="keep"

  if [[ -z "$PLAN_LOOP_ID" ]]; then
    create_output="$("$LOOPS_CREATE_BIN" \
      --name "$branch_token" \
      --objective "Governed deferred branch memory for ${BRANCH} after lane ${LANE_ID} closeout." \
      --priority medium \
      --horizon later \
      --readiness blocked \
      --execution-mode single_worker \
      --json)"
    PLAN_LOOP_ID="$(printf '%s' "$create_output" | python3 -c 'import json,sys; print(json.load(sys.stdin)["loop_id"])')"
    PLAN_SCOPE_FILE="$(printf '%s' "$create_output" | python3 -c 'import json,sys; print(json.load(sys.stdin)["scope_file"])')"
  else
    [[ "$PLAN_LOOP_ID" =~ ^LOOP-[A-Z0-9-]+$ ]] || fail "invalid --plan-loop-id: $PLAN_LOOP_ID"
    PLAN_SCOPE_FILE="$SPINE_STATE/loop-scopes/${PLAN_LOOP_ID}.scope.md"
    [[ -f "$PLAN_SCOPE_FILE" ]] || fail "--plan-loop-id does not resolve to a real scope file: $PLAN_SCOPE_FILE"
  fi

  [[ -n "${PLAN_SCOPE_FILE:-}" ]] || PLAN_SCOPE_FILE="$SPINE_STATE/loop-scopes/${PLAN_LOOP_ID}.scope.md"

  PLAN_INDEX="$SPINE_STATE/plans/index.yaml"
  PLAN_EXISTS=0
  if [[ -f "$PLAN_INDEX" ]] && yq e -e ".plans[]? | select(.plan_id == \"$PLAN_ID\") | .plan_id" "$PLAN_INDEX" >/dev/null 2>&1; then
    PLAN_EXISTS=1
  fi

  if [[ "$PLAN_EXISTS" -eq 0 ]]; then
    TRACKING_REF="$(git -C "$ROOT" for-each-ref --format='%(upstream:short)' "refs/heads/${BRANCH}" 2>/dev/null | head -1 || true)"
    plan_cmd=(
      "$PLAN_CREATE_BIN"
      --plan-id "$PLAN_ID"
      --loop-id "$PLAN_LOOP_ID"
      --owner "$CREATED_BY"
      --horizon later
      --review-date "$PLAN_REVIEW_DATE"
      --description "$PLAN_DESCRIPTION"
      --activation-trigger manual
      --branch-ref "$BRANCH"
      --worktree-path "$WORKTREE_PATH"
      --branch-retention-state "$PLAN_BRANCH_RETENTION_STATE"
    )
    if [[ -n "$TRACKING_REF" ]]; then
      plan_cmd+=(--tracking-ref "$TRACKING_REF")
    fi
    if [[ -n "$PLAN_PR_URL" ]]; then
      plan_cmd+=(--pr-url "$PLAN_PR_URL")
    fi
    "${plan_cmd[@]}" >/dev/null
  fi
fi

# Update lane state file
yq e -i ".status = \"$STATUS\"" "$LANE_STATE_FILE"
yq e -i ".closed_at = \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" "$LANE_STATE_FILE"
yq e -i ".closed_by = \"session.execution.lane.closeout\"" "$LANE_STATE_FILE"

if [[ -n "$REASON" ]]; then
  yq e -i ".closeout_reason = \"$REASON\"" "$LANE_STATE_FILE"
fi

if [[ -n "$LANDING_COMMIT" ]]; then
  yq e -i ".landing_commit = \"$LANDING_COMMIT\"" "$LANE_STATE_FILE"
fi
if [[ "$STATUS" == "deferred" ]]; then
  yq e -i ".deferred_plan_id = \"$PLAN_ID\"" "$LANE_STATE_FILE"
  yq e -i ".deferred_loop_id = \"$PLAN_LOOP_ID\"" "$LANE_STATE_FILE"
  yq e -i ".deferred_review_date = \"$PLAN_REVIEW_DATE\"" "$LANE_STATE_FILE"
  yq e -i ".branch_retention_state = \"$PLAN_BRANCH_RETENTION_STATE\"" "$LANE_STATE_FILE"
  if [[ -n "${TRACKING_REF:-}" ]]; then
    yq e -i ".branch_tracking_ref = \"$TRACKING_REF\"" "$LANE_STATE_FILE"
  fi
  if [[ -n "$PLAN_PR_URL" ]]; then
    yq e -i ".branch_pr_url = \"$PLAN_PR_URL\"" "$LANE_STATE_FILE"
  fi
fi

# Create closeout receipt
mkdir -p "$RECEIPT_ROOT"
RECEIPT_FILE="$RECEIPT_ROOT/${LANE_ID}-closeout-$(date +%Y%m%d-%H%M%S).yaml"
cat > "$RECEIPT_FILE" <<YAML
lane_id: "$LANE_ID"
lane_type: "$LANE_TYPE"
branch: "$BRANCH"
worktree_path: "$WORKTREE_PATH"
status: "$STATUS"
closed_at: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
closed_by: "session.execution.lane.closeout"
reason: "${REASON:-}"
landing_commit: "${LANDING_COMMIT:-}"
deferred_plan_id: "${PLAN_ID:-}"
deferred_loop_id: "${PLAN_LOOP_ID:-}"
deferred_review_date: "${PLAN_REVIEW_DATE:-}"
branch_retention_state: "${PLAN_BRANCH_RETENTION_STATE:-}"
branch_pr_url: "${PLAN_PR_URL:-}"
YAML

if [[ -n "$FRICTION_RECEIPT_SUMMARY_JSON" ]]; then
  python3 - "$RECEIPT_FILE" "$FRICTION_RECEIPT_SUMMARY_JSON" <<'PY'
import json
import sys
import yaml

receipt_path = sys.argv[1]
summary = json.loads(sys.argv[2])
doc = yaml.safe_load(open(receipt_path, encoding="utf-8")) or {}
doc["friction_ingest"] = summary
with open(receipt_path, "w", encoding="utf-8") as fh:
    yaml.safe_dump(doc, fh, sort_keys=False)
PY
fi

if [[ -n "$LOOP_CONTINUITY_NEXT_ACTION" || "${#LOOP_CONTINUITY_EVIDENCE_REFS[@]}" -gt 0 ]]; then
  LOOP_CONTINUITY_EVIDENCE_REFS+=("$RECEIPT_FILE")
  if [[ -n "${PLAN_SCOPE_FILE:-}" ]]; then
    LOOP_CONTINUITY_EVIDENCE_REFS+=("$PLAN_SCOPE_FILE")
  fi
  persist_parent_loop_continuity
  python3 - "$RECEIPT_FILE" "$LOOP_CONTINUITY_RESULT_JSON" <<'PY'
import json
import sys
import yaml

receipt_path = sys.argv[1]
continuity = json.loads(sys.argv[2])
doc = yaml.safe_load(open(receipt_path, encoding="utf-8")) or {}
doc["loop_continuity"] = {
    "loop_id": continuity.get("loop_id", ""),
    "next_action": continuity.get("next_action", ""),
    "evidence_refs": continuity.get("evidence_refs", []),
}
with open(receipt_path, "w", encoding="utf-8") as fh:
    yaml.safe_dump(doc, fh, sort_keys=False)
PY
fi

# Log to audit trail
AUDIT_LOG="$STATE_ROOT/audit.log"
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)|closeout|$LANE_ID|$LANE_TYPE|$STATUS|$REASON" >> "$AUDIT_LOG"

# Output
if [[ "$JSON_OUTPUT" == "true" ]]; then
  jq -n \
    --arg lane_id "$LANE_ID" \
    --arg status "$STATUS" \
    --arg receipt "$RECEIPT_FILE" \
    --argjson friction_ingest "${FRICTION_SUMMARY_OUTPUT_JSON:-null}" \
    --argjson loop_continuity "${LOOP_CONTINUITY_RESULT_JSON:-null}" \
    '{
      lane_id: $lane_id,
      status: $status,
      receipt: $receipt
    }
    + (if $friction_ingest == null then {} else {friction_ingest: $friction_ingest} end)
    + (if $loop_continuity == null then {} else {loop_continuity: $loop_continuity} end)'
else
  echo "════════════════════════════════════════════════════════════"
  echo "LANE CLOSED"
  echo "════════════════════════════════════════════════════════════"
  echo "Lane ID:    $LANE_ID"
  echo "Type:       $LANE_TYPE"
  echo "Status:     $STATUS"
  echo "Receipt:    $RECEIPT_FILE"
  echo ""

  if [[ "$STATUS" == "landed" || "$STATUS" == "abandoned" ]]; then
    echo "Safe to delete worktree:"
    echo "  cd ~"
    echo "  git worktree remove '$WORKTREE_PATH'"
    if [[ "$STATUS" == "landed" ]]; then
      echo "  git branch -d '$BRANCH'  # Merged, safe to delete"
    else
      echo "  git branch -D '$BRANCH'  # Force delete (not merged)"
    fi
  elif [[ "$STATUS" == "deferred" ]]; then
    echo "Lane deferred - branch preserved via governed plan memory"
    echo "Deferred plan: $PLAN_ID"
    echo "Deferred loop: $PLAN_LOOP_ID"
    echo "Review date:   $PLAN_REVIEW_DATE"
    echo "To resume: promote the plan/loop first, then re-enter execution"
  fi
  if [[ -n "$FRICTION_SUMMARY_OUTPUT_JSON" ]]; then
    echo ""
    echo "Friction ingest:"
    echo "  Provided: $(printf '%s\n' "$FRICTION_SUMMARY_OUTPUT_JSON" | jq -r '.provided')"
    echo "  Created:  $(printf '%s\n' "$FRICTION_SUMMARY_OUTPUT_JSON" | jq -r '.created')"
    echo "  Deduped:  $(printf '%s\n' "$FRICTION_SUMMARY_OUTPUT_JSON" | jq -r '.deduped')"
  fi
  if [[ -n "$LOOP_CONTINUITY_RESULT_JSON" ]]; then
    echo ""
    echo "Loop continuity:"
    echo "  Loop: $(printf '%s\n' "$LOOP_CONTINUITY_RESULT_JSON" | jq -r '.loop_id')"
    echo "  Next: $(printf '%s\n' "$LOOP_CONTINUITY_RESULT_JSON" | jq -r '.next_action // \"\"')"
  fi
  echo "════════════════════════════════════════════════════════════"
fi

exit 0
