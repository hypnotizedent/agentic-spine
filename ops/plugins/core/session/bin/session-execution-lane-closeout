#!/usr/bin/env bash
set -euo pipefail

# session-execution-lane-closeout — Mark execution lane as closed with explicit state
#
# Usage:
#   session-execution-lane-closeout --lane-id <ID> --status <status> [options]
#
# Required:
#   --lane-id <LANE-ID>
#   --status <landed|deferred|abandoned|blocked|review-complete|changes-requested|findings-documented>
#
# Optional:
#   --reason "<reason>"         # Required for some statuses
#   --landing-commit <sha>      # SHA if landed
#   --json                      # Machine-readable output
#
# Returns:
#   0 if closeout successful
#   1 if validation fails
#   2 if invalid arguments

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

CONTRACT_FILE="$ROOT/ops/bindings/session.execution.lane.contract.yaml"
STATE_ROOT="$SPINE_STATE/execution-lanes"
RECEIPT_ROOT="$SPINE_EVIDENCE_ROOT/execution-lanes"
PLAN_CREATE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/planning-plans-create"
LOOPS_CREATE_BIN="$ROOT/ops/plugins/core/lifecycle/bin/loops-create"

# Args
LANE_ID=""
STATUS=""
REASON=""
LANDING_COMMIT=""
PLAN_ID=""
PLAN_REVIEW_DATE=""
PLAN_DESCRIPTION=""
PLAN_LOOP_ID=""
PLAN_BRANCH_RETENTION_STATE=""
PLAN_PR_URL=""
JSON_OUTPUT=false

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

normalize_branch_token() {
  local raw="$1"
  local normalized
  normalized="$(printf '%s' "$raw" \
    | tr '[:lower:]' '[:upper:]' \
    | sed -E 's#[/[:space:]_]+#-#g; s/[^A-Z0-9-]//g; s/-+/-/g; s/^-+//; s/-+$//')"
  while [[ "$normalized" == CODEX-* || "$normalized" == RUNTIME-* || "$normalized" == MANAGED-* || "$normalized" == WORKTREE-* ]]; do
    normalized="${normalized#*-}"
  done
  printf '%s\n' "$normalized"
}

default_review_date() {
  python3 - <<'PY'
from datetime import datetime, timedelta, timezone
print((datetime.now(timezone.utc) + timedelta(days=7)).strftime("%Y-%m-%d"))
PY
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lane-id)
      LANE_ID="${2:-}"
      shift 2
      ;;
    --status)
      STATUS="${2:-}"
      shift 2
      ;;
    --reason)
      REASON="${2:-}"
      shift 2
      ;;
    --landing-commit)
      LANDING_COMMIT="${2:-}"
      shift 2
      ;;
    --plan-id)
      PLAN_ID="${2:-}"
      shift 2
      ;;
    --plan-review-date)
      PLAN_REVIEW_DATE="${2:-}"
      shift 2
      ;;
    --plan-description)
      PLAN_DESCRIPTION="${2:-}"
      shift 2
      ;;
    --plan-loop-id)
      PLAN_LOOP_ID="${2:-}"
      shift 2
      ;;
    --branch-retention-state)
      PLAN_BRANCH_RETENTION_STATE="${2:-}"
      shift 2
      ;;
    --pr-url)
      PLAN_PR_URL="${2:-}"
      shift 2
      ;;
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    *)
      echo "ERROR: Unknown argument: $1" >&2
      echo "Usage: session-execution-lane-closeout --lane-id <ID> --status <status> [options]" >&2
      exit 2
      ;;
  esac
done

# Validation
if [[ -z "$LANE_ID" ]]; then
  echo "ERROR: --lane-id required" >&2
  exit 2
fi

if [[ -z "$STATUS" ]]; then
  echo "ERROR: --status required" >&2
  exit 2
fi

# Check if lane state file exists
LANE_STATE_FILE="$STATE_ROOT/${LANE_ID}.yaml"
if [[ ! -f "$LANE_STATE_FILE" ]]; then
  echo "ERROR: Lane state file not found: $LANE_STATE_FILE" >&2
  echo "Lane ID may be invalid or already closed" >&2
  exit 1
fi

# Read current lane state
LANE_TYPE=$(yq e '.type' "$LANE_STATE_FILE" 2>/dev/null || echo "")
CURRENT_STATUS=$(yq e '.status' "$LANE_STATE_FILE" 2>/dev/null || echo "active")
BRANCH=$(yq e '.branch' "$LANE_STATE_FILE" 2>/dev/null || echo "")
WORKTREE_PATH=$(yq e '.worktree_path' "$LANE_STATE_FILE" 2>/dev/null || echo "")
PARENT_LOOP=$(yq e '.parent_loop // ""' "$LANE_STATE_FILE" 2>/dev/null || echo "")
CREATED_BY=$(yq e '.created_by // "@ronny"' "$LANE_STATE_FILE" 2>/dev/null || echo "@ronny")

if [[ -z "$LANE_TYPE" ]]; then
  echo "ERROR: Could not read lane type from state file" >&2
  exit 1
fi

# Check if already closed
if [[ "$CURRENT_STATUS" != "active" ]]; then
  echo "ERROR: Lane $LANE_ID is already closed (status: $CURRENT_STATUS)" >&2
  exit 1
fi

# Validate status is allowed for this lane type
ALLOWED_STATUSES=$(yq e ".lane_types.${LANE_TYPE}.closeout_options | join(\",\")" "$CONTRACT_FILE" 2>/dev/null || echo "")
if [[ ! ",$ALLOWED_STATUSES," =~ ,"$STATUS", ]]; then
  echo "ERROR: Status '$STATUS' not allowed for $LANE_TYPE lane" >&2
  echo "Allowed: $ALLOWED_STATUSES" >&2
  exit 1
fi

# Check if reason is required
REASON_REQUIRED=$(yq e ".closeout_requirements.${LANE_TYPE}.reason_required // false" "$CONTRACT_FILE" 2>/dev/null)
if [[ "$REASON_REQUIRED" == "true" ]] && [[ -z "$REASON" ]]; then
  echo "ERROR: --reason required for $LANE_TYPE lane closeout" >&2
  exit 1
fi

if [[ "$STATUS" == "deferred" ]]; then
  if [[ -z "$BRANCH" || "$BRANCH" == "null" ]]; then
    echo "ERROR: deferred closeout requires branch metadata in lane state" >&2
    exit 1
  fi
  branch_token="$(normalize_branch_token "$BRANCH")"
  [[ -n "$branch_token" ]] || {
    echo "ERROR: could not derive deferred plan token from branch '$BRANCH'" >&2
    exit 1
  }

  [[ -n "$PLAN_ID" ]] || PLAN_ID="PLAN-${branch_token}"
  [[ -n "$PLAN_REVIEW_DATE" ]] || PLAN_REVIEW_DATE="$(default_review_date)"
  [[ -n "$PLAN_DESCRIPTION" ]] || PLAN_DESCRIPTION="Deferred lane closeout preserved branch ${BRANCH} from ${LANE_ID}; future work must resume from governed plan memory, not branch-only memory."
  [[ -n "$PLAN_BRANCH_RETENTION_STATE" ]] || PLAN_BRANCH_RETENTION_STATE="keep"

  if [[ -z "$PLAN_LOOP_ID" ]]; then
    create_output="$("$LOOPS_CREATE_BIN" \
      --name "$branch_token" \
      --objective "Governed deferred branch memory for ${BRANCH} after lane ${LANE_ID} closeout." \
      --priority medium \
      --horizon later \
      --readiness blocked \
      --execution-mode single_worker \
      --json)"
    PLAN_LOOP_ID="$(printf '%s' "$create_output" | python3 -c 'import json,sys; print(json.load(sys.stdin)["loop_id"])')"
    PLAN_SCOPE_FILE="$(printf '%s' "$create_output" | python3 -c 'import json,sys; print(json.load(sys.stdin)["scope_file"])')"
  else
    [[ "$PLAN_LOOP_ID" =~ ^LOOP-[A-Z0-9-]+$ ]] || fail "invalid --plan-loop-id: $PLAN_LOOP_ID"
    PLAN_SCOPE_FILE="$SPINE_STATE/loop-scopes/${PLAN_LOOP_ID}.scope.md"
    [[ -f "$PLAN_SCOPE_FILE" ]] || fail "--plan-loop-id does not resolve to a real scope file: $PLAN_SCOPE_FILE"
  fi

  [[ -n "${PLAN_SCOPE_FILE:-}" ]] || PLAN_SCOPE_FILE="$SPINE_STATE/loop-scopes/${PLAN_LOOP_ID}.scope.md"

  PLAN_INDEX="$SPINE_STATE/plans/index.yaml"
  PLAN_EXISTS=0
  if [[ -f "$PLAN_INDEX" ]] && yq e -e ".plans[]? | select(.plan_id == \"$PLAN_ID\") | .plan_id" "$PLAN_INDEX" >/dev/null 2>&1; then
    PLAN_EXISTS=1
  fi

  if [[ "$PLAN_EXISTS" -eq 0 ]]; then
    TRACKING_REF="$(git -C "$ROOT" for-each-ref --format='%(upstream:short)' "refs/heads/${BRANCH}" 2>/dev/null | head -1 || true)"
    plan_cmd=(
      "$PLAN_CREATE_BIN"
      --plan-id "$PLAN_ID"
      --loop-id "$PLAN_LOOP_ID"
      --owner "$CREATED_BY"
      --horizon later
      --review-date "$PLAN_REVIEW_DATE"
      --description "$PLAN_DESCRIPTION"
      --activation-trigger manual
      --branch-ref "$BRANCH"
      --worktree-path "$WORKTREE_PATH"
      --branch-retention-state "$PLAN_BRANCH_RETENTION_STATE"
    )
    if [[ -n "$TRACKING_REF" ]]; then
      plan_cmd+=(--tracking-ref "$TRACKING_REF")
    fi
    if [[ -n "$PLAN_PR_URL" ]]; then
      plan_cmd+=(--pr-url "$PLAN_PR_URL")
    fi
    "${plan_cmd[@]}" >/dev/null
  fi
fi

# Update lane state file
yq e -i ".status = \"$STATUS\"" "$LANE_STATE_FILE"
yq e -i ".closed_at = \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" "$LANE_STATE_FILE"
yq e -i ".closed_by = \"session.execution.lane.closeout\"" "$LANE_STATE_FILE"

if [[ -n "$REASON" ]]; then
  yq e -i ".closeout_reason = \"$REASON\"" "$LANE_STATE_FILE"
fi

if [[ -n "$LANDING_COMMIT" ]]; then
  yq e -i ".landing_commit = \"$LANDING_COMMIT\"" "$LANE_STATE_FILE"
fi
if [[ "$STATUS" == "deferred" ]]; then
  yq e -i ".deferred_plan_id = \"$PLAN_ID\"" "$LANE_STATE_FILE"
  yq e -i ".deferred_loop_id = \"$PLAN_LOOP_ID\"" "$LANE_STATE_FILE"
  yq e -i ".deferred_review_date = \"$PLAN_REVIEW_DATE\"" "$LANE_STATE_FILE"
  yq e -i ".branch_retention_state = \"$PLAN_BRANCH_RETENTION_STATE\"" "$LANE_STATE_FILE"
  if [[ -n "${TRACKING_REF:-}" ]]; then
    yq e -i ".branch_tracking_ref = \"$TRACKING_REF\"" "$LANE_STATE_FILE"
  fi
  if [[ -n "$PLAN_PR_URL" ]]; then
    yq e -i ".branch_pr_url = \"$PLAN_PR_URL\"" "$LANE_STATE_FILE"
  fi
fi

# Create closeout receipt
mkdir -p "$RECEIPT_ROOT"
RECEIPT_FILE="$RECEIPT_ROOT/${LANE_ID}-closeout-$(date +%Y%m%d-%H%M%S).yaml"
cat > "$RECEIPT_FILE" <<YAML
lane_id: "$LANE_ID"
lane_type: "$LANE_TYPE"
branch: "$BRANCH"
worktree_path: "$WORKTREE_PATH"
status: "$STATUS"
closed_at: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
closed_by: "session.execution.lane.closeout"
reason: "${REASON:-}"
landing_commit: "${LANDING_COMMIT:-}"
deferred_plan_id: "${PLAN_ID:-}"
deferred_loop_id: "${PLAN_LOOP_ID:-}"
deferred_review_date: "${PLAN_REVIEW_DATE:-}"
branch_retention_state: "${PLAN_BRANCH_RETENTION_STATE:-}"
branch_pr_url: "${PLAN_PR_URL:-}"
YAML

# Log to audit trail
AUDIT_LOG="$STATE_ROOT/audit.log"
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)|closeout|$LANE_ID|$LANE_TYPE|$STATUS|$REASON" >> "$AUDIT_LOG"

# Output
if [[ "$JSON_OUTPUT" == "true" ]]; then
  jq -n \
    --arg lane_id "$LANE_ID" \
    --arg status "$STATUS" \
    --arg receipt "$RECEIPT_FILE" \
    '{
      lane_id: $lane_id,
      status: $status,
      receipt: $receipt
    }'
else
  echo "════════════════════════════════════════════════════════════"
  echo "LANE CLOSED"
  echo "════════════════════════════════════════════════════════════"
  echo "Lane ID:    $LANE_ID"
  echo "Type:       $LANE_TYPE"
  echo "Status:     $STATUS"
  echo "Receipt:    $RECEIPT_FILE"
  echo ""

  if [[ "$STATUS" == "landed" || "$STATUS" == "abandoned" ]]; then
    echo "Safe to delete worktree:"
    echo "  cd ~"
    echo "  git worktree remove '$WORKTREE_PATH'"
    if [[ "$STATUS" == "landed" ]]; then
      echo "  git branch -d '$BRANCH'  # Merged, safe to delete"
    else
      echo "  git branch -D '$BRANCH'  # Force delete (not merged)"
    fi
  elif [[ "$STATUS" == "deferred" ]]; then
    echo "Lane deferred - branch preserved via governed plan memory"
    echo "Deferred plan: $PLAN_ID"
    echo "Deferred loop: $PLAN_LOOP_ID"
    echo "Review date:   $PLAN_REVIEW_DATE"
    echo "To resume: promote the plan/loop first, then re-enter execution"
  fi
  echo "════════════════════════════════════════════════════════════"
fi

exit 0
