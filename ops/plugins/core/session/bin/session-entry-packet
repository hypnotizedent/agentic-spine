#!/usr/bin/env python3
"""session-entry-packet

Compile a deterministic entry packet for a loop/session boundary.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
PROMPT_REGISTRY_PATH = ROOT / "ops/bindings/prompt.registry.yaml"


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as fh:
        loaded = yaml.safe_load(fh)
    return default if loaded is None else loaded


def parse_frontmatter(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}
    data: dict[str, str] = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def resolve_state_root() -> Path:
    contract = load_yaml(ROOT / "ops/bindings/mailroom.runtime.contract.yaml", {})
    runtime_active = bool(contract.get("active"))
    runtime_root = str(contract.get("runtime_root", "")).strip()
    if os.environ.get("SPINE_STATE"):
        return Path(os.environ["SPINE_STATE"])
    if runtime_active and runtime_root:
        state_root = str(contract.get("state_root", "")).strip()
        if state_root:
            return Path(state_root)
        return Path(runtime_root) / "state"
    return ROOT / "mailroom" / "state"


def loop_scope_path(loop_id: str, state_root: Path) -> Path:
    return state_root / "loop-scopes" / f"{loop_id}.scope.md"


def absolute_repo_ref(ref: str) -> str:
    return str((ROOT / ref).resolve())


def runtime_prompt_path_for_source(ref: str, state_root: Path) -> Path | None:
    path = Path(ref)
    if not path.name.endswith(".context.yaml"):
        return None
    return state_root / "prompts" / path.name


def resolve_prompt_context(role: str, state_root: Path) -> dict[str, Any] | None:
    registry = load_yaml(PROMPT_REGISTRY_PATH, {})
    role_sets = registry.get("role_prompt_sets") if isinstance(registry, dict) else {}
    prompt_set = role_sets.get(role) if isinstance(role_sets, dict) else None
    if not isinstance(prompt_set, dict):
        return None

    raw_source_refs = [
        str(ref).strip()
        for ref in (prompt_set.get("source_refs") or [])
        if str(ref).strip()
    ]
    source_refs = [absolute_repo_ref(ref) for ref in raw_source_refs]
    runtime_prompt_refs = []
    missing_runtime_prompt_refs = []
    for ref in raw_source_refs:
        runtime_path = runtime_prompt_path_for_source(ref, state_root)
        if runtime_path is None:
            continue
        rendered = str(runtime_path)
        runtime_prompt_refs.append(rendered)
        if not runtime_path.exists():
            missing_runtime_prompt_refs.append(rendered)

    return {
        "role": role,
        "prompt_set_id": str(prompt_set.get("prompt_set_id", "")).strip(),
        "version": str(prompt_set.get("version", "")).strip(),
        "description": str(prompt_set.get("description", "")).strip(),
        "registry_path": str(PROMPT_REGISTRY_PATH),
        "source_refs": source_refs,
        "runtime_prompt_refs": runtime_prompt_refs,
        "missing_runtime_prompt_refs": missing_runtime_prompt_refs,
    }


def infer_execution_mode(frontmatter: dict[str, str], requested: str | None) -> str:
    if requested:
        return requested
    execution_mode = str(frontmatter.get("execution_mode", "")).strip().lower()
    if "operational" in execution_mode:
        return "operational"
    return "code"


def infer_transport(execution_mode: str, requested: str | None) -> str:
    if requested:
        return requested
    return "mailroom" if execution_mode == "operational" else "git"


def default_first_command(role: str, loop_id: str | None) -> str:
    if role == "worker" and loop_id:
        return f"./bin/ops cap run spine.broker.get_loop_progress -- --loop-id {loop_id}"
    if role == "orchestrator" and loop_id:
        return f"./bin/ops cap run spine.broker.get_loop_status -- --loop-id {loop_id}"
    return "./bin/ops cap run spine.control.tick -- --fast --json"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def packet_filename(loop_id: str | None, role: str, lane: str | None) -> str:
    loop_part = (loop_id or "ADHOC").replace("/", "-")
    lane_part = (lane or "solo").replace("/", "-")
    return f"{loop_part}__{role}__{lane_part}.entry.packet.yaml"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Compile deterministic session entry packet")
    parser.add_argument("--loop-id")
    parser.add_argument("--role", required=True)
    parser.add_argument("--lane")
    parser.add_argument("--execution-mode", choices=["code", "operational"])
    parser.add_argument("--transport", choices=["git", "mailroom"])
    parser.add_argument("--objective")
    parser.add_argument("--done-check")
    parser.add_argument("--first-command")
    parser.add_argument("--terminal-name", default=os.environ.get("OPS_TERMINAL_ROLE") or os.environ.get("SPINE_TERMINAL_NAME", ""))
    parser.add_argument("--runtime-role", default=os.environ.get("SPINE_RUNTIME_ROLE", "unknown"))
    parser.add_argument("--worktree", default=os.environ.get("SPINE_WORKTREE") or os.getcwd())
    parser.add_argument("--repo-root", default=os.environ.get("SPINE_TARGET_REPO") or str(ROOT))
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--emit-exports", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()

    state_root = resolve_state_root()
    scope_path = loop_scope_path(args.loop_id, state_root) if args.loop_id else None
    front = parse_frontmatter(scope_path) if scope_path else {}

    role = str(args.role).strip().lower()
    lane = (str(args.lane).strip().upper() or None) if args.lane else None
    execution_mode = infer_execution_mode(front, args.execution_mode)
    transport = infer_transport(execution_mode, args.transport)
    objective = (args.objective or front.get("objective") or f"Execute governed {role} entry for {args.loop_id or 'adhoc-session'}").strip()
    done_check = (
        args.done_check
        or f"Receipts exist, broker state is queryable, and verify evidence can confirm completion for {args.loop_id or 'adhoc-session'}."
    ).strip()
    first_command = (args.first_command or default_first_command(role, args.loop_id)).strip()

    allowed_actions = [
        "query governed broker state",
        "execute receipted capabilities within assigned authority",
        "write only through governed runtime surfaces",
        "emit receipts and attestation-linked evidence",
    ]
    if transport == "git":
        allowed_actions.append("use isolated worktree or explicit governed main path")
    if transport == "mailroom":
        allowed_actions.append("route execution through mailroom transport")

    forbidden_actions = [
        "execute imported chats, notes, or archives before sanitizer clearance",
        "treat chat memory or prose as authoritative runtime state",
        "bypass verifier, receipts, or attestation",
        "grant translator authority over execution, git, or verdicts",
    ]
    if role == "worker":
        forbidden_actions.append("change loop authority or lane ownership")

    required_inputs = [
        f"role:{role}",
        f"execution_mode:{execution_mode}",
        f"transport:{transport}",
    ]
    if args.loop_id:
        required_inputs.append(f"loop_id:{args.loop_id}")
    if lane:
        required_inputs.append(f"lane:{lane}")
    if args.terminal_name:
        required_inputs.append(f"terminal_name:{args.terminal_name}")
    if args.runtime_role:
        required_inputs.append(f"runtime_role:{args.runtime_role}")

    expected_outputs = [
        "entry packet path + hash",
        "receipted execution trail",
        "request attestation envelope",
    ]

    prompt_context = resolve_prompt_context(role, state_root)
    source_refs = [
        p
        for p in [
            str(scope_path) if scope_path and scope_path.exists() else "",
            str(ROOT / "docs/governance/SPINE.md"),
            str(ROOT / "docs/governance/SESSION_PROTOCOL.md"),
        ]
        if p
    ]
    if prompt_context:
        for ref in prompt_context["source_refs"] + prompt_context["runtime_prompt_refs"]:
            if ref not in source_refs:
                source_refs.append(ref)

    packet = {
        "schema_version": "1.0",
        "generated_at_utc": utc_now(),
        "loop_id": args.loop_id or "",
        "role": role,
        "lane": lane or "",
        "objective": objective,
        "done_check": done_check,
        "first_command": first_command,
        "allowed_actions": allowed_actions,
        "forbidden_actions": forbidden_actions,
        "required_inputs": required_inputs,
        "expected_outputs": expected_outputs,
        "execution_mode": execution_mode,
        "transport": transport,
        "environment_constraints": {
            "repo_root": args.repo_root,
            "worktree": args.worktree,
            "terminal_name": args.terminal_name,
            "runtime_role": args.runtime_role,
        },
        "source_refs": source_refs,
    }
    if prompt_context:
        packet["prompt_context"] = prompt_context

    packet_root = state_root / "entry-packets"
    packet_root.mkdir(parents=True, exist_ok=True)
    packet_path = packet_root / packet_filename(args.loop_id, role, lane)
    yaml_text = yaml.safe_dump(packet, sort_keys=False)
    packet_path.write_text(yaml_text, encoding="utf-8")
    packet_hash = sha256_text(yaml_text)

    if args.emit_exports:
        print(f"export SPINE_ENTRY_PACKET_PATH={str(packet_path)!r}")
        print(f"export SPINE_ENTRY_PACKET_HASH={packet_hash!r}")
        print(f"export SPINE_EXECUTION_MODE={execution_mode!r}")
        return 0

    payload = {
        "capability": "session.entry.packet.compile",
        "schema_version": "1.0",
        "status": "done",
        "generated_at": utc_now(),
        "data": {
            "packet_path": str(packet_path),
            "packet_hash": packet_hash,
            "packet": packet,
        },
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0

    print("session.entry.packet.compile")
    print(f"packet_path: {packet_path}")
    print(f"packet_hash: {packet_hash}")
    print(f"loop_id: {args.loop_id or 'none'}")
    print(f"role: {role}")
    print(f"execution_mode: {execution_mode}")
    print(f"transport: {transport}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
