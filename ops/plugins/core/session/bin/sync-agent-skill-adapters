#!/usr/bin/env bash
# sync-agent-skill-adapters — sync repo-owned skill adapters to tool-native install targets
#
# Syncs:
#   repo .claude/skills/claude-ai-skill/SKILL.md  (in-repo, just verified)
#   repo ops/plugins/core/session/codex-adapter/SKILL.md -> ~/.codex/skills/ronny-interpreter/SKILL.md
#
# Safe to run repeatedly. Does not delete anything outside intended targets.

set -euo pipefail

SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "$0")/../../../../.." && pwd)}"

# --- Sources ---
CLAUDE_ADAPTER_SRC="${SPINE_ROOT}/.claude/skills/claude-ai-skill/SKILL.md"
CODEX_ADAPTER_SRC="${SPINE_ROOT}/ops/plugins/core/session/codex-adapter/SKILL.md"

# --- Targets ---
CLAUDE_ADAPTER_DST="${SPINE_ROOT}/.claude/skills/claude-ai-skill/SKILL.md"
CODEX_ADAPTER_DST="${HOME}/.codex/skills/ronny-interpreter/SKILL.md"

# --- Shared core (for verification only) ---
SHARED_CORE="${SPINE_ROOT}/docs/governance/RONNY_SESSION_SKILL_CORE.md"

echo "=== sync-agent-skill-adapters ==="
echo ""

# Verify shared core exists
if [[ ! -f "$SHARED_CORE" ]]; then
  echo "ERROR: shared skill core not found at: $SHARED_CORE"
  exit 1
fi
echo "[ok] shared core exists: $SHARED_CORE"

# Verify Claude adapter (in-repo, no copy needed — just verify it exists and references core)
if [[ ! -f "$CLAUDE_ADAPTER_SRC" ]]; then
  echo "ERROR: Claude adapter not found at: $CLAUDE_ADAPTER_SRC"
  exit 1
fi
if grep -q "RONNY_SESSION_SKILL_CORE" "$CLAUDE_ADAPTER_SRC"; then
  echo "[ok] Claude adapter references shared core: $CLAUDE_ADAPTER_SRC"
else
  echo "WARN: Claude adapter does not reference RONNY_SESSION_SKILL_CORE: $CLAUDE_ADAPTER_SRC"
fi

# Sync Codex adapter from repo-owned source to local install target
if [[ ! -f "$CODEX_ADAPTER_SRC" ]]; then
  echo "ERROR: Codex adapter source not found at: $CODEX_ADAPTER_SRC"
  exit 1
fi
if ! grep -q "RONNY_SESSION_SKILL_CORE" "$CODEX_ADAPTER_SRC"; then
  echo "WARN: Codex adapter source does not reference RONNY_SESSION_SKILL_CORE: $CODEX_ADAPTER_SRC"
fi

mkdir -p "$(dirname "$CODEX_ADAPTER_DST")"
cp "$CODEX_ADAPTER_SRC" "$CODEX_ADAPTER_DST"
echo "[ok] Codex adapter synced: $CODEX_ADAPTER_SRC -> $CODEX_ADAPTER_DST"

echo ""
echo "=== Summary ==="
echo "  shared core:       $SHARED_CORE"
echo "  claude adapter:    $CLAUDE_ADAPTER_SRC (in-repo, verified)"
echo "  codex source:      $CODEX_ADAPTER_SRC"
echo "  codex install:     $CODEX_ADAPTER_DST (synced)"
echo ""
echo "Done."
