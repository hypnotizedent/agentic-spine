#!/usr/bin/env bash
set -euo pipefail

# session-start — Initialize a governed spine terminal session
#
# Usage:
#   session-start                     # fast startup summary (default)
#   session-start full               # deep startup diagnostics
#   session-start degraded           # reduced continuity packet when full startup is not needed
#   session-start <lane>             # lane wiring: scan | apply | coordinator
#
# Creates:
#   - SPINE_SESSION_ID env var
#   - Session state dir: mailroom/state/sessions/<id>/
#   - Session manifest: <id>/session.yaml
#   - Bootstrap log: <id>/bootstrap.log
#   - Commands log hook (preexec)
#
# Multi-agent awareness:
#   - Prunes stale sessions (dead PID + age > TTL)
#   - Counts active peer sessions
#   - Exports SPINE_ACTIVE_SESSION_COUNT and SPINE_MULTI_AGENT
#
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
# Resolve operator timezone from tenant profile SSOT (scheduling/display only; timestamps stay UTC)
SPINE_OPERATOR_TZ="$(yq -r '.runtime.timezone // "America/New_York"' "$ROOT/ops/bindings/tenant.profile.yaml" 2>/dev/null || echo "America/New_York")"
export SPINE_OPERATOR_TZ
TERMINAL_LAUNCHER_VIEW="$ROOT/ops/bindings/terminal.launcher.view.yaml"
TERMINAL_ROLE_CONTRACT="$ROOT/ops/bindings/terminal.role.contract.yaml"
ROLE_RUNTIME_CONTRACT="$ROOT/ops/bindings/role.runtime.control.contract.yaml"
MEMORY_CONTINUITY_CONTRACT="$ROOT/ops/bindings/memory.continuity.contract.yaml"
SESSIONS_DIR="$SPINE_STATE/sessions"
ARCHIVE_DIR="$SESSIONS_DIR/.archive"
SESSION_TTL=${SPINE_SESSION_TTL:-14400}  # 4 hours default

parse_epoch_utc() {
  local ts="${1:-}"
  [[ -n "$ts" ]] || { echo 0; return; }

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$ts" <<'PY'
import sys
from datetime import datetime, timezone

ts = (sys.argv[1] or "").strip()
if not ts:
    print(0)
    raise SystemExit(0)

if ts.endswith("Z"):
    ts = ts[:-1] + "+00:00"

try:
    dt = datetime.fromisoformat(ts)
except Exception:
    print(0)
    raise SystemExit(0)

if dt.tzinfo is None:
    dt = dt.replace(tzinfo=timezone.utc)

print(int(dt.timestamp()))
PY
    return
  fi

  if date --version >/dev/null 2>&1; then
    date -d "$ts" "+%s" 2>/dev/null || echo 0
    return
  fi

  local clean_ts="${ts%%Z*}"
  clean_ts="${clean_ts%%+*}"
  date -j -f "%Y-%m-%dT%H:%M:%S" "$clean_ts" "+%s" 2>/dev/null || echo 0
}

resolve_terminal_context() {
  local terminal_id label runtime_role role_type
  terminal_id="${OPS_TERMINAL_ROLE:-${SPINE_TERMINAL_ROLE:-${SPINE_TERMINAL_NAME:-${SPINE_TERMINAL_ID:-}}}}"
  label="${SPINE_TERMINAL_LABEL:-}"
  runtime_role="${SPINE_RUNTIME_ROLE:-}"

  if [[ -n "$terminal_id" && -z "$label" && -f "$TERMINAL_LAUNCHER_VIEW" ]] && command -v yq >/dev/null 2>&1; then
    label="$(yq e -r ".terminals.\"${terminal_id}\".label // \"\"" "$TERMINAL_LAUNCHER_VIEW" 2>/dev/null || true)"
  fi
  if [[ -z "$label" ]]; then
    label="$terminal_id"
  fi
  if [[ -z "$label" ]]; then
    label="Spine Session"
  fi

  if [[ -z "$runtime_role" && -n "$terminal_id" && -f "$TERMINAL_ROLE_CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
    runtime_role="$(yq e -r ".runtime_role_defaults.by_terminal_id.\"${terminal_id}\" // \"\"" "$TERMINAL_ROLE_CONTRACT" 2>/dev/null || true)"
    if [[ -z "$runtime_role" || "$runtime_role" == "null" ]]; then
      role_type="$(yq e -r ".roles[]? | select(.id == \"${terminal_id}\") | .type" "$TERMINAL_ROLE_CONTRACT" 2>/dev/null | head -n1 || true)"
      if [[ -n "$role_type" && "$role_type" != "null" ]]; then
        runtime_role="$(yq e -r ".runtime_role_defaults.by_terminal_type.\"${role_type}\" // \"\"" "$TERMINAL_ROLE_CONTRACT" 2>/dev/null || true)"
      fi
    fi
  fi
  if [[ -z "$runtime_role" || "$runtime_role" == "null" ]] && [[ -f "$ROLE_RUNTIME_CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
    runtime_role="$(yq e -r '.runtime_roles.default_role // ""' "$ROLE_RUNTIME_CONTRACT" 2>/dev/null || true)"
  fi
  if [[ -z "$runtime_role" || "$runtime_role" == "null" ]]; then
    runtime_role="researcher"
  fi

  printf '%s|%s|%s' "$terminal_id" "$label" "$runtime_role"
}

emit_terminal_title_contract() {
  local ctx terminal_id label runtime_role terminal_title
  ctx="$(resolve_terminal_context)"
  terminal_id="${ctx%%|*}"
  ctx="${ctx#*|}"
  label="${ctx%%|*}"
  runtime_role="${ctx#*|}"
  terminal_title="${label} [${runtime_role}]"

  export SPINE_TERMINAL_NAME="${SPINE_TERMINAL_NAME:-$terminal_id}"
  export OPS_TERMINAL_ROLE="${OPS_TERMINAL_ROLE:-$terminal_id}"
  export SPINE_TERMINAL_LABEL="${SPINE_TERMINAL_LABEL:-$label}"
  export SPINE_RUNTIME_ROLE="${SPINE_RUNTIME_ROLE:-$runtime_role}"
  export SPINE_TERMINAL_TITLE="$terminal_title"

  # OSC title sequence; safe no-op on terminals that do not support title updates.
  printf '\033]0;%s\007' "$terminal_title" >&2 || true
  echo "terminal_title: $terminal_title"
}

usage() {
  cat <<'EOF'
Usage:
  session-start [--mode fast|full|degraded] [--strict] [--json]
                [--allow-dirty --dirty-reason "<reason>"]
                [--allow-main-divergence --main-divergence-reason "<reason>"]
  session-start <lane>
                [--allow-dirty --dirty-reason "<reason>"]
                [--allow-main-divergence --main-divergence-reason "<reason>"]

Lanes:
  scan | apply | coordinator

Notes:
  - No args defaults to fast startup mode.
  - full mode runs status + stability snapshot + core verify.
  - degraded mode preserves boring-root + parity + managed-worktree guards, then emits continuity fallbacks and runtime state hints.
  - startup attempts bounded boring-root auto-heal before enforcing dirty/parity guards.
  - startup blocks dirty checkouts and clean-but-diverged main checkouts by default.
EOF
  exit 1
}

read_memory_contract_list() {
  local query="$1"
  shift || true
  local default_lines=("$@")

  if [[ -f "$MEMORY_CONTINUITY_CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
    local out=""
    out="$(yq e -r "$query" "$MEMORY_CONTINUITY_CONTRACT" 2>/dev/null || true)"
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      return 0
    fi
  fi

  printf '%s\n' "${default_lines[@]}"
}

read_memory_contract_scalar() {
  local query="$1"
  local default_value="${2:-}"

  if [[ -f "$MEMORY_CONTINUITY_CONTRACT" ]] && command -v yq >/dev/null 2>&1; then
    local out=""
    out="$(yq e -r "$query // \"\"" "$MEMORY_CONTINUITY_CONTRACT" 2>/dev/null || true)"
    if [[ -n "$out" && "$out" != "null" ]]; then
      printf '%s\n' "$out"
      return 0
    fi
  fi

  printf '%s\n' "$default_value"
}

build_active_handoff_hint() {
  if [[ -x "$ROOT/ops/plugins/core/handoff/bin/session-handoff-list" ]]; then
    local active_count
    active_count="$("$ROOT/ops/plugins/core/handoff/bin/session-handoff-list" --state active --json 2>/dev/null | jq -r '.handoffs | length // 0' 2>/dev/null || echo 0)"
    if [[ "$active_count" =~ ^[0-9]+$ ]] && (( active_count > 0 )); then
      printf '%s\n' "$active_count active handoff(s) — run: ./bin/ops cap run session.handoff.list --state active"
      return 0
    fi
  fi
  printf '%s\n' ""
}

build_operator_storage_surface_hint() {
  local status_bin="${SPINE_OPERATOR_STORAGE_SURFACE_STATUS_BIN:-$ROOT/ops/plugins/infra/host/bin/operator-storage-surface-status}"
  [[ -x "$status_bin" ]] || return 0

  local hint=""
  hint="$(SPINE_TARGET_REPO="$SPINE_TARGET_REPO" SPINE_REPO="$SPINE_REPO" SPINE_CODE="$SPINE_CODE" SPINE_OPERATOR_STORAGE_SURFACE_STATUS_TIMEOUT_SECONDS="${SPINE_OPERATOR_STORAGE_SURFACE_STATUS_TIMEOUT_SECONDS:-3}" python3 - "$status_bin" <<'PY' 2>/dev/null || true
import os
import subprocess
import sys

status_bin = sys.argv[1]
timeout_seconds = float(os.environ.get("SPINE_OPERATOR_STORAGE_SURFACE_STATUS_TIMEOUT_SECONDS", "3"))
env = os.environ.copy()
result = subprocess.run(
    [status_bin, "--brief"],
    capture_output=True,
    text=True,
    env=env,
    timeout=timeout_seconds,
    check=False,
)
if result.stdout:
    sys.stdout.write(result.stdout.strip())
PY
)"
  [[ -n "$hint" ]] || return 0
  printf '%s\n' "$hint"
}

run_startup_checkout_guards() {
  local allow_dirty="${1:-false}"
  local dirty_reason="${2:-}"
  local allow_main_divergence="${3:-false}"
  local main_divergence_reason="${4:-}"

  local dirty_guard_args=()
  if [[ "$allow_dirty" == "true" ]]; then
    dirty_guard_args+=(--allow-dirty)
    if [[ -n "$dirty_reason" ]]; then
      dirty_guard_args+=(--dirty-reason "$dirty_reason")
    fi
  fi

  "$ROOT/ops/plugins/core/session/bin/session-start-dirty-guard" "${dirty_guard_args[@]}" || {
    echo "session.start FAIL: dirty working directory blocked" >&2
    return 1
  }

  local main_parity_guard_args=()
  if [[ "$allow_main_divergence" == "true" ]]; then
    main_parity_guard_args+=(--allow-main-divergence)
    if [[ -n "$main_divergence_reason" ]]; then
      main_parity_guard_args+=(--main-divergence-reason "$main_divergence_reason")
    fi
  fi

  "$ROOT/ops/plugins/core/session/bin/session-start-main-parity-guard" "${main_parity_guard_args[@]}" || {
    echo "session.start FAIL: main checkout diverged from origin/main" >&2
    return 1
  }
}

run_root_boring_reconcile() {
  local trigger="${1:-session.start}"
  local normalize_bin="${SPINE_ROOT_BORING_RECONCILE_BIN:-$ROOT/ops/plugins/core/ops/bin/worktree-lifecycle-root-normalize}"

  [[ -x "$normalize_bin" ]] || return 0

  local normalize_out=""
  if ! normalize_out="$(SPINE_TARGET_REPO="$SPINE_TARGET_REPO" SPINE_REPO="$SPINE_REPO" SPINE_CODE="$SPINE_CODE" "$normalize_bin" --trigger "$trigger" --brief 2>&1)"; then
    [[ -n "$normalize_out" ]] && printf '%s\n' "$normalize_out" >&2
    echo "session.start FAIL: root boring reconcile blocked" >&2
    return 1
  fi
}

run_managed_worktree_sync() {
  local trigger="${1:-session.start}"
  local sync_bin="${SPINE_MANAGED_WORKTREE_SYNC_BIN:-$ROOT/ops/plugins/core/ops/bin/worktree-lifecycle-managed-sync}"

  [[ -x "$sync_bin" ]] || return 0

  local sync_out=""
  if ! sync_out="$(SPINE_TARGET_REPO="$SPINE_TARGET_REPO" SPINE_REPO="$SPINE_REPO" SPINE_CODE="$SPINE_CODE" "$sync_bin" --trigger "$trigger" --brief 2>&1)"; then
    [[ -n "$sync_out" ]] && printf '%s\n' "$sync_out" >&2
    echo "session.start FAIL: managed worktree sync blocked" >&2
    return 1
  fi
}

run_fast_startup() {
  local mode="fast"
  local strict=0
  local json_mode=0
  local allow_dirty=false
  local dirty_reason=""
  local allow_main_divergence=false
  local main_divergence_reason=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        ;;
      --mode)
        mode="${2:-}"
        shift 2
        ;;
      --strict)
        strict=1
        shift
        ;;
      --json)
        json_mode=1
        shift
        ;;
      --allow-dirty)
        allow_dirty=true
        shift
        ;;
      --dirty-reason)
        dirty_reason="${2:-}"
        shift 2
        ;;
      --allow-main-divergence)
        allow_main_divergence=true
        shift
        ;;
      --main-divergence-reason)
        main_divergence_reason="${2:-}"
        shift 2
        ;;
      fast|full|degraded)
        mode="$1"
        shift
        ;;
      -h|--help)
        usage
        ;;
      *)
        echo "session.start FAIL: unknown arg: $1" >&2
        return 2
        ;;
    esac
  done

  case "$mode" in
    fast|full|degraded) ;;
    *)
      echo "session.start FAIL: --mode must be fast|full|degraded" >&2
      return 2
      ;;
  esac

  run_root_boring_reconcile "session.start.${mode}" || return 1

  # Run startup checkout guards before bootstrapping the session.
  run_startup_checkout_guards \
    "$allow_dirty" \
    "$dirty_reason" \
    "$allow_main_divergence" \
    "$main_divergence_reason" || return 1

  run_managed_worktree_sync "session.start.${mode}" || return 1

  if [[ "$mode" == "fast" || "$mode" == "degraded" ]]; then
    local status_brief
    local hardware_brief=""
    local recommend_output=""
    local recommend_domains="core"
    local recommend_cmd="./bin/ops cap run verify.core.run"
    local recommended_first_domain="core"
    local receipt_memory_domain="none"
    local receipt_memory_hint="./bin/ops cap run receipts.summary -- --domain none --days 7"
    status_brief="$("$ROOT/bin/ops" status --brief 2>&1 || true)"
    if [[ "$mode" == "fast" ]] && [[ -x "$ROOT/ops/plugins/infra/bin/infra-media-capacity-guard-reconcile" ]]; then
      hardware_brief="$("$ROOT/ops/plugins/infra/bin/infra-media-capacity-guard-reconcile" --brief 2>/dev/null || true)"
    fi
    if [[ -z "$hardware_brief" ]]; then
      hardware_brief="HW: UNKNOWN (media capacity brief unavailable)"
    fi

    if [[ "$mode" == "fast" ]] && [[ -x "$ROOT/ops/plugins/core/verify/bin/verify-topology" ]]; then
      recommend_output="$("$ROOT/ops/plugins/core/verify/bin/verify-topology" recommend --json 2>/dev/null || true)"
      if [[ -n "$recommend_output" ]] && jq -e '.' >/dev/null 2>&1 <<< "$recommend_output"; then
        recommend_domains="$(jq -r '.recommended_domains | join(",")' <<< "$recommend_output" 2>/dev/null || echo core)"
        recommend_cmd="$(jq -r '
          (.recommended_domains // ["core"]) as $domains
          | if ($domains | length) == 0 or $domains[0] == "core" then
              "./bin/ops cap run verify.core.run"
            else
              "./bin/ops cap run verify.pack.run " + $domains[0]
            end
        ' <<< "$recommend_output" 2>/dev/null || echo "./bin/ops cap run verify.core.run")"
      fi
    fi

    recommended_first_domain="${recommend_domains%%,*}"
    recommended_first_domain="${recommended_first_domain//[[:space:]]/}"
    [[ -n "$recommended_first_domain" ]] || recommended_first_domain="core"
    if [[ "$recommended_first_domain" == "core" || "$recommended_first_domain" == "none" ]]; then
      receipt_memory_domain="none"
    else
      receipt_memory_domain="$recommended_first_domain"
    fi
    receipt_memory_hint="./bin/ops cap run receipts.summary -- --domain ${receipt_memory_domain} --days 7"

    # Check for active handoffs from prior sessions
    local active_handoff_hint=""
    local operator_storage_surface_hint=""
    active_handoff_hint="$(build_active_handoff_hint)"
    operator_storage_surface_hint="$(build_operator_storage_surface_hint)"

    if [[ "$mode" == "degraded" ]]; then
      local continuity_policy=""
      local primary_layer=""
      local fallback_layers=()
      local startup_hints=()
      local line=""

      continuity_policy="$(read_memory_contract_scalar '.degraded_mode.policy' 'continue_with_explicit_fallback_chain')"
      primary_layer="$(read_memory_contract_scalar '.primary_layer.id' 'anythingllm')"

      while IFS= read -r line; do
        [[ -n "$line" ]] && fallback_layers+=("$line")
      done < <(read_memory_contract_list '.fallback_layers[].id' 'spine_rag_mcp' 'receipts_summary' 'active_handoffs' 'loop_gap_runtime' 'direct_file_truth' 'rg_search')

      while IFS= read -r line; do
        [[ -n "$line" ]] && startup_hints+=("$line")
      done < <(read_memory_contract_list '.degraded_mode.required_startup_hints[]' \
        './bin/ops cap run session.handoff.list --state active' \
        './bin/ops cap run receipts.summary -- --domain none --days 7' \
        './bin/ops cap run loops.status' \
        './bin/ops cap run gaps.status')

      if [[ "$json_mode" -eq 1 ]]; then
        local fallback_json hints_json
        fallback_json="$(printf '%s\n' "${fallback_layers[@]}" | jq -R . | jq -s .)"
        hints_json="$(printf '%s\n' "${startup_hints[@]}" | jq -R . | jq -s .)"
        jq -n \
          --arg capability "session.start" \
          --arg mode "degraded" \
          --arg status_brief "$status_brief" \
          --arg continuity_policy "$continuity_policy" \
          --arg primary_layer "$primary_layer" \
          --arg runtime_state_root "$SPINE_STATE" \
          --arg logical_state_path "mailroom/state" \
          --arg active_handoff_hint "$active_handoff_hint" \
          --arg operator_storage_surface_hint "$operator_storage_surface_hint" \
          --argjson fallback_layers "$fallback_json" \
          --argjson startup_hints "$hints_json" \
          '{
            capability: $capability,
            mode: $mode,
            status_brief: $status_brief,
            continuity_policy: $continuity_policy,
            primary_memory_layer: $primary_layer,
            fallback_layers: $fallback_layers,
            startup_hints: $startup_hints,
            logical_state_path: $logical_state_path,
            runtime_state_root: $runtime_state_root,
            note: "degraded bootstrap complete; prefer fallback continuity surfaces until fast startup is healthy"
          }
          + (if $active_handoff_hint != "" then {active_handoff_hint: $active_handoff_hint} else {} end)
          + (if $operator_storage_surface_hint != "" then {operator_storage_surface_hint: $operator_storage_surface_hint} else {} end)'
      else
        echo "session.start"
        echo "mode: degraded"
        echo "status: ${status_brief}"
        echo "continuity_policy: ${continuity_policy}"
        echo "primary_memory_layer: ${primary_layer}"
        echo "logical_state_path: mailroom/state"
        echo "runtime_state_root: ${SPINE_STATE}"
        if [[ -n "$active_handoff_hint" ]]; then
          echo "active_handoff: ${active_handoff_hint}"
        fi
        if [[ -n "$operator_storage_surface_hint" ]]; then
          echo "operator_storage_surfaces: ${operator_storage_surface_hint}"
        fi
        echo "fallback_layers: $(IFS=,; echo "${fallback_layers[*]}")"
        echo "startup_hints:"
        for line in "${startup_hints[@]}"; do
          echo "  - ${line}"
        done
        echo "note: degraded bootstrap complete; prefer fallback continuity surfaces until fast startup is healthy"
      fi
      return 0
    fi

    if [[ "$json_mode" -eq 1 ]]; then
      jq -n \
        --arg capability "session.start" \
        --arg mode "fast" \
        --arg status_brief "$status_brief" \
        --arg hardware_brief "$hardware_brief" \
        --arg recommended_domains "$recommend_domains" \
        --arg recommended_verify_command "$recommend_cmd" \
        --arg receipt_memory_hint "$receipt_memory_hint" \
        --arg active_handoff_hint "$active_handoff_hint" \
        --arg operator_storage_surface_hint "$operator_storage_surface_hint" \
        '{
          capability: $capability,
          mode: $mode,
          status_brief: $status_brief,
          hardware_brief: $hardware_brief,
          recommended_domains: ($recommended_domains | split(",") | map(select(length > 0))),
          recommended_verify_command: $recommended_verify_command,
          receipt_memory_hint_command: $receipt_memory_hint,
          note: "fast lane complete; run recommended verify after domain edits"
        }
        + (if $active_handoff_hint != "" then {active_handoff_hint: $active_handoff_hint} else {} end)
        + (if $operator_storage_surface_hint != "" then {operator_storage_surface_hint: $operator_storage_surface_hint} else {} end)'
    else
      echo "session.start"
      echo "mode: fast"
      echo "status: ${status_brief}"
      echo "hardware_brief: ${hardware_brief}"
      echo "recommended_domains: ${recommend_domains}"
      echo "post_work_verify: ${recommend_cmd}"
      echo "receipt_memory_hint: ${receipt_memory_hint}"
      if [[ -n "$active_handoff_hint" ]]; then
        echo "active_handoff: ${active_handoff_hint}"
      fi
      if [[ -n "$operator_storage_surface_hint" ]]; then
        echo "operator_storage_surfaces: ${operator_storage_surface_hint}"
      fi
      echo "note: fast lane complete; run recommended verify after domain edits"
    fi
    return 0
  fi

  local status_rc=0
  local snapshot_rc=0
  local core_rc=0

  if [[ "$json_mode" -eq 0 ]]; then
    echo "session.start"
    echo "mode: full"
    echo "running: ./bin/ops status"
  fi
  "$ROOT/bin/ops" status >/dev/null 2>&1 || status_rc=$?

  if [[ "$json_mode" -eq 0 ]]; then
    echo "running: ./bin/ops cap run stability.control.snapshot"
  fi
  "$ROOT/bin/ops" cap run stability.control.snapshot >/dev/null 2>&1 || snapshot_rc=$?

  if [[ "$json_mode" -eq 0 ]]; then
    echo "running: ./bin/ops cap run verify.core.run"
  fi
  "$ROOT/bin/ops" cap run verify.core.run >/dev/null 2>&1 || core_rc=$?

  if [[ "$json_mode" -eq 1 ]]; then
    jq -n \
      --arg capability "session.start" \
      --arg mode "full" \
      --argjson strict "$strict" \
      --argjson status_rc "$status_rc" \
      --argjson snapshot_rc "$snapshot_rc" \
      --argjson core_rc "$core_rc" \
      '{
        capability: $capability,
        mode: $mode,
        strict: ($strict == 1),
        status_rc: $status_rc,
        snapshot_rc: $snapshot_rc,
        core_rc: $core_rc
      }'
  else
    echo "status_rc: $status_rc"
    echo "snapshot_rc: $snapshot_rc"
    echo "core_rc: $core_rc"
  fi

  if [[ "$strict" -eq 1 ]]; then
    (( status_rc == 0 && snapshot_rc == 0 && core_rc == 0 )) || return 1
    return 0
  fi

  (( core_rc == 0 )) || return "$core_rc"
  return 0
}

if [[ $# -eq 0 ]]; then
  run_fast_startup
  exit $?
fi

case "${1:-}" in
  fast|full|degraded|--mode|--strict|--json|--allow-dirty|--dirty-reason|--allow-main-divergence|--main-divergence-reason|-h|--help|--)
    run_fast_startup "$@"
    exit $?
    ;;
esac

LANE="$1"
shift
case "$LANE" in
  scan|apply|coordinator) ;;
  *) echo "ERROR: unknown lane '$LANE'. Use: scan | apply | coordinator"; exit 1 ;;
esac

allow_dirty=false
dirty_reason=""
allow_main_divergence=false
main_divergence_reason=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      ;;
    --allow-dirty)
      allow_dirty=true
      shift
      ;;
    --dirty-reason)
      dirty_reason="${2:-}"
      shift 2
      ;;
    --allow-main-divergence)
      allow_main_divergence=true
      shift
      ;;
    --main-divergence-reason)
      main_divergence_reason="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "session.start FAIL: unknown arg for lane '$LANE': $1" >&2
      exit 2
      ;;
  esac
done

run_root_boring_reconcile "session.start.lane.${LANE}" || exit 1

run_startup_checkout_guards \
  "$allow_dirty" \
  "$dirty_reason" \
  "$allow_main_divergence" \
  "$main_divergence_reason" || exit 1

run_managed_worktree_sync "session.start.lane.${LANE}" || exit 1

# ─── Session pruning + liveness ─────────────────────────────
# Archive stale sessions: PID dead (immediate); also archive TTL-expired sessions.
# Returns active session count via stdout when called as subshell.

prune_and_count_sessions() {
  mkdir -p "$ARCHIVE_DIR"
  local now
  now=$(date +%s)
  local active=0

  for session_dir in "$SESSIONS_DIR"/SES-*/; do
    [[ -d "$session_dir" ]] || continue
    local manifest="$session_dir/session.yaml"
    [[ -f "$manifest" ]] || continue

    # Extract fields with grep (portable, no yq dependency in hooks)
    local pid created
    pid=$(grep '^pid:' "$manifest" | sed 's/^pid: *//' | tr -d '"' || echo "")
    created=$(grep '^created:' "$manifest" | sed 's/^created: *//' | tr -d '"' || echo "")

    # Calculate age
    local epoch=0
    if [[ -n "$created" ]]; then
      epoch=$(parse_epoch_utc "$created")
    fi
    local age=$((now - epoch))

    # Check PID liveness
    local pid_alive=false
    if [[ -n "$pid" && "$pid" != "null" && "$pid" != "" ]]; then
      if kill -0 "$pid" 2>/dev/null; then
        pid_alive=true
      fi
    fi

    # Archive if PID dead (stale session) or far past TTL.
    if [[ "$pid_alive" == "false" ]] || [[ "$age" -gt "$SESSION_TTL" ]]; then
      mv "$session_dir" "$ARCHIVE_DIR/" 2>/dev/null || true
      continue
    fi

    active=$((active + 1))
  done

  echo "$active"
}

# Prune stale sessions and count active peers
ACTIVE_BEFORE=$(prune_and_count_sessions)

# ─── Generate session ───────────────────────────────────────

DATE_PART=$(date +%Y%m%d-%H%M%S)
HASH_PART=$(head -c 4 /dev/urandom | xxd -p | head -c 6)
SESSION_ID="SES-${DATE_PART}-${LANE}-${HASH_PART}"
SESSION_DIR="$SESSIONS_DIR/$SESSION_ID"

mkdir -p "$SESSION_DIR"

# Write session manifest
cat > "$SESSION_DIR/session.yaml" <<YAML
session_id: "$SESSION_ID"
lane: "$LANE"
created: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
terminal: "${TERM_PROGRAM:-unknown}"
user: "$(whoami)"
hostname: "$(hostname -s)"
pid: $$
YAML

# ─── Multi-agent awareness ──────────────────────────────────

# Count includes the session we just created
ACTIVE_COUNT=$((ACTIVE_BEFORE + 1))
MULTI_AGENT=false
if [[ "$ACTIVE_COUNT" -gt 1 ]]; then
  MULTI_AGENT=true
fi

echo "═══════════════════════════════════════════════════════════════"
echo "  SPINE SESSION: $SESSION_ID"
echo "  Lane: $LANE"
echo "  State: $SESSION_DIR/"
echo "═══════════════════════════════════════════════════════════════"

# Multi-agent banner
if [[ "$MULTI_AGENT" == "true" ]]; then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════╗"
  echo "║  MULTI-AGENT MODE ACTIVE ($ACTIVE_COUNT sessions)                  ║"
  echo "║  Proposal flow required; avoid direct commit.            ║"
  echo "║  Use: proposals.submit / proposals.apply                 ║"
  echo "╚═══════════════════════════════════════════════════════════╝"
fi

# Pruning summary
if [[ -d "$ARCHIVE_DIR" ]]; then
  ARCHIVED_COUNT=$(find "$ARCHIVE_DIR" -maxdepth 1 -type d -name 'SES-*' 2>/dev/null | wc -l | tr -d ' ')
  echo ""
  echo "  Sessions: $ACTIVE_COUNT active, $ARCHIVED_COUNT archived"
fi

# Terminal UX contract: stable label + runtime role title without manual prompt hacks.
echo ""
emit_terminal_title_contract

# Bootstrap (P2) — capture all outputs
BOOTSTRAP_LOG="$SESSION_DIR/bootstrap.log"
{
  echo "=== ops status ==="
  "$ROOT/bin/ops" status 2>&1 || true
  echo ""
  echo "=== gaps.status ==="
  bash "$ROOT/ops/plugins/core/loops/bin/gaps-status" 2>&1 || true
  echo ""
} > "$BOOTSTRAP_LOG" 2>&1

# MCP/tooling awareness (P6) — print agent routing summary
echo ""
echo "──────────────────────────────────────────────────────────────"
echo "  Agent Routing"
echo "──────────────────────────────────────────────────────────────"
if command -v yq >/dev/null 2>&1 && [[ -f "$ROOT/ops/bindings/agents.registry.yaml" ]]; then
  AGENTS_FILE="$ROOT/ops/bindings/agents.registry.yaml"
  SHOW_SUPERSEDED="${SPINE_SESSION_SHOW_SUPERSEDED:-0}"
  if [[ "$SHOW_SUPERSEDED" == "1" ]]; then
    ROUTING_FILTER='.agents[] | .id + "|" + .domain + "|" + (.mcp_type // "n/a")'
  else
    ROUTING_FILTER='.agents[] | select((.implementation_status // "active") != "superseded") | .id + "|" + .domain + "|" + (.mcp_type // "n/a")'
  fi
  while IFS='|' read -r agent_id domain mcp_type; do
    printf "  %-24s  domain=%-16s  mcp=%s\n" "$agent_id" "$domain" "$mcp_type"
  done < <(yq e "$ROUTING_FILTER" "$AGENTS_FILE" 2>/dev/null)
  if [[ "$SHOW_SUPERSEDED" != "1" ]]; then
    HIDDEN_SUPERSEDED="$(yq e '.agents | map(select((.implementation_status // "active") == "superseded")) | length' "$AGENTS_FILE" 2>/dev/null || echo "0")"
    if [[ "$HIDDEN_SUPERSEDED" =~ ^[0-9]+$ ]] && (( HIDDEN_SUPERSEDED > 0 )); then
      echo "  (hidden superseded agents: $HIDDEN_SUPERSEDED; set SPINE_SESSION_SHOW_SUPERSEDED=1 to show all)"
    fi
  fi
fi

echo ""
echo "──────────────────────────────────────────────────────────────"
echo "  Capabilities: $(yq e '.capabilities | length' "$ROOT/ops/bindings/capability_map.yaml" 2>/dev/null || echo '?') mapped"
MAX_GATE="$(yq e -r '.gates[].id' "$ROOT/ops/bindings/gate.registry.yaml" 2>/dev/null | sed 's/^D//' | sort -n | tail -1)"
[[ -n "${MAX_GATE:-}" ]] || MAX_GATE="?"
echo "  Drift Gates: D1-D$MAX_GATE ($(ls "$ROOT/surfaces/verify/"d[0-9]*.sh 2>/dev/null | wc -l | tr -d ' ') scripts)"
echo "──────────────────────────────────────────────────────────────"

# Emit env vars for caller to source
ENV_FILE="$SESSION_DIR/env.sh"
cat > "$ENV_FILE" <<SH
export SPINE_SESSION_ID="$SESSION_ID"
export SPINE_LANE="$LANE"
export SPINE_SESSION_DIR="$SESSION_DIR"
export SPINE_ACTIVE_SESSION_COUNT=$ACTIVE_COUNT
export SPINE_MULTI_AGENT=$MULTI_AGENT
export SPINE_OPERATOR_TZ="$SPINE_OPERATOR_TZ"
export SPINE_TERMINAL_NAME="${SPINE_TERMINAL_NAME:-}"
export OPS_TERMINAL_ROLE="${OPS_TERMINAL_ROLE:-}"
export SPINE_TERMINAL_LABEL="${SPINE_TERMINAL_LABEL:-}"
export SPINE_RUNTIME_ROLE="${SPINE_RUNTIME_ROLE:-}"
export SPINE_TERMINAL_TITLE="${SPINE_TERMINAL_TITLE:-}"
SH

echo ""
echo "To activate in your shell:"
echo "  source $ENV_FILE"
echo ""

# Preexec hook snippet (P3)
PREEXEC_FILE="$SESSION_DIR/preexec-hook.zsh"
cat > "$PREEXEC_FILE" <<'ZSH'
# Spine session command telemetry — source this in your zsh session
# Usage: source <session-dir>/preexec-hook.zsh
_spine_preexec() {
  local cmd="$1"
  local log="${SPINE_SESSION_DIR}/commands.log"
  [[ -n "${SPINE_SESSION_DIR:-}" ]] || return
  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(pwd)" "$cmd" >> "$log"
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _spine_preexec
ZSH

echo "For command telemetry:"
echo "  source $PREEXEC_FILE"
