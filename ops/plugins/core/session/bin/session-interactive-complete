#!/usr/bin/env bash
set -euo pipefail

# session-interactive-complete
#
# Records completion for an interactive dispatch, linking the receipt
# (run_key) back to the originating dispatch envelope.
#
# Creates a completion artifact at $SPINE_STATE/dispatch/completion/
# in the same format as mailroom transport completion, so both paths
# produce queryable completion artifacts.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
SPINE_CODE="${SPINE_CODE:-$ROOT}"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

DISPATCH_ID=""
RUN_KEY=""
EVIDENCE_PATH=""
JSON_MODE=0

usage() {
  cat <<'USAGE'
session-interactive-complete

Records completion for an interactive dispatch with receipt linkage.

Usage:
  session-interactive-complete --dispatch-id ENV-... --run-key CAP-...

Required:
  --dispatch-id <ENV-ID>  The dispatch envelope ID
  --run-key <CAP-ID>      The run key from capability execution

Options:
  --evidence-path <path>  Path to receipt/evidence (auto-detected if omitted)
  --json                  Emit JSON output

Example:
  session-interactive-complete \
    --dispatch-id ENV-20260405-201500-a1b2c3d4 \
    --run-key CAP-20260405-201600__gaps.file__Rabc12345
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dispatch-id) DISPATCH_ID="$2"; shift 2 ;;
    --run-key) RUN_KEY="$2"; shift 2 ;;
    --evidence-path) EVIDENCE_PATH="$2"; shift 2 ;;
    --json) JSON_MODE=1; shift ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "ERROR: unknown flag: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -z "$DISPATCH_ID" ]]; then
  echo "ERROR: --dispatch-id is required" >&2
  exit 1
fi
if [[ -z "$RUN_KEY" ]]; then
  echo "ERROR: --run-key is required" >&2
  exit 1
fi

# ── Validate dispatch exists ──
DISPATCH_DIR="$SPINE_STATE/dispatch/interactive"
DISPATCH_FILE="$DISPATCH_DIR/${DISPATCH_ID}.dispatch.yaml"
if [[ ! -f "$DISPATCH_FILE" ]]; then
  echo "ERROR: dispatch not found: $DISPATCH_FILE" >&2
  echo "Available dispatches:" >&2
  ls "$DISPATCH_DIR"/*.dispatch.yaml 2>/dev/null | head -5 >&2 || echo "  (none)" >&2
  exit 1
fi

# ── Auto-detect evidence path from run_key ──
if [[ -z "$EVIDENCE_PATH" ]]; then
  # Convention: receipt at $EVIDENCE/sessions/R<run_key>/receipt.md
  EVIDENCE_BASE="${SPINE_EVIDENCE:-/Users/ronnyworks/code/.evidence/spine}"
  RECEIPT_DIR="$EVIDENCE_BASE/sessions/R${RUN_KEY}"
  if [[ -d "$RECEIPT_DIR" ]]; then
    EVIDENCE_PATH="$RECEIPT_DIR/receipt.md"
  fi
fi

# ── Read dispatch metadata ──
WAVE_ID=""
LOOP_ID=""
if command -v yq >/dev/null 2>&1; then
  WAVE_ID=$(yq e -r '.work_scope.wave_id // ""' "$DISPATCH_FILE" 2>/dev/null || true)
  LOOP_ID=$(yq e -r '.work_scope.loop_id // ""' "$DISPATCH_FILE" 2>/dev/null || true)
fi

# ── Write completion artifact ──
NOW_UTC=$(TZ=UTC date "+%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u "+%Y-%m-%dT%H:%M:%SZ")
COMP_DIR="$SPINE_STATE/dispatch/completion"
mkdir -p "$COMP_DIR"
COMP_FILE="$COMP_DIR/${DISPATCH_ID}.completion.json"

python3 -c "
import json
comp = {
    'envelope_id': '$DISPATCH_ID',
    'completion_status': 'complete',
    'wave_id': '$WAVE_ID',
    'loop_id': '$LOOP_ID',
    'run_key': '$RUN_KEY',
    'evidence_path': '${EVIDENCE_PATH}',
    'completed_at_utc': '$NOW_UTC',
    'transport_mode': 'operator_relay',
}
with open('$COMP_FILE', 'w') as f:
    json.dump(comp, f, indent=2)
    f.write('\n')
print(json.dumps(comp, indent=2))
" > /dev/null

if [[ "$JSON_MODE" -eq 1 ]]; then
  cat "$COMP_FILE"
else
  echo "════════════════════════════════════════"
  echo "INTERACTIVE DISPATCH COMPLETED"
  echo "════════════════════════════════════════"
  echo ""
  echo "Dispatch:   ${DISPATCH_ID}"
  echo "Run Key:    ${RUN_KEY}"
  echo "Completion: ${COMP_FILE}"
  if [[ -n "$EVIDENCE_PATH" && -f "$EVIDENCE_PATH" ]]; then
    echo "Evidence:   ${EVIDENCE_PATH}"
  fi
  if [[ -n "$LOOP_ID" ]]; then
    echo "Loop:       ${LOOP_ID}"
  fi
  echo "Transport:  operator_relay"
  echo "Status:     complete"
  echo ""
  echo "════════════════════════════════════════"
fi
