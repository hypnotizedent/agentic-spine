#!/usr/bin/env bash
# wave-execute - Governed wave dispatch with authority binding
#
# Wraps wave.sh with pre-flight authority validation, loop/gap context
# binding in every dispatch, receipt validation, and wave-finish preparation.
#
# Part of the authority.resolve -> wave.execute -> wave.finish triad.
# When close is given a disposition, this surface drives wave.finish automatically
# unless --no-finish is supplied.
#
# Subcommands:
#   start    --loop-id LOOP-... [--wave-id WAVE-...] [--objective "..."] [wave.sh start flags...]
#   dispatch --wave-id WAVE-... --lane <lane> --task "desc" [--gap-ids GAP-OP-1234,GAP-OP-1235]
#   collect  --wave-id WAVE-...
#   close    --wave-id WAVE-... [--disposition landed|deferred] [--completion-level slice|loop|domain|estate] [--fixed-in <sha>] [--verify-receipt <path>] [--controller-only] [--skip-residue-check] [--no-finish]
#   status   --wave-id WAVE-...
#   land     --wave-id WAVE-... --files "path1,path2,..." --summary "description" [--dry-run]
#
# Exit codes:
#   0 — success
#   1 — blocked / failed
#   2 — invalid args
set -euo pipefail

# ── Path bootstrap ───────────────────────────────────────────────
SP="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$SP/ops/lib/spine-paths.sh" || { echo "FATAL: spine-paths.sh not found" >&2; exit 1; }
spine_paths_init

RUNTIME_ROOT="$SPINE_RUNTIME_ROOT"
WAVES_DIR="$RUNTIME_ROOT/waves"
WAVE_SH="$SP/ops/commands/wave.sh"
CAP_SH="$SP/ops/commands/cap.sh"
AUTHORITY_RESOLVE="$SP/ops/plugins/core/orchestration/bin/authority-resolve"
WAVE_FINISH="$SP/ops/plugins/core/orchestration/bin/wave-finish"
WORKTREE_REHYDRATE="$SP/ops/plugins/core/lifecycle/bin/worktree-lifecycle-rehydrate"
WORKTREE_LIFECYCLE_CONTRACT="$SP/ops/bindings/worktree.lifecycle.contract.yaml"

mkdir -p "$WAVES_DIR"

# ── Usage ────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
wave-execute - Governed wave dispatch with authority binding

Usage:
  wave-execute start    --loop-id LOOP-... [--wave-id WAVE-...] [--objective "..."]
  wave-execute dispatch --wave-id WAVE-... --lane <lane> --task "desc" [--gap-ids GAP-OP-1234,GAP-OP-1235]
  wave-execute collect  --wave-id WAVE-...
  wave-execute close    --wave-id WAVE-... [--disposition landed|deferred] [--completion-level slice|loop|domain|estate] [--fixed-in <sha>] [--verify-receipt <path>] [--controller-only] [--skip-residue-check] [--no-finish]
  wave-execute status   --wave-id WAVE-...
  wave-execute land     --wave-id WAVE-... --files "path1,path2,..." --summary "description" [--dry-run]

Wraps wave.sh with pre-flight authority validation and loop/gap context.

Exit codes:
  0  success
  1  blocked / failed
  2  invalid args
USAGE
}

# ── Helpers ──────────────────────────────────────────────────────

_header() {
  local label="$1"
  echo ""
  echo "======================================="
  echo "WAVE EXECUTE: $label"
  echo "======================================="
  echo ""
}

_fail() {
  echo "wave.execute FAIL: $1" >&2
  exit "${2:-1}"
}

_fail_args() {
  echo "wave.execute FAIL: $1" >&2
  exit 2
}

# Generate next sequential wave ID: WAVE-YYYYMMDD-NN
_next_wave_id() {
  local today
  today="$(date -u +%Y%m%d)"
  local prefix="WAVE-${today}-"
  local max=0
  if [[ -d "$WAVES_DIR" ]]; then
    for d in "$WAVES_DIR"/${prefix}*/; do
      [[ -d "$d" ]] || continue
      local leaf
      leaf="$(basename "$d")"
      local nn="${leaf#"$prefix"}"
      [[ "$nn" =~ ^[0-9]+$ ]] || continue
      # Strip leading zeros for arithmetic
      nn="$(echo "$nn" | sed 's/^0*//')"
      [[ -n "$nn" ]] || nn=0
      [[ "$nn" =~ ^[0-9]+$ ]] || continue
      if (( nn > max )); then
        max=$nn
      fi
    done
  fi
  local next=$(( max + 1 ))
  printf '%s%02d' "$prefix" "$next"
}

# Read authority binding JSON for a wave
_read_authority() {
  local wave_id="$1"
  local auth_file="$WAVES_DIR/$wave_id/authority.json"
  if [[ ! -f "$auth_file" ]]; then
    _fail "authority binding not found: $auth_file (was this wave started with wave-execute?)"
  fi
  cat "$auth_file"
}

# Extract a field from authority JSON
_auth_field() {
  local auth_json="$1"
  local field="$2"
  echo "$auth_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('$field',''))" 2>/dev/null || echo ""
}

_auth_execution_mode() {
  local auth_json="$1"
  local exec_mode
  exec_mode="$(printf '%s' "$(_auth_field "$auth_json" "execution_mode")" | tr '[:upper:]' '[:lower:]')"
  if [[ -z "$exec_mode" ]]; then
    exec_mode="code"
  fi
  printf '%s\n' "$exec_mode"
}

_infer_transport_for_execution_mode() {
  local execution_mode="${1:-code}"
  case "$execution_mode" in
    operational) printf 'mailroom\n' ;;
    *) printf 'git\n' ;;
  esac
}

_has_passthrough_flag() {
  local needle="$1"
  shift
  local arg=""
  for arg in "$@"; do
    if [[ "$arg" == "$needle" || "$arg" == "$needle="* ]]; then
      return 0
    fi
  done
  return 1
}

_preferred_checkout_dir() {
  # Prefer the caller's PWD when it's inside a governed sibling worktree
  # of SP (same git-common-dir). Otherwise fall back to SP so we keep the
  # current root-safe behavior for ad-hoc invocations from unrelated dirs.
  local pwd_top sp_common pwd_common
  pwd_top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$pwd_top" || "$pwd_top" == "$SP" ]]; then
    printf '%s\n' "$SP"
    return
  fi
  sp_common="$(cd "$SP" && git rev-parse --git-common-dir 2>/dev/null | xargs -I{} bash -c 'cd "{}" && pwd -P' 2>/dev/null || true)"
  pwd_common="$(cd "$pwd_top" && git rev-parse --git-common-dir 2>/dev/null | xargs -I{} bash -c 'cd "{}" && pwd -P' 2>/dev/null || true)"
  if [[ -n "$sp_common" && "$sp_common" == "$pwd_common" ]]; then
    printf '%s\n' "$pwd_top"
  else
    printf '%s\n' "$SP"
  fi
}

_current_checkout_common_root() {
  local target common_dir
  target="$(_preferred_checkout_dir)"
  common_dir="$(cd "$target" && git rev-parse --git-common-dir 2>/dev/null | xargs -I{} bash -c 'cd "{}" && pwd -P' 2>/dev/null || true)"
  if [[ -n "$common_dir" && "$(basename "$common_dir")" == ".git" ]]; then
    cd "$common_dir/.." && pwd -P
    return
  fi
  git -C "$target" rev-parse --show-toplevel 2>/dev/null || true
}

_current_checkout_repo() {
  _current_checkout_common_root
}

_current_checkout_branch() {
  local target
  target="$(_preferred_checkout_dir)"
  git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

_current_checkout_worktree() {
  local target
  target="$(_preferred_checkout_dir)"
  git -C "$target" rev-parse --show-toplevel 2>/dev/null || true
}

_state_field() {
  local state_file="${1:?state file required}"
  local dotted_path="${2:?state field path required}"
  python3 - "$state_file" "$dotted_path" <<'PYSTATEFIELD'
import json
import sys

state = json.load(open(sys.argv[1], encoding="utf-8"))
value = state
for segment in sys.argv[2].split("."):
    if isinstance(value, dict):
        value = value.get(segment, "")
    else:
        value = ""
        break
if value is None:
    value = ""
print(value)
PYSTATEFIELD
}

_resolve_commitish() {
  local repo_root="${1:-}"
  local ref="${2:-}"
  [[ -n "$ref" ]] || return 0
  if [[ -n "$repo_root" ]]; then
    git -C "$repo_root" rev-parse --verify "${ref}^{commit}" 2>/dev/null || printf '%s\n' "$ref"
    return 0
  fi
  printf '%s\n' "$ref"
}

_wave_workspace_snapshot() {
  local state_file="${1:?state file required}"
  local repo_root="" worktree="" branch="" head=""

  repo_root="$(_state_field "$state_file" "workspace.repo")"
  worktree="$(_state_field "$state_file" "workspace.worktree")"
  branch="$(_state_field "$state_file" "workspace.branch")"

  if [[ -n "$worktree" && -d "$worktree" ]]; then
    head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
      branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    fi
    if [[ -z "$repo_root" ]]; then
      repo_root="$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null || true)"
    fi
  fi

  if [[ -z "$head" && -n "$repo_root" && -n "$branch" ]]; then
    head="$(git -C "$repo_root" rev-parse --verify "${branch}^{commit}" 2>/dev/null || true)"
  fi

  printf '%s|%s|%s|%s\n' "$repo_root" "$worktree" "$branch" "$head"
}

_resolve_close_head() {
  local state_file="${1:?state file required}"
  local explicit_fixed_in="${2:-}"
  local repo_root="" worktree="" branch="" head=""

  IFS='|' read -r repo_root worktree branch head <<< "$(_wave_workspace_snapshot "$state_file")"
  if [[ -n "$explicit_fixed_in" ]]; then
    _resolve_commitish "${repo_root:-$(_current_checkout_repo)}" "$explicit_fixed_in"
    return 0
  fi

  if [[ -n "$head" ]]; then
    printf '%s\n' "$head"
    return 0
  fi

  local checkout_repo
  checkout_repo="$(_current_checkout_repo)"
  if [[ -n "$checkout_repo" ]]; then
    git -C "$checkout_repo" rev-parse HEAD 2>/dev/null || true
  fi
}

_resolve_canonical_worktree_prefix() {
  local repo_root="${1:?repo root required}"
  local canonical_root="/Users/ronnyworks/code/.runtime/spine/tmp/worktrees"
  if command -v yq >/dev/null 2>&1 && [[ -f "$WORKTREE_LIFECYCLE_CONTRACT" ]]; then
    canonical_root="$(yq e -r '.policy.canonical_worktree_root // "/Users/ronnyworks/code/.runtime/spine/tmp/worktrees"' "$WORKTREE_LIFECYCLE_CONTRACT" 2>/dev/null || echo "$canonical_root")"
  fi
  if [[ "$canonical_root" == "~/"* ]]; then
    canonical_root="$HOME/${canonical_root#~/}"
  fi
  printf '%s/%s\n' "${canonical_root%/}" "$(basename "$repo_root")"
}

_write_cleanup_proof() {
  local wave_id="${1:?wave id required}"
  local loop_id="${2:-}"
  local state_file="${3:?state file required}"
  local fixed_head="${4:-}"

  local repo_root="" worktree="" branch="" workspace_head=""
  IFS='|' read -r repo_root worktree branch workspace_head <<< "$(_wave_workspace_snapshot "$state_file")"
  [[ -n "$repo_root" ]] || repo_root="$(_current_checkout_repo)"
  [[ -n "$worktree" ]] || worktree="$(_state_field "$state_file" "workspace.worktree")"
  [[ -n "$branch" ]] || branch="$(_state_field "$state_file" "workspace.branch")"
  if [[ -n "$fixed_head" ]]; then
    workspace_head="$fixed_head"
  fi

  local evidence_dir="$WAVES_DIR/$wave_id/evidence"
  local cleanup_ref="$evidence_dir/${wave_id}-cleanup-proof.md"
  local generated_at
  generated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$evidence_dir"

  local -a worktree_status_lines=()
  local -a worktree_binding_lines=()
  local cleanup_classifier_status="unavailable"
  local cleanup_classifier_note="final wrapper cleanup proof generated before wave-close teardown so the landed head and workspace binding survive close-time cleanup"

  if [[ -n "$worktree" && -d "$worktree" ]]; then
    while IFS= read -r line; do
      worktree_status_lines+=("$line")
    done < <(git -C "$worktree" status --short --branch 2>/dev/null || true)

    local binding_head="" binding_branch=""
    binding_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
    binding_branch="$(git -C "$worktree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    [[ -n "$binding_head" ]] && worktree_binding_lines+=("HEAD ${binding_head}")
    if [[ -n "$binding_branch" ]]; then
      worktree_binding_lines+=("branch refs/heads/${binding_branch}")
    elif [[ -n "$branch" ]]; then
      worktree_binding_lines+=("branch refs/heads/${branch}")
    fi
  fi

  if [[ -n "$worktree" ]]; then
    worktree_binding_lines=("worktree ${worktree}" "${worktree_binding_lines[@]}")
  fi

  {
    printf 'wave_id: %s\n' "$wave_id"
    printf 'loop_id: %s\n' "$loop_id"
    printf 'generated_at_utc: %s\n' "$generated_at"
    printf 'workspace_repo: %s\n' "$repo_root"
    printf 'workspace_worktree: %s\n' "$worktree"
    printf 'workspace_branch: %s\n' "$branch"
    printf 'workspace_head: %s\n' "$workspace_head"
    printf 'cleanup_classifier_status: %s\n' "$cleanup_classifier_status"
    printf 'cleanup_classifier_note: %s\n' "$cleanup_classifier_note"
    printf 'worktree_status:\n'
    if [[ ${#worktree_status_lines[@]} -eq 0 ]]; then
      printf '  - "%s"\n' "<unavailable>"
    else
      local line=""
      for line in "${worktree_status_lines[@]}"; do
        line="${line//\\/\\\\}"
        line="${line//\"/\\\"}"
        printf '  - "%s"\n' "$line"
      done
    fi
    printf 'worktree_binding:\n'
    if [[ ${#worktree_binding_lines[@]} -eq 0 ]]; then
      printf '  - "%s"\n' "<unavailable>"
    else
      local binding=""
      for binding in "${worktree_binding_lines[@]}"; do
        binding="${binding//\\/\\\\}"
        binding="${binding//\"/\\\"}"
        printf '  - "%s"\n' "$binding"
      done
    fi
  } > "$cleanup_ref"

  printf '%s\n' "$cleanup_ref"
}

_provision_finish_runner_worktree() {
  local repo_root="${1:?repo root required}"
  local wave_id="${2:?wave id required}"
  local commit_ref="${3:?commit ref required}"
  local canonical_prefix="" temp_dir=""

  canonical_prefix="$(_resolve_canonical_worktree_prefix "$repo_root")"
  mkdir -p "$canonical_prefix"
  temp_dir="$(mktemp -d "$canonical_prefix/FINISH-${wave_id}.XXXXXX")"
  rmdir "$temp_dir"
  git -C "$repo_root" worktree add --detach "$temp_dir" "$commit_ref" >/dev/null 2>&1 || {
    rm -rf "$temp_dir" >/dev/null 2>&1 || true
    _fail "unable to provision detached finish runner at $commit_ref"
  }

  printf '%s\n' "$temp_dir"
}

_remove_temp_worktree() {
  local repo_root="${1:-}"
  local worktree_path="${2:-}"
  [[ -n "$repo_root" && -n "$worktree_path" ]] || return 0
  git -C "$repo_root" worktree remove --force "$worktree_path" >/dev/null 2>&1 || rm -rf "$worktree_path" >/dev/null 2>&1 || true
}

_ensure_wave_branch() {
  local repo_root="${1:?repo root required}"
  local wave_id="${2:?wave id required}"
  local target_branch="codex/$wave_id"
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$target_branch"; then
    printf '%s\n' "$target_branch"
    return 0
  fi

  local base_branch
  base_branch="$(_current_checkout_branch)"
  if [[ -z "$base_branch" || "$base_branch" == "HEAD" ]]; then
    base_branch="main"
  fi

  if git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$base_branch"; then
    git -C "$repo_root" branch "$target_branch" "origin/$base_branch" >/dev/null
  else
    git -C "$repo_root" branch "$target_branch" "$base_branch" >/dev/null
  fi

  printf '%s\n' "$target_branch"
}

_provision_wrapper_managed_workspace() {
  local wave_id="${1:?wave id required}"
  local repo_root
  repo_root="$(_current_checkout_repo)"
  [[ -n "$repo_root" ]] || _fail "unable to resolve current checkout root for wrapper-managed workspace"
  [[ -x "$WORKTREE_REHYDRATE" ]] || _fail "worktree-lifecycle-rehydrate unavailable at $WORKTREE_REHYDRATE"

  local branch
  branch="$(_ensure_wave_branch "$repo_root" "$wave_id")" || _fail "unable to materialize codex/$wave_id branch"

  local helper_output
  helper_output="$("$WORKTREE_REHYDRATE" --branch "$branch" --lane "$wave_id" --repo "$repo_root" 2>&1)" || {
    echo "$helper_output"
    _fail "wrapper-managed worktree rehydrate failed for $wave_id"
  }

  local resolved_repo="" resolved_branch="" resolved_worktree=""
  while IFS='=' read -r key value; do
    case "$key" in
      repo) resolved_repo="$value" ;;
      branch) resolved_branch="$value" ;;
      worktree) resolved_worktree="$value" ;;
    esac
  done <<< "$helper_output"

  [[ -n "$resolved_repo" ]] || resolved_repo="$repo_root"
  [[ -n "$resolved_branch" ]] || resolved_branch="$branch"
  [[ -n "$resolved_worktree" ]] || _fail "wrapper-managed worktree rehydrate did not report a worktree path"

  printf '%s|%s|%s|%s\n' \
    "$resolved_repo" \
    "$resolved_branch" \
    "$resolved_worktree" \
    "wrapper-managed worktree rehydrate after wave.sh path-policy block"
}

_sync_wave_runtime_state() {
  local wave_id="${1:?wave id required}"
  local auth_json="${2:?authority json required}"
  local fallback_repo="${3:-}"
  local fallback_worktree="${4:-}"
  local fallback_branch="${5:-}"
  local workspace_note="${6:-}"
  local state_file="$WAVES_DIR/$wave_id/state.json"
  [[ -f "$state_file" ]] || return 0

  local execution_mode
  execution_mode="$(_auth_execution_mode "$auth_json")"
  local transport
  transport="$(_infer_transport_for_execution_mode "$execution_mode")"

  python3 - "$state_file" "$fallback_repo" "$fallback_worktree" "$fallback_branch" "$execution_mode" "$transport" "$workspace_note" <<'PYSYNC'
import json
import os
import sys
import tempfile
from pathlib import Path

state_path = Path(sys.argv[1])
fallback_repo = sys.argv[2]
fallback_worktree = sys.argv[3]
fallback_branch = sys.argv[4]
execution_mode = sys.argv[5]
transport = sys.argv[6]
workspace_note = sys.argv[7]

state = json.loads(state_path.read_text(encoding="utf-8"))
workspace = state.get("workspace") if isinstance(state.get("workspace"), dict) else {}
packet = state.get("packet") if isinstance(state.get("packet"), dict) else {}
if not packet and isinstance(state.get("wave_packet"), dict):
    packet = state["wave_packet"]

changed = False

repo = str(workspace.get("repo") or "").strip()
worktree = str(workspace.get("worktree") or "").strip()
branch = str(workspace.get("branch") or "").strip()
lifecycle_state = str(workspace.get("lifecycle_state") or "").strip()
force_workspace_refresh = "wrapper-managed worktree rehydrate" in workspace_note

def missing_path(value: str) -> bool:
    return not value or not Path(value).exists()

def _atomic_write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd_tmp = None
    tmp_path = None
    try:
        fd_tmp, tmp_path = tempfile.mkstemp(prefix=".state-", suffix=".tmp", dir=str(path.parent))
        with os.fdopen(fd_tmp, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        fd_tmp = None
        os.replace(tmp_path, path)
        tmp_path = None
    finally:
        if fd_tmp is not None:
            try:
                os.close(fd_tmp)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except FileNotFoundError:
                pass

if fallback_repo and (not repo or missing_path(repo) or force_workspace_refresh):
    workspace["repo"] = fallback_repo
    repo = fallback_repo
    changed = True
if fallback_worktree and (not worktree or missing_path(worktree) or force_workspace_refresh):
    workspace["worktree"] = fallback_worktree
    worktree = fallback_worktree
    changed = True
if fallback_branch and (not branch or force_workspace_refresh):
    workspace["branch"] = fallback_branch
    branch = fallback_branch
    changed = True

if repo or worktree or branch:
    if not bool(workspace.get("enabled")):
        workspace["enabled"] = True
        changed = True
    if lifecycle_state in {"", "disabled"}:
        workspace["lifecycle_state"] = "active"
        changed = True
    if workspace_note:
        current_note = str(workspace.get("note") or "").strip()
        if not current_note or current_note == "worktree auto-provision disabled (--worktree off)":
            workspace["note"] = workspace_note
            changed = True

packet_execution_mode = str(packet.get("execution_mode") or "").strip().lower()
packet_transport = str(packet.get("transport") or "").strip().lower()
if not packet_execution_mode and execution_mode:
    packet["execution_mode"] = execution_mode
    changed = True
if not packet_transport and transport:
    packet["transport"] = transport
    changed = True

if not str(state.get("execution_mode") or "").strip() and execution_mode:
    state["execution_mode"] = execution_mode
    changed = True
if not str(state.get("transport") or "").strip() and transport:
    state["transport"] = transport
    changed = True

gate = packet.get("cross_repo_pushability_gate")
if isinstance(gate, dict):
    gate_repo = str(gate.get("repo") or "").strip()
    gate_branch = str(gate.get("branch") or "").strip()
    if repo and (not gate_repo or force_workspace_refresh or missing_path(gate_repo)):
        gate["repo"] = repo
        changed = True
    if branch and (not gate_branch or force_workspace_refresh):
        gate["branch"] = branch
        changed = True
    packet["cross_repo_pushability_gate"] = gate

state["workspace"] = workspace
state["packet"] = packet
state["wave_packet"] = packet

if changed:
    _atomic_write_json(state_path, state)
PYSYNC
}

_normalize_completion_level() {
  local completion_level="${1:-}"
  case "$completion_level" in
    "" ) printf '\n' ;;
    slice) printf 'slice_complete\n' ;;
    loop) printf 'loop_complete\n' ;;
    domain) printf 'domain_complete\n' ;;
    estate) printf 'estate_complete\n' ;;
    readiness) printf 'readiness_complete\n' ;;
    *) printf '%s\n' "$completion_level" ;;
  esac
}

# ── Subcommand: start ────────────────────────────────────────────
cmd_start() {
  local loop_id=""
  local wave_id=""
  local objective=""
  local -a passthrough_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)           shift ;;
      --loop-id)    loop_id="${2:?--loop-id requires a value}"; shift 2 ;;
      --wave-id)    wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      --objective)  objective="${2:?--objective requires a value}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)            passthrough_args+=("$1"); shift ;;
    esac
  done

  [[ -n "$loop_id" ]] || _fail_args "--loop-id required"

  _header "start"

  # Step 1: Authority check
  echo "Resolving authority for $loop_id..."
  local auth_json
  auth_json="$("$AUTHORITY_RESOLVE" --loop-id "$loop_id" --json 2>&1)" || {
    local rc=$?
    echo "$auth_json"
    if [[ $rc -eq 2 ]]; then
      _fail "loop not found or invalid: $loop_id" 2
    fi
    _fail "authority check blocked dispatch"
  }

  local ready
  ready="$(_auth_field "$auth_json" "ready_for_dispatch")"
  if [[ "$ready" != "True" ]]; then
    echo "Authority: BLOCKED"
    echo ""
    local blockers
    blockers="$(echo "$auth_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for b in d.get('blockers',[]):
    print('  - ' + b)
" 2>/dev/null || true)"
    echo "Blockers:"
    echo "$blockers"
    echo ""
    _fail "authority check blocked dispatch"
  fi

  # Step 2: Generate wave ID if not provided
  if [[ -z "$wave_id" ]]; then
    wave_id="$(_next_wave_id)"
  fi

  # Validate wave ID format
  if [[ ! "$wave_id" =~ ^WAVE-[0-9]{8}-[0-9]{2}$ ]]; then
    _fail_args "wave ID must match WAVE-YYYYMMDD-NN (got: $wave_id)"
  fi

  # Step 3: Delegate to wave.sh start
  local wave_start_args=("$wave_id" --loop-id "$loop_id")
  if [[ -n "$objective" ]]; then
    wave_start_args+=(--objective "$objective")
  fi
  # Pass through any additional wave.sh start flags
  if [[ ${#passthrough_args[@]} -gt 0 ]]; then
    wave_start_args+=("${passthrough_args[@]}")
  fi

  local explicit_worktree_flag=0
  if _has_passthrough_flag "--worktree" "${passthrough_args[@]+"${passthrough_args[@]}"}"; then
    explicit_worktree_flag=1
  fi

  echo "Starting wave $wave_id..."
  local start_rc=0
  local start_output=""
  local provision_repo=""
  local provision_branch=""
  local provision_worktree=""
  local provision_note=""
  start_output="$(bash "$WAVE_SH" start "${wave_start_args[@]}" 2>&1)" || start_rc=$?

  if [[ "$start_rc" -ne 0 ]]; then
    if [[ "$explicit_worktree_flag" -eq 0 && "$start_output" == *"WORKTREE PATH POLICY BLOCK:"* ]]; then
      echo "$start_output"
      echo "wave.execute: retrying start with wrapper-managed worktree rehydrate..."

      local -a fallback_args=("$wave_id" --loop-id "$loop_id" --worktree off)
      if [[ -n "$objective" ]]; then
        fallback_args+=(--objective "$objective")
      fi
      if [[ ${#passthrough_args[@]} -gt 0 ]]; then
        fallback_args+=("${passthrough_args[@]}")
      fi

      start_output="$(bash "$WAVE_SH" start "${fallback_args[@]}" 2>&1)" || {
        echo "$start_output"
        _fail "wave.sh start failed for $wave_id"
      }

      local provisioned
      provisioned="$(_provision_wrapper_managed_workspace "$wave_id")"
      IFS='|' read -r provision_repo provision_branch provision_worktree provision_note <<< "$provisioned"
    else
      echo "$start_output"
      _fail "wave.sh start failed for $wave_id"
    fi
  fi
  echo "$start_output"

  # Step 4: Write authority binding
  local wave_dir="$WAVES_DIR/$wave_id"
  mkdir -p "$wave_dir"
  local started_at
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  python3 -c "
import json, sys

auth = json.loads(sys.argv[1])
auth['wave_id'] = sys.argv[2]
auth['started_at_utc'] = sys.argv[3]
auth['run_key'] = sys.argv[4]

with open(sys.argv[5], 'w') as f:
    json.dump(auth, f, indent=2)
    f.write('\n')
" "$auth_json" "$wave_id" "$started_at" "${SPINE_CAP_RUN_KEY:-manual}" "$wave_dir/authority.json"

  _sync_wave_runtime_state "$wave_id" "$auth_json" "$provision_repo" "$provision_worktree" "$provision_branch" "$provision_note"

  # Step 5: Print summary
  local exec_mode
  exec_mode="$(_auth_execution_mode "$auth_json")"
  local owner
  owner="$(_auth_field "$auth_json" "owner")"
  local loop_objective
  loop_objective="$(_auth_field "$auth_json" "objective")"

  echo ""
  printf "Authority:  %s -> READY\n" "$loop_id"
  printf "Wave ID:    %s\n" "$wave_id"
  printf "Objective:  %s\n" "${objective:-${loop_objective:-<not set>}}"
  printf "Exec Mode:  %s\n" "$exec_mode"
  printf "Owner:      %s\n" "$owner"
  echo ""

  # Print linked gaps
  local gap_count
  gap_count="$(echo "$auth_json" | python3 -c "import json,sys; print(len(json.load(sys.stdin).get('linked_gaps',[])))" 2>/dev/null || echo 0)"
  if [[ "$gap_count" -gt 0 ]]; then
    echo "Linked Gaps: $gap_count"
    echo "$auth_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for g in d.get('linked_gaps',[]):
    print('  %-14s %-8s %s' % (g['gap_id'], g['severity'], g['title']))
" 2>/dev/null || true
  else
    echo "Linked Gaps: none"
  fi
  echo ""

  echo "WAVE STARTED -- dispatch tasks with:"
  echo "  wave-execute dispatch --wave-id $wave_id --lane <lane> --task \"...\""
  echo ""
}

# ── Subcommand: dispatch ─────────────────────────────────────────
cmd_dispatch() {
  local wave_id=""
  local lane=""
  local task=""
  local gap_ids=""
  local -a passthrough_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)           shift ;;
      --wave-id)    wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      --lane)       lane="${2:?--lane requires a value}"; shift 2 ;;
      --task)       task="${2:?--task requires a value}"; shift 2 ;;
      --gap-ids)    gap_ids="${2:?--gap-ids requires a value}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)            passthrough_args+=("$1"); shift ;;
    esac
  done

  [[ -n "$wave_id" ]] || _fail_args "--wave-id required"
  [[ -n "$lane" ]]    || _fail_args "--lane required"
  [[ -n "$task" ]]    || _fail_args "--task required"

  _header "dispatch"

  # Step 1: Read authority binding
  local auth_json
  auth_json="$(_read_authority "$wave_id")"
  local loop_id
  loop_id="$(_auth_field "$auth_json" "loop_id")"

  # Step 2: Validate wave exists and is active
  local state_file="$WAVES_DIR/$wave_id/state.json"
  if [[ ! -f "$state_file" ]]; then
    _fail "wave state not found: $state_file"
  fi
  local wave_status
  wave_status="$(python3 -c "import json; print(json.load(open('$state_file'))['status'])" 2>/dev/null || echo "unknown")"
  if [[ "$wave_status" != "active" ]]; then
    _fail "wave $wave_id is '$wave_status' (must be active)"
  fi

  printf "Wave:      %s (active)\n" "$wave_id"
  printf "Loop:      %s\n" "$loop_id"
  printf "Lane:      %s\n" "$lane"
  printf "Task:      %s\n" "$task"
  if [[ -n "$gap_ids" ]]; then
    printf "Gap IDs:   %s\n" "$gap_ids"
  fi
  echo ""

  local checkout_repo=""
  local checkout_worktree=""
  local checkout_branch=""
  checkout_repo="$(_current_checkout_repo)"
  checkout_worktree="$(_current_checkout_worktree)"
  checkout_branch="$(_current_checkout_branch)"
  _sync_wave_runtime_state \
    "$wave_id" \
    "$auth_json" \
    "$checkout_repo" \
    "$checkout_worktree" \
    "$checkout_branch" \
    "wave-execute adopted current checkout metadata for dispatch"

  # Step 3: Delegate to wave.sh dispatch
  local dispatch_args=("$wave_id" --lane "$lane" --task "$task")
  if [[ ${#passthrough_args[@]} -gt 0 ]]; then
    dispatch_args+=("${passthrough_args[@]}")
  fi

  echo "Dispatching..."
  bash "$WAVE_SH" dispatch "${dispatch_args[@]}" || {
    _fail "wave.sh dispatch failed"
  }

  # Step 4: Log gap_ids binding to wave state
  if [[ -n "$gap_ids" ]]; then
    python3 -c "
import json, sys, os, fcntl, tempfile

state_file = sys.argv[1]
gap_ids_raw = sys.argv[2]
lane = sys.argv[3]
task = sys.argv[4]

gap_list = [g.strip() for g in gap_ids_raw.split(',') if g.strip()]

lock_file = state_file + '.lock'
fd = os.open(lock_file, os.O_CREAT | os.O_RDWR)
try:
    fcntl.flock(fd, fcntl.LOCK_EX)
    with open(state_file) as f:
        state = json.load(f)

    # Add gap_ids to the most recent dispatch matching this lane/task
    dispatches = state.get('dispatches', [])
    for d in reversed(dispatches):
        if d.get('lane') == lane and d.get('task') == task:
            d['gap_ids'] = gap_list
            break

    # Also maintain a top-level gap_bindings map for quick lookup
    if 'gap_bindings' not in state:
        state['gap_bindings'] = {}
    for gid in gap_list:
        if gid not in state['gap_bindings']:
            state['gap_bindings'][gid] = []
        entry = {'lane': lane, 'task': task}
        if entry not in state['gap_bindings'][gid]:
            state['gap_bindings'][gid].append(entry)

    dirpath = os.path.dirname(state_file) or "."
    fd_tmp = None
    tmp_path = None
    try:
        fd_tmp, tmp_path = tempfile.mkstemp(prefix=".state-", suffix=".tmp", dir=dirpath)
        with os.fdopen(fd_tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        fd_tmp = None
        os.replace(tmp_path, state_file)
        tmp_path = None
    finally:
        if fd_tmp is not None:
            try:
                os.close(fd_tmp)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except FileNotFoundError:
                pass
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
" "$state_file" "$gap_ids" "$lane" "$task"
    echo "Gap binding recorded: $gap_ids -> $lane"
  fi

  echo ""
  echo "DISPATCH RECORDED"
  echo "  Complete with: wave.sh ack $wave_id --lane $lane --result \"...\""
  echo ""
}

# ── Subcommand: collect ──────────────────────────────────────────
cmd_collect() {
  local wave_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)           shift ;;
      --wave-id)    wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)            wave_id="$1"; shift ;;
    esac
  done

  [[ -n "$wave_id" ]] || _fail_args "--wave-id required"

  _header "collect"

  # Step 1: Delegate to wave.sh collect
  echo "Collecting receipts for $wave_id..."
  bash "$WAVE_SH" collect "$wave_id" || {
    _fail "wave.sh collect failed"
  }
  echo ""

  # Step 2: Read authority binding and validate receipts
  local auth_file="$WAVES_DIR/$wave_id/authority.json"
  if [[ ! -f "$auth_file" ]]; then
    echo "WARN: no authority binding found -- skipping receipt validation"
    echo "(wave was not started with wave-execute)"
    return 0
  fi

  local auth_json
  auth_json="$(cat "$auth_file")"
  local expected_loop_id
  expected_loop_id="$(_auth_field "$auth_json" "loop_id")"

  # Scan evidence directory for receipts
  local evidence_dir="$WAVES_DIR/$wave_id/evidence"
  if [[ ! -d "$evidence_dir" ]]; then
    echo "No evidence directory found -- 0 receipts to validate"
    return 0
  fi

  local valid=0
  local invalid=0
  local missing_loop=0
  local missing_proof=0
  local missing_gap_ids=0
  local -a gap_ids_covered=()
  local linked_gaps
  linked_gaps="$(echo "$auth_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for g in d.get('linked_gaps',[]):
    print(g['gap_id'])
" 2>/dev/null || true)"
  local require_gap_ids=0
  [[ -n "$linked_gaps" ]] && require_gap_ids=1

  echo "Receipt Validation (authority loop: $expected_loop_id):"
  echo "---------------------------------------"

  for receipt_file in "$evidence_dir"/*.exec_receipt.json; do
    [[ -f "$receipt_file" ]] || continue
    local receipt_name
    receipt_name="$(basename "$receipt_file")"

    local validation
    validation="$(python3 -c "
import json, sys

with open(sys.argv[1]) as f:
    r = json.load(f)

expected_loop = sys.argv[2]
require_gap_ids = sys.argv[3] == '1'
issues = []

# Check loop_id matches
receipt_loop = r.get('loop_id', '')
if not receipt_loop:
    issues.append('missing loop_id')
elif receipt_loop != expected_loop:
    issues.append(f'loop_id mismatch: {receipt_loop} != {expected_loop}')

# Check run_keys non-empty
lane = str(r.get('lane', '')).strip()
run_keys = r.get('run_keys', [])
commit_hashes = r.get('commit_hashes', [])
if lane == 'audit' and not run_keys:
    issues.append('missing audit run_keys')
elif lane == 'execution' and not run_keys and not commit_hashes:
    issues.append('missing execution proof (run_keys or commit_hashes)')

# Check gap_ids present
gap_ids = r.get('gap_ids', [])
if require_gap_ids and not gap_ids:
    issues.append('missing gap_ids')

if issues:
    print('INVALID|' + '; '.join(issues))
    for gid in gap_ids:
        print('GAP|' + gid)
else:
    print('VALID|ok')
    for gid in gap_ids:
        print('GAP|' + gid)
" "$receipt_file" "$expected_loop_id" "$require_gap_ids" 2>/dev/null || echo "INVALID|parse error")"

    local first_line
    first_line="$(echo "$validation" | head -1)"
    local verdict="${first_line%%|*}"
    local detail="${first_line#*|}"

    if [[ "$verdict" == "VALID" ]]; then
      (( valid++ )) || true
      printf "  %-30s VALID\n" "$receipt_name"
    else
      (( invalid++ )) || true
      printf "  %-30s INVALID: %s\n" "$receipt_name" "$detail"
      [[ "$detail" != *"missing loop_id"* && "$detail" != *"loop_id mismatch"* ]] || (( missing_loop++ )) || true
      [[ "$detail" != *"run_keys"* && "$detail" != *"execution proof"* ]] || (( missing_proof++ )) || true
      [[ "$detail" != *"missing gap_ids"* ]] || (( missing_gap_ids++ )) || true
    fi

    # Collect covered gap IDs
    while IFS= read -r line; do
      if [[ "$line" == GAP\|* ]]; then
        gap_ids_covered+=("${line#GAP|}")
      fi
    done <<< "$validation"
  done

  echo ""
  echo "Summary:"
  printf "  Valid receipts:     %d\n" "$valid"
  printf "  Invalid receipts:   %d\n" "$invalid"
  if [[ $invalid -gt 0 ]]; then
    printf "    Missing loop_id:  %d\n" "$missing_loop"
    printf "    Missing proof:    %d\n" "$missing_proof"
    printf "    Missing gap_ids:  %d\n" "$missing_gap_ids"
  fi

  # Gap coverage
  if [[ -n "$linked_gaps" ]]; then
    echo ""
    echo "Gap Coverage:"
    local covered=0
    local uncovered=0
    while IFS= read -r gid; do
      [[ -n "$gid" ]] || continue
      local found=0
      for cid in "${gap_ids_covered[@]+"${gap_ids_covered[@]}"}"; do
        if [[ "$cid" == "$gid" ]]; then
          found=1
          break
        fi
      done
      if [[ $found -eq 1 ]]; then
        printf "  %-14s COVERED\n" "$gid"
        (( covered++ )) || true
      else
        printf "  %-14s UNCOVERED\n" "$gid"
        (( uncovered++ )) || true
      fi
    done <<< "$linked_gaps"
    printf "\n  Coverage: %d/%d linked gaps addressed in receipts\n" "$covered" "$((covered + uncovered))"
  fi
  echo ""
}

# ── Subcommand: close ────────────────────────────────────────────
cmd_close() {
  local wave_id=""
  local disposition=""
  local completion_level=""
  local fixed_in=""
  local verify_receipt=""
  local controller_only=0
  local skip_residue_check=0
  local no_finish=0
  local -a passthrough_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)                   shift ;;
      --wave-id)            wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      --disposition)        disposition="${2:?--disposition requires a value}"; shift 2 ;;
      --completion-level)   completion_level="${2:?--completion-level requires a value}"; shift 2 ;;
      --fixed-in)           fixed_in="${2:?--fixed-in requires a value}"; shift 2 ;;
      --verify-receipt)     verify_receipt="${2:?--verify-receipt requires a value}"; shift 2 ;;
      --controller-only)    controller_only=1; shift ;;
      --skip-residue-check) skip_residue_check=1; shift ;;
      --no-finish)          no_finish=1; shift ;;
      -h|--help)            usage; exit 0 ;;
      *)                    passthrough_args+=("$1"); shift ;;
    esac
  done

  [[ -n "$wave_id" ]] || _fail_args "--wave-id required"

  completion_level="$(_normalize_completion_level "$completion_level")"

  _header "close"

  # Step 1: Read authority binding
  local auth_json
  auth_json="$(_read_authority "$wave_id")"
  local loop_id
  loop_id="$(_auth_field "$auth_json" "loop_id")"

  printf "Wave:      %s\n" "$wave_id"
  printf "Loop:      %s\n" "$loop_id"
  echo ""

  # Step 2: Run collect first (ensure all receipts are ingested)
  echo "Running collect before close..."
  (
    cd "$SP"
    env -u SPINE_ROOT -u SPINE_REPO -u SPINE_TARGET_REPO -u OPS_WORKTREE_IDENTITY \
      bash "$WAVE_SH" collect "$wave_id"
  ) 2>/dev/null || true
  echo ""

  # Step 3: Validate dispatches have receipts or explicit blockers
  local state_file="$WAVES_DIR/$wave_id/state.json"
  if [[ -f "$state_file" ]]; then
    local dispatch_check
    dispatch_check="$(python3 -c "
import json, sys

with open(sys.argv[1]) as f:
    state = json.load(f)

dispatches = state.get('dispatches', [])
pending = [d for d in dispatches if d.get('status') in ('pending', 'dispatched')]
done_count = len([d for d in dispatches if d.get('status') in ('done', 'acked')])
blocked_count = len([d for d in dispatches if d.get('status') == 'blocked'])
failed_count = len([d for d in dispatches if d.get('status') == 'failed'])

print(f'{len(dispatches)}|{done_count}|{blocked_count}|{failed_count}|{len(pending)}')
for p in pending:
    print(f'PENDING|{p.get(\"lane\",\"?\")}|{p.get(\"task\",\"?\")[:60]}')
" "$state_file" 2>/dev/null || echo "0|0|0|0|0")"

    local first_line
    first_line="$(echo "$dispatch_check" | head -1)"
    IFS='|' read -r total done blocked failed pending <<< "$first_line"

    echo "Dispatch Status:"
    printf "  Total:    %s\n" "$total"
    printf "  Done:     %s\n" "$done"
    printf "  Blocked:  %s\n" "$blocked"
    printf "  Failed:   %s\n" "$failed"
    printf "  Pending:  %s\n" "$pending"
    echo ""

    if [[ "$pending" -gt 0 ]]; then
      echo "WARNING: $pending dispatch(es) still pending:"
      echo "$dispatch_check" | while IFS='|' read -r tag lane task; do
        [[ "$tag" == "PENDING" ]] && printf "  [%s] %s\n" "$lane" "$task"
      done
      echo ""
    fi
  fi

  # Step 4: Delegate to wave.sh close
  local close_head=""
  local effective_fixed_in=""
  if [[ -n "$disposition" || -n "$fixed_in" ]]; then
    close_head="$(_resolve_close_head "$state_file" "$fixed_in")"
    [[ -n "$close_head" ]] || _fail "unable to resolve canonical close head"
  fi
  if [[ "$disposition" == "landed" || -n "$fixed_in" ]]; then
    effective_fixed_in="$close_head"
  fi

  local cleanup_ref=""
  cleanup_ref="$(_write_cleanup_proof "$wave_id" "$loop_id" "$state_file" "$close_head")"

  local close_args=("$wave_id")
  if [[ -n "$disposition" ]]; then
    close_args+=(--disposition "$disposition")
  fi
  if [[ -n "$completion_level" ]]; then
    close_args+=(--completion-level "$completion_level")
  fi
  if [[ -n "$effective_fixed_in" ]]; then
    close_args+=(--fixed-in "$effective_fixed_in")
  fi
  if [[ -n "$verify_receipt" ]]; then
    close_args+=(--verify-receipt "$verify_receipt")
  fi
  if [[ "$controller_only" -eq 1 ]]; then
    close_args+=(--controller-only)
  fi
  if [[ ${#passthrough_args[@]} -gt 0 ]]; then
    close_args+=("${passthrough_args[@]}")
  fi

  echo "Closing wave $wave_id..."
  (
    cd "$SP"
    env -u SPINE_ROOT -u SPINE_REPO -u SPINE_TARGET_REPO -u OPS_WORKTREE_IDENTITY \
      "WAVE_CLOSE_CLEANUP_REF=$cleanup_ref" \
      bash "$WAVE_SH" close "${close_args[@]}"
  ) || {
    _fail "wave.sh close failed"
  }
  echo ""

  # Step 5: Propagate closure with wave.finish unless explicitly deferred.
  if [[ -n "$disposition" ]]; then
    local finish_main_override=""
    if [[ "$controller_only" -eq 1 && "$(_current_checkout_branch)" == "main" ]]; then
      finish_main_override="OPS_GOVERNED_MAIN_OVERRIDE=1 "
    fi

    local finish_cmd="  ${finish_main_override}./ops/plugins/core/orchestration/bin/wave-finish \\"
    finish_cmd+="\n    --loop-id $loop_id \\"
    finish_cmd+="\n    --disposition $disposition"
    if [[ -n "$completion_level" ]]; then
      finish_cmd+=" \\\\\n    --completion-level $completion_level"
    fi
    if [[ -n "$effective_fixed_in" ]]; then
      finish_cmd+=" \\\\\n    --fixed-in $effective_fixed_in"
    fi
    if [[ "$controller_only" -eq 1 ]]; then
      finish_cmd+=" \\\\\n    --controller-only"
    fi
    if [[ "$skip_residue_check" -eq 1 ]]; then
      finish_cmd+=" \\\\\n    --skip-residue-check"
    fi
    finish_cmd+=" \\\\\n    --wave-id $wave_id"

    if [[ "$no_finish" -eq 1 ]]; then
      echo "======================================="
      echo "NEXT STEP: wave.finish"
      echo "======================================="
      echo ""
      echo "Wave is closed. To propagate closure across all surfaces, run:"
      echo ""
      printf "$finish_cmd\n"
      echo ""
      echo "(wave.finish was skipped because --no-finish was supplied)"
    else
      local -a finish_args=(--loop-id "$loop_id" --disposition "$disposition" --wave-id "$wave_id")
      if [[ -n "$completion_level" ]]; then
        finish_args+=(--completion-level "$completion_level")
      fi
      if [[ -n "$effective_fixed_in" ]]; then
        finish_args+=(--fixed-in "$effective_fixed_in")
      fi
      if [[ "$controller_only" -eq 1 ]]; then
        finish_args+=(--controller-only)
      fi
      if [[ "$skip_residue_check" -eq 1 ]]; then
        finish_args+=(--skip-residue-check)
      fi

      echo "Running wave.finish..."
      local finish_repo_root=""
      finish_repo_root="$(_current_checkout_repo)"
      [[ -n "$finish_repo_root" ]] || finish_repo_root="$(_state_field "$state_file" "workspace.repo")"
      [[ -n "$finish_repo_root" ]] || _fail "unable to resolve canonical repo root for wave.finish"
      local finish_runner=""
      finish_runner="$(_provision_finish_runner_worktree "$finish_repo_root" "$wave_id" "${close_head:-HEAD}")"
      local finish_bin="$finish_runner/ops/plugins/core/orchestration/bin/wave-finish"
      [[ -x "$finish_bin" ]] || {
        _remove_temp_worktree "$finish_repo_root" "$finish_runner"
        _fail "wave.finish missing from detached finish runner: $finish_bin"
      }
      local -a finish_env=("OPS_CAP_AUTO_APPROVE=yes")
      if [[ -n "$finish_main_override" ]]; then
        finish_env+=("OPS_GOVERNED_MAIN_OVERRIDE=1")
      fi
      (
        cd "$finish_runner"
        env -u SPINE_ROOT -u SPINE_REPO -u SPINE_TARGET_REPO -u OPS_WORKTREE_IDENTITY \
          "${finish_env[@]}" \
          bash "$finish_bin" "${finish_args[@]}"
      ) || {
        _remove_temp_worktree "$finish_repo_root" "$finish_runner"
        _fail "wave.finish failed"
      }
      _remove_temp_worktree "$finish_repo_root" "$finish_runner"
    fi
  fi
  echo ""
}

# ── Subcommand: status ───────────────────────────────────────────
cmd_status() {
  local wave_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)           shift ;;
      --wave-id)    wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      *)            wave_id="$1"; shift ;;
    esac
  done

  [[ -n "$wave_id" ]] || _fail_args "--wave-id required"

  _header "status"

  # Step 1: Delegate to wave.sh status
  bash "$WAVE_SH" status "$wave_id" || {
    _fail "wave.sh status failed"
  }
  echo ""

  # Step 2: Add authority context
  local auth_file="$WAVES_DIR/$wave_id/authority.json"
  if [[ -f "$auth_file" ]]; then
    local auth_json
    auth_json="$(cat "$auth_file")"
    local loop_id
    loop_id="$(_auth_field "$auth_json" "loop_id")"
    local started_at
    started_at="$(_auth_field "$auth_json" "started_at_utc")"
    local exec_mode
    exec_mode="$(_auth_field "$auth_json" "execution_mode")"

    echo "Authority Context:"
    printf "  Loop ID:      %s\n" "$loop_id"
    printf "  Exec Mode:    %s\n" "$exec_mode"
    printf "  Started At:   %s\n" "$started_at"

    # Linked gaps
    local gap_count
    gap_count="$(echo "$auth_json" | python3 -c "import json,sys; print(len(json.load(sys.stdin).get('linked_gaps',[])))" 2>/dev/null || echo 0)"
    printf "  Linked Gaps:  %s\n" "$gap_count"
    if [[ "$gap_count" -gt 0 ]]; then
      echo "$auth_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for g in d.get('linked_gaps',[]):
    print('    %-14s %-8s %s' % (g['gap_id'], g['severity'], g['title']))
" 2>/dev/null || true
    fi

    # Gap coverage from state
    local state_file="$WAVES_DIR/$wave_id/state.json"
    if [[ -f "$state_file" ]]; then
      local gap_bindings
      gap_bindings="$(python3 -c "
import json
with open('$state_file') as f:
    state = json.load(f)
bindings = state.get('gap_bindings', {})
print(len(bindings))
" 2>/dev/null || echo 0)"
      printf "  Gap Bindings: %s\n" "$gap_bindings"
    fi
    echo ""
  else
    echo "Authority Context: not available (wave not started with wave-execute)"
    echo ""
  fi
}

# ── Subcommand: land ─────────────────────────────────────────────
# Governed verify→commit→push sequence for wave output.
# approval: manual — must be invoked explicitly by operator or trusted orchestrator
#   with OPS_GOVERNED_MAIN_OVERRIDE=1 set in the calling environment.
cmd_land() {
  local wave_id="${SPINE_WAVE_ID:-}"
  local files_arg=""
  local summary=""
  local dry_run=0
  local state_file=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)            shift ;;
      --wave-id)     wave_id="${2:?--wave-id requires a value}"; shift 2 ;;
      --files)       files_arg="${2:?--files requires a value}"; shift 2 ;;
      --summary)     summary="${2:?--summary requires a value}"; shift 2 ;;
      --dry-run)     dry_run=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      *)             _fail_args "unknown argument: $1" ;;
    esac
  done

  [[ -n "$wave_id" ]]   || _fail_args "--wave-id required (or set SPINE_WAVE_ID)"
  [[ -n "$files_arg" ]] || _fail_args "--files required (comma-separated list of paths to stage)"
  [[ -n "$summary" ]]   || _fail_args "--summary required (short description for commit message)"

  _header "land"

  printf "Wave:    %s\n" "$wave_id"
  printf "Summary: %s\n" "$summary"
  echo ""

  # ── Step 1: Read authority binding ───────────────────────────
  local auth_json
  auth_json="$(_read_authority "$wave_id")"
  local loop_id
  loop_id="$(_auth_field "$auth_json" "loop_id")"
  state_file="$WAVES_DIR/$wave_id/state.json"
  printf "Loop:    %s\n" "$loop_id"
  echo ""

  # ── Step 2: Parse file allowlist ─────────────────────────────
  local -a allowlist=()
  IFS=',' read -ra raw_files <<< "$files_arg"
  for f in "${raw_files[@]}"; do
    f="${f## }"
    f="${f%% }"
    [[ -n "$f" ]] && allowlist+=("$f")
  done

  if [[ ${#allowlist[@]} -eq 0 ]]; then
    _fail "no files parsed from --files argument"
  fi

  echo "File allowlist (${#allowlist[@]} paths):"
  for f in "${allowlist[@]}"; do
    printf "  %s\n" "$f"
  done
  echo ""

  local land_checkout="$SP"
  land_checkout="$(python3 - "$state_file" "$SP" <<'PY'
import json
import sys

state_file = sys.argv[1]
fallback = sys.argv[2]

try:
    with open(state_file) as f:
        state = json.load(f)
except Exception:
    print(fallback)
    raise SystemExit(0)

workspace = state.get("workspace") if isinstance(state.get("workspace"), dict) else {}
worktree = str(workspace.get("worktree") or "").strip()
repo = str(workspace.get("repo") or "").strip()

if worktree:
    print(worktree)
elif repo:
    print(repo)
else:
    print(fallback)
PY
)"
  [[ -n "$land_checkout" ]] || _fail "unable to resolve land checkout for $wave_id"
  printf "Checkout: %s\n" "$land_checkout"
  echo ""

  # ── Step 3: Run verify.infra.run — abort if any gate fails ───
  echo "Running verify.infra.run..."
  local verify_rc=0
  local verify_output
  verify_output="$(cd "$land_checkout" && "$SP/bin/ops" cap run verify.infra.run 2>&1)" || verify_rc=$?

  # Extract pass/fail summary line from output
  local verify_summary
  verify_summary="$(echo "$verify_output" | grep "^wrapper:" | head -1 || true)"

  if [[ $verify_rc -ne 0 ]]; then
    echo ""
    echo "verify.infra.run OUTPUT:"
    echo "$verify_output" | tail -20
    echo ""
    _fail "verify.infra.run FAILED (rc=$verify_rc) — land aborted. No commit will be made."
  fi

  echo "verify.infra.run PASS: $verify_summary"
  echo ""

  if [[ $dry_run -eq 1 ]]; then
    echo "DRY RUN — would commit and push the following files:"
    for f in "${allowlist[@]}"; do
      printf "  %s\n" "$f"
    done
    echo ""
    echo "Commit message: feat(wave): land $wave_id — $summary"
    echo "Push target:    origin/$(cd "$SP" && git rev-parse --abbrev-ref HEAD)"
    echo ""
    echo "wave.execute.land: dry-run complete (no changes made)"
    exit 0
  fi

  # ── Step 4: Stage allowlisted files ──────────────────────────
  echo "Staging allowlisted files..."
  cd "$land_checkout"

  for f in "${allowlist[@]}"; do
    # Use -A so tracked deletions in the allowlist stage cleanly instead of
    # failing on a missing pathspec.
    if ! git add -A -- "$f" 2>/dev/null; then
      if git diff --cached --name-only -- "$f" | grep -Fxq "$f"; then
        continue
      fi
      _fail "git add failed for: $f"
    fi
  done

  # Verify staged set is a subset of allowlist (mirrors git-stage-commit-scoped safety check)
  local -a staged_files
  mapfile -t staged_files < <(git diff --cached --name-only | awk 'NF')

  if [[ ${#staged_files[@]} -eq 0 ]]; then
    _fail "no staged changes after allowlist stage — nothing to commit"
  fi

  declare -A allowed_map=()
  for f in "${allowlist[@]}"; do
    allowed_map["$f"]=1
  done

  local -a outside_allowlist=()
  for s in "${staged_files[@]}"; do
    if [[ -z "${allowed_map[$s]:-}" ]]; then
      outside_allowlist+=("$s")
    fi
  done

  if [[ ${#outside_allowlist[@]} -gt 0 ]]; then
    echo "staged files:" >&2
    printf '  - %s\n' "${staged_files[@]}" >&2
    echo "allowlist:" >&2
    printf '  - %s\n' "${allowlist[@]}" >&2
    _fail "staged file(s) outside allowlist: ${outside_allowlist[*]}"
  fi

  printf "Staged %d file(s)\n" "${#staged_files[@]}"
  echo ""

  # ── Step 5: Commit with governed message ─────────────────────
  local commit_message="feat(wave): land $wave_id — $summary"
  echo "Committing: $commit_message"

  local commit_rc=0
  local commit_output
  commit_output="$(OPS_GOVERNED_MAIN_OVERRIDE=1 git commit -m "$commit_message" 2>&1)" || commit_rc=$?

  if [[ $commit_rc -ne 0 ]]; then
    echo ""
    echo "git commit OUTPUT:"
    echo "$commit_output"
    echo ""
    _fail "git commit FAILED (rc=$commit_rc) — pre-commit hook may have rejected. Push aborted. Staged files remain staged; resolve and retry."
  fi

  local commit_sha
  commit_sha="$(git rev-parse HEAD)"
  echo "Committed: $commit_sha"
  echo ""

  # ── Step 6: Push ─────────────────────────────────────────────
  local branch
  branch="$(git rev-parse --abbrev-ref HEAD)"
  echo "Pushing to origin/$branch..."

  local push_rc=0
  local push_output
  push_output="$(OPS_GOVERNED_MAIN_OVERRIDE=1 git push origin "$branch" 2>&1)" || push_rc=$?

  local pushed_at
  pushed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  local push_result
  if [[ $push_rc -eq 0 ]]; then
    push_result="success"
    echo "Push: SUCCESS"
  else
    push_result="failed"
    echo ""
    echo "git push OUTPUT:"
    echo "$push_output"
    echo ""
    echo "WARN: push FAILED (rc=$push_rc) — commit $commit_sha is in place."
    echo "The commit was NOT lost. Retry push manually:"
    echo "  OPS_GOVERNED_MAIN_OVERRIDE=1 git push origin $branch"
    echo ""
  fi

  echo ""

  # ── Step 7: Write push.receipt.json ──────────────────────────
  local wave_dir="$WAVES_DIR/$wave_id"
  mkdir -p "$wave_dir"
  local receipt_file="$wave_dir/push.receipt.json"

  python3 -c "
import json, sys

receipt = {
    'wave_id': sys.argv[1],
    'loop_id': sys.argv[2],
    'commit_sha': sys.argv[3],
    'push_result': sys.argv[4],
    'pushed_at': sys.argv[5],
    'verify_status': 'pass',
    'branch': sys.argv[6],
    'summary': sys.argv[7],
    'files_staged': json.loads(sys.argv[8]),
}

with open(sys.argv[9], 'w') as f:
    json.dump(receipt, f, indent=2)
    f.write('\n')
" \
    "$wave_id" \
    "$loop_id" \
    "$commit_sha" \
    "$push_result" \
    "$pushed_at" \
    "$branch" \
    "$summary" \
    "$(python3 -c "import json,sys; print(json.dumps(sys.argv[1:]))" "${staged_files[@]}")" \
    "$receipt_file"

  echo "Receipt:  $receipt_file"
  echo ""
  echo "======================================="
  echo "WAVE LAND: $wave_id"
  if [[ "$push_result" == "success" ]]; then
    echo "STATUS: COMPLETE"
    printf "  verify.infra.run:  PASS\n"
    printf "  commit:       %s\n" "$commit_sha"
    printf "  push:         %s -> origin/%s\n" "$push_result" "$branch"
  else
    echo "STATUS: COMMIT OK / PUSH FAILED"
    printf "  verify.infra.run:  PASS\n"
    printf "  commit:       %s\n" "$commit_sha"
    printf "  push:         FAILED — retry manually\n"
  fi
  echo "======================================="
  echo ""

  # Exit non-zero if push failed so caller can detect
  if [[ "$push_result" != "success" ]]; then
    exit 1
  fi
}

# ── Self-check ───────────────────────────────────────────────────
cmd_self_check() {
  local errors=0
  for dep in python3 bash; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      echo "wave.execute self-check FAIL: missing $dep" >&2
      errors=$((errors + 1))
    fi
  done
  [[ -f "$WAVE_SH" ]] || { echo "wave.execute self-check FAIL: missing wave.sh at $WAVE_SH" >&2; errors=$((errors + 1)); }
  [[ -f "$AUTHORITY_RESOLVE" ]] || { echo "wave.execute self-check FAIL: missing authority-resolve at $AUTHORITY_RESOLVE" >&2; errors=$((errors + 1)); }
  [[ -f "$WAVE_FINISH" ]] || { echo "wave.execute self-check FAIL: missing wave-finish at $WAVE_FINISH" >&2; errors=$((errors + 1)); }

  if [[ $errors -gt 0 ]]; then
    exit 1
  fi
  echo "wave.execute self-check PASS"
  exit 0
}

# ── Dispatch ─────────────────────────────────────────────────────
case "${1:-}" in
  start)        shift; cmd_start "$@" ;;
  dispatch)     shift; cmd_dispatch "$@" ;;
  collect)      shift; cmd_collect "$@" ;;
  close)        shift; cmd_close "$@" ;;
  status)       shift; cmd_status "$@" ;;
  land)         shift; cmd_land "$@" ;;
  --self-check) cmd_self_check ;;
  -h|--help)    usage; exit 0 ;;
  "")           usage; exit 2 ;;
  *)            echo "wave.execute FAIL: unknown subcommand: $1" >&2; usage; exit 2 ;;
esac
