#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  ROOT="${SPINE_TARGET_REPO:-${SPINE_ROOT:-${SPINE_CODE:-$(pwd)}}}"
fi
REMOTE="origin"
TARGET_BRANCH="main"
SOURCE_REF=""
SOURCE_RESOLVED_REF=""
SOURCE_HEAD=""
EXPECT_HEAD=""
DRY_RUN=0
JSON_MODE=0

usage() {
  cat <<'USAGE'
coordinator-target-publish

Usage:
  coordinator-target-publish [--source-ref <ref>] [--target-branch main] [--remote origin] [--expect-head <sha>] [--dry-run] [--json]

Publishes the verified target head after routed coordinator.lane.closeout ran
with --no-push because the authority host cannot push the target branch.
USAGE
}

fail() {
  echo "coordinator.target.publish FAIL: $*" >&2
  exit 1
}

branch_worktree_path() {
  local branch="$1"
  python3 - "$ROOT" "$branch" <<'PY'
import subprocess
import sys

repo = sys.argv[1]
branch = sys.argv[2]
proc = subprocess.run(
    ["git", "-C", repo, "worktree", "list", "--porcelain"],
    text=True,
    capture_output=True,
)
if proc.returncode != 0:
    raise SystemExit(0)
current = ""
for raw in proc.stdout.splitlines():
    line = raw.strip()
    if not line:
        continue
    if line.startswith("worktree "):
        current = line.split(" ", 1)[1].strip()
        continue
    if line == f"branch refs/heads/{branch}":
        print(current)
        break
PY
}

worktree_is_clean() {
  local path="$1"
  [[ -n "$path" ]] || return 0
  [[ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ]]
}

reconcile_refused_publish_residue() {
  local target_branch="$1"
  local remote_head="$2"
  local source_head="$3"
  local local_target_head target_wt

  # Only roll back the exact guarded residue shape left by a --no-push closeout.
  if [[ -z "$EXPECT_HEAD" || "$EXPECT_HEAD" != "$source_head" ]]; then
    echo "skipped_expect_head_missing_or_mismatch"
    return 1
  fi

  local_target_head="$(git -C "$ROOT" rev-parse --verify "${target_branch}^{commit}" 2>/dev/null || true)"
  if [[ -z "$local_target_head" ]]; then
    echo "skipped_no_local_target_branch"
    return 1
  fi
  if [[ "$local_target_head" != "$source_head" ]]; then
    echo "skipped_local_target_not_unpublished_head"
    return 1
  fi

  target_wt="$(branch_worktree_path "$target_branch")"
  if [[ -n "$target_wt" ]]; then
    if ! worktree_is_clean "$target_wt"; then
      echo "blocked_dirty_target_worktree:$target_wt"
      return 1
    fi
    git -C "$target_wt" reset --hard "$remote_head" >/dev/null 2>&1 \
      || {
        echo "failed_reset_target_worktree_to_remote:$target_wt"
        return 1
      }
    echo "reset_clean_target_worktree_to_remote:$target_wt"
    return 0
  fi

  git -C "$ROOT" update-ref "refs/heads/$target_branch" "$remote_head" "$source_head" >/dev/null 2>&1 \
    || {
      echo "failed_update_target_ref_to_remote"
      return 1
    }
  echo "reset_target_ref_to_remote"
}

resolve_source_head() {
  local ref="$1"
  local head=""
  local remote_ref="$ref"

  head="$(git -C "$ROOT" rev-parse --verify "${ref}^{commit}" 2>/dev/null || true)"
  if [[ -n "$head" ]]; then
    SOURCE_RESOLVED_REF="$ref"
    SOURCE_HEAD="$head"
    return 0
  fi

  if [[ "$remote_ref" == "$REMOTE/"* ]]; then
    remote_ref="${remote_ref#"$REMOTE/"}"
  fi
  remote_ref="${remote_ref#refs/heads/}"

  git -C "$ROOT" fetch "$REMOTE" "+refs/heads/${remote_ref}:refs/remotes/${REMOTE}/${remote_ref}" >/dev/null 2>&1 \
    || true
  head="$(git -C "$ROOT" rev-parse --verify "refs/remotes/${REMOTE}/${remote_ref}^{commit}" 2>/dev/null || true)"
  if [[ -n "$head" ]]; then
    SOURCE_RESOLVED_REF="refs/remotes/${REMOTE}/${remote_ref}"
    SOURCE_HEAD="$head"
    return 0
  fi

  return 1
}

if [[ "${1:-}" == "--self-check" ]]; then
  grep -q "merge-base --is-ancestor" "$0" || fail "self-check missing fast-forward marker"
  grep -q "refs/heads/" "$0" || fail "self-check missing target push marker"
  grep -q "refs/remotes/" "$0" || fail "self-check missing remote source resolution marker"
  grep -q -- "--expect-head" "$0" || fail "self-check missing expected-head marker"
  grep -q "reconcile_refused_publish_residue" "$0" || fail "self-check missing refused-publish reconcile marker"
  grep -q 'reset --hard "$remote_head"' "$0" || fail "self-check missing target worktree reconcile marker"
  grep -q 'update-ref "refs/heads/$target_branch" "$remote_head" "$source_head"' "$0" || fail "self-check missing target ref reconcile marker"
  echo "coordinator.target.publish self-check PASS"
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --source-ref) SOURCE_REF="${2:-}"; shift 2 ;;
    --target-branch) TARGET_BRANCH="${2:-}"; shift 2 ;;
    --remote) REMOTE="${2:-}"; shift 2 ;;
    --expect-head) EXPECT_HEAD="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --json) JSON_MODE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown arg: $1" ;;
  esac
done

git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "not a git repository: $ROOT"
[[ -n "$TARGET_BRANCH" && "$TARGET_BRANCH" != "HEAD" ]] || fail "invalid target branch: $TARGET_BRANCH"

if [[ -z "$SOURCE_REF" ]]; then
  SOURCE_REF="HEAD"
  if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]]; then
    fail "worktree must be clean when --source-ref is omitted"
  fi
fi

resolve_source_head "$SOURCE_REF" \
  || fail "source ref does not resolve to a commit: $SOURCE_REF"
source_head="$SOURCE_HEAD"
if [[ -n "$EXPECT_HEAD" && "$source_head" != "$EXPECT_HEAD" ]]; then
  fail "source head mismatch for $SOURCE_REF (source=$source_head expected=$EXPECT_HEAD)"
fi

git -C "$ROOT" fetch "$REMOTE" "$TARGET_BRANCH" >/dev/null 2>&1 || true
remote_target_head="$(git -C "$ROOT" ls-remote --heads "$REMOTE" "$TARGET_BRANCH" 2>/dev/null | awk '{print $1}' | head -1 || true)"
[[ -n "$remote_target_head" ]] || fail "missing remote target branch: $REMOTE/$TARGET_BRANCH"

git -C "$ROOT" cat-file -e "${remote_target_head}^{commit}" 2>/dev/null \
  || git -C "$ROOT" fetch "$REMOTE" "$TARGET_BRANCH" >/dev/null 2>&1 \
  || fail "cannot fetch remote target head object: $remote_target_head"

if ! git -C "$ROOT" merge-base --is-ancestor "$remote_target_head" "$source_head" >/dev/null 2>&1; then
  target_reconcile_status="not_attempted"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    if target_reconcile_status="$(reconcile_refused_publish_residue "$TARGET_BRANCH" "$remote_target_head" "$source_head")"; then
      fail "non-fast-forward target publish refused: $REMOTE/$TARGET_BRANCH=$remote_target_head source=$source_head; target_checkout_reconcile=$target_reconcile_status"
    fi
  fi
  fail "non-fast-forward target publish refused: $REMOTE/$TARGET_BRANCH=$remote_target_head source=$source_head; target_checkout_reconcile=$target_reconcile_status"
fi

publish_required=0
publish_status="already_published"
if [[ "$remote_target_head" != "$source_head" ]]; then
  publish_required=1
  publish_status="publish_required"
fi

publish_command="git -C $ROOT push $REMOTE $source_head:refs/heads/$TARGET_BRANCH"
if [[ "$DRY_RUN" -eq 0 && "$publish_required" -eq 1 ]]; then
  push_output="$(git -C "$ROOT" push "$REMOTE" "$source_head:refs/heads/$TARGET_BRANCH" 2>&1)" \
    || fail "push failed: $REMOTE/$TARGET_BRANCH. Remote said: ${push_output:-<no output>}"
  remote_target_head_after="$(git -C "$ROOT" ls-remote --heads "$REMOTE" "$TARGET_BRANCH" 2>/dev/null | awk '{print $1}' | head -1 || true)"
  [[ "$remote_target_head_after" == "$source_head" ]] || fail "remote target head did not match after publish"
  publish_status="published"
else
  remote_target_head_after="$remote_target_head"
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  publish_status="dry_run_${publish_status}"
fi

if [[ "$JSON_MODE" -eq 1 ]]; then
  python3 - "$publish_status" "$ROOT" "$REMOTE" "$TARGET_BRANCH" "$SOURCE_REF" "$SOURCE_RESOLVED_REF" "$source_head" "$remote_target_head" "$remote_target_head_after" "$publish_required" "$publish_command" <<'PY'
import json
import sys

(
    status,
    repo,
    remote,
    target_branch,
    source_ref,
    source_resolved_ref,
    source_head,
    remote_target_head_before,
    remote_target_head_after,
    publish_required,
    publish_command,
) = sys.argv[1:12]
print(json.dumps(
    {
        "capability": "coordinator.target.publish",
        "status": status,
        "repo": repo,
        "remote": remote,
        "target_branch": target_branch,
        "source_ref": source_ref,
        "source_resolved_ref": source_resolved_ref,
        "source_head": source_head,
        "remote_target_head_before": remote_target_head_before,
        "remote_target_head_after": remote_target_head_after,
        "publish_required": publish_required == "1",
        "publish_command": publish_command,
    },
    indent=2,
    sort_keys=True,
))
PY
else
  echo "coordinator.target.publish"
  echo "status: $publish_status"
  echo "target_branch: $TARGET_BRANCH"
  echo "source_ref: $SOURCE_REF"
  echo "source_resolved_ref: $SOURCE_RESOLVED_REF"
  echo "source_head: $source_head"
  echo "remote_target_head_before: $remote_target_head"
  echo "remote_target_head_after: $remote_target_head_after"
  echo "publish_required: $publish_required"
  echo "publish_command: $publish_command"
fi
