#!/usr/bin/env bash
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
CONTRACT="$ROOT/ops/bindings/loop.closeout.contract.yaml"
DISPOSITION_CONTRACT="$ROOT/ops/bindings/closeout.disposition.contract.yaml"
GAPS_FILE="$ROOT/ops/bindings/operational.gaps.yaml"
GAPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/gaps-authority-bridge"

source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
source "$ROOT/ops/lib/git-lock.sh"
SCOPES_DIR="$SPINE_STATE/loop-scopes"

usage() {
  cat <<'USAGE'
loop-closeout-finalize

Usage:
  loop-closeout-finalize --loop-id LOOP-... --acceptance-matrix <path> \
    --disposition <state> [--regression-lock-id D###-...] [--evidence <ref>] [--owner <owner>] \
    [--expiry-check <date-or-cadence>] [--root-cause <text>] \
    [--propagation-evidence <text>] \
    [--completion-level <level>] \
    [--receipt-path <path>] [--no-close-linked-gaps] \
    [--cleanup-branch <branch-name>]

Validation:
  - acceptance matrix has PASS state with no FAIL rows/placeholders
  - required run keys exist in acceptance matrix or companion supervisor receipt
  - decision is MERGE_READY or DONE
  - blocker_count is zero when explicitly declared
  - disposition: landed requires --propagation-evidence when contract enforces it
  - disposition: landed requires --completion-level (slice_complete|loop_complete|domain_complete|estate_complete|readiness_complete)

Behavior:
  - closes loop scope status to closed
  - closes linked open gaps (status=fixed) unless --no-close-linked-gaps
  - enforces fix-to-lock for linked high/critical gaps
  - emits a single closeout receipt markdown file
  - if --cleanup-branch is specified: deletes local and remote branch refs
    (only if merged into main and not protected; skips with reason otherwise)
  - archives loop artifacts (exec receipts, controller prompts, wave files)
    to $SPINE_STATE/archive/{completed-receipts,completed-prompts,old-waves}/
  - purges orphaned .fuse_hidden* files and stale .pid/.lock files
USAGE
}

SELF_CHECK=0
LOOP_ID=""
ACCEPTANCE_MATRIX=""
REGRESSION_LOCK_ID=""
EVIDENCE=""
OWNER=""
EXPIRY_CHECK=""
ROOT_CAUSE=""
PROPAGATION_EVIDENCE=""
RECEIPT_PATH=""
CLOSE_LINKED_GAPS=1
CLEANUP_BRANCH=""
DISPOSITION=""
COMPLETION_LEVEL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      ;;
    --self-check)
      SELF_CHECK=1
      shift
      ;;
    --loop-id)
      LOOP_ID="${2:-}"
      shift 2
      ;;
    --acceptance-matrix)
      ACCEPTANCE_MATRIX="${2:-}"
      shift 2
      ;;
    --regression-lock-id)
      REGRESSION_LOCK_ID="${2:-}"
      shift 2
      ;;
    --disposition)
      DISPOSITION="${2:-}"
      shift 2
      ;;
    --completion-level)
      COMPLETION_LEVEL="${2:-}"
      shift 2
      ;;
    --evidence)
      EVIDENCE="${2:-}"
      shift 2
      ;;
    --owner)
      OWNER="${2:-}"
      shift 2
      ;;
    --expiry-check)
      EXPIRY_CHECK="${2:-}"
      shift 2
      ;;
    --root-cause)
      ROOT_CAUSE="${2:-}"
      shift 2
      ;;
    --propagation-evidence)
      PROPAGATION_EVIDENCE="${2:-}"
      shift 2
      ;;
    --receipt-path)
      RECEIPT_PATH="${2:-}"
      shift 2
      ;;
    --no-close-linked-gaps)
      CLOSE_LINKED_GAPS=0
      shift
      ;;
    --cleanup-branch)
      CLEANUP_BRANCH="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "loop.closeout.finalize FAIL: unknown arg: $1" >&2
      usage
      exit 2
      ;;
  esac
done

for required in "$CONTRACT" "$SCOPES_DIR" "$GAPS_FILE" "$ROOT/ops/commands/loops.sh"; do
  [[ -e "$required" ]] || {
    echo "loop.closeout.finalize FAIL: missing required path: $required" >&2
    exit 1
  }
done
command -v yq >/dev/null 2>&1 || { echo "loop.closeout.finalize FAIL: missing dependency yq" >&2; exit 1; }
command -v rg >/dev/null 2>&1 || { echo "loop.closeout.finalize FAIL: missing dependency rg" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "loop.closeout.finalize FAIL: missing dependency python3" >&2; exit 1; }

if [[ "$SELF_CHECK" -eq 1 ]]; then
  yq e '.version and .validation and .fix_to_lock and .protected_lanes and .closeout_receipts' "$CONTRACT" >/dev/null
  echo "loop.closeout.finalize self-check PASS: contract and dependencies present"
  exit 0
fi

[[ -n "$LOOP_ID" ]] || { echo "loop.closeout.finalize FAIL: --loop-id required" >&2; exit 2; }
[[ -n "$ACCEPTANCE_MATRIX" ]] || { echo "loop.closeout.finalize FAIL: --acceptance-matrix required" >&2; exit 2; }
[[ -n "$DISPOSITION" ]] || { echo "loop.closeout.finalize FAIL: --disposition required" >&2; exit 2; }

if [[ "$ACCEPTANCE_MATRIX" != /* ]]; then
  ACCEPTANCE_MATRIX="$ROOT/$ACCEPTANCE_MATRIX"
fi
[[ -f "$ACCEPTANCE_MATRIX" ]] || { echo "loop.closeout.finalize FAIL: acceptance matrix not found: $ACCEPTANCE_MATRIX" >&2; exit 1; }

RUN_KEY_REGEX="$(yq e -r '.validation.run_key_regex // "^(CAP-[0-9]{8}-[0-9]{6}__[A-Za-z0-9._-]+__R[A-Za-z0-9]+|S[0-9]{8}-[0-9]{6}__[A-Za-z0-9._-]+__R[A-Za-z0-9]+)$"' "$CONTRACT")"
MIN_RUN_KEYS="$(yq e -r '.validation.min_required_run_keys // 1' "$CONTRACT")"
RECEIPT_DIR_REL="$(yq e -r '.closeout_receipts.directory // ""' "$CONTRACT")"
[[ -n "$RECEIPT_DIR_REL" && "$RECEIPT_DIR_REL" != "null" ]] || RECEIPT_DIR_REL="${SPINE_LOOP_CLOSEOUTS_ROOT:-$HOME/code/.evidence/spine/loop-closeouts}"
REQUIRE_MATRIX_PASS="$(yq e -r '.validation.require_acceptance_pass // true' "$CONTRACT")"
DISPOSITION_CSV="landed,deferred,superseded,abandoned"
if command -v yq >/dev/null 2>&1 && [[ -f "$DISPOSITION_CONTRACT" ]]; then
  disposition_accum=""
  while IFS= read -r disposition_item; do
    [[ -n "$disposition_item" && "$disposition_item" != "null" ]] || continue
    if [[ -n "$disposition_accum" ]]; then
      disposition_accum+=",$disposition_item"
    else
      disposition_accum="$disposition_item"
    fi
  done < <(yq e -r '.terminal_dispositions.allowed[]?' "$DISPOSITION_CONTRACT" 2>/dev/null || true)
  [[ -n "$disposition_accum" ]] && DISPOSITION_CSV="$disposition_accum"
fi
IFS=',' read -r -a ALLOWED_DISPOSITIONS <<< "$DISPOSITION_CSV"
disposition_ok=0
for allowed_disposition in "${ALLOWED_DISPOSITIONS[@]}"; do
  if [[ "$DISPOSITION" == "$allowed_disposition" ]]; then
    disposition_ok=1
    break
  fi
done
if [[ "$disposition_ok" -ne 1 ]]; then
  echo "loop.closeout.finalize FAIL: invalid disposition '$DISPOSITION' (allowed: ${DISPOSITION_CSV//,/|})" >&2
  exit 1
fi

# ── Propagation enforcement gate ──
# When the closeout contract requires propagation evidence for "landed",
# block the closeout unless --propagation-evidence is provided.
PROPAGATION_REQUIRED="false"
if [[ -f "$CONTRACT" ]]; then
  PROPAGATION_REQUIRED="$(yq e -r '.propagation.require_for_landed // false' "$CONTRACT")"
fi
if [[ "$DISPOSITION" == "landed" && "$PROPAGATION_REQUIRED" == "true" ]]; then
  if [[ -z "$PROPAGATION_EVIDENCE" ]]; then
    echo "loop.closeout.finalize FAIL: disposition 'landed' requires --propagation-evidence" >&2
    echo "" >&2
    echo "  The closeout contract (propagation.require_for_landed: true) requires proof" >&2
    echo "  that all propagation surfaces agree before 'landed' disposition." >&2
    echo "" >&2
    echo "  Required propagation surfaces:" >&2
    while IFS= read -r surface; do
      [[ -n "$surface" && "$surface" != "null" ]] && echo "    - $surface" >&2
    done < <(yq e -r '.propagation.surfaces[]?' "$CONTRACT" 2>/dev/null || true)
    echo "" >&2
    echo "  Provide --propagation-evidence with a reference (path, commit, or attestation text)" >&2
    echo "  describing how each surface was verified." >&2
    echo "" >&2
    echo "  If propagation is incomplete, use --disposition deferred instead." >&2
    exit 1
  fi
fi

# ── Completion level enforcement gate ──
# When the disposition contract requires completion_level for "landed",
# block the closeout unless --completion-level is provided and valid.
COMPLETION_LEVEL_REQUIRED="false"
if [[ -f "$DISPOSITION_CONTRACT" ]]; then
  COMPLETION_LEVEL_REQUIRED="$(yq e -r '.completion_levels.enforcement.require_on_landed // false' "$DISPOSITION_CONTRACT")"
fi
if [[ "$DISPOSITION" == "landed" && "$COMPLETION_LEVEL_REQUIRED" == "true" ]]; then
  if [[ -z "$COMPLETION_LEVEL" ]]; then
    cl_message="$(yq e -r '.completion_levels.enforcement.message // ""' "$DISPOSITION_CONTRACT" 2>/dev/null || true)"
    echo "loop.closeout.finalize FAIL: ${cl_message:-disposition: landed requires --completion-level}" >&2
    echo "" >&2
    echo "  Allowed levels:" >&2
    while IFS= read -r cl_item; do
      [[ -n "$cl_item" && "$cl_item" != "null" ]] && echo "    - $cl_item" >&2
    done < <(yq e -r '.completion_levels.allowed[]?' "$DISPOSITION_CONTRACT" 2>/dev/null || true)
    echo "" >&2
    echo "  If completion level is unclear, use --disposition deferred instead." >&2
    exit 1
  fi
  # Validate completion level against allowed list
  cl_csv=""
  while IFS= read -r cl_item; do
    [[ -n "$cl_item" && "$cl_item" != "null" ]] || continue
    if [[ -n "$cl_csv" ]]; then
      cl_csv+=",$cl_item"
    else
      cl_csv="$cl_item"
    fi
  done < <(yq e -r '.completion_levels.allowed[]?' "$DISPOSITION_CONTRACT" 2>/dev/null || true)
  if [[ -n "$cl_csv" ]]; then
    IFS=',' read -r -a ALLOWED_CL <<< "$cl_csv"
    cl_ok=0
    for allowed_cl in "${ALLOWED_CL[@]}"; do
      if [[ "$COMPLETION_LEVEL" == "$allowed_cl" ]]; then
        cl_ok=1
        break
      fi
    done
    if [[ "$cl_ok" -ne 1 ]]; then
      echo "loop.closeout.finalize FAIL: invalid completion_level '$COMPLETION_LEVEL' (allowed: ${cl_csv//,/|})" >&2
      exit 1
    fi
  fi
fi

mapfile -t PROTECTED_LOOPS < <(yq e -r '.protected_lanes.loops[]? // ""' "$CONTRACT" | sed '/^$/d')
mapfile -t PROTECTED_LOOP_PREFIXES < <(yq e -r '.protected_lanes.loop_prefixes[]? // ""' "$CONTRACT" | sed '/^$/d')
mapfile -t PROTECTED_GAPS < <(yq e -r '.protected_lanes.gaps[]? // ""' "$CONTRACT" | sed '/^$/d')
mapfile -t P0P1_SEVERITIES < <(yq e -r '.fix_to_lock.p0_p1_severities[]? // ""' "$CONTRACT" | sed '/^$/d')

if [[ "${#P0P1_SEVERITIES[@]}" -eq 0 ]]; then
  P0P1_SEVERITIES=(critical high)
fi

for protected in "${PROTECTED_LOOPS[@]}"; do
  [[ "$LOOP_ID" != "$protected" ]] || {
    echo "loop.closeout.finalize FAIL: loop is protected lane: $LOOP_ID" >&2
    exit 1
  }
done
for prefix in "${PROTECTED_LOOP_PREFIXES[@]}"; do
  [[ "$LOOP_ID" == "$prefix"* ]] && {
    echo "loop.closeout.finalize FAIL: loop matches protected prefix '$prefix': $LOOP_ID" >&2
    exit 1
  }
done

SCOPE_FILE="$SCOPES_DIR/${LOOP_ID}.scope.md"
[[ -f "$SCOPE_FILE" ]] || { echo "loop.closeout.finalize FAIL: scope file not found: $SCOPE_FILE" >&2; exit 1; }

current_status="$(awk '/^status:/{print $2; exit}' "$SCOPE_FILE" | tr -d '"' || true)"
case "$current_status" in
  active|draft|open) ;;
  closed)
    echo "loop.closeout.finalize FAIL: loop already closed: $LOOP_ID" >&2
    exit 1
    ;;
  *)
    echo "loop.closeout.finalize FAIL: unsupported loop status '$current_status' for $LOOP_ID" >&2
    exit 1
    ;;
esac

validation_json="$(python3 - "$ACCEPTANCE_MATRIX" "$RUN_KEY_REGEX" "$MIN_RUN_KEYS" <<'PY'
import pathlib
import re
import sys
import json

matrix_path = pathlib.Path(sys.argv[1])
run_key_re = re.compile(sys.argv[2], re.MULTILINE)
min_keys = int(sys.argv[3])
text = matrix_path.read_text(encoding="utf-8")

errors = []

if "<value>" in text:
    errors.append("acceptance matrix contains <value> placeholders")
if "PASS/FAIL" in text:
    errors.append("acceptance matrix contains PASS/FAIL placeholders")
if re.search(r"\|\s*FAIL\s*\|", text):
    errors.append("acceptance matrix contains FAIL result rows")

run_key_count = len(run_key_re.findall(text))
companion_files = []
if run_key_count < min_keys:
    name = matrix_path.name
    stem_prefix = name.split("ACCEPTANCE_MATRIX", 1)[0]
    if stem_prefix:
        candidate_names = [
            f"{stem_prefix}SUPERVISOR_MASTER_RECEIPT.md",
            f"{stem_prefix}MASTER_RECEIPT.md",
        ]
        for candidate in candidate_names:
            p = matrix_path.parent / candidate
            if p.exists():
                companion_files.append(str(p))
                run_key_count += len(run_key_re.findall(p.read_text(encoding="utf-8")))

if run_key_count < min_keys:
    errors.append(f"required run keys missing: found={run_key_count}, min_required={min_keys}")

decision = None
match = re.search(r"^decision:\s*([A-Z_]+)\s*$", text, flags=re.MULTILINE)
if match:
    decision = match.group(1)

for line in text.splitlines():
    line = line.strip()
    m = re.match(r"^\|\s*decision\s*\|[^|]*\|\s*`?([A-Z_]+)`?\s*\|", line)
    if m:
        decision = m.group(1)
    m = re.match(r"^\|\s*final_decision\s*\|\s*`?([A-Z_]+)`?\s*\|", line)
    if m:
        decision = m.group(1)

if decision is None:
    errors.append("unable to resolve decision from acceptance matrix")
elif decision not in {"MERGE_READY", "DONE"}:
    errors.append(f"decision must be MERGE_READY or DONE, got {decision}")

blocker_count = None
for line in text.splitlines():
    line = line.strip()
    m = re.match(r"^\|\s*blocker_count\s*\|\s*`?([0-9]+)`?\s*\|", line)
    if m:
        blocker_count = int(m.group(1))
        break

if blocker_count is not None and blocker_count > 0:
    errors.append(f"blocker_count must be 0, got {blocker_count}")

pass_rows = len(re.findall(r"\|\s*PASS\s*\|", text))
if pass_rows == 0 and "score:" not in text and "acceptance_score" not in text:
    errors.append("acceptance matrix has no PASS evidence")

if errors:
    for err in errors:
        print(f"loop.closeout.finalize FAIL: {err}", file=sys.stderr)
    sys.exit(1)

print(json.dumps({
    "decision": decision,
    "blocker_count": blocker_count if blocker_count is not None else 0,
    "run_key_count": run_key_count,
    "companion_files": companion_files,
    "pass_rows": pass_rows,
}))
PY
)"

if [[ "$REQUIRE_MATRIX_PASS" != "true" ]]; then
  echo "loop.closeout.finalize WARN: contract disables strict acceptance-pass enforcement"
fi

declare -a LINKED_GAP_IDS=()
declare -a LINKED_GAP_SEVERITIES=()
while IFS=$'\t' read -r gid sev; do
  [[ -n "$gid" ]] || continue
  LINKED_GAP_IDS+=("$gid")
  LINKED_GAP_SEVERITIES+=("${sev,,}")
done < <(yq e -r ".gaps[] | select((.parent_loop // \"\") == \"$LOOP_ID\" and .status == \"open\") | [.id, (.severity // \"\")] | @tsv" "$GAPS_FILE")

linked_open_count="${#LINKED_GAP_IDS[@]}"
closed_gap_count=0
blocked_gap_count=0

severity_requires_fix_to_lock() {
  local severity="${1,,}"
  local sev
  for sev in "${P0P1_SEVERITIES[@]}"; do
    [[ "$severity" == "${sev,,}" ]] && return 0
  done
  return 1
}

is_protected_gap() {
  local gid="$1"
  local g
  for g in "${PROTECTED_GAPS[@]}"; do
    [[ "$gid" == "$g" ]] && return 0
  done
  return 1
}

if [[ "$CLOSE_LINKED_GAPS" -eq 1 ]]; then
  for idx in "${!LINKED_GAP_IDS[@]}"; do
    gid="${LINKED_GAP_IDS[$idx]}"
    sev="${LINKED_GAP_SEVERITIES[$idx]}"

    if is_protected_gap "$gid"; then
      echo "loop.closeout.finalize FAIL: linked gap is protected and cannot be closed: $gid" >&2
      blocked_gap_count=$((blocked_gap_count + 1))
      continue
    fi

    if severity_requires_fix_to_lock "$sev"; then
      if [[ -z "$REGRESSION_LOCK_ID" || -z "$EVIDENCE" ]]; then
        echo "loop.closeout.finalize FAIL: linked $sev gap $gid requires --regression-lock-id and --evidence" >&2
        blocked_gap_count=$((blocked_gap_count + 1))
        continue
      fi
    fi
  done
fi

if [[ "$blocked_gap_count" -gt 0 ]]; then
  echo "loop.closeout.finalize FAIL: blocker_count=$blocked_gap_count (loop remains active)" >&2
  exit 1
fi

acquire_git_lock gaps || exit 1
trap 'release_git_lock' EXIT INT TERM

timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ "$CLOSE_LINKED_GAPS" -eq 1 ]]; then
  close_note="Closed by loop.closeout.finalize (${SPINE_CAP_RUN_KEY:-manual})"

  for idx in "${!LINKED_GAP_IDS[@]}"; do
    gid="${LINKED_GAP_IDS[$idx]}"
    sev="${LINKED_GAP_SEVERITIES[$idx]}"

    # Close gap via SQLite authority bridge (writes SQLite, projects to YAML).
    bridge_args=("close" "--id" "$gid" "--status" "fixed" "--fixed-in" "$LOOP_ID")
    bridge_args+=("--notes" "$close_note")
    bridge_args+=("--actor" "loop.closeout.finalize")
    bridge_args+=("--reason" "Linked gap closed by loop closeout: $LOOP_ID")

    # Flow completion_level from closeout into gap authority (Part D binding).
    [[ -n "$COMPLETION_LEVEL" ]] && bridge_args+=("--completion-level" "$COMPLETION_LEVEL")

    if severity_requires_fix_to_lock "$sev"; then
      [[ -n "$REGRESSION_LOCK_ID" ]] && bridge_args+=("--regression-lock-id" "$REGRESSION_LOCK_ID")
      [[ -n "$EVIDENCE" ]] && bridge_args+=("--evidence" "$EVIDENCE")
      [[ -n "$OWNER" ]] && bridge_args+=("--owner" "$OWNER")
      [[ -n "$EXPIRY_CHECK" ]] && bridge_args+=("--expiry-check" "$EXPIRY_CHECK")
      [[ -n "$ROOT_CAUSE" ]] && bridge_args+=("--root-cause" "$ROOT_CAUSE")
    fi

    python3 "$GAPS_BRIDGE" "${bridge_args[@]}" >/dev/null || {
      echo "loop.closeout.finalize FAIL: bridge close failed for $gid" >&2
      exit 1
    }

    closed_gap_count=$((closed_gap_count + 1))
  done
fi

# Atomic frontmatter status mutation.
tmp_file="$(mktemp "${SCOPE_FILE}.tmp.XXXXXX")"
if ! python3 - "$SCOPE_FILE" "$tmp_file" "$DISPOSITION" "$timestamp" "$COMPLETION_LEVEL" <<'PY'
import sys
from pathlib import Path

scope_path = Path(sys.argv[1])
tmp_path = Path(sys.argv[2])
disposition = sys.argv[3].strip()
timestamp = sys.argv[4].strip()
completion_level = sys.argv[5].strip() if len(sys.argv) > 5 else ""

lines = scope_path.read_text(encoding="utf-8").splitlines()
if not lines or lines[0].strip() != "---":
    raise SystemExit(2)

end_idx = None
for idx in range(1, len(lines)):
    if lines[idx].strip() == "---":
        end_idx = idx
        break
if end_idx is None:
    raise SystemExit(2)

frontmatter = lines[1:end_idx]
rest = lines[end_idx + 1 :]
indices = {}
for idx, line in enumerate(frontmatter):
    if ":" not in line:
        continue
    key = line.split(":", 1)[0].strip()
    if key and key not in indices:
        indices[key] = idx

updates = {
    "status": "status: closed",
    "closed_at": f'closed_at: "{timestamp}"',
    "disposition": f"disposition: {disposition}",
}
if completion_level:
    updates["completion_level"] = f"completion_level: {completion_level}"

for key, line in updates.items():
    if key in indices:
        frontmatter[indices[key]] = line
    else:
        frontmatter.append(line)

output = ["---", *frontmatter, "---", *rest]
tmp_path.write_text("\n".join(output) + "\n", encoding="utf-8")
PY
then
  rm -f "$tmp_file"
  echo "loop.closeout.finalize FAIL: unable to update loop status in $SCOPE_FILE" >&2
  exit 1
fi
mv "$tmp_file" "$SCOPE_FILE"

# ── SQLite authority bridge: record close in shared_authority.db ──
# TODO: make authoritative once bridge is proven; non-fatal during transition.
# Scope file write already succeeded above; bridge failure does not block closeout.
LOOPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/loops-authority-bridge"
if [[ -x "$LOOPS_BRIDGE" ]]; then
  bridge_close_args=("close" "--id" "$LOOP_ID" "--status" "closed"
    "--disposition" "$DISPOSITION"
    "--actor" "loop.closeout.finalize"
    "--reason" "Closed via loop.closeout.finalize (run_key=${SPINE_CAP_RUN_KEY:-manual})"
  )
  [[ -n "$COMPLETION_LEVEL" ]] && bridge_close_args+=("--completion-level" "$COMPLETION_LEVEL")
  if python3 "$LOOPS_BRIDGE" "${bridge_close_args[@]}" 2>/dev/null; then
    echo "loops-authority-bridge: recorded close for $LOOP_ID in shared_authority.db" >&2
  else
    echo "loops-authority-bridge: close failed (non-fatal, scope file is primary)" >&2
  fi
fi

if [[ -z "$RECEIPT_PATH" ]]; then
  if [[ "$RECEIPT_DIR_REL" == /* ]]; then
    RECEIPT_PATH="$RECEIPT_DIR_REL/${LOOP_ID}.closeout.md"
  else
    RECEIPT_PATH="$ROOT/$RECEIPT_DIR_REL/${LOOP_ID}.closeout.md"
  fi
elif [[ "$RECEIPT_PATH" != /* ]]; then
  RECEIPT_PATH="$ROOT/$RECEIPT_PATH"
fi
mkdir -p "$(dirname "$RECEIPT_PATH")"

matrix_decision="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("decision","unknown"))' "$validation_json")"
matrix_run_keys="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("run_key_count",0))' "$validation_json")"

cat > "$RECEIPT_PATH" <<EOF
# Loop Closeout Receipt

- loop_id: $LOOP_ID
- status: closed
- disposition: $DISPOSITION
- completion_level: ${COMPLETION_LEVEL:-n/a}
- acceptance_matrix: $ACCEPTANCE_MATRIX
- matrix_decision: $matrix_decision
- matrix_run_key_count: $matrix_run_keys
- linked_open_gaps_before: $linked_open_count
- linked_gaps_closed: $closed_gap_count
- linked_gap_close_mode: $([[ "$CLOSE_LINKED_GAPS" -eq 1 ]] && echo "enabled" || echo "disabled")
- regression_lock_id_applied: ${REGRESSION_LOCK_ID:-n/a}
- evidence_reference: ${EVIDENCE:-n/a}
- propagation_evidence: ${PROPAGATION_EVIDENCE:-n/a}
- propagation_required: $PROPAGATION_REQUIRED
- closeout_gate: D289 loop-closeout-completeness-lock
- capability: loop.closeout.finalize
- run_key: ${SPINE_CAP_RUN_KEY:-manual}
- generated_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

release_git_lock
trap - EXIT INT TERM

# ── Inline branch cleanup (post-close) ──
BRANCH_CLEANUP_STATUS="skipped"
BRANCH_CLEANUP_REASON="not requested"
if [[ -n "$CLEANUP_BRANCH" ]]; then
  CURRENT_BRANCH="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"

  # Load protected branch regexes from nightly closeout contract
  NIGHTLY_CONTRACT="$ROOT/ops/bindings/nightly.closeout.contract.yaml"
  PROTECTED_BRANCH_REGEXES=("^main$")
  if command -v yq >/dev/null 2>&1 && [[ -f "$NIGHTLY_CONTRACT" ]]; then
    while IFS= read -r rx; do
      [[ -n "$rx" && "$rx" != "null" ]] && PROTECTED_BRANCH_REGEXES+=("$rx")
    done < <(yq e -r '.protected_scope.branch_regexes[]?' "$NIGHTLY_CONTRACT" 2>/dev/null || true)
  fi

  # Guard 1: not protected
  is_cleanup_protected=0
  for rx in "${PROTECTED_BRANCH_REGEXES[@]}"; do
    if [[ "$CLEANUP_BRANCH" =~ $rx ]]; then
      is_cleanup_protected=1
      break
    fi
  done

  if [[ "$is_cleanup_protected" -eq 1 ]]; then
    BRANCH_CLEANUP_STATUS="skipped"
    BRANCH_CLEANUP_REASON="branch matches protected regex"
    echo "loop.closeout.finalize WARN: branch cleanup skipped: $CLEANUP_BRANCH ($BRANCH_CLEANUP_REASON)"
  elif [[ "$CLEANUP_BRANCH" == "$CURRENT_BRANCH" ]]; then
    BRANCH_CLEANUP_STATUS="skipped"
    BRANCH_CLEANUP_REASON="branch is currently checked out"
    echo "loop.closeout.finalize WARN: branch cleanup skipped: $CLEANUP_BRANCH ($BRANCH_CLEANUP_REASON)"
  elif ! git -C "$ROOT" rev-parse --verify "$CLEANUP_BRANCH" >/dev/null 2>&1; then
    BRANCH_CLEANUP_STATUS="skipped"
    BRANCH_CLEANUP_REASON="branch does not exist locally"
    echo "loop.closeout.finalize WARN: branch cleanup skipped: $CLEANUP_BRANCH ($BRANCH_CLEANUP_REASON)"
  elif ! git -C "$ROOT" merge-base --is-ancestor "$CLEANUP_BRANCH" main >/dev/null 2>&1; then
    # Guard 2: must be merged into main
    BRANCH_CLEANUP_STATUS="skipped"
    BRANCH_CLEANUP_REASON="branch is not merged into main (merge-base check failed)"
    echo "loop.closeout.finalize WARN: branch cleanup skipped: $CLEANUP_BRANCH ($BRANCH_CLEANUP_REASON)"
  else
    # All preconditions passed - safe to delete
    BRANCH_CLEANUP_STATUS="attempted"
    local_ok=0
    if git -C "$ROOT" branch -d "$CLEANUP_BRANCH" >/dev/null 2>&1; then
      local_ok=1
      echo "loop.closeout.finalize: deleted local branch $CLEANUP_BRANCH"
    else
      echo "loop.closeout.finalize WARN: failed to delete local branch $CLEANUP_BRANCH"
    fi

    # Remote cleanup (best-effort for each configured remote)
    for remote_name in origin github; do
      if git -C "$ROOT" remote get-url "$remote_name" >/dev/null 2>&1; then
        if git -C "$ROOT" ls-remote --exit-code "$remote_name" "refs/heads/$CLEANUP_BRANCH" >/dev/null 2>&1; then
          if git -C "$ROOT" push "$remote_name" --delete "$CLEANUP_BRANCH" >/dev/null 2>&1; then
            echo "loop.closeout.finalize: deleted $remote_name/$CLEANUP_BRANCH"
          else
            echo "loop.closeout.finalize WARN: failed to delete $remote_name/$CLEANUP_BRANCH"
          fi
        fi
      fi
    done

    if [[ "$local_ok" -eq 1 ]]; then
      BRANCH_CLEANUP_STATUS="completed"
      BRANCH_CLEANUP_REASON="branch deleted (merged, not protected)"
    else
      BRANCH_CLEANUP_STATUS="partial"
      BRANCH_CLEANUP_REASON="local delete failed, remote may have succeeded"
    fi
  fi
fi

# ── GC: Archive loop artifacts & purge orphans ──
GC_ARCHIVE_ROOT="$SPINE_STATE/archive"
GC_PROMPTS_DIR="$GC_ARCHIVE_ROOT/completed-prompts"
GC_RECEIPTS_DIR="$GC_ARCHIVE_ROOT/completed-receipts"
GC_WAVES_DIR="$GC_ARCHIVE_ROOT/old-waves"
GC_MOVED=0
GC_PURGED=0

mkdir -p "$GC_PROMPTS_DIR" "$GC_RECEIPTS_DIR" "$GC_WAVES_DIR"

# Archive EXEC_RECEIPT files belonging to this loop
for f in "$SPINE_STATE"/EXEC_RECEIPT*.yaml; do
  [[ -f "$f" ]] || continue
  if grep -q "loop_id:.*${LOOP_ID}" "$f" 2>/dev/null; then
    mv "$f" "$GC_RECEIPTS_DIR/"
    GC_MOVED=$((GC_MOVED + 1))
  fi
done

# Archive controller prompts referencing this loop
for f in "$SPINE_STATE"/*CONTROLLER_PROMPT*.md; do
  [[ -f "$f" ]] || continue
  if grep -q "$LOOP_ID" "$f" 2>/dev/null; then
    mv "$f" "$GC_PROMPTS_DIR/"
    GC_MOVED=$((GC_MOVED + 1))
  fi
done

# Archive wave artifacts referencing this loop
for f in "$SPINE_STATE"/wave*.md "$SPINE_STATE"/wave*.yaml; do
  [[ -f "$f" ]] || continue
  if grep -q "$LOOP_ID" "$f" 2>/dev/null; then
    mv "$f" "$GC_WAVES_DIR/"
    GC_MOVED=$((GC_MOVED + 1))
  fi
done

# Purge orphaned FUSE artifacts (always safe to remove)
while IFS= read -r -d '' orphan; do
  rm -f "$orphan"
  GC_PURGED=$((GC_PURGED + 1))
done < <(find "$SPINE_STATE" -maxdepth 2 -name '.fuse_hidden*' -type f -print0 2>/dev/null)

# Purge stale PID files (referenced process no longer running)
while IFS= read -r -d '' pidfile; do
  pid_val="$(head -1 "$pidfile" 2>/dev/null | tr -dc '0-9')"
  if [[ -n "$pid_val" ]] && ! kill -0 "$pid_val" 2>/dev/null; then
    rm -f "$pidfile"
    GC_PURGED=$((GC_PURGED + 1))
  fi
done < <(find "$SPINE_STATE" -maxdepth 2 -name '*.pid' -type f -print0 2>/dev/null)

# Purge stale lock files (untouched for over 2 hours)
while IFS= read -r -d '' lockfile; do
  rm -f "$lockfile"
  GC_PURGED=$((GC_PURGED + 1))
done < <(find "$SPINE_STATE" -maxdepth 2 -name '*.lock' -type f -mmin +120 -print0 2>/dev/null)

echo "loop.closeout.finalize"
echo "loop_id=$LOOP_ID"
echo "acceptance_matrix=$ACCEPTANCE_MATRIX"
echo "disposition=$DISPOSITION"
echo "completion_level=${COMPLETION_LEVEL:-n/a}"
echo "linked_open_gaps_before=$linked_open_count"
echo "linked_gaps_closed=$closed_gap_count"
echo "receipt=$RECEIPT_PATH"
echo "branch_cleanup_status=$BRANCH_CLEANUP_STATUS"
echo "branch_cleanup_branch=${CLEANUP_BRANCH:-none}"
echo "branch_cleanup_reason=$BRANCH_CLEANUP_REASON"
echo "gc_artifacts_archived=$GC_MOVED"
echo "gc_orphans_purged=$GC_PURGED"
