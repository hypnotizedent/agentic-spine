#!/usr/bin/env bash
set -euo pipefail

# gaps.close — Close or fix one gap, or batch-close multiple gaps in one commit.
#
# Single:
#   gaps-close --id <GAP_ID> --status <fixed|closed> \
#     [--fixed-in "reference"] [--notes "description"] \
#     [--regression-lock-id "D###|LOCK-ID"]
#
# Batch (single commit):
#   gaps-close --batch /path/to/close.yaml --status <fixed|closed> \
#     [--fixed-in "reference"] [--notes "description"] \
#     [--regression-lock-id "D###|LOCK-ID"]
#
# Batch file accepted shapes:
#   - YAML list of gap IDs
#   - YAML list of objects: [{id, status?, fixed_in?, notes?, regression_lock_id?}, ...]
#   - Object with `ids:` list of IDs
#   - Object with `gaps:` list of objects

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/git-lock.sh"
source "$ROOT/ops/plugins/core/loops/lib/gap-claims.sh"
source "$ROOT/ops/lib/passive-friction-capture.sh"
GAPS_BRIDGE="$ROOT/ops/plugins/core/lifecycle/bin/gaps-authority-bridge"
PROJECTION_COMMIT="$ROOT/ops/plugins/core/lifecycle/bin/gaps-projection-commit"
SHARED_AUTHORITY_CONTRACT="$ROOT/ops/bindings/shared-authority.mutation.contract.yaml"

usage() {
  cat <<'USAGE'
Usage:
  gaps-close --id <GAP_ID> --status <fixed|closed> [--fixed-in "ref"] [--notes "desc"] [--regression-lock-id "id"]
  gaps-close --batch /path/to/close.yaml --status <fixed|closed> [--fixed-in "ref"] [--notes "desc"] [--regression-lock-id "id"]
  gaps-close ... --lane-safe [--loop-id LOOP-...]
USAGE
}

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

GAPS_CLOSE_LAST_BRIDGE_STDOUT=""
GAPS_CLOSE_LAST_BRIDGE_STDERR=""
GAPS_CLOSE_LAST_BRIDGE_RC=0
GAPS_CLOSE_LAST_PARTIAL_PAYLOAD=""

GAP_ID=""
BATCH_FILE=""
STATUS=""
FIXED_IN=""
NOTES=""
REGRESSION_LOCK_ID=""
LANE_SAFE=0
LANE_SAFE_LOOP_ID="${SPINE_LOOP_ID:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --id) GAP_ID="${2:?--id requires a value}"; shift 2 ;;
    --batch) BATCH_FILE="${2:?--batch requires a value}"; shift 2 ;;
    --status) STATUS="${2:?--status requires a value}"; shift 2 ;;
    --fixed-in) FIXED_IN="${2:?--fixed-in requires a value}"; shift 2 ;;
    --notes) NOTES="${2:?--notes requires a value}"; shift 2 ;;
    --regression-lock-id) REGRESSION_LOCK_ID="${2:?--regression-lock-id requires a value}"; shift 2 ;;
    --lane-safe) LANE_SAFE=1; shift ;;
    --loop-id) LANE_SAFE_LOOP_ID="${2:?--loop-id requires a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "FAIL: unknown arg: $1" >&2; exit 2 ;;
  esac
done

[[ -n "$STATUS" ]] || { echo "FAIL: --status required (fixed or closed)" >&2; exit 2; }
case "$STATUS" in
  fixed|closed) ;;
  *) echo "FAIL: --status must be 'fixed' or 'closed' (got '$STATUS')" >&2; exit 2 ;;
esac

if [[ -n "$GAP_ID" && -n "$BATCH_FILE" ]]; then
  echo "FAIL: --id and --batch are mutually exclusive" >&2
  exit 2
fi
if [[ -z "$GAP_ID" && -z "$BATCH_FILE" ]]; then
  echo "FAIL: provide either --id or --batch" >&2
  exit 2
fi

if [[ "$LANE_SAFE" -eq 1 ]]; then
  [[ -n "$LANE_SAFE_LOOP_ID" ]] || fail "--lane-safe requires --loop-id or SPINE_LOOP_ID context"
  request_dir="$SPINE_STATE/orchestration/${LANE_SAFE_LOOP_ID}/shared-authority-mutations"
  mkdir -p "$request_dir"
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  req_target="${GAP_ID:-batch}"
  request_file="$request_dir/${ts}-gaps-close-${req_target}.yaml"
  cat > "$request_file" <<YAML
kind: shared-authority-mutation
status: queued
queued_at: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
queued_by: "${OPS_TERMINAL_ROLE:-${SPINE_TERMINAL_ROLE:-unknown}}"
loop_id: "$LANE_SAFE_LOOP_ID"
mutation:
  capability: gaps.close
  id: "${GAP_ID:-}"
  batch_file: "${BATCH_FILE:-}"
  status: "$STATUS"
  fixed_in: "$FIXED_IN"
  notes: "$NOTES"
  regression_lock_id: "$REGRESSION_LOCK_ID"
YAML
  echo "gaps.close LANE_SAFE_QUEUED: $request_file"
  exit 0
fi

preflight_ceremony_check() {
  # Preflight check: ensure working tree is closure-safe before attempting commit.
  # Fail fast with clear diagnosis instead of hidden pre-commit surprise.

  local porcelain_output staged_count unstaged_count

  porcelain_output="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
  staged_count=$(echo "$porcelain_output" | grep -c '^[MADRC]' || true)
  unstaged_count=$(echo "$porcelain_output" | grep -c '^.[MD]' || true)

  if [[ -z "$porcelain_output" ]]; then
    echo "INFO: working tree clean — closure-safe" >&2
    return 0
  fi

  if [[ "$unstaged_count" -gt 0 ]]; then
    echo "FAIL: gaps.close requires clean working tree before ceremony" >&2
    echo "" >&2
    echo "Unstaged changes detected:" >&2
    echo "$porcelain_output" | grep '^.[MD]' | sed 's/^/  /' >&2
    echo "" >&2
    echo "Remediation:" >&2
    echo "  1. Commit or stash unstaged changes" >&2
    echo "  2. Or: git checkout -- <file> to discard" >&2
    echo "  3. Then retry gaps.close" >&2
    echo "" >&2
    echo "Reason: mixed dirty state (staged + unstaged) causes pre-commit failures." >&2
    return 1
  fi

  if [[ "$staged_count" -gt 0 ]]; then
    echo "WARN: working tree has staged changes (not from gaps.close)" >&2
    echo "$porcelain_output" | grep '^[MADRC]' | sed 's/^/  /' >&2
    echo "Proceeding with ceremony — staged changes will be committed separately." >&2
  fi

  return 0
}

validate_gap_closure() {
  local id="$1"
  local status="$2"
  local lock_override="${3:-}"
  local severity existing_lock effective_lock

  gap_exists "$id" || fail "$id does not exist in gap registry"
  if ! gap_is_open "$id"; then
    # Query status from SQLite authority via bridge (YAML fallback in gap_query_field)
    local current_status
    current_status="$(gap_query_field "$id" "status")"
    echo "INFO: $id already $current_status — skipping (idempotent)" >&2
    return 1
  fi

  # Read severity and regression_lock_id from SQLite authority via bridge
  severity="$(gap_query_field "$id" "severity")"
  existing_lock="$(gap_query_field "$id" "regression_lock_id")"
  effective_lock="${lock_override:-$existing_lock}"

  # Enforce fix-to-lock discipline for high/critical closures.
  if [[ "$severity" == "high" || "$severity" == "critical" ]]; then
    if [[ -z "$effective_lock" || "$effective_lock" == LEGACY-NO-REGRESSION-LOCK-* ]]; then
      fail "$id severity=$severity requires a non-legacy regression_lock_id"
    fi
  fi

  # Verify claim ownership (no claim = Terminal C direct, allowed).
  verify_claim_ownership "$id" || exit 1

  # Validate status defensively for per-entry batch overrides.
  case "$status" in
    fixed|closed) ;;
    *) fail "$id has invalid status '$status' (must be fixed|closed)" ;;
  esac
}

apply_gap_update() {
  local id="$1"
  local status="$2"
  local fixed_in="$3"
  local notes="$4"
  local reg_lock="$5"
  local updated_at="$6"
  local defer_sync="${7:-0}"

  # Delegate mutation to SQLite authority bridge.
  local bridge_args=("close" "--id" "$id" "--status" "$status")
  [[ -n "$fixed_in" ]] && bridge_args+=("--fixed-in" "$fixed_in")
  [[ -n "$notes" ]] && bridge_args+=("--notes" "$notes")
  [[ -n "$reg_lock" ]] && bridge_args+=("--regression-lock-id" "$reg_lock")
  [[ "$defer_sync" -eq 1 ]] && bridge_args+=("--defer-sync")

  local stdout_file stderr_file result rc
  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  if python3 "$GAPS_BRIDGE" "${bridge_args[@]}" >"$stdout_file" 2>"$stderr_file"; then
    rc=0
  else
    rc=$?
  fi
  result="$(cat "$stdout_file")"
  GAPS_CLOSE_LAST_BRIDGE_STDERR="$(cat "$stderr_file")"
  rm -rf "$stdout_file" "$stderr_file"

  GAPS_CLOSE_LAST_BRIDGE_STDOUT="$result"
  GAPS_CLOSE_LAST_BRIDGE_RC="$rc"
  [[ -n "$GAPS_CLOSE_LAST_BRIDGE_STDERR" ]] && printf '%s\n' "$GAPS_CLOSE_LAST_BRIDGE_STDERR" >&2

  local ok
  ok="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null || echo "False")"
  if [[ "$rc" -ne 0 ]]; then
    local bridge_status
    bridge_status="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('status',''))" 2>/dev/null || echo "")"
    if [[ "$bridge_status" == "partial" ]]; then
      GAPS_CLOSE_LAST_PARTIAL_PAYLOAD="$result"
      return 3
    fi
    local err
    err="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','unknown'))" 2>/dev/null || echo "bridge error")"
    fail "authority bridge close failed for $id: $err"
  fi
  if [[ "$ok" != "True" ]]; then
    local err
    err="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','unknown'))" 2>/dev/null || echo "bridge error")"
    fail "authority bridge close failed for $id: $err"
  fi
}

sync_gap_updates() {
  local -a closed_ids=("$@")
  local -a bridge_args=("sync" "--context" "gaps.close.batch")
  local id stdout_file stderr_file result rc

  for id in "${closed_ids[@]}"; do
    [[ -n "$id" ]] && bridge_args+=("--expect-closed" "$id")
  done

  stdout_file="$(mktemp)"
  stderr_file="$(mktemp)"
  if python3 "$GAPS_BRIDGE" "${bridge_args[@]}" >"$stdout_file" 2>"$stderr_file"; then
    rc=0
  else
    rc=$?
  fi
  result="$(cat "$stdout_file")"
  GAPS_CLOSE_LAST_BRIDGE_STDERR="$(cat "$stderr_file")"
  rm -rf "$stdout_file" "$stderr_file"

  GAPS_CLOSE_LAST_BRIDGE_STDOUT="$result"
  GAPS_CLOSE_LAST_BRIDGE_RC="$rc"
  [[ -n "$GAPS_CLOSE_LAST_BRIDGE_STDERR" ]] && printf '%s\n' "$GAPS_CLOSE_LAST_BRIDGE_STDERR" >&2

  if [[ "$rc" -ne 0 ]]; then
    local bridge_status
    bridge_status="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('status',''))" 2>/dev/null || echo "")"
    if [[ "$bridge_status" == "partial" ]]; then
      GAPS_CLOSE_LAST_PARTIAL_PAYLOAD="$result"
      return 3
    fi
    local err
    err="$(printf '%s' "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','unknown'))" 2>/dev/null || echo "bridge error")"
    fail "authority bridge sync failed: $err"
  fi
  return 0
}

cleanup_claim_if_present() {
  local id="$1"
  local local_claim
  local_claim="$(claim_file "$id")"
  if [[ -f "$local_claim" ]]; then
    rm -f "$local_claim"
    echo "Claim cleaned up for $id"
  fi
}

emit_partial_state() {
  local payload="$1"
  local marker reason next_step
  marker="$(printf '%s' "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin).get('partial_state',{}).get('marker','partial'))" 2>/dev/null || echo "partial")"
  reason="$(printf '%s' "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin).get('partial_state',{}).get('reason',''))" 2>/dev/null || echo "")"
  next_step="$(printf '%s' "$payload" | python3 -c "import sys,json; print(json.load(sys.stdin).get('partial_state',{}).get('next_step',''))" 2>/dev/null || echo "")"
  echo "PARTIAL STATE: $marker" >&2
  [[ -n "$reason" ]] && echo "reason=$reason" >&2
  [[ -n "$next_step" ]] && echo "next_step=$next_step" >&2
  echo "partial_state_json=$payload" >&2
}

projection_paths() {
  command -v yq >/dev/null 2>&1 || fail "yq required"
  local active archive
  active="$(yq e -r '.gap_projection_enforcement.active_projection // ""' "$SHARED_AUTHORITY_CONTRACT")"
  archive="$(yq e -r '.gap_projection_enforcement.archive_projection // ""' "$SHARED_AUTHORITY_CONTRACT")"
  [[ -n "$active" ]] || fail "active gap projection path missing in contract"
  [[ -n "$archive" ]] || fail "archive gap projection path missing in contract"
  printf '%s\n%s\n' "$active" "$archive"
}

projection_commit_required() {
  local active archive paths
  paths="$(projection_paths)"
  active="${paths%%$'\n'*}"
  archive="${paths#*$'\n'}"

  if ! git -C "$ROOT" diff --quiet -- "$active" 2>/dev/null; then
    return 0
  fi
  if ! git -C "$ROOT" diff --cached --quiet -- "$active" 2>/dev/null; then
    return 0
  fi
  if [[ -f "$ROOT/$archive" ]]; then
    if git -C "$ROOT" ls-files --error-unmatch "$archive" >/dev/null 2>&1; then
      if ! git -C "$ROOT" diff --quiet -- "$archive" 2>/dev/null; then
        return 0
      fi
      if ! git -C "$ROOT" diff --cached --quiet -- "$archive" 2>/dev/null; then
        return 0
      fi
    else
      return 0
    fi
  fi
  return 1
}

commit_gap_projection_or_partial() {
  [[ -x "$PROJECTION_COMMIT" ]] || fail "gaps projection commit surface missing: $PROJECTION_COMMIT"

  if ! projection_commit_required; then
    return 0
  fi

  local projection_output rc=0
  set +e
  projection_output="$(
    GAPS_PROJECTION_COMMIT_SKIP_LOCK=1 \
      "$PROJECTION_COMMIT" 2>&1
  )"
  rc=$?
  set -e
  [[ -n "$projection_output" ]] && printf '%s\n' "$projection_output" >&2

  if [[ "$rc" -eq 0 ]]; then
    return 0
  fi

  local reason next_step payload
  reason="projection commit failed: $(printf '%s' "$projection_output" | tail -n 1)"
  next_step="./bin/ops cap run gaps.projection.commit"
  auto_file_friction \
    "gaps.close.partial_state" \
    "gap close should complete authority, projection, and durable git commit in one governed command" \
    "$reason" \
    "medium" || true
  payload="$(python3 - <<'PY' "$reason" "$next_step"
import json, sys
reason = sys.argv[1]
next_step = sys.argv[2]
print(json.dumps({
    "partial_state": {
        "marker": "gap_projection_commit_partial",
        "reason": reason,
        "next_step": next_step,
        "authority_committed": True,
        "projection_completed": True,
        "projection_commit_completed": False,
    }
}))
PY
)"
  emit_partial_state "$payload"
  exit 3
}

parse_batch_file() {
  local batch_file="$1"
  local default_status="$2"
  local default_fixed_in="$3"
  local default_notes="$4"
  local default_reg_lock="$5"

  [[ -f "$batch_file" ]] || fail "--batch file not found: $batch_file"
  command -v python3 >/dev/null 2>&1 || fail "python3 required for --batch"
  command -v yq >/dev/null 2>&1 || fail "yq required for --batch"

  python3 - "$batch_file" "$default_status" "$default_fixed_in" "$default_notes" "$default_reg_lock" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

batch_file = Path(sys.argv[1])
default_status = (sys.argv[2] or "").strip()
default_fixed_in = sys.argv[3]
default_notes = sys.argv[4]
default_reg_lock = sys.argv[5]

raw = subprocess.run(
    ["yq", "e", "-o=json", ".", str(batch_file)],
    capture_output=True,
    text=True,
    check=False,
)
if raw.returncode != 0:
    raise SystemExit(f"FAIL: unable to parse batch YAML: {raw.stderr.strip()}")

try:
    data = json.loads(raw.stdout or "null")
except Exception as exc:
    raise SystemExit(f"FAIL: invalid batch JSON conversion: {exc}")

if isinstance(data, dict):
    if isinstance(data.get("gaps"), list):
        items = data["gaps"]
    elif isinstance(data.get("ids"), list):
        items = [{"id": gid} for gid in data["ids"]]
    else:
        raise SystemExit("FAIL: batch YAML object must contain `gaps:` or `ids:` list")
elif isinstance(data, list):
    items = data
else:
    raise SystemExit("FAIL: batch YAML must be a list or an object with list fields")

out = []
seen = set()
for idx, item in enumerate(items):
    if isinstance(item, str):
        entry = {"id": item}
    elif isinstance(item, dict):
        entry = item
    else:
        raise SystemExit(f"FAIL: batch entry #{idx + 1} must be string or object")

    gap_id = str(entry.get("id", "")).strip()
    if not gap_id:
        raise SystemExit(f"FAIL: batch entry #{idx + 1} missing id")
    if gap_id in seen:
        raise SystemExit(f"FAIL: duplicate id in batch: {gap_id}")
    seen.add(gap_id)

    status = str(entry.get("status", "")).strip() or default_status
    if status not in {"fixed", "closed"}:
        raise SystemExit(f"FAIL: batch entry {gap_id} has invalid status '{status}'")

    fixed_in = str(entry.get("fixed_in", "")).strip() or default_fixed_in
    notes = str(entry.get("notes", "")).strip() or default_notes
    reg_lock = str(entry.get("regression_lock_id", "")).strip() or default_reg_lock

    out.append(
        {
            "id": gap_id,
            "status": status,
            "fixed_in": fixed_in,
            "notes": notes,
            "regression_lock_id": reg_lock,
        }
    )

if not out:
    raise SystemExit("FAIL: batch contains no entries")

print(json.dumps(out))
PY
}

close_single() {
  local id="$1" status="$2" fixed_in="$3" notes="$4" reg_lock="$5"
  local timestamp

  acquire_git_lock gaps || exit 1
  trap 'release_git_lock' EXIT INT TERM

  # Preflight: check ceremony-safety before mutation
  preflight_ceremony_check || {
    release_git_lock
    exit 1
  }

  if ! validate_gap_closure "$id" "$status" "$reg_lock"; then
    echo "SKIPPED: $id (already closed)"
    return 0
  fi

  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local rc=0
  set +e
  apply_gap_update "$id" "$status" "$fixed_in" "$notes" "$reg_lock" "$timestamp" 0
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    cleanup_claim_if_present "$id"
    if [[ "$rc" -eq 3 ]]; then
      emit_partial_state "$GAPS_CLOSE_LAST_PARTIAL_PAYLOAD"
      exit 3
    fi
    exit "$rc"
  fi
  cleanup_claim_if_present "$id"
  commit_gap_projection_or_partial

  echo "CLOSED: $id (status=$status${fixed_in:+, fixed_in=$fixed_in})"
}

close_batch() {
  local batch_file="$1"
  local default_status="$2"
  local default_fixed_in="$3"
  local default_notes="$4"
  local default_reg_lock="$5"
  local entries_json
  local -a ids=() statuses=() fixed_ins=() notes=() reg_locks=()
  local timestamp local_claim i count

  command -v jq >/dev/null 2>&1 || fail "jq required for --batch"
  entries_json="$(parse_batch_file "$batch_file" "$default_status" "$default_fixed_in" "$default_notes" "$default_reg_lock")"

  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    ids+=("$(jq -r '.id' <<<"$row")")
    statuses+=("$(jq -r '.status' <<<"$row")")
    fixed_ins+=("$(jq -r '.fixed_in // ""' <<<"$row")")
    notes+=("$(jq -r '.notes // ""' <<<"$row")")
    reg_locks+=("$(jq -r '.regression_lock_id // ""' <<<"$row")")
  done < <(jq -c '.[]' <<<"$entries_json")

  count="${#ids[@]}"
  (( count > 0 )) || fail "batch contains no entries"

  acquire_git_lock gaps || exit 1
  trap 'release_git_lock' EXIT INT TERM

  # Preflight: check ceremony-safety before mutation
  preflight_ceremony_check || {
    release_git_lock
    exit 1
  }

  # Validate under lock to avoid stale read races between concurrent terminals.
  local -a valid_indices=()
  for ((i=0; i<count; i++)); do
    if validate_gap_closure "${ids[$i]}" "${statuses[$i]}" "${reg_locks[$i]}"; then
      valid_indices+=("$i")
    else
      echo "SKIPPED: ${ids[$i]} (already closed)"
    fi
  done

  if [[ "${#valid_indices[@]}" -eq 0 ]]; then
    echo "INFO: all gaps already closed — nothing to do"
    return 0
  fi

  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local -a closed_ids=()
  for i in "${valid_indices[@]}"; do
    local rc=0
    set +e
    apply_gap_update "${ids[$i]}" "${statuses[$i]}" "${fixed_ins[$i]}" "${notes[$i]}" "${reg_locks[$i]}" "$timestamp" 1
    rc=$?
    set -e
    if [[ "$rc" -ne 0 ]]; then
      for id in "${closed_ids[@]}"; do
        cleanup_claim_if_present "$id"
      done
      if [[ "$rc" -eq 3 ]]; then
        emit_partial_state "$GAPS_CLOSE_LAST_PARTIAL_PAYLOAD"
        exit 3
      fi
      exit "$rc"
    fi
    closed_ids+=("${ids[$i]}")
  done

  local sync_rc=0
  set +e
  sync_gap_updates "${closed_ids[@]}"
  sync_rc=$?
  set -e
  if [[ "$sync_rc" -ne 0 ]]; then
    for id in "${closed_ids[@]}"; do
      cleanup_claim_if_present "$id"
    done
    if [[ "$sync_rc" -eq 3 ]]; then
      emit_partial_state "$GAPS_CLOSE_LAST_PARTIAL_PAYLOAD"
      exit 3
    fi
    exit "$sync_rc"
  fi

  for id in "${closed_ids[@]}"; do
    cleanup_claim_if_present "$id"
  done
  commit_gap_projection_or_partial

  for i in "${valid_indices[@]}"; do
    echo "CLOSED: ${ids[$i]} (status=${statuses[$i]}${fixed_ins[$i]:+, fixed_in=${fixed_ins[$i]}})"
  done
}

if [[ -n "$BATCH_FILE" ]]; then
  close_batch "$BATCH_FILE" "$STATUS" "$FIXED_IN" "$NOTES" "$REGRESSION_LOCK_ID"
else
  close_single "$GAP_ID" "$STATUS" "$FIXED_IN" "$NOTES" "$REGRESSION_LOCK_ID"
fi
