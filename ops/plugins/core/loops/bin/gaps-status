#!/usr/bin/env bash
set -euo pipefail

# gaps.status — Gap-Loop Reconciliation
# Lists open gaps and checks parent_loop linkage.
# Flags: orphaned gaps (parent loop closed but gap still open)
#
# Usage: ./gaps-status [--fix-orphans]
#   --fix-orphans: remove parent_loop from gaps whose loops are closed

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
SCOPES="$SPINE_STATE/loop-scopes"
AUTH_DUMP="$(
  python3 - "$ROOT" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
lib_dir = root / "ops" / "plugins" / "core" / "lifecycle" / "lib"
sys.path.insert(0, str(lib_dir))

import gaps_sql_authority as gsa

db_path, gaps_yaml = gsa.resolve_paths(root)
conn = gsa.connect(db_path)
gsa.ensure_schema(conn)
gsa.bootstrap_from_yaml(conn, gaps_yaml)
gaps = gsa.fetch_gaps(conn)
conn.close()

total = len(gaps)
open_count = sum(1 for g in gaps if g.get("status") == "open")
fixed_count = sum(1 for g in gaps if g.get("status") == "fixed")
closed_count = sum(1 for g in gaps if g.get("status") == "closed")
null_status = sum(1 for g in gaps if not str(g.get("status") or "").strip())

print(f"TOTAL={total}")
print(f"OPEN={open_count}")
print(f"FIXED={fixed_count}")
print(f"CLOSED={closed_count}")
print(f"NULL_STATUS={null_status}")
for gap in gaps:
    if gap.get("status") != "open":
        continue
    gap_id = str(gap.get("id") or "").strip()
    severity = str(gap.get("severity") or "").strip()
    parent_loop = str(gap.get("parent_loop") or "null").strip() or "null"
    print(f"OPEN_GAP|{gap_id}|{severity}|{parent_loop}")
PY
)" || {
  echo "ERROR: unable to read gaps authority" >&2
  exit 1
}

total="$(printf '%s\n' "$AUTH_DUMP" | awk -F= '/^TOTAL=/{print $2; exit}')"
open="$(printf '%s\n' "$AUTH_DUMP" | awk -F= '/^OPEN=/{print $2; exit}')"
fixed="$(printf '%s\n' "$AUTH_DUMP" | awk -F= '/^FIXED=/{print $2; exit}')"
closed="$(printf '%s\n' "$AUTH_DUMP" | awk -F= '/^CLOSED=/{print $2; exit}')"
null_status="$(printf '%s\n' "$AUTH_DUMP" | awk -F= '/^NULL_STATUS=/{print $2; exit}')"

echo "═══════════════════════════════════════════════════════════════"
echo "  Gap-Loop Reconciliation"
echo "═══════════════════════════════════════════════════════════════"
echo

echo "Gaps: $total total | $open open | $fixed fixed | $closed closed"
if [[ "$null_status" -gt 0 ]]; then
  echo "WARNING: $null_status gap(s) have null/missing status — invisible to reconciliation"
fi
echo

# List open gaps with parent_loop status
orphan_count=0
echo "Open gaps with parent loop check:"
echo "──────────────────────────────────────────────────────────────"

while IFS='|' read -r gap_id severity parent_loop; do
  [[ -z "$gap_id" ]] && continue
  parent_loop=$(echo "$parent_loop" | xargs)

  if [[ -z "$parent_loop" || "$parent_loop" == "null" ]]; then
    echo "  [$severity] $gap_id — no parent loop (standalone)"
    continue
  fi

  scope_file="$SCOPES/${parent_loop}.scope.md"
  if [[ ! -f "$scope_file" ]]; then
    echo "  [$severity] $gap_id → $parent_loop (MISSING scope file)"
    continue
  fi

  loop_status=$(awk '/^status:/{print $2; exit}' "$scope_file" 2>/dev/null || echo "unknown")
  loop_mode=$(sed -n 's/^execution_mode:[[:space:]]*//p' "$scope_file" | head -n1 | tr -d '"')
  active_terminal=$(sed -n 's/^active_terminal:[[:space:]]*//p' "$scope_file" | head -n1 | tr -d '"')
  blocked_by=$(sed -n 's/^blocked_by:[[:space:]]*//p' "$scope_file" | head -n1 | tr -d '"')

  if [[ "$loop_status" == "closed" ]]; then
    echo "  [$severity] $gap_id → $parent_loop (ORPHANED — loop closed, gap open)"
    orphan_count=$((orphan_count + 1))
  else
    loop_state="$loop_status"
    [[ "$loop_mode" == "background" ]] && loop_state="${loop_state}/background"
    [[ -n "$active_terminal" ]] && loop_state="${loop_state}, terminal=${active_terminal}"
    echo "  [$severity] $gap_id → $parent_loop ($loop_state)"
    if [[ -n "$blocked_by" && "$blocked_by" != "none" ]]; then
      echo "             note: $blocked_by"
    fi
  fi
done < <(printf '%s\n' "$AUTH_DUMP" | awk -F'|' '$1=="OPEN_GAP"{print $2 "|" $3 "|" $4}')

echo
echo "──────────────────────────────────────────────────────────────"
echo "Orphaned gaps (loop closed, gap open): $orphan_count"
echo "═══════════════════════════════════════════════════════════════"

exit 0
