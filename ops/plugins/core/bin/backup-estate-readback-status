#!/usr/bin/env bash
set -euo pipefail

# backup.estate.readback.status
# Estate-wide, read-only backup readback projection.
# Starts from live pve/pve-r620/proxmox-home subjects, then joins lifecycle,
# backup inventory, backup.status, and Proxmox jobs.cfg evidence.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

: "${SPINE_STATE:=$HOME/code/.runtime/spine/state}"
export SPINE_STATE

JSON_MODE=0
SHOW_DETAILS=0

usage() {
  cat <<'USAGE'
backup-estate-readback-status

Usage:
  backup-estate-readback-status [--json] [--details]

Read-only estate backup readback projection. It does not run backups, restore
backups, change schedules, delete artifacts, or dispatch alerts.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON_MODE=1; shift ;;
    --details) SHOW_DETAILS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "FAIL: unknown argument: $1" >&2; exit 2 ;;
  esac
done

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "FAIL: missing dependency: $1" >&2; exit 1; }
}

need python3
need jq
need ssh

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

capture_host() {
  local host="$1"
  local out="$tmpdir/${host}.txt"
  local err="$tmpdir/${host}.err"
  local candidate=""
  local rc=0
  local -a candidates=("$host")
  case "$host" in
    pve) candidates+=("192.168.1.184" "100.96.211.33") ;;
    pve-r620) candidates+=("192.168.1.126" "100.92.252.36") ;;
    proxmox-home) candidates+=("100.103.99.62") ;;
  esac

  for candidate in "${candidates[@]}"; do
    set +e
    ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$candidate" 'hostname; echo ---QEMU---; qm list 2>/dev/null || true; echo ---LXC---; pct list 2>/dev/null || true; echo ---JOBS---; cat /etc/pve/jobs.cfg 2>/dev/null || true; echo ---STORAGE---; pvesm status 2>/dev/null || true' >"$out" 2>"$err" < /dev/null
    rc=$?
    set -e
    [[ "$rc" -eq 0 ]] && break
  done
  printf '%s\n' "$rc" > "$tmpdir/${host}.rc"
}

capture_host pve
capture_host pve-r620
capture_host proxmox-home

backup_status_out="$tmpdir/backup-status.out"
backup_status_err="$tmpdir/backup-status.err"
backup_status_rc=0
set +e
"$ROOT/ops/plugins/infra/backup/bin/backup-status" >"$backup_status_out" 2>"$backup_status_err" < /dev/null
backup_status_rc=$?
set -e

results_json="$tmpdir/results.json"
python3 - "$ROOT" "$tmpdir" "$backup_status_out" "$backup_status_rc" "${SPINE_STATE:-}" > "$results_json" <<'PY'
import json
import os
import pathlib
import re
import sys

import yaml

root = pathlib.Path(sys.argv[1])
tmpdir = pathlib.Path(sys.argv[2])
backup_status_path = pathlib.Path(sys.argv[3])
backup_status_rc = int(sys.argv[4])
spine_state = pathlib.Path(sys.argv[5]) if len(sys.argv) > 5 and sys.argv[5] else pathlib.Path(os.environ.get("SPINE_STATE", str(pathlib.Path.home() / "code/.runtime/spine/state")))

lifecycle_path = root / "ops/bindings/vm.lifecycle.yaml"
inventory_path = root / "ops/bindings/domains/backup/backup.inventory.yaml"
locality_path = root / "ops/bindings/domains/backup/backup.locality.contract.yaml"


def load_yaml(path):
    if not path.is_file():
        return {}
    return yaml.safe_load(path.read_text(encoding="utf-8")) or {}


lifecycle = load_yaml(lifecycle_path)
inventory = load_yaml(inventory_path)
locality_doc = load_yaml(locality_path)

vm_by_host_id = {}
for row in lifecycle.get("vms", []) or []:
    host = str(row.get("proxmox_host") or "pve")
    vmid = str(row.get("id") or "")
    if vmid:
        vm_by_host_id[(host, vmid)] = row
backup_target_to_lifecycle = {
    str(row.get("backup_target") or ""): row
    for row in lifecycle.get("vms", []) or []
    if row.get("backup_target")
}

runtime_units = inventory.get("runtime_units", []) or []
targets = inventory.get("targets", []) or []
target_by_name = {str(t.get("name") or ""): t for t in targets if t.get("name")}
target_unit_mode = {}
for unit in runtime_units:
    mode = str(unit.get("unit_runtime_mode") or "")
    for target_name in unit.get("inventory_targets") or []:
        target_unit_mode[str(target_name)] = mode

# Locality lookup for disabled-target classification (PACKET-612).
locality_by_target = {}
for entry in locality_doc.get("target_localities") or []:
    if isinstance(entry, dict) and entry.get("target"):
        locality_by_target[str(entry["target"])] = entry

# Recovery-alternative lookup: for target X, find runtime_units whose
# inventory_targets list contains X (companions become recovery promise);
# fall back to runtime_units whose hostname matches the VM owner inferred
# from the target name (e.g. vm-206-dev-tools-primary -> hostname dev-tools).
def derive_recovery_alternative(target_name):
    if not target_name:
        return []
    direct_companions = []
    for unit in runtime_units:
        members = [str(m) for m in unit.get("inventory_targets") or []]
        if target_name in members:
            direct_companions.extend(m for m in members if m != target_name)
    if direct_companions:
        # de-dupe preserving order
        seen = set()
        out = []
        for m in direct_companions:
            if m not in seen:
                seen.add(m)
                out.append(m)
        return out
    # Fallback: parse hostname from target name pattern.
    # Patterns: vm-NNN-<hostname>-primary, home-vm-NNN-<hostname>-primary,
    # lxc-NNN-<hostname>-primary, app-<hostname>-*, home-lxc-NNN-<hostname>-primary
    inferred_hostname = None
    parts = target_name.split("-")
    if len(parts) >= 4 and parts[0] == "vm" and parts[1].isdigit():
        # vm-NNN-<hostname...>-primary
        inferred_hostname = "-".join(parts[2:-1]) if parts[-1] in {"primary", "offsite"} else "-".join(parts[2:])
    elif len(parts) >= 5 and parts[0] == "home" and parts[1] == "vm" and parts[2].isdigit():
        inferred_hostname = "-".join(parts[3:-1]) if parts[-1] == "primary" else "-".join(parts[3:])
    elif len(parts) >= 4 and parts[0] == "lxc" and parts[1].isdigit():
        inferred_hostname = "-".join(parts[2:-1]) if parts[-1] == "primary" else "-".join(parts[2:])
    elif len(parts) >= 5 and parts[0] == "home" and parts[1] == "lxc" and parts[2].isdigit():
        inferred_hostname = "-".join(parts[3:-1]) if parts[-1] == "primary" else "-".join(parts[3:])
    if inferred_hostname:
        for unit in runtime_units:
            if str(unit.get("hostname") or "") == inferred_hostname:
                members = [str(m) for m in unit.get("inventory_targets") or [] if str(m) != target_name]
                if members:
                    seen = set()
                    out = []
                    for m in members:
                        if m not in seen:
                            seen.add(m)
                            out.append(m)
                    return out
    return []


# Drill-evidence lookup: only forge_node currently has a drill receipt at
# the canonical path. Parametric structure so other node-roles can plug in.
DRILL_RECEIPT_PATHS = {
    "forge_node": spine_state / "domain-state/forge-node/restore-drill-receipt-latest.yaml",
}
FORGE_TARGETS = {"vm-206-dev-tools-primary", "app-gitea", "app-gitea-export"}


def derive_drill_evidence_present(target_name):
    if target_name in FORGE_TARGETS:
        path = DRILL_RECEIPT_PATHS.get("forge_node")
        if path is not None:
            return path.is_file()
    return False


def classify_disabled_target(target_name, target_def):
    """Classify a disabled target per PACKET-612 rules.

    Reads existing fields only:
      - target_def.classification (critical|important|rebuildable|retired|decommissioned)
      - target_def.retirement_reason
      - locality_by_target[target_name].note
    """
    locality_entry = locality_by_target.get(target_name) or {}
    note = str(locality_entry.get("note") or "")
    inv_classification = str(target_def.get("classification") or "")
    retirement_reason = str(target_def.get("retirement_reason") or "")

    # rollback / appliance cutover -> appliance_cutover_rollback_only
    note_l = note.lower()
    if "rollback evidence" in note_l or "appliance cutover" in note_l:
        return "appliance_cutover_rollback_only"
    # app-local subtraction
    if (
        "not active readiness authority unless re-admitted" in note_l
        or retirement_reason == "app_local_backup_subtraction_policy"
    ):
        return "app_local_subtraction"
    # decommissioned residue (locality note says Decommissioned/Tombstoned, OR
    # inventory classification == decommissioned, OR classification == retired
    # without other markers — retired and decommissioned are aligned residue
    # semantics per the locality contract restore_matrix).
    if (
        "decommissioned" in note_l
        or "tombstoned" in note_l
        or inv_classification == "decommissioned"
    ):
        return "decommissioned_residue"
    # disabled by policy
    if "intentionally retired" in note_l or "intentionally disabled" in note_l:
        return "disabled_by_policy"
    # classification: retired with no other clue -> bucket as decommissioned_residue
    # (residue semantics; canonical recovery is on a different surface).
    if inv_classification == "retired":
        return "decommissioned_residue"
    # No clear locality note + not retired/decommissioned -> needs operator decision.
    return "needs_operator_decision"

policy = (((inventory.get("model") or {}).get("vzdump_schedule_policy") or {}))
derived = policy.get("derived_assignments") or {}
policy_by_vmid = {}
for policy_name, rows in derived.items():
    for item in rows or []:
        vmid = str(item.get("vm_id") or "")
        if vmid:
            policy_by_vmid[vmid] = policy_name


def parse_backup_status(path):
    statuses = {}
    summary = {}
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.rstrip()
        if not line:
            continue
        if line.startswith("summary:"):
            nums = re.findall(r"(\d+)\s+(targets|ok|degraded|context_blocked)", line)
            for value, name in nums:
                summary[name] = int(value)
            summary["line"] = line
            continue
        parts = line.split()
        if len(parts) < 3:
            continue
        marker = parts[-2] if len(parts) >= 2 else ""
        if marker not in {"OK", "STALE", "MISSING", "ERROR", "BLOCKED"}:
            continue
        statuses[parts[0]] = {
            "status": marker.lower(),
            "reason": parts[-1],
            "raw": line,
        }
    return statuses, summary


target_status, backup_summary = parse_backup_status(backup_status_path)
backup_status_degraded_targets = [
    {
        "target": name,
        "status": row.get("status"),
        "reason": row.get("reason"),
        "raw": row.get("raw"),
    }
    for name, row in sorted(target_status.items())
    if row.get("status") in {"stale", "missing", "error", "blocked"}
]


def split_sections(text):
    sections = {}
    current = "hostname"
    sections[current] = []
    for line in text.splitlines():
        if line.startswith("---") and line.endswith("---"):
            current = line.strip("-")
            sections.setdefault(current, [])
        else:
            sections.setdefault(current, []).append(line)
    return sections


def parse_qemu(lines):
    rows = []
    for line in lines:
        if not line.strip() or line.lstrip().startswith("VMID"):
            continue
        parts = line.split()
        if len(parts) < 3 or not parts[0].isdigit():
            continue
        rows.append({
            "kind": "qemu",
            "vmid": parts[0],
            "name": parts[1],
            "runtime_status": parts[2],
        })
    return rows


def parse_lxc(lines):
    rows = []
    for line in lines:
        if not line.strip() or line.lstrip().startswith("VMID"):
            continue
        parts = line.split()
        if len(parts) < 3 or not parts[0].isdigit():
            continue
        rows.append({
            "kind": "lxc",
            "vmid": parts[0],
            "name": parts[-1],
            "runtime_status": parts[1],
        })
    return rows


def parse_jobs(lines):
    jobs = []
    current = None
    for line in lines:
        if line.startswith("vzdump:"):
            if current:
                jobs.append(current)
            current = {"id": line.split(":", 1)[1].strip(), "vmids": []}
            continue
        if current is None:
            continue
        stripped = line.strip()
        if not stripped:
            continue
        key, _, value = stripped.partition(" ")
        if key == "vmid":
            current["vmids"] = [v.strip() for v in value.split(",") if v.strip()]
        else:
            current[key] = value.strip()
    if current:
        jobs.append(current)
    return jobs


host_docs = {}
for host in ["pve", "pve-r620", "proxmox-home"]:
    out = tmpdir / f"{host}.txt"
    rc_path = tmpdir / f"{host}.rc"
    rc = int(rc_path.read_text(encoding="utf-8").strip() or "1") if rc_path.is_file() else 1
    text = out.read_text(encoding="utf-8", errors="replace") if out.is_file() else ""
    sections = split_sections(text)
    jobs = parse_jobs(sections.get("JOBS", []))
    scheduled = {}
    for job in jobs:
        for vmid in job.get("vmids", []):
            scheduled.setdefault(vmid, []).append(job.get("id"))
    host_docs[host] = {
        "ssh_rc": rc,
        "subjects": parse_qemu(sections.get("QEMU", [])) + parse_lxc(sections.get("LXC", [])),
        "jobs": jobs,
        "scheduled": scheduled,
    }


def runtime_unit_targets_for(hostname):
    result = []
    for unit in runtime_units:
        if str(unit.get("hostname") or "") == hostname:
            result.extend(str(x) for x in unit.get("inventory_targets") or [])
    return result


def target_status_for(target_name):
    if not target_name:
        return {"status": "none", "reason": "no_target"}
    if target_name in target_status:
        return target_status[target_name]
    if target_name in target_by_name:
        return {"status": "not_reported", "reason": "inventory_target_not_reported"}
    return {"status": "missing_inventory", "reason": "target_missing_from_inventory"}


subjects = []
gaps = []
for host, doc in host_docs.items():
    if doc["ssh_rc"] != 0:
        gaps.append({
            "severity": "blocking",
            "code": "host_unreachable",
            "host": host,
            "meaning": "cannot enumerate backup subjects",
        })
        continue
    for subject in sorted(doc["subjects"], key=lambda x: (x["kind"], int(x["vmid"]))):
        vmid = subject["vmid"]
        lifecycle_row = vm_by_host_id.get((host, vmid))
        lifecycle_status = str((lifecycle_row or {}).get("status") or "unmodeled")
        backup_target = str((lifecycle_row or {}).get("backup_target") or "")
        policy_name = policy_by_vmid.get(vmid, "")
        scheduled_jobs = doc["scheduled"].get(vmid, [])
        target_readback = target_status_for(backup_target)
        classification = "subject"
        status = "ok"
        reason = "covered_by_inventory_and_readback"

        if subject["runtime_status"] == "stopped":
            classification = "residue"
            status = "residue"
            reason = "stopped_guest_requires_disposition_not_runtime_backup"
        elif lifecycle_status == "unmodeled":
            classification = "gap"
            status = "gap"
            reason = "live_subject_missing_from_lifecycle_authority"
        elif lifecycle_status in {"decommissioned", "residual", "abandoned"} and subject["runtime_status"] == "running":
            classification = "residue"
            status = "gap"
            reason = "live_runtime_contradicts_lifecycle_status"
        elif policy_name == "no_recurring_vzdump":
            classification = "exclusion"
            status = "ok"
            reason = "policy_excludes_recurring_vzdump"
        elif target_readback["status"] in {"stale", "missing", "error", "blocked", "not_reported", "missing_inventory"}:
            classification = "subject"
            status = "degraded"
            reason = f"backup_target_{target_readback['status']}"
        elif not backup_target:
            classification = "gap"
            status = "gap"
            reason = "no_backup_target_or_exclusion"

        unit_mode = target_unit_mode.get(backup_target, "")
        if (
            subject["runtime_status"] == "running"
            and backup_target
            and not scheduled_jobs
            and policy_name not in {"no_recurring_vzdump", "decommission_capsule"}
            and unit_mode not in {"file_archive"}
        ):
            if status == "ok":
                status = "partial"
                reason = "fresh_target_but_no_live_proxmox_job_membership_seen"

        # PACKET-612: per-row disabled-target classification (when applicable),
        # recovery_alternative, drill_evidence_present.
        disabled_classification = None
        recovery_alternative = None
        drill_evidence_present = False
        backup_target_def = target_by_name.get(backup_target) if backup_target else None
        if backup_target_def is not None and backup_target_def.get("enabled") is False:
            disabled_classification = classify_disabled_target(backup_target, backup_target_def)
            ra = derive_recovery_alternative(backup_target)
            recovery_alternative = ra if ra else None
            drill_evidence_present = derive_drill_evidence_present(backup_target)

        row = {
            "host": host,
            "kind": subject["kind"],
            "vmid": vmid,
            "name": subject["name"],
            "runtime_status": subject["runtime_status"],
            "classification": classification,
            "status": status,
            "reason": reason,
            "lifecycle_status": lifecycle_status,
            "backup_target": backup_target or None,
            "backup_target_status": target_readback.get("status"),
            "backup_target_reason": target_readback.get("reason"),
            "schedule_policy": policy_name or None,
            "unit_runtime_mode": unit_mode or None,
            "scheduled_jobs": scheduled_jobs,
            "disabled_classification": disabled_classification,
            "recovery_alternative": recovery_alternative,
            "drill_evidence_present": drill_evidence_present,
        }
        subjects.append(row)
        if status in {"gap", "degraded", "partial"}:
            gaps.append({
                "severity": "high" if status == "gap" else "medium",
                "code": reason,
                "host": host,
                "vmid": vmid,
                "name": subject["name"],
            })

# PACKET-612: SECOND PASS — iterate ALL inventory targets (49) so disabled
# targets that have no live Proxmox guest mapping (app-level lanes, retired
# VM artifact targets, NAS legacy lanes) still surface as canonical estate
# truth. Skip targets already covered by the live-guest pass (those rows
# already carry the disabled_classification fields).
covered_backup_targets = {
    s.get("backup_target") for s in subjects if s.get("backup_target")
}
inventory_targets = []
disabled_classification_counts = {
    "disabled_by_policy": 0,
    "decommissioned_residue": 0,
    "app_local_subtraction": 0,
    "appliance_cutover_rollback_only": 0,
    "needs_operator_decision": 0,
}
# Count classifications already attributed to live-guest rows so the rollup
# reflects the full estate, not just the inventory-only second pass.
for s in subjects:
    dc = s.get("disabled_classification")
    if dc and dc in disabled_classification_counts:
        disabled_classification_counts[dc] += 1
for target_def in targets:
    name = str(target_def.get("name") or "")
    if not name:
        continue
    if name in covered_backup_targets:
        continue
    enabled = bool(target_def.get("enabled"))
    inv_host = str(target_def.get("host") or "")
    classification_value = str(target_def.get("classification") or "")
    if enabled:
        # Inventory-only enabled target — likely already covered by
        # backup.status freshness; emit a row so the canonical estate
        # truth includes it.
        readback = target_status_for(name)
        unit_mode = target_unit_mode.get(name, "")
        if readback["status"] in {"stale", "missing", "error", "blocked"}:
            row_status = "degraded"
            row_reason = f"backup_target_{readback['status']}"
        elif readback["status"] in {"not_reported", "missing_inventory"}:
            row_status = "partial"
            row_reason = f"backup_target_{readback['status']}"
        else:
            row_status = "ok"
            row_reason = "covered_by_inventory_and_readback"
        inventory_targets.append({
            "scope": "inventory_only",
            "host": inv_host or None,
            "name": name,
            "kind": str(target_def.get("kind") or ""),
            "enabled": True,
            "classification": classification_value or None,
            "framing": "recurring_freshness_checked",
            "status": row_status,
            "reason": row_reason,
            "backup_target": name,
            "backup_target_status": readback.get("status"),
            "backup_target_reason": readback.get("reason"),
            "unit_runtime_mode": unit_mode or None,
            "disabled_classification": None,
            "recovery_alternative": None,
            "drill_evidence_present": False,
        })
    else:
        disabled_class = classify_disabled_target(name, target_def)
        if disabled_class in disabled_classification_counts:
            disabled_classification_counts[disabled_class] += 1
        ra = derive_recovery_alternative(name)
        recovery = ra if ra else None
        drill_present = derive_drill_evidence_present(name)
        unit_mode = target_unit_mode.get(name, "")
        retirement_reason = str(target_def.get("retirement_reason") or "")
        retired_at = str(target_def.get("retired_at") or "")
        locality_entry = locality_by_target.get(name) or {}
        inventory_targets.append({
            "scope": "inventory_only",
            "host": inv_host or None,
            "name": name,
            "kind": str(target_def.get("kind") or ""),
            "enabled": False,
            "classification": classification_value or None,
            "framing": "disabled_target_classified",
            "status": "disabled",
            "reason": disabled_class,
            "backup_target": name,
            "backup_target_status": None,
            "backup_target_reason": None,
            "unit_runtime_mode": unit_mode or None,
            "disabled_classification": disabled_class,
            "recovery_alternative": recovery,
            "drill_evidence_present": drill_present,
            "locality": str(locality_entry.get("locality") or "") or None,
            "locality_note": str(locality_entry.get("note") or "") or None,
            "retirement_reason": retirement_reason or None,
            "retired_at": retired_at or None,
        })
        if disabled_class == "needs_operator_decision":
            gaps.append({
                "severity": "medium",
                "code": "disabled_target_needs_operator_decision",
                "host": inv_host or None,
                "target": name,
            })

for unit in runtime_units:
    host = str(unit.get("hostname") or "")
    for target_name in unit.get("inventory_targets") or []:
        if str(target_name) and str(target_name) not in target_by_name:
            gaps.append({
                "severity": "medium",
                "code": "runtime_unit_target_missing_from_inventory",
                "host": host,
                "target": str(target_name),
            })

overall = "ok"
if backup_status_rc != 0 or any(g["severity"] == "blocking" for g in gaps):
    overall = "blocked"
elif any(g["severity"] == "high" for g in gaps):
    overall = "degraded"
elif gaps or backup_status_degraded_targets:
    overall = "partial"

subject_degraded_targets = {
    s["backup_target"]
    for s in subjects
    if s["status"] == "degraded" and s.get("backup_target")
}
backup_status_degraded_total = len(backup_status_degraded_targets)
backup_status_degraded_unattached_total = sum(
    1
    for row in backup_status_degraded_targets
    if row.get("target") not in subject_degraded_targets
)
subject_degraded_total = sum(1 for s in subjects if s["status"] == "degraded")
counts = {
    "subjects_total": len(subjects),
    "running_total": sum(1 for s in subjects if s["runtime_status"] == "running"),
    "stopped_total": sum(1 for s in subjects if s["runtime_status"] == "stopped"),
    "ok_total": sum(1 for s in subjects if s["status"] == "ok"),
    "partial_total": sum(1 for s in subjects if s["status"] == "partial"),
    "degraded_total": subject_degraded_total + backup_status_degraded_unattached_total,
    "subject_degraded_total": subject_degraded_total,
    "backup_status_degraded_total": backup_status_degraded_total,
    "backup_status_degraded_unattached_total": backup_status_degraded_unattached_total,
    "gap_total": sum(1 for s in subjects if s["status"] == "gap"),
    "residue_total": sum(1 for s in subjects if s["status"] == "residue"),
    "inventory_targets_total": len(inventory_targets),
    "inventory_disabled_total": sum(1 for r in inventory_targets if r.get("enabled") is False),
    "inventory_enabled_only_total": sum(1 for r in inventory_targets if r.get("enabled") is True),
}

print(json.dumps({
    "capability": "backup.estate.readback.status",
    "status": overall,
    "control_node": "pve-r620",
    "mutation_performed": False,
    "backup_job_performed": False,
    "restore_execution_performed": False,
    "deletion_performed": False,
    "hypervisor_sources": {
        host: {
            "ssh_rc": doc["ssh_rc"],
            "job_count": len(doc["jobs"]),
            "jobs": doc["jobs"],
        }
        for host, doc in host_docs.items()
    },
    "backup_status_exit_code": backup_status_rc,
    "backup_status_summary": backup_summary,
    "backup_status_degraded_targets": backup_status_degraded_targets,
    "counts": counts,
    "subjects": subjects,
    "inventory_targets": inventory_targets,
    "disabled_classification_counts": disabled_classification_counts,
    "gaps": gaps,
}, indent=2, sort_keys=True))
PY

if [[ "$JSON_MODE" -eq 1 ]]; then
  cat "$results_json"
  exit 0
fi

echo "backup.estate.readback.status"
echo "status: $(jq -r '.status' "$results_json")"
echo "control_node: $(jq -r '.control_node' "$results_json")"
echo "subjects: $(jq -r '.counts.subjects_total' "$results_json") total, $(jq -r '.counts.running_total' "$results_json") running, $(jq -r '.counts.stopped_total' "$results_json") stopped"
echo "coverage: $(jq -r '.counts.ok_total' "$results_json") ok, $(jq -r '.counts.partial_total' "$results_json") partial, $(jq -r '.counts.degraded_total' "$results_json") degraded, $(jq -r '.counts.gap_total' "$results_json") gaps, $(jq -r '.counts.residue_total' "$results_json") residue"
echo "inventory: $(jq -r '.counts.inventory_targets_total' "$results_json") additional inventory targets ($(jq -r '.counts.inventory_disabled_total' "$results_json") disabled, $(jq -r '.counts.inventory_enabled_only_total' "$results_json") enabled-only)"
disabled_counts="$(jq -r '.disabled_classification_counts | to_entries | map("\(.key)=\(.value)") | join(", ")' "$results_json")"
if [[ -n "$disabled_counts" ]]; then
  echo "disabled_classification: $disabled_counts"
fi
echo
printf '%-14s %-5s %-26s %-10s %-10s %-36s %s\n' "HOST" "VMID" "NAME" "RUNTIME" "STATUS" "TARGET" "REASON / DISABLED_CLASSIFICATION"
jq -r '.subjects[] | [.host, .vmid, .name, .runtime_status, .status, (.backup_target // "-"), .reason, (.disabled_classification // "-"), (if (.recovery_alternative // []) == [] then "-" else (.recovery_alternative | join(",")) end), (.drill_evidence_present | tostring)] | @tsv' "$results_json" \
  | while IFS=$'\t' read -r host vmid name runtime status target reason disabled_class recovery drill; do
      base="$reason"
      if [[ "$disabled_class" != "-" && -n "$disabled_class" ]]; then
        base="$reason | disabled=$disabled_class"
        if [[ "$recovery" != "-" && -n "$recovery" ]]; then
          base="$base | recovery=$recovery"
        fi
        if [[ "$drill" == "true" ]]; then
          base="$base | drill_evidence=true"
        fi
      fi
      printf '%-14s %-5s %-26s %-10s %-10s %-36s %s\n' "$host" "$vmid" "$name" "$runtime" "$status" "$target" "$base"
    done

inventory_count="$(jq -r '.counts.inventory_targets_total' "$results_json")"
if [[ "$inventory_count" -gt 0 ]]; then
  echo
  echo "inventory targets (not represented by a live Proxmox guest):"
  printf '%-22s %-36s %-10s %-32s %s\n' "HOST" "TARGET" "ENABLED" "DISABLED_CLASSIFICATION" "RECOVERY_ALTERNATIVE / DRILL"
  jq -r '.inventory_targets[] | [(.host // "-"), .name, (.enabled | tostring), (.disabled_classification // "-"), (if (.recovery_alternative // []) == [] then "-" else (.recovery_alternative | join(",")) end), (.drill_evidence_present | tostring)] | @tsv' "$results_json" \
    | while IFS=$'\t' read -r host name enabled disabled recovery drill; do
        suffix=""
        if [[ "$recovery" != "-" && -n "$recovery" ]]; then
          suffix="recovery=$recovery"
        fi
        if [[ "$drill" == "true" ]]; then
          if [[ -n "$suffix" ]]; then
            suffix="$suffix | drill_evidence=true"
          else
            suffix="drill_evidence=true"
          fi
        fi
        if [[ -z "$suffix" ]]; then suffix="-"; fi
        printf '%-22s %-36s %-10s %-32s %s\n' "$host" "$name" "$enabled" "$disabled" "$suffix"
      done
fi

if [[ "$SHOW_DETAILS" -eq 1 ]]; then
  echo
  cat "$results_json"
fi
