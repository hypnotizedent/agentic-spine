#!/usr/bin/env bash
# TRIAGE: centralized mutating promoter for tracked snapshot bindings.
# This is the ONLY governed tracked promotion path for snapshot surfaces.
# All snapshot/status capabilities MUST use --check (runtime-only) by default.
# This surface invokes the underlying capability with --apply to write the
# tracked binding explicitly.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"
OPS_BIN="$ROOT/bin/ops"
CONTRACT="$ROOT/ops/bindings/snapshot.surface.contract.yaml"

DRY_RUN=0
TARGETS=()
ALL=0
LIST_GOVERNED=0

usage() {
  cat <<'USAGE'
snapshot-projection-apply — centralized tracked snapshot promoter

Usage:
  ./bin/ops cap run snapshot.projection.apply -- --all
  ./bin/ops cap run snapshot.projection.apply -- --target ha.inventory.snapshot.yaml
  ./bin/ops cap run snapshot.projection.apply -- --all --dry-run
  ./bin/ops cap run snapshot.projection.apply -- --list-governed

Flags:
  --all                 Promote all governed tracked snapshot surfaces.
  --target <file>       Promote a single snapshot surface (base filename).
  --dry-run             Show what would be promoted without writing.
  --list-governed       List governed tracked snapshot targets.
  -h|--help             Show this help.

Safety:
  This capability requires manual approval (safety=mutating, approval=manual).
  It invokes each underlying snapshot capability with --apply to write the
  tracked binding in ops/bindings/. All other snapshot invocations default to
  --check mode which writes only to runtime/domain-state/snapshots/.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL=1; shift ;;
    --target)
      TARGETS+=("${2:-}")
      shift 2
      ;;
    --dry-run) DRY_RUN=1; shift ;;
    --list-governed) LIST_GOVERNED=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *)
      echo "snapshot-projection-apply FAIL: unknown arg '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
done

command -v yq >/dev/null 2>&1 || { echo "snapshot-projection-apply FAIL: missing dependency yq" >&2; exit 1; }
[[ -f "$CONTRACT" ]] || { echo "snapshot-projection-apply FAIL: missing contract $CONTRACT" >&2; exit 1; }

load_all_targets() {
  yq -r '.governed_surfaces[].tracked_binding | split("/") | .[-1]' "$CONTRACT" 2>/dev/null
}

resolve_cap() {
  local target="$1"
  yq -r --arg target "$target" '.governed_surfaces[] | select((.tracked_binding | split("/") | .[-1]) == $target) | .capability' "$CONTRACT" 2>/dev/null | head -n1
}

resolve_tracked_rel() {
  local target="$1"
  yq -r --arg target "$target" '.governed_surfaces[] | select((.tracked_binding | split("/") | .[-1]) == $target) | .tracked_binding' "$CONTRACT" 2>/dev/null | head -n1
}

if [[ "$LIST_GOVERNED" -eq 1 ]]; then
  load_all_targets
  exit 0
fi

if [[ "$ALL" -eq 1 ]]; then
  mapfile -t TARGETS < <(load_all_targets)
fi

if [[ "${#TARGETS[@]}" -eq 0 ]]; then
  echo "snapshot-projection-apply FAIL: specify --all or --target <file>" >&2
  usage >&2
  exit 1
fi

PASS=0
FAIL=0
SKIP=0

for target in "${TARGETS[@]}"; do
  cap="$(resolve_cap "$target" 2>/dev/null || true)"
  tracked_rel="$(resolve_tracked_rel "$target" 2>/dev/null || true)"
  if [[ -z "$cap" || -z "$tracked_rel" || "$cap" == "null" || "$tracked_rel" == "null" ]]; then
    echo "SKIP: unknown target '$target' (not in tracked targets list)"
    SKIP=$((SKIP + 1))
    continue
  fi
  tracked_path="$ROOT/$tracked_rel"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY-RUN: would run '$cap --apply' -> $tracked_path"
    continue
  fi

  echo "PROMOTE: running $cap --apply -> $tracked_path"
  before_hash="missing"
  if [[ -f "$tracked_path" ]]; then
    before_hash=$(shasum -a 256 "$tracked_path" | awk '{print $1}')
  fi

  if "$OPS_BIN" cap run "$cap" -- --apply 2>&1; then
    after_hash="missing"
    if [[ -f "$tracked_path" ]]; then
      after_hash=$(shasum -a 256 "$tracked_path" | awk '{print $1}')
    fi
    if [[ "$before_hash" == "$after_hash" ]]; then
      echo "  result=no-change (tracked file unchanged)"
    else
      echo "  result=promoted (hash changed)"
    fi
    PASS=$((PASS + 1))
  else
    rc=$?
    echo "  result=FAIL (rc=$rc)"
    FAIL=$((FAIL + 1))
  fi
done

echo ""
echo "snapshot-projection-apply summary: pass=$PASS fail=$FAIL skip=$SKIP dry_run=$DRY_RUN"

if [[ "$FAIL" -gt 0 ]]; then
  exit 1
fi
