bash "$ROOT/surfaces/verify/d-intake-master-projection-lineage-lock.sh"
bash "$ROOT/surfaces/verify/d-projection-generated-only-discipline-lock.sh"
bash "$ROOT/surfaces/verify/d406-concern-projection-registration-completeness-lock.sh"

echo "docs.projection.verify"
echo "status: OK"
