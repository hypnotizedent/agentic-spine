#!/usr/bin/env bash
set -euo pipefail

ROOT="${SPINE_CODE:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"

"$ROOT/ops/plugins/core/ops/bin/gen-entry-surface-gate-metadata.sh" --check
"$ROOT/ops/plugins/core/ops/bin/gen-boot-entry-surface.sh" --check
