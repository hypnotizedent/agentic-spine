#!/usr/bin/env bash
set -euo pipefail

# home-health-check: HTTP health probes for home services
ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
# shellcheck source=ops/lib/ssh-resolve.sh
source "$ROOT/ops/lib/ssh-resolve.sh"

echo "=== Home Services Health Check ==="
echo ""

check_service() {
    local name="$1" url="$2" expect="$3"
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -m 5 "$url" 2>/dev/null || echo "000")
    if [[ "$http_code" == "$expect" ]]; then
        echo "  $name: OK (HTTP $http_code)"
    else
        echo "  $name: FAIL (HTTP $http_code, expected $expect)"
    fi
}

HA_HOST="${HA_HOST:-$(ssh_resolve_probe_host ha 2>/dev/null | awk '{print $1}')}"
HA_PORT="${HA_PORT:-8123}"
[[ -n "$HA_HOST" ]] || { echo "ERROR: Cannot resolve ha probe host" >&2; exit 1; }
check_service "Home Assistant" "http://${HA_HOST}:${HA_PORT}/api/" "401"

PIHOLE_HOST="${PIHOLE_HOST:-$(ssh_resolve_probe_host pihole-home 2>/dev/null | awk '{print $1}')}"
PIHOLE_PORT="${PIHOLE_PORT:-80}"
[[ -n "$PIHOLE_HOST" ]] || { echo "ERROR: Cannot resolve pihole-home probe host" >&2; exit 1; }
check_service "Pi-hole" "http://${PIHOLE_HOST}:${PIHOLE_PORT}/admin/" "302"

echo ""
echo "--- Stopped / Decommissioned services (skipped) ---"
echo "  Vaultwarden (VM 102): decommissioned 2026-02-16 (superseded by infra-core)"
echo "  Immich-home (VM 101): stopped"
echo "  download-home (LXC 103): stopped"

echo ""
echo "=== Done ==="
