#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_SPINE_ROOT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
if [[ -z "${SPINE_ROOT:-}" || ! -r "${SPINE_ROOT}/ops/plugins/providers/gitea/lib/gitea-api.sh" ]]; then
  SPINE_ROOT="$DEFAULT_SPINE_ROOT"
fi

# shellcheck source=/Users/ronnyworks/code/agentic-spine/ops/plugins/providers/gitea/lib/gitea-api.sh
source "$SPINE_ROOT/ops/plugins/providers/gitea/lib/gitea-api.sh"

usage() {
  cat <<'EOF'
gitea-pr-list - governed Gitea pull request list surface

Usage:
  gitea-pr-list [--repo owner/repo] [--state open|closed|all] [--limit N] [--json]
EOF
}

REPO_SLUG=""
STATE="open"
LIMIT="20"
JSON_OUT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO_SLUG="${2:-}"; shift 2 ;;
    --state) STATE="${2:-}"; shift 2 ;;
    --limit) LIMIT="${2:-}"; shift 2 ;;
    --json) JSON_OUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) gitea_stop "unknown argument: $1" ;;
  esac
done

case "$STATE" in
  open|closed|all) ;;
  *) gitea_stop "--state must be one of: open, closed, all" ;;
esac
[[ "$LIMIT" =~ ^[0-9]+$ ]] || gitea_stop "--limit must be numeric"

gitea_require_tool python3
repo_slug="$(gitea_repo_slug_resolve "$REPO_SLUG")"
owner="$(gitea_repo_owner "$repo_slug")"
repo="$(gitea_repo_name "$repo_slug")"
payload="$(gitea_api_request GET "/api/v1/repos/${owner}/${repo}/pulls?state=${STATE}&limit=${LIMIT}")"

if [[ "$JSON_OUT" -eq 1 ]]; then
  GITEA_PR_PAYLOAD="$payload" python3 - "$repo_slug" "$STATE" "$LIMIT" <<'PY'
import json
import os
import sys

prs = json.loads(os.environ["GITEA_PR_PAYLOAD"])
repo_slug, state, limit = sys.argv[1:4]
summary = []
for pr in prs:
    head = pr.get("head") or {}
    base = pr.get("base") or {}
    summary.append({
        "number": pr.get("number"),
        "title": pr.get("title"),
        "state": pr.get("state"),
        "draft": pr.get("draft", False),
        "merged": pr.get("merged", False),
        "head": (head.get("label") or head.get("ref")),
        "base": (base.get("label") or base.get("ref")),
        "url": pr.get("html_url"),
    })
print(json.dumps({
    "surface": "gitea.pr.list",
    "repo": repo_slug,
    "state": state,
    "limit": int(limit),
    "count": len(summary),
    "pull_requests": summary,
}, indent=2))
PY
  exit 0
fi

GITEA_PR_PAYLOAD="$payload" python3 - "$repo_slug" "$STATE" <<'PY'
import json
import os
import sys

prs = json.loads(os.environ["GITEA_PR_PAYLOAD"])
repo_slug, state = sys.argv[1:3]
print("gitea.pr.list")
print(f"repo: {repo_slug}")
print(f"state: {state}")
print(f"count: {len(prs)}")
for pr in prs:
    head = pr.get("head") or {}
    base = pr.get("base") or {}
    print("---")
    print(f"number: {pr.get('number')}")
    print(f"title: {pr.get('title')}")
    print(f"status: {pr.get('state')}")
    print(f"draft: {pr.get('draft', False)}")
    print(f"merged: {pr.get('merged', False)}")
    print(f"head: {head.get('label') or head.get('ref') or 'unknown'}")
    print(f"base: {base.get('label') or base.get('ref') or 'unknown'}")
    print(f"url: {pr.get('html_url') or 'n/a'}")
PY
