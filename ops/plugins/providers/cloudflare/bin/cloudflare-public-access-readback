#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

import yaml


ROOT = Path(__file__).resolve().parents[5]
SECRETS_EXEC = ROOT / "ops/plugins/infra/secrets/bin/secrets-exec"
CF_BINDING = ROOT / "ops/bindings/cloudflare.inventory.yaml"
HOME_INGRESS = ROOT / "ops/bindings/home.ingress.map.yaml"
SHOP_INGRESS = ROOT / "ops/bindings/shop.ingress.map.yaml"
COCKPIT_CONTRACT = ROOT / "ops/bindings/operator.cockpit.contract.yaml"
BRIDGE_ENDPOINTS = ROOT / "ops/bindings/mailroom.bridge.endpoints.yaml"

LIFECYCLE_VOCABULARY = [
    "canonical",
    "live",
    "compatibility_hold",
    "declared_only",
    "unowned_live_route",
    "ghost",
    "parked",
    "retired",
    "unknown",
]

PROOF_MODEL = {
    "declaration": "Repo-side declared owner/source for the hostname.",
    "dns_record": "Cloudflare DNS record presence for the hostname.",
    "tunnel_route": "Cloudflare Tunnel ingress route presence when the surface is tunnel-backed.",
    "access_policy": "Cloudflare Access app/policy proof when the surface is Access-protected.",
    "service_reachability": "Target service reachability. Currently modeled but not probed by this readback.",
}


def load_yaml(path):
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def cf_request(path, mode):
    base = os.environ.get("CLOUDFLARE_API_BASE", "https://api.cloudflare.com/client/v4").rstrip("/")
    url = path
    if path.startswith("/"):
        url = base + path
    headers = {"Content-Type": "application/json"}
    if mode == "token":
        token = os.environ.get("CLOUDFLARE_API_TOKEN", "")
        if not token:
            return None, {"status": "blocked", "reason": "missing_CLOUDFLARE_API_TOKEN", "mode": mode}
        headers["Authorization"] = f"Bearer {token}"
    elif mode == "read_all_token":
        token = os.environ.get("CLOUDFLARE_TOKEN_READ_ALL_RESOURCES", "")
        if not token:
            return None, {"status": "blocked", "reason": "missing_CLOUDFLARE_TOKEN_READ_ALL_RESOURCES", "mode": mode}
        headers["Authorization"] = f"Bearer {token}"
    elif mode == "global":
        email = os.environ.get("CLOUDFLARE_AUTH_EMAIL", "")
        key = os.environ.get("CLOUDFLARE_GLOBAL_API_KEY", "")
        if not email or not key:
            return None, {"status": "blocked", "reason": "missing_global_key_auth", "mode": mode}
        headers["X-Auth-Email"] = email
        headers["X-Auth-Key"] = key
    else:
        return None, {"status": "blocked", "reason": "unknown_auth_mode", "mode": mode}
    req = urllib.request.Request(
        url,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            return json.load(resp), None
    except urllib.error.HTTPError as exc:
        return None, {"status": "blocked", "http_status": exc.code, "mode": mode}
    except Exception as exc:
        return None, {"status": "blocked", "reason": type(exc).__name__, "mode": mode}


def cf_get(path, allow_global_fallback=True):
    errors = []
    data, err = cf_request(path, "token")
    if not err:
        return data, None, "token"
    errors.append(err)
    if allow_global_fallback and err.get("http_status") in (401, 403):
        data, read_all_err = cf_request(path, "read_all_token")
        if not read_all_err:
            return data, None, "read_all_token"
        errors.append(read_all_err)
        data, global_err = cf_request(path, "global")
        if not global_err:
            return data, None, "global"
        errors.append(global_err)
    return None, {"status": "blocked", "attempts": errors}, ""


def tunnel_ingress(binding):
    account = os.environ.get("CLOUDFLARE_ACCOUNT_ID", "")
    tunnel_id = os.environ.get("CLOUDFLARE_TUNNEL_ID", "")
    if not tunnel_id:
        for tunnel in binding.get("tunnels", []) or []:
            if tunnel.get("name") == "homelab-tunnel":
                tunnel_id = tunnel.get("id") or ""
                break
    if not account or not tunnel_id:
        return {}, {"status": "blocked", "reason": "missing_account_or_tunnel_id"}

    data, err, auth_mode = cf_get(f"/accounts/{account}/cfd_tunnel/{tunnel_id}/configurations")
    if err:
        return {}, err
    if not data or not data.get("success"):
        return {}, {"status": "blocked", "reason": "cloudflare_success_false"}
    result = data.get("result") or {}
    cfg = result.get("config") or result.get("configuration") or result
    rows = {}
    for rule in cfg.get("ingress") or []:
        if not isinstance(rule, dict):
            continue
        service = (rule.get("service") or "").strip()
        hosts = []
        if isinstance(rule.get("hostname"), str):
            hosts.append(rule["hostname"])
        if isinstance(rule.get("hostnames"), list):
            hosts.extend([h for h in rule["hostnames"] if isinstance(h, str)])
        for host in hosts:
            host = host.strip()
            if host:
                rows[host] = service
    return rows, {"status": "ok", "auth_mode": auth_mode}


def zone_for_host(binding, host):
    zones = [z for z in binding.get("zones", []) or [] if z.get("name") and z.get("id")]
    matches = [z for z in zones if host == z["name"] or host.endswith(f".{z['name']}")]
    if not matches:
        return {}
    return sorted(matches, key=lambda z: len(z["name"]), reverse=True)[0]


def dns_records(binding):
    records = {}
    api_status = {"status": "not_checked"}
    auth_modes = set()
    for zone in binding.get("zones", []) or []:
        zone_id = zone.get("id")
        zone_name = zone.get("name")
        if not zone_id or not zone_name:
            continue
        data, err, auth_mode = cf_get(f"/zones/{zone_id}/dns_records?per_page=1000")
        if err:
            api_status = err
            continue
        if not data or not data.get("success"):
            api_status = {"status": "blocked", "reason": "cloudflare_success_false"}
            continue
        auth_modes.add(auth_mode)
        for record in data.get("result") or []:
            name = record.get("name")
            if not name:
                continue
            entry = records.setdefault(name, {"zone": zone_name, "types": [], "proxied": [], "auth_modes": set()})
            if record.get("type"):
                entry["types"].append(record["type"])
            if "proxied" in record:
                entry["proxied"].append(bool(record.get("proxied")))
            entry["auth_modes"].add(auth_mode)
    if api_status.get("status") == "not_checked":
        api_status = {"status": "ok", "auth_mode": ",".join(sorted(auth_modes)) or "unknown"}
    for entry in records.values():
        entry["types"] = sorted(set(entry["types"]))
        entry["proxied"] = sorted(set(entry["proxied"]))
        entry["auth_modes"] = sorted(entry["auth_modes"])
    return records, api_status


def access_apps(binding):
    account = os.environ.get("CLOUDFLARE_ACCOUNT_ID", "")
    by_domain = {}
    api_status = {"status": "not_checked"}
    policies_by_domain = {}
    if account:
        data, err, auth_mode = cf_get(f"/accounts/{account}/access/apps")
        if err:
            api_status = err
        elif data and data.get("success"):
            api_status = {"status": "ok", "auth_mode": auth_mode}
            for app in data.get("result") or []:
                domain = app.get("domain")
                domains = domain if isinstance(domain, list) else [domain]
                for item in domains:
                    if isinstance(item, str) and item:
                        by_domain[item] = {
                            "name": app.get("name", ""),
                            "id": app.get("id", ""),
                            "source": "cloudflare_api",
                        }
                        policies, policy_err, policy_auth = cf_get(f"/accounts/{account}/access/apps/{app.get('id')}/policies")
                        if policies and policies.get("success"):
                            policies_by_domain[item] = summarize_policies(policies.get("result") or [], policy_auth)
                        elif policy_err:
                            policies_by_domain[item] = {"status": "blocked", "error": policy_err}
        else:
            api_status = {"status": "blocked", "reason": "cloudflare_success_false"}

    for app in binding.get("access_apps", []) or []:
        domain = app.get("domain")
        if not domain:
            continue
        declared = {
            "name": app.get("name", ""),
            "legacy_name": app.get("legacy_name", ""),
            "purpose": app.get("purpose", ""),
            "owner": app.get("owner", ""),
            "actor_class": app.get("actor_class", ""),
            "auth_method": app.get("auth_method", ""),
            "live_policy_proof": app.get("live_policy_proof", ""),
            "declaration_source": "cloudflare.inventory.yaml",
        }
        existing = by_domain.setdefault(domain, {"source": "cloudflare.inventory.yaml"})
        for key, value in declared.items():
            if value:
                existing[key] = value
    return by_domain, policies_by_domain, api_status


def summarize_rule(rule):
    if not isinstance(rule, dict):
        return "unknown"
    parts = []
    for key, value in sorted(rule.items()):
        if isinstance(value, dict):
            parts.append(f"{key}:{','.join(sorted(value.keys()))}")
        elif isinstance(value, list):
            parts.append(f"{key}:list[{len(value)}]")
        else:
            parts.append(key)
    return "+".join(parts) if parts else "unknown"


def summarize_policies(policies, auth_mode):
    rows = []
    for policy in policies:
        rows.append({
            "name": policy.get("name", ""),
            "decision": policy.get("decision", ""),
            "include": [summarize_rule(rule) for rule in (policy.get("include") or [])],
            "require": [summarize_rule(rule) for rule in (policy.get("require") or [])],
            "exclude": [summarize_rule(rule) for rule in (policy.get("exclude") or [])],
        })
    return {"status": "ok", "auth_mode": auth_mode, "policies": rows}


def ingress_metadata(cockpit=None, bridge=None):
    meta = {}
    for path in (HOME_INGRESS, SHOP_INGRESS):
        data = load_yaml(path)
        for route in data.get("public_routes", []) or []:
            host = route.get("hostname")
            if not host:
                continue
            meta[host] = {
                "purpose": route.get("service", ""),
                "site": data.get("site", ""),
                "stack": route.get("stack", ""),
                "routing_layer": route.get("routing_layer", ""),
                "authority_source": route.get("authority_source", ""),
                "target_hint": route.get("target_hint", ""),
                "lifecycle_class": route.get("lifecycle_class", ""),
                "source": str(path.relative_to(ROOT)),
            }
    cockpit = cockpit or {}
    public_cockpit = ((cockpit.get("authority") or {}).get("public_operator_url") or "").replace("https://", "").replace("http://", "").strip("/")
    if public_cockpit:
        meta.setdefault(public_cockpit, {
            "purpose": "human operator cockpit",
            "site": "spine",
            "stack": "operator-surface",
            "routing_layer": "cloudflare_tunnel",
            "authority_source": str(COCKPIT_CONTRACT.relative_to(ROOT)),
            "target_hint": ((cockpit.get("authority") or {}).get("canonical_operator_url") or "").rstrip("/"),
            "lifecycle_class": "canonical",
            "source": str(COCKPIT_CONTRACT.relative_to(ROOT)),
        })
    bridge = bridge or {}
    bridge_public = ((bridge.get("endpoints") or {}).get("public_https") or {})
    bridge_former = (bridge_public.get("former_url") or bridge_public.get("url") or "").replace("https://", "").replace("http://", "").strip("/")
    if bridge_former and bridge_public.get("lifecycle_state") == "retired" and bridge_former not in meta:
        meta[bridge_former] = {
            "purpose": "retired mailroom bridge public endpoint",
            "site": "spine",
            "stack": "mailroom-bridge",
            "routing_layer": "cloudflare_tunnel",
            "authority_source": str(BRIDGE_ENDPOINTS.relative_to(ROOT)),
            "target_hint": "",
            "lifecycle_class": "retired",
            "source": str(BRIDGE_ENDPOINTS.relative_to(ROOT)),
        }
    return meta


def normalize_lifecycle(raw, host, declared, routed, public_cockpit):
    raw = (raw or "").strip()
    if host == public_cockpit:
        return "canonical"
    if raw in LIFECYCLE_VOCABULARY:
        return raw
    if raw == "live_if_routed":
        return "live" if routed else "declared_only"
    if declared and routed:
        return "live"
    if declared and not routed:
        return "declared_only"
    if routed and not declared:
        return "unowned_live_route"
    return "unknown"


def access_policy_proof(app, policy_summary, access_api_status):
    if policy_summary.get("status") == "ok":
        return f"policy_proved_{policy_summary.get('auth_mode', 'unknown')}"
    if app.get("live_policy_proof"):
        return app["live_policy_proof"]
    if app:
        return "inventory_only_live_policy_unproved"
    if access_api_status.get("status") == "blocked":
        return f"unproved_access_api_{access_api_status.get('http_status') or access_api_status.get('reason')}"
    return "no_access_app_known"


def build_proofs(host, meta, dns, dns_status, tunnel, tunnel_status, app, policy_summary, auth_policy):
    declaration_source = app.get("declaration_source", "")
    declared = bool(meta) or bool(declaration_source)
    dns_entry = dns.get(host)
    routing_layer = meta.get("routing_layer") or ("cloudflare_tunnel" if host in tunnel else "")
    tunnel_expected = routing_layer == "cloudflare_tunnel" or host in tunnel
    access_expected = bool(app)

    dns_proof = {
        "status": "proved" if dns_entry else ("unproved" if dns_status.get("status") == "blocked" else "missing"),
        "zone": (dns_entry or {}).get("zone", ""),
        "record_types": (dns_entry or {}).get("types", []),
        "proxied": (dns_entry or {}).get("proxied", []),
        "auth_mode": ",".join((dns_entry or {}).get("auth_modes", [])) or dns_status.get("auth_mode", ""),
    }
    tunnel_proof = {
        "status": "proved" if host in tunnel else ("missing" if tunnel_expected else "not_applicable"),
        "target": tunnel.get(host, ""),
        "auth_mode": tunnel_status.get("auth_mode", ""),
    }
    access_proof = {
        "status": "proved" if policy_summary.get("status") == "ok" else ("unproved" if access_expected else "not_applicable"),
        "app_known": bool(app),
        "auth_mode": policy_summary.get("auth_mode", ""),
        "summary": policy_summary,
        "legacy_proof_value": auth_policy,
    }
    return {
        "declaration": {
            "status": "proved" if declared else "missing",
            "source": meta.get("source", "") or declaration_source,
            "authority_source": meta.get("authority_source", "") or declaration_source,
        },
        "dns_record": dns_proof,
        "tunnel_route": tunnel_proof,
        "access_policy": access_proof,
        "service_reachability": {
            "status": "not_checked",
            "reason": "outside_cloudflare_public_access_readback_scope",
        },
    }


def summarize_proof_status(lifecycle, proofs):
    gaps = []
    if proofs["declaration"]["status"] != "proved" and lifecycle not in {"retired", "ghost"}:
        gaps.append("missing_declaration")
    if proofs["dns_record"]["status"] != "proved" and lifecycle not in {"retired", "ghost"}:
        gaps.append("missing_dns_record")
    if proofs["tunnel_route"]["status"] == "missing" and lifecycle in {"canonical", "live", "compatibility_hold"}:
        gaps.append("missing_tunnel_route")
    if proofs["access_policy"]["app_known"] and proofs["access_policy"]["status"] != "proved":
        gaps.append("access_policy_unproved")
    return "proved" if not gaps else "gapped:" + ",".join(gaps)


def static_purpose(host):
    names = {
        "auth.ronny.works": ("identity/auth surface", "human_operator/admin"),
        "secrets.ronny.works": ("secrets manager", "human_operator/admin"),
        "vault.ronny.works": ("password vault", "human_operator/admin"),
        "git.ronny.works": ("canonical git", "human_operator/agent_actor"),
        "grafana.ronny.works": ("observability", "human_operator/admin"),
        "dash.ronny.works": ("dashboard", "human_operator"),
        "pihole.ronny.works": ("dns admin", "human_operator/admin"),
    }
    return names.get(host, ("", "unknown"))


def build_rows():
    binding = load_yaml(CF_BINDING)
    cockpit = load_yaml(COCKPIT_CONTRACT)
    bridge = load_yaml(BRIDGE_ENDPOINTS)
    ingress = ingress_metadata(cockpit, bridge)
    tunnel, tunnel_status = tunnel_ingress(binding)
    access, access_policies, access_api_status = access_apps(binding)
    dns, dns_status = dns_records(binding)

    hosts = set(tunnel) | set(ingress) | set(access)
    public_cockpit = ((cockpit.get("authority") or {}).get("public_operator_url") or "").replace("https://", "").replace("http://", "").strip("/")
    if public_cockpit:
        hosts.add(public_cockpit)

    bridge_public = ((bridge.get("endpoints") or {}).get("public_https") or {})
    bridge_former = (bridge_public.get("former_url") or bridge_public.get("url") or "").replace("https://", "").replace("http://", "").strip("/")
    if bridge_former:
        hosts.add(bridge_former)

    rows = []
    for host in sorted(hosts):
        meta = ingress.get(host, {})
        purpose = meta.get("purpose", "")
        actor_class = "unknown"
        owner = meta.get("site", "") or "unknown"
        notes = []
        zone = meta.get("zone", "")
        if not zone:
            zone = (zone_for_host(binding, host) or {}).get("name", "")

        static, static_actor = static_purpose(host)
        if static and not purpose:
            purpose = static
            actor_class = static_actor

        if host == public_cockpit:
            purpose = "human operator cockpit"
            actor_class = "human_operator"
            owner = "spine"
            notes.append("canonical_public_operator_url")

        if host == bridge_former:
            notes.append(f"mailroom_bridge_public_claim={bridge_public.get('lifecycle_state', 'unknown')}")

        app = access.get(host, {})
        app_declared = bool(app.get("declaration_source"))
        if app.get("purpose") and not purpose:
            purpose = app["purpose"]
        if app.get("owner") and owner == "unknown":
            owner = app["owner"]
        if app.get("actor_class"):
            actor_class = app["actor_class"]
        auth_mode = app.get("auth_method", "")
        if not auth_mode and app:
            auth_mode = "cloudflare_access"
        if not auth_mode:
            auth_mode = "unknown_or_service_local"

        policy_summary = access_policies.get(host, {})
        auth_policy_proof = access_policy_proof(app, policy_summary, access_api_status)

        route_target = tunnel.get(host, "")
        if not route_target:
            route_target = meta.get("target_hint", "")
        route_state = "live_tunnel" if host in tunnel else "declared_only"
        lifecycle = normalize_lifecycle(meta.get("lifecycle_class", ""), host, bool(meta) or app_declared, host in tunnel, public_cockpit)
        proofs = build_proofs(host, meta, dns, dns_status, tunnel, tunnel_status or {}, app, policy_summary, auth_policy_proof)
        proof_status = summarize_proof_status(lifecycle, proofs)

        if not purpose:
            purpose = "unclassified public route"
        if app.get("legacy_name"):
            notes.append(f"legacy_access_app_name={app['legacy_name']}")

        rows.append({
            "hostname": host,
            "zone": zone,
            "purpose": purpose,
            "route_target": route_target,
            "route_state": route_state,
            "routing_layer": meta.get("routing_layer", "cloudflare_tunnel" if host in tunnel else ""),
            "actor_class": actor_class,
            "auth_mode": auth_mode,
            "auth_policy_proof": auth_policy_proof,
            "access_policy_summary": policy_summary,
            "owner": owner,
            "lifecycle": lifecycle,
            "lifecycle_status": lifecycle,
            "proof_status": proof_status,
            "proofs": proofs,
            "notes": "; ".join(notes),
            "source": meta.get("source", "") or app.get("declaration_source", ""),
        })
    return {
        "capability": "cloudflare.public_access.readback",
        "status": "ok",
        "layer": "L2_shared_infrastructure",
        "boundary": "publication/access adapter; not L1 kernel",
        "cloudflare_access_fit": "Cloudflare Access is the edge identity/auth policy layer for public URLs and machine service-token access. It belongs in L2 because L3 services depend on it, but it must not define the spine kernel.",
        "lifecycle_vocabulary": LIFECYCLE_VOCABULARY,
        "proof_model": PROOF_MODEL,
        "access_policy_api": access_api_status,
        "tunnel_api": tunnel_status or {"status": "blocked"},
        "dns_api": dns_status,
        "rows": rows,
    }


def print_table(payload):
    print("cloudflare.public_access.readback")
    print(f"layer: {payload['layer']}")
    print(f"boundary: {payload['boundary']}")
    print(f"access_policy_api: {payload['access_policy_api']}")
    print(f"tunnel_api: {payload['tunnel_api']}")
    print(f"dns_api: {payload['dns_api']}")
    print(f"lifecycle_vocabulary: {', '.join(payload['lifecycle_vocabulary'])}")
    print("")
    print("| hostname | lifecycle | proof_status | purpose | route | actor | auth | proof | notes |")
    print("|---|---|---|---|---|---|---|---|---|")
    for row in payload["rows"]:
        route = row["route_target"] or row["route_state"]
        print(
            f"| {row['hostname']} | {row['lifecycle_status']} | {row['proof_status']} | {row['purpose']} | {route} | "
            f"{row['actor_class']} | {row['auth_mode']} | {row['auth_policy_proof']} | {row['notes']} |"
        )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if not os.environ.get("SPINE_SECRETS_INJECTED"):
        env = os.environ.copy()
        env["SPINE_SECRETS_INJECTED"] = "1"
        cmd = [str(SECRETS_EXEC), "--", sys.executable, __file__] + sys.argv[1:]
        raise SystemExit(subprocess.call(cmd, env=env))

    payload = build_rows()
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print_table(payload)


if __name__ == "__main__":
    main()
