#!/usr/bin/env bash
# Thin exec shim — canonical implementation lives in workbench
# See: agents/calendar/spine-plugin-calendar/bin/calendar-home-publish
set -euo pipefail
export SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
exec "$HOME/code/workbench/agents/calendar/spine-plugin-calendar/bin/calendar-home-publish" "$@"
