#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[5]
LIB_DIR = ROOT / "ops/plugins/domains/communications/lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from communications_alerts_status_common import collect_runtime_status, queue_contract_path  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="communications-alerts-runtime-status",
        description="Read-only health rollup for the communications alert intent queue and escalation state.",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON output")
    return parser


def render_text(payload: dict[str, object]) -> str:
    data = payload.get("data", {})
    if not isinstance(data, dict):
        data = {}
    lines = [
        "communications.alerts.runtime.status",
        f"status: {payload.get('status', 'unknown')}",
        f"generated_at: {payload.get('generated_at', '')}",
        "",
        str(data.get("oneliner", "")),
        "",
        f"queue_pending_count: {data.get('queue_pending_count', 0)}",
        f"queue_oldest_age_seconds: {data.get('queue_oldest_age_seconds', 0)}",
        f"queue_sent_count: {data.get('queue_sent_count', 0)}",
        f"queue_failed_count: {data.get('queue_failed_count', 0)}",
        f"slo_status: {data.get('slo_status', 'unknown')}",
        f"escalation_recommended: {str(bool(data.get('escalation_recommended', False))).lower()}",
        f"last_escalation_at: {data.get('last_escalation_at', '') or '(none)'}",
        f"last_escalation_fingerprint: {data.get('last_escalation_fingerprint', '') or '(none)'}",
        f"pending_escalation_task_count: {data.get('pending_escalation_task_count', 0)}",
        f"delivery_recent_count: {data.get('delivery_recent_count', 0)}",
        f"delivery_recent_failed: {data.get('delivery_recent_failed', 0)}",
    ]
    recommended_action = str(data.get("recommended_action", ""))
    if recommended_action:
        lines.append(f"recommended_action: {recommended_action}")
    return "\n".join(lines)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    payload = collect_runtime_status(contract_path=queue_contract_path())
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=False))
        return 0
    print(render_text(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
