#!/usr/bin/env bash
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

WORKBENCH_RUNTIME="${COMMUNICATIONS_TARGET_REPO:-${SPINE_FOUNDATION_ROOT:-/Users/ronnyworks/code/workbench}/agents/communications/tools/spine-plugin-communications}/bin/communications-alerts-runtime-status"
JSON=0

resolve_execution_host_dispatcher_access() {
  local registry="$ROOT/ops/bindings/launchd.scheduler.registry.yaml"
  local state_root="${SPINE_STATE:-}"
  local domain_state receipt target_host target_access dispatcher_role access_token local_host

  [[ -f "$registry" ]] || return 1
  dispatcher_role="$(yq -r '.labels[] | select(.label == "com.ronny.communications-alerts-dispatcher") | .intended_node_role // ""' "$registry" 2>/dev/null || true)"
  [[ "$dispatcher_role" == "execution_host" ]] || return 1

  [[ -n "$state_root" ]] || return 1
  domain_state="$state_root/domain-state"
  [[ -d "$domain_state" ]] || return 1

  receipt="$(find "$domain_state" -maxdepth 1 -name 'EXEC_RECEIPT-SPINE-EXECUTION-HOST-ACTIVATION-*.yaml' -type f 2>/dev/null | sort -r | head -1 || true)"
  [[ -n "$receipt" ]] || return 1

  target_host="$(yq -r '.final_live_execution_host // .target_host // ""' "$receipt" 2>/dev/null || true)"
  target_access="$(yq -r '.target_access_path // ""' "$receipt" 2>/dev/null || true)"
  access_token="$(printf '%s\n' "$target_access" | awk '{print $1}')"
  [[ -n "$access_token" ]] || return 1

  local_host="$(hostname -s 2>/dev/null || true)"
  if [[ -n "$target_host" && "$local_host" == "$target_host" ]]; then
    return 1
  fi

  printf '%s\n' "$access_token"
}

maybe_emit_remote_runtime_status() {
  local access_token="$1"
  [[ -n "$access_token" ]] || return 1
  command -v ssh >/dev/null 2>&1 || return 1

  local remote_cmd='set -euo pipefail
source /etc/spine/execution-host.env >/dev/null 2>&1 || true
repo=/home/ubuntu/code/agentic-spine
foundation=/home/ubuntu/code/workbench
contract="$repo/ops/bindings/communications.alerts.queue.contract.yaml"
queue_json="$(env SPINE_ROOT="$repo" SPINE_FOUNDATION_ROOT="$foundation" COMMUNICATIONS_ALERTS_QUEUE_CONTRACT="$contract" "$repo/ops/plugins/domains/communications/bin/communications-alerts-queue-status" --json)"
dispatcher_json="$(env SPINE_ROOT="$repo" SPINE_FOUNDATION_ROOT="$foundation" COMMUNICATIONS_ALERTS_QUEUE_CONTRACT="$contract" "$repo/ops/plugins/domains/communications/bin/communications-alerts-dispatcher-status" --json)"
jq -n --arg source "execution_host" --arg repo "$repo" --arg foundation "$foundation" --arg contract "$contract" --argjson queue "$queue_json" --argjson dispatcher "$dispatcher_json" "{source:\$source, repo:\$repo, foundation:\$foundation, contract:\$contract, queue:\$queue, dispatcher:\$dispatcher}"'

  printf '%s\n' "$remote_cmd" | ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "$access_token" "bash -s" 2>/dev/null
}

emit_remote_rollup() {
  local remote_json="$1"
  local queue_pending_count queue_oldest_age_seconds queue_sent_count queue_failed_count
  local dead_letter_count dispatcher_running
  local slo_status escalation_recommended recommended_action pending_escalation_task_count
  local delivery_recent_count delivery_recent_failed oneliner rollup_status dispatcher_status
  local warn_age incident_age max_pending_warn max_pending_incident dead_letter_warn dead_letter_incident

  queue_pending_count="$(echo "$remote_json" | jq -r '.queue.data.pending_count // 0')"
  queue_oldest_age_seconds="$(echo "$remote_json" | jq -r '.queue.data.oldest_pending_age_seconds // 0')"
  queue_sent_count="$(echo "$remote_json" | jq -r '.queue.data.sent_count // 0')"
  queue_failed_count="$(echo "$remote_json" | jq -r '.queue.data.failed_count // 0')"
  dead_letter_count="$(echo "$remote_json" | jq -r '.queue.data.dead_letter_count // 0')"
  dispatcher_status="$(echo "$remote_json" | jq -r '.dispatcher.status // "unknown"')"
  dispatcher_running="$(echo "$remote_json" | jq -r '.dispatcher.data.running // false')"
  pending_escalation_task_count=0
  delivery_recent_count=0
  delivery_recent_failed=0
  warn_age="$(yq -r '.slo.warn_age_seconds // 3600' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 3600)"
  incident_age="$(yq -r '.slo.incident_age_seconds // 14400' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 14400)"
  max_pending_warn="$(yq -r '.slo.max_pending_warn // 50' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 50)"
  max_pending_incident="$(yq -r '.slo.max_pending_incident // 200' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 200)"
  dead_letter_warn="$(yq -r '.slo.dead_letter_warn // 1' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 1)"
  dead_letter_incident="$(yq -r '.slo.dead_letter_incident // 10' "$ROOT/ops/bindings/domains/communications/communications.alerts.queue.contract.yaml" 2>/dev/null || echo 10)"

  slo_status="ok"
  if [[ "$queue_oldest_age_seconds" -ge "$incident_age" || "$queue_pending_count" -ge "$max_pending_incident" || "$dead_letter_count" -ge "$dead_letter_incident" ]]; then
    slo_status="incident"
  elif [[ "$queue_oldest_age_seconds" -ge "$warn_age" || "$queue_pending_count" -ge "$max_pending_warn" || "$dead_letter_count" -ge "$dead_letter_warn" ]]; then
    slo_status="warn"
  fi
  if [[ "$queue_pending_count" -gt 0 && "$dispatcher_running" != "true" && "$slo_status" == "ok" ]]; then
    slo_status="warn"
  fi
  escalation_recommended="$([[ "$slo_status" == "incident" ]] && echo true || echo false)"
  recommended_action=""
  if [[ "$queue_pending_count" -gt 0 && "$dispatcher_running" != "true" ]]; then
    recommended_action='echo "yes" | ./bin/ops cap run communications.alerts.dispatcher.start'
  elif [[ "$dead_letter_count" -gt 0 ]]; then
    recommended_action='echo "yes" | ./bin/ops cap run communications.alerts.deadletter.replay --limit 10'
  fi
  rollup_status="$slo_status"
  [[ "$rollup_status" == "unknown" ]] && rollup_status="ok"
  oneliner="CommsQueue: ${slo_status} (pending=${queue_pending_count} oldest=${queue_oldest_age_seconds}s escalations=${pending_escalation_task_count})"

  if [[ "$JSON" -eq 1 ]]; then
    jq -n \
      --arg capability "communications.alerts.runtime.status" \
      --arg status "$rollup_status" \
      --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg source "$(echo "$remote_json" | jq -r '.source // "execution_host"')" \
      --arg dispatcher_status "$dispatcher_status" \
      --argjson queue_pending_count "$queue_pending_count" \
      --argjson queue_oldest_age_seconds "$queue_oldest_age_seconds" \
      --argjson queue_sent_count "$queue_sent_count" \
      --argjson queue_failed_count "$queue_failed_count" \
      --argjson dead_letter_count "$dead_letter_count" \
      --arg slo_status "$slo_status" \
      --argjson escalation_recommended "$([[ "$escalation_recommended" == "true" ]] && echo true || echo false)" \
      --arg last_escalation_at "" \
      --arg last_escalation_fingerprint "" \
      --argjson pending_escalation_task_count "$pending_escalation_task_count" \
      --arg recommended_action "$recommended_action" \
      --argjson slo_reasons "$(jq -nc --argjson pending "$queue_pending_count" --argjson oldest "$queue_oldest_age_seconds" --argjson dead "$dead_letter_count" --argjson warn_age "$warn_age" --argjson incident_age "$incident_age" --argjson warn_pending "$max_pending_warn" --argjson incident_pending "$max_pending_incident" --argjson warn_dead "$dead_letter_warn" --argjson incident_dead "$dead_letter_incident" --arg running "$dispatcher_running" '
        [
          (if $oldest >= $incident_age and $incident_age > 0 then "oldest_pending_age \($oldest)s >= incident_threshold \($incident_age)s" else empty end),
          (if $oldest >= $warn_age and $oldest < $incident_age and $warn_age > 0 then "oldest_pending_age \($oldest)s >= warn_threshold \($warn_age)s" else empty end),
          (if $pending >= $incident_pending and $incident_pending > 0 then "pending_count \($pending) >= incident_threshold \($incident_pending)" else empty end),
          (if $pending >= $warn_pending and $pending < $incident_pending and $warn_pending > 0 then "pending_count \($pending) >= warn_threshold \($warn_pending)" else empty end),
          (if $dead >= $incident_dead and $incident_dead > 0 then "dead_letter_count \($dead) >= incident_threshold \($incident_dead)" else empty end),
          (if $dead >= $warn_dead and $dead < $incident_dead and $warn_dead > 0 then "dead_letter_count \($dead) >= warn_threshold \($warn_dead)" else empty end),
          (if $pending > 0 and $running != "true" then "dispatcher_not_running_with_pending_queue" else empty end)
        ]')" \
      --argjson delivery_recent_count "$delivery_recent_count" \
      --argjson delivery_recent_failed "$delivery_recent_failed" \
      --arg oneliner "$oneliner" \
      '{
        capability: $capability,
        status: $status,
        generated_at: $generated_at,
        source: $source,
        data: {
          queue_pending_count: $queue_pending_count,
          queue_oldest_age_seconds: $queue_oldest_age_seconds,
          queue_sent_count: $queue_sent_count,
          queue_failed_count: $queue_failed_count,
          dead_letter_count: $dead_letter_count,
          slo_status: $slo_status,
          escalation_recommended: $escalation_recommended,
          last_escalation_at: $last_escalation_at,
          last_escalation_fingerprint: $last_escalation_fingerprint,
          pending_escalation_task_count: $pending_escalation_task_count,
          recommended_action: $recommended_action,
          slo_reasons: $slo_reasons,
          delivery_recent_count: $delivery_recent_count,
          delivery_recent_failed: $delivery_recent_failed,
          dispatcher_status: $dispatcher_status,
          oneliner: $oneliner
        }
      }'
  else
    echo "communications.alerts.runtime.status"
    echo "status: $rollup_status"
    echo "generated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo ""
    echo "$oneliner"
    echo ""
    echo "source: execution_host"
    echo "dispatcher_status: $dispatcher_status"
    echo "recommended_action: $recommended_action"
  fi
}

emit_remote_read_failed() {
  local remote_error="$1"
  local oneliner="CommsQueue: unknown (execution_host read failed; local queue not authoritative)"
  if [[ "$JSON" -eq 1 ]]; then
    jq -n \
      --arg capability "communications.alerts.runtime.status" \
      --arg status "unknown" \
      --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg source "execution_host" \
      --arg remote_error "$remote_error" \
      --arg oneliner "$oneliner" \
      '{
        capability: $capability,
        status: $status,
        generated_at: $generated_at,
        source: $source,
        data: {
          queue_pending_count: 0,
          queue_oldest_age_seconds: 0,
          queue_sent_count: 0,
          queue_failed_count: 0,
          slo_status: "unknown",
          escalation_recommended: false,
          last_escalation_at: "",
          last_escalation_fingerprint: "",
          pending_escalation_task_count: 0,
          recommended_action: "",
          slo_reasons: [],
          delivery_recent_count: 0,
          delivery_recent_failed: 0,
          remote_read_failed: true,
          remote_error: $remote_error,
          oneliner: $oneliner
        }
      }'
  else
    echo "communications.alerts.runtime.status"
    echo "status: unknown"
    echo "generated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo ""
    echo "$oneliner"
    echo ""
    echo "source: execution_host"
    echo "remote_error: $remote_error"
  fi
}

usage() {
  cat <<'USAGE'
Usage: communications-alerts-runtime-status [--json]

Remote-first communications queue health rollup for watcher/status embedding.
When the dispatcher role is execution_host, this surface must read execution-host
truth or return an explicit remote-read failure. It must not silently fall back
to the operator-console queue.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ "${COMMUNICATIONS_ALERTS_RUNTIME_LOCAL_ONLY:-0}" != "1" ]]; then
  remote_access="$(resolve_execution_host_dispatcher_access || true)"
  if [[ -n "$remote_access" ]]; then
    remote_json="$(maybe_emit_remote_runtime_status "$remote_access" || true)"
    if [[ -n "$remote_json" ]] && echo "$remote_json" | jq -e '.queue and .dispatcher' >/dev/null 2>&1; then
      emit_remote_rollup "$remote_json"
      exit 0
    fi
    emit_remote_read_failed "execution_host compound probe failed"
    exit 0
  fi
fi

export SPINE_ROOT="$ROOT"
exec "$WORKBENCH_RUNTIME" "$@"
