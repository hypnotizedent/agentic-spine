#!/usr/bin/env bash
# communications-mail-archiver-restore-drill — governed scratch restore proof for mail-archiver
# Domain: communications
# Safety: mutating
# Approval: auto
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
BACKUP_CONTRACT="$ROOT/ops/bindings/mail.archiver.backup.contract.yaml"
BACKUP_SCHEDULE="$ROOT/ops/bindings/backup.schedule.yaml"
BACKUP_INVENTORY="$ROOT/ops/bindings/backup.inventory.yaml"
CONTRACT="$ROOT/ops/bindings/communications.stack.contract.yaml"
SSH_BINDING="$ROOT/ops/bindings/ssh.targets.yaml"
RECEIPT_DIR="$ROOT/mailroom/outbox/reports/restore-drills"
TARGET_ID=""
KEEP_ARTIFACTS=0

fail() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

need yq
need jq
need ssh
[[ -f "$BACKUP_CONTRACT" ]] || fail "missing backup contract: $BACKUP_CONTRACT"
[[ -f "$BACKUP_SCHEDULE" ]] || fail "missing backup schedule: $BACKUP_SCHEDULE"
[[ -f "$BACKUP_INVENTORY" ]] || fail "missing backup inventory: $BACKUP_INVENTORY"
[[ -f "$CONTRACT" ]] || fail "missing communications contract: $CONTRACT"
[[ -f "$SSH_BINDING" ]] || fail "missing ssh binding: $SSH_BINDING"

usage() {
  cat <<'EOF'
Usage: communications-mail-archiver-restore-drill [--target <ssh-target>] [--keep-artifacts]

Runs a scratch restore of the latest canonical mail-archiver artifact set on communications-stack,
compares the restored database and uploads payload against the canonical manifest, and writes a
single YAML receipt under mailroom/outbox/reports/restore-drills/.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --target|--ssh-id) TARGET_ID="${2:?--target requires a value}"; shift 2 ;;
    --keep-artifacts) KEEP_ARTIFACTS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

if [[ -z "$TARGET_ID" ]]; then
  TARGET_ID="$(yq e -r '.mail_archiver.monitoring.machine_status_target.ssh_target // ""' "$CONTRACT")"
  if [[ -z "$TARGET_ID" || "$TARGET_ID" == "null" ]]; then
    TARGET_ID="$(yq e -r '.pilot.vm_target.hostname // ""' "$CONTRACT")"
  fi
fi
[[ -n "$TARGET_ID" && "$TARGET_ID" != "null" ]] || fail "target id not found"

DEF_USER="$(yq e -r '.ssh.defaults.user // "root"' "$SSH_BINDING")"
DEF_PORT="$(yq e -r '.ssh.defaults.port // 22' "$SSH_BINDING")"
DEF_TO="$(yq e -r '.ssh.defaults.connect_timeout_sec // 5' "$SSH_BINDING")"

TARGET_HOST="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .host // \"\"" "$SSH_BINDING")"
TARGET_USER="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .user // \"$DEF_USER\"" "$SSH_BINDING")"
TARGET_PORT="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .port // $DEF_PORT" "$SSH_BINDING")"
TARGET_TAILSCALE="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .tailscale_ip // \"\"" "$SSH_BINDING")"
[[ -n "$TARGET_HOST" && "$TARGET_HOST" != "null" ]] || fail "ssh target '$TARGET_ID' missing host"
SSH_OPTS="-p $TARGET_PORT -o ConnectTimeout=${DEF_TO} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

PVE_TARGET_ID="$(yq e -r '.model.destination_lanes."r730xd-communications-backups".host // "pve"' "$BACKUP_INVENTORY")"
PVE_TARGET_HOST="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .host // \"\"" "$SSH_BINDING")"
PVE_TARGET_USER="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .user // \"$DEF_USER\"" "$SSH_BINDING")"
PVE_TARGET_PORT="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .port // $DEF_PORT" "$SSH_BINDING")"
PVE_TARGET_TAILSCALE="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .tailscale_ip // \"\"" "$SSH_BINDING")"
[[ -n "$PVE_TARGET_HOST" && "$PVE_TARGET_HOST" != "null" ]] || fail "ssh target '$PVE_TARGET_ID' missing host"
PVE_SSH_OPTS="-p $PVE_TARGET_PORT -o ConnectTimeout=${DEF_TO} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
OFFSITE_BASE="$(yq e -r '.model.destination_lanes."r730xd-communications-backups".base_path // ""' "$BACKUP_INVENTORY")/mail-archiver"

required_manifest_keys=(
  manifest_version
  timestamp
  db_dump_bytes
  uploads_archive_bytes
  schema_public_table_count
  schema_mail_archiver_table_count
  public_ef_migrations_history_rows
  mail_archiver_archived_emails_rows
  mail_archiver_mail_accounts_rows
  mail_archiver_users_rows
  uploads_file_count
)

resolve_ssh_ref() {
  local id="$1"
  local user="$2"
  local host="$3"
  local tailscale="$4"
  local opts="$5"
  local -a candidates=("${id}" "${user}@${host}")
  if [[ -n "$tailscale" && "$tailscale" != "null" && "$tailscale" != "$host" ]]; then
    candidates+=("${user}@${tailscale}")
  fi
  local candidate
  for candidate in "${candidates[@]}"; do
    if ssh $opts "$candidate" "true" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  echo "${user}@${host}"
}

comm_ssh_ref="$(resolve_ssh_ref "$TARGET_ID" "$TARGET_USER" "$TARGET_HOST" "$TARGET_TAILSCALE" "$SSH_OPTS")"
pve_ssh_ref="$(resolve_ssh_ref "$PVE_TARGET_ID" "$PVE_TARGET_USER" "$PVE_TARGET_HOST" "$PVE_TARGET_TAILSCALE" "$PVE_SSH_OPTS")"

comm_ssh() { ssh $SSH_OPTS "$comm_ssh_ref" "$@"; }
pve_ssh() { ssh $PVE_SSH_OPTS "$pve_ssh_ref" "$@"; }

manifest_value() {
  local key="$1"
  local content="$2"
  awk -F= -v k="$key" '$1 == k {print substr($0, index($0, "=") + 1); exit}' <<<"$content"
}

yaml_quote() {
  python3 - <<'PY' "$1"
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

declare -A EXPECTED=()
declare -A ACTUAL=()
comparison_keys=(
  schema_public_table_count
  schema_mail_archiver_table_count
  public_ef_migrations_history_rows
  mail_archiver_archived_emails_rows
  mail_archiver_mail_accounts_rows
  mail_archiver_users_rows
  uploads_file_count
)

BACKUP_BASE="/srv/mail-archiver/backups/last-good"
BACKUP_PARENT="/srv/mail-archiver/backups"
LOCAL_SET=""
for candidate_dir in "$BACKUP_PARENT/last-good" "$BACKUP_PARENT/staging"; do
  while IFS= read -r candidate_db; do
    [[ -n "$candidate_db" ]] || continue
    candidate_base="$(basename "$candidate_db")"
    candidate_ts="${candidate_base#mail-archiver-db-}"
    candidate_ts="${candidate_ts%.sql.gz}"
    candidate_uploads="$candidate_dir/mail-archiver-uploads-${candidate_ts}.tar.gz"
    candidate_manifest="$candidate_dir/mail-archiver-manifest-${candidate_ts}.txt"
    if comm_ssh "test -f '$candidate_uploads' && test -f '$candidate_manifest'" >/dev/null 2>&1; then
      LOCAL_SET="$candidate_dir|$candidate_ts|$candidate_db|$candidate_uploads|$candidate_manifest"
      break 2
    fi
  done < <(comm_ssh "find '$candidate_dir' -maxdepth 1 -type f -name 'mail-archiver-db-*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-")
done

[[ -n "$LOCAL_SET" ]] || fail "no complete local artifact set found in $BACKUP_PARENT/{last-good,staging}"
IFS='|' read -r LOCAL_SET_DIR LOCAL_SET_TIMESTAMP LATEST_LOCAL_DB LATEST_LOCAL_UPLOADS LATEST_LOCAL_MANIFEST <<<"$LOCAL_SET"

LOCAL_DB_BASENAME="$(basename "$LATEST_LOCAL_DB")"
LOCAL_UPLOADS_BASENAME="$(basename "$LATEST_LOCAL_UPLOADS")"
LOCAL_MANIFEST_BASENAME="$(basename "$LATEST_LOCAL_MANIFEST")"

LATEST_OFFSITE_DB="$OFFSITE_BASE/$LOCAL_DB_BASENAME"
LATEST_OFFSITE_UPLOADS="$OFFSITE_BASE/$LOCAL_UPLOADS_BASENAME"
LATEST_OFFSITE_MANIFEST="$OFFSITE_BASE/$LOCAL_MANIFEST_BASENAME"
offsite_db_present=false
offsite_uploads_present=false
offsite_manifest_present=false
pve_ssh "test -f '$LATEST_OFFSITE_DB'" >/dev/null 2>&1 && offsite_db_present=true || LATEST_OFFSITE_DB=""
pve_ssh "test -f '$LATEST_OFFSITE_UPLOADS'" >/dev/null 2>&1 && offsite_uploads_present=true || LATEST_OFFSITE_UPLOADS=""
pve_ssh "test -f '$LATEST_OFFSITE_MANIFEST'" >/dev/null 2>&1 && offsite_manifest_present=true || LATEST_OFFSITE_MANIFEST=""

MANIFEST_CONTENT="$(comm_ssh "cat '$LATEST_LOCAL_MANIFEST'")"
for key in "${required_manifest_keys[@]}"; do
  value="$(manifest_value "$key" "$MANIFEST_CONTENT")"
  [[ -n "$value" ]] || fail "manifest missing required key: $key"
  EXPECTED["$key"]="$value"
done
[[ "${EXPECTED[manifest_version]}" == "2" ]] || fail "manifest_version must be 2"

RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DAY="$(date -u +%Y%m%d)"
DRILL_DB="MailArchiver_restore_drill_${RUN_TS//[-:]/}"
DRILL_DB="${DRILL_DB//Z/}"
DRILL_DIR="/tmp/mail-archiver-restore-drill-${RUN_TS}"
mkdir -p "$RECEIPT_DIR"
RECEIPT_PATH="$RECEIPT_DIR/communications-mailarchiver-restore-drill-${RUN_DAY}.yaml"

REMOTE_OUTPUT_FILE="$(mktemp)"
REMOTE_ERROR_FILE="$(mktemp)"
cleanup_local() {
  rm -f "$REMOTE_OUTPUT_FILE" "$REMOTE_ERROR_FILE"
}
trap cleanup_local EXIT

set +e
comm_ssh "bash -s -- '$LATEST_LOCAL_DB' '$LATEST_LOCAL_UPLOADS' '$DRILL_DB' '$DRILL_DIR' '$KEEP_ARTIFACTS' '${EXPECTED[schema_public_table_count]}' '${EXPECTED[schema_mail_archiver_table_count]}' '${EXPECTED[public_ef_migrations_history_rows]}' '${EXPECTED[mail_archiver_archived_emails_rows]}' '${EXPECTED[mail_archiver_mail_accounts_rows]}' '${EXPECTED[mail_archiver_users_rows]}'" <<'REMOTE' >"$REMOTE_OUTPUT_FILE" 2>"$REMOTE_ERROR_FILE"
set -euo pipefail
db_dump="$1"
uploads_archive="$2"
drill_db="$3"
drill_dir="$4"
keep_artifacts="${5:-0}"
expected_schema_public="$6"
expected_schema_mail_archiver="$7"
expected_ef_migrations="${8}"
expected_archived_emails="${9}"
expected_mail_accounts="${10}"
expected_users="${11}"

cleanup() {
  if [[ "$keep_artifacts" != "1" ]]; then
    docker exec -i mail-archiver-db psql -U mailuser -d postgres -v ON_ERROR_STOP=1 <<SQL >/dev/null 2>&1 || true
DROP DATABASE IF EXISTS "$drill_db";
SQL
    rm -rf "$drill_dir"
  fi
}
trap cleanup EXIT

docker exec -i mail-archiver-db psql -U mailuser -d postgres -v ON_ERROR_STOP=1 <<SQL >/dev/null
DROP DATABASE IF EXISTS "$drill_db";
CREATE DATABASE "$drill_db";
SQL

rm -rf "$drill_dir"
mkdir -p "$drill_dir"
tar -xzf "$uploads_archive" -C "$drill_dir"

query_contract_metrics() {
  docker exec -i mail-archiver-db psql -U mailuser -d "$drill_db" -v ON_ERROR_STOP=1 -F $'\t' -At <<'SQL' 2>/dev/null || true
SELECT 'schema_public_table_count', COUNT(*)::bigint::text
FROM information_schema.tables
WHERE table_schema = 'public'
UNION ALL
SELECT 'schema_mail_archiver_table_count', COUNT(*)::bigint::text
FROM information_schema.tables
WHERE table_schema = 'mail_archiver'
UNION ALL
SELECT 'public_ef_migrations_history_rows', COUNT(*)::bigint::text
FROM public."__EFMigrationsHistory"
UNION ALL
SELECT 'mail_archiver_archived_emails_rows', COUNT(*)::bigint::text
FROM mail_archiver."ArchivedEmails"
UNION ALL
SELECT 'mail_archiver_mail_accounts_rows', COUNT(*)::bigint::text
FROM mail_archiver."MailAccounts"
UNION ALL
SELECT 'mail_archiver_users_rows', COUNT(*)::bigint::text
FROM mail_archiver."Users";
SQL
}

counts_tsv="$drill_dir/contract-counts.tsv"

if command -v pigz >/dev/null 2>&1; then
  decompress_cmd=(pigz -dc -p "$(nproc 2>/dev/null || echo 4)" "$db_dump")
else
  decompress_cmd=(gzip -dc "$db_dump")
fi

# Restore the schema plus small control-table data into scratch DB while counting
# contract-table rows directly from the canonical artifact stream.
LC_ALL=C "${decompress_cmd[@]}" | awk -v counts_file="$counts_tsv" '
BEGIN {
  pre_data = 1
  in_copy = 0

  count_targets["public.\"__EFMigrationsHistory\""] = "public_ef_migrations_history_rows"
  count_targets["mail_archiver.\"ArchivedEmails\""] = "mail_archiver_archived_emails_rows"
  count_targets["mail_archiver.\"MailAccounts\""] = "mail_archiver_mail_accounts_rows"
  count_targets["mail_archiver.\"Users\""] = "mail_archiver_users_rows"

  restore_targets["public.\"__EFMigrationsHistory\""] = 1
  restore_targets["mail_archiver.\"MailAccounts\""] = 1
  restore_targets["mail_archiver.\"Users\""] = 1

  target_total = 0
  for (target in count_targets) {
    seen[target] = 0
    counts[count_targets[target]] = 0
    target_total++
  }
}

function copy_target_from_line(line, parts) {
  split(line, parts, " ")
  return parts[2]
}

function seen_all(    target) {
  for (target in count_targets) {
    if (!seen[target]) {
      return 0
    }
  }
  return 1
}

{
  if (!in_copy) {
    if ($0 ~ /^COPY /) {
      pre_data = 0
      in_copy = 1
      current_target = copy_target_from_line($0)
      emit_copy = (current_target in restore_targets)
      if (emit_copy) {
        print
      }
      next
    }
    if (pre_data) {
      print
    }
    next
  }

  if ($0 == "\\.") {
    if (current_target in count_targets) {
      seen[current_target] = 1
    }
    if (emit_copy) {
      print
    }
    in_copy = 0
    current_target = ""
    emit_copy = 0
    if (seen_all()) {
      exit
    }
    next
  }

  if (current_target in count_targets) {
    counts[count_targets[current_target]]++
  }
  if (emit_copy) {
    print
  }
}

END {
  for (target in count_targets) {
    metric = count_targets[target]
    printf "%s\t%s\n", metric, counts[metric] > counts_file
  }
}
' | docker exec -e PGOPTIONS="-c synchronous_commit=off" -i mail-archiver-db psql -U mailuser -d "$drill_db" -v ON_ERROR_STOP=1 >/dev/null

docker exec -i mail-archiver-db psql -U mailuser -d "$drill_db" -v ON_ERROR_STOP=1 -F $'\t' -At <<'SQL'
SELECT 'schema_public_table_count', COUNT(*)::bigint::text
FROM information_schema.tables
WHERE table_schema = 'public'
UNION ALL
SELECT 'schema_mail_archiver_table_count', COUNT(*)::bigint::text
FROM information_schema.tables
WHERE table_schema = 'mail_archiver'
UNION ALL
SELECT 'public_ef_migrations_history_rows', COUNT(*)::bigint::text
FROM public."__EFMigrationsHistory"
UNION ALL
SELECT 'mail_archiver_archived_emails_rows', COUNT(*)::bigint::text
FROM mail_archiver."ArchivedEmails"
UNION ALL
SELECT 'mail_archiver_mail_accounts_rows', COUNT(*)::bigint::text
FROM mail_archiver."MailAccounts"
UNION ALL
SELECT 'mail_archiver_users_rows', COUNT(*)::bigint::text
FROM mail_archiver."Users";
SQL
awk -F $'\t' '$1 == "mail_archiver_archived_emails_rows" {print $1 "\t" $2}' "$counts_tsv"
printf 'uploads_file_count\t%s\n' "$(find "$drill_dir/uploads" -type f 2>/dev/null | wc -l | tr -d ' ')"
printf 'restore_scope_mode\t%s\n' "hybrid_schema_restore_artifact_scan"
REMOTE
restore_rc=$?
set -e

restore_error=""
if [[ $restore_rc -eq 0 ]]; then
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] || continue
    ACTUAL["$key"]="$value"
  done <"$REMOTE_OUTPUT_FILE"
else
  restore_error="$(tr '\n' ' ' <"$REMOTE_ERROR_FILE" | sed 's/[[:space:]]\+/ /g' | sed 's/^ //; s/ $//')"
fi

all_match=true
if [[ $restore_rc -eq 0 ]]; then
  for key in "${comparison_keys[@]}"; do
    [[ -n "${ACTUAL[$key]:-}" ]] || fail "restore drill missing actual metric: $key"
    if [[ "${EXPECTED[$key]}" != "${ACTUAL[$key]}" ]]; then
      all_match=false
    fi
  done
else
  all_match=false
fi

RESULT="FAIL"
if [[ $restore_rc -eq 0 && "$all_match" == "true" ]]; then
  RESULT="PASS"
fi

{
  echo "kind: communications_mailarchiver_restore_drill"
  echo "version: 1"
  echo "generated_at: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  echo "result: $RESULT"
  echo "target:"
  echo "  ssh_target: $TARGET_ID"
  echo "  ssh_ref: $(yaml_quote "$comm_ssh_ref")"
  echo "offsite_target:"
  echo "  ssh_target: $PVE_TARGET_ID"
  echo "  ssh_ref: $(yaml_quote "$pve_ssh_ref")"
  echo "artifacts:"
  echo "  local_set_dir: $(yaml_quote "$LOCAL_SET_DIR")"
  echo "  local_set_timestamp: $(yaml_quote "$LOCAL_SET_TIMESTAMP")"
  echo "  local_db: $(yaml_quote "$LATEST_LOCAL_DB")"
  echo "  local_uploads: $(yaml_quote "$LATEST_LOCAL_UPLOADS")"
  echo "  local_manifest: $(yaml_quote "$LATEST_LOCAL_MANIFEST")"
  if [[ -n "$LATEST_OFFSITE_DB" ]]; then
    echo "  offsite_db: $(yaml_quote "$LATEST_OFFSITE_DB")"
  else
    echo "  offsite_db: null"
  fi
  if [[ -n "$LATEST_OFFSITE_UPLOADS" ]]; then
    echo "  offsite_uploads: $(yaml_quote "$LATEST_OFFSITE_UPLOADS")"
  else
    echo "  offsite_uploads: null"
  fi
  if [[ -n "$LATEST_OFFSITE_MANIFEST" ]]; then
    echo "  offsite_manifest: $(yaml_quote "$LATEST_OFFSITE_MANIFEST")"
  else
    echo "  offsite_manifest: null"
  fi
  echo "  offsite_match:"
  echo "    db: $offsite_db_present"
  echo "    uploads: $offsite_uploads_present"
  echo "    manifest: $offsite_manifest_present"
  echo "manifest:"
  for key in "${required_manifest_keys[@]}"; do
    echo "  $key: $(yaml_quote "${EXPECTED[$key]}")"
  done
  echo "restore:"
  echo "  mode: scratch_nonprod"
  echo "  scope_mode: $(yaml_quote "${ACTUAL[restore_scope_mode]:-contract_scoped_until_match}")"
  echo "  database: $(yaml_quote "$DRILL_DB")"
  echo "  uploads_extract_dir: $(yaml_quote "$DRILL_DIR")"
  echo "  keep_artifacts: $([[ "$KEEP_ARTIFACTS" -eq 1 ]] && echo true || echo false)"
  echo "comparison:"
  for key in "${comparison_keys[@]}"; do
    echo "  $key:"
    echo "    expected: $(yaml_quote "${EXPECTED[$key]}")"
    echo "    actual: $(yaml_quote "${ACTUAL[$key]:-}")"
    if [[ "${EXPECTED[$key]}" == "${ACTUAL[$key]:-__missing__}" ]]; then
      echo "    match: true"
    else
      echo "    match: false"
    fi
  done
  if [[ -n "$restore_error" ]]; then
    echo "error: $(yaml_quote "$restore_error")"
  else
    echo "error: null"
  fi
} >"$RECEIPT_PATH"

echo "=== Mail-Archiver Restore Drill ==="
echo "target: $TARGET_ID ($comm_ssh_ref)"
echo "receipt: $RECEIPT_PATH"
echo "result: $RESULT"
if [[ -n "$restore_error" ]]; then
  echo "error: $restore_error"
fi
for key in "${comparison_keys[@]}"; do
  echo "  $key expected=${EXPECTED[$key]} actual=${ACTUAL[$key]:-missing}"
done

if [[ "$RESULT" != "PASS" ]]; then
  exit 1
fi
