#!/usr/bin/env bash
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
CONTRACT="${COMMUNICATIONS_STACK_CONTRACT:-$ROOT/ops/bindings/communications.stack.contract.yaml}"
MICROSOFT_EXEC="${COMMUNICATIONS_MICROSOFT_EXEC:-${COMMUNICATIONS_MICROSOFT_EXEC_LEGACY:-$ROOT/ops/plugins/providers/microsoft/bin/microsoft-cap-exec}}"
CAPABILITY_NAME="${COMMUNICATIONS_MAIL_SEARCH_CAPABILITY_NAME:-communications.mail.search}"
QUERY=""
TOP=""
MAILBOX=""
JSON=0
TRIAGE=0

need() { command -v "$1" >/dev/null 2>&1 || { echo "ERROR: missing dependency: $1" >&2; exit 1; }; }
extract_first_json() {
  local raw_file="$1"
  local out_file="$2"
  python3 - "$raw_file" "$out_file" <<'PY'
import json
import re
import sys
from pathlib import Path

raw_path = Path(sys.argv[1])
out_path = Path(sys.argv[2])
text = raw_path.read_text(encoding="utf-8", errors="replace")
text = re.sub(r"\x1b\[[0-9;]*m", "", text)
decoder = json.JSONDecoder()
for idx, ch in enumerate(text):
    if ch != "{":
        continue
    try:
        obj, _ = decoder.raw_decode(text[idx:])
    except json.JSONDecodeError:
        continue
    if isinstance(obj, dict):
        out_path.write_text(json.dumps(obj), encoding="utf-8")
        sys.exit(0)
sys.exit(1)
PY
}

build_triage_json() {
  local json_file="$1"
  COMMUNICATIONS_TRIAGE_LIB_DIR="$ROOT/ops/plugins/domains/communications/lib" python3 - "$json_file" <<'PY'
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, os.environ["COMMUNICATIONS_TRIAGE_LIB_DIR"])

from mail_triage_classifier import classify_message, clean


payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
messages = []
for message in payload.get("value") or []:
    triage_class, recommended_action, classification_basis = classify_message(
        str((((message.get("from") or {}).get("emailAddress") or {}).get("address")) or ""),
        str(message.get("subject") or ""),
        str(message.get("bodyPreview") or ""),
    )
    preview = clean(str(message.get("bodyPreview") or ""))
    if len(preview) > 160:
        preview = preview[:157] + "..."
    messages.append(
        {
            "message_id": str(message.get("id") or ""),
            "received_utc": str(message.get("receivedDateTime") or ""),
            "from": str((((message.get("from") or {}).get("emailAddress") or {}).get("address")) or ""),
            "subject": clean(str(message.get("subject") or "")),
            "read_state": "read" if bool(message.get("isRead")) else "unread",
            "triage_class": triage_class,
            "recommended_action": recommended_action,
            "classification_basis": classification_basis,
            "link_policy": "do_not_open_body_links",
            "preview": preview,
        }
    )
messages.sort(key=lambda item: item.get("received_utc") or "", reverse=True)
print(json.dumps(messages))
PY
}

need yq
need jq
[[ -f "$CONTRACT" ]] || { echo "ERROR: missing contract: $CONTRACT" >&2; exit 1; }
[[ -x "$MICROSOFT_EXEC" ]] || { echo "ERROR: missing Microsoft executor: $MICROSOFT_EXEC" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --query) QUERY="${2:-}"; shift 2 ;;
    --top) TOP="${2:-}"; shift 2 ;;
    --mailbox) MAILBOX="${2:-}"; shift 2 ;;
    --triage) TRIAGE=1; shift ;;
    --json) JSON=1; shift ;;
    -h|--help)
      cat <<'USAGE'
Usage: communications-mail-search [--query <text>] [--top <n>] [--json]
       communications-mail-search [--mailbox <id|address>] [--query <text>] [--top <n>] [--json]
       communications-mail-search --triage [--mailbox <id|address>] [--top <n>] [--json]

Simulation mode: searches contract mailbox catalog.
Live mode: runs Microsoft mailbox search via Microsoft executor.
Triage mode: flattens live mailbox messages into a one-pass operator view.
USAGE
      exit 0
      ;;
    *)
      if [[ -z "$QUERY" ]]; then
        QUERY="$1"
      else
        echo "ERROR: unknown argument: $1" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

mode="$(yq e -r '.pilot.send_test.mode // "simulation-only"' "$CONTRACT")"
stage="$(yq e -r '.pilot.stage // ""' "$CONTRACT")"
backend="$(yq e -r '.pilot.execution_backend // "none"' "$CONTRACT")"
default_top="$(yq e -r '.pilot.microsoft.search_default_top // 10' "$CONTRACT")"
default_mailbox="$(yq e -r '.pilot.microsoft.default_mailbox // ""' "$CONTRACT")"
query_effective="${QUERY:-*}"
top_effective="${TOP:-$default_top}"
mailbox_effective="${MAILBOX:-$default_mailbox}"

if [[ -n "$mailbox_effective" ]]; then
  resolved_mailbox="$(yq e -r ".pilot.mailboxes[] | select(.id == \"$mailbox_effective\" or .address == \"$mailbox_effective\") | .address" "$CONTRACT" | head -n 1)"
  if [[ -n "$resolved_mailbox" && "$resolved_mailbox" != "null" ]]; then
    mailbox_effective="$resolved_mailbox"
  fi
fi

if [[ "$mode" == "simulation-only" ]]; then
  if [[ "$TRIAGE" -eq 1 ]]; then
    if [[ "$JSON" -eq 1 ]]; then
      jq -n \
        --arg capability "$CAPABILITY_NAME" \
        --arg schema_version "1.0" \
        --arg status "ok" \
        --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg mode "$mode" \
        --arg stage "$stage" \
        --arg backend "$backend" \
        --arg query "$query_effective" \
        --arg mailbox "$mailbox_effective" \
        --argjson top "$top_effective" \
        --arg note "triage view requires live Microsoft mailbox mode" \
        '{capability:$capability,schema_version:$schema_version,status:$status,generated_at:$generated_at,data:{mode:$mode,stage:$stage,backend:$backend,query:$query,mailbox:$mailbox,top:$top,note:$note,messages:[]}}'
      exit 0
    fi

    echo "$CAPABILITY_NAME"
    echo "mode: $mode"
    echo "stage: $stage"
    [[ -n "$mailbox_effective" ]] && echo "mailbox: $mailbox_effective"
    echo "query: $query_effective"
    echo "top: $top_effective"
    echo "matches: 0"
    echo "note: triage view requires live Microsoft mailbox mode"
    exit 0
  fi

  rows="$(yq e -r '.pilot.mailboxes[] | [.id, .address, .role, .status] | @tsv' "$CONTRACT")"
  count=0
  matches_json="$(mktemp)"
  trap 'rm -f "$matches_json"' EXIT
  echo "[]" >"$matches_json"
  while IFS=$'\t' read -r id address role status; do
    line="$id $address $role $status"
    if [[ -n "$mailbox_effective" && "$id" != "$mailbox_effective" && "$address" != "$mailbox_effective" ]]; then
      continue
    fi
    if [[ -z "$QUERY" ]] || echo "$line" | grep -qi -- "$QUERY"; then
      count=$((count + 1))
      jq --arg id "$id" --arg address "$address" --arg role "$role" --arg status "$status" \
        '. += [{"id":$id,"address":$address,"role":$role,"status":$status}]' \
        "$matches_json" > "${matches_json}.tmp" && mv "${matches_json}.tmp" "$matches_json"
    fi
  done <<< "$rows"

  if [[ "$JSON" -eq 1 ]]; then
    jq -n \
      --arg capability "$CAPABILITY_NAME" \
      --arg schema_version "1.0" \
      --arg status "ok" \
      --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg mode "$mode" \
      --arg stage "$stage" \
      --arg backend "$backend" \
      --arg query "$QUERY" \
      --arg mailbox "$mailbox_effective" \
      --argjson matches "$(cat "$matches_json")" \
      '{capability:$capability,schema_version:$schema_version,status:$status,generated_at:$generated_at,data:{mode:$mode,stage:$stage,backend:$backend,query:$query,mailbox:$mailbox,matches:($matches|length),messages:$matches}}'
    exit 0
  fi

  echo "$CAPABILITY_NAME"
  echo "mode: $mode"
  echo "stage: $stage"
  [[ -n "$mailbox_effective" ]] && echo "mailbox: $mailbox_effective"
  [[ -n "$QUERY" ]] && echo "query: $QUERY"
  printf "%-12s %-34s %-14s %-10s\n" "id" "address" "role" "status"
  printf "%-12s %-34s %-14s %-10s\n" "------------" "----------------------------------" "--------------" "----------"
  jq -r '.[] | [.id,.address,.role,.status] | @tsv' "$matches_json" | while IFS=$'\t' read -r id address role status; do
    printf "%-12s %-34s %-14s %-10s\n" "$id" "$address" "$role" "$status"
  done
  echo "matches: $count"
  exit 0
fi

# Live pilot path (Microsoft-backed)
result_json_tmp="$(mktemp)"
result_raw_tmp="$(mktemp)"
result_err_tmp="$(mktemp)"
trap 'rm -f "$result_raw_tmp" "$result_json_tmp" "$result_err_tmp"' EXIT
cmd=("$MICROSOFT_EXEC" mail_search --query "$query_effective" --top "$top_effective")
if [[ -n "$mailbox_effective" ]]; then
  cmd+=(--mailbox "$mailbox_effective")
fi
if ! "${cmd[@]}" >"$result_raw_tmp" 2>"$result_err_tmp"; then
  echo "ERROR: microsoft mail search failed" >&2
  cat "$result_err_tmp" >&2 || true
  exit 1
fi

if ! extract_first_json "$result_raw_tmp" "$result_json_tmp"; then
  echo "ERROR: microsoft mail search returned invalid JSON payload" >&2
  cat "$result_raw_tmp" >&2 || true
  exit 1
fi

message_count="$(jq -r '.value | length' "$result_json_tmp" 2>/dev/null || echo 0)"
triage_messages_json=""
if [[ "$TRIAGE" -eq 1 ]]; then
  triage_messages_json="$(build_triage_json "$result_json_tmp")"
  message_count="$(echo "$triage_messages_json" | jq -r 'length')"
fi

if [[ "$JSON" -eq 1 ]]; then
  if [[ "$TRIAGE" -eq 1 ]]; then
    jq -n \
      --arg capability "$CAPABILITY_NAME" \
      --arg schema_version "1.0" \
      --arg status "ok" \
      --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg mode "$mode" \
      --arg stage "$stage" \
      --arg backend "$backend" \
      --arg query "$query_effective" \
      --arg mailbox "$mailbox_effective" \
      --argjson top "$top_effective" \
      --argjson messages "$triage_messages_json" \
      '{capability:$capability,schema_version:$schema_version,status:$status,generated_at:$generated_at,data:{mode:$mode,stage:$stage,backend:$backend,query:$query,mailbox:$mailbox,top:$top,matches:($messages|length),messages:$messages}}'
  else
    jq -n \
      --arg capability "$CAPABILITY_NAME" \
      --arg schema_version "1.0" \
      --arg status "ok" \
      --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg mode "$mode" \
      --arg stage "$stage" \
      --arg backend "$backend" \
      --arg query "$query_effective" \
      --arg mailbox "$mailbox_effective" \
      --argjson top "$top_effective" \
      --argjson microsoft "$(cat "$result_json_tmp")" \
      '{capability:$capability,schema_version:$schema_version,status:$status,generated_at:$generated_at,data:{mode:$mode,stage:$stage,backend:$backend,query:$query,mailbox:$mailbox,top:$top,microsoft:$microsoft}}'
  fi
  exit 0
fi

echo "$CAPABILITY_NAME"
echo "mode: $mode"
echo "stage: $stage"
echo "backend: $backend"
[[ -n "$mailbox_effective" ]] && echo "mailbox: $mailbox_effective"
echo "query: $query_effective"
echo "top: $top_effective"
echo "matches: $message_count"
if [[ "$TRIAGE" -eq 1 ]]; then
  if [[ "$message_count" -gt 0 ]]; then
    echo
    jq -r '.[]? | "message_id: \(.message_id)\nreceived_utc: \(.received_utc)\nfrom: \(.from)\nsubject: \(.subject)\nread_state: \(.read_state)\ntriage_class: \(.triage_class)\nrecommended_action: \(.recommended_action)\nclassification_basis: \(.classification_basis)\nlink_policy: \(.link_policy)\npreview: \(.preview)\n---"' <<<"$triage_messages_json"
  fi
  exit 0
fi

printf "%-26s %-30s %-42s\n" "received_utc" "from" "subject"
printf "%-26s %-30s %-42s\n" "--------------------------" "------------------------------" "------------------------------------------"
jq -r '.value[]? | [(.receivedDateTime // ""), (.from.emailAddress.address // ""), (.subject // "")] | @tsv' "$result_json_tmp" | while IFS=$'\t' read -r received from subject; do
  printf "%-26s %-30s %-42s\n" "$received" "$from" "$subject"
done
