#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[5]
LIB_DIR = ROOT / "ops/plugins/domains/communications/lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from communications_alerts_status_common import collect_queue_status, queue_contract_path  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="communications-alerts-queue-status",
        description="Read-only view of the alerting email intent queue.",
    )
    parser.add_argument("--limit", type=int, default=25, help="Show at most N pending intents (default: 25)")
    parser.add_argument("--json", action="store_true", help="Emit JSON output")
    return parser


def render_text(payload: dict[str, object], limit: int) -> str:
    data = payload.get("data", {})
    if not isinstance(data, dict):
        data = {}
    lines = [
        "communications.alerts.queue.status",
        f"pending_count: {data.get('pending_count', 0)}",
        f"pending_ready_count: {data.get('pending_ready_count', 0)}",
        f"retry_scheduled_count: {data.get('retry_scheduled_count', 0)}",
        f"sent_count: {data.get('sent_count', 0)}",
        f"failed_count: {data.get('failed_count', 0)}",
        f"dead_letter_count: {data.get('dead_letter_count', 0)}",
        f"oldest_pending_age_seconds: {data.get('oldest_pending_age_seconds', 0)}",
        f"newest_pending_age_seconds: {data.get('newest_pending_age_seconds', 0)}",
        "",
    ]
    top_pending = data.get("top_pending", [])
    if isinstance(top_pending, list) and top_pending:
        lines.extend(
            [
                f"Top pending intents (limit: {limit}):",
                f"  {'intent_id':44} {'status':18} {'severity':8} {'attempt':6} {'next_retry_at':20} {'ready':7} recipient",
                f"  {'-' * 44} {'-' * 18} {'-' * 8} {'-' * 6} {'-' * 20} {'-' * 7} {'-' * 9}",
            ]
        )
        for row in top_pending:
            if not isinstance(row, dict):
                continue
            lines.append(
                "  "
                f"{str(row.get('intent_id', '')):44} "
                f"{str(row.get('flush_status', '')):18} "
                f"{str(row.get('severity', '')):8} "
                f"{str(row.get('attempts', 0)):6} "
                f"{str(row.get('next_retry_at', '')):20} "
                f"{str(row.get('ready_now', False)).lower():7} "
                f"{str(row.get('recipient', ''))}"
            )
    else:
        lines.append("No pending intents.")
    return "\n".join(lines)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    payload = collect_queue_status(limit=max(0, args.limit), contract_path=queue_contract_path())
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=False))
        return 0
    print(render_text(payload, max(0, args.limit)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
