#!/usr/bin/env bash
set -euo pipefail

# communications-alerts-queue-status — Read-only queue status for pending
# alerting email intents.
#
# Safety: read-only
# Approval: auto

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
QUEUE_CONTRACT="${COMMUNICATIONS_ALERTS_QUEUE_CONTRACT:-$ROOT/ops/bindings/communications.alerts.queue.contract.yaml}"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths

INTENT_DIR="$SPINE_OUTBOX/alerts/email-intents"
LIMIT=25
JSON=0

usage() {
  cat <<'USAGE'
Usage: communications-alerts-queue-status [--limit <n>] [--json]

Read-only view of the alerting email intent queue.

Output:
  pending_count, pending_ready_count, retry_scheduled_count,
  sent_count, failed_count, dead_letter_count,
  oldest/newest pending age, top pending intents.

Options:
  --limit <n>    Show at most N pending intents (default: 25)
  --json         Emit JSON output
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit) LIMIT="${2:-25}"; shift 2 ;;
    --json) JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

command -v yq >/dev/null 2>&1 || { echo "ERROR: missing dependency: yq" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "ERROR: missing dependency: jq" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "ERROR: missing dependency: python3" >&2; exit 1; }
python3 -c 'import yaml' >/dev/null 2>&1 || { echo "ERROR: missing dependency: python3 yaml" >&2; exit 1; }
[[ "$LIMIT" =~ ^[0-9]+$ ]] || { echo "ERROR: --limit must be numeric" >&2; exit 2; }

retry_enabled="$(yq -r '.retry_policy.enabled // true' "$QUEUE_CONTRACT" 2>/dev/null || echo true)"
dead_letter_dir_raw="$(yq -r '.retry_policy.dead_letter_dir // "$SPINE_OUTBOX/alerts/email-intents-dead-letter"' "$QUEUE_CONTRACT" 2>/dev/null || echo '$SPINE_OUTBOX/alerts/email-intents-dead-letter')"
DEAD_LETTER_DIR="${dead_letter_dir_raw//\$SPINE_OUTBOX/$SPINE_OUTBOX}"

queue_scan_json="$(python3 - "$INTENT_DIR" "$DEAD_LETTER_DIR" "$LIMIT" "$retry_enabled" <<'PY'
from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml


def parse_iso_epoch(raw: object) -> int | None:
    text = str(raw or "").strip()
    if not text:
        return None
    try:
        return int(datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp())
    except Exception:
        return None


intent_dir = Path(sys.argv[1])
dead_letter_dir = Path(sys.argv[2])
limit = int(sys.argv[3])
retry_enabled = sys.argv[4].lower() == "true"
now_epoch = int(datetime.now(timezone.utc).timestamp())

data = {
    "pending_count": 0,
    "pending_ready_count": 0,
    "retry_scheduled_count": 0,
    "sent_count": 0,
    "failed_count": 0,
    "dead_letter_count": 0,
    "oldest_pending_age_seconds": 0,
    "newest_pending_age_seconds": 0,
    "top_pending": [],
}

oldest_pending_epoch: int | None = None
newest_pending_epoch: int | None = None

if intent_dir.is_dir():
    for path in sorted(intent_dir.rglob("*.yaml")):
        try:
            payload = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        except Exception:
            payload = {}

        flush_status = str(payload.get("flush_status") or "pending")
        created_at = str(payload.get("created_at") or "")
        next_retry_at = str(payload.get("next_retry_at") or "")
        last_error = str(payload.get("last_error") or "")
        intent_id = str(payload.get("intent_id") or "")
        domain_id = str(payload.get("domain_id") or "")
        severity = str(payload.get("severity") or "")
        recipient = str(payload.get("suggested_recipient") or "")

        attempts_raw = payload.get("attempts", 0)
        try:
            attempts = int(attempts_raw)
        except Exception:
            attempts = 0

        ready_now = True

        if flush_status == "sent":
            data["sent_count"] += 1
            continue

        if flush_status == "dead-letter":
            data["dead_letter_count"] += 1
            continue

        if flush_status == "retry_scheduled":
            data["retry_scheduled_count"] += 1
            if retry_enabled:
                if next_retry_at:
                    next_retry_epoch = parse_iso_epoch(next_retry_at)
                    ready_now = next_retry_epoch is None or next_retry_epoch <= now_epoch
                else:
                    ready_now = True
            else:
                ready_now = True
        elif flush_status == "failed":
            data["failed_count"] += 1

        data["pending_count"] += 1
        if ready_now:
            data["pending_ready_count"] += 1

        created_epoch = parse_iso_epoch(created_at)
        if created_epoch is not None:
            if oldest_pending_epoch is None or created_epoch < oldest_pending_epoch:
                oldest_pending_epoch = created_epoch
            if newest_pending_epoch is None or created_epoch > newest_pending_epoch:
                newest_pending_epoch = created_epoch

        if len(data["top_pending"]) < limit:
            data["top_pending"].append(
                {
                    "intent_id": intent_id,
                    "domain_id": domain_id,
                    "severity": severity,
                    "created_at": created_at,
                    "recipient": recipient,
                    "flush_status": flush_status,
                    "attempts": attempts,
                    "next_retry_at": next_retry_at,
                    "ready_now": ready_now,
                    "last_error": last_error,
                }
            )

if dead_letter_dir.is_dir():
    data["dead_letter_count"] += sum(1 for _ in dead_letter_dir.rglob("*.yaml"))

if oldest_pending_epoch is not None:
    data["oldest_pending_age_seconds"] = max(0, now_epoch - oldest_pending_epoch)
if newest_pending_epoch is not None:
    data["newest_pending_age_seconds"] = max(0, now_epoch - newest_pending_epoch)

print(json.dumps(data, separators=(",", ":")))
PY
)"

pending_count="$(jq -r '.pending_count' <<<"$queue_scan_json")"
pending_ready_count="$(jq -r '.pending_ready_count' <<<"$queue_scan_json")"
retry_scheduled_count="$(jq -r '.retry_scheduled_count' <<<"$queue_scan_json")"
sent_count="$(jq -r '.sent_count' <<<"$queue_scan_json")"
failed_count="$(jq -r '.failed_count' <<<"$queue_scan_json")"
dead_letter_count="$(jq -r '.dead_letter_count' <<<"$queue_scan_json")"
oldest_pending_age="$(jq -r '.oldest_pending_age_seconds' <<<"$queue_scan_json")"
newest_pending_age="$(jq -r '.newest_pending_age_seconds' <<<"$queue_scan_json")"
pending_intents_json="$(jq -c '.top_pending' <<<"$queue_scan_json")"

if [[ "$JSON" -eq 1 ]]; then
  jq -n \
    --arg capability "communications.alerts.queue.status" \
    --arg status "ok" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson pending_count "$pending_count" \
    --argjson pending_ready_count "$pending_ready_count" \
    --argjson retry_scheduled_count "$retry_scheduled_count" \
    --argjson sent_count "$sent_count" \
    --argjson failed_count "$failed_count" \
    --argjson dead_letter_count "$dead_letter_count" \
    --argjson oldest_pending_age_seconds "$oldest_pending_age" \
    --argjson newest_pending_age_seconds "$newest_pending_age" \
    --argjson top_pending "$pending_intents_json" \
    '{
      capability: $capability,
      status: $status,
      generated_at: $generated_at,
      data: {
        pending_count: $pending_count,
        pending_ready_count: $pending_ready_count,
        retry_scheduled_count: $retry_scheduled_count,
        sent_count: $sent_count,
        failed_count: $failed_count,
        dead_letter_count: $dead_letter_count,
        oldest_pending_age_seconds: $oldest_pending_age_seconds,
        newest_pending_age_seconds: $newest_pending_age_seconds,
        top_pending: $top_pending
      }
    }'
  exit 0
fi

echo "communications.alerts.queue.status"
echo "pending_count: $pending_count"
echo "pending_ready_count: $pending_ready_count"
echo "retry_scheduled_count: $retry_scheduled_count"
echo "sent_count: $sent_count"
echo "failed_count: $failed_count"
echo "dead_letter_count: $dead_letter_count"
echo "oldest_pending_age_seconds: $oldest_pending_age"
echo "newest_pending_age_seconds: $newest_pending_age"
echo ""
if [[ "$pending_count" -gt 0 ]]; then
  echo "Top pending intents (limit: $LIMIT):"
  printf "  %-44s %-18s %-8s %-6s %-20s %-7s %s\n" "intent_id" "status" "severity" "attempt" "next_retry_at" "ready" "recipient"
  printf "  %-44s %-18s %-8s %-6s %-20s %-7s %s\n" "--------------------------------------------" "------------------" "--------" "------" "--------------------" "-------" "---------"
  echo "$pending_intents_json" | jq -r '.[] | [.intent_id, .flush_status, .severity, (.attempts|tostring), .next_retry_at, (.ready_now|tostring), .recipient] | @tsv' | \
  while IFS=$'\t' read -r id status sev attempt next_retry ready recip; do
    printf "  %-44s %-18s %-8s %-6s %-20s %-7s %s\n" "$id" "$status" "$sev" "$attempt" "$next_retry" "$ready" "$recip"
  done
else
  echo "No pending intents."
fi
