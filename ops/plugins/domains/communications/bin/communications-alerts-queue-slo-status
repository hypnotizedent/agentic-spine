#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[5]
LIB_DIR = ROOT / "ops/plugins/domains/communications/lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from communications_alerts_status_common import collect_queue_slo_status, queue_contract_path  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="communications-alerts-queue-slo-status",
        description="Evaluate the alerting email intent queue against SLO thresholds.",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON output")
    return parser


def render_text(payload: dict[str, object]) -> str:
    data = payload.get("data", {})
    if not isinstance(data, dict):
        data = {}
    thresholds = data.get("thresholds", {})
    if not isinstance(thresholds, dict):
        thresholds = {}
    dispatcher = data.get("dispatcher", {})
    if not isinstance(dispatcher, dict):
        dispatcher = {}
    reasons = data.get("reasons", [])
    if not isinstance(reasons, list):
        reasons = []
    lines = [
        "communications.alerts.queue.slo.status",
        f"status: {payload.get('status', 'unknown')}",
        f"pending_count: {data.get('pending_count', 0)}",
        f"pending_ready_count: {data.get('pending_ready_count', 0)}",
        f"dead_letter_count: {data.get('dead_letter_count', 0)}",
        f"oldest_pending_age_seconds: {data.get('oldest_pending_age_seconds', 0)}",
        "thresholds:",
        f"  warn_age_seconds: {thresholds.get('warn_age_seconds', 0)}",
        f"  incident_age_seconds: {thresholds.get('incident_age_seconds', 0)}",
        f"  max_pending_warn: {thresholds.get('max_pending_warn', 0)}",
        f"  max_pending_incident: {thresholds.get('max_pending_incident', 0)}",
        f"  dead_letter_warn: {thresholds.get('dead_letter_warn', 0)}",
        f"  dead_letter_incident: {thresholds.get('dead_letter_incident', 0)}",
        f"dispatcher_enabled: {str(dispatcher.get('enabled', False)).lower()}",
        f"dispatcher_running: {str(dispatcher.get('running', False)).lower()}",
    ]
    if reasons:
        lines.append("reasons:")
        lines.extend(f"  - {reason}" for reason in reasons)
    recommended_action = str(data.get("recommended_action", ""))
    if recommended_action:
        lines.append(f"recommended_action: {recommended_action}")
    if bool(data.get("escalation_recommended", False)):
        lines.append("escalation_recommended: true")
        lines.append(f"escalation_reason: {data.get('escalation_reason', '')}")
        lines.append(f"escalation_fingerprint: {data.get('escalation_fingerprint', '')}")
        lines.append(f"suggested_command: {data.get('suggested_command', '')}")
    return "\n".join(lines)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    payload = collect_queue_slo_status(contract_path=queue_contract_path())
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=False))
        return 0
    print(render_text(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
