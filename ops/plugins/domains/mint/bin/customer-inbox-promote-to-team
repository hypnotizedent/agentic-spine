#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from customer_identity_common import normalize_space, resolve_message_customer_contact  # noqa: E402
from customer_inbox_machine_common import load_machine_contract, render_promote_comment  # noqa: E402
from operator_mail_common import (  # noqa: E402
    append_ndjson,
    compact_utc,
    iso_utc,
    message_sender,
    message_subject,
    resolve_spine_root,
    resolve_spine_state,
    run_cap_capture,
    utc_now,
    write_json,
)


CAPABILITY_NAME = "mint.customer.inbox.promote_to_team"
MAIL_GET_CAPABILITY = "microsoft.mail.get"
MAIL_MOVE_CAPABILITY = "microsoft.mail.move"
MAIL_FOLDER_ENSURE_CAPABILITY = "microsoft.mail.folder.ensure"
MAIL_SEARCH_CAPABILITY = "communications.mail.search"
SCHEMA_VERSION = "1.0"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="customer-inbox-promote-to-team",
        description="Forward a ronny@/info@ customer email into the canonical team@ lane and park the source copy.",
    )
    parser.add_argument("--message-id", required=True, help="Source mailbox message id")
    parser.add_argument("--source-mailbox", default="ronny@mintprints.com", help="Source mailbox (default: ronny@mintprints.com)")
    parser.add_argument("--target-mailbox", default="", help="Target team mailbox override")
    parser.add_argument("--park-folder", default="", help="Override source mailbox park folder")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    return parser.parse_args(argv)


def unwrap_message(payload: dict[str, Any]) -> dict[str, Any]:
    data = payload.get("data")
    if isinstance(data, dict) and data.get("id"):
        return data
    return payload


def unwrap_search_results(payload: dict[str, Any]) -> list[dict[str, Any]]:
    microsoft = dict(((payload.get("data") or {}).get("microsoft")) or {})
    if microsoft:
        return list(microsoft.get("value") or [])
    if isinstance(payload.get("value"), list):
        return list(payload.get("value") or [])
    return []


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    now = utc_now()
    spine_root = resolve_spine_root()
    state_root = resolve_spine_state(spine_root)
    contract = load_machine_contract(spine_root)

    raise SystemExit(
        "agent mailbox promote-to-team relay is disabled by policy; drafts only until Outlook/mail governance is stable"
    )

    source_mailbox = normalize_space(args.source_mailbox).lower()
    target_mailbox = normalize_space(args.target_mailbox or contract.get("canonical_mailbox") or "").lower()
    if source_mailbox not in set(contract.get("promote_allowed_source_mailboxes") or []):
        raise SystemExit(f"source mailbox not allowed for promote-to-team: {source_mailbox}")
    if not target_mailbox:
        raise SystemExit("missing canonical target mailbox")

    source_payload, source_receipt = run_cap_capture(
        spine_root,
        MAIL_GET_CAPABILITY,
        ["--message-id", args.message_id, "--mailbox", source_mailbox],
    )
    source_message = unwrap_message(source_payload)
    customer_contact = resolve_message_customer_contact(source_message)
    promote_id = f"MIP-{compact_utc(now)}-{os.urandom(2).hex()}"
    comment = render_promote_comment(
        contract=contract,
        promote_id=promote_id,
        source_mailbox=source_mailbox,
        target_mailbox=target_mailbox,
        source_message=source_message,
        source_customer_email=normalize_space(customer_contact.get("email") or ""),
    )

    forward_payload, forward_receipt = run_cap_capture(
        spine_root,
        MAIL_FORWARD_CAPABILITY,
        [
            "--message-id",
            args.message_id,
            "--mailbox",
            source_mailbox,
            "--to",
            target_mailbox,
            "--comment",
            comment,
        ],
    )
    park_folder = normalize_space(args.park_folder or contract.get("promote_source_park_folder") or "Promoted to Team")
    folder_payload, folder_receipt = run_cap_capture(
        spine_root,
        MAIL_FOLDER_ENSURE_CAPABILITY,
        ["--mailbox", source_mailbox, "--display-name", park_folder],
    )
    moved_payload, move_receipt = run_cap_capture(
        spine_root,
        MAIL_MOVE_CAPABILITY,
        ["--message-id", args.message_id, "--mailbox", source_mailbox, "--destination-folder", park_folder],
    )

    team_hits: list[dict[str, Any]] = []
    search_receipt = ""
    try:
        search_payload, search_receipt = run_cap_capture(
            spine_root,
            MAIL_SEARCH_CAPABILITY,
            ["--mailbox", target_mailbox, "--query", promote_id, "--top", "5", "--json"],
        )
        team_hits = unwrap_search_results(search_payload)
    except SystemExit:
        team_hits = []
        search_receipt = ""

    promoted_message = dict(team_hits[0]) if team_hits else {}
    promotion_id = f"MIPR-{compact_utc(now)}-{os.urandom(2).hex()}"
    record = {
        "capability": CAPABILITY_NAME,
        "schema_version": SCHEMA_VERSION,
        "promotion_record_id": promotion_id,
        "promote_id": promote_id,
        "stored_at_utc": iso_utc(now),
        "source_mailbox": source_mailbox,
        "target_mailbox": target_mailbox,
        "park_folder": park_folder,
        "source_message": {
            "message_id": normalize_space(source_message.get("id") or args.message_id),
            "subject": normalize_space(message_subject(source_message)),
            "from": normalize_space(message_sender(source_message)),
            "received_at": normalize_space(source_message.get("receivedDateTime") or ""),
            "customer_email": normalize_space(customer_contact.get("email") or "").lower(),
            "customer_mode": normalize_space(customer_contact.get("mode") or ""),
        },
        "target_message": {
            "message_id": normalize_space(promoted_message.get("id") or ""),
            "subject": normalize_space(promoted_message.get("subject") or ""),
            "received_at": normalize_space(promoted_message.get("receivedDateTime") or ""),
        },
        "provider_receipts": {
            "source_get_receipt": source_receipt or None,
            "forward_receipt": forward_receipt or None,
            "folder_ensure_receipt": folder_receipt or None,
            "move_receipt": move_receipt or None,
            "target_search_receipt": search_receipt or None,
        },
        "provider_results": {
            "forward": forward_payload,
            "folder": folder_payload,
            "move": moved_payload,
        },
    }
    records_dir = state_root / "mint" / "customer-inbox-promotions" / "records" / now.strftime("%Y") / now.strftime("%m") / now.strftime("%d")
    record_file = records_dir / f"{promotion_id}.json"
    index_file = state_root / "mint" / "customer-inbox-promotions" / "index.ndjson"
    lock_file = state_root / "locks" / "mint-customer-inbox-promotions.lock"
    write_json(record_file, record)
    append_ndjson(
        index_file,
        lock_file,
        {
            "stored_at_utc": iso_utc(now),
            "promotion_record_id": promotion_id,
            "promote_id": promote_id,
            "source_mailbox": source_mailbox,
            "source_message_id": record["source_message"]["message_id"],
            "target_message_id": record["target_message"]["message_id"],
            "record_file": str(record_file),
        },
    )
    record["record_file"] = str(record_file)
    record["index_file"] = str(index_file)

    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
        return 0
    print(CAPABILITY_NAME)
    print(f"promote_id: {promote_id}")
    print(f"source_mailbox: {source_mailbox}")
    print(f"target_mailbox: {target_mailbox}")
    print(f"source_message_id: {record['source_message']['message_id']}")
    print(f"target_message_id: {record['target_message']['message_id']}")
    print(f"park_folder: {park_folder}")
    print(f"record_file: {record_file}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
