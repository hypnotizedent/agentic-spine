def capability_name() -> str:
    return os.environ.get("MINT_CUSTOMER_REORDER_RESOLVE_CAPABILITY_NAME") or CAPABILITY_FALLBACK


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="customer-reorder-resolve",
        description=(
            "Resolve an existing-customer reorder email into customer memory, a matched historical job, "
            "a structured delta, a governed draft work object, and a reply draft."
        ),
    )
    parser.add_argument("message_id", nargs="?", help="Mailbox message id for the inbound reorder email or forwarded wrapper")
    parser.add_argument("--message-id", dest="message_id_flag", default="", help="Mailbox message id for the inbound reorder email or forwarded wrapper")
    parser.add_argument("--mailbox", default=DEFAULT_MAILBOX, help=f"Mailbox to read from (default: {DEFAULT_MAILBOX})")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    args = parser.parse_args(argv)
    resolved_message_id = args.message_id_flag.strip() or str(args.message_id or "").strip()
    if not resolved_message_id:
        fail("message_id required")
    args.message_id = resolved_message_id
    return args


def normalize_loose(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (text or "").lower()).strip()


def normalize_compact(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", (text or "").lower())


def parse_bool(value: str) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "y"}


def parse_date(value: str) -> datetime | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    for fmt in ("%Y-%m-%d", "%Y-%m-%d %H:%M:%S %z", "%Y-%m-%d %H:%M:%S"):
        try:
            parsed = datetime.strptime(raw, fmt)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            return parsed.astimezone(timezone.utc)
        except ValueError:
            continue
    return None


def latest_glob_path(pattern: str) -> Path | None:
    expanded = pattern.replace("$HOME", str(Path.home()))
    home = Path.home()
    base = home
    static_parts: list[str] = []
    for part in Path(expanded).parts:
        if any(ch in part for ch in "*?[]"):
            break
        static_parts.append(part)
    if static_parts:
        base = Path(*static_parts)
    matches = sorted(
        (path for path in base.glob(str(Path(expanded).relative_to(base))) if path.is_file()),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    return matches[0] if matches else None


def resolve_customers_export() -> Path:
    override = os.environ.get("MINT_CUSTOMER_REORDER_CUSTOMERS_EXPORT", "").strip()
    if override:
        path = Path(override).expanduser().resolve()
        if not path.is_file():
            fail(f"customer export not found: {path}")
        return path
    path = latest_glob_path("$HOME/ronny-ops/mint-os/data/imports/**/*ExportsCustomersJob_export*.csv")
    if path is None:
        fail("could not find a Printavo customers export under ~/ronny-ops/mint-os/data/imports")
    return path


