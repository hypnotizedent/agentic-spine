#!/usr/bin/env python3
"""mint.suppliers.witness — canonical-routed yaml writer (PACKET-1398).

Thin Mint domain adapter. Reads a pre-built witness yaml from sys.stdin
(or --from-file PATH on the writer host) and writes it verbatim to
$SPINE_STATE/domain-state/mint/suppliers/per-poll/<iso>.yaml. NO row
parsing, NO Mint format knowledge, NO yaml-content interpretation
beyond the minimal schema-version sanity check that prevents writing
arbitrary garbage as a witness artifact.

The Mint format and witness yaml shape live in mint-modules
(scripts/ops/suppliers-witness.py) per PACKET-1398 — the operator's
"keep mint product/parsing logic OUT of spine core" directive after
PACKET-1395 landed the proof-of-pattern with too much body in spine.

Cap binding: mutating, state_authority: read_write_canonical, plane:
fabric, domain: mint. cap.sh routes the writer execution to the
canonical state owner (storage_evidence_node = pve) regardless of
calling host; the producer-host orchestrator (mint.suppliers.poll)
pipes the yaml in from where mint-modules lives.

--read-only mode emits the latest artifact as JSON for status.sh
consumption (read by mint.suppliers.attention.line, which renders
the operator-facing line).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

import yaml


CAPABILITY = "mint.suppliers.witness"
SCHEMA_VERSION = 1
ARTIFACT_REL = "domain-state/mint/suppliers/per-poll"
DEFAULT_FRESHNESS_TTL_SECONDS = 6 * 3600  # 6 hours


def resolve_state_root(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("SPINE_STATE")
    if env:
        return Path(env)
    raise SystemExit(f"{CAPABILITY} FAIL: SPINE_STATE not set and --state-root not supplied")


def latest_artifact(state_root: Path) -> Path | None:
    target_dir = state_root / ARTIFACT_REL
    if not target_dir.is_dir():
        return None
    paths = sorted(target_dir.glob("*.yaml"))
    return paths[-1] if paths else None


def freshness_state(path: Path | None, ttl_seconds: int) -> tuple[str, int | None]:
    if path is None:
        return "missing", None
    try:
        mtime = path.stat().st_mtime
    except Exception:
        return "missing", None
    age = int(datetime.now(UTC).timestamp() - mtime)
    return ("fresh" if age <= ttl_seconds else "stale", age)


def emit_status(state_root: Path, ttl_seconds: int) -> dict[str, Any]:
    latest = latest_artifact(state_root)
    state, age = freshness_state(latest, ttl_seconds)
    payload: dict[str, Any] = {
        "capability": CAPABILITY,
        "freshness": {
            "state": state,
            "age_seconds": age,
            "ttl_seconds": ttl_seconds,
        },
        "artifact_path": str(latest) if latest else None,
    }
    if latest is not None:
        try:
            doc = yaml.safe_load(latest.read_text(encoding="utf-8")) or {}
        except Exception as exc:
            payload["read_error"] = str(exc)[:200]
            return payload
        if isinstance(doc, dict):
            payload["written_at_utc"] = doc.get("written_at_utc")
            payload["attention"] = doc.get("attention") or {}
    return payload


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=CAPABILITY)
    parser.add_argument("--read-only", action="store_true",
                        help="Skip stdin write; emit latest artifact's status JSON.")
    parser.add_argument("--state-root", default=None)
    parser.add_argument("--freshness-ttl-seconds", type=int,
                        default=DEFAULT_FRESHNESS_TTL_SECONDS)
    parser.add_argument("--from-file", default=None,
                        help="Read witness yaml from FILE on the writer host instead of stdin.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-check", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    if args.self_check:
        try:
            import yaml as _yaml  # noqa: F401
        except Exception as exc:  # pragma: no cover
            print(f"{CAPABILITY} self-check FAIL: pyyaml import: {exc}",
                  file=sys.stderr)
            return 1
        print(f"{CAPABILITY} self-check PASS")
        return 0

    state_root = resolve_state_root(args.state_root)
    ttl = max(60, args.freshness_ttl_seconds)

    if args.read_only:
        outcome = emit_status(state_root, ttl)
        if args.json:
            print(json.dumps(outcome, indent=2, sort_keys=True))
        else:
            attn = outcome.get("attention") or {}
            print(f"{CAPABILITY}: {outcome['freshness']['state']} "
                  f"(age={outcome['freshness']['age_seconds']}s); "
                  f"any_fail={attn.get('any_fail')} "
                  f"fail_count={attn.get('fail_count')}/{attn.get('total_checks')}")
        return 0

    # Default mode: read pre-built yaml, sanity-check shape, write
    # verbatim to canonical artifact path. NO Mint format parsing.
    if args.from_file:
        try:
            yaml_text = Path(args.from_file).read_text(encoding="utf-8")
        except Exception as exc:
            print(f"{CAPABILITY} FAIL: cannot read --from-file {args.from_file}: {exc}",
                  file=sys.stderr)
            return 1
    else:
        yaml_text = sys.stdin.read()
    if not yaml_text.strip():
        print(f"{CAPABILITY} FAIL: empty yaml on stdin — pipe a witness "
              "yaml in (see mint.suppliers.poll for the producer-host "
              "orchestrator that builds it via mint-modules).",
              file=sys.stderr)
        return 1
    try:
        doc = yaml.safe_load(yaml_text)
    except Exception as exc:
        print(f"{CAPABILITY} FAIL: yaml parse: {exc}", file=sys.stderr)
        return 1
    if not isinstance(doc, dict) or doc.get("schema_version") != SCHEMA_VERSION:
        print(f"{CAPABILITY} FAIL: yaml shape — expected dict with "
              f"schema_version={SCHEMA_VERSION}", file=sys.stderr)
        return 1

    target_dir = state_root / ARTIFACT_REL
    target_dir.mkdir(parents=True, exist_ok=True)
    target_path = target_dir / f"{datetime.now(UTC).strftime('%Y%m%dT%H%M%SZ')}.yaml"
    target_path.write_text(yaml_text, encoding="utf-8")

    outcome = emit_status(state_root, ttl)
    outcome["just_polled"] = True
    outcome["artifact_path"] = str(target_path)
    if args.json:
        print(json.dumps(outcome, indent=2, sort_keys=True))
    else:
        attn = outcome.get("attention") or {}
        print(f"{CAPABILITY}: wrote {target_path}; "
              f"any_fail={attn.get('any_fail')} "
              f"fail_count={attn.get('fail_count')}/{attn.get('total_checks')}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
