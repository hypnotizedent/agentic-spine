#!/usr/bin/env bash
# intake-validate — thin shim.
#
# Implementation lives in mint-modules. This shim execs the Mint-owned
# counterpart, preserving args, cwd, and environment.

set -euo pipefail

_resolve_mint_modules_root() {
  if [[ -n "${MINT_MODULES_ROOT:-}" ]]; then
    echo "$MINT_MODULES_ROOT"
    return
  fi
  local spine_root
  spine_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../../" && pwd)"
  if [[ -n "${WORKSPACE_ROOT:-}" ]] && [[ -d "$WORKSPACE_ROOT/mint-modules" ]]; then
    echo "$WORKSPACE_ROOT/mint-modules"
    return
  fi
  if [[ -d "$spine_root/../mint-modules" ]]; then
    echo "$(cd "$spine_root/../mint-modules" && pwd)"
    return
  fi
  echo "$HOME/code/mint-modules"
}

MINT_ROOT="$(_resolve_mint_modules_root)"
exec bash "$MINT_ROOT/scripts/ops/intake-validate.sh" "$@"
