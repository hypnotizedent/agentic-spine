#!/usr/bin/env python3
"""
mint.intake.attachment.download — thin shim.

Implementation lives in mint-modules. This shim execs the Mint-owned
counterpart, preserving args, cwd, and environment.
"""
import os
import sys
from pathlib import Path

SPINE_ROOT = Path(__file__).resolve().parents[5]

def _mint_modules_root() -> Path:
    explicit = os.environ.get("MINT_MODULES_ROOT")
    if explicit:
        return Path(explicit).expanduser().resolve()
    workspace = os.environ.get("WORKSPACE_ROOT")
    if workspace:
        candidate = Path(workspace) / "mint-modules"
        if candidate.is_dir():
            return candidate.resolve()
    candidate = SPINE_ROOT.parent / "mint-modules"
    if candidate.is_dir():
        return candidate.resolve()
    return (Path.home() / "code" / "mint-modules").resolve()

target = _mint_modules_root() / "scripts" / "ops" / "intake-attachment-download.py"
os.execvp(sys.executable, [sys.executable, str(target)] + sys.argv[1:])
