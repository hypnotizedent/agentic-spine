#!/usr/bin/env bash
# mint-auth-deploy - Durable auth/files-api deployment with Infisical-backed secrets
#
# This script provides the canonical governed path for deploying auth and files-api
# services on mint-apps with secrets sourced from Infisical.
#
# Process:
# 1. Sync auth secrets from Infisical to /opt/stacks/mint-apps/.env.auth-secrets
# 2. Deploy services using layered env files (.env + .env.auth-secrets)
# 3. Verify health
#
# Usage:
#   mint-auth-deploy [--services auth,files-api] [--skip-sync] [--skip-health-check]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$HOME/code/agentic-spine}"
SSH_BINDING="${SPINE_ROOT}/ops/bindings/ssh.targets.yaml"
SERVICES="auth,files-api"
SKIP_SYNC=0
SKIP_HEALTH=0

# shellcheck source=/dev/null
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --services)
      SERVICES="${2:-auth,files-api}"
      shift 2
      ;;
    --skip-sync)
      SKIP_SYNC=1
      shift
      ;;
    --skip-health-check)
      SKIP_HEALTH=1
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Usage: mint-auth-deploy [--services auth,files-api] [--skip-sync] [--skip-health-check]" >&2
      exit 1
      ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "missing dependency: jq" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { echo "missing dependency: ssh" >&2; exit 2; }
command -v yq >/dev/null 2>&1 || { echo "missing dependency: yq" >&2; exit 2; }
[[ -f "$SSH_BINDING" ]] || { echo "missing binding: $SSH_BINDING" >&2; exit 2; }

# Convert CSV to array
IFS=',' read -ra SERVICE_ARRAY <<< "$SERVICES"

MINT_APPS_USER="$(ssh_resolve_user "mint-apps" "ubuntu")"
MINT_APPS_PORT="$(yq -r '.ssh.targets[] | select(.id == "mint-apps") | .port // 22' "$SSH_BINDING" | head -n1)"
IFS=' ' read -r MINT_APPS_HOST MINT_APPS_PATH <<< "$(ssh_resolve_ssh_host_with_fallback "mint-apps" 3 || true)"
[[ -n "$MINT_APPS_HOST" && "$MINT_APPS_PATH" != "unreachable" ]] || { echo "mint-apps unreachable for deploy" >&2; exit 2; }
SSH_OPTS=(-o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR)

echo "mint.auth.deploy"
echo "services: ${SERVICES}"
echo "target: ${MINT_APPS_USER}@${MINT_APPS_HOST} (${MINT_APPS_PATH})"
echo ""

# Step 1: Sync auth secrets from Infisical (unless skipped)
if [[ "$SKIP_SYNC" -eq 0 ]]; then
  echo "[1/3] Syncing auth secrets from Infisical..."
  "$SPINE_ROOT/ops/plugins/domains/mint/bin/mint-auth-secrets-sync"
  echo ""
else
  echo "[1/3] Skipping auth secrets sync (--skip-sync)"
  echo ""
fi

# Step 2: Deploy services with layered env files
echo "[2/3] Deploying services..."
for service in "${SERVICE_ARRAY[@]}"; do
  echo "  Deploying: $service"
  ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "cd /opt/stacks/mint-apps && \
    docker compose --env-file .env --env-file .env.auth-secrets up -d --no-deps $service"
done
echo ""

# Step 3: Health checks (unless skipped)
if [[ "$SKIP_HEALTH" -eq 0 ]]; then
  echo "[3/3] Checking service health..."

  for service in "${SERVICE_ARRAY[@]}"; do
    case "$service" in
      auth)
        echo "  auth: Waiting for startup..."
        sleep 3
        HEALTH=$(ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "curl -sf http://localhost:4300/health" || echo '{"status":"error"}')
        STATUS=$(echo "$HEALTH" | jq -r '.status // "error"')
        if [[ "$STATUS" == "ok" ]]; then
          echo "  auth: ✅ HEALTHY"
        else
          echo "  auth: ❌ UNHEALTHY - $HEALTH"
          exit 1
        fi
        ;;
      files-api)
        echo "  files-api: Waiting for startup..."
        sleep 3
        HEALTH=$(ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "curl -sf http://localhost:3500/health" || echo '{"status":"error"}')
        STATUS=$(echo "$HEALTH" | jq -r '.status // "error"')
        if [[ "$STATUS" == "ok" ]]; then
          echo "  files-api: ✅ HEALTHY"
        else
          echo "  files-api: ❌ UNHEALTHY - $HEALTH"
          exit 1
        fi
        ;;
    esac
  done
else
  echo "[3/3] Skipping health checks (--skip-health-check)"
fi

echo ""
echo "✅ Deployment complete"
echo "   Services: ${SERVICES}"
echo "   Secret source: Infisical (infrastructure/prod /spine/services/auth)"
echo "   Env files: .env + .env.auth-secrets (layered)"
