#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import json
import os
import sys
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from payment_record_common import (  # noqa: E402
    latest_capture_for_order,
    load_index,
    load_order,
    normalize_payment_summary,
    resolve_spine_root,
    runtime_paths,
)
from quote_packet_normalize import fail  # noqa: E402


CAPABILITY_NAME = "mint.payment.record.snapshot"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="payment-record-snapshot",
        description="Read governed Mint payment visibility from canonical order truth and payment capture records.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--order-id", help="Canonical Mint order_id")
    group.add_argument("--quote-id", help="Canonical Mint quote_id")
    group.add_argument("--customer-id", help="Canonical Mint customer record id")
    group.add_argument("--email", help="Customer email address")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    return parser.parse_args(argv)


def capability_name() -> str:
    return os.environ.get("MINT_PAYMENT_RECORD_CAPABILITY_NAME") or CAPABILITY_NAME


def query_mode(args: argparse.Namespace) -> tuple[str, str]:
    if args.order_id:
        return "order_id", str(args.order_id).strip()
    if args.quote_id:
        return "quote_id", str(args.quote_id).strip()
    if args.customer_id:
        return "customer_id", str(args.customer_id).strip()
    return "email", str(args.email or "").strip().lower()


def collect_order_ids(paths: dict[str, Path], mode: str, value: str) -> list[str]:
    if not value:
        return []
    if mode == "order_id":
        return [value]
    if mode == "quote_id":
        try:
            from payment_record_common import load_quote  # noqa: PLC0415

            _quote_file, quote = load_quote(paths, value)
            order_id = str(quote.get("order_id") or "").strip()
            return [order_id] if order_id else []
        except (FileNotFoundError, ValueError):
            return []

    entries = load_index(paths["orders_index_file"], "orders")
    matched: list[str] = []
    for entry in entries:
        if mode == "customer_id" and str(entry.get("customer_id") or "").strip() == value:
            matched.append(str(entry.get("order_id") or "").strip())
        elif mode == "email" and str(entry.get("customer_email") or "").strip().lower() == value:
            matched.append(str(entry.get("order_id") or "").strip())
        elif mode == "quote_id" and str(entry.get("active_quote_id") or "").strip() == value:
            matched.append(str(entry.get("order_id") or "").strip())

    if matched:
        return [item for item in matched if item]

    for path in sorted(paths["orders_dir"].glob("order_*.yaml")):
        try:
            _file, order = load_order(paths, path.stem.removeprefix("order_"))
        except (FileNotFoundError, ValueError):
            continue
        if mode == "customer_id" and str(order.get("customer_id") or "").strip() == value:
            matched.append(str(order.get("order_id") or "").strip())
        elif mode == "email" and str(order.get("customer_email") or "").strip().lower() == value:
            matched.append(str(order.get("order_id") or "").strip())
    return [item for item in matched if item]


def capture_matches(record: dict[str, Any], mode: str, value: str) -> bool:
    if mode == "order_id":
        return str(record.get("order_id") or "").strip() == value
    if mode == "quote_id":
        return str(record.get("quote_id") or "").strip() == value
    if mode == "customer_id":
        return str(record.get("customer_id") or "").strip() == value
    return str(record.get("customer_email") or "").strip().lower() == value


def item_timestamp(item: dict[str, Any]) -> str:
    latest_capture = item.get("latest_payment_capture") or {}
    summary = (item.get("payment_summary") or {}) if isinstance(item.get("payment_summary"), dict) else {}
    return str(
        item.get("updated_at")
        or latest_capture.get("recorded_at")
        or summary.get("recorded_at")
        or latest_capture.get("captured_at")
        or summary.get("captured_at")
        or ""
    )


def build_match(order: dict[str, Any], latest_capture: dict[str, Any] | None) -> dict[str, Any]:
    summary = normalize_payment_summary(order)
    visibility_state = str(summary.get("visibility_state") or "not_yet_visible")
    effective_summary = copy.deepcopy(summary)
    if visibility_state != "confirmed_in_records" and latest_capture is not None:
        visibility_state = "capture_recorded_projection_pending"
        effective_summary["visibility_state"] = visibility_state
        if not effective_summary.get("record_id"):
            effective_summary["record_id"] = latest_capture.get("payment_capture_id")
        if effective_summary.get("source_kind") in (None, "", "none"):
            effective_summary["source_kind"] = latest_capture.get("source_kind")
        effective_summary["payment_state"] = latest_capture.get("payment_state") or effective_summary.get("payment_state")
        effective_summary["amount_cents"] = latest_capture.get("amount_cents")
        effective_summary["currency"] = latest_capture.get("currency")
        effective_summary["captured_at"] = latest_capture.get("captured_at")
        effective_summary["recorded_at"] = latest_capture.get("recorded_at")
        effective_summary["captured_by"] = latest_capture.get("captured_by")
        effective_summary["reference"] = latest_capture.get("reference")
    return {
        "order_id": order.get("order_id"),
        "quote_id": order.get("active_quote_id"),
        "customer_id": order.get("customer_id"),
        "customer_email": order.get("customer_email"),
        "customer_name": order.get("customer_name"),
        "lifecycle_state": order.get("lifecycle_state"),
        "payment_state": order.get("payment_state"),
        "payment_visibility_state": visibility_state,
        "payment_summary": effective_summary,
        "latest_payment_capture": latest_capture or None,
        "source_quote_packet_id": order.get("source_quote_packet_id"),
        "updated_at": order.get("updated_at"),
    }


def build_capture_only_match(record: dict[str, Any]) -> dict[str, Any]:
    return {
        "order_id": record.get("order_id"),
        "quote_id": record.get("quote_id"),
        "customer_id": record.get("customer_id"),
        "customer_email": record.get("customer_email"),
        "customer_name": record.get("customer_name"),
        "lifecycle_state": None,
        "payment_state": record.get("payment_state"),
        "payment_visibility_state": "capture_recorded_projection_pending",
        "payment_summary": None,
        "latest_payment_capture": record,
        "source_quote_packet_id": record.get("source_quote_packet_id"),
        "updated_at": record.get("recorded_at"),
    }


def overall_state(matches: list[dict[str, Any]]) -> str:
    if not matches:
        return "no_record_found"
    states = {str(item.get("payment_visibility_state") or "") for item in matches}
    if "confirmed_in_records" in states:
        return "confirmed_in_records"
    if "capture_recorded_projection_pending" in states:
        return "capture_recorded_projection_pending"
    return "not_yet_visible"


def print_text(payload: dict[str, Any]) -> None:
    latest = payload.get("latest") or {}
    print(f"capability: {payload['capability']}")
    print(f"query_mode: {payload['query_mode']}")
    print(f"query_value: {payload['query_value']}")
    print(f"state: {payload['state']}")
    print(f"match_count: {payload['match_count']}")
    print(f"latest_order_id: {latest.get('order_id') or ''}")
    print(f"latest_payment_state: {latest.get('payment_state') or ''}")
    print(f"latest_visibility_state: {latest.get('payment_visibility_state') or ''}")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    paths = runtime_paths(resolve_spine_root())
    mode, value = query_mode(args)
    if not value:
        fail("query value is required")

    captures = load_index(paths["payment_captures_index_file"], "payment_captures")
    order_ids = collect_order_ids(paths, mode, value)
    matches: list[dict[str, Any]] = []

    seen_order_ids: set[str] = set()
    for order_id in order_ids:
        if not order_id or order_id in seen_order_ids:
            continue
        seen_order_ids.add(order_id)
        try:
            _order_file, order = load_order(paths, order_id)
        except (FileNotFoundError, ValueError):
            continue
        matches.append(build_match(order, latest_capture_for_order(captures, order_id)))

    matched_capture_ids = {str((item.get("latest_payment_capture") or {}).get("payment_capture_id") or "") for item in matches}
    for record in captures:
        if not capture_matches(record, mode, value):
            continue
        record_id = str(record.get("payment_capture_id") or "")
        order_id = str(record.get("order_id") or "")
        if record_id in matched_capture_ids or order_id in seen_order_ids:
            continue
        matches.append(build_capture_only_match(record))

    matches.sort(key=item_timestamp, reverse=True)
    payload = {
        "capability": capability_name(),
        "query_mode": mode,
        "query_value": value,
        "state": overall_state(matches),
        "match_count": len(matches),
        "latest": matches[0] if matches else None,
        "matches": matches,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print_text(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
