#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from customer_inbox_machine_common import load_machine_contract, transition_inbox_item  # noqa: E402
from operator_mail_common import resolve_spine_root, resolve_spine_state  # noqa: E402


CAPABILITY_NAME = "mint.customer.inbox.transition"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="customer-inbox-transition",
        description="Transition a governed Mint inbox-item state by inbox-item id or team mailbox message id.",
    )
    parser.add_argument("--state", required=True, help="Target inbox-item workflow state")
    parser.add_argument("--inbox-item-id", default="", help="Inbox item id")
    parser.add_argument("--message-id", default="", help="Team mailbox message id")
    parser.add_argument("--note", default="", help="Optional operator note")
    parser.add_argument("--actor", default="", help="Optional explicit actor id")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    args = parser.parse_args(argv)
    if not str(args.inbox_item_id or args.message_id).strip():
        raise SystemExit("inbox-item-id or message-id required")
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    spine_root = resolve_spine_root()
    state_root = resolve_spine_state(spine_root)
    contract = load_machine_contract(spine_root)
    actor = (
        str(args.actor or "").strip()
        or str(os.environ.get("MORPHEUS_OPERATOR_ID") or "").strip()
        or str(os.environ.get("OPS_TERMINAL_ROLE") or "").strip()
        or CAPABILITY_NAME
    )
    record = transition_inbox_item(
        state_root,
        contract=contract,
        new_state=args.state,
        inbox_item_id=args.inbox_item_id,
        message_id=args.message_id,
        note=args.note,
        actor=actor,
    )
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
        return 0
    print(CAPABILITY_NAME)
    print(f"inbox_item_id: {record.get('inbox_item_id', '')}")
    print(f"workflow_state: {record.get('workflow_state', '')}")
    print(f"record_file: {record.get('record_file', '')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
