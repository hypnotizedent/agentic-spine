#!/usr/bin/env bash
# quote-source - Governed packet-driven supplier sourcing runtime

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
SOURCER="$SCRIPT_DIR/../lib/quote_packet_source.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$SOURCER" ]]; then
  echo "STOP (2): sourcer not found: $SOURCER" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$SOURCER" "$@"
