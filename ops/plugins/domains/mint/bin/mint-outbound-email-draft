#!/usr/bin/env python3
"""
mint.outbound.email.draft — Outbound quote email composer.

Ingests the output of mint.quote.generate, locates mockup paths in Hot
storage, and constructs a professional draft email for operator approval.
Agents MUST NOT send this email directly — draft goes to operator review.

Authority:
  - Storage lifecycle: ops/plugins/domains/mint/storage/mint.storage.lifecycle.yaml
  - Quote packet: ops/bindings/domains/mint/mint.quote.packet.authority.yaml
  - Reply draft policy: ops/bindings/domains/mint/mint.customer.reply.draft.policy.contract.yaml
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.domains.mint.lib.mint_intake_common import (
    MINT_RUNTIME_ROOT,
    generate_id,
    get_db_connection,
    get_order_mockups,
    hot_mockup_path,
    init_db,
    now_utc,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Draft outbound quote email for operator approval"
    )
    parser.add_argument("--quote-file", help="Path to quote JSON from mint.quote.generate")
    parser.add_argument("--history-file", help="Path to customer history JSON (optional, for personalization)")
    parser.add_argument("--sender", default="team@mintprints.com",
                        help="Sender address (default: team@mintprints.com)")
    parser.add_argument("--json", action="store_true", default=True)
    return parser.parse_args()


def find_hot_mockups(order_id: str) -> list[dict[str, Any]]:
    """Scan Hot storage for mockup files associated with this order."""
    mockup_root = MINT_RUNTIME_ROOT / "hot" / "mockups" / order_id
    found: list[dict[str, Any]] = []
    if not mockup_root.exists():
        return found
    for path in mockup_root.rglob("*"):
        if path.is_file() and not path.name.startswith("."):
            found.append({
                "filename": path.name,
                "path": str(path),
                "size_bytes": path.stat().st_size,
            })
    return found


def find_db_mockups(order_id: str) -> list[dict[str, Any]]:
    """Query the Mint database for mockup records linked to this order."""
    try:
        conn = get_db_connection()
        init_db(conn)
        mockups = get_order_mockups(conn, order_id)
        conn.close()
        return mockups
    except Exception:
        return []


def format_price(dollars: float) -> str:
    return f"${dollars:,.2f}"


def format_garment_table(line_items: list[dict[str, Any]]) -> str:
    """Format garment pricing tiers into a clean text table for the email."""
    lines: list[str] = []
    for i, item in enumerate(line_items):
        qty = item.get("quantity_assumed", "TBD")
        garment = item.get("garment_type_detected") or "Custom Apparel"
        garment = garment.title() if isinstance(garment, str) else str(garment)

        lines.append(f"  {garment} — {qty} pieces")
        lines.append("")
        for tier in item.get("garment_pricing", []):
            example = f" ({tier['example']})" if tier.get("example") else ""
            lines.append(
                f"    {tier['tier']}{example}: "
                f"{format_price(tier['unit_price'])}/ea → "
                f"{format_price(tier['line_total'])} total"
            )
        lines.append("")

        # Show top decoration options (limit to 4 for readability)
        dec_options = item.get("decoration_pricing", [])[:4]
        if dec_options:
            lines.append("  Decoration options:")
            for dec in dec_options:
                setup = f" + {format_price(dec['setup_cost'])} setup" if dec["setup_cost"] > 0 else ""
                lines.append(
                    f"    • {dec['method']} ({dec['variant']}): "
                    f"{format_price(dec['per_unit_cost'])}/ea{setup}"
                )
            lines.append("")

        if item.get("note"):
            lines.append(f"  Note: {item['note']}")
            lines.append("")

    return "\n".join(lines)


def compose_subject(quote: dict[str, Any]) -> str:
    """Generate a professional email subject line."""
    customer = quote.get("customer_name") or "Customer"
    items = quote.get("line_items") or []
    if items and items[0].get("garment_type_detected"):
        garment = items[0]["garment_type_detected"].title()
        return f"Your {garment} Quote from Mint Prints"
    return f"Your Custom Quote from Mint Prints"


def compose_body(quote: dict[str, Any], history: dict[str, Any] | None,
                 mockups: list[dict[str, Any]], sender: str) -> str:
    """Compose the full email body."""
    customer_name = quote.get("customer_name") or "there"
    customer_tier = quote.get("customer_tier", "new")
    summary = quote.get("summary") or {}

    # Personalized greeting
    if customer_tier == "returning":
        greeting = f"Hi {customer_name},\n\nGreat to hear from you again!"
    elif customer_tier == "repeat":
        greeting = f"Hi {customer_name},\n\nThanks for coming back to us!"
    else:
        greeting = f"Hi {customer_name},\n\nThanks for reaching out to Mint Prints!"

    # Quote introduction
    intro = (
        " We've put together pricing options for your project below. "
        "Since some details are still open, we've included a few tiers "
        "so you can choose what fits best.\n"
    )

    # Pricing table
    pricing_section = format_garment_table(quote.get("line_items", []))

    # Price range summary
    range_low = summary.get("price_range_low", 0)
    range_high = summary.get("price_range_high", 0)
    if range_low and range_high and range_low != range_high:
        range_text = (
            f"\nEstimated range: {format_price(range_low)} – {format_price(range_high)}\n"
            f"(Final price depends on garment selection and decoration method)\n"
        )
    elif range_low:
        range_text = f"\nEstimated total: {format_price(range_low)}\n"
    else:
        range_text = ""

    # Returning customer discount note
    discount_note = ""
    discount_pct = 0
    items = quote.get("line_items", [])
    if items:
        discount_pct = items[0].get("customer_discount_pct", 0)
    if discount_pct > 0:
        discount_note = f"\n* Your returning customer discount ({discount_pct}%) is already applied above.\n"

    # Mockup section
    mockup_section = ""
    if mockups:
        mockup_section = (
            "\n--- Mockups ---\n"
            f"We have {len(mockups)} mockup(s) attached for your review. "
            "Let us know if you'd like any adjustments.\n"
        )

    # Call to action
    cta = (
        "\nTo move forward, just reply with:\n"
        "  1. Your preferred garment tier (Basic / Mid-Range / Premium)\n"
        "  2. Your preferred decoration method\n"
        "  3. Final quantity and size breakdown\n"
        "\nWe'll lock in your pricing and get started right away.\n"
    )

    # Sign-off
    signoff = (
        "\nBest,\n"
        "The Mint Prints Team\n"
        f"{sender}\n"
    )

    return (
        f"{greeting}{intro}\n"
        f"--- Pricing Options ---\n\n"
        f"{pricing_section}"
        f"{range_text}"
        f"{discount_note}"
        f"{mockup_section}"
        f"{cta}"
        f"{signoff}"
    )


def draft_email(quote: dict[str, Any], history: dict[str, Any] | None,
                sender: str) -> dict[str, Any]:
    """Assemble the complete email draft envelope."""
    draft_id = generate_id()
    order_id = quote.get("order_id", "")

    # Resolve mockups from Hot storage + DB
    fs_mockups = find_hot_mockups(order_id)
    db_mockups = find_db_mockups(order_id)
    all_mockups = fs_mockups + [
        {"filename": m.get("filename", ""), "path": m.get("storage_path", ""), "source": "database"}
        for m in db_mockups if m.get("storage_path")
    ]

    # Resolve recipient
    recipient = ""
    if history and history.get("status") == "compiled":
        customer = history.get("customer") or {}
        recipient = customer.get("email", "")
    if not recipient and quote.get("customer_name"):
        recipient = "(resolve from customer record)"

    subject = compose_subject(quote)
    body = compose_body(quote, history, all_mockups, sender)

    return {
        "capability": "mint.outbound.email.draft",
        "generated_at": now_utc(),
        "draft_id": draft_id,
        "order_id": order_id,
        "quote_id": quote.get("quote_id", ""),
        "status": "draft_ready",
        "email": {
            "from": sender,
            "to": recipient,
            "subject": subject,
            "body": body,
            "mockup_attachments": all_mockups,
        },
        "approval_required": True,
        "approval_note": (
            "This draft requires OPERATOR APPROVAL before sending. "
            "Review pricing, personalization, and attachments. "
            "Agents are forbidden from sending without explicit operator sign-off."
        ),
        "next_step": "operator_review_and_send",
    }


def main() -> int:
    args = parse_args()

    # Load quote JSON
    quote: dict[str, Any] = {}
    if args.quote_file:
        with open(args.quote_file) as f:
            quote = json.load(f)
    elif not sys.stdin.isatty():
        quote = json.load(sys.stdin)

    if not quote:
        print(json.dumps({"status": "error", "error": "No quote input provided"}))
        return 1

    # Load history JSON (optional)
    history: dict[str, Any] | None = None
    if args.history_file:
        with open(args.history_file) as f:
            history = json.load(f)

    result = draft_email(quote, history, args.sender)
    print(json.dumps(result, indent=2, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
