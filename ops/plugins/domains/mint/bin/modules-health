#!/usr/bin/env bash
# modules-health - HTTP health probe for mint module endpoints (fresh-slate)
#
# Checks all app modules on mint-apps (VM 213) plus data plane on mint-data (VM 212):
#   files-api, quote-page, order-intake, finance-adapter, auth, pricing, suppliers, shipping, payment
#   minio, postgres, redis
#
# Read-only. No mutations.
# STOP=2 on preconditions.
#
# Usage:
#   modules-health              # check all mint endpoints
#   modules-health <component>  # check specific component
#   modules-health --parallel 6
#   modules-health --strict-exit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"
SSH_BINDING="$SPINE_ROOT/ops/bindings/ssh.targets.yaml"
SERVICES_BINDING="$SPINE_ROOT/ops/bindings/services.health.yaml"
PROBE_BINDING="$SPINE_ROOT/ops/bindings/mint.probe.targets.yaml"
MINT_HEALTH_SURFACE="$SPINE_ROOT/ops/lib/mint-health-surface.sh"
# shellcheck source=/dev/null
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"
# shellcheck source=/dev/null
source "$MINT_HEALTH_SURFACE"

stop(){ echo "STOP (2): $*" >&2; exit 2; }

command -v yq >/dev/null 2>&1 || stop "missing dependency: yq"
command -v curl >/dev/null 2>&1 || stop "missing dependency: curl"
command -v ssh >/dev/null 2>&1 || stop "missing dependency: ssh"
[[ -f "$SSH_BINDING" ]] || stop "missing binding: $SSH_BINDING"
[[ -f "$SERVICES_BINDING" ]] || stop "missing binding: $SERVICES_BINDING"
[[ -f "$PROBE_BINDING" ]] || stop "missing binding: $PROBE_BINDING"
[[ -f "$MINT_HEALTH_SURFACE" ]] || stop "missing helper: $MINT_HEALTH_SURFACE"

FILTER=""
STRICT_EXIT=0
PARALLEL="${MINT_MODULES_PARALLEL:-6}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --parallel)
      PARALLEL="${2:?--parallel requires value}"
      shift 2
      ;;
    --strict-exit)
      STRICT_EXIT=1
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage:
  modules-health
  modules-health <component>
  modules-health --parallel 6
  modules-health --strict-exit

Flags:
  --parallel <n>  Run Mint probes concurrently (default: 6).
  --strict-exit  Exit non-zero when any checked component is not OK.
EOF
      exit 0
      ;;
    *)
      if [[ -n "$FILTER" ]]; then
        stop "unknown argument: $1"
      fi
      FILTER="$1"
      shift
      ;;
  esac
done

[[ "$PARALLEL" =~ ^[1-9][0-9]*$ ]] || stop "--parallel must be integer >= 1"

APP_TARGET_ID="$(mint_probe_target_id app_plane)"
DATA_TARGET_ID="$(mint_probe_target_id data_plane)"
[[ -n "$APP_TARGET_ID" && "$APP_TARGET_ID" != "null" ]] || stop "missing app plane target in $PROBE_BINDING"
[[ -n "$DATA_TARGET_ID" && "$DATA_TARGET_ID" != "null" ]] || stop "missing data plane target in $PROBE_BINDING"

MINT_APPS_HOST="$(yq -r ".ssh.targets[] | select(.id == \"$APP_TARGET_ID\") | .host" "$SSH_BINDING" | head -n1)"
MINT_DATA_HOST="$(yq -r ".ssh.targets[] | select(.id == \"$DATA_TARGET_ID\") | .host" "$SSH_BINDING" | head -n1)"
MINT_APPS_USER="$(ssh_resolve_user "$APP_TARGET_ID" "ubuntu")"
MINT_DATA_USER="$(ssh_resolve_user "$DATA_TARGET_ID" "ubuntu")"

[[ -n "$MINT_APPS_HOST" && "$MINT_APPS_HOST" != "null" ]] || stop "$APP_TARGET_ID not found in ssh.targets"
[[ -n "$MINT_DATA_HOST" && "$MINT_DATA_HOST" != "null" ]] || stop "$DATA_TARGET_ID not found in ssh.targets"

resolve_http_target() {
  local target_id="$1"
  local default_host="$2"
  local result resolved_host resolved_path

  result="$(ssh_resolve_ssh_host_with_fallback "$target_id" 2 || true)"
  resolved_host="$(printf '%s\n' "$result" | awk '{print $1}')"
  resolved_path="$(printf '%s\n' "$result" | awk '{print $2}')"

  if [[ -z "$resolved_host" || "$resolved_path" == "unreachable" ]]; then
    result="$(ssh_resolve_probe_host "$target_id" 2 || true)"
    resolved_host="$(printf '%s\n' "$result" | awk '{print $1}')"
    resolved_path="$(printf '%s\n' "$result" | awk '{print $2}')"
  fi

  [[ -n "$resolved_host" ]] || resolved_host="$default_host"
  case "$resolved_path" in
    lan|tailscale|direct) ;;
    *) resolved_path="direct" ;;
  esac

  printf '%s\t%s\n' "$resolved_host" "$resolved_path"
}

rewrite_url_for_target() {
  local url="$1"
  local target_id="$2"
  local preferred_host="$3"
  local preferred_path="$4"
  local canonical_host rewritten_url

  canonical_host="$(ssh_resolve_host "$target_id")"
  rewritten_url="$url"
  if [[ -n "$canonical_host" && -n "$preferred_host" && "$preferred_host" != "$canonical_host" ]]; then
    rewritten_url="${url//$canonical_host/$preferred_host}"
  fi

  printf '%s\t%s\n' "$rewritten_url" "${preferred_path:-direct}"
}

IFS=$'\t' read -r MINT_APPS_PROBE_HOST MINT_APPS_PROBE_PATH <<< "$(resolve_http_target "$APP_TARGET_ID" "$MINT_APPS_HOST")"
IFS=$'\t' read -r MINT_DATA_PROBE_HOST MINT_DATA_PROBE_PATH <<< "$(resolve_http_target "$DATA_TARGET_ID" "$MINT_DATA_HOST")"
IFS=' ' read -r MINT_DATA_SSH_HOST MINT_DATA_SSH_PATH <<< "$(ssh_resolve_ssh_host_with_fallback "$DATA_TARGET_ID" || true)"

echo "mint.modules.health"
echo "services.binding: $SERVICES_BINDING"
echo "probe.binding: $PROBE_BINDING"
echo "$APP_TARGET_ID: ${MINT_APPS_USER}@${MINT_APPS_HOST} (VM $(yq -r '.targets.app_plane.vm_id // "?"' "$PROBE_BINDING")) http=${MINT_APPS_PROBE_HOST:-unreachable} via=${MINT_APPS_PROBE_PATH:-unreachable}"
echo "$DATA_TARGET_ID: ${MINT_DATA_USER}@${MINT_DATA_HOST} (VM $(yq -r '.targets.data_plane.vm_id // "?"' "$PROBE_BINDING")) http=${MINT_DATA_PROBE_HOST:-unreachable} via=${MINT_DATA_PROBE_PATH:-unreachable} ssh=${MINT_DATA_SSH_HOST:-unreachable}/${MINT_DATA_SSH_PATH:-unreachable}"
echo

declare -a HTTP_ROWS=()
while IFS=$'\t' read -r name plane; do
  [[ -z "$name" ]] && continue
  if [[ -n "$FILTER" && "$name" != "$FILTER" ]]; then
    continue
  fi
  [[ "$(mint_service_enabled "$name")" == "true" ]] || continue
  url="$(mint_service_url "$name")"
  [[ -n "$url" ]] || stop "missing canonical url for $name in $SERVICES_BINDING"
  case "$plane" in
    app_plane)
      IFS=$'\t' read -r resolved_url resolved_path <<< "$(rewrite_url_for_target "$url" "$APP_TARGET_ID" "$MINT_APPS_PROBE_HOST" "$MINT_APPS_PROBE_PATH")"
      HTTP_ROWS+=("$name|$APP_TARGET_ID|${resolved_path:-$MINT_APPS_PROBE_PATH}|$resolved_url")
      ;;
    data_plane)
      IFS=$'\t' read -r resolved_url resolved_path <<< "$(rewrite_url_for_target "$url" "$DATA_TARGET_ID" "$MINT_DATA_PROBE_HOST" "$MINT_DATA_PROBE_PATH")"
      HTTP_ROWS+=("$name|$DATA_TARGET_ID|${resolved_path:-$MINT_DATA_PROBE_PATH}|$resolved_url")
      ;;
    *)
      stop "unknown mint http plane in helper: $plane"
      ;;
  esac
done < <(mint_http_rows_tsv)

SSH_OPTS=(-o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR)

printf "%-16s %-10s %-10s %s\n" "COMPONENT" "STATUS" "TIME" "NOTE"

fail=0
checked=0

curl_health_with_retry() {
  local url="$1"
  local max_attempts=3
  local attempt=1
  local backoff=1
  local http_code curl_exit

  while [[ "$attempt" -le "$max_attempts" ]]; do
    set +e
    http_code="$(curl -fsS -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 "$url" 2>/dev/null)"
    curl_exit=$?
    set -e

    if [[ "$curl_exit" -eq 0 || ( "$curl_exit" -ne 28 && "$curl_exit" -ne 7 ) || "$attempt" -eq "$max_attempts" ]]; then
      printf '%s %s\n' "$http_code" "$curl_exit"
      return 0
    fi

    sleep "$backoff"
    backoff=$((backoff * 2))
    attempt=$((attempt + 1))
  done
}

check_http_result() {
  local idx="$1" name="$2" target_id="$3" path_used="$4" url="$5"
  if [[ -z "$url" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "UNREACHABLE" "-" "target=$target_id" "1"
    return 0
  fi
  local start_ms end_ms dur_ms http_code curl_exit
  start_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
  read -r http_code curl_exit <<< "$(curl_health_with_retry "$url")"
  end_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
  dur_ms=$((end_ms - start_ms))
  if [[ "$curl_exit" -eq 0 && "$http_code" == "200" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "OK" "${dur_ms}ms" "target=$target_id via=${path_used:-direct}" "0"
  elif [[ "$curl_exit" -eq 0 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "DEGRADED" "${dur_ms}ms" "target=$target_id via=${path_used:-direct} http=$http_code" "1"
  elif [[ "$curl_exit" -eq 28 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "TIMEOUT" "${dur_ms}ms" "target=$target_id via=${path_used:-direct}" "1"
  elif [[ "$curl_exit" -eq 7 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "REFUSED" "${dur_ms}ms" "target=$target_id via=${path_used:-direct}" "1"
  else
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "FAIL" "${dur_ms}ms" "target=$target_id via=${path_used:-direct} curl=$curl_exit" "1"
  fi
}

check_ssh_service_result() {
  local idx="$1" name="$2" target_id="$3" host="$4" path_used="$5" user="$6" cmd="$7"
  if [[ -z "$host" ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "UNREACHABLE" "-" "target=$target_id" "1"
    return 0
  fi
  local start_ms end_ms dur_ms
  start_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
  set +e
  local out
  out="$(ssh "${SSH_OPTS[@]}" "${user}@${host}" "$cmd" 2>&1)"
  local rc=$?
  set -e
  end_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
  dur_ms=$((end_ms - start_ms))
  if [[ "$rc" -eq 0 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "OK" "${dur_ms}ms" "target=$target_id via=${path_used:-direct}" "0"
  else
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "FAIL" "${dur_ms}ms" "target=$target_id via=${path_used:-direct} rc=$rc" "1"
  fi
}

RESULT_ROOT="$(mktemp -d)"
declare -a RESULT_FILES=()
active_batch=0
task_index=0

schedule_result_task() {
  local result_file="$1"
  shift
  RESULT_FILES+=("$result_file")
  (
    set +e
    "$@" >"$result_file"
    echo "$?" >"${result_file}.rc"
  ) &
  active_batch=$((active_batch + 1))
  if (( active_batch >= PARALLEL )); then
    set +e
    wait
    set -e
    active_batch=0
  fi
}

for row in "${HTTP_ROWS[@]}"; do
  IFS='|' read -r name target_id path_used url <<< "$row"
  task_index=$((task_index + 1))
  printf -v task_slot '%03d' "$task_index"
  schedule_result_task "$RESULT_ROOT/${task_slot}-${name}.row" check_http_result "$task_slot" "$name" "$target_id" "$path_used" "$url"
done

while IFS=$'\t' read -r name cmd; do
  [[ -z "$name" ]] && continue
  task_index=$((task_index + 1))
  printf -v task_slot '%03d' "$task_index"
  schedule_result_task "$RESULT_ROOT/${task_slot}-${name}.row" check_ssh_service_result "$task_slot" "$name" "$DATA_TARGET_ID" "$MINT_DATA_SSH_HOST" "$MINT_DATA_SSH_PATH" "$MINT_DATA_USER" "$cmd"
done < <(yq -r '.targets.data_plane.ssh_checks[] | [.id, .command] | @tsv' "$PROBE_BINDING")

set +e
wait
set -e

for result_file in "${RESULT_FILES[@]}"; do
  rc="$(cat "${result_file}.rc" 2>/dev/null || echo 99)"
  if [[ "$rc" -ne 0 ]]; then
    rm -rf "$RESULT_ROOT"
    stop "worker failure for $(basename "$result_file")"
  fi
  IFS=$'\t' read -r _ name status duration note failed_flag <"$result_file"
  printf "%-16s %-10s %-10s %s\n" "$name" "$status" "$duration" "$note"
  checked=$((checked + 1))
  if [[ "$failed_flag" == "1" ]]; then
    fail=1
  fi
done

rm -rf "$RESULT_ROOT"

echo

if [[ "$checked" -eq 0 && -n "$FILTER" ]]; then
  echo "STOP (2): component '$FILTER' not found"
  exit 2
fi

if [[ "$fail" -eq 1 ]]; then
  echo "status: FAIL (some components unhealthy)"
else
  echo "status: OK (all components healthy)"
fi

if [[ "$STRICT_EXIT" -eq 1 && "$fail" -eq 1 ]]; then
  exit 1
fi
exit 0
