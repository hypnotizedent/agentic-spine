#!/usr/bin/env python3
"""
mint.decoration.link — Artwork→Decoration binding with heuristic auto-linking.

Links artwork files to line items by creating decoration records. Uses heuristics
to auto-link simple cases (1 line item + 1 artwork) and returns clarification
requests for ambiguous cases (multiple line items or artwork).

Authority:
  - Schema: ops/plugins/domains/mint/schema/mint.core.schema.sql
  - Schema governance: ops/plugins/domains/mint/schema/mint.schema.authority.yaml
  - Order truth: ops/bindings/mint.order.truth.authority.yaml
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.domains.mint.lib.mint_intake_common import (
    generate_id,
    get_db_connection,
    get_order,
    get_order_line_items,
    init_db,
    now_utc,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Link artwork to line items via decoration records"
    )
    parser.add_argument("--order-id", required=True, help="Order UUID")
    parser.add_argument("--method", default="screen_print",
                        help="Decoration method (default: screen_print)")
    parser.add_argument("--placement", default="front",
                        help="Decoration placement (default: front)")
    parser.add_argument("--dry-run", action="store_true",
                        help="Show what would be linked without writing to DB")
    parser.add_argument("--json", action="store_true", default=True)
    return parser.parse_args()


def get_order_artwork(conn: "sqlite3.Connection", order_id: str) -> list[dict[str, Any]]:
    """Query all artwork associated with an order."""
    cursor = conn.execute(
        """SELECT a.artwork_id, a.customer_id, a.filename, a.file_format,
                  a.storage_path, a.storage_tier, a.created_at
           FROM artwork a
           JOIN line_item li ON li.order_id = ?
           WHERE a.customer_id = (SELECT customer_id FROM "order" WHERE order_id = ?)
           ORDER BY a.created_at DESC""",
        (order_id, order_id),
    )
    return [dict(row) for row in cursor.fetchall()]


def get_existing_decorations(conn: "sqlite3.Connection", order_id: str) -> list[dict[str, Any]]:
    """Query existing decorations for an order."""
    cursor = conn.execute(
        """SELECT d.decoration_id, d.line_item_id, d.artwork_id, d.method, d.placement
           FROM decoration d
           JOIN line_item li ON d.line_item_id = li.line_item_id
           WHERE li.order_id = ?""",
        (order_id,),
    )
    return [dict(row) for row in cursor.fetchall()]


def create_decoration(
    conn: "sqlite3.Connection",
    line_item_id: str,
    artwork_id: str,
    method: str,
    placement: str,
) -> dict[str, Any]:
    """Insert a decoration record linking artwork to line item."""
    decoration_id = generate_id()
    ts = now_utc()

    conn.execute(
        """INSERT INTO decoration (decoration_id, line_item_id, artwork_id, method, placement, created_at, updated_at)
           VALUES (?, ?, ?, ?, ?, ?, ?)""",
        (decoration_id, line_item_id, artwork_id, method, placement, ts, ts),
    )

    return {
        "decoration_id": decoration_id,
        "line_item_id": line_item_id,
        "artwork_id": artwork_id,
        "method": method,
        "placement": placement,
        "created_at": ts,
    }


def link_decorations(
    order_id: str,
    method: str,
    placement: str,
    *,
    dry_run: bool = False,
) -> dict[str, Any]:
    """
    Main decoration linking logic.
    Returns one of:
      - {"status": "linked", "decorations": [...]} — auto-linked successfully
      - {"status": "requires_clarification", "options": [...]} — ambiguous, needs operator input
      - {"status": "error", "error": str} — query failed or order not found
    """
    conn = get_db_connection()
    try:
        init_db(conn)

        order = get_order(conn, order_id)
        if not order:
            return {
                "status": "error",
                "error": f"Order {order_id} not found in database",
            }

        line_items = get_order_line_items(conn, order_id)
        if not line_items:
            return {
                "status": "error",
                "error": f"No line items found for order {order_id}",
            }

        artwork = get_order_artwork(conn, order_id)
        if not artwork:
            return {
                "status": "error",
                "error": f"No artwork found for order {order_id}",
            }

        existing_decorations = get_existing_decorations(conn, order_id)
        if existing_decorations:
            return {
                "status": "already_linked",
                "decorations": existing_decorations,
                "note": "Decorations already exist for this order",
            }

        # Heuristic: 1 line item + 1 artwork → auto-link
        if len(line_items) == 1 and len(artwork) == 1:
            if dry_run:
                return {
                    "status": "would_link",
                    "dry_run": True,
                    "line_item": line_items[0],
                    "artwork": artwork[0],
                    "method": method,
                    "placement": placement,
                }

            decoration = create_decoration(
                conn=conn,
                line_item_id=line_items[0]["line_item_id"],
                artwork_id=artwork[0]["artwork_id"],
                method=method,
                placement=placement,
            )

            conn.commit()

            return {
                "status": "linked",
                "decorations": [decoration],
                "heuristic": "single_line_item_single_artwork",
            }

        # Ambiguous: multiple line items or artwork
        return {
            "status": "requires_clarification",
            "reason": f"{len(line_items)} line items, {len(artwork)} artwork files",
            "line_items": line_items,
            "artwork": artwork,
            "options": [
                {
                    "action": "Specify which artwork goes on which line item",
                    "example": "./bin/ops cap run mint.decoration.link -- --order-id {order_id} --line-item-id {id} --artwork-id {id}",
                },
                {
                    "action": "Apply same artwork to all line items",
                    "note": "Requires operator approval for multi-item orders",
                },
            ],
        }

    except Exception as e:
        conn.rollback()
        return {
            "status": "error",
            "error": str(e),
        }
    finally:
        conn.close()


def main() -> int:
    args = parse_args()

    result = link_decorations(
        order_id=args.order_id,
        method=args.method,
        placement=args.placement,
        dry_run=args.dry_run,
    )

    result["capability"] = "mint.decoration.link"
    result["generated_at"] = now_utc()

    print(json.dumps(result, indent=2, default=str))

    if result["status"] in ("linked", "already_linked", "would_link"):
        return 0
    elif result["status"] == "requires_clarification":
        return 2  # Exit code 2 = needs clarification (not an error)
    else:
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
