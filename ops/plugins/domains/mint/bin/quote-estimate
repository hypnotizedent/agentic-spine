#!/usr/bin/env bash
# quote-estimate - Governed packet-driven quote estimation runtime

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
ESTIMATOR="$SCRIPT_DIR/../lib/quote_packet_estimate.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$ESTIMATOR" ]]; then
  echo "STOP (2): estimator not found: $ESTIMATOR" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$ESTIMATOR" "$@"
