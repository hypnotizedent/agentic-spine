#!/usr/bin/env bash
# pricing-lane-matrix - Governed lane-matrix pricing bridge

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
RUNNER="$SCRIPT_DIR/../lib/pricing_lane_matrix.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$RUNNER" ]]; then
  echo "STOP (2): runner not found: $RUNNER" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$RUNNER" "$@"
