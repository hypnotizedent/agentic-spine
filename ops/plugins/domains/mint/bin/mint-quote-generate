#!/usr/bin/env python3
"""
mint.quote.generate — Variable pricing quote generator.

Takes parsed order intent and customer history to produce a quote with a
Variable Pricing Matrix. NEVER blocks or halts on missing parameters —
when garment brand, stitch count, or decoration specifics are unknown,
the generator produces tiered pricing options and proceeds.

Code-Law: Ambiguity → Options, never Failure.

Authority:
  - Order truth: ops/bindings/mint.order.truth.authority.yaml
  - Quote packet: ops/bindings/mint.quote.packet.authority.yaml
  - Schema: ops/plugins/domains/mint/schema/mint.core.schema.sql
"""
from __future__ import annotations

import argparse
import json
import math
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.domains.mint.lib.mint_intake_common import (
    generate_id,
    now_utc,
)

# ---------------------------------------------------------------------------
# Variable Pricing Tiers (Code-Law: these are the fallback, not the blocker)
# ---------------------------------------------------------------------------

GARMENT_TIERS: dict[str, list[dict[str, Any]]] = {
    "t-shirt": [
        {"tier": "Basic", "example": "Gildan G500", "unit_cost_cents": 350, "description": "6.0 oz cotton tee"},
        {"tier": "Mid-Range", "example": "Bella+Canvas 3001", "unit_cost_cents": 550, "description": "4.2 oz combed ringspun"},
        {"tier": "Premium", "example": "Next Level 6210", "unit_cost_cents": 750, "description": "4.3 oz CVC crew"},
    ],
    "hoodie": [
        {"tier": "Basic", "example": "Gildan 18500", "unit_cost_cents": 1200, "description": "8.0 oz blend hoodie"},
        {"tier": "Mid-Range", "example": "Bella+Canvas 3719", "unit_cost_cents": 1800, "description": "7.0 oz sponge fleece"},
        {"tier": "Premium", "example": "Independent SS4500", "unit_cost_cents": 2400, "description": "10.0 oz heavyweight"},
    ],
    "polo": [
        {"tier": "Basic", "example": "Gildan 8800", "unit_cost_cents": 600, "description": "6.0 oz DryBlend polo"},
        {"tier": "Mid-Range", "example": "Port Authority K500", "unit_cost_cents": 900, "description": "5.0 oz silk-touch polo"},
        {"tier": "Premium", "example": "Nike NKDC1963", "unit_cost_cents": 2200, "description": "Dri-FIT performance"},
    ],
    "default": [
        {"tier": "Basic", "unit_cost_cents": 400, "description": "Economy blank"},
        {"tier": "Mid-Range", "unit_cost_cents": 700, "description": "Standard quality"},
        {"tier": "Premium", "unit_cost_cents": 1100, "description": "Premium quality"},
    ],
}

DECORATION_PRICING: dict[str, dict[str, Any]] = {
    "screen_print": {
        "display": "Screen Print",
        "tiers": [
            {"variant": "1-color", "setup_cents": 3500, "per_unit_cents": 250},
            {"variant": "2-color", "setup_cents": 5500, "per_unit_cents": 350},
            {"variant": "3-color", "setup_cents": 7500, "per_unit_cents": 450},
            {"variant": "Full color (simulated)", "setup_cents": 9500, "per_unit_cents": 600},
        ],
    },
    "dtg": {
        "display": "Direct-to-Garment (DTG)",
        "tiers": [
            {"variant": "Standard", "setup_cents": 0, "per_unit_cents": 800},
            {"variant": "Oversized (12x16+)", "setup_cents": 0, "per_unit_cents": 1200},
        ],
    },
    "dtf": {
        "display": "Direct-to-Film (DTF)",
        "tiers": [
            {"variant": "Standard", "setup_cents": 0, "per_unit_cents": 500},
            {"variant": "Large format", "setup_cents": 0, "per_unit_cents": 800},
        ],
    },
    "embroidery": {
        "display": "Embroidery",
        "tiers": [
            {"variant": "Small (≤5K stitches)", "setup_cents": 5000, "per_unit_cents": 400},
            {"variant": "Medium (5-10K stitches)", "setup_cents": 5000, "per_unit_cents": 650},
            {"variant": "Large (10K+ stitches)", "setup_cents": 7500, "per_unit_cents": 900},
        ],
    },
    "vinyl": {
        "display": "Vinyl/Heat Transfer",
        "tiers": [
            {"variant": "Single color", "setup_cents": 0, "per_unit_cents": 500},
            {"variant": "Multi-color", "setup_cents": 0, "per_unit_cents": 800},
        ],
    },
}

QUANTITY_BREAKS = [
    {"min": 1, "max": 11, "label": "Small run (1-11)", "markup_pct": 40},
    {"min": 12, "max": 47, "label": "Standard (12-47)", "markup_pct": 30},
    {"min": 48, "max": 143, "label": "Bulk (48-143)", "markup_pct": 25},
    {"min": 144, "max": 499, "label": "Volume (144-499)", "markup_pct": 20},
    {"min": 500, "max": 999999, "label": "Large volume (500+)", "markup_pct": 15},
]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate variable pricing quote — never blocks on ambiguity"
    )
    parser.add_argument("--intake-file", help="Path to parsed intake JSON from mint.intake.email.parse")
    parser.add_argument("--history-file", help="Path to customer history JSON from mint.customer.history.compile")
    parser.add_argument("--json", action="store_true", default=True)
    return parser.parse_args()


def cents_to_dollars(cents: int) -> float:
    return round(cents / 100, 2)


def get_quantity_break(qty: int) -> dict[str, Any]:
    for brk in QUANTITY_BREAKS:
        if brk["min"] <= qty <= brk["max"]:
            return brk
    return QUANTITY_BREAKS[-1]


def price_line_item(item: dict[str, Any], customer_tier: str) -> dict[str, Any]:
    """
    Generate a Variable Pricing Matrix for a single line item.
    If parameters are missing, generate tiered options instead of failing.
    """
    # Extract values, tolerating confidence-scored or plain formats
    garment_type = item.get("garment_type")
    if isinstance(garment_type, dict):
        garment_type = garment_type.get("value")
    garment_type = (garment_type or "").lower().strip()

    quantity = item.get("quantity")
    if isinstance(quantity, dict):
        quantity = quantity.get("value")
    quantity = int(quantity) if quantity and str(quantity).isdigit() else None

    decoration_method = item.get("decoration_method")
    if isinstance(decoration_method, dict):
        decoration_method = decoration_method.get("value")
    decoration_method = (decoration_method or "").lower().replace(" ", "_").replace("-", "_").strip()

    # --- Garment pricing (variable if brand unknown) ---
    garment_key = garment_type if garment_type in GARMENT_TIERS else "default"
    garment_tiers = GARMENT_TIERS[garment_key]

    # --- Quantity (default to 50 if unknown, show quantity breaks) ---
    assumed_qty = quantity or 50
    qty_break = get_quantity_break(assumed_qty)
    markup = qty_break["markup_pct"] / 100

    # Returning customer discount
    discount = 0.05 if customer_tier == "returning" else 0.03 if customer_tier == "repeat" else 0.0

    # --- Decoration pricing (variable if method unknown) ---
    if decoration_method and decoration_method in DECORATION_PRICING:
        decoration_options = [DECORATION_PRICING[decoration_method]]
    else:
        # Provide all applicable options
        decoration_options = list(DECORATION_PRICING.values())

    # --- Build the matrix ---
    garment_matrix: list[dict[str, Any]] = []
    for gt in garment_tiers:
        base_cost = gt["unit_cost_cents"]
        sell_price = math.ceil(base_cost * (1 + markup) * (1 - discount))
        garment_matrix.append({
            "tier": gt["tier"],
            "example": gt.get("example", ""),
            "description": gt.get("description", ""),
            "unit_cost_cents": base_cost,
            "unit_price_cents": sell_price,
            "unit_price": cents_to_dollars(sell_price),
            "line_total": cents_to_dollars(sell_price * assumed_qty),
        })

    decoration_matrix: list[dict[str, Any]] = []
    for dec_opt in decoration_options:
        for variant in dec_opt["tiers"]:
            decoration_matrix.append({
                "method": dec_opt["display"],
                "variant": variant["variant"],
                "setup_cost": cents_to_dollars(variant["setup_cents"]),
                "per_unit_cost": cents_to_dollars(variant["per_unit_cents"]),
                "total_decoration": cents_to_dollars(
                    variant["setup_cents"] + variant["per_unit_cents"] * assumed_qty
                ),
            })

    return {
        "garment_type_detected": garment_type or None,
        "garment_type_confident": bool(garment_type and garment_type in GARMENT_TIERS),
        "quantity_detected": quantity,
        "quantity_assumed": assumed_qty,
        "quantity_break": qty_break["label"],
        "decoration_method_detected": decoration_method or None,
        "customer_discount_pct": round(discount * 100, 1),
        "garment_pricing": garment_matrix,
        "decoration_pricing": decoration_matrix,
        "quantity_breaks": [
            {
                "range": f"{b['min']}-{b['max'] if b['max'] < 999999 else '+'}",
                "label": b["label"],
                "markup_pct": b["markup_pct"],
            }
            for b in QUANTITY_BREAKS
        ],
    }


def generate_quote(intake: dict[str, Any], history: dict[str, Any] | None) -> dict[str, Any]:
    """Generate a complete quote with Variable Pricing Matrix."""
    quote_id = generate_id()
    order_id = intake.get("provisional_order_id") or intake.get("order_id") or generate_id()
    line_items = intake.get("line_items") or []

    # Determine customer tier from history
    customer_tier = "new"
    customer_name = ""
    if history and history.get("status") == "compiled":
        customer_tier = (history.get("preferences") or {}).get("customer_tier", "new")
        customer_name = (history.get("customer") or {}).get("name", "")

    # Price each line item
    priced_items: list[dict[str, Any]] = []
    for i, item in enumerate(line_items):
        priced = price_line_item(item, customer_tier)
        priced["line_index"] = i
        priced_items.append(priced)

    # If no line items parsed, generate a generic quote template
    if not priced_items:
        priced_items.append(price_line_item({"garment_type": "t-shirt", "quantity": 50}, customer_tier))
        priced_items[0]["note"] = "No specific items detected — showing standard t-shirt pricing template"

    # Quote summary ranges
    min_total = sum(
        p["garment_pricing"][0]["line_total"] + (p["decoration_pricing"][0]["total_decoration"] if p["decoration_pricing"] else 0)
        for p in priced_items
    )
    max_total = sum(
        p["garment_pricing"][-1]["line_total"] + (p["decoration_pricing"][-1]["total_decoration"] if p["decoration_pricing"] else 0)
        for p in priced_items
    )

    return {
        "capability": "mint.quote.generate",
        "generated_at": now_utc(),
        "quote_id": quote_id,
        "order_id": order_id,
        "customer_tier": customer_tier,
        "customer_name": customer_name,
        "pricing_rule": "variable_pricing_matrix",
        "pricing_rule_explanation": (
            "Ambiguous parameters generate tiered options instead of blocking. "
            "The operator selects the final tier before sending to the customer."
        ),
        "line_items": priced_items,
        "summary": {
            "total_line_items": len(priced_items),
            "price_range_low": min_total,
            "price_range_high": max_total,
            "currency": "USD",
            "note": "Range reflects Basic→Premium garment tiers + decoration options",
        },
        "next_step": "mint.outbound.email.draft",
    }


def main() -> int:
    args = parse_args()

    # Load intake JSON
    intake: dict[str, Any] = {}
    if args.intake_file:
        with open(args.intake_file) as f:
            intake = json.load(f)
    elif not sys.stdin.isatty():
        intake = json.load(sys.stdin)

    # Load history JSON (optional)
    history: dict[str, Any] | None = None
    if args.history_file:
        with open(args.history_file) as f:
            history = json.load(f)

    result = generate_quote(intake, history)
    print(json.dumps(result, indent=2, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
