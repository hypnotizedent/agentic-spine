#!/usr/bin/env bash
# quote-render - Compatibility wrapper for governed quote_packet render

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
RENDERER="$SCRIPT_DIR/../lib/quote_packet_render.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$RENDERER" ]]; then
  echo "STOP (2): renderer not found: $RENDERER" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$RENDERER" "$@"
