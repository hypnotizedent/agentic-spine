#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
RUNTIME="$SCRIPT_DIR/../lib/customer_voice.py"

source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
export SPINE_ROOT="$ROOT"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$RUNTIME" ]]; then
  echo "STOP (2): runtime not found: $RUNTIME" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$RUNTIME" callback "$@"
