#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/plugins/domains/mint/lib/mint-operator-storage-common.sh"

BRIEF=0
JSON_MODE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --brief) BRIEF=1; shift ;;
    --json) JSON_MODE=1; shift ;;
    -h|--help)
      cat <<'EOF'
mint.operator.storage.status

Usage:
  mint-operator-storage-status [--brief|--json]
EOF
      exit 0
      ;;
    *)
      echo "mint.operator.storage.status FAIL: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

mint_operator_storage_require_contract
mint_operator_storage_load_contract

mount_payload="$(mint_operator_storage_mount_status)"
mount_status="${mount_payload%%|*}"
rest="${mount_payload#*|}"
mount_attached="${rest%%|*}"
rest="${rest#*|}"
mount_accessible="${rest%%|*}"
rest="${rest#*|}"
mount_process="${rest%%|*}"
mount_rc="${rest##*|}"

remote_status="fail"
remote_detail="probe_failed"
if mint_operator_storage_remote_ok; then
  remote_status="ok"
  remote_detail="reachable"
else
  rc=$?
  if [[ "$rc" == "2" ]]; then
    remote_status="missing_tool"
    remote_detail="rclone_missing"
  fi
fi

operator_drop_state="missing"
required_paths_state="missing"
if mint_operator_storage_operator_drop_ready; then
  operator_drop_state="ready"
fi
if mint_operator_storage_required_paths_ready; then
  required_paths_state="ready"
fi

fallback_entries="$(mint_operator_storage_list_mount_fallback_entries "$mount_status" || true)"
fallback_count="$(mint_operator_storage_count_lines "$fallback_entries")"
legacy_desktop_state="$(mint_operator_storage_legacy_desktop_state)"
legacy_desktop_entries="$(mint_operator_storage_legacy_desktop_entries || true)"
legacy_desktop_count="$(mint_operator_storage_count_lines "$legacy_desktop_entries")"
assist_helper_state="$(mint_operator_storage_assist_helper_state)"
assist_app_state="$(mint_operator_storage_assist_app_state)"
assist_surface_state="$(mint_operator_storage_assist_surface_state)"

overall_status="ok"
if [[ "$remote_status" != "ok" || "$operator_drop_state" != "ready" || "$fallback_count" -gt 0 || "$legacy_desktop_state" == "dirty" ]]; then
  overall_status="fail"
elif [[ "$MINT_OPERATOR_ASSIST_REQUIRES_ENTRY_SURFACE" == "true" && "$assist_surface_state" != "ready" ]]; then
  overall_status="warn"
elif [[ "$legacy_desktop_state" == "empty" ]]; then
  overall_status="warn"
elif [[ "$mount_status" != "ACTIVE" || "$required_paths_state" != "ready" ]]; then
  overall_status="warn"
fi

if [[ "$JSON_MODE" -eq 1 ]]; then
  if command -v "$MINT_OPERATOR_JQ_BIN" >/dev/null 2>&1; then
    jq -n \
      --arg capability "mint.operator.storage.status" \
      --arg status "$overall_status" \
      --arg mode "$MINT_OPERATOR_MODE" \
      --arg operator_drop "$MINT_OPERATOR_CANONICAL_DROP_ROOT" \
      --arg remote "${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_HEALTH_PROBE_PATH}" \
      --arg remote_status "$remote_status" \
      --arg remote_detail "$remote_detail" \
      --arg remote_operator_drop "$MINT_OPERATOR_CANONICAL_DROP_REMOTE" \
      --arg mount_status "$mount_status" \
      --arg mount_label "$MINT_OPERATOR_MOUNT_LABEL" \
      --arg mountpoint "$MINT_OPERATOR_MOUNTPOINT" \
      --arg mount_attached "$mount_attached" \
      --arg mount_accessible "$mount_accessible" \
      --arg mount_process "$mount_process" \
      --arg mount_rc "$mount_rc" \
      --arg mount_role "$MINT_OPERATOR_MOUNT_ROLE" \
      --arg operator_drop_state "$operator_drop_state" \
      --arg required_paths_state "$required_paths_state" \
      --arg legacy_desktop_path "$MINT_OPERATOR_LEGACY_DESKTOP_PATH" \
      --arg legacy_desktop_state "$legacy_desktop_state" \
      --arg assist_mode "$MINT_OPERATOR_ASSIST_MODE" \
      --arg assist_helper_bin "$MINT_OPERATOR_ASSIST_HELPER_BIN" \
      --arg assist_helper_state "$assist_helper_state" \
      --arg assist_app_path "$MINT_OPERATOR_ASSIST_FINDER_APP" \
      --arg assist_app_state "$assist_app_state" \
      --arg assist_surface_state "$assist_surface_state" \
      --arg fallback_count "$fallback_count" \
      --arg legacy_desktop_count "$legacy_desktop_count" \
      '{
        capability: $capability,
        status: $status,
        critical_path: $mode,
        operator_drop_path: $operator_drop,
        remote_target: $remote,
        remote_status: $remote_status,
        remote_detail: $remote_detail,
        remote_operator_drop: $remote_operator_drop,
        mount_surface: {
          label: $mount_label,
          mountpoint: $mountpoint,
          role: $mount_role,
          status: $mount_status,
          attached: $mount_attached,
          accessible: $mount_accessible,
          process_running: $mount_process,
          rc_reachable: $mount_rc
        },
        operator_drop_state: $operator_drop_state,
        required_paths_state: $required_paths_state,
        assisted_move_surface: {
          mode: $assist_mode,
          helper_bin: $assist_helper_bin,
          helper_state: $assist_helper_state,
          finder_app_path: $assist_app_path,
          finder_app_state: $assist_app_state,
          surface_state: $assist_surface_state
        },
        fallback_local_entries: ($fallback_count | tonumber),
        legacy_desktop: {
          path: $legacy_desktop_path,
          state: $legacy_desktop_state,
          entries: ($legacy_desktop_count | tonumber)
        }
      }'
  else
    echo "{\"status\":\"$overall_status\"}"
  fi
  exit 0
fi

if [[ "$BRIEF" -eq 1 ]]; then
  echo "status=${overall_status} mode=${MINT_OPERATOR_MODE} remote=${remote_status} mount=${mount_status} operator_drop=${operator_drop_state} assist=${assist_surface_state} desktop_legacy=${legacy_desktop_state} fallback=${fallback_count}"
  exit 0
fi

echo "mint.operator.storage.status"
echo "status: ${overall_status}"
echo "critical_path: ${MINT_OPERATOR_MODE}"
echo "operator_drop_path: ${MINT_OPERATOR_CANONICAL_DROP_ROOT}"
echo "operator_drop_remote: ${MINT_OPERATOR_CANONICAL_DROP_REMOTE}"
echo "remote_target: ${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_HEALTH_PROBE_PATH}"
echo "remote_status: ${remote_status}"
echo "remote_detail: ${remote_detail}"
echo "mount_label: ${MINT_OPERATOR_MOUNT_LABEL}"
echo "mount_role: ${MINT_OPERATOR_MOUNT_ROLE}"
echo "mount_status: ${mount_status}"
echo "mountpoint: ${MINT_OPERATOR_MOUNTPOINT}"
echo "mount_attached: ${mount_attached}"
echo "mount_accessible: ${mount_accessible}"
echo "mount_process_running: ${mount_process}"
echo "mount_rc_reachable: ${mount_rc}"
echo "operator_drop_state: ${operator_drop_state}"
echo "required_paths_state: ${required_paths_state}"
echo "assisted_move_mode: ${MINT_OPERATOR_ASSIST_MODE}"
echo "assisted_move_helper: ${MINT_OPERATOR_ASSIST_HELPER_BIN}"
echo "assisted_move_helper_state: ${assist_helper_state}"
echo "assisted_move_finder_app: ${MINT_OPERATOR_ASSIST_FINDER_APP}"
echo "assisted_move_finder_app_state: ${assist_app_state}"
echo "assisted_move_surface_state: ${assist_surface_state}"
echo "fallback_local_entries: ${fallback_count}"
echo "legacy_desktop_path: ${MINT_OPERATOR_LEGACY_DESKTOP_PATH}"
echo "legacy_desktop_state: ${legacy_desktop_state}"
echo "legacy_desktop_entries: ${legacy_desktop_count}"
echo "note: use the governed assisted-move surface for Desktop/Downloads -> operator-drop; the MinIO mount is browse-only convenience, not the write path"
