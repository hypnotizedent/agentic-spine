#!/usr/bin/env python3
"""
mint.customer.history.compile — Customer history context compiler.

Read-only capability that queries the Mint database to build a strict JSON
context packet for a customer. Agents are FORBIDDEN from drafting customer
communications without passing this context packet into their prompt.

Authority:
  - Schema: ops/plugins/domains/mint/schema/mint.core.schema.sql
  - Order truth: ops/bindings/mint.order.truth.authority.yaml
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[5]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.domains.mint.lib.mint_intake_common import (
    get_customer,
    get_customer_aggregate,
    get_customer_artwork,
    get_customer_by_email,
    get_customer_orders,
    get_db_connection,
    get_db_path,
    get_line_item_decorations,
    get_order,
    get_order_line_items,
    get_order_mockups,
    init_db,
    now_utc,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Compile customer history context packet from Mint database"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--customer-id", help="Customer UUID")
    group.add_argument("--order-id", help="Order UUID (resolves to customer)")
    group.add_argument("--email", help="Customer email address")
    parser.add_argument("--include-artwork", action="store_true", default=True,
                        help="Include artwork library (default: true)")
    parser.add_argument("--include-mockups", action="store_true", default=True,
                        help="Include mockup history (default: true)")
    parser.add_argument("--max-orders", type=int, default=20,
                        help="Maximum past orders to include (default: 20)")
    parser.add_argument("--json", action="store_true", default=True)
    return parser.parse_args()


def compile_history(conn: "sqlite3.Connection", customer_id: str,
                    *, max_orders: int = 20, include_artwork: bool = True,
                    include_mockups: bool = True) -> dict[str, Any]:
    """Build the complete customer context packet."""

    customer = get_customer(conn, customer_id)
    if not customer:
        return {
            "capability": "mint.customer.history.compile",
            "generated_at": now_utc(),
            "status": "not_found",
            "customer_id": customer_id,
            "error": "Customer not found in Mint database",
        }

    # --- Aggregate stats ---
    aggregate = get_customer_aggregate(conn, customer_id)

    # --- Order history with full detail ---
    orders = get_customer_orders(conn, customer_id)[:max_orders]
    order_details: list[dict[str, Any]] = []
    for order in orders:
        line_items = get_order_line_items(conn, order["order_id"])
        for li in line_items:
            li["decorations"] = get_line_item_decorations(conn, li["line_item_id"])

        detail: dict[str, Any] = {
            **order,
            "line_items": line_items,
        }
        if include_mockups:
            detail["mockups"] = get_order_mockups(conn, order["order_id"])
        order_details.append(detail)

    # --- Artwork library ---
    artwork: list[dict[str, Any]] = []
    if include_artwork:
        artwork = get_customer_artwork(conn, customer_id)

    # --- Derived preferences ---
    preferences: dict[str, Any] = {}
    if aggregate.get("preferred_garments"):
        top = aggregate["preferred_garments"][0]
        preferences["typical_garment"] = f"{top['brand']} {top['category']}"
    if aggregate.get("preferred_decoration_methods"):
        top = aggregate["preferred_decoration_methods"][0]
        preferences["typical_decoration"] = top["method"]
    if aggregate.get("total_orders", 0) > 0:
        preferences["customer_tier"] = (
            "returning" if aggregate["total_orders"] >= 3
            else "repeat" if aggregate["total_orders"] >= 2
            else "new"
        )
    else:
        preferences["customer_tier"] = "new"

    return {
        "capability": "mint.customer.history.compile",
        "generated_at": now_utc(),
        "status": "compiled",
        "db_path": str(get_db_path()),
        "customer": customer,
        "aggregate": aggregate,
        "preferences": preferences,
        "orders": order_details,
        "artwork_library": artwork,
        "context_guidance": {
            "rule": "This context packet MUST be included when drafting customer communications.",
            "use_for": [
                "Greeting personalization (use customer name, reference past orders)",
                "Pricing context (returning customers may have negotiated rates)",
                "Artwork reuse (check library before requesting new uploads)",
                "Tone calibration (new vs returning vs high-value customer)",
            ],
        },
    }


def main() -> int:
    args = parse_args()
    conn = get_db_connection()
    try:
        init_db(conn)

        # Resolve customer_id from various inputs
        customer_id = args.customer_id
        if args.order_id:
            order = get_order(conn, args.order_id)
            if not order:
                print(json.dumps({"status": "error", "error": f"Order {args.order_id} not found"}))
                return 1
            customer_id = order["customer_id"]
        elif args.email:
            customer = get_customer_by_email(conn, args.email)
            if not customer:
                print(json.dumps({"status": "error", "error": f"No customer with email {args.email}"}))
                return 1
            customer_id = customer["customer_id"]

        result = compile_history(
            conn, customer_id,
            max_orders=args.max_orders,
            include_artwork=args.include_artwork,
            include_mockups=args.include_mockups,
        )
    finally:
        conn.close()

    print(json.dumps(result, indent=2, default=str))
    return 0 if result.get("status") != "error" else 1


if __name__ == "__main__":
    raise SystemExit(main())
