#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from customer_identity_common import query_customer_rows  # noqa: E402
from printavo_bridge_common import (  # noqa: E402
    default_printavo_summary,
    load_index,
    load_order,
    load_quote,
    normalize_printavo_summary,
    normalize_text,
    runtime_paths,
    resolve_spine_root,
)
from quote_packet_normalize import fail  # noqa: E402


CAPABILITY_NAME = "mint.printavo.bridge.snapshot"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="printavo-bridge-snapshot",
        description="Read governed Mint Printavo bridge visibility from canonical order truth and immutable bridge records.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--order-id", help="Canonical Mint order_id")
    group.add_argument("--quote-id", help="Canonical Mint quote_id")
    group.add_argument("--seed-id", help="Canonical Mint seed_id")
    group.add_argument("--customer-id", help="Fresh-slate customer record id")
    group.add_argument("--email", help="Customer email address")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    return parser.parse_args(argv)


def capability_name() -> str:
    return os.environ.get("MINT_PRINTAVO_BRIDGE_CAPABILITY_NAME") or CAPABILITY_NAME


def query_mode(args: argparse.Namespace) -> tuple[str, str]:
    if args.order_id:
        return "order_id", normalize_text(args.order_id)
    if args.quote_id:
        return "quote_id", normalize_text(args.quote_id)
    if args.seed_id:
        return "seed_id", normalize_text(args.seed_id)
    if args.customer_id:
        return "customer_id", normalize_text(args.customer_id)
    return "email", normalize_text(args.email).lower()


def run_cap_json(spine_root: Path, capability: str, args: list[str]) -> dict[str, Any]:
    cmd = [str(spine_root / "bin" / "ops"), "cap", "run", capability]
    if args:
        cmd.extend(["--", *args])
    result = subprocess.run(cmd, cwd=spine_root, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        combined = (result.stdout or "") + ("\n" + result.stderr if result.stderr else "")
        fail(f"{capability} failed: {combined.strip()}")
    text = (result.stdout or "").strip()
    start = text.find("{")
    end = text.rfind("}")
    if start == -1 or end == -1 or end < start:
        fail(f"{capability} returned non-JSON output")
    return json.loads(text[start : end + 1])


def seed_exists(spine_root: Path, seed_id: str) -> bool:
    if not seed_id:
        return False
    payload = run_cap_json(spine_root, "mint.seeds.query", ["--json", "--seed-id", seed_id, "--limit", "1"])
    return bool(payload.get("rows"))


def email_has_seed(spine_root: Path, email: str) -> tuple[bool, dict[str, Any]]:
    if not email:
        return False, {}
    payload = run_cap_json(spine_root, "mint.seeds.query", ["--json", "--email", email, "--limit", "1"])
    rows = list(payload.get("rows") or [])
    return bool(rows), dict(rows[0]) if rows else {}


def item_timestamp(item: dict[str, Any]) -> str:
    bridge = item.get("latest_printavo_bridge") or {}
    summary = item.get("printavo_summary") or {}
    return str(item.get("updated_at") or bridge.get("recorded_at") or summary.get("last_reconciled_at") or "")


def customer_anchor_for_order(spine_root: Path, order: dict[str, Any]) -> dict[str, Any]:
    customer_id = normalize_text(order.get("customer_id"))
    customer_email = normalize_text(order.get("customer_email")).lower()
    rows: list[dict[str, Any]] = []
    if customer_id:
        rows = query_customer_rows(spine_root, record_id=customer_id)
    if not rows and customer_email:
        rows = query_customer_rows(spine_root, email=customer_email)
    return dict(rows[0]) if rows else {}


def collect_order_ids(paths: dict[str, Path], mode: str, value: str) -> list[str]:
    if mode == "order_id":
        return [value] if value else []
    if mode == "quote_id":
        try:
            _quote_file, quote = load_quote(paths, value)
            order_id = normalize_text(quote.get("order_id"))
            return [order_id] if order_id else []
        except (FileNotFoundError, ValueError):
            return []

    order_ids: list[str] = []
    for path in sorted(paths["orders_dir"].glob("order_*.yaml")):
        order_id = path.stem.removeprefix("order_")
        try:
            _order_file, order = load_order(paths, order_id)
        except (FileNotFoundError, ValueError):
            continue
        if mode == "customer_id" and normalize_text(order.get("customer_id")) == value:
            order_ids.append(order_id)
        elif mode == "email" and normalize_text(order.get("customer_email")).lower() == value:
            order_ids.append(order_id)
        elif mode == "seed_id" and value in [normalize_text(item) for item in (order.get("intake_seed_refs") or [])]:
            order_ids.append(order_id)
    return order_ids


def bridge_matches(record: dict[str, Any], mode: str, value: str) -> bool:
    if mode == "order_id":
        return normalize_text(record.get("order_id")) == value
    if mode == "quote_id":
        return normalize_text(record.get("quote_id")) == value
    if mode == "seed_id":
        return normalize_text(record.get("seed_id")) == value
    if mode == "customer_id":
        return normalize_text(record.get("customer_id")) == value
    return normalize_text(record.get("customer_email")).lower() == value


def build_match(spine_root: Path, order: dict[str, Any], latest_bridge: dict[str, Any] | None) -> dict[str, Any]:
    summary = normalize_printavo_summary(order)
    if latest_bridge is not None and summary.get("record_id") in (None, "", "null") and latest_bridge.get("printavo_bridge_id"):
        overlay = copy.deepcopy(summary)
        overlay.update(
            {
                "printavo_state": latest_bridge.get("printavo_state"),
                "printavo_customer_id": latest_bridge.get("printavo_customer_id"),
                "printavo_invoice_url": latest_bridge.get("printavo_invoice_url"),
                "printavo_public_invoice_url": latest_bridge.get("printavo_public_invoice_url"),
                "printavo_work_order_url": latest_bridge.get("printavo_work_order_url"),
                "printavo_visual_id": latest_bridge.get("printavo_visual_id"),
                "last_reconciled_at": latest_bridge.get("last_reconciled_at"),
                "source_kind": latest_bridge.get("source_kind"),
                "record_kind": "printavo_bridge",
                "record_id": latest_bridge.get("printavo_bridge_id"),
                "provenance": copy.deepcopy(latest_bridge.get("provenance") or summary.get("provenance") or {}),
            }
        )
        summary = overlay
    elif not normalize_text(summary.get("printavo_customer_id")):
        customer_anchor = customer_anchor_for_order(spine_root, order)
        anchored_printavo_customer_id = normalize_text(customer_anchor.get("printavo_customer_id"))
        if anchored_printavo_customer_id:
            summary["printavo_customer_id"] = anchored_printavo_customer_id
            summary["provenance"] = {"source": "fresh_customer_anchor", "basis": ["fresh_customer_printavo_id"]}
    return {
        "order_id": order.get("order_id"),
        "quote_id": order.get("active_quote_id"),
        "seed_id": next((normalize_text(item) for item in (order.get("intake_seed_refs") or []) if normalize_text(item)), None),
        "customer_id": order.get("customer_id"),
        "customer_email": order.get("customer_email"),
        "customer_name": order.get("customer_name"),
        "printavo_state": summary.get("printavo_state"),
        "printavo_summary": summary,
        "latest_printavo_bridge": latest_bridge or None,
        "source_quote_packet_id": order.get("source_quote_packet_id"),
        "updated_at": order.get("updated_at"),
    }


def build_bridge_only_match(record: dict[str, Any]) -> dict[str, Any]:
    return {
        "order_id": record.get("order_id"),
        "quote_id": record.get("quote_id"),
        "seed_id": record.get("seed_id"),
        "customer_id": record.get("customer_id"),
        "customer_email": record.get("customer_email"),
        "customer_name": record.get("customer_name"),
        "printavo_state": record.get("printavo_state"),
        "printavo_summary": {
            "schema_version": "1.0",
            "printavo_state": record.get("printavo_state"),
            "printavo_customer_id": record.get("printavo_customer_id"),
            "printavo_invoice_url": record.get("printavo_invoice_url"),
            "printavo_public_invoice_url": record.get("printavo_public_invoice_url"),
            "printavo_work_order_url": record.get("printavo_work_order_url"),
            "printavo_visual_id": record.get("printavo_visual_id"),
            "last_reconciled_at": record.get("last_reconciled_at"),
            "source_kind": record.get("source_kind"),
            "record_kind": "printavo_bridge",
            "record_id": record.get("printavo_bridge_id"),
            "provenance": copy.deepcopy(record.get("provenance") or {"source": record.get("source_kind"), "basis": []}),
        },
        "latest_printavo_bridge": record,
        "source_quote_packet_id": record.get("source_quote_packet_id"),
        "updated_at": record.get("recorded_at"),
    }


def build_default_context(
    *,
    mode: str,
    value: str,
    customer_row: dict[str, Any] | None,
    latest_seed: dict[str, Any] | None,
) -> dict[str, Any] | None:
    if mode == "seed_id" and not value:
        return None
    if mode in {"customer_id", "email"} and not customer_row and not latest_seed:
        return None
    summary = default_printavo_summary()
    if customer_row:
        summary["printavo_customer_id"] = normalize_text(customer_row.get("printavo_customer_id")) or None
        if summary["printavo_customer_id"]:
            summary["provenance"] = {"source": "fresh_customer_anchor", "basis": ["fresh_customer_printavo_id"]}
    return {
        "order_id": None,
        "quote_id": None,
        "seed_id": normalize_text((latest_seed or {}).get("seed_id")) or (value if mode == "seed_id" else None),
        "customer_id": (customer_row or {}).get("record_id"),
        "customer_email": (customer_row or {}).get("email") or (latest_seed or {}).get("customer_email"),
        "customer_name": (customer_row or {}).get("name") or (customer_row or {}).get("company"),
        "printavo_state": summary.get("printavo_state"),
        "printavo_summary": summary,
        "latest_printavo_bridge": None,
        "source_quote_packet_id": None,
        "updated_at": None,
    }


def overall_state(matches: list[dict[str, Any]]) -> str:
    if not matches:
        return "no_record_found"
    return str((matches[0].get("printavo_summary") or {}).get("printavo_state") or matches[0].get("printavo_state") or "no_record_found")


def print_text(payload: dict[str, Any]) -> None:
    latest = payload.get("latest") or {}
    print(f"capability: {payload['capability']}")
    print(f"query_mode: {payload['query_mode']}")
    print(f"query_value: {payload['query_value']}")
    print(f"state: {payload['state']}")
    print(f"match_count: {payload['match_count']}")
    print(f"latest_order_id: {latest.get('order_id') or ''}")
    print(f"latest_seed_id: {latest.get('seed_id') or ''}")
    print(f"latest_printavo_state: {latest.get('printavo_state') or ''}")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    spine_root = resolve_spine_root()
    paths = runtime_paths(spine_root)
    mode, value = query_mode(args)
    if not value:
        fail("query value is required")

    bridge_index = load_index(paths["printavo_bridges_index_file"], "printavo_bridges")
    order_ids = collect_order_ids(paths, mode, value)
    matches: list[dict[str, Any]] = []
    seen_order_ids: set[str] = set()
    for order_id in order_ids:
        if not order_id or order_id in seen_order_ids:
            continue
        seen_order_ids.add(order_id)
        try:
            _order_file, order = load_order(paths, order_id)
        except (FileNotFoundError, ValueError):
            continue
        latest_bridge = None
        matching_bridges = [record for record in bridge_index if normalize_text(record.get("order_id")) == order_id]
        matching_bridges.sort(key=lambda item: str(item.get("recorded_at") or item.get("last_reconciled_at") or ""), reverse=True)
        if matching_bridges:
            latest_bridge = dict(matching_bridges[0])
        matches.append(build_match(spine_root, order, latest_bridge))

    seen_bridge_ids = {normalize_text((item.get("latest_printavo_bridge") or {}).get("printavo_bridge_id")) for item in matches}
    for record in bridge_index:
        if not bridge_matches(record, mode, value):
            continue
        bridge_id = normalize_text(record.get("printavo_bridge_id"))
        if bridge_id in seen_bridge_ids:
            continue
        order_id = normalize_text(record.get("order_id"))
        if order_id and order_id in seen_order_ids:
            continue
        matches.append(build_bridge_only_match(record))

    customer_row = None
    latest_seed: dict[str, Any] | None = None
    if not matches:
        if mode == "seed_id" and seed_exists(spine_root, value):
            latest_seed = {"seed_id": value}
        elif mode == "email":
            rows = query_customer_rows(spine_root, email=value)
            customer_row = dict(rows[0]) if rows else None
            has_seed, latest_seed_row = email_has_seed(spine_root, value)
            latest_seed = latest_seed_row if has_seed else None
        elif mode == "customer_id":
            rows = query_customer_rows(spine_root, record_id=value)
            customer_row = dict(rows[0]) if rows else None
            email = normalize_text((customer_row or {}).get("email")).lower()
            if email:
                has_seed, latest_seed_row = email_has_seed(spine_root, email)
                latest_seed = latest_seed_row if has_seed else None
        default_match = build_default_context(mode=mode, value=value, customer_row=customer_row, latest_seed=latest_seed)
        if default_match is not None:
            matches.append(default_match)

    matches.sort(key=item_timestamp, reverse=True)
    payload = {
        "capability": capability_name(),
        "query_mode": mode,
        "query_value": value,
        "state": overall_state(matches),
        "match_count": len(matches),
        "latest": matches[0] if matches else None,
        "matches": matches,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print_text(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
