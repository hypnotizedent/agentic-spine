#!/usr/bin/env bash
# quote-prepare - Compatibility wrapper for governed quote_packet normalization
#
# Canonical runtime: ops/plugins/domains/mint/lib/quote_packet_normalize.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
NORMALIZER="$SCRIPT_DIR/../lib/quote_packet_normalize.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$NORMALIZER" ]]; then
  echo "STOP (2): normalizer not found: $NORMALIZER" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$NORMALIZER" "$@"
