#!/usr/bin/env python3
from __future__ import annotations

import argparse
import copy
import json
import os
import sys
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR.parent / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from artwork_intelligence_common import load_index, normalize_lower, normalize_text, resolve_spine_root, runtime_paths  # noqa: E402
from quote_packet_normalize import fail  # noqa: E402


CAPABILITY_NAME = "mint.artwork.intelligence.snapshot"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="artwork-intelligence-snapshot",
        description="Read the latest governed Mint artwork intelligence by seed, customer, order, job, or thread.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--seed-id")
    group.add_argument("--email")
    group.add_argument("--customer-id")
    group.add_argument("--order-id")
    group.add_argument("--job-ref")
    group.add_argument("--thread-id")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    return parser.parse_args(argv)


def capability_name() -> str:
    return os.environ.get("MINT_ARTWORK_INTELLIGENCE_CAPABILITY_NAME") or CAPABILITY_NAME


def query_mode(args: argparse.Namespace) -> tuple[str, str]:
    if args.seed_id:
        return "seed_id", normalize_text(args.seed_id)
    if args.email:
        return "email", normalize_lower(args.email)
    if args.customer_id:
        return "customer_id", normalize_text(args.customer_id)
    if args.order_id:
        return "order_id", normalize_text(args.order_id)
    if args.job_ref:
        return "job_ref", normalize_text(args.job_ref)
    return "thread_id", normalize_text(args.thread_id)


def entry_matches(entry: dict[str, Any], mode: str, value: str) -> bool:
    if mode == "seed_id":
        return normalize_text(entry.get("seed_id")) == value
    if mode == "email":
        return normalize_lower(entry.get("customer_email")) == value
    if mode == "customer_id":
        return normalize_text(entry.get("customer_id")) == value
    if mode == "order_id":
        return normalize_text(entry.get("order_id")) == value
    if mode == "job_ref":
        return normalize_text(entry.get("job_ref")) == value
    return normalize_text(entry.get("thread_id")) == value


def overall_state(matches: list[dict[str, Any]]) -> str:
    if not matches:
        return "no_analysis_found"
    if any(int(item.get("review_required_count") or 0) > 0 for item in matches):
        return "analysis_present_review_required"
    return "analysis_present_reusable"


def print_text(payload: dict[str, Any]) -> None:
    latest = payload.get("latest") or {}
    print(f"capability: {payload['capability']}")
    print(f"query_mode: {payload['query_mode']}")
    print(f"query_value: {payload['query_value']}")
    print(f"state: {payload['state']}")
    print(f"match_count: {payload['match_count']}")
    print(f"latest_analysis_id: {latest.get('analysis_id') or ''}")
    print(f"latest_review_required_count: {latest.get('review_required_count') or 0}")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    mode, value = query_mode(args)
    if not value:
        fail("query value is required")

    paths = runtime_paths(resolve_spine_root())
    matches: list[dict[str, Any]] = []
    for entry in load_index(paths["analyses_index_file"], "artwork_intelligence"):
        if not entry_matches(entry, mode, value):
            continue
        matches.append(copy.deepcopy(entry))
    matches.sort(key=lambda item: normalize_text(item.get("created_at")), reverse=True)

    payload = {
        "capability": capability_name(),
        "query_mode": mode,
        "query_value": value,
        "state": overall_state(matches),
        "match_count": len(matches),
        "latest": matches[0] if matches else None,
        "matches": matches,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print_text(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
