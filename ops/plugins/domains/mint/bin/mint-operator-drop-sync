#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/plugins/domains/mint/lib/mint-operator-storage-common.sh"

EXECUTE=0
JSON_MODE=0
QUIET=0
declare -a REQUESTED_FOLDERS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --execute) EXECUTE=1; shift ;;
    --json) JSON_MODE=1; shift ;;
    --quiet) QUIET=1; shift ;;
    --folder)
      REQUESTED_FOLDERS+=("${2:?--folder requires value}")
      shift 2
      ;;
    -h|--help)
      cat <<'EOF'
mint.operator.drop.sync

Usage:
  mint-operator-drop-sync [--execute] [--json] [--quiet] [--folder NAME ...]

Notes:
  - Without --execute, this is a read-only preview.
  - Successful upload plus successful ingest deletes the local source folder.
EOF
      exit 0
      ;;
    *)
      echo "mint.operator.drop.sync FAIL: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

mint_operator_storage_require_contract
mint_operator_storage_load_contract
mint_operator_storage_ensure_local_roots

LOCK_DIR="${SPINE_LOCKS}/mint-operator-drop-sync.lock"
mkdir -p "$SPINE_LOCKS"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  if [[ "$JSON_MODE" -eq 1 ]]; then
    printf '{"status":"locked","executed":false}\n'
  elif [[ "$QUIET" -eq 0 ]]; then
    echo "mint.operator.drop.sync"
    echo "status: locked"
    echo "note: another sync is already running"
  fi
  exit 0
fi
trap 'rmdir "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT

if ! command -v "$MINT_OPERATOR_RCLONE_BIN" >/dev/null 2>&1; then
  echo "mint.operator.drop.sync FAIL: missing rclone" >&2
  exit 1
fi

MINTCTL_BIN="${MINTCTL_BIN:-$MINT_OPERATOR_MINT_REPO_ROOT/bin/mintctl}"
[[ -x "$MINTCTL_BIN" ]] || mint_operator_storage_fail "missing mintctl: $MINTCTL_BIN"

pending_dirs_raw="$(mint_operator_storage_list_inbox_dirs || true)"
loose_entries_raw="$(mint_operator_storage_list_inbox_loose_entries || true)"

declare -a FOLDERS=()
if [[ "${#REQUESTED_FOLDERS[@]}" -gt 0 ]]; then
  for folder in "${REQUESTED_FOLDERS[@]}"; do
    [[ -n "$folder" ]] || continue
    FOLDERS+=("$folder")
  done
else
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    FOLDERS+=("${entry##*/}")
  done <<< "$pending_dirs_raw"
fi

if [[ "${#FOLDERS[@]}" -eq 0 && -z "$loose_entries_raw" ]]; then
  if [[ "$JSON_MODE" -eq 1 ]]; then
    printf '{"status":"ok","executed":%s,"folders":0,"uploaded":0,"ingested":0,"deleted":0,"errors":0}\n' "$([[ "$EXECUTE" -eq 1 ]] && echo true || echo false)"
  elif [[ "$QUIET" -eq 0 ]]; then
    echo "mint.operator.drop.sync"
    echo "status: ok"
    echo "executed: $([[ "$EXECUTE" -eq 1 ]] && echo true || echo false)"
    echo "folders: 0"
    echo "note: no pending operator-drop folders"
  fi
  exit 0
fi

uploaded=0
ingested=0
deleted=0
errors=0
loose_count="$(mint_operator_storage_count_lines "$loose_entries_raw")"

if [[ "$JSON_MODE" -eq 0 && "$QUIET" -eq 0 ]]; then
  echo "mint.operator.drop.sync"
  echo "mode: $([[ "$EXECUTE" -eq 1 ]] && echo execute || echo preview)"
  echo "local_inbox: $MINT_OPERATOR_LOCAL_INBOX"
  echo "remote_target: ${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_BUCKET}/${MINT_OPERATOR_PREFIX}"
  echo "folders: ${#FOLDERS[@]}"
fi

if ! mint_operator_storage_remote_ok; then
  echo "mint.operator.drop.sync FAIL: remote ${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_HEALTH_PROBE_PATH} is not reachable" >&2
  exit 1
fi

for folder in "${FOLDERS[@]}"; do
  local_dir="${MINT_OPERATOR_LOCAL_INBOX}/${folder}"
  remote_dir="${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_BUCKET}/${MINT_OPERATOR_PREFIX}/${folder}"

  if [[ ! -d "$local_dir" ]]; then
    echo "WARN: missing local folder: $local_dir" >&2
    mint_operator_storage_history_append "missing" "$folder" "local folder missing"
    errors=$((errors + 1))
    continue
  fi

  if [[ "$EXECUTE" -eq 0 ]]; then
    if [[ "$JSON_MODE" -eq 0 && "$QUIET" -eq 0 ]]; then
      echo "preview: folder=${folder} -> ${remote_dir}"
    fi
    continue
  fi

  if ! "$MINT_OPERATOR_RCLONE_BIN" copy "$local_dir" "$remote_dir" \
      --create-empty-src-dirs="$MINT_OPERATOR_CREATE_EMPTY_SRC_DIRS" \
      --contimeout "$MINT_OPERATOR_CONTIMEOUT" \
      --timeout "$MINT_OPERATOR_TIMEOUT" \
      --retries "$MINT_OPERATOR_RETRIES" \
      --low-level-retries "$MINT_OPERATOR_LOW_LEVEL_RETRIES"; then
    echo "ERROR: upload failed for ${folder}" >&2
    mint_operator_storage_history_append "upload_failed" "$folder" "rclone copy failed"
    errors=$((errors + 1))
    continue
  fi
  uploaded=$((uploaded + 1))

  if ! "$MINTCTL_BIN" morpheus intake "$MINT_OPERATOR_FOLDER_FLAG" "$folder"; then
    echo "ERROR: ingest failed for ${folder}" >&2
    mint_operator_storage_history_append "ingest_failed" "$folder" "mintctl intake failed"
    errors=$((errors + 1))
    continue
  fi
  ingested=$((ingested + 1))

  rm -rf "$local_dir"
  deleted=$((deleted + 1))
  mint_operator_storage_history_append "synced" "$folder" "uploaded, ingested, local source deleted"
done

overall_status="ok"
if [[ "$errors" -gt 0 ]]; then
  overall_status="fail"
elif [[ "$loose_count" -gt 0 ]]; then
  overall_status="warn"
fi

if [[ "$JSON_MODE" -eq 1 ]]; then
  printf '{"status":"%s","executed":%s,"folders":%s,"uploaded":%s,"ingested":%s,"deleted":%s,"loose_entries":%s,"errors":%s}\n' \
    "$overall_status" \
    "$([[ "$EXECUTE" -eq 1 ]] && echo true || echo false)" \
    "${#FOLDERS[@]}" \
    "$uploaded" \
    "$ingested" \
    "$deleted" \
    "$loose_count" \
    "$errors"
else
  if [[ "$QUIET" -eq 0 ]]; then
    echo "status: ${overall_status}"
    echo "uploaded: ${uploaded}"
    echo "ingested: ${ingested}"
    echo "deleted_local_sources: ${deleted}"
    echo "loose_entries: ${loose_count}"
    echo "errors: ${errors}"
    if [[ "$loose_count" -gt 0 ]]; then
      echo "note: loose non-directory entries remain in ${MINT_OPERATOR_LOCAL_INBOX}"
    fi
  fi
fi

if [[ "$errors" -gt 0 ]]; then
  exit 1
fi

if [[ "$loose_count" -gt 0 ]]; then
  exit 1
fi
