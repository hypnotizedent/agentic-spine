#!/usr/bin/env bash
# mint-auth-secrets-sync - Generate auth secrets env file from Infisical for mint-apps
#
# This script creates /opt/stacks/mint-apps/.env.auth-secrets containing auth/files-api
# secret variables sourced from Infisical. The file is machine-generated and non-authoritative.
#
# Infisical is the ONLY source of truth. This file is a projection/cache for docker compose.
#
# Usage:
#   mint-auth-secrets-sync [--dry-run]
#
# Output: /opt/stacks/mint-apps/.env.auth-secrets (mode 600, non-authoritative)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$HOME/code/agentic-spine}"
SSH_BINDING="${SPINE_ROOT}/ops/bindings/ssh.targets.yaml"
DRY_RUN=0

# shellcheck source=/dev/null
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "missing dependency: jq" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { echo "missing dependency: ssh" >&2; exit 2; }
command -v yq >/dev/null 2>&1 || { echo "missing dependency: yq" >&2; exit 2; }
[[ -f "$SSH_BINDING" ]] || { echo "missing binding: $SSH_BINDING" >&2; exit 2; }

MINT_APPS_USER="$(ssh_resolve_user "mint-apps" "ubuntu")"
MINT_APPS_PORT="$(yq -r '.ssh.targets[] | select(.id == "mint-apps") | .port // 22' "$SSH_BINDING" | head -n1)"
IFS=' ' read -r MINT_APPS_HOST MINT_APPS_PATH <<< "$(ssh_resolve_ssh_host_with_fallback "mint-apps" 3 || true)"
[[ -n "$MINT_APPS_HOST" && "$MINT_APPS_PATH" != "unreachable" ]] || { echo "mint-apps unreachable for auth secret sync" >&2; exit 2; }
SSH_OPTS=(-o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR)

# Fetch auth secrets from Infisical via canonical local agent
echo "Fetching auth secrets from Infisical (infrastructure/prod /spine/services/auth)..."
SECRETS_JSON=$("$SPINE_ROOT/ops/plugins/providers/bin/infisical-agent.sh" list-recursive infrastructure prod)

# Extract the 5 auth secrets
AUTH_DATABASE_URL=$(echo "$SECRETS_JSON" | jq -r '.secrets[] | select(.secretPath == "/spine/services/auth" and .secretKey == "AUTH_DATABASE_URL") | .secretValue')
AUTH_API_KEY=$(echo "$SECRETS_JSON" | jq -r '.secrets[] | select(.secretPath == "/spine/services/auth" and .secretKey == "AUTH_API_KEY") | .secretValue')
CUSTOMER_JWT_SECRET=$(echo "$SECRETS_JSON" | jq -r '.secrets[] | select(.secretPath == "/spine/services/auth" and .secretKey == "CUSTOMER_JWT_SECRET") | .secretValue')
ADMIN_JWT_SECRET=$(echo "$SECRETS_JSON" | jq -r '.secrets[] | select(.secretPath == "/spine/services/auth" and .secretKey == "ADMIN_JWT_SECRET") | .secretValue')
EMPLOYEE_JWT_SECRET=$(echo "$SECRETS_JSON" | jq -r '.secrets[] | select(.secretPath == "/spine/services/auth" and .secretKey == "EMPLOYEE_JWT_SECRET") | .secretValue')

# Verify all secrets retrieved
if [[ -z "$AUTH_DATABASE_URL" || -z "$AUTH_API_KEY" || -z "$CUSTOMER_JWT_SECRET" || -z "$ADMIN_JWT_SECRET" || -z "$EMPLOYEE_JWT_SECRET" ]]; then
  echo "ERROR: Failed to retrieve all auth secrets from Infisical" >&2
  exit 1
fi

# Generate the env file content
ENV_CONTENT=$(cat <<EOF
# DO NOT EDIT THIS FILE MANUALLY
# This file is MACHINE-GENERATED from Infisical (infrastructure/prod /spine/services/auth)
# Source of truth: Infisical
# Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Regenerate via: cd ~/code/agentic-spine && ./ops/plugins/domains/mint/bin/mint-auth-secrets-sync

# Auth service secrets
AUTH_DATABASE_URL="${AUTH_DATABASE_URL}"
AUTH_API_KEY="${AUTH_API_KEY}"
CUSTOMER_JWT_SECRET="${CUSTOMER_JWT_SECRET}"
ADMIN_JWT_SECRET="${ADMIN_JWT_SECRET}"
EMPLOYEE_JWT_SECRET="${EMPLOYEE_JWT_SECRET}"
EOF
)

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "DRY RUN: Would generate /opt/stacks/mint-apps/.env.auth-secrets with:"
  echo "  - 5 auth secret keys"
  echo "  - mode 600"
  echo "  - clear non-authoritative header"
  exit 0
fi

# Write to mint-apps via SSH
echo "Writing /opt/stacks/mint-apps/.env.auth-secrets via ${MINT_APPS_PATH}..."
ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "cat > /opt/stacks/mint-apps/.env.auth-secrets" <<< "$ENV_CONTENT"

# Set restrictive permissions
ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "chmod 600 /opt/stacks/mint-apps/.env.auth-secrets"

# Verify
echo "Verifying file..."
FILE_SIZE=$(ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "wc -c < /opt/stacks/mint-apps/.env.auth-secrets")
FILE_PERMS=$(ssh "${SSH_OPTS[@]}" -p "$MINT_APPS_PORT" "${MINT_APPS_USER}@${MINT_APPS_HOST}" "stat -c %a /opt/stacks/mint-apps/.env.auth-secrets 2>/dev/null || stat -f %A /opt/stacks/mint-apps/.env.auth-secrets")

echo "✅ Auth secrets synced to mint-apps"
echo "   File: /opt/stacks/mint-apps/.env.auth-secrets"
echo "   Size: ${FILE_SIZE} bytes"
echo "   Permissions: ${FILE_PERMS}"
echo "   Keys: AUTH_DATABASE_URL, AUTH_API_KEY, CUSTOMER_JWT_SECRET, ADMIN_JWT_SECRET, EMPLOYEE_JWT_SECRET"
