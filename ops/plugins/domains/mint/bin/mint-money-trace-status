#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"
SSH_BINDING="$SPINE_ROOT/ops/bindings/ssh.targets.yaml"
MINT_HEALTH_SURFACE="$SPINE_ROOT/ops/lib/mint-health-surface.sh"

# shellcheck source=/dev/null
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"
# shellcheck source=/dev/null
source "$MINT_HEALTH_SURFACE"

usage() {
  cat <<'EOF'
Usage:
  mint-money-trace-status [--brief|--json]

Environment overrides for tests/local proofs:
  MINT_FINANCE_ADAPTER_BASE_URL
  MINT_FINANCE_ADAPTER_API_KEY
  MINT_SHIPPING_BASE_URL
  MINT_SHIPPING_API_KEY
EOF
}

stop() {
  echo "STOP (2): $*" >&2
  exit 2
}

command -v curl >/dev/null 2>&1 || stop "missing dependency: curl"
command -v jq >/dev/null 2>&1 || stop "missing dependency: jq"
command -v yq >/dev/null 2>&1 || stop "missing dependency: yq"
command -v ssh >/dev/null 2>&1 || stop "missing dependency: ssh"
[[ -f "$SSH_BINDING" ]] || stop "missing binding: $SSH_BINDING"
[[ -f "$MINT_HEALTH_SURFACE" ]] || stop "missing helper: $MINT_HEALTH_SURFACE"

MODE="full"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --brief) MODE="brief"; shift ;;
    --json) MODE="json"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) stop "unknown argument: $1" ;;
  esac
done

container_env_value() {
  local container="$1" key="$2"
  ssh "${SSH_OPTS[@]}" "${APP_USER}@${APP_SSH_HOST}" \
    "docker inspect $container --format '{{range .Config.Env}}{{println .}}{{end}}' | awk -F= -v K='$key' '\$1==K{sub(\$1\"=\",\"\"); print; exit}'"
}

SSH_OPTS=(-o ConnectTimeout=6 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR)
APP_TARGET_ID="$(mint_probe_target_id app_plane)"
APP_USER="$(ssh_resolve_user "$APP_TARGET_ID" "ubuntu")"
IFS=' ' read -r APP_SSH_HOST APP_SSH_PATH <<< "$(ssh_resolve_ssh_host_with_fallback "$APP_TARGET_ID" 5 || true)"

FINANCE_BASE_URL="${MINT_FINANCE_ADAPTER_BASE_URL:-$(mint_service_resolved_base_url finance-adapter 5)}"
SHIPPING_BASE_URL="${MINT_SHIPPING_BASE_URL:-$(mint_service_resolved_base_url shipping 5)}"
FINANCE_API_KEY="${MINT_FINANCE_ADAPTER_API_KEY:-}"
SHIPPING_API_KEY="${MINT_SHIPPING_API_KEY:-}"

if [[ -z "$FINANCE_API_KEY" ]]; then
  [[ -n "$APP_SSH_HOST" && "$APP_SSH_PATH" != "unreachable" ]] || stop "unable to resolve mint-apps ssh host"
  FINANCE_API_KEY="$(container_env_value finance-adapter API_KEY)"
fi
if [[ -z "$SHIPPING_API_KEY" ]]; then
  [[ -n "$APP_SSH_HOST" && "$APP_SSH_PATH" != "unreachable" ]] || stop "unable to resolve mint-apps ssh host"
  SHIPPING_API_KEY="$(container_env_value shipping API_KEY)"
fi

[[ -n "$FINANCE_BASE_URL" ]] || stop "unable to resolve finance-adapter base url"
[[ -n "$SHIPPING_BASE_URL" ]] || stop "unable to resolve shipping base url"
[[ -n "$FINANCE_API_KEY" ]] || stop "missing finance-adapter API key"
[[ -n "$SHIPPING_API_KEY" ]] || stop "missing shipping API key"

finance_report="$(
  curl -fsS -m 20 -X POST \
    -H "x-api-key: $FINANCE_API_KEY" \
    "$FINANCE_BASE_URL/api/v1/finance/reconcile"
)"
shipping_history="$(
  curl -fsS -m 20 \
    -H "x-api-key: $SHIPPING_API_KEY" \
    "$SHIPPING_BASE_URL/api/v1/shipping/history?page=1&limit=100"
)"

finance_status="$(jq -r '.status // "UNKNOWN"' <<<"$finance_report")"
orphaned_firefly="$(jq -r '.orphaned_firefly // 0' <<<"$finance_report")"
failed_exhausted="$(jq -r '.failed_exhausted // 0' <<<"$finance_report")"
payment_checked="$(jq -r '.payment_trace.checked // 0' <<<"$finance_report")"
payment_converged="$(jq -r '.payment_trace.converged // 0' <<<"$finance_report")"
payment_drifted="$(jq -r '.payment_trace.drifted // 0' <<<"$finance_report")"
payment_skipped="$(jq -r '.payment_trace.skipped_cancelled // 0' <<<"$finance_report")"
shipping_submitted="$(jq '[.labels[]? | select(.refund_status == "submitted")] | length' <<<"$shipping_history")"
shipping_settled="$(jq '[.labels[]? | select((.refund_status // "") != "" and .refund_status != "submitted")] | length' <<<"$shipping_history")"

overall_status="ok"
if [[ "$finance_status" != "CLEAN" || "$payment_drifted" != "0" || "$shipping_submitted" != "0" ]]; then
  overall_status="fail"
elif [[ "$orphaned_firefly" != "0" ]]; then
  overall_status="warn"
fi

json_payload="$(
  jq -cn \
    --arg capability "mint.money.trace.status" \
    --arg status "$overall_status" \
    --arg finance_status "$finance_status" \
    --argjson orphaned_firefly "$orphaned_firefly" \
    --argjson failed_exhausted "$failed_exhausted" \
    --argjson payment_checked "$payment_checked" \
    --argjson payment_converged "$payment_converged" \
    --argjson payment_drifted "$payment_drifted" \
    --argjson payment_skipped "$payment_skipped" \
    --argjson shipping_submitted "$shipping_submitted" \
    --argjson shipping_settled "$shipping_settled" \
    '{
      capability: $capability,
      status: $status,
      finance: {
        status: $finance_status,
        orphaned_firefly: $orphaned_firefly,
        failed_exhausted: $failed_exhausted,
        payment_trace: {
          checked: $payment_checked,
          converged: $payment_converged,
          drifted: $payment_drifted,
          skipped_cancelled: $payment_skipped
        }
      },
      shipping_refunds: {
        submitted: $shipping_submitted,
        settled: $shipping_settled
      }
    }'
)"

case "$MODE" in
  json)
    printf '%s\n' "$json_payload"
    ;;
  brief)
    printf 'status=%s finance=%s failed_exhausted=%s payment_checked=%s payment_converged=%s payment_drifted=%s shipping_submitted=%s shipping_settled=%s orphaned_firefly=%s\n' \
      "$overall_status" "$finance_status" "$failed_exhausted" "$payment_checked" "$payment_converged" "$payment_drifted" "$shipping_submitted" "$shipping_settled" "$orphaned_firefly"
    ;;
  *)
    echo "mint.money.trace.status"
    echo "status: $overall_status"
    echo "finance_status: $finance_status"
    echo "failed_exhausted: $failed_exhausted"
    echo "payment_trace_checked: $payment_checked"
    echo "payment_trace_converged: $payment_converged"
    echo "payment_trace_drifted: $payment_drifted"
    echo "payment_trace_skipped_cancelled: $payment_skipped"
    echo "shipping_refunds_submitted: $shipping_submitted"
    echo "shipping_refunds_settled: $shipping_settled"
    echo "orphaned_firefly: $orphaned_firefly"
    ;;
esac
