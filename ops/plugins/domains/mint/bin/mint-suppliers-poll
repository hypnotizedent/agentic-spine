#!/usr/bin/env bash
# mint.suppliers.poll — producer-host orchestrator (PACKET-1398).
#
# Pipes the mint-modules witness builder (which captures
# mint.runtime.proof stdout, parses suppliers.* rows, and emits the
# canonical witness yaml) into the spine writer cap mint.suppliers.witness
# (canonical-routed). Mint format / parsing / yaml shape live in
# mint-modules per the L3 product-vs-spine boundary; this script knows
# only "run the Mint side, pipe its yaml output to the spine writer."
#
# Witness boundary: this script does NOT inspect or interpret the
# yaml. It only orchestrates the two surfaces.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
OPS="$REPO_ROOT/bin/ops"
MINT_MODULES_ROOT="${MINT_MODULES_ROOT:-$HOME/code/mint-modules}"
MINT_WITNESS_BUILDER="$MINT_MODULES_ROOT/scripts/ops/suppliers-witness.py"

if [[ "${1:-}" == "--self-check" ]]; then
    [[ -x "$OPS" ]] || { echo "mint.suppliers.poll self-check FAIL: bin/ops" >&2; exit 1; }
    "$OPS" cap show mint.suppliers.witness >/dev/null 2>&1 \
        || { echo "mint.suppliers.poll self-check FAIL: cap show mint.suppliers.witness" >&2; exit 1; }
    # mint-modules builder presence is host-conditional (only on the
    # operator workstation); just check the path expectation is recorded.
    echo "mint.suppliers.poll self-check PASS"
    exit 0
fi

if [[ ! -x "$MINT_WITNESS_BUILDER" ]]; then
    echo "mint.suppliers.poll FAIL: mint-modules witness builder not executable at $MINT_WITNESS_BUILDER" >&2
    echo "  Run mint.suppliers.poll from the operator workstation where mint-modules is checked out." >&2
    exit 1
fi

"$MINT_WITNESS_BUILDER" | "$OPS" cap run mint.suppliers.witness "$@"
