#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/plugins/domains/mint/lib/mint-operator-storage-common.sh"

MINT_OPERATOR_ASSIST_RCLONE_BIN="${MINT_OPERATOR_ASSIST_RCLONE_BIN:-${RCLONE_BIN:-rclone}}"
MINT_OPERATOR_ASSIST_OSASCRIPT_BIN="${MINT_OPERATOR_ASSIST_OSASCRIPT_BIN:-osascript}"
MINT_OPERATOR_ASSIST_TRASH_STRATEGY="${MINT_OPERATOR_ASSIST_TRASH_STRATEGY:-finder_trash}"
MINT_OPERATOR_ASSIST_TRASH_ROOT="${MINT_OPERATOR_ASSIST_TRASH_ROOT:-$HOME/.Trash}"

assist_usage() {
  cat <<'EOF'
mint.operator.drop.assist

Usage:
  mint-operator-drop-assist move [--preview] [--keep-source] [PATH ...]
  mint-operator-drop-assist open
  mint-operator-drop-assist status

Notes:
  - The canonical destination stays MinIO artwork-intake/operator-drop
  - This surface uploads directly to MinIO instead of writing through ~/MinIO
  - Accepted source entries are directories only
EOF
}

assist_fail() {
  echo "mint.operator.drop.assist FAIL: $*" >&2
  exit 1
}

assist_timestamp() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

assist_receipt_id() {
  date -u +"MINT-DROP-%Y%m%dT%H%M%SZ-$PPID-$RANDOM"
}

assist_path_in_tree() {
  local path_a="$1"
  local path_b="$2"
  [[ "$path_a" == "$path_b" || "$path_a" == "$path_b/"* ]]
}

assist_absolute_path() {
  local raw="$1"
  (cd "$(dirname "$raw")" && printf '%s/%s\n' "$(pwd)" "$(basename "$raw")")
}

assist_unique_path() {
  local target="$1"
  if [[ ! -e "$target" ]]; then
    printf '%s\n' "$target"
    return 0
  fi

  local dir base name ext candidate idx
  dir="$(dirname "$target")"
  base="$(basename "$target")"
  name="$base"
  ext=""
  if [[ "$base" == *.* && "$base" != .* ]]; then
    name="${base%.*}"
    ext=".${base##*.}"
  fi
  idx=1
  while :; do
    candidate="${dir}/${name}-${idx}${ext}"
    if [[ ! -e "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    idx=$((idx + 1))
  done
}

assist_collect_metrics() {
  local root="$1"
  local count=0
  local bytes=0
  while IFS= read -r -d '' file; do
    count=$((count + 1))
    bytes=$((bytes + $(stat -f '%z' "$file")))
  done < <(find "$root" -type f -print0)
  printf '%s|%s\n' "$count" "$bytes"
}

assist_source_root_allowed() {
  local source_path="$1"
  local raw allowed_root
  local any=0
  while IFS= read -r raw; do
    [[ -n "$raw" ]] || continue
    any=1
    allowed_root="$(mint_operator_expand_path "$raw")"
    assist_path_in_tree "$source_path" "$allowed_root" && return 0
  done < <(mint_operator_contract_list '.assisted_move_surface.allowed_source_roots')

  if [[ "$any" -eq 0 ]]; then
    return 0
  fi
  return 1
}

assist_rclone_base_args() {
  printf '%s\0' \
    --contimeout "$MINT_OPERATOR_CONTIMEOUT" \
    --timeout "$MINT_OPERATOR_TIMEOUT" \
    --retries "$MINT_OPERATOR_RETRIES" \
    --low-level-retries "$MINT_OPERATOR_LOW_LEVEL_RETRIES"
}

assist_rclone_run() {
  local -a base_args
  mapfile -d '' -t base_args < <(assist_rclone_base_args)
  "$MINT_OPERATOR_ASSIST_RCLONE_BIN" "$@" "${base_args[@]}"
}

assist_remote_path_exists() {
  local remote_path="$1"
  local listing=""
  listing="$(assist_rclone_run lsjson "$remote_path" 2>/dev/null | tr -d '[:space:]' || true)"
  [[ -n "$listing" && "$listing" != "[]" ]]
}

assist_remote_purge() {
  local remote_path="$1"
  assist_rclone_run purge "$remote_path" >/dev/null 2>&1 || true
}

assist_verify_remote_parity() {
  local source_dir="$1"
  local remote_dir="$2"
  assist_rclone_run check "$source_dir" "$remote_dir" --one-way --size-only >/dev/null 2>&1
}

assist_write_receipt() {
  local receipt_id="$1"
  local status="$2"
  local source_path="$3"
  local destination_remote="$4"
  local destination_browse="$5"
  local cleanup_action="$6"
  local preview="$7"
  local file_count="$8"
  local total_bytes="$9"

  local receipt_dir="${MINT_OPERATOR_ASSIST_RECEIPT_ROOT}/${receipt_id}"
  mkdir -p "$receipt_dir"
  cat > "${receipt_dir}/receipt.yaml" <<EOF
receipt_id: ${receipt_id}
status: ${status}
generated_at: $(assist_timestamp)
source_path: ${source_path}
destination_remote: ${destination_remote}
destination_browse_path: ${destination_browse}
cleanup_action: ${cleanup_action}
preview: ${preview}
file_count: ${file_count}
total_bytes: ${total_bytes}
verification_method: ${MINT_OPERATOR_ASSIST_VERIFICATION_METHOD}
EOF
}

assist_trash_source() {
  local source_path="$1"

  case "$MINT_OPERATOR_ASSIST_TRASH_STRATEGY" in
    keep)
      return 0
      ;;
    trash_dir)
      mkdir -p "$MINT_OPERATOR_ASSIST_TRASH_ROOT"
      local trash_target
      trash_target="$(assist_unique_path "${MINT_OPERATOR_ASSIST_TRASH_ROOT}/$(basename "$source_path")")"
      mv "$source_path" "$trash_target"
      return 0
      ;;
    finder_trash)
      if command -v "$MINT_OPERATOR_ASSIST_OSASCRIPT_BIN" >/dev/null 2>&1; then
        if "$MINT_OPERATOR_ASSIST_OSASCRIPT_BIN" - "$source_path" >/dev/null 2>&1 <<'EOF'
on run argv
  tell application "Finder"
    delete POSIX file (item 1 of argv)
  end tell
end run
EOF
        then
          return 0
        fi
      fi
      ;;
  esac

  mkdir -p "$MINT_OPERATOR_ASSIST_TRASH_ROOT"
  local fallback_target
  fallback_target="$(assist_unique_path "${MINT_OPERATOR_ASSIST_TRASH_ROOT}/$(basename "$source_path")")"
  mv "$source_path" "$fallback_target"
}

assist_require_remote_ready() {
  mint_operator_storage_require_contract
  mint_operator_storage_load_contract

  command -v "$MINT_OPERATOR_ASSIST_RCLONE_BIN" >/dev/null 2>&1 || assist_fail "missing required tool: ${MINT_OPERATOR_ASSIST_RCLONE_BIN}"
  mint_operator_storage_remote_ok || assist_fail "remote ${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_HEALTH_PROBE_PATH} is not reachable"
}

assist_move_one() {
  local source_path="$1"
  local preview="$2"
  local keep_source="$3"

  [[ -d "$source_path" ]] || assist_fail "source must be an existing directory: ${source_path}"
  source_path="$(assist_absolute_path "$source_path")"
  assist_source_root_allowed "$source_path" || assist_fail "source is outside allowed assisted-move roots: ${source_path}"
  assist_path_in_tree "$source_path" "$MINT_OPERATOR_MOUNTPOINT" && assist_fail "source cannot live under the MinIO mount root: ${source_path}"

  local folder_name destination_remote staging_remote destination_browse metrics file_count total_bytes receipt_id cleanup_action
  folder_name="$(basename "$source_path")"
  destination_remote="${MINT_OPERATOR_ASSIST_REMOTE_DESTINATION}/${folder_name}"
  staging_remote="${MINT_OPERATOR_REMOTE}:${MINT_OPERATOR_ASSIST_REMOTE_STAGING_PREFIX}/${folder_name}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  destination_browse="${MINT_OPERATOR_CANONICAL_DROP_BROWSE_ROOT}/${folder_name}"
  assist_remote_path_exists "$destination_remote" && assist_fail "destination already exists: ${destination_remote}"

  metrics="$(assist_collect_metrics "$source_path")"
  file_count="${metrics%%|*}"
  total_bytes="${metrics##*|}"
  receipt_id="$(assist_receipt_id)"

  if [[ "$preview" == "1" ]]; then
    assist_write_receipt "$receipt_id" "preview" "$source_path" "$destination_remote" "$destination_browse" "none" "true" "$file_count" "$total_bytes"
    cat <<EOF
preview: ready
source: ${source_path}
destination_remote: ${destination_remote}
destination_browse_path: ${destination_browse}
file_count: ${file_count}
total_bytes: ${total_bytes}
cleanup_policy: ${MINT_OPERATOR_ASSIST_CLEANUP_POLICY}
receipt: ${MINT_OPERATOR_ASSIST_RECEIPT_ROOT}/${receipt_id}/receipt.yaml
EOF
    return 0
  fi

  assist_rclone_run copy "$source_path" "$staging_remote"
  if ! assist_verify_remote_parity "$source_path" "$staging_remote"; then
    assist_remote_purge "$staging_remote"
    assist_fail "staging verification failed: ${source_path} -> ${staging_remote}"
  fi

  assist_rclone_run copy "$staging_remote" "$destination_remote"
  if ! assist_verify_remote_parity "$source_path" "$destination_remote"; then
    assist_remote_purge "$staging_remote"
    assist_remote_purge "$destination_remote"
    assist_fail "final verification failed: ${source_path} -> ${destination_remote}"
  fi
  assist_remote_purge "$staging_remote"

  cleanup_action="kept"
  if [[ "$keep_source" != "1" && "$MINT_OPERATOR_ASSIST_CLEANUP_POLICY" == "trash_after_verified_arrival" ]]; then
    assist_trash_source "$source_path"
    cleanup_action="trashed"
  fi

  assist_write_receipt "$receipt_id" "moved" "$source_path" "$destination_remote" "$destination_browse" "$cleanup_action" "false" "$file_count" "$total_bytes"
  cat <<EOF
status: moved
source: ${source_path}
destination_remote: ${destination_remote}
destination_browse_path: ${destination_browse}
cleanup_action: ${cleanup_action}
file_count: ${file_count}
total_bytes: ${total_bytes}
receipt: ${MINT_OPERATOR_ASSIST_RECEIPT_ROOT}/${receipt_id}/receipt.yaml
EOF
}

assist_open() {
  mint_operator_storage_require_contract
  mint_operator_storage_load_contract
  local mount_payload mount_status
  mount_payload="$(mint_operator_storage_mount_status)"
  mount_status="${mount_payload%%|*}"
  [[ "$mount_status" == "ACTIVE" ]] || assist_fail "browse mount is not active: ${MINT_OPERATOR_MOUNTPOINT}"
  open "$MINT_OPERATOR_CANONICAL_DROP_BROWSE_ROOT"
}

assist_status() {
  exec "$ROOT/ops/plugins/domains/mint/bin/mint-operator-storage-status"
}

main() {
  local command="move"
  local preview=0
  local keep_source=0

  if [[ $# -gt 0 ]]; then
    case "$1" in
      move|open|status)
        command="$1"
        shift
        ;;
      -h|--help|help)
        assist_usage
        exit 0
        ;;
    esac
  fi

  case "$command" in
    open)
      [[ $# -eq 0 ]] || assist_fail "open does not accept source paths"
      assist_open
      ;;
    status)
      [[ $# -eq 0 ]] || assist_fail "status does not accept source paths"
      assist_status
      ;;
  esac

  local -a sources=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --preview)
        preview=1
        shift
        ;;
      --keep-source)
        keep_source=1
        shift
        ;;
      -h|--help|help)
        assist_usage
        exit 0
        ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          sources+=("$1")
          shift
        done
        ;;
      *)
        sources+=("$1")
        shift
        ;;
    esac
  done

  ((${#sources[@]} > 0)) || assist_fail "at least one source directory is required"

  assist_require_remote_ready
  local source
  for source in "${sources[@]}"; do
    assist_move_one "$source" "$preview" "$keep_source"
  done
}

main "$@"
