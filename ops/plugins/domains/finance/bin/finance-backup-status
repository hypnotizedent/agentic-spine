#!/usr/bin/env bash
# Thin exec shim — canonical implementation lives in workbench
# See: agents/finance/spine-plugin-finance/bin/finance-backup-status
set -euo pipefail
export SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
exec "$HOME/code/workbench/agents/finance/spine-plugin-finance/bin/finance-backup-status" "$@"
