#!/usr/bin/env bash
set -euo pipefail
# media-radarr-research — Trigger re-search for a movie in Radarr (mutating bridge)
# Delegates to workbench media-agent tool: search_movie_by_id
# Default: preview mode. Use --apply to execute.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/media-agent-bridge.sh"

usage() {
  echo "Usage: media-radarr-research --movie-id <id> [--apply] [--json]"
  echo ""
  echo "Options:"
  echo "  --movie-id <id>  Radarr movie ID (required)"
  echo "  --apply          Execute the re-search (default: preview only)"
  echo "  --json           Output structured JSON"
}

MOVIE_ID=""
APPLY=false
JSON_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --movie-id) MOVIE_ID="$2"; shift 2 ;;
    --apply) APPLY=true; shift ;;
    --json) JSON_MODE=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -z "$MOVIE_ID" ]]; then
  echo "ERROR: --movie-id is required" >&2
  exit 1
fi

MODE="preview"
[[ "$APPLY" == "true" ]] && MODE="apply"

if [[ "$MODE" == "preview" ]]; then
  if [[ "$JSON_MODE" == "true" ]]; then
    python3 -c "
import json, sys
print(json.dumps({
    'capability': 'media.radarr.research',
    'tool': 'search_movie_by_id',
    'movie_id': int(sys.argv[1]),
    'mode': 'preview',
    'mutation': {'command': 'MoviesSearch', 'movieIds': [int(sys.argv[1])]},
    'text': 'Preview: would trigger MoviesSearch for movie ID ' + sys.argv[1],
    'applied': False,
}, indent=2))
" "$MOVIE_ID"
  else
    echo "=== PREVIEW: media.radarr.research ==="
    echo "Mode:         preview (use --apply to execute)"
    echo "Movie ID:     $MOVIE_ID"
    echo "Target Tool:  search_movie_by_id"
    echo "Mutation:     POST /command {name: MoviesSearch, movieIds: [$MOVIE_ID]}"
  fi
  exit 0
fi

# Apply mode
ARGS_JSON=$(python3 -c "import json,sys; print(json.dumps({'movieId': int(sys.argv[1])}))" "$MOVIE_ID")

RESULT=$(media_agent_call "search_movie_by_id" "$ARGS_JSON") || {
  echo "FAIL: bridge call failed" >&2
  [[ -n "${RESULT:-}" ]] && echo "$RESULT" >&2
  exit 1
}

if [[ "$JSON_MODE" == "true" ]]; then
  python3 -c "
import json, sys
text = sys.stdin.read().strip()
print(json.dumps({
    'capability': 'media.radarr.research',
    'tool': 'search_movie_by_id',
    'movie_id': int(sys.argv[1]),
    'mode': 'apply',
    'text': text,
    'applied': True,
}, indent=2))
" "$MOVIE_ID" <<< "$RESULT"
else
  echo "=== APPLIED: media.radarr.research ==="
  echo "$RESULT"
fi
