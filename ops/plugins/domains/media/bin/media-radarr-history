#!/usr/bin/env bash
set -euo pipefail
# media-radarr-history — Get movie history from Radarr (read-only bridge)
# Delegates to workbench media-agent tool: get_movie_history
# If --title given, resolves movieId via get_movie_details first

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/media-agent-bridge.sh"

usage() {
  echo "Usage: media-radarr-history (--movie-id <id> | --title <text>) [--json]"
  echo ""
  echo "Options:"
  echo "  --movie-id <id>  Radarr movie ID"
  echo "  --title <text>   Movie title (resolves to ID first)"
  echo "  --json           Output structured JSON"
}

MOVIE_ID=""
TITLE=""
JSON_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --movie-id) MOVIE_ID="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --json) JSON_MODE=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -z "$MOVIE_ID" && -z "$TITLE" ]]; then
  echo "ERROR: --movie-id or --title is required" >&2
  exit 1
fi

# If title given, resolve to movieId first
if [[ -z "$MOVIE_ID" && -n "$TITLE" ]]; then
  LOOKUP_ARGS=$(python3 -c "import json,sys; print(json.dumps({'title': sys.argv[1]}))" "$TITLE")
  LOOKUP_RESULT=$(media_agent_call "get_movie_details" "$LOOKUP_ARGS") || {
    echo "FAIL: could not resolve title to movie ID" >&2
    exit 1
  }
  # Extract movieId from the lookup result text
  # The get_movie_details handler returns markdown with "ID: <number>" in it
  MOVIE_ID=$(echo "$LOOKUP_RESULT" | python3 -c "
import sys, re
text = sys.stdin.read()
# Try to find 'ID: <number>' pattern in the response
match = re.search(r'\bID:\s*(\d+)', text)
if match:
    print(match.group(1))
else:
    # Try to find movie not found
    if 'not found' in text.lower():
        print('ERROR: ' + text.strip(), file=sys.stderr)
        sys.exit(1)
    print('', file=sys.stderr)
    sys.exit(1)
") || {
    echo "FAIL: could not extract movie ID from title lookup" >&2
    echo "$LOOKUP_RESULT" >&2
    exit 1
  }
fi

ARGS_JSON=$(python3 -c "import json,sys; print(json.dumps({'movieId': int(sys.argv[1])}))" "$MOVIE_ID")

RESULT=$(media_agent_call "get_movie_history" "$ARGS_JSON") || {
  echo "FAIL: bridge call failed" >&2
  [[ -n "${RESULT:-}" ]] && echo "$RESULT" >&2
  exit 1
}

if [[ "$JSON_MODE" == "true" ]]; then
  python3 -c "
import json, sys
text = sys.stdin.read().strip()
obj = {
    'capability': 'media.radarr.history',
    'tool': 'get_movie_history',
    'arguments': {'movieId': int(sys.argv[1])},
    'text': text,
}
if sys.argv[2]:
    obj['resolved_from_title'] = sys.argv[2]
print(json.dumps(obj, indent=2))
" "$MOVIE_ID" "$TITLE" <<< "$RESULT"
else
  echo "$RESULT"
fi
