#!/usr/bin/env bash
# media.scene.rename — diagnose and fix scene-named TV episodes via Sonarr rename API
#
# Usage:
#   ./bin/ops cap run media.scene.rename                    # diagnostic (read-only)
#   ./bin/ops cap run media.scene.rename -- --execute       # trigger renames
#   ./bin/ops cap run media.scene.rename -- --series "Bones"  # single series
#   ./bin/ops cap run media.scene.rename -- --json          # JSON output
#
# Contract:
# - Default mode is READ-ONLY diagnostic (shows what Sonarr WOULD rename)
# - --execute triggers Sonarr RenameFiles command (mutating)
# - Uses canonical media-api-resolve for Sonarr API key
# - Uses ssh-resolve.sh for media-home host resolution
# - Exit 0 if diagnostic clean or renames triggered, exit 1 on errors

set -euo pipefail

SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"

source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

EXECUTE=false
TARGET_SERIES=""
OUTPUT_JSON=false
TIMEOUT_SEC=15

while [[ $# -gt 0 ]]; do
  case "$1" in
    --execute)  EXECUTE=true; shift ;;
    --series)   TARGET_SERIES="${2:-}"; shift 2 ;;
    --json)     OUTPUT_JSON=true; shift ;;
    --timeout)  TIMEOUT_SEC="${2:-15}"; shift 2 ;;
    -h|--help)
      echo "media.scene.rename — diagnose and fix scene-named TV episodes"
      echo "  (default)    Read-only diagnostic — shows what Sonarr would rename"
      echo "  --execute    Trigger Sonarr rename for all renameable episodes"
      echo "  --series N   Target a single series by title"
      echo "  --json       JSON output"
      echo "  --timeout N  SSH timeout (default: 15)"
      exit 0 ;;
    --)         shift ;;
    *)          echo "FAIL: unknown arg: $1" >&2; exit 1 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }

# Resolve media-home
RESOLVE_RESULT="$(ssh_resolve_host_with_fallback "media-home" 2>/dev/null || true)"
MEDIA_IP="${RESOLVE_RESULT%% *}"
if [[ -z "$MEDIA_IP" ]]; then
  echo "FAIL: Cannot reach media-home" >&2
  exit 2
fi

# Resolve Sonarr API key via canonical resolver
SONARR_KEY=$("$SPINE_ROOT/ops/plugins/domains/media/bin/media-api-resolve" sonarr 2>/dev/null || echo "")
if [[ -z "$SONARR_KEY" ]]; then
  echo "FAIL: Could not resolve Sonarr API key" >&2
  exit 2
fi

SONARR_API="http://localhost:8989/api/v3"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
SSH_TARGET="ubuntu@${MEDIA_IP}"

# Helper: run curl on media-home via SSH, strip control chars
sonarr_get() {
  local endpoint="$1"
  ssh -n -o ConnectTimeout="$TIMEOUT_SEC" -o BatchMode=yes "$SSH_TARGET" \
    "curl -sf '${SONARR_API}${endpoint}' -H 'X-Api-Key: $SONARR_KEY'" 2>/dev/null \
    | tr -d '\000-\037'
}

sonarr_post() {
  local endpoint="$1" body="$2"
  ssh -n -o ConnectTimeout="$TIMEOUT_SEC" -o BatchMode=yes "$SSH_TARGET" \
    "curl -sf -X POST '${SONARR_API}${endpoint}' -H 'X-Api-Key: $SONARR_KEY' -H 'Content-Type: application/json' -d '$body'" 2>/dev/null \
    | tr -d '\000-\037'
}

echo "=== SCENE RENAME DIAGNOSTIC ==="
echo "Date: $GENERATED_AT"
echo "Target: media-home ($MEDIA_IP)"
if [[ "$EXECUTE" == "true" ]]; then
  echo "Mode: EXECUTE (will trigger renames)"
else
  echo "Mode: DIAGNOSTIC (read-only)"
fi
echo ""

# Use temp files for large JSON payloads
TMPDIR_SCENE=$(mktemp -d)
trap 'rm -rf "$TMPDIR_SCENE"' EXIT

# Get all series into temp file
sonarr_get "/series" > "$TMPDIR_SCENE/series.json"
if [[ ! -s "$TMPDIR_SCENE/series.json" ]]; then
  echo "FAIL: Could not fetch series list from Sonarr" >&2
  exit 2
fi

# Build series list (filter by target if specified)
if [[ -n "$TARGET_SERIES" ]]; then
  jq -r --arg t "$TARGET_SERIES" \
    '.[] | select(.title == $t or (.title | ascii_downcase) == ($t | ascii_downcase)) | "\(.id)\t\(.title)"' \
    "$TMPDIR_SCENE/series.json" > "$TMPDIR_SCENE/series_list.tsv"
  if [[ ! -s "$TMPDIR_SCENE/series_list.tsv" ]]; then
    echo "FAIL: Series '$TARGET_SERIES' not found in Sonarr" >&2
    exit 1
  fi
else
  jq -r '.[] | "\(.id)\t\(.title)"' "$TMPDIR_SCENE/series.json" > "$TMPDIR_SCENE/series_list.tsv"
fi

TOTAL_SERIES=0
SERIES_WITH_RENAMES=0
TOTAL_RENAMEABLE=0
TOTAL_CHECKED=0
JSON_ENTRIES=""

while IFS=$'\t' read -r SERIES_ID SERIES_TITLE; do
  [[ -z "$SERIES_ID" ]] && continue
  TOTAL_SERIES=$((TOTAL_SERIES + 1))

  # Get rename preview for this series
  sonarr_get "/rename?seriesId=$SERIES_ID" > "$TMPDIR_SCENE/rename.json" 2>/dev/null
  RENAME_COUNT=$(jq 'length' "$TMPDIR_SCENE/rename.json" 2>/dev/null || echo "0")

  if [[ "$RENAME_COUNT" -gt 0 ]]; then
    SERIES_WITH_RENAMES=$((SERIES_WITH_RENAMES + 1))
    TOTAL_RENAMEABLE=$((TOTAL_RENAMEABLE + RENAME_COUNT))

    # Get episode file count
    sonarr_get "/episodefile?seriesId=$SERIES_ID" > "$TMPDIR_SCENE/epfiles.json" 2>/dev/null
    EP_COUNT=$(jq 'length' "$TMPDIR_SCENE/epfiles.json" 2>/dev/null || echo "?")

    # Sample rename
    SAMPLE=$(jq -r '.[0] | "\(.existingPath | split("/") | last) → \(.newPath | split("/") | last)"' "$TMPDIR_SCENE/rename.json" 2>/dev/null || echo "?")

    echo "Series: $SERIES_TITLE (Sonarr ID: $SERIES_ID)"
    echo "  Episodes on disk: $EP_COUNT"
    echo "  Sonarr would rename: $RENAME_COUNT"
    echo "  Sample: $SAMPLE"

    if [[ "$EXECUTE" == "true" ]]; then
      # Collect file IDs
      FILE_IDS=$(jq -r '[.[].episodeFileId] | join(",")' "$TMPDIR_SCENE/rename.json" 2>/dev/null)
      if [[ -n "$FILE_IDS" ]]; then
        CMD_BODY="{\"name\":\"RenameFiles\",\"seriesId\":$SERIES_ID,\"files\":[$FILE_IDS]}"
        CMD_RESULT=$(sonarr_post "/command" "$CMD_BODY")
        CMD_ID=$(echo "$CMD_RESULT" | jq -r '.id // "unknown"' 2>/dev/null)
        echo "  RENAME TRIGGERED: command ID $CMD_ID ($RENAME_COUNT files)"
      else
        echo "  SKIP: could not extract file IDs"
      fi
    fi
    echo ""

    if [[ "$OUTPUT_JSON" == "true" ]]; then
      ENTRY=$(jq -n --arg t "$SERIES_TITLE" --argjson id "$SERIES_ID" \
        --arg ep "$EP_COUNT" --argjson rc "$RENAME_COUNT" --arg s "$SAMPLE" \
        '{title: $t, sonarr_id: $id, episodes_on_disk: ($ep | tonumber? // $ep), would_rename: $rc, sample: $s}')
      JSON_ENTRIES="${JSON_ENTRIES}${ENTRY},"
    fi
  fi

  TOTAL_CHECKED=$((TOTAL_CHECKED + 1))
done < "$TMPDIR_SCENE/series_list.tsv"

echo "SUMMARY:"
echo "  Series checked: $TOTAL_CHECKED"
echo "  Series with renames available: $SERIES_WITH_RENAMES"
echo "  Total episodes renameable: $TOTAL_RENAMEABLE"
if [[ "$EXECUTE" == "true" ]]; then
  echo "  Renames triggered: $TOTAL_RENAMEABLE"
else
  echo "  Run with --execute to trigger renames."
fi

if [[ "$OUTPUT_JSON" == "true" ]]; then
  JSON_ENTRIES="${JSON_ENTRIES%,}"
  cat <<ENDJSON
{
  "capability": "media.scene.rename",
  "generated_at": "$GENERATED_AT",
  "target": "media-home",
  "mode": "$(if [[ "$EXECUTE" == "true" ]]; then echo "execute"; else echo "diagnostic"; fi)",
  "series_checked": $TOTAL_CHECKED,
  "series_with_renames": $SERIES_WITH_RENAMES,
  "total_renameable": $TOTAL_RENAMEABLE,
  "series": [$JSON_ENTRIES]
}
ENDJSON
fi

exit 0
