#!/usr/bin/env bash
# media.queue.reconcile.lidarr — Deterministic queue reconciliation for Lidarr
#
# Usage (via spine):
#   ./bin/ops cap run media.queue.reconcile.lidarr
#   ./bin/ops cap run media.queue.reconcile.lidarr -- --apply
#   ./bin/ops cap run media.queue.reconcile.lidarr -- --json
#
# Contract:
# - Implements MEDIA_QUEUE_RECONCILIATION_POLICY_V1 for Lidarr
# - Reads Lidarr queue via API, classifies items per policy
# - Auto-removes QUEUE-C1 and QUEUE-C4 items (safe: tracks exist)
# - Reports QUEUE-C2, QUEUE-C3, QUEUE-C5 items for manual review
# - Default: dry-run mode (no deletions without --apply)
#
# Policy ref: ops/bindings/domains/media/media.queue.reconciliation.policy.yaml

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../../" && pwd)"
MEDIA_BINDINGS_HOME="${MEDIA_BINDINGS_HOME:-$HOME/code/workbench/agents/media/bindings}"
SECRETS_EXEC="$ROOT/ops/plugins/infra/secrets/bin/secrets-exec"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"
POLICY="$MEDIA_BINDINGS_HOME/media.queue.reconciliation.policy.yaml"
SERVICES_BINDING="$ROOT/ops/bindings/services.health.yaml"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Re-exec under secrets injection
if [[ -z "${SPINE_SECRETS_INJECTED:-}" ]]; then
  export SPINE_SECRETS_INJECTED=1
  exec "$SECRETS_EXEC" -- "$0" "$@"
fi

# shellcheck source=ops/lib/ssh-resolve.sh
source "$SSH_RESOLVE" 2>/dev/null || true

usage() {
  cat <<'USAGE'
media.queue.reconcile.lidarr — Deterministic Lidarr queue reconciliation

Args:
  --dry-run    Show what would be removed (default)
  --apply      Actually remove safe queue items (QUEUE-C1, QUEUE-C4)
  --json       Output JSON format
  --batch N    Max items per run (default: 50)

Examples:
  ./bin/ops cap run media.queue.reconcile.lidarr
  ./bin/ops cap run media.queue.reconcile.lidarr -- --apply
  ./bin/ops cap run media.queue.reconcile.lidarr -- --json --dry-run
USAGE
}

DRY_RUN=true
OUTPUT_JSON=false
BATCH_SIZE=50

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)    DRY_RUN=true; shift ;;
    --apply)      DRY_RUN=false; shift ;;
    --json)       OUTPUT_JSON=true; shift ;;
    --batch)      BATCH_SIZE="${2:-50}"; shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift ;;
    *)            echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "MISSING_DEP: curl" >&2; exit 2; }
command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
[[ -f "$SERVICES_BINDING" ]] || { echo "STOP: missing binding $SERVICES_BINDING" >&2; exit 2; }

# Resolve Lidarr endpoint
LIDARR_HOST="${LIDARR_HOST:-}"
LIDARR_URL="${LIDARR_URL:-}"
if [[ -z "$LIDARR_URL" && -z "$LIDARR_HOST" ]]; then
  CANONICAL_LIDARR_URL="$(yq -r '.endpoints[] | select(.id == "lidarr") | .url // ""' "$SERVICES_BINDING" | head -n1)"
  CANONICAL_LIDARR_TARGET="$(yq -r '.endpoints[] | select(.id == "lidarr") | .host // ""' "$SERVICES_BINDING" | head -n1)"
  [[ -n "$CANONICAL_LIDARR_URL" ]] || { echo "STOP: lidarr missing from services.health.yaml" >&2; exit 2; }
  if [[ -n "$CANONICAL_LIDARR_TARGET" ]] && type ssh_resolve_url_with_fallback &>/dev/null; then
    LIDARR_URL="$(ssh_resolve_url_with_fallback "$CANONICAL_LIDARR_URL" "$CANONICAL_LIDARR_TARGET" 5 2>/dev/null | awk '{print $1}')"
  fi
  [[ -z "$LIDARR_URL" ]] && LIDARR_URL="$CANONICAL_LIDARR_URL"
fi
if [[ -z "$LIDARR_URL" ]]; then
  LIDARR_PORT="${LIDARR_PORT:-8686}"
  [[ -n "$LIDARR_HOST" ]] || { echo "STOP: LIDARR_HOST unresolved and LIDARR_URL not provided" >&2; exit 2; }
  LIDARR_URL="http://${LIDARR_HOST}:${LIDARR_PORT}"
fi

# Strip /ping suffix if present
LIDARR_URL="$(echo "$LIDARR_URL" | sed 's|/ping$||')"

# API key from secrets injection
LIDARR_API_KEY="${LIDARR_API_KEY:-}"
if [[ -z "$LIDARR_API_KEY" ]]; then
  echo "STOP: LIDARR_API_KEY not available (secrets injection may have failed)" >&2
  exit 2
fi

# Fetch queue (Lidarr uses API v1)
fetch_queue() {
  curl -sf --max-time 15 \
    -H "X-Api-Key: ${LIDARR_API_KEY}" \
    "${LIDARR_URL}/api/v1/queue?page=1&pageSize=200&includeAlbum=true&includeArtist=true" 2>/dev/null
}

# Delete queue item
delete_queue_item() {
  local queue_id="$1"
  local remove_from_client="${2:-false}"
  if $DRY_RUN; then
    echo "DRY-RUN: would DELETE /api/v1/queue/${queue_id}?removeFromClient=${remove_from_client}" >&2
    return 0
  fi
  curl -sf --max-time 10 -X DELETE \
    -H "X-Api-Key: ${LIDARR_API_KEY}" \
    "${LIDARR_URL}/api/v1/queue/${queue_id}?removeFromClient=${remove_from_client}&blocklist=false" 2>/dev/null
}

# Trigger album search (for C6 auto-remove-and-research)
trigger_album_search() {
  local album_id="$1"
  if $DRY_RUN; then
    echo "DRY-RUN: would trigger AlbumSearch for album ${album_id}" >&2
    return 0
  fi
  curl -sf --max-time 10 -X POST \
    -H "X-Api-Key: ${LIDARR_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"AlbumSearch\",\"albumIds\":[${album_id}]}" \
    "${LIDARR_URL}/api/v1/command" 2>/dev/null >/dev/null
}

# Main reconciliation logic
QUEUE_JSON="$(fetch_queue)" || {
  echo "FAIL: cannot reach Lidarr queue API at ${LIDARR_URL}" >&2
  if $OUTPUT_JSON; then
    jq -n --arg ts "$GENERATED_AT" '{capability: "media.queue.reconcile.lidarr", generated_at: $ts, status: "unreachable", error: "Cannot reach Lidarr queue API"}'
  fi
  exit 1
}

TOTAL_RECORDS="$(echo "$QUEUE_JSON" | jq '.totalRecords // 0')"
if [[ "$TOTAL_RECORDS" -eq 0 ]]; then
  if $OUTPUT_JSON; then
    jq -n --arg ts "$GENERATED_AT" '{capability: "media.queue.reconcile.lidarr", generated_at: $ts, status: "clean", total_queue_items: 0, classifications: {}, actions: []}'
  else
    echo "media.queue.reconcile.lidarr"
    echo "============================"
    echo "status: clean"
    echo "total_queue_items: 0"
    echo "generated_at: $GENERATED_AT"
  fi
  exit 0
fi

# C6 age threshold (hours) — items older than this with no files are auto-removed + re-searched
NOW_EPOCH="$(date -u +%s)"
STALE_IMPORT_THRESHOLD_HOURS=48

# Classify each queue item per policy
# Lidarr: has_file is approximated by album.statistics.trackFileCount > 0
CLASSIFICATIONS="$(echo "$QUEUE_JSON" | jq --argjson batch "$BATCH_SIZE" --argjson now "$NOW_EPOCH" --argjson stale_h "$STALE_IMPORT_THRESHOLD_HOURS" '
  def parse_added_utc:
    (sub("Z$"; "") | split(".")[0] + "Z" | fromdateiso8601);
  [.records[:$batch][] | {
    queue_id: .id,
    artist_id: (.artistId // null),
    album_id: (.albumId // null),
    title: (.title // .album.title // "unknown"),
    artist_name: (.artist.artistName // "unknown"),
    album_title: (.album.title // "unknown"),
    status: (.status // "unknown"),
    tracked_status: (.trackedDownloadStatus // "unknown"),
    tracked_state: (.trackedDownloadState // "unknown"),
    has_file: ((.album.statistics.trackFileCount // 0) > 0),
    track_file_count: (.album.statistics.trackFileCount // 0),
    error_message: (.errorMessage // null),
    added: (.added // null),
    age_hours: (if .added then (($now - (.added | parse_added_utc)) / 3600 | floor) else null end)
  } | . + {
    classification: (
      if (.status == "downloadClientUnavailable" or .trackedDownloadStatus == "downloadClientUnavailable") and .has_file then "QUEUE-C1"
      elif (.status == "downloadClientUnavailable" or .trackedDownloadStatus == "downloadClientUnavailable") and (.has_file | not) then "QUEUE-C2"
      elif (.has_file | not) and (.age_hours != null and .age_hours >= $stale_h) and (.tracked_state == "importPending" or .trackedDownloadStatus == "warning" or (.error_message != null and (.error_message | test("match"; "i")))) then "QUEUE-C6"
      elif (.status == "warning" or .trackedDownloadStatus == "warning") and (.has_file | not) then "QUEUE-C3"
      elif (.status == "completed" or .trackedDownloadState == "importPending") and .has_file then "QUEUE-C4"
      elif (.status == "completed" or .trackedDownloadState == "importPending") and (.has_file | not) then "QUEUE-C5"
      else "UNCLASSIFIED"
      end
    )
  } | . + {
    action: (
      if .classification == "QUEUE-C1" or .classification == "QUEUE-C4" then "auto_remove"
      elif .classification == "QUEUE-C6" then "auto_remove_and_research"
      elif .classification == "QUEUE-C2" or .classification == "QUEUE-C5" then "manual_review"
      elif .classification == "QUEUE-C3" then "age_flag"
      else "skip"
      end
    )
  }]
')"

# Count classifications
C1_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C1")] | length')"
C2_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C2")] | length')"
C3_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C3")] | length')"
C4_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C4")] | length')"
C5_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C5")] | length')"
C6_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "QUEUE-C6")] | length')"
UNCLASSIFIED_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.classification == "UNCLASSIFIED")] | length')"
AUTO_REMOVE_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.action == "auto_remove")] | length')"
AUTO_REMOVE_AND_RESEARCH_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.action == "auto_remove_and_research")] | length')"
MANUAL_REVIEW_COUNT="$(echo "$CLASSIFICATIONS" | jq '[.[] | select(.action == "manual_review")] | length')"

# Execute auto-remove actions (C1, C4)
REMOVED=0
REMOVE_ERRORS=0
if [[ "$AUTO_REMOVE_COUNT" -gt 0 ]]; then
  while IFS= read -r queue_id; do
    if delete_queue_item "$queue_id"; then
      REMOVED=$((REMOVED + 1))
    else
      REMOVE_ERRORS=$((REMOVE_ERRORS + 1))
    fi
  done < <(echo "$CLASSIFICATIONS" | jq -r '.[] | select(.action == "auto_remove") | .queue_id')
fi

# Execute auto-remove-and-research actions (C6)
RESEARCHED=0
RESEARCH_ERRORS=0
if [[ "$AUTO_REMOVE_AND_RESEARCH_COUNT" -gt 0 ]]; then
  while IFS=$'\t' read -r queue_id album_id; do
    if delete_queue_item "$queue_id" "true"; then
      REMOVED=$((REMOVED + 1))
      if trigger_album_search "$album_id"; then
        RESEARCHED=$((RESEARCHED + 1))
      else
        RESEARCH_ERRORS=$((RESEARCH_ERRORS + 1))
      fi
    else
      REMOVE_ERRORS=$((REMOVE_ERRORS + 1))
    fi
  done < <(echo "$CLASSIFICATIONS" | jq -r '.[] | select(.action == "auto_remove_and_research") | [.queue_id, .album_id] | @tsv')
fi

MODE="dry-run"
if ! $DRY_RUN; then
  MODE="apply"
fi

if $OUTPUT_JSON; then
  echo "$CLASSIFICATIONS" | jq \
    --arg ts "$GENERATED_AT" \
    --arg mode "$MODE" \
    --argjson total "$TOTAL_RECORDS" \
    --argjson c1 "$C1_COUNT" \
    --argjson c2 "$C2_COUNT" \
    --argjson c3 "$C3_COUNT" \
    --argjson c4 "$C4_COUNT" \
    --argjson c5 "$C5_COUNT" \
    --argjson c6 "$C6_COUNT" \
    --argjson unclassified "$UNCLASSIFIED_COUNT" \
    --argjson removed "$REMOVED" \
    --argjson errors "$REMOVE_ERRORS" \
    --argjson researched "$RESEARCHED" \
    --argjson research_errors "$RESEARCH_ERRORS" \
    '{
      capability: "media.queue.reconcile.lidarr",
      generated_at: $ts,
      mode: $mode,
      status: (if $errors > 0 then "partial" elif $removed > 0 then "cleaned" else "report_only" end),
      total_queue_items: $total,
      batch_processed: (. | length),
      classifications: {
        "QUEUE-C1_ghost_hasfile": $c1,
        "QUEUE-C2_broken_nofile": $c2,
        "QUEUE-C3_stalled": $c3,
        "QUEUE-C4_completed_hasfile": $c4,
        "QUEUE-C5_completed_nofile": $c5,
        "QUEUE-C6_stale_import": $c6,
        "UNCLASSIFIED": $unclassified
      },
      actions: {
        auto_removable: ($c1 + $c4),
        auto_remove_and_research: $c6,
        manual_review: ($c2 + $c5),
        age_flag: $c3,
        removed: $removed,
        remove_errors: $errors,
        researched: $researched,
        research_errors: $research_errors
      },
      items: .
    }'
else
  echo "media.queue.reconcile.lidarr"
  echo "============================"
  echo "mode: $MODE"
  echo "generated_at: $GENERATED_AT"
  echo "total_queue_items: $TOTAL_RECORDS"
  echo ""
  echo "Classifications:"
  echo "  QUEUE-C1 (ghost, tracks exist):     $C1_COUNT"
  echo "  QUEUE-C2 (broken, no tracks):       $C2_COUNT"
  echo "  QUEUE-C3 (stalled/warning):         $C3_COUNT"
  echo "  QUEUE-C4 (completed, tracks exist): $C4_COUNT"
  echo "  QUEUE-C5 (completed, no import):    $C5_COUNT"
  echo "  QUEUE-C6 (stale import, >48h):      $C6_COUNT"
  echo "  UNCLASSIFIED:                       $UNCLASSIFIED_COUNT"
  echo ""
  echo "Actions:"
  echo "  auto_removable: $((C1_COUNT + C4_COUNT))"
  echo "  auto_remove+research: $C6_COUNT"
  echo "  manual_review:  $((C2_COUNT + C5_COUNT))"
  echo "  removed:        $REMOVED"
  echo "  researched:     $RESEARCHED"
  echo "  errors:         $REMOVE_ERRORS"

  if [[ "$MANUAL_REVIEW_COUNT" -gt 0 ]]; then
    echo ""
    echo "Manual Review Items:"
    echo "$CLASSIFICATIONS" | jq -r '.[] | select(.action == "manual_review") | "  - \(.artist_name) / \(.album_title) [\(.classification)] status=\(.status) tracks=\(.track_file_count)"'
  fi
fi

if [[ "$REMOVE_ERRORS" -gt 0 ]]; then
  exit 1
fi
exit 0
