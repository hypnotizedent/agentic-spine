#!/usr/bin/env bash
# media.e2e.verify — End-to-end media availability verification on media-home

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../.." && pwd)"
VM_BINDING="$ROOT/ops/bindings/vm.lifecycle.yaml"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# shellcheck source=/dev/null
source "$SSH_RESOLVE"

usage() {
  cat <<'USAGE'
media.e2e.verify — End-to-end media availability verification on media-home

Args:
  --mode MODE         targeted|sampled (default: sampled)
  --ids IDS           Comma-separated Radarr movie IDs (for targeted mode)
  --sample-size N     Number of titles to check (default: 5)
  --json              Output JSON format

Examples:
  ./bin/ops cap run media.e2e.verify
  ./bin/ops cap run media.e2e.verify -- --mode targeted --ids 123,456
  ./bin/ops cap run media.e2e.verify -- --mode sampled --sample-size 3 --json
USAGE
}

MODE="sampled"
IDS=""
SAMPLE_SIZE=5
OUTPUT_JSON=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="${2:-sampled}"; shift 2 ;;
    --ids) IDS="${2:-}"; shift 2 ;;
    --sample-size) SAMPLE_SIZE="${2:-5}"; shift 2 ;;
    --json) OUTPUT_JSON=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *) echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ "$MODE" == "sampled" || "$MODE" == "targeted" ]] || { echo "FAIL: --mode must be sampled or targeted" >&2; exit 1; }
[[ "$SAMPLE_SIZE" =~ ^[0-9]+$ ]] || { echo "FAIL: --sample-size must be numeric" >&2; exit 1; }

command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { echo "MISSING_DEP: ssh" >&2; exit 2; }

resolve_ssh_ref() {
  local vm="media-home"
  local target user host resolved
  target="$(yq -r ".vms[] | select(.hostname == \"$vm\") | .ssh_target // .hostname // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  user="$(yq -r ".vms[] | select(.hostname == \"$vm\") | .ssh_user // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  [[ -n "$target" && "$target" != "null" ]] || return 1

  host="$target"
  if declare -F ssh_resolve_ssh_host_with_fallback >/dev/null 2>&1; then
    resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 2>/dev/null || true)"
    if [[ -n "$resolved" ]]; then
      host="$(awk '{print $1}' <<<"$resolved")"
    fi
  fi

  if [[ -n "$user" && "$user" != "null" ]]; then
    printf '%s@%s\n' "$user" "$host"
  else
    printf '%s\n' "$host"
  fi
}

SSH_REF="$(resolve_ssh_ref)"

RESULT_JSON="$(
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_REF" \
    sudo env MODE="$MODE" IDS="$IDS" SAMPLE_SIZE="$SAMPLE_SIZE" GENERATED_AT="$GENERATED_AT" python3 - <<'PY'
import json
import os
import re
import urllib.parse
import urllib.request
from pathlib import Path

MODE = os.environ.get("MODE", "sampled")
IDS = [item for item in os.environ.get("IDS", "").split(",") if item]
SAMPLE_SIZE = int(os.environ.get("SAMPLE_SIZE", "5"))

base_write = Path("/srv/appdata/compose/media-write/volumes")

def read_xml_api_key(path_root: Path) -> str:
    for path in path_root.rglob("*.xml"):
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        match = re.search(r"<ApiKey>([^<]+)</ApiKey>", text)
        if match:
            return match.group(1)
    raise RuntimeError(f"api key not found under {path_root}")

def read_env_key(env_path: str, key: str) -> str:
    with open(env_path, encoding="utf-8") as handle:
        for line in handle:
            if line.startswith(f"{key}="):
                return line.strip().split("=", 1)[1]
    raise RuntimeError(f"{key} missing from {env_path}")

def api_json(url: str, headers: dict) -> object:
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.load(response)

radarr_key = read_xml_api_key(base_write / "radarr" / "config")
jellyfin_token = read_env_key("/srv/appdata/compose/media-playback/.env", "JELLYFIN_API_TOKEN")
jellyseerr_key = read_env_key("/srv/appdata/compose/media-playback/.env", "JELLYSEERR_API_KEY")

def radarr_movie(movie_id: int) -> dict:
    return api_json(f"http://127.0.0.1:7878/api/v3/movie/{movie_id}", {"X-Api-Key": radarr_key})

def radarr_movies() -> list:
    return api_json("http://127.0.0.1:7878/api/v3/movie", {"X-Api-Key": radarr_key})

def jellyfin_search(title: str) -> dict:
    encoded = urllib.parse.quote(title)
    url = f"http://127.0.0.1:8096/Items?SearchTerm={encoded}&IncludeItemTypes=Movie&Recursive=true&Fields=ProviderIds"
    return api_json(url, {"X-Emby-Token": jellyfin_token})

def jellyseerr_requests() -> list:
    data = api_json("http://127.0.0.1:5055/api/v1/request?take=1000&skip=0", {"X-Api-Key": jellyseerr_key})
    return data.get("results", [])

def host_path_from_container_path(path: str) -> str:
    if path.startswith("/movies/"):
        return path.replace("/movies/", "/srv/media/movies/", 1)
    if path.startswith("/tv/"):
        return path.replace("/tv/", "/srv/media/tv/", 1)
    if path.startswith("/media/"):
        return path.replace("/media/", "/srv/media/", 1)
    return path

all_requests = jellyseerr_requests()
request_by_tmdb = {}
for item in all_requests:
    media = item.get("media") or {}
    tmdb_id = media.get("tmdbId")
    if tmdb_id is not None:
        request_by_tmdb.setdefault(int(tmdb_id), []).append(item)

if MODE == "targeted":
    selected = [radarr_movie(int(movie_id)) for movie_id in IDS]
else:
    movies = []
    for item in radarr_movies():
        if not item.get("hasFile"):
            continue
        movie_file = item.get("movieFile") or {}
        path = host_path_from_container_path(movie_file.get("path") or "")
        if path and os.path.exists(path) and os.path.getsize(path) > 0:
            movies.append(item)
    movies.sort(key=lambda item: item.get("id", 0), reverse=True)
    selected = movies[:SAMPLE_SIZE]
eligible_count = len(selected)

results = []
for movie in selected:
    title = movie.get("title", "unknown")
    movie_id = int(movie.get("id", 0))
    tmdb_id = int(movie.get("tmdbId") or 0)
    movie_file = movie.get("movieFile") or {}
    file_path = movie_file.get("path") or ""
    host_file_path = host_path_from_container_path(file_path)

    leg1 = {
        "leg": "arr_hasfile",
        "pass": bool(movie.get("hasFile")),
        "title": title,
        "file_path": file_path,
        "host_file_path": host_file_path,
        "tmdb_id": tmdb_id,
    }

    if host_file_path and os.path.exists(host_file_path):
        size = os.path.getsize(host_file_path)
        leg2 = {"leg": "filesystem_exists", "pass": size > 0, "file_size_bytes": size}
    else:
        leg2 = {"leg": "filesystem_exists", "pass": False, "reason": "file_missing"}

    search = jellyfin_search(title)
    items = search.get("Items", [])
    match = False
    for item in items:
        providers = item.get("ProviderIds") or {}
        if tmdb_id and providers.get("Tmdb") == str(tmdb_id):
            match = True
            break
    if not items:
        leg3 = {"leg": "jellyfin_indexed", "pass": False, "reason": "not_in_library"}
    elif tmdb_id and not match:
        leg3 = {"leg": "jellyfin_indexed", "pass": False, "reason": "tmdb_mismatch", "matches": len(items)}
    else:
        leg3 = {"leg": "jellyfin_indexed", "pass": True, "matches": len(items)}

    matching_requests = request_by_tmdb.get(tmdb_id, [])
    if not matching_requests:
        leg4 = {"leg": "jellyseerr_fulfilled", "pass": True, "skip": True, "reason": "no_request_record"}
    else:
        statuses = []
        fulfilled = False
        for request in matching_requests:
          media = request.get("media") or {}
          status_value = media.get("status")
          statuses.append(status_value)
          if (status_value is not None and int(status_value) >= 3) or media.get("jellyfinMediaId"):
              fulfilled = True
        leg4 = {
            "leg": "jellyseerr_fulfilled",
            "pass": fulfilled,
            "request_statuses": statuses,
            "matching_requests": len(matching_requests),
        }

    verdict = "PASS" if leg1["pass"] and leg2["pass"] and leg3["pass"] and leg4["pass"] else "FAIL"
    if leg4.get("skip"):
        verdict = "PASS_WITH_SKIP"

    results.append({
        "movie_id": movie_id,
        "title": title,
        "tmdb_id": tmdb_id,
        "verdict": verdict,
        "legs": [leg1, leg2, leg3, leg4],
    })

overall = "pass" if results and all(item["verdict"] != "FAIL" for item in results) else "fail"
print(json.dumps({
    "capability": "media.e2e.verify",
    "generated_at": os.environ.get("GENERATED_AT"),
    "status": overall,
    "data": {
        "mode": MODE,
        "sample_size": SAMPLE_SIZE,
        "ids": IDS,
        "eligible_count": eligible_count,
        "checked": len(results),
        "results": results,
        "reason": "no_eligible_samples" if not results else None,
    },
}))
PY
)"

if $OUTPUT_JSON; then
  printf '%s\n' "$RESULT_JSON"
else
  echo "media.e2e.verify"
  echo "================"
  echo "mode: $(jq -r '.data.mode' <<<"$RESULT_JSON")"
  echo "checked: $(jq -r '.data.checked' <<<"$RESULT_JSON")"
  jq -r '.data.results[] | "  " + .title + ": " + .verdict' <<<"$RESULT_JSON"
fi

if [[ "$(jq -r '.status' <<<"$RESULT_JSON")" != "pass" ]]; then
  exit 1
fi
exit 0
