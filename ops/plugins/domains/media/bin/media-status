#!/usr/bin/env bash
# media-status — Unified media-home runtime status dashboard

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../.." && pwd)"
VM_BINDING="$ROOT/ops/bindings/vm.lifecycle.yaml"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"

# shellcheck source=/dev/null
source "$SSH_RESOLVE"

command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { echo "MISSING_DEP: ssh" >&2; exit 2; }

LAN_IP="$(yq -r '.vms[] | select(.hostname == "media-home") | .lan_ip // ""' "$VM_BINDING")"
TS_IP="$(yq -r '.vms[] | select(.hostname == "media-home") | .tailscale_ip // ""' "$VM_BINDING")"
SSH_USER="$(yq -r '.vms[] | select(.hostname == "media-home") | .ssh_user // "ubuntu"' "$VM_BINDING")"

RESOLUTION="$(ssh_resolve_ssh_host_with_fallback "media-home" 2>/dev/null || true)"
RESOLVED_HOST="$(awk '{print $1}' <<<"$RESOLUTION")"
RESOLVED_PATH="$(awk '{print $2}' <<<"$RESOLUTION")"
SSH_REF="${SSH_USER}@${RESOLVED_HOST:-$LAN_IP}"

COUNTS="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_REF" \
  "sudo docker ps -a --format '{{.Status}}' | awk '
    BEGIN {total=0; running=0; exited=0; unhealthy=0}
    {total++}
    /^Up/ {running++}
    /^Exited/ {exited++}
    /unhealthy/ {unhealthy++}
    END {printf \"%d:%d:%d:%d\n\", total, running, exited, unhealthy}
  '" 2>/dev/null || echo "0:0:0:0")"
TOTAL="${COUNTS%%:*}"
REST="${COUNTS#*:}"
RUNNING="${REST%%:*}"
REST="${REST#*:}"
EXITED="${REST%%:*}"
UNHEALTHY="${REST##*:}"

MOUNT_INFO="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_REF" \
  "findmnt -no SOURCE,FSTYPE,OPTIONS /srv/media 2>/dev/null || true" 2>/dev/null || true)"
DF_INFO="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_REF" \
  "df -h /srv/media 2>/dev/null | tail -1" 2>/dev/null || true)"
HEALTH_JSON="$("$ROOT/ops/plugins/domains/media/bin/media-health-check" --json 2>/dev/null || true)"

echo "═══════════════════════════════════════════════════════════════════════════"
echo "MEDIA STACK STATUS"
echo "═══════════════════════════════════════════════════════════════════════════"
echo
echo "┌─ RUNTIME ────────────────────────────────────────────────────────────────┐"
printf "│  %-22s %s\n" "canonical-vm:" "media-home (VM 106)"
printf "│  %-22s %s\n" "lan-ip:" "${LAN_IP:-unknown}"
printf "│  %-22s %s\n" "tailscale-ip:" "${TS_IP:-unknown}"
printf "│  %-22s %s\n" "ssh-path:" "${RESOLVED_HOST:-unresolved} (${RESOLVED_PATH:-unknown})"
echo "└──────────────────────────────────────────────────────────────────────────┘"
echo
echo "┌─ CONTAINERS ─────────────────────────────────────────────────────────────┐"
printf "│  %-22s %s total | %s running | %s exited | %s unhealthy\n" \
  "media-home:" "$TOTAL" "$RUNNING" "$EXITED" "$UNHEALTHY"
echo "└──────────────────────────────────────────────────────────────────────────┘"
echo
echo "┌─ PAYLOAD MOUNT ──────────────────────────────────────────────────────────┐"
if [[ -n "$MOUNT_INFO" ]]; then
  printf "│  %-22s %s\n" "findmnt:" "$MOUNT_INFO"
else
  printf "│  %-22s %s\n" "findmnt:" "(unavailable)"
fi
if [[ -n "$DF_INFO" ]]; then
  printf "│  %-22s %s\n" "df:" "$DF_INFO"
else
  printf "│  %-22s %s\n" "df:" "(unavailable)"
fi
echo "└──────────────────────────────────────────────────────────────────────────┘"
echo
echo "┌─ HEALTH SUMMARY ─────────────────────────────────────────────────────────┐"
if [[ -n "$HEALTH_JSON" ]]; then
  OK_COUNT="$(jq -r '.data.summary.ok // 0' <<<"$HEALTH_JSON" 2>/dev/null || echo 0)"
  FAIL_COUNT="$(jq -r '.data.summary.fail // 0' <<<"$HEALTH_JSON" 2>/dev/null || echo 0)"
  SKIP_COUNT="$(jq -r '.data.summary.skip // 0' <<<"$HEALTH_JSON" 2>/dev/null || echo 0)"
  MISSING_COUNT="$(jq -r '.data.summary.missing // 0' <<<"$HEALTH_JSON" 2>/dev/null || echo 0)"
  printf "│  %-22s %s ok | %s fail | %s skip | %s missing\n" \
    "media-home:" "$OK_COUNT" "$FAIL_COUNT" "$SKIP_COUNT" "$MISSING_COUNT"
else
  printf "│  %-22s %s\n" "media-home:" "(health probe unavailable)"
fi
echo "└──────────────────────────────────────────────────────────────────────────┘"
