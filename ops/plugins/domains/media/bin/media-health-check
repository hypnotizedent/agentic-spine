#!/usr/bin/env bash
# media.health.check — Aggregate health check across the canonical media-home runtime

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../.." && pwd)"
BINDING="$ROOT/ops/bindings/services.health.yaml"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"
SCHEMA_VERSION="2.0.0"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# shellcheck source=/dev/null
source "$SSH_RESOLVE"

usage() {
  cat <<'USAGE'
media.health.check — Aggregate health check across the canonical media-home runtime

Args:
  --vm HOST         Only supported value: media-home
  --service NAME    Limit probe to one service id from services.health.yaml
  --json            Output JSON format
  --timeout SEC     Per-service health timeout (default: 10)

Examples:
  ./bin/ops cap run media.health.check
  ./bin/ops cap run media.health.check -- --service jellyfin --json
USAGE
}

VM_FILTER=""
SERVICE_FILTER=""
OUTPUT_JSON=false
TIMEOUT_SEC=10

while [[ $# -gt 0 ]]; do
  case "$1" in
    --vm) VM_FILTER="${2:-}"; shift 2 ;;
    --service) SERVICE_FILTER="${2:-}"; shift 2 ;;
    --json) OUTPUT_JSON=true; shift ;;
    --timeout) TIMEOUT_SEC="${2:-10}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *) echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "MISSING_DEP: curl" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }

[[ -f "$BINDING" ]] || { echo "STOP: binding not found: $BINDING" >&2; exit 2; }

if [[ -n "$VM_FILTER" && "$VM_FILTER" != "media-home" ]]; then
  echo "FAIL: media.health.check now treats media-home as the only canonical media runtime; requested vm '$VM_FILTER' is legacy/non-authoritative" >&2
  exit 1
fi

ACTIVE_MEDIA_SERVICE_IDS=(
  radarr
  sonarr
  prowlarr
  sabnzbd
  jellyfin
  navidrome
  jellyseerr
  bazarr
  homarr
  wizarr
  spotisub
  media-node-exporter
)

get_field() {
  local id="$1"
  local field="$2"
  yq -r ".endpoints[] | select(.id == \"$id\") | .$field // \"\"" "$BINDING" 2>/dev/null
}

get_enabled() {
  local id="$1"
  yq -r ".endpoints[] | select(.id == \"$id\") | if has(\"enabled\") then (.enabled | tostring) else \"true\" end" "$BINDING" 2>/dev/null
}

probe_service() {
  local id="$1"
  local host url expect enabled
  host="$(get_field "$id" host)"
  url="$(get_field "$id" url)"
  expect="$(get_field "$id" expect)"
  enabled="$(get_enabled "$id")"

  if [[ -z "$url" ]]; then
    printf 'MISSING\t%s\t%s\t%s\n' "$id" "${host:-unbound}" "missing-services-health-entry"
    return 0
  fi

  if [[ "$enabled" == "false" ]]; then
    printf 'SKIP\t%s\t%s\t%s\n' "$id" "${host:-unbound}" "disabled"
    return 0
  fi

  local candidate_rows=()
  if declare -F ssh_resolve_url_candidates >/dev/null 2>&1 && [[ -n "$host" ]]; then
    while IFS=$'\t' read -r candidate_url path_used; do
      [[ -n "$candidate_url" ]] || continue
      candidate_rows+=("${candidate_url}|${path_used}")
    done < <(ssh_resolve_url_candidates "$url" "$host")
  fi
  if [[ "${#candidate_rows[@]}" -eq 0 ]]; then
    candidate_rows+=("${url}|direct")
  fi

  local row candidate_url path_used http_code
  for row in "${candidate_rows[@]}"; do
    candidate_url="${row%%|*}"
    path_used="${row##*|}"
    http_code="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time "$TIMEOUT_SEC" "$candidate_url" 2>/dev/null || true)"
    if [[ "$http_code" == "$expect" ]]; then
      printf 'OK\t%s\t%s\t%s (%s)\n' "$id" "${host:-unbound}" "$candidate_url" "$path_used"
      return 0
    fi
  done

  printf 'FAIL\t%s\t%s\t%s expected=%s got=%s\n' "$id" "${host:-unbound}" "$url" "$expect" "${http_code:-curl-failed}"
  return 0
}

RESULTS=()
OK_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
MISSING_COUNT=0

IDS_TO_CHECK=("${ACTIVE_MEDIA_SERVICE_IDS[@]}")
if [[ -n "$SERVICE_FILTER" ]]; then
  IDS_TO_CHECK=("$SERVICE_FILTER")
fi

for id in "${IDS_TO_CHECK[@]}"; do
  result="$(probe_service "$id")"
  RESULTS+=("$result")
  case "${result%%$'\t'*}" in
    OK) OK_COUNT=$((OK_COUNT + 1)) ;;
    FAIL) FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
    SKIP) SKIP_COUNT=$((SKIP_COUNT + 1)) ;;
    MISSING) MISSING_COUNT=$((MISSING_COUNT + 1)) ;;
  esac
done

TOTAL=$((OK_COUNT + FAIL_COUNT + SKIP_COUNT + MISSING_COUNT))
STATUS="ok"
if [[ $FAIL_COUNT -gt 0 || $MISSING_COUNT -gt 0 ]]; then
  STATUS="fail"
fi

if $OUTPUT_JSON; then
  results_json="$(printf '%s\n' "${RESULTS[@]}" | jq -R -s '
    split("\n")
    | map(select(length > 0))
    | map(split("\t") | {code: .[0], service: .[1], host: .[2], detail: .[3]})
  ')"
  jq -n \
    --arg capability "media.health.check" \
    --arg schema_version "$SCHEMA_VERSION" \
    --arg generated_at "$GENERATED_AT" \
    --arg status "$STATUS" \
    --arg vm_filter "${VM_FILTER:-media-home}" \
    --arg service_filter "$SERVICE_FILTER" \
    --argjson total "$TOTAL" \
    --argjson ok "$OK_COUNT" \
    --argjson fail "$FAIL_COUNT" \
    --argjson skip "$SKIP_COUNT" \
    --argjson missing "$MISSING_COUNT" \
    --argjson results "$results_json" \
    '{
      capability: $capability,
      schema_version: $schema_version,
      generated_at: $generated_at,
      status: $status,
      data: {
        vm_filter: $vm_filter,
        service_filter: (if $service_filter == "" then null else $service_filter end),
        summary: {
          total: $total,
          ok: $ok,
          fail: $fail,
          skip: $skip,
          missing: $missing
        },
        results: $results
      }
    }'
else
  echo "media.health.check"
  echo "==================="
  echo "vm: media-home"
  echo "total: $TOTAL | ok: $OK_COUNT | fail: $FAIL_COUNT | skip: $SKIP_COUNT | missing: $MISSING_COUNT"
  echo
  for result in "${RESULTS[@]}"; do
    echo "  ${result//$'\t'/: }"
  done
fi

if [[ $FAIL_COUNT -gt 0 || $MISSING_COUNT -gt 0 ]]; then
  exit 1
fi
exit 0
