#!/usr/bin/env bash
# media-config-restore-drill — governed scratch restore proof for media-home config-state
# Domain: media
# Safety: mutating
# Approval: auto
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)}"
source "$ROOT/ops/lib/spine-paths.sh"
spine_paths_init
VM_BINDING="$ROOT/ops/bindings/vm.lifecycle.yaml"
BACKUP_SCHEDULE="$ROOT/ops/bindings/backup.schedule.yaml"
RECEIPT_DIR="$SPINE_OUTBOX/reports/restore-drills"
KEEP_ARTIFACTS=0
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"

fail() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

need yq
need ssh
[[ -f "$VM_BINDING" ]] || fail "missing vm lifecycle: $VM_BINDING"
[[ -f "$BACKUP_SCHEDULE" ]] || fail "missing backup schedule: $BACKUP_SCHEDULE"

# shellcheck source=ops/lib/ssh-resolve.sh
source "$SSH_RESOLVE" 2>/dev/null || true

usage() {
  cat <<'EOF'
Usage: media-config-restore-drill [--keep-artifacts]

Runs a scratch restore drill covering the combined media-home plane:
  - writer_plane: radarr config
  - playback_plane: jellyfin config

For each plane:
  1. Find latest config artifact from /srv/appdata/backups/media-config/
  2. Extract representative config files to temporary location
  3. Validate config structure and key files present
  4. Cleanup (unless --keep-artifacts)

Writes a single YAML receipt under mailroom/outbox/reports/restore-drills/.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --keep-artifacts) KEEP_ARTIFACTS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

get_vm_ssh_ref() {
  local vm="$1"
  local target user resolved_host
  target="$(yq e -r ".vms[] | select(.hostname == \"$vm\") | .ssh_target // .hostname // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  user="$(yq e -r ".vms[] | select(.hostname == \"$vm\") | .ssh_user // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  [[ -n "$target" && "$target" != "null" ]] || return 1

  resolved_host="$target"
  if type ssh_resolve_host_with_fallback &>/dev/null; then
    local resolution
    resolution="$(ssh_resolve_host_with_fallback "$target" 2>/dev/null || true)"
    if [[ -n "$resolution" ]]; then
      resolved_host="$(awk '{print $1}' <<<"$resolution")"
    fi
  fi

  [[ -n "$resolved_host" ]] || return 1
  if [[ -n "$user" && "$user" != "null" ]]; then
    echo "${user}@${resolved_host}"
  else
    echo "$resolved_host"
  fi
}

yaml_quote() {
  python3 - <<'PY' "$1"
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
media_home_ssh="$(get_vm_ssh_ref "media-home" 2>/dev/null || true)"
[[ -n "$media_home_ssh" ]] || fail "no ssh target found for media-home"

RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DAY="$(date -u +%Y%m%d)"
mkdir -p "$RECEIPT_DIR"
RECEIPT_PATH="$RECEIPT_DIR/media-config-restore-drill-${RUN_DAY}.yaml"

RESULT="PASS"
ERROR_MSG=""
declare -a DRILL_RESULTS=()

run_plane_drill() {
  local role="$1"
  local service="$2"
  local config_root="$3"
  local config_key_file="$4"

  local backup_root="/srv/appdata/backups/media-config"
  local latest_backup
  latest_backup="$(ssh $SSH_OPTS "$media_home_ssh" \
    "find '$backup_root/last-good' '$backup_root' -maxdepth 1 -type f -name 'media-home-config-*.tar.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-" || true)"

  if [[ -z "$latest_backup" ]]; then
    echo "  $role: FAIL (no backup found)"
    DRILL_RESULTS+=("$role|FAIL|no_backup_found|$service|$config_root|$config_key_file|no_backup_found")
    RESULT="FAIL"
    return 1
  fi

  local drill_dir="/tmp/media-config-drill-${role}-${RUN_TS}"
  local restore_output
  local restore_error

  set +e
  restore_output="$(ssh $SSH_OPTS "$media_home_ssh" bash -s -- "$latest_backup" "$drill_dir" "$config_root" "$config_key_file" "$KEEP_ARTIFACTS" <<'REMOTE_SCRIPT' 2>&1
set -euo pipefail
backup_file="$1"
drill_dir="$2"
config_root="$3"
config_key_file="$4"
keep_artifacts="${5:-0}"

cleanup() {
  if [[ "$keep_artifacts" != "1" ]]; then
    rm -rf "$drill_dir"
  fi
}
trap cleanup EXIT

rm -rf "$drill_dir"
mkdir -p "$drill_dir"

set +o pipefail
if ! tar -tzf "$backup_file" | grep -q "^${config_root}/"; then
  set -o pipefail
  echo "config root missing in archive: $config_root" >&2
  exit 1
fi
set -o pipefail

set +o pipefail
key_file_path="${config_root}/${config_key_file}"
if ! tar -tzf "$backup_file" | grep -Fxq "$key_file_path"; then
  set -o pipefail
  echo "key config file missing in archive: $config_key_file" >&2
  exit 2
fi
set -o pipefail

set +o pipefail
file_count="$(tar -tzf "$backup_file" | grep "^${config_root}/" | grep -v '/$' | wc -l | tr -d ' ')"
set -o pipefail
[[ "$file_count" -gt 0 ]] || { echo "config directory empty in archive" >&2; exit 3; }

mkdir -p "$drill_dir/$(dirname "$key_file_path")"
tar -xzf "$backup_file" -C "$drill_dir" "$key_file_path"

[[ -s "$drill_dir/$key_file_path" ]] || { echo "extracted key file is empty" >&2; exit 4; }

echo "OK: verified $file_count files in archive, key file extracted and valid"
REMOTE_SCRIPT
)"
  local rc=$?
  set -e

  if [[ $rc -eq 0 ]]; then
    echo "  $role: PASS"
    local backup_basename
    backup_basename="$(basename "$latest_backup")"
    DRILL_RESULTS+=("$role|PASS|$backup_basename|$service|$config_root|$config_key_file|")
  else
    echo "  $role: FAIL (restore error)"
    restore_error="$(echo "$restore_output" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g' | sed 's/^ //; s/ $//')"
    DRILL_RESULTS+=("$role|FAIL|restore_failed|$service|$config_root|$config_key_file|$restore_error")
    RESULT="FAIL"
    ERROR_MSG="${ERROR_MSG}${role}: ${restore_error}; "
  fi
}

echo "=== Media Config Restore Drill ==="
echo "timestamp: $RUN_TS"

run_plane_drill "writer_plane" "radarr" "srv/appdata/compose/media-write/volumes/radarr/config" "config.xml"
run_plane_drill "playback_plane" "jellyfin" "srv/appdata/compose/media-playback/volumes/jellyfin/config" "config/system.xml"

ERROR_MSG="${ERROR_MSG%; }"

writer_result="${DRILL_RESULTS[0]#*|}"
writer_result="${writer_result%%|*}"
playback_result="${DRILL_RESULTS[1]#*|}"
playback_result="${playback_result%%|*}"

{
  echo "kind: media_config_restore_drill"
  echo "version: 2"
  echo "generated_at: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  echo "result: $RESULT"
  echo "target:"
  echo "  media_home_ssh_ref: $(yaml_quote "$media_home_ssh")"
  echo "artifacts:"
  for drill_line in "${DRILL_RESULTS[@]}"; do
    IFS='|' read -r role result backup service config_root config_file detail <<< "$drill_line"
    echo "  - stack: \"media-home\""
    echo "    role: $(yaml_quote "$role")"
    echo "    result: $(yaml_quote "$result")"
    if [[ -n "$backup" ]]; then
      echo "    backup: $(yaml_quote "$backup")"
    else
      echo "    backup: null"
    fi
    if [[ -n "$service" ]]; then
      echo "    service: $(yaml_quote "$service")"
    else
      echo "    service: null"
    fi
    if [[ -n "$config_root" ]]; then
      echo "    config_root: $(yaml_quote "$config_root")"
    else
      echo "    config_root: null"
    fi
    if [[ -n "$config_file" ]]; then
      echo "    key_config_file: $(yaml_quote "$config_file")"
    else
      echo "    key_config_file: null"
    fi
  done
  echo "restore:"
  echo "  mode: scratch_extract_verify"
  echo "  keep_artifacts: $([[ "$KEEP_ARTIFACTS" -eq 1 ]] && echo true || echo false)"
  echo "comparison:"
  echo "  media_home:"
  echo "    writer_plane:"
  echo "      result: $(yaml_quote "$writer_result")"
  echo "    playback_plane:"
  echo "      result: $(yaml_quote "$playback_result")"
  if [[ -n "$ERROR_MSG" ]]; then
    echo "error: $(yaml_quote "$ERROR_MSG")"
  else
    echo "error: null"
  fi
} >"$RECEIPT_PATH"

echo "receipt: $RECEIPT_PATH"
echo "result: $RESULT"
if [[ -n "$ERROR_MSG" ]]; then
  echo "error: $ERROR_MSG"
fi

if [[ "$RESULT" != "PASS" ]]; then
  exit 1
fi
