#!/usr/bin/env bash
set -euo pipefail

# media-content-ledger-reconcile
# Reconcile media content snapshot into canonical ledger.
# Check mode (preview) by default; --apply promotes unledgered items to governed ledger entries.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../.." && pwd)}"

source "$ROOT/ops/lib/git-lock.sh"

MODE="check"
LIMIT=250
OFFSET=0
STATUS="pending"

usage() {
  cat <<'USAGE'
media-content-ledger-reconcile

Reconcile media content snapshot into canonical ledger.

Usage:
  ./bin/ops cap run media.content.ledger.reconcile
  ./bin/ops cap run media.content.ledger.reconcile -- --check --limit 100
  ./bin/ops cap run media.content.ledger.reconcile -- --apply --limit 1000 --status approved

Flags:
  --check           Preview unledgered items without writing (default).
  --apply           Populate ledger with governed entries.
  --limit <n>       Maximum items to process (default: 250).
  --offset <n>      Skip first N items (default: 0).
  --status <status> Status for new ledger entries: pending|approved (default: pending).
  -h, --help        Show this help.

Description:
  Check mode: Reports unledgered items from snapshot without modifying ledger.
  Apply mode: Adds unledgered items to ledger with governed metadata fields.

  Ledger is canonical master. Snapshot is observed input only.
USAGE
}

if [[ "${1:-}" == "--" ]]; then
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      MODE="check"
      shift
      ;;
    --apply)
      MODE="apply"
      shift
      ;;
    --limit)
      LIMIT="${2:-250}"
      shift 2
      ;;
    --offset)
      OFFSET="${2:-0}"
      shift 2
      ;;
    --status)
      STATUS="${2:-pending}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "media.content.ledger.reconcile FAIL: unknown arg '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! [[ "$LIMIT" =~ ^[0-9]+$ ]] || [[ "$LIMIT" -lt 0 ]]; then
  echo "media.content.ledger.reconcile FAIL: --limit must be >= 0" >&2
  exit 1
fi

if ! [[ "$OFFSET" =~ ^[0-9]+$ ]] || [[ "$OFFSET" -lt 0 ]]; then
  echo "media.content.ledger.reconcile FAIL: --offset must be >= 0" >&2
  exit 1
fi

if [[ "$STATUS" != "pending" && "$STATUS" != "approved" ]]; then
  echo "media.content.ledger.reconcile FAIL: --status must be pending|approved" >&2
  exit 1
fi

SNAPSHOT_PATH="$ROOT/ops/bindings/media.content.snapshot.yaml"
LEDGER_PATH="$ROOT/ops/bindings/media.content.ledger.yaml"

if [[ ! -f "$SNAPSHOT_PATH" ]]; then
  echo "media.content.ledger.reconcile FAIL: snapshot not found: $SNAPSHOT_PATH" >&2
  exit 2
fi

if [[ ! -f "$LEDGER_PATH" ]]; then
  echo "media.content.ledger.reconcile FAIL: ledger not found: $LEDGER_PATH" >&2
  exit 2
fi

if [[ "$MODE" == "apply" ]]; then
  if [[ "${SPINE_GIT_LOCK_HELD:-0}" != "1" ]]; then
    acquire_git_lock media_ledger_reconcile || exit 1
    trap 'release_git_lock' EXIT INT TERM
    export SPINE_GIT_LOCK_HELD=1
  fi
fi

python3 - "$ROOT" "$SNAPSHOT_PATH" "$LEDGER_PATH" "$MODE" "$LIMIT" "$OFFSET" "$STATUS" <<'PY'
from __future__ import annotations

from datetime import datetime, timezone
from pathlib import Path
import sys

import yaml


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def today_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def load_yaml(path: Path) -> dict:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
    except Exception as exc:
        print(f"FAIL: unable to parse YAML {path}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(data, dict):
        print(f"FAIL: expected mapping at YAML root: {path}", file=sys.stderr)
        raise SystemExit(1)
    return data


def save_yaml(path: Path, data: dict) -> None:
    path.write_text(yaml.safe_dump(data, sort_keys=False), encoding="utf-8")


root = Path(sys.argv[1]).expanduser().resolve()
snapshot_path = Path(sys.argv[2]).expanduser().resolve()
ledger_path = Path(sys.argv[3]).expanduser().resolve()
mode = sys.argv[4]
limit = int(sys.argv[5])
offset = int(sys.argv[6])
status = sys.argv[7]

snapshot = load_yaml(snapshot_path)
ledger = load_yaml(ledger_path)

# Extract observed items from snapshot
observed_items: list[dict] = []
source_stamp = str(snapshot.get("generated_at") or now_iso())

for section, item_class in [("movies", "movie"), ("tv", "tv"), ("music", "music")]:
    for row in snapshot.get(section) or []:
        title = ""
        source_id = ""
        if isinstance(row, str):
            item_id = row.strip()
        elif isinstance(row, dict):
            item_id = str(row.get("id", "")).strip()
            title = str(row.get("title", "")).strip()
            source_id = str(row.get("source_id", "")).strip()
        else:
            continue

        if not item_id:
            continue

        observed_items.append({
            "id": item_id,
            "class": item_class,
            "title": title if isinstance(row, dict) else item_id,
            "source_id": source_id if isinstance(row, dict) else f"{item_class}:{item_id}",
            "first_seen_at": source_stamp,
        })

# Extract ledgered item IDs
ledgered_ids: set[str] = set()
for row in ledger.get("items") or []:
    if isinstance(row, dict):
        item_id = str(row.get("id", "")).strip()
        if item_id:
            ledgered_ids.add(item_id)

# Find unledgered items
unledgered_items = [item for item in observed_items if item["id"] not in ledgered_ids]

# Sort and paginate
unledgered_items.sort(key=lambda x: (x["class"], x["id"]))
total_unledgered = len(unledgered_items)
selected = unledgered_items[offset:offset + limit] if limit > 0 else []

# Output report
print(f"media.content.ledger.reconcile")
print(f"mode: {mode}")
print(f"snapshot_path: {snapshot_path.relative_to(root)}")
print(f"ledger_path: {ledger_path.relative_to(root)}")
print(f"observed_count: {len(observed_items)}")
print(f"ledgered_count: {len(ledgered_ids)}")
print(f"unledgered_count: {total_unledgered}")
print(f"selected_count: {len(selected)}")

if mode == "check":
    if selected:
        print("\nSample unledgered items (first 5):")
        for item in selected[:5]:
            print(f"  - {item['id']} ({item['class']}): {item['title']}")

elif mode == "apply":
    if not selected:
        print("\nmedia.content.ledger.reconcile: no items to add")
        raise SystemExit(0)

    # Build ledger entries
    ledger_items = list(ledger.get("items") or [])
    added_count = 0

    for item in selected:
        ledger_entry = {
            "id": item["id"],
            "domain": "media",
            "class": item["class"],
            "source_system": "media.content.snapshot",
            "first_seen_at": item["first_seen_at"],
            "status": status,
            "owner_agent": "media-agent",
            "location_or_site": "shop",
            "evidence_refs": ["ops/bindings/media.content.snapshot.yaml"],
            "runbook_path": "docs/governance/domains/media.md",
        }

        # Add optional fields if available
        if item.get("title"):
            ledger_entry["title"] = item["title"]
        if item.get("source_id"):
            ledger_entry["source_id"] = item["source_id"]

        ledger_items.append(ledger_entry)
        added_count += 1

    # Update ledger
    ledger["items"] = ledger_items
    ledger["updated_at"] = today_iso()

    save_yaml(ledger_path, ledger)

    print(f"\nmedia.content.ledger.reconcile: added {added_count} entries to ledger")
    print(f"entries_added: {added_count}")
    print(f"new_ledger_count: {len(ledger_items)}")
    print(f"status: {status}")
PY

echo "done"
