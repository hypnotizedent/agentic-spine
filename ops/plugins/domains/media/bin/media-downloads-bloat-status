#!/usr/bin/env bash
# media.downloads.bloat.status — read-only analysis of downloads folder bloat
#
# Usage:
#   ./bin/ops cap run media.downloads.bloat.status
#   ./bin/ops cap run media.downloads.bloat.status --json
#
# Contract:
# - Resolves the canonical downloads path on media-home first
# - Falls back to streaming-stack only if the residual shop view is the only reachable path
# - Analyzes the resolved downloads root for size, age, and bloat candidates
# - Read-only, no mutations
# - Exit 0 if successful, exit 1 on error, exit 2 on config errors
#
# Phase 1 Audit Prep (2026-03-19):
# This capability supports safe downloads audit per MEDIA_STORAGE_CONTRACT.md Phase 1.
# Provides read-only inventory and classification without deletion or movement.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../.." && pwd)"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# shellcheck source=/dev/null
source "$ROOT/ops/lib/media-residual-probe.sh"

usage() {
  cat <<'USAGE'
media.downloads.bloat.status — analyze downloads folder bloat (read-only)

Args:
  --json      Output JSON format
  --timeout   SSH timeout in seconds (default: 15)

Examples:
  ./bin/ops cap run media.downloads.bloat.status
  ./bin/ops cap run media.downloads.bloat.status --json

Output:
  - Total downloads size
  - Age buckets (<7 days, 7-30 days, 30-90 days, >90 days)
  - Top 20 space consumers
  - Estimated bloat candidates (>30 days old)
  - No deletions or moves (read-only audit)
USAGE
}

OUTPUT_JSON=false
TIMEOUT_SEC=15

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)     OUTPUT_JSON=true; shift ;;
    --timeout)  TIMEOUT_SEC="${2:-15}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift ;;
    *)          echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

media_residual_probe_require_deps || exit $?

target_ssh() {
  media_residual_probe_ssh "$1"
}

# Try media-home first (canonical), fall back to streaming-stack (legacy)
TARGET_VM=""
TARGET_HOST=""
TARGET_PATH_USED=""
DOWNLOADS_PATH=""

if media_residual_probe_init "media-home" "$TIMEOUT_SEC"; then
  if target_ssh "test -d /srv/media/downloads" >/dev/null 2>&1; then
    TARGET_VM="media-home"
    TARGET_HOST="$MEDIA_RESIDUAL_HOST"
    TARGET_PATH_USED="$MEDIA_RESIDUAL_PATH_USED"
    DOWNLOADS_PATH="/srv/media/downloads"
  fi
fi

if [[ -z "$TARGET_VM" ]] && media_residual_probe_init "streaming-stack" "$TIMEOUT_SEC"; then
  if target_ssh "test -d /mnt/media/downloads" >/dev/null 2>&1; then
    TARGET_VM="streaming-stack"
    TARGET_HOST="$MEDIA_RESIDUAL_HOST"
    TARGET_PATH_USED="$MEDIA_RESIDUAL_PATH_USED"
    DOWNLOADS_PATH="/mnt/media/downloads"
  fi
fi

if [[ -z "$TARGET_VM" ]]; then
  if [[ "$OUTPUT_JSON" == "true" ]]; then
    cat <<JSON
{
  "generated_at": "$GENERATED_AT",
  "targets_tried": ["media-home:/srv/media/downloads", "streaming-stack:/mnt/media/downloads"],
  "status": "path_missing",
  "exists": false,
  "mutations": "none"
}
JSON
  else
    echo "# media.downloads.bloat.status"
    echo "# Generated: $GENERATED_AT"
    echo ""
    echo "## Status: PATH_MISSING"
    echo ""
    echo "Downloads path not reachable on media-home (/srv/media/downloads)"
    echo "or streaming-stack (/mnt/media/downloads)."
    echo ""
    echo "## Next Actions"
    echo "1. Run: ./bin/ops cap run media.nfs.verify"
    echo "2. Verify media-home Synology mount for /srv/media"
    echo "3. Verify streaming-stack mount contract for /mnt/media"
    echo "4. Do not delete or move anything until mount truth is reconciled"
    echo ""
    echo "# Audit complete (read-only, no reachable target)"
  fi

  exit 0
fi

media_residual_probe_init "$TARGET_VM" "$TIMEOUT_SEC" >/dev/null 2>&1 || true

TOTAL_SIZE=$(target_ssh "du -sh --exclude=.quarantine $DOWNLOADS_PATH 2>/dev/null | cut -f1" || echo "UNKNOWN")
QUARANTINE_SIZE=$(target_ssh "du -sh $DOWNLOADS_PATH/.quarantine 2>/dev/null | cut -f1" || echo "none")
RECENT_COUNT=$(target_ssh "find $DOWNLOADS_PATH -not -path '*/.quarantine/*' -type f -mtime -7 2>/dev/null | wc -l | tr -d ' '" || echo "0")
WEEK_MONTH_COUNT=$(target_ssh "find $DOWNLOADS_PATH -not -path '*/.quarantine/*' -type f -mtime +7 -mtime -30 2>/dev/null | wc -l | tr -d ' '" || echo "0")
MONTH_QUARTER_COUNT=$(target_ssh "find $DOWNLOADS_PATH -not -path '*/.quarantine/*' -type f -mtime +30 -mtime -90 2>/dev/null | wc -l | tr -d ' '" || echo "0")
OLD_COUNT=$(target_ssh "find $DOWNLOADS_PATH -not -path '*/.quarantine/*' -type f -mtime +90 2>/dev/null | wc -l | tr -d ' '" || echo "0")
TOP_CONSUMERS=$(target_ssh "du -sh $DOWNLOADS_PATH/* 2>/dev/null | sort -rh | head -20" || echo "ERROR: Could not list top consumers")
BLOAT_ESTIMATE=$((MONTH_QUARTER_COUNT + OLD_COUNT))

if [[ "$OUTPUT_JSON" == "true" ]]; then
  cat <<JSON
{
  "generated_at": "$GENERATED_AT",
  "target": "$TARGET_VM",
  "resolution_target": "$TARGET_VM",
  "resolution_host": "$TARGET_HOST",
  "resolution_path": "$TARGET_PATH_USED",
  "downloads_path": "$DOWNLOADS_PATH",
  "total_size": "$TOTAL_SIZE",
  "quarantine_size": "$QUARANTINE_SIZE",
  "age_buckets": {
    "recent_7d": $RECENT_COUNT,
    "week_to_month": $WEEK_MONTH_COUNT,
    "month_to_quarter": $MONTH_QUARTER_COUNT,
    "over_90d": $OLD_COUNT
  },
  "bloat_estimate": $BLOAT_ESTIMATE,
  "status": "$(if [[ $BLOAT_ESTIMATE -gt 100 ]]; then echo "BLOAT_DETECTED"; else echo "ACCEPTABLE"; fi)",
  "top_consumers": $(printf '%s\n' "$TOP_CONSUMERS" | python3 -c 'import json,sys; print(json.dumps([line for line in sys.stdin.read().splitlines() if line]))'),
  "mutations": "none",
  "safe_for_phase_1": true
}
JSON
else
  echo "# media.downloads.bloat.status"
  echo "# Generated: $GENERATED_AT"
  echo "# Target: $TARGET_VM ($(if [[ "$TARGET_VM" == "media-home" ]]; then echo "canonical home Synology mount"; else echo "legacy shop NFS view"; fi))"
  echo "# Resolution target: $TARGET_VM"
  echo "# Resolution host: $TARGET_HOST"
  echo "# Resolution path: $TARGET_PATH_USED"
  echo "# Downloads path: $DOWNLOADS_PATH"
  echo ""
  echo "## Total Downloads Size"
  echo "Total: $TOTAL_SIZE"
  if [[ "$QUARANTINE_SIZE" != "none" && "$QUARANTINE_SIZE" != "0" ]]; then
    echo "Quarantine: $QUARANTINE_SIZE (classified, pending operator review)"
  fi
  echo ""
  echo "## Age Bucket Analysis"
  echo "Analyzing file ages..."
  echo "< 7 days: $RECENT_COUNT files"
  echo "7-30 days: $WEEK_MONTH_COUNT files"
  echo "30-90 days: $MONTH_QUARTER_COUNT files (bloat candidates)"
  echo "> 90 days: $OLD_COUNT files (high-confidence bloat)"
  echo ""
  echo "## Top 20 Space Consumers"
  echo "Largest items in downloads (top-level directories/files):"
  printf '%s\n' "$TOP_CONSUMERS"
  echo ""
  echo "## Bloat Estimate"
  echo "Files >30 days old: $BLOAT_ESTIMATE"
  echo "Status: $(if [[ $BLOAT_ESTIMATE -gt 100 ]]; then echo "BLOAT_DETECTED"; else echo "ACCEPTABLE"; fi)"
  echo ""
  echo "## Next Actions"
  echo "1. Review top space consumers manually"
  echo "2. Check if items >30 days are:"
  echo "   - Already imported (hardlinked) → safe to remove"
  echo "   - Failed downloads → safe to remove"
  echo "   - Stuck in processing → investigate"
  echo "3. Use dry-run rsync to test moves to cold/quarantine"
  echo "4. DO NOT DELETE without Phase 1 audit manifest approval"
  echo ""
  echo "# Audit complete (read-only, no mutations)"
fi

exit 0
