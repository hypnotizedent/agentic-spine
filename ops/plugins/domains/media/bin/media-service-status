#!/usr/bin/env bash
# media.service.status — Container status for the canonical media-home runtime

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../.." && pwd)"
VM_BINDING="$ROOT/ops/bindings/vm.lifecycle.yaml"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"
SCHEMA_VERSION="2.0.0"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# shellcheck source=/dev/null
source "$SSH_RESOLVE"

usage() {
  cat <<'USAGE'
media.service.status — Container status for the canonical media-home runtime

Args:
  --vm HOST         Only supported value: media-home
  --service NAME    Limit output to one container/service name
  --json            Output JSON format

Examples:
  ./bin/ops cap run media.service.status
  ./bin/ops cap run media.service.status -- --service radarr --json
USAGE
}

VM_FILTER=""
SERVICE_FILTER=""
OUTPUT_JSON=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --vm) VM_FILTER="${2:-}"; shift 2 ;;
    --service) SERVICE_FILTER="${2:-}"; shift 2 ;;
    --json) OUTPUT_JSON=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *) echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { echo "MISSING_DEP: ssh" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }

if [[ -n "$VM_FILTER" && "$VM_FILTER" != "media-home" ]]; then
  echo "FAIL: media.service.status now treats media-home as the only canonical media runtime; requested vm '$VM_FILTER' is legacy/non-authoritative" >&2
  exit 1
fi

resolve_ssh_ref() {
  local vm="media-home"
  local target user host resolved
  target="$(yq -r ".vms[] | select(.hostname == \"$vm\") | .ssh_target // .hostname // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  user="$(yq -r ".vms[] | select(.hostname == \"$vm\") | .ssh_user // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  [[ -n "$target" && "$target" != "null" ]] || return 1

  host="$target"
  if declare -F ssh_resolve_ssh_host_with_fallback >/dev/null 2>&1; then
    resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 2>/dev/null || true)"
    if [[ -n "$resolved" ]]; then
      host="$(awk '{print $1}' <<<"$resolved")"
    fi
  fi

  if [[ -n "$user" && "$user" != "null" ]]; then
    printf '%s@%s\n' "$user" "$host"
  else
    printf '%s\n' "$host"
  fi
}

SSH_REF="$(resolve_ssh_ref)"

ACTIVE_SERVICES=(
  sabnzbd
  qbittorrent
  prowlarr
  radarr
  sonarr
  jellyfin
  navidrome
  jellyseerr
  bazarr
  homarr
  wizarr
  spotisub
  subgen
  watchtower
  node-exporter
)

declare -A CONTAINERS
while IFS=$'\t' read -r name status; do
  [[ -n "$name" ]] || continue
  CONTAINERS["$name"]="$status"
done < <(
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_REF" \
    "sudo docker ps -a --format '{{.Names}}\t{{.Status}}'" 2>/dev/null || true
)

parse_status() {
  local raw="$1"
  if [[ "$raw" =~ ^Up ]]; then
    printf 'running\n'
  elif [[ "$raw" =~ ^Exited ]]; then
    printf 'exited\n'
  elif [[ "$raw" =~ ^Created ]]; then
    printf 'created\n'
  else
    printf 'missing\n'
  fi
}

RESULTS=()
RUNNING=0
EXITED=0
CREATED=0
MISSING=0

SERVICES_TO_CHECK=("${ACTIVE_SERVICES[@]}")
if [[ -n "$SERVICE_FILTER" ]]; then
  SERVICES_TO_CHECK=("$SERVICE_FILTER")
fi

for service in "${SERVICES_TO_CHECK[@]}"; do
  raw="${CONTAINERS[$service]:-}"
  if [[ -z "$raw" ]]; then
    status="missing"
    detail="container-not-found"
  else
    status="$(parse_status "$raw")"
    detail="$raw"
  fi
  RESULTS+=("$service"$'\t'"media-home"$'\t'"$status"$'\t'"$detail")
  case "$status" in
    running) RUNNING=$((RUNNING + 1)) ;;
    exited) EXITED=$((EXITED + 1)) ;;
    created) CREATED=$((CREATED + 1)) ;;
    missing) MISSING=$((MISSING + 1)) ;;
  esac
done

TOTAL=$((RUNNING + EXITED + CREATED + MISSING))
OVERALL="ok"
if [[ $EXITED -gt 0 || $CREATED -gt 0 || $MISSING -gt 0 ]]; then
  OVERALL="warn"
fi

if $OUTPUT_JSON; then
  services_json="$(printf '%s\n' "${RESULTS[@]}" | jq -R -s '
    split("\n")
    | map(select(length > 0))
    | map(split("\t") | {service: .[0], vm: .[1], status: .[2], detail: .[3]})
  ')"
  jq -n \
    --arg capability "media.service.status" \
    --arg schema_version "$SCHEMA_VERSION" \
    --arg generated_at "$GENERATED_AT" \
    --arg status "$OVERALL" \
    --arg service_filter "$SERVICE_FILTER" \
    --argjson services "$services_json" \
    '{
      capability: $capability,
      schema_version: $schema_version,
      generated_at: $generated_at,
      status: $status,
      data: {
        vm_filter: "media-home",
        service_filter: (if $service_filter == "" then null else $service_filter end),
        counts: {
          total: ($services | length),
          running: ($services | map(select(.status == "running")) | length),
          exited: ($services | map(select(.status == "exited")) | length),
          created: ($services | map(select(.status == "created")) | length),
          missing: ($services | map(select(.status == "missing")) | length)
        },
        services: $services
      }
    }'
else
  echo "media.service.status"
  echo "===================="
  printf "%-18s %-12s %s\n" "SERVICE" "STATUS" "DETAIL"
  printf "%-18s %-12s %s\n" "-------" "------" "------"
  for row in "${RESULTS[@]}"; do
    IFS=$'\t' read -r service _vm status detail <<< "$row"
    printf "%-18s %-12s %s\n" "$service" "$status" "$detail"
  done
fi

exit 0
