#!/usr/bin/env bash
# media.import.cli — CLI-driven manual import for Radarr/Sonarr/Lidarr
#
# Usage (via spine):
#   ./bin/ops cap run media.import.cli -- --app radarr --folder /media/downloads/complete/movies/
#   ./bin/ops cap run media.import.cli -- --app sonarr --folder /media/downloads/complete/tv/ --apply
#   ./bin/ops cap run media.import.cli -- --app lidarr --folder /media/downloads/complete/music/ --json
#
# Contract:
# - Scans folder via ARR manual import API
# - Classifies results as MATCHED (has metadata) or UNMATCHED (no metadata)
# - Dry-run default: shows what would be imported
# - --apply: triggers ManualImport command for MATCHED items
# - Replaces web UI import for all ARR apps

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../../../" && pwd)"
SECRETS_EXEC="$ROOT/ops/plugins/infra/secrets/bin/secrets-exec"
SSH_RESOLVE="$ROOT/ops/lib/ssh-resolve.sh"
SERVICES_BINDING="$ROOT/ops/bindings/services.health.yaml"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Re-exec under secrets injection
if [[ -z "${SPINE_SECRETS_INJECTED:-}" ]]; then
  export SPINE_SECRETS_INJECTED=1
  exec "$SECRETS_EXEC" -- "$0" "$@"
fi

# shellcheck source=ops/lib/ssh-resolve.sh
source "$SSH_RESOLVE" 2>/dev/null || true

usage() {
  cat <<'USAGE'
media.import.cli — CLI-driven manual import for ARR apps

Args:
  --app APP       radarr|sonarr|lidarr (required)
  --folder PATH   Folder to scan for importable media (required, path on remote host)
  --apply         Actually trigger import (default: dry-run)
  --json          Output JSON format

Examples:
  ./bin/ops cap run media.import.cli -- --app radarr --folder /media/downloads/complete/movies/
  ./bin/ops cap run media.import.cli -- --app sonarr --folder /media/downloads/complete/tv/ --apply
  ./bin/ops cap run media.import.cli -- --app lidarr --folder /media/downloads/complete/music/ --json
USAGE
}

APP=""
FOLDER=""
DRY_RUN=true
OUTPUT_JSON=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --app)      APP="${2:-}"; shift 2 ;;
    --folder)   FOLDER="${2:-}"; shift 2 ;;
    --apply)    DRY_RUN=false; shift ;;
    --json)     OUTPUT_JSON=true; shift ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift ;;
    *)          echo "FAIL: unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ -n "$APP" ]] || { echo "STOP: --app required (radarr|sonarr|lidarr)" >&2; usage >&2; exit 1; }
[[ -n "$FOLDER" ]] || { echo "STOP: --folder required" >&2; usage >&2; exit 1; }

command -v jq >/dev/null 2>&1 || { echo "MISSING_DEP: jq" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "MISSING_DEP: curl" >&2; exit 2; }
command -v yq >/dev/null 2>&1 || { echo "MISSING_DEP: yq" >&2; exit 2; }
[[ -f "$SERVICES_BINDING" ]] || { echo "STOP: missing binding $SERVICES_BINDING" >&2; exit 2; }

# Resolve app-specific settings
case "$APP" in
  radarr)
    SERVICE_ID="radarr"
    API_VERSION="v3"
    API_KEY_VAR="RADARR_API_KEY"
    API_KEY="${RADARR_API_KEY:-}"
    ENTITY_FIELD="movie"
    ENTITY_ID_FIELD="movieId"
    IMPORT_FILES_KEY="files"
    ;;
  sonarr)
    SERVICE_ID="sonarr"
    API_VERSION="v3"
    API_KEY_VAR="SONARR_API_KEY"
    API_KEY="${SONARR_API_KEY:-}"
    ENTITY_FIELD="series"
    ENTITY_ID_FIELD="seriesId"
    IMPORT_FILES_KEY="files"
    ;;
  lidarr)
    SERVICE_ID="lidarr"
    API_VERSION="v1"
    API_KEY_VAR="LIDARR_API_KEY"
    API_KEY="${LIDARR_API_KEY:-}"
    ENTITY_FIELD="artist"
    ENTITY_ID_FIELD="artistId"
    IMPORT_FILES_KEY="files"
    ;;
  *)
    echo "STOP: invalid --app: $APP (must be radarr|sonarr|lidarr)" >&2
    exit 1
    ;;
esac

# Resolve endpoint URL
BASE_URL="${BASE_URL:-}"
if [[ -z "$BASE_URL" ]]; then
  CANONICAL_URL="$(yq -r ".endpoints[] | select(.id == \"${SERVICE_ID}\") | .url // \"\"" "$SERVICES_BINDING" | head -n1)"
  [[ -n "$CANONICAL_URL" ]] || { echo "STOP: ${SERVICE_ID} missing from services.health.yaml" >&2; exit 2; }
  BASE_URL="$(echo "$CANONICAL_URL" | sed 's|/ping$||; s|/health$||; s|/api/.*||')"
fi

# API key
if [[ -z "$API_KEY" ]]; then
  echo "STOP: ${API_KEY_VAR} not available (secrets injection may have failed)" >&2
  exit 2
fi

# Fetch manual import preview
echo "Scanning folder: $FOLDER via ${APP} manual import API..." >&2
ENCODED_FOLDER="$(python3 -c "import urllib.parse; print(urllib.parse.quote('$FOLDER'))" 2>/dev/null || echo "$FOLDER")"

IMPORT_PREVIEW="$(curl -sf --max-time 60 \
  -H "X-Api-Key: ${API_KEY}" \
  "${BASE_URL}/api/${API_VERSION}/manualimport?folder=${ENCODED_FOLDER}&filterExistingFiles=true" 2>/dev/null)" || {
  echo "FAIL: cannot reach ${APP} manual import API at ${BASE_URL}" >&2
  if $OUTPUT_JSON; then
    jq -n --arg ts "$GENERATED_AT" --arg app "$APP" \
      '{capability: "media.import.cli", app: $app, generated_at: $ts, status: "unreachable", error: "Cannot reach manual import API"}'
  fi
  exit 1
}

TOTAL_ITEMS="$(echo "$IMPORT_PREVIEW" | jq 'length')"

if [[ "$TOTAL_ITEMS" -eq 0 ]]; then
  if $OUTPUT_JSON; then
    jq -n --arg ts "$GENERATED_AT" --arg app "$APP" --arg folder "$FOLDER" \
      '{capability: "media.import.cli", app: $app, generated_at: $ts, folder: $folder, status: "empty", total_items: 0, matched: 0, unmatched: 0}'
  else
    echo "media.import.cli (${APP})"
    echo "========================="
    echo "folder: $FOLDER"
    echo "status: empty (no importable items found)"
    echo "generated_at: $GENERATED_AT"
  fi
  exit 0
fi

# Classify items: MATCHED vs UNMATCHED
# Matched = has the entity field populated (movie/series/artist)
case "$APP" in
  radarr)
    CLASSIFIED="$(echo "$IMPORT_PREVIEW" | jq '
      [.[] | {
        path: .path,
        name: (.name // .path | split("/") | last),
        size: .size,
        quality: .quality.quality.name,
        matched: (.movie != null and .movie.id != null and .movie.id > 0),
        entity_id: (.movie.id // null),
        entity_title: (.movie.title // null),
        rejections: [.rejections[]?.reason // empty]
      }]')"
    ;;
  sonarr)
    CLASSIFIED="$(echo "$IMPORT_PREVIEW" | jq '
      [.[] | {
        path: .path,
        name: (.name // .path | split("/") | last),
        size: .size,
        quality: .quality.quality.name,
        matched: (.series != null and .series.id != null and .series.id > 0),
        entity_id: (.series.id // null),
        entity_title: (.series.title // null),
        episode_ids: [.episodes[]?.id // empty],
        season: (.seasonNumber // null),
        episode: (.episodes[0]?.episodeNumber // null),
        rejections: [.rejections[]?.reason // empty]
      }]')"
    ;;
  lidarr)
    CLASSIFIED="$(echo "$IMPORT_PREVIEW" | jq '
      [.[] | {
        path: .path,
        name: (.name // .path | split("/") | last),
        size: .size,
        quality: .quality.quality.name,
        matched: (.artist != null and .artist.id != null and .artist.id > 0),
        entity_id: (.artist.id // null),
        entity_title: (.artist.artistName // null),
        album_id: (.album.id // null),
        album_title: (.album.title // null),
        track_ids: [.tracks[]?.id // empty],
        rejections: [.rejections[]?.reason // empty]
      }]')"
    ;;
esac

MATCHED_COUNT="$(echo "$CLASSIFIED" | jq '[.[] | select(.matched == true)] | length')"
UNMATCHED_COUNT="$(echo "$CLASSIFIED" | jq '[.[] | select(.matched == false)] | length')"
REJECTED_COUNT="$(echo "$CLASSIFIED" | jq '[.[] | select((.rejections | length) > 0)] | length')"

# Build import payload for matched items
IMPORTED=0
IMPORT_ERRORS=0

if ! $DRY_RUN && [[ "$MATCHED_COUNT" -gt 0 ]]; then
  echo "Importing ${MATCHED_COUNT} matched items..." >&2

  case "$APP" in
    radarr)
      IMPORT_PAYLOAD="$(echo "$IMPORT_PREVIEW" | jq '[.[] | select(.movie != null and .movie.id > 0) | {
        path: .path,
        movieId: .movie.id,
        quality: .quality,
        languages: .languages
      }]')"
      COMMAND_BODY="$(jq -n --argjson files "$IMPORT_PAYLOAD" '{"name": "ManualImport", "files": $files, "importMode": "auto"}')"
      ;;
    sonarr)
      IMPORT_PAYLOAD="$(echo "$IMPORT_PREVIEW" | jq '[.[] | select(.series != null and .series.id > 0) | {
        path: .path,
        seriesId: .series.id,
        episodeIds: [.episodes[]?.id // empty],
        quality: .quality,
        languages: .languages
      }]')"
      COMMAND_BODY="$(jq -n --argjson files "$IMPORT_PAYLOAD" '{"name": "ManualImport", "files": $files, "importMode": "auto"}')"
      ;;
    lidarr)
      IMPORT_PAYLOAD="$(echo "$IMPORT_PREVIEW" | jq '[.[] | select(.artist != null and .artist.id > 0) | {
        path: .path,
        artistId: .artist.id,
        albumId: (.album.id // null),
        trackIds: [.tracks[]?.id // empty],
        quality: .quality
      }]')"
      COMMAND_BODY="$(jq -n --argjson files "$IMPORT_PAYLOAD" '{"name": "ManualImport", "files": $files, "importMode": "auto"}')"
      ;;
  esac

  IMPORT_RESULT="$(curl -sf --max-time 120 -X POST \
    -H "X-Api-Key: ${API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$COMMAND_BODY" \
    "${BASE_URL}/api/${API_VERSION}/command" 2>/dev/null)" || {
    echo "FAIL: import command failed" >&2
    IMPORT_ERRORS=1
  }

  if [[ "$IMPORT_ERRORS" -eq 0 ]]; then
    COMMAND_ID="$(echo "$IMPORT_RESULT" | jq '.id // 0')"
    IMPORTED="$MATCHED_COUNT"
    echo "Import command queued (id=${COMMAND_ID}). Items will process asynchronously." >&2
  fi
fi

MODE="dry-run"
if ! $DRY_RUN; then
  MODE="apply"
fi

if $OUTPUT_JSON; then
  echo "$CLASSIFIED" | jq \
    --arg ts "$GENERATED_AT" \
    --arg app "$APP" \
    --arg folder "$FOLDER" \
    --arg mode "$MODE" \
    --argjson total "$TOTAL_ITEMS" \
    --argjson matched "$MATCHED_COUNT" \
    --argjson unmatched "$UNMATCHED_COUNT" \
    --argjson rejected "$REJECTED_COUNT" \
    --argjson imported "$IMPORTED" \
    --argjson errors "$IMPORT_ERRORS" \
    '{
      capability: "media.import.cli",
      app: $app,
      generated_at: $ts,
      folder: $folder,
      mode: $mode,
      status: (if $errors > 0 then "partial" elif $imported > 0 then "imported" else "report_only" end),
      total_items: $total,
      matched: $matched,
      unmatched: $unmatched,
      rejected: $rejected,
      imported: $imported,
      import_errors: $errors,
      items: .
    }'
else
  echo "media.import.cli (${APP})"
  echo "========================="
  echo "mode: $MODE"
  echo "folder: $FOLDER"
  echo "generated_at: $GENERATED_AT"
  echo ""
  echo "Scan Results:"
  echo "  total_items: $TOTAL_ITEMS"
  echo "  matched:     $MATCHED_COUNT"
  echo "  unmatched:   $UNMATCHED_COUNT"
  echo "  rejected:    $REJECTED_COUNT"

  if ! $DRY_RUN; then
    echo ""
    echo "Import:"
    echo "  imported: $IMPORTED"
    echo "  errors:   $IMPORT_ERRORS"
  fi

  if [[ "$MATCHED_COUNT" -gt 0 ]]; then
    echo ""
    echo "Matched Items:"
    echo "$CLASSIFIED" | jq -r '.[] | select(.matched == true) | "  + \(.entity_title // .name) [\(.quality)] \(.size | . / 1048576 | floor)MB"'
  fi

  if [[ "$UNMATCHED_COUNT" -gt 0 ]]; then
    echo ""
    echo "Unmatched Items (need manual review):"
    echo "$CLASSIFIED" | jq -r '.[] | select(.matched == false) | "  ? \(.name) [\(.quality)] \(.size | . / 1048576 | floor)MB rejections=\(.rejections | length)"'
  fi
fi

if [[ "$IMPORT_ERRORS" -gt 0 ]]; then
  exit 1
fi
exit 0
