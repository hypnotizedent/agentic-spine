#!/usr/bin/env bash
set -euo pipefail

# ha-inventory-snapshot-build — SHIM: delegates to workbench canonical implementation
# Canonical: workbench/agents/home-assistant/tools/spine-plugin-ha/bin/ha-inventory-snapshot-build

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTROL_ROOT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
source "$CONTROL_ROOT/ops/lib/spine-paths.sh"
spine_paths_init >/dev/null 2>&1 || true
WORKBENCH_ROOT="$(spine_resolve_peer_repo workbench)"

CANONICAL="$WORKBENCH_ROOT/agents/home-assistant/tools/spine-plugin-ha/bin/ha-inventory-snapshot-build"
if [[ ! -x "$CANONICAL" ]]; then
  echo "FAIL: canonical script not found: $CANONICAL" >&2
  exit 1
fi

exec "$CANONICAL" "$@"
