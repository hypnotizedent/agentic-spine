#!/usr/bin/env bash
# media-config-restore-drill — governed scratch restore proof for media config-state
# Domain: media
# Safety: mutating
# Approval: auto
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
VM_BINDING="$ROOT/ops/bindings/vm.lifecycle.yaml"
BACKUP_SCHEDULE="$ROOT/ops/bindings/backup.schedule.yaml"
RECEIPT_DIR="$ROOT/mailroom/outbox/reports/restore-drills"
KEEP_ARTIFACTS=0

fail() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

need yq
need ssh
[[ -f "$VM_BINDING" ]] || fail "missing vm lifecycle: $VM_BINDING"
[[ -f "$BACKUP_SCHEDULE" ]] || fail "missing backup schedule: $BACKUP_SCHEDULE"

usage() {
  cat <<'EOF'
Usage: media-config-restore-drill [--keep-artifacts]

Runs a scratch restore drill covering both download-stack and streaming-stack:
  - download-stack: radarr config
  - streaming-stack: jellyfin config

For each stack:
  1. Find latest config artifact from /mnt/docker/backups/media-config/
  2. Extract representative config files to temporary location
  3. Validate config structure and key files present
  4. Cleanup (unless --keep-artifacts)

Writes a single YAML receipt under mailroom/outbox/reports/restore-drills/.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --keep-artifacts) KEEP_ARTIFACTS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

get_vm_ssh_ref() {
  local vm="$1"
  local target user
  target="$(yq e -r ".vms[] | select(.hostname == \"$vm\") | .ssh_target // .hostname // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  user="$(yq e -r ".vms[] | select(.hostname == \"$vm\") | .ssh_user // \"\"" "$VM_BINDING" 2>/dev/null || true)"
  [[ -n "$target" && "$target" != "null" ]] || return 1
  if [[ -n "$user" && "$user" != "null" ]]; then
    echo "${user}@${target}"
  else
    echo "$target"
  fi
}

yaml_quote() {
  python3 - <<'PY' "$1"
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

download_stack_ssh="$(get_vm_ssh_ref "download-stack" 2>/dev/null || true)"
streaming_stack_ssh="$(get_vm_ssh_ref "streaming-stack" 2>/dev/null || true)"
[[ -n "$download_stack_ssh" ]] || fail "no ssh target found for download-stack"
[[ -n "$streaming_stack_ssh" ]] || fail "no ssh target found for streaming-stack"

download_ssh() { ssh $SSH_OPTS "$download_stack_ssh" "$@"; }
streaming_ssh() { ssh $SSH_OPTS "$streaming_stack_ssh" "$@"; }

RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DAY="$(date -u +%Y%m%d)"
mkdir -p "$RECEIPT_DIR"
RECEIPT_PATH="$RECEIPT_DIR/media-config-restore-drill-${RUN_DAY}.yaml"

RESULT="PASS"
ERROR_MSG=""
declare -a DRILL_RESULTS=()

run_stack_drill() {
  local stack="$1"
  local ssh_ref="$2"
  local service="$3"
  local config_key_file="$4"

  local backup_root="/mnt/docker/backups/media-config"
  local latest_backup
  latest_backup="$(ssh $SSH_OPTS "$ssh_ref" \
    "find '$backup_root' -maxdepth 1 -type f -name '${stack}-config-*.tar.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-" || true)"

  if [[ -z "$latest_backup" ]]; then
    echo "  $stack: FAIL (no backup found)"
    DRILL_RESULTS+=("$stack|FAIL|no_backup_found||")
    RESULT="FAIL"
    return 1
  fi

  local drill_dir="/tmp/media-config-drill-${stack}-${RUN_TS}"
  local restore_output
  local restore_error

  set +e
  restore_output="$(ssh $SSH_OPTS "$ssh_ref" bash -s -- "$latest_backup" "$drill_dir" "$service" "$config_key_file" "$KEEP_ARTIFACTS" <<'REMOTE_SCRIPT' 2>&1
set -euo pipefail
backup_file="$1"
drill_dir="$2"
service="$3"
config_key_file="$4"
keep_artifacts="${5:-0}"

cleanup() {
  if [[ "$keep_artifacts" != "1" ]]; then
    rm -rf "$drill_dir"
  fi
}
trap cleanup EXIT

rm -rf "$drill_dir"
mkdir -p "$drill_dir"

# Extract to temp location
tar -xzf "$backup_file" -C "$drill_dir"

# Find the service config path in extracted backup
service_paths=(
  "mnt/docker/volumes/${service}/config"
  "opt/appdata/${service}"
)

found_path=""
for sp in "${service_paths[@]}"; do
  if [[ -d "$drill_dir/$sp" ]]; then
    found_path="$drill_dir/$sp"
    break
  fi
done

[[ -n "$found_path" ]] || { echo "service config path not found in backup" >&2; exit 1; }

# Verify key config file exists
if [[ ! -f "$found_path/$config_key_file" ]]; then
  echo "key config file missing: $config_key_file" >&2
  exit 2
fi

# Verify config is valid (basic structure check)
file_count="$(find "$found_path" -type f | wc -l | tr -d ' ')"
[[ "$file_count" -gt 0 ]] || { echo "config directory empty" >&2; exit 3; }

echo "OK: restored $file_count files, key file verified"
REMOTE_SCRIPT
)"
  local rc=$?
  set -e

  if [[ $rc -eq 0 ]]; then
    echo "  $stack: PASS"
    local backup_basename
    backup_basename="$(basename "$latest_backup")"
    DRILL_RESULTS+=("$stack|PASS|$backup_basename|$service|$config_key_file")
  else
    echo "  $stack: FAIL (restore error)"
    restore_error="$(echo "$restore_output" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g' | sed 's/^ //; s/ $//')"
    DRILL_RESULTS+=("$stack|FAIL|restore_failed||$restore_error")
    RESULT="FAIL"
    ERROR_MSG="${ERROR_MSG}${stack}: ${restore_error}; "
  fi
}

echo "=== Media Config Restore Drill ==="
echo "timestamp: $RUN_TS"

run_stack_drill "download-stack" "$download_stack_ssh" "radarr" "config.xml"
run_stack_drill "streaming-stack" "$streaming_stack_ssh" "jellyfin" "system.xml"

ERROR_MSG="${ERROR_MSG%; }"

{
  echo "kind: media_config_restore_drill"
  echo "version: 1"
  echo "generated_at: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  echo "result: $RESULT"
  echo "target:"
  echo "  download_stack_ssh_ref: $(yaml_quote "$download_stack_ssh")"
  echo "  streaming_stack_ssh_ref: $(yaml_quote "$streaming_stack_ssh")"
  echo "artifacts:"
  for drill_line in "${DRILL_RESULTS[@]}"; do
    IFS='|' read -r stack result backup service config_file <<< "$drill_line"
    echo "  - stack: $(yaml_quote "$stack")"
    echo "    result: $(yaml_quote "$result")"
    if [[ -n "$backup" ]]; then
      echo "    backup: $(yaml_quote "$backup")"
    else
      echo "    backup: null"
    fi
    if [[ -n "$service" ]]; then
      echo "    service: $(yaml_quote "$service")"
    else
      echo "    service: null"
    fi
    if [[ -n "$config_file" ]]; then
      echo "    key_config_file: $(yaml_quote "$config_file")"
    else
      echo "    key_config_file: null"
    fi
  done
  echo "restore:"
  echo "  mode: scratch_extract_verify"
  echo "  keep_artifacts: $([[ "$KEEP_ARTIFACTS" -eq 1 ]] && echo true || echo false)"
  echo "comparison:"
  echo "  download_stack:"
  download_result="${DRILL_RESULTS[0]%%|*}"
  echo "    result: $(yaml_quote "${download_result##*|}")"
  echo "  streaming_stack:"
  streaming_result="${DRILL_RESULTS[1]%%|*}"
  echo "    result: $(yaml_quote "${streaming_result##*|}")"
  if [[ -n "$ERROR_MSG" ]]; then
    echo "error: $(yaml_quote "$ERROR_MSG")"
  else
    echo "error: null"
  fi
} >"$RECEIPT_PATH"

echo "receipt: $RECEIPT_PATH"
echo "result: $RESULT"
if [[ -n "$ERROR_MSG" ]]; then
  echo "error: $ERROR_MSG"
fi

if [[ "$RESULT" != "PASS" ]]; then
  exit 1
fi
