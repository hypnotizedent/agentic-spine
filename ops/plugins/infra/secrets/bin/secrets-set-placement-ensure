#!/usr/bin/env bash
# secrets-set-placement-ensure - smallest governed mutating secrets-placement
# primitive (PACKET-905). Wraps the existing infisical-agent.sh set path with
# stdin-only value handling, idempotent no-op detection, and a governed
# receipt that never contains the secret value (sha256 fingerprint only).
#
# This is the first L2 governed mutating cap on the secrets surface. Existing
# secrets.* caps are all read-only; this cap closes the gap surfaced by the
# runway readback when an L2 key needs placement and the operator declines to
# go around governance via direct infisical CLI.
#
# Stop lines (enforced by this script):
# - No --value flag on the cap surface; value comes from stdin only.
# - No secret value in stdout, stderr, or receipt body.
# - No deletion (only create/update via infisical-agent.sh set).
# - No registration of new secret paths (path comes from registered policy
#   via infisical-agent.sh resolve_secret_path; unregistered paths fail at
#   that guard).
# - Default behavior is dry-run; --apply --reason both required to mutate.
#
# Usage:
#   printf '%s' '<value>' | secrets-set-placement-ensure \
#       --project <name> --env prod --key <KEY> --apply --reason '<text>'
#   secrets-set-placement-ensure --project <name> --env prod --key <KEY> [--dry-run]
#
# Exit codes:
#   0   placed (created or updated) or already-present idempotent
#   1   API/wrapper error
#   2   bad usage / missing dependency / dry-run skipped (no --apply)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/secrets-root.sh
source "$SCRIPT_DIR/../lib/secrets-root.sh"
secrets_bind_control_root
SPINE_STATE="${SPINE_STATE:-$HOME/code/.runtime/spine/state}"

stop(){ echo "STOP ($1): $2" >&2; exit "$1"; }

command -v shasum >/dev/null 2>&1 || stop 2 "missing dependency: shasum"
command -v python3 >/dev/null 2>&1 || stop 2 "missing dependency: python3"

PROJECT=""
ENV="prod"
KEY=""
APPLY=0
REASON=""
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --env) ENV="$2"; shift 2 ;;
    --key) KEY="$2"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --reason) REASON="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) sed -n '2,33p' "$0"; exit 0 ;;
    --value|--value=*)
      stop 2 "--value is forbidden by design; pipe value via stdin instead"
      ;;
    *) stop 2 "unknown arg: $1" ;;
  esac
done

[[ -n "$PROJECT" ]] || stop 2 "--project required"
[[ -n "$KEY" ]] || stop 2 "--key required"
[[ "$KEY" =~ ^[A-Za-z0-9_]+$ ]] || stop 2 "--key must match [A-Za-z0-9_]+"
if [[ "$APPLY" -eq 1 && -z "$REASON" ]]; then
  stop 2 "--apply requires --reason '<text>'"
fi
if [[ "$APPLY" -eq 1 && "$DRY_RUN" -eq 1 ]]; then
  stop 2 "--apply and --dry-run are mutually exclusive"
fi

INFISICAL="${SPINE_ROOT}/ops/plugins/providers/bin/infisical-agent.sh"
[[ -x "$INFISICAL" ]] || stop 2 "infisical-agent.sh not executable at $INFISICAL"

# Probe current value. Honor the wrapper's exit code: infisical-agent.sh
# can write diagnostic/error text (e.g. "unregistered key route") to
# stdout in failure paths, so reading stdout alone is NOT enough to know
# whether a real value was returned. A non-zero exit means no value
# (unregistered policy route, missing key, or auth failure); treat that
# as absent. The cap then either creates (apply path) or surfaces the
# absence honestly (dry-run path).
set +e
CURRENT="$("$INFISICAL" get "$PROJECT" "$ENV" "$KEY" 2>/dev/null)"
GET_RC=$?
set -e
KEY_PRESENT_BEFORE="false"
CURRENT_SHA="absent"
GET_DIAG="ok"
if [[ "$GET_RC" -ne 0 ]]; then
  CURRENT=""
  GET_DIAG="get_rc_${GET_RC}"
elif [[ -n "$CURRENT" ]]; then
  KEY_PRESENT_BEFORE="true"
  CURRENT_SHA="$(printf '%s' "$CURRENT" | shasum -a 256 | awk '{print $1}')"
fi

# Read stdin value only when applying. Dry-run does not require a value.
VALUE=""
NEW_SHA="absent"
if [[ "$APPLY" -eq 1 ]]; then
  if [[ -t 0 ]]; then
    stop 2 "--apply requires value via stdin (printf '%s' '<value>' | ...). TTY stdin refused."
  fi
  VALUE="$(cat)"
  # Trim a single trailing newline (echo-style input) but preserve embedded newlines.
  VALUE="${VALUE%$'\n'}"
  [[ -n "$VALUE" ]] || stop 2 "stdin value is empty"
  NEW_SHA="$(printf '%s' "$VALUE" | shasum -a 256 | awk '{print $1}')"
fi

# Determine outcome
if [[ "$KEY_PRESENT_BEFORE" == "true" ]]; then
  if [[ "$APPLY" -eq 1 && "$CURRENT_SHA" == "$NEW_SHA" ]]; then
    OUTCOME="idempotent_no_op"
    PLAN="none"
  elif [[ "$APPLY" -eq 1 ]]; then
    OUTCOME="updated"
    PLAN="patch"
  else
    OUTCOME="present_unverified"
    PLAN="patch_or_idempotent_pending_value"
  fi
else
  if [[ "$APPLY" -eq 1 ]]; then
    OUTCOME="created"
    PLAN="post"
  else
    OUTCOME="would_create"
    PLAN="post"
  fi
fi

# Receipt path
RECEIPT_DIR="${SPINE_STATE}/domain-state/secrets/placement"
mkdir -p "$RECEIPT_DIR"
SAFE_KEY="$(echo "$KEY" | tr -c 'A-Za-z0-9_' '_')"
RECEIPT_PATH="${RECEIPT_DIR}/${PROJECT}-${SAFE_KEY}-latest.yaml"
GENERATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

write_receipt() {
  local mode="$1"
  python3 - "$RECEIPT_PATH" "$mode" "$PROJECT" "$ENV" "$KEY" \
    "$KEY_PRESENT_BEFORE" "$CURRENT_SHA" "$NEW_SHA" "$OUTCOME" \
    "$GENERATED_AT" "$REASON" <<'PYEOF'
import sys, yaml
(out, mode, project, env, key,
 key_present_before, current_sha, new_sha, outcome, generated_at, reason) = sys.argv[1:]
data = {
  "proof_class": "secrets_placement_proof",
  "capability": "secrets.set.placement.ensure",
  "generated_at": generated_at,
  "mode": mode,
  "reason": reason or None,
  "outcome": outcome,
  "placement": {
    "project": project,
    "environment": env,
    "key": key,
    "key_present_before": (key_present_before == "true"),
    "current_value_sha256": current_sha,
    "applied_value_sha256": new_sha,
  },
  "scope_note": (
    "Governed mutating secrets placement primitive. Value never appears in "
    "stdout, stderr, or receipt body — only sha256 fingerprint is recorded "
    "for audit. Idempotent: applied mode with current_value_sha256 == "
    "applied_value_sha256 returns no-op without re-writing."
  ),
  "stop_lines_respected": [
    "no --value flag on cap surface (stdin only)",
    "no value in stdout",
    "no value in stderr (--apply path on success path discards subprocess output)",
    "no value in receipt body (sha256 fingerprint only)",
    "no deletion (cap creates or updates only)",
    "no path registration (relies on infisical-agent.sh resolve_secret_path guard)",
  ],
}
with open(out, "w", encoding="utf-8") as fh:
    yaml.safe_dump(data, fh, sort_keys=False)
PYEOF
}

print_render() {
  local mode="$1"
  echo "secrets.set.placement.ensure"
  echo "project: $PROJECT"
  echo "env: $ENV"
  echo "key: $KEY"
  echo "mode: $mode"
  if [[ -n "$REASON" ]]; then echo "reason: $REASON"; fi
  echo "outcome: $OUTCOME"
  echo "plan: $PLAN"
  echo "key_present_before: $KEY_PRESENT_BEFORE"
  if [[ "$KEY_PRESENT_BEFORE" == "true" ]]; then
    echo "current_value_sha256: $CURRENT_SHA"
  fi
  if [[ "$APPLY" -eq 1 ]]; then
    echo "applied_value_sha256: $NEW_SHA"
  fi
  echo "receipt: $RECEIPT_PATH"
}

# Dry-run path: never writes the canonical receipt (preserves prior applied
# state if any) and never mutates Infisical.
if [[ "$APPLY" -eq 0 || "$DRY_RUN" -eq 1 ]]; then
  print_render "dry_run"
  echo "(dry run; no API mutation; canonical receipt not written)"
  if [[ "$APPLY" -eq 0 ]]; then
    echo "(default-safe: pipe value via stdin and pass --apply --reason '<text>' to mutate)"
    exit 2
  fi
  exit 0
fi

# Apply path
if [[ "$OUTCOME" == "idempotent_no_op" ]]; then
  write_receipt "applied"
  print_render "applied"
  unset VALUE CURRENT
  exit 0
fi

# Call infisical-agent.sh set. Subprocess argv will briefly contain the value
# (existing pattern in the codebase). Stdout from the wrapper may contain the
# success message but never the value; we discard it for safety.
if ! "$INFISICAL" set "$PROJECT" "$ENV" "$KEY" "$VALUE" >/dev/null 2>&1; then
  unset VALUE
  stop 1 "infisical-agent.sh set failed (path may be unregistered or auth missing)"
fi

# Verify by re-reading
RE_CURRENT="$("$INFISICAL" get "$PROJECT" "$ENV" "$KEY" 2>/dev/null || true)"
if [[ -z "$RE_CURRENT" ]]; then
  unset VALUE RE_CURRENT
  stop 1 "post-apply readback returned no value (write may have silently failed)"
fi
RE_SHA="$(printf '%s' "$RE_CURRENT" | shasum -a 256 | awk '{print $1}')"
if [[ "$RE_SHA" != "$NEW_SHA" ]]; then
  unset VALUE RE_CURRENT
  stop 1 "post-apply readback sha256 mismatch (expected $NEW_SHA, got $RE_SHA)"
fi
unset RE_CURRENT

# Update CURRENT_SHA with the post-apply fingerprint for the receipt.
CURRENT_SHA="$RE_SHA"

write_receipt "applied"
print_render "applied"
unset VALUE
exit 0
