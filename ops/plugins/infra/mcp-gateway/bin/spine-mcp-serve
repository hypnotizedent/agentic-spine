AGENT_ROUTE_BIN = os.path.join(
    SPINE_ROOT, "ops", "plugins", "core", "agent", "bin", "agent-route"
)
SPINE_CONTROL_BIN = os.path.join(
    SPINE_ROOT, "ops", "plugins", "core", "evidence", "bin", "spine-control"
)
SAFE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
RUNTIME_ENV = _normalized_runtime_env(SPINE_ROOT)
DEFAULT_CAP_RUN_MAX_CHARS = int(os.environ.get("SPINE_MCP_CAP_RUN_MAX_CHARS", "16000"))
ROLE_PREFIXES: List[str] = []  # set once in main() from mcp.role.scope.yaml

