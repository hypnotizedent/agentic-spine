def _agent_tools_available() -> bool:
    if not os.path.isfile(AGENTS_REGISTRY_FILE):
        return False
    for path in (AGENT_INFO_BIN, AGENT_TOOLS_BIN, AGENT_ROUTE_BIN):
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            return False
    return True


AGENT_TOOLS_ENABLED = _agent_tools_available()
TOOLS = BASE_TOOLS + (AGENT_TOOLS if AGENT_TOOLS_ENABLED else [])
TOOL_NAMES = {tool["name"] for tool in TOOLS}


def read_message() -> Tuple[Optional[Dict[str, Any]], bool]:
    while True:
        line = sys.stdin.readline()
        if line == "":
            return None, True
        line = line.strip()
        if not line:
            continue
        try:
            return json.loads(line), False
        except json.JSONDecodeError:
            continue


def write_message(payload: Dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def sanitize_noise(text: str) -> str:
    lines = []
    for line in (text or "").splitlines():
        lower = line.lower()
        if "new release of infisical" in lower:
            continue
        if "brew update" in lower:
            continue
        if line.startswith("INF "):
            continue
        if "Injecting" in line:
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def run_cmd(
    args: List[str],
    *,
    stdin_text: Optional[str] = None,
    cwd: Optional[str] = None,
    timeout: int = 180,
) -> Tuple[int, str, str]:
    result = subprocess.run(
        args,
        cwd=cwd or SPINE_ROOT,
        input=stdin_text,
        capture_output=True,
        text=True,
        env=RUNTIME_ENV,
        timeout=timeout,
    )
    stdout = sanitize_noise(result.stdout)
    stderr = sanitize_noise(result.stderr)
    return result.returncode, stdout, stderr


def load_capabilities() -> Dict[str, Any]:
    code, out, err = run_cmd(
        ["yq", "e", "-o=json", ".capabilities", CAPABILITIES_FILE],
        timeout=30,
    )
    if code != 0:
        raise RuntimeError(f"failed to read capability registry: {err or out}")
    try:
        parsed = json.loads(out or "{}")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid capabilities json output: {exc}") from exc
    if not isinstance(parsed, dict):
        raise RuntimeError("capability registry did not parse as an object")
    return parsed


def load_agents_registry() -> Dict[str, Any]:
    code, out, err = run_cmd(
        ["yq", "e", "-o=json", ".", AGENTS_REGISTRY_FILE],
        timeout=30,
    )
    if code != 0:
        raise RuntimeError(f"failed to read agent registry: {err or out}")
    try:
        parsed = json.loads(out or "{}")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid agent registry json output: {exc}") from exc
    if not isinstance(parsed, dict):
        raise RuntimeError("agent registry did not parse as an object")
    return parsed


def _normalize_legacy_cap_args(raw: Any) -> List[str]:
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(x) for x in raw]
    if isinstance(raw, str):
        text = raw.strip()
        if not text:
            return []
        if text.startswith("[") and text.endswith("]"):
            try:
                parsed = json.loads(text)
            except json.JSONDecodeError:
                parsed = None
            if isinstance(parsed, list):
                return [str(x) for x in parsed]
            inner = text[1:-1].strip()
            if inner:
                items = []
                for part in inner.split(","):
                    cleaned = part.strip().strip("\"'")
                    if cleaned:
                        items.append(cleaned)
                if items:
                    return items
        return shlex.split(text)
    raise RuntimeError("args must be an array of strings or a string")


def normalize_cap_args(raw: Any, *, argv: Any = None, shell_args: Any = None) -> List[str]:
    if argv is not None and shell_args is not None:
        raise RuntimeError("pass either argv or shell_args, not both")
    if argv is not None:
        if not isinstance(argv, list):
            raise RuntimeError("argv must be an array of strings")
        return [str(x) for x in argv]
    if shell_args is not None:
        if not isinstance(shell_args, str):
            raise RuntimeError("shell_args must be a string")
        return shlex.split(shell_args)
    return _normalize_legacy_cap_args(raw)


def _extract_cap_metadata(text: str, prefix: str) -> str:
    for raw in (text or "").splitlines():
        s = raw.strip()
        if not s.startswith(prefix):
            continue
        val = s.split(prefix, 1)[1].strip()
        if val:
            return val
    return ""


def _bounded_cap_output(stdout: str, stderr: str, *, full_output: bool, max_chars: Optional[int]) -> str:
    combined = f"{stdout}\n{stderr}".strip() if stderr else (stdout or "").strip()
    if not combined:
        return "(no output)"
    if full_output:
        return combined

    limit = DEFAULT_CAP_RUN_MAX_CHARS if max_chars is None else int(max_chars)
    if limit < 200:
        raise RuntimeError("max_chars must be at least 200")
    if limit > 200000:
        raise RuntimeError("max_chars must be at most 200000")
    if len(combined) <= limit:
        return combined

    run_key = _extract_cap_metadata(combined, "Run Key:")
    receipt = _extract_cap_metadata(combined, "Receipt:")
    output_path = _extract_cap_metadata(combined, "Output:")
    preview = combined[:limit].rstrip()
    note = (
        f"[truncated interactive cap_run output at {limit} chars; "
        "rerun with full_output=true or inspect the receipt/output artifact]"
    )

    parts: List[str] = []
    if run_key:
        parts.append(f"Run Key: {run_key}")
    if receipt:
        parts.append(f"Receipt: {receipt}")
    if output_path:
        parts.append(f"Output: {output_path}")
    if parts:
        parts.append("")
    parts.append(preview)
    parts.append("")
    parts.append(note)
    return "\n".join(parts).strip()


def _load_role_prefixes() -> List[str]:
    """Load allowed capability prefixes for the current execution class."""
    scope_file = os.path.join(
        SPINE_ROOT, "ops", "bindings", "mcp.role.scope.yaml"
    )
    if not os.path.isfile(scope_file):
        return []  # no scope file = no filtering
    try:
        code, out, _ = run_cmd(
            ["yq", "e", "-o=json", ".", scope_file], timeout=10
        )
        if code != 0:
            return []
        parsed = json.loads(out or "{}")
        roles = parsed.get("roles", {})
        role = RUNTIME_ENV.get("SPINE_EXECUTION_CLASS") or RUNTIME_ENV.get("SPINE_RUNTIME_ROLE", "researcher")
        role_def = roles.get(role, roles.get("researcher", {}))
        return role_def.get("prefixes", [])
    except Exception:
        return []  # fail open — no filtering on error


def _prefix_allowed(name: str, prefixes: List[str]) -> bool:
    """Check if a capability name is allowed by the role prefix list."""
    if not prefixes or "*" in prefixes:
        return True
    return any(name.startswith(p) for p in prefixes)


def run_capability(
    name: str,
    cap_args: List[str],
    confirm: bool,
    *,
    full_output: bool = False,
    max_chars: Optional[int] = None,
) -> str:
    if not SAFE_NAME.match(name or ""):
        raise RuntimeError("invalid capability name")

    # Role-scope enforcement
    if not _prefix_allowed(name, ROLE_PREFIXES):
        raise RuntimeError(
            f"capability '{name}' is outside your role scope. "
            f"Your role allows: {', '.join(ROLE_PREFIXES)}"
        )

    capabilities = load_capabilities()
    meta = capabilities.get(name)
    if not isinstance(meta, dict):
        raise RuntimeError(f"unknown capability: {name}")

    approval = str(meta.get("approval", "")).strip()
    cmd = [OPS_BIN, "cap", "run", name, *cap_args]
    stdin_text = None

    if approval == "manual":
        if not confirm:
            raise RuntimeError(
                f"capability '{name}' requires manual approval; "
                "rerun with confirm=true to forward approval"
            )
        stdin_text = "yes\n"

    code, out, err = run_cmd(cmd, stdin_text=stdin_text, timeout=600)
    bounded = _bounded_cap_output(out, err, full_output=full_output, max_chars=max_chars)
    if code != 0:
        detail = bounded or "no output"
        raise RuntimeError(f"cap_run failed for {name} (rc={code}): {detail}")
    return bounded


def _meta_command_help(meta: Dict[str, Any]) -> str:
    command = str(meta.get("command", "")).strip()
    if not command:
        return ""
    try:
        argv = shlex.split(command)
    except ValueError:
        return ""
    if not argv:
        return ""

    cwd = str(meta.get("cwd", "")).strip() or SPINE_ROOT
    # Expand using RUNTIME_ENV (which has SPINE_CODE/SPINE_ROOT set),
    # not os.environ (which may lack them in the MCP server process).
    for var, val in RUNTIME_ENV.items():
        cwd = cwd.replace(f"${var}", val).replace(f"${{{var}}}", val)
    cwd = os.path.expanduser(cwd)
    if not os.path.isabs(cwd):
        cwd = os.path.join(SPINE_ROOT, cwd)

    code, out, err = run_cmd(argv + ["--help"], timeout=20, cwd=cwd)
    text = sanitize_noise("\n".join(part for part in (out, err) if part).strip())
    if not text:
        return ""
    if code == 0 or "usage" in text.lower() or "--help" in text.lower():
        return text
    return ""


def list_capabilities(filter_text: Optional[str], safety: Optional[str]) -> str:
    capabilities = load_capabilities()
    rows = []
    needle = (filter_text or "").strip().lower()
    safety_filter = (safety or "").strip()

    for name in sorted(capabilities.keys()):
        meta = capabilities.get(name) or {}
        cap_safety = str(meta.get("safety", "")).strip()
        if needle and needle not in name.lower():
            continue
        if safety_filter and cap_safety != safety_filter:
            continue
        # Role-scope filtering
        if not _prefix_allowed(name, ROLE_PREFIXES):
            continue
        rows.append({
            "name": name,
            "safety": cap_safety,
            "approval": str(meta.get("approval", "")).strip(),
            "description": str(meta.get("description", "")).strip(),
            "arg_protocol": str(meta.get("arg_protocol", "")).strip() or "passthrough",
            "flags": meta.get("flags") or [],
            "examples": meta.get("examples") or [],
        })

    return json.dumps(
        {
            "count": len(rows),
            "capabilities": rows,
        },
        indent=2,
        sort_keys=False,
    )


def capability_info(name: str, *, include_help: bool = False) -> str:
    name = (name or "").strip()
    if not SAFE_NAME.match(name):
        raise RuntimeError("invalid capability name")

    capabilities = load_capabilities()
    meta = capabilities.get(name)
    if not isinstance(meta, dict):
        raise RuntimeError(f"unknown capability: {name}")

    info = dict(meta)
    info["name"] = name
    info["arg_protocol"] = str(meta.get("arg_protocol", "")).strip() or "passthrough"
    info["flags"] = meta.get("flags") or []
    info["examples"] = meta.get("examples") or []
    if include_help:
        help_text = _meta_command_help(meta)
        if help_text:
            info["help_output"] = help_text

    return json.dumps(info, indent=2, sort_keys=False)


def list_agents(filter_text: Optional[str], domain: Optional[str], status: Optional[str]) -> str:
    registry = load_agents_registry()
    agents = registry.get("agents") or []
    if not isinstance(agents, list):
        agents = []

    needle = (filter_text or "").strip().lower()
    domain_filter = (domain or "").strip()
    status_filter = (status or "").strip()

    rows: List[Dict[str, Any]] = []
    for agent in agents:
        if not isinstance(agent, dict):
            continue
        agent_id = str(agent.get("id", "")).strip()
        agent_domain = str(agent.get("domain", "")).strip()
        agent_status = str(agent.get("implementation_status", "")).strip()
        agent_description = str(agent.get("description", "")).strip()
        agent_contract = str(agent.get("contract", "")).strip()
        if domain_filter and agent_domain != domain_filter:
            continue
        if status_filter and agent_status != status_filter:
            continue
        if needle:
            haystack = f"{agent_id} {agent_domain} {agent_description}".lower()
            if needle not in haystack:
                continue
        rows.append(
            {
                "id": agent_id,
                "domain": agent_domain,
                "status": agent_status,
                "description": agent_description,
                "contract": agent_contract,
            }
        )

    rows.sort(key=lambda row: row.get("id", ""))
    return json.dumps(
        {
            "count": len(rows),
            "agents": rows,
        },
        indent=2,
        sort_keys=False,
    )


def _json_from_cmd(args: List[str], *, timeout: int = 120) -> Dict[str, Any]:
    code, out, err = run_cmd(args, timeout=timeout)
    text = (out or "").strip() or (err or "").strip()
    if not text:
        raise RuntimeError(f"empty output from command: {' '.join(args)}")
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"expected JSON output from command: {' '.join(args)}") from exc
    if not isinstance(parsed, dict):
        raise RuntimeError(f"expected JSON object output from command: {' '.join(args)}")
    if code != 0:
        status = str(parsed.get("status", "")).strip()
        if status not in {"not_found", "error"}:
            raise RuntimeError(f"command failed (rc={code}): {text}")
    return parsed


def agent_info(agent_id: str) -> str:
    agent_id = (agent_id or "").strip()
    if not agent_id:
        raise RuntimeError("agent_id is required")
    payload = _json_from_cmd([AGENT_INFO_BIN, agent_id, "--json"])
    return json.dumps(payload, indent=2, sort_keys=False)


def agent_tools(agent_id: str) -> str:
    agent_id = (agent_id or "").strip()
    if not agent_id:
        raise RuntimeError("agent_id is required")
    payload = _json_from_cmd([AGENT_TOOLS_BIN, agent_id, "--json"])
    return json.dumps(payload, indent=2, sort_keys=False)


def route_resolve(input_value: str) -> str:
    input_value = (input_value or "").strip()
    if not input_value:
        raise RuntimeError("input is required")
    payload = _json_from_cmd([AGENT_ROUTE_BIN, "--json", input_value])
    return json.dumps(payload, indent=2, sort_keys=False)


def run_rag(subcommand: str, *args: str) -> str:
    cmd = [SECRETS_EXEC, "--", RAG_BIN, subcommand, *args]
    code, out, err = run_cmd(cmd, timeout=300)
    if code != 0:
        raise RuntimeError(f"rag {subcommand} failed (rc={code}): {err or out}")
    if err:
        return f"{out}\n{err}".strip()
    return out or "(no output)"


def run_spine_broker(command: str, *args: str) -> str:
    payload = _json_from_cmd([SPINE_CONTROL_BIN, command, "--json", *args])
    return json.dumps(payload, indent=2, sort_keys=False)


def handle_initialize(msg: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "spine-mcp-gateway", "version": "1.0.0"},
        },
    }


def handle_tools_list(msg: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {"tools": TOOLS},
    }


def handle_tools_call(msg: Dict[str, Any]) -> Dict[str, Any]:
    name = msg.get("params", {}).get("name")
    arguments = msg.get("params", {}).get("arguments", {})

    if name not in TOOL_NAMES:
        return {
            "jsonrpc": "2.0",
            "id": msg.get("id"),
            "error": {"code": -32601, "message": f"Unknown tool: {name}"},
        }

    try:
        if name == "cap_list":
            text = list_capabilities(
                arguments.get("filter"),
                arguments.get("safety"),
            )
        elif name == "cap_run":
            cap_name = arguments.get("name", "")
            cap_args = normalize_cap_args(
                arguments.get("args"),
                argv=arguments.get("argv"),
                shell_args=arguments.get("shell_args"),
            )
            confirm_raw = arguments.get("confirm", False)
            if not isinstance(confirm_raw, bool):
                raise RuntimeError("confirm must be a boolean")
            confirm = confirm_raw
            full_output_raw = arguments.get("full_output", False)
            if not isinstance(full_output_raw, bool):
                raise RuntimeError("full_output must be a boolean")
            max_chars_raw = arguments.get("max_chars")
            if max_chars_raw is not None and not isinstance(max_chars_raw, int):
                raise RuntimeError("max_chars must be an integer")
            text = run_capability(
                cap_name,
                cap_args,
                confirm,
                full_output=full_output_raw,
                max_chars=max_chars_raw,
            )
        elif name == "cap_info":
            include_help_raw = arguments.get("include_help", False)
            if not isinstance(include_help_raw, bool):
                raise RuntimeError("include_help must be a boolean")
            text = capability_info(
                str(arguments.get("name", "")),
                include_help=include_help_raw,
            )
        elif name == "agent_list":
            text = list_agents(
                arguments.get("filter"),
                arguments.get("domain"),
                arguments.get("status"),
            )
        elif name == "agent_info":
            text = agent_info(str(arguments.get("agent_id", "")))
        elif name == "agent_tools":
            text = agent_tools(str(arguments.get("agent_id", "")))
        elif name == "route_resolve":
            text = route_resolve(str(arguments.get("input", "")))
        elif name == "rag_query":
            text = run_capability(
                "rag.anythingllm.ask",
                [arguments["question"]],
                False,
            )
        elif name == "rag_retrieve":
            limit = int(arguments.get("limit", 5))
            text = run_rag("retrieve", arguments["query"], "--limit", str(limit))
        elif name == "rag_health":
            text = run_capability("rag.health", [], False)
        elif name == "get_latest_loop":
            broker_args: List[str] = []
            if bool(arguments.get("include_closed")):
                broker_args.append("--include-closed")
            text = run_spine_broker("latest-loop", *broker_args)
        elif name == "get_loop_status":
            broker_args = []
            if bool(arguments.get("latest")):
                broker_args.append("--latest")
            elif arguments.get("loop_id"):
                broker_args.extend(["--loop-id", str(arguments.get("loop_id"))])
            else:
                raise RuntimeError("loop_id is required unless latest=true")
            text = run_spine_broker("loop-status", *broker_args)
        elif name == "get_loop_progress":
            broker_args = []
            if bool(arguments.get("latest")):
                broker_args.append("--latest")
            elif arguments.get("loop_id"):
                broker_args.extend(["--loop-id", str(arguments.get("loop_id"))])
            else:
                raise RuntimeError("loop_id is required unless latest=true")
            text = run_spine_broker("loop-progress", *broker_args)
        elif name == "get_request_attestation":
            request_id = str(arguments.get("request_id", "")).strip()
            if not request_id:
                raise RuntimeError("request_id is required")
            text = run_spine_broker("request-attestation", "--request-id", request_id)
        else:
            return {
                "jsonrpc": "2.0",
                "id": msg["id"],
                "error": {"code": -32601, "message": f"Unknown tool: {name}"},
            }

        return {
            "jsonrpc": "2.0",
            "id": msg["id"],
            "result": {
                "content": [{"type": "text", "text": text}]
            },
        }
    except Exception as exc:
        return {
            "jsonrpc": "2.0",
            "id": msg.get("id"),
            "result": {
                "content": [{"type": "text", "text": f"Error: {exc}"}],
                "isError": True,
            },
        }


def bootstrap_session() -> None:
    """Warm the runtime by confirming the core CLI surfaces are reachable."""
    status_cmd = [OPS_BIN, "cap", "list"]
    try:
        result = subprocess.run(
            status_cmd,
            cwd=SPINE_ROOT,
            capture_output=True,
            text=True,
            env=RUNTIME_ENV,
            timeout=60,
        )
        if result.returncode != 0:
            print(
                f"[spine-mcp-serve] ops cap list failed (rc={result.returncode}): "
                f"{(result.stderr or result.stdout or 'unknown error').strip()[:200]}",
                file=sys.stderr,
            )
            RUNTIME_ENV["SPINE_MCP_SESSION"] = "degraded"
            return
        RUNTIME_ENV["SPINE_MCP_SESSION"] = "ready"
        print(
            "[spine-mcp-serve] runtime warmup complete: ops cap list reachable",
            file=sys.stderr,
        )
    except Exception as exc:
        print(
            f"[spine-mcp-serve] runtime warmup error: {exc}",
            file=sys.stderr,
        )
        RUNTIME_ENV["SPINE_MCP_SESSION"] = "degraded"


def main() -> int:
    terminal_role = (
        RUNTIME_ENV.get("SPINE_TERMINAL_ID")
        or RUNTIME_ENV.get("OPS_TERMINAL_ID")
        or RUNTIME_ENV.get("OPS_TERMINAL_ROLE")
        or RUNTIME_ENV.get("SPINE_TERMINAL_ROLE")
        or RUNTIME_ENV.get("SPINE_TERMINAL_NAME")
        or "unset"
    )
    runtime_role = RUNTIME_ENV.get("SPINE_EXECUTION_CLASS") or RUNTIME_ENV.get("SPINE_RUNTIME_ROLE") or "researcher"
    RUNTIME_ENV["SPINE_EXECUTION_CLASS"] = runtime_role
    RUNTIME_ENV["SPINE_RUNTIME_ROLE"] = runtime_role
    print(
        f"[spine-mcp-serve] terminal_role={terminal_role} runtime_role={runtime_role}",
        file=sys.stderr,
    )

    bootstrap_session()

    global ROLE_PREFIXES
    ROLE_PREFIXES = _load_role_prefixes()
    print(
        f"[spine-mcp-serve] role_scope: {len(ROLE_PREFIXES)} prefixes "
        f"for role={runtime_role}"
        + (f" ({', '.join(ROLE_PREFIXES)})" if ROLE_PREFIXES and "*" not in ROLE_PREFIXES else ""),
        file=sys.stderr,
    )
    if not AGENT_TOOLS_ENABLED:
        print(
            "[spine-mcp-serve] agent registry tooling disabled: "
            "missing agents.registry.yaml or agent-* helper binaries",
            file=sys.stderr,
        )

    while True:
        msg, eof = read_message()
        if eof:
            break
        if msg is None:
            continue

        method = msg.get("method")
        msg_id = msg.get("id")

        if method == "initialize":
            write_message(handle_initialize(msg))
        elif method == "notifications/initialized":
            continue
        elif method == "tools/list":
            write_message(handle_tools_list(msg))
        elif method == "tools/call":
            write_message(handle_tools_call(msg))
        elif method == "ping":
            write_message({"jsonrpc": "2.0", "id": msg_id, "result": {}})
        elif msg_id is not None:
            write_message(
                {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method not found: {method}",
                    },
                }
            )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
