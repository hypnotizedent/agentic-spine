#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"
DISCOVER_SCRIPT="$SPINE_ROOT/ops/plugins/infra/observability/bin/baremetal-idrac-discover"

if [[ ! -x "$DISCOVER_SCRIPT" ]]; then
    echo "STOP (2): baremetal-idrac-discover script not found at $DISCOVER_SCRIPT" >&2
    exit 2
fi

exec "$DISCOVER_SCRIPT" --target-id idrac-shop --legacy-text "$@"
