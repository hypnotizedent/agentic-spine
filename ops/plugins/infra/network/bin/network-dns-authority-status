#!/usr/bin/env bash
set -euo pipefail

# network.dns.authority.status
# Read-only: verify DNS authority stack health on canonical home Pi-hole.
# Checks Unbound, Pi-hole upstream config, and DNSSEC.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"
# shellcheck source=ops/lib/ssh-resolve.sh
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

PIHOLE_HOST="${PIHOLE_HOME_HOST:-$(ssh_resolve_ssh_host_with_fallback pihole-home 2>/dev/null | awk '{print $1}')}"
PIHOLE_USER="${PIHOLE_HOME_USER:-$(ssh_resolve_user pihole-home 2>/dev/null || true)}"
SSH_OPTS="-o ConnectTimeout=15 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
[[ -n "$PIHOLE_HOST" ]] || { echo "ERROR: cannot resolve pihole-home SSH host" >&2; exit 1; }
[[ -n "$PIHOLE_USER" ]] || PIHOLE_USER="ubuntu"
PIHOLE_SSH_REF="${PIHOLE_USER}@${PIHOLE_HOST}"

pass=0
fail=0
total=0

check() {
  local label="$1"
  local result="$2"
  total=$((total + 1))
  if [[ "$result" == "PASS" ]]; then
    echo "  PASS: $label"
    pass=$((pass + 1))
  else
    echo "  FAIL: $label — $3"
    fail=$((fail + 1))
  fi
}

echo "network.dns.authority.status"
echo "target: pihole-home ($PIHOLE_SSH_REF)"
echo

# ── 1. SSH reachability ──────────────────────────────────────────────────
if ! ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'echo ok' >/dev/null 2>&1; then
  echo "  FAIL: SSH unreachable at $PIHOLE_SSH_REF"
  echo
  echo "summary: 0/1 checks passed (SSH unreachable)"
  echo "status: FAIL"
  exit 1
fi

# ── 2. Unbound service status ───────────────────────────────────────────
UNBOUND_STATUS="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'systemctl is-active unbound 2>/dev/null' || echo 'inactive')"
if [[ "$UNBOUND_STATUS" == "active" ]]; then
  check "unbound service active" "PASS" ""
else
  check "unbound service active" "FAIL" "status=$UNBOUND_STATUS"
fi

# ── 3. Unbound responds to dig on port 5335 ─────────────────────────────
UNBOUND_DIG="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'dig @127.0.0.1 -p 5335 cloudflare.com +short +time=5 2>/dev/null' || true)"
if [[ -n "$UNBOUND_DIG" && "$UNBOUND_DIG" != *"timed out"* && "$UNBOUND_DIG" != *"SERVFAIL"* ]]; then
  check "unbound responds on port 5335" "PASS" ""
else
  check "unbound responds on port 5335" "FAIL" "response='$UNBOUND_DIG'"
fi

# ── 4. Pi-hole upstream points to Unbound ────────────────────────────────
UPSTREAMS="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'sudo grep -A6 "upstreams = \[" /etc/pihole/pihole.toml 2>/dev/null' || true)"
if echo "$UPSTREAMS" | grep -q '127.0.0.1#5335'; then
  check "Pi-hole upstream includes Unbound (127.0.0.1#5335)" "PASS" ""
else
  check "Pi-hole upstream includes Unbound (127.0.0.1#5335)" "FAIL" "upstreams do not include Unbound"
fi

# ── 5. Pi-hole upstream does NOT include public DNS ──────────────────────
HAS_PUBLIC="$(echo "$UPSTREAMS" | grep -E '"(1\.1\.1\.1|1\.0\.0\.1|8\.8\.8\.8|8\.8\.4\.4|9\.9\.9\.9)"' || true)"
if [[ -z "$HAS_PUBLIC" ]]; then
  check "Pi-hole upstream has no public DNS servers" "PASS" ""
else
  check "Pi-hole upstream has no public DNS servers" "FAIL" "found public upstream: $HAS_PUBLIC"
fi

# ── 6. DNSSEC validation ────────────────────────────────────────────────
# sigok.verteiltesysteme.net should resolve; sigfail should not
SIGOK="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'dig @127.0.0.1 -p 5335 sigok.verteiltesysteme.net +short +time=5 +tries=2 2>/dev/null | grep -E "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" | tail -1' || true)"
if [[ -n "$SIGOK" ]]; then
  check "DNSSEC sigok resolves" "PASS" ""
else
  check "DNSSEC sigok resolves" "FAIL" "response='$SIGOK'"
fi

# ── 7. Pi-hole FTL running ──────────────────────────────────────────────
FTL_STATUS="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'systemctl is-active pihole-FTL 2>/dev/null' || echo 'inactive')"
if [[ "$FTL_STATUS" == "active" ]]; then
  check "pihole-FTL service active" "PASS" ""
else
  check "pihole-FTL service active" "FAIL" "status=$FTL_STATUS"
fi

# ── 8. Full chain test (Pi-hole → Unbound → root) ──────────────────────
CHAIN_DIG="$(ssh $SSH_OPTS "$PIHOLE_SSH_REF" 'dig @127.0.0.1 google.com +short +time=5 2>/dev/null' || true)"
if [[ -n "$CHAIN_DIG" && "$CHAIN_DIG" != *"timed out"* && "$CHAIN_DIG" != *"SERVFAIL"* ]]; then
  check "full chain (Pi-hole → Unbound) resolves" "PASS" ""
else
  check "full chain (Pi-hole → Unbound) resolves" "FAIL" "response='$CHAIN_DIG'"
fi

echo
echo "summary: ${pass}/${total} checks passed"
if [[ $fail -gt 0 ]]; then
  echo "status: FAIL"
  exit 1
fi
echo "status: PASS"
