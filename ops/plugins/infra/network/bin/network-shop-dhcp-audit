#!/usr/bin/env bash
set -euo pipefail

# network.shop.dhcp.audit — Read back shop UniFi DHCP reservations as folded DHCP intent
# Uses UNIFI_SHOP_API_KEY via X-API-KEY header (no cookie auth needed).
# Proxied through PVE SSH (UDR6 is LAN-only).

# PACKET-1371: private network branch producer. Direct operator invocation is
# rejected — operators read network.presence.status. This cap is only legal in
# an internal/scheduler producer context (SPINE_INTERNAL_PRODUCER=1).
if [[ "${SPINE_INTERNAL_PRODUCER:-0}" != "1" ]]; then
  cat >&2 <<'STOP'
STOP (PACKET-1371): network.shop.dhcp.audit is a private network branch producer.
  Operators read the Network branch via:
      ./bin/ops cap run network.presence.status
  Direct invocation requires SPINE_INTERNAL_PRODUCER=1 (scheduler/internal context).
STOP
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../../../core/snapshot/lib/snapshot-surface-common.sh"

snapshot_surface_init "ops/bindings/shop.dhcp.audit.yaml" "$@"

SPINE_ROOT="$SNAPSHOT_SURFACE_ROOT"
REGISTRY="$SPINE_ROOT/ops/bindings/shop.device.registry.yaml"
SSH_BINDING="$SPINE_ROOT/ops/bindings/ssh.targets.yaml"
INFISICAL_AGENT="$SPINE_ROOT/ops/plugins/providers/bin/infisical-agent.sh"
SITE_PRESENCE_AUTHORITY="site.presence.status"
INTENT_ROLE="folded_declared_dhcp_reservation_intent"
TRACKED_SUMMARY_FILE="$SNAPSHOT_SURFACE_TRACKED_OUTPUT"
SUMMARY_FILE="$SNAPSHOT_SURFACE_OUTPUT"
MODE="$SNAPSHOT_SURFACE_MODE"
TMPDIR_WORK=$(mktemp -d)
trap 'rm -rf "$TMPDIR_WORK"' EXIT

usage() {
  cat <<'USAGE'
network-shop-dhcp-audit

Usage:
  SPINE_INTERNAL_PRODUCER=1 ./bin/ops cap run network.shop.dhcp.audit
  SPINE_INTERNAL_PRODUCER=1 ./bin/ops cap run network.shop.dhcp.audit -- --apply

Flags:
  --apply               Write tracked projection binding.
  --check               Read-only mode (default): write runtime state only.
  --state-path <path>   Override output path (defaults to runtime state path).
USAGE
}

if [[ "${#SNAPSHOT_SURFACE_REMAINING_ARGS[@]}" -gt 0 ]]; then
  echo "network-shop-dhcp-audit FAIL: unknown arg '${SNAPSHOT_SURFACE_REMAINING_ARGS[0]}'" >&2
  usage >&2
  exit 1
fi

if [[ -z "$SUMMARY_FILE" ]]; then
  echo "network-shop-dhcp-audit FAIL: summary path cannot be empty" >&2
  exit 1
fi

echo "network.shop.dhcp.audit"
echo

# ── Dependencies ──
command -v yq >/dev/null 2>&1 || { echo "STOP (2): missing dependency: yq"; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "STOP (2): missing dependency: jq"; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "STOP (2): missing dependency: python3"; exit 2; }
[[ -f "$REGISTRY" ]] || { echo "STOP (2): shop.device.registry.yaml not found"; exit 2; }

# ── Resolve API key ──
API_KEY="${UNIFI_SHOP_API_KEY:-}"
if [[ -z "$API_KEY" && -f "$INFISICAL_AGENT" ]]; then
  API_KEY="$(SPINE_ROOT="$SPINE_ROOT" SPINE_REPO="$SPINE_ROOT" SPINE_CODE="$SPINE_ROOT" "$INFISICAL_AGENT" get-cached infrastructure prod UNIFI_SHOP_API_KEY 2>/dev/null || true)"
fi
if [[ -z "$API_KEY" ]]; then
  echo "STOP (2): UNIFI_SHOP_API_KEY not available (check Infisical infrastructure/prod)"
  exit 2
fi

# ── Resolve SSH proxy ──
PROXY_HOST="$(yq -r '.ssh.targets[] | select(.id == "pve") | .host' "$SSH_BINDING")"
PROXY_USER="$(yq -r '.ssh.targets[] | select(.id == "pve") | .user // "root"' "$SSH_BINDING")"
UDR_HOST="$(yq -r '.ssh.targets[] | select(.id == "udr-shop") | .host' "$SSH_BINDING")"

SSH_OPTS="-o ConnectTimeout=10 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR"

# ── Query UniFi API for all configured clients ──
api_b64="$(printf '%s' "$API_KEY" | base64)"

ssh $SSH_OPTS "${PROXY_USER}@${PROXY_HOST}" "bash -s" <<SSHEOF > "$TMPDIR_WORK/clients_raw.json" 2>/dev/null
set -euo pipefail
api_key="\$(echo '$api_b64' | base64 -d)"
curl -sk "https://${UDR_HOST}/proxy/network/api/s/default/rest/user" \
  -H "X-API-KEY: \${api_key}" \
  -H "Accept: application/json" 2>/dev/null
SSHEOF

[[ -s "$TMPDIR_WORK/clients_raw.json" ]] || { echo "STOP (2): UniFi API query failed or returned empty"; exit 2; }

if ! jq -e '.data | type == "array"' "$TMPDIR_WORK/clients_raw.json" >/dev/null; then
  echo "STOP (2): UniFi API response missing array .data field"
  jq -r '.meta.msg? // .meta.rc? // .error? // "unknown UniFi response shape"' "$TMPDIR_WORK/clients_raw.json" 2>/dev/null || true
  exit 2
fi

jq '.data' "$TMPDIR_WORK/clients_raw.json" > "$TMPDIR_WORK/clients.json"
[[ -s "$TMPDIR_WORK/clients.json" ]] || { echo "STOP (2): UniFi API response missing .data field"; exit 2; }

# ── Extract DHCP reservations (clients with fixed_ip) ──
jq '[.[] | select(.fixed_ip != null) | {
  mac: .mac,
  ip: .fixed_ip,
  hostname: (.hostname // .name // "unknown"),
  use_fixedip: (.use_fixedip // false)
}]' "$TMPDIR_WORK/clients.json" > "$TMPDIR_WORK/reservations.json"

RESERVATION_COUNT=$(jq 'length' "$TMPDIR_WORK/reservations.json")

echo "Found $RESERVATION_COUNT DHCP reservations on shop UDR6"
echo

# ── Build summary ──
# Output lock fragments kept literal for D448:
# canonical_site_presence: $SITE_PRESENCE_AUTHORITY
# intent_source: ops/bindings/shop.device.registry.yaml
# folded_into_first_class_system
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
python3 - "$TMPDIR_WORK/reservations.json" "$TMPDIR_WORK/clients.json" "$REGISTRY" "$SUMMARY_FILE" "$TIMESTAMP" "$SITE_PRESENCE_AUTHORITY" "$INTENT_ROLE" "$MODE" <<'PY'
import json
import sys
from pathlib import Path
from typing import Any

import yaml

reservations_path = Path(sys.argv[1])
clients_path = Path(sys.argv[2])
registry_path = Path(sys.argv[3])
summary_path = Path(sys.argv[4])
timestamp = sys.argv[5]
site_presence_authority = sys.argv[6]
intent_role = sys.argv[7]
mode = sys.argv[8]


def mac(value: Any) -> str:
    return str(value or "").strip().lower()


reservations = json.loads(reservations_path.read_text(encoding="utf-8"))
clients = json.loads(clients_path.read_text(encoding="utf-8"))
registry = yaml.safe_load(registry_path.read_text(encoding="utf-8")) or {}
registry_devices = [row for row in (registry.get("devices") or []) if isinstance(row, dict)]
registry_macs = {mac(row.get("mac")) for row in registry_devices if mac(row.get("mac"))}
registry_ips = {str(row.get("ip") or "").strip() for row in registry_devices if row.get("ip")}


def _name_tokens(value: Any) -> set[str]:
    text = str(value or "").lower()
    out: set[str] = set()
    if not text:
        return out
    out.add(text)
    cleaned = "".join(ch if ch.isalnum() or ch in "-_ " else " " for ch in text)
    for token in cleaned.split():
        if len(token) >= 4:
            out.add(token)
    return out


registry_name_tokens: set[str] = set()
for row in registry_devices:
    registry_name_tokens |= _name_tokens(row.get("name"))
    registry_name_tokens |= _name_tokens(row.get("hostname"))

# PACKET-1317: classify unregistered shop UniFi clients into honest
# folded-input buckets so the 55-row set stops floating as audit-only bloat.
# Categories preserve packet vocabulary; node admission authority is NOT
# inferred here — site.presence.status remains canonical.
TRANSIENT_PREFIXES = (
    "iphone",
    "ipad",
    "macbook",
    "mac",
    "mike-s-",
    "ronnys-",
    "sm-r",
    "sm-g",
    "galaxy",
    "pixel",
    "android",
    "tablet-",
    "laptop-",
    "desktop-",
)


def _is_transient(host: str) -> bool:
    h = host.lower().strip()
    if not h or h == "unknown":
        return False
    return any(h.startswith(p) for p in TRANSIENT_PREFIXES)


unregistered_clients: list[dict[str, Any]] = []
seen_ips: dict[str, str] = {}
for client in clients:
    if not isinstance(client, dict):
        continue
    client_mac = mac(client.get("mac"))
    if not client_mac or client_mac in registry_macs:
        continue
    host = client.get("hostname") or client.get("name") or "unknown"
    ip_value = client.get("ip") or client.get("last_ip") or ""
    unregistered_clients.append(
        {
            "mac": client_mac,
            "ip": ip_value,
            "hostname": host,
        }
    )
    if ip_value:
        seen_ips.setdefault(str(ip_value), client_mac)

# Detect IP collisions across the unregistered set (same IP on >1 MAC) — a
# strong signal of stale UniFi snapshot artifacts; bucket those explicitly.
ip_macs: dict[str, set[str]] = {}
for entry in unregistered_clients:
    ip_value = str(entry.get("ip") or "")
    if not ip_value:
        continue
    ip_macs.setdefault(ip_value, set()).add(entry["mac"])
collision_ips = {ip for ip, macs in ip_macs.items() if len(macs) > 1}

classification: dict[str, list[dict[str, Any]]] = {
    "already_declared_other_key": [],
    "transient_non_node": [],
    "observed_only_unknown": [],
    "stale_snapshot_artifact": [],
    "candidate_pending_admission": [],
}
for entry in unregistered_clients:
    host = str(entry.get("hostname") or "").strip()
    host_lower = host.lower()
    ip_value = str(entry.get("ip") or "")
    declared_match = False
    if host_lower and host_lower != "unknown":
        if host_lower in registry_name_tokens:
            declared_match = True
        else:
            for token in _name_tokens(host):
                if token in registry_name_tokens:
                    declared_match = True
                    break
    if not declared_match and ip_value and ip_value in registry_ips:
        declared_match = True
    bucket: str
    if declared_match:
        bucket = "already_declared_other_key"
    elif ip_value and ip_value in collision_ips:
        bucket = "stale_snapshot_artifact"
    elif _is_transient(host):
        bucket = "transient_non_node"
    elif host_lower in {"", "unknown"}:
        bucket = "observed_only_unknown"
    else:
        bucket = "candidate_pending_admission"
    classification[bucket].append(entry)

classification_summary = {bucket: len(rows) for bucket, rows in classification.items()}

payload = {
    "status": "generated",
    "schema_version": 1,
    "status": "folded_dhcp_audit_observation",
    "generated": timestamp,
    "source": "UDR6 UniFi API via PVE SSH proxy",
    "mode": mode,
    "canonical_site_presence": site_presence_authority,
    "authority_boundary": {
        "intent_source": "ops/bindings/shop.device.registry.yaml",
        "intent_role": intent_role,
        "folded_into_first_class_system": site_presence_authority,
        "does_not_decide": [
            "current_site_presence",
            "site_profile_authority",
            "node_admission",
            "role_assignment",
        ],
    },
    "summary": {
        "total_reservations": len(reservations),
        "unifi_clients_total": len(clients),
        "unregistered_clients": len(unregistered_clients),
        "unregistered_classification": classification_summary,
        "last_audit": timestamp,
    },
    "reservations": reservations,
    "unregistered_clients": unregistered_clients,
    "unregistered_classification": classification,
}

with summary_path.open("w", encoding="utf-8") as handle:
    handle.write("# Auto-generated by network.shop.dhcp.audit — do not edit manually\n")
    yaml.safe_dump(payload, handle, sort_keys=False)
PY

echo "Audit complete. Results written to: $SUMMARY_FILE"

if [[ "$MODE" == "apply" ]]; then
  if [[ "$SUMMARY_FILE" != "$TRACKED_SUMMARY_FILE" ]]; then
    cp "$SUMMARY_FILE" "$TRACKED_SUMMARY_FILE"
    echo "Tracked binding updated: $TRACKED_SUMMARY_FILE"
  else
    echo "Tracked binding co-located with summary: $TRACKED_SUMMARY_FILE"
  fi
fi
