#!/usr/bin/env bash
set -euo pipefail

# network.shop.dhcp.reservation.create — wrapper for unifi-shop-agent.sh reservation-create
# Mutating: creates a DHCP reservation on the shop UDR6.

SPINE_ROOT="${SPINE_ROOT:-$HOME/code/agentic-spine}"
AGENT="$SPINE_ROOT/ops/plugins/providers/bin/unifi-shop-agent.sh"

[[ -x "$AGENT" ]] || { echo "STOP (2): missing unifi-shop-agent.sh"; exit 2; }

echo "network.shop.dhcp.reservation.create"
echo

"$AGENT" reservation-create "$@"
