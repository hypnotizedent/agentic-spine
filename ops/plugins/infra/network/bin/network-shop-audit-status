#!/usr/bin/env bash
# network-shop-audit-status - Composite shop-network parity audit (local files only)
#
# Checks (no SSH/ping; pure structured bindings):
#  1) Duplicate IPs in ssh.targets.yaml (IPv4 only)
#  2) ssh.targets.yaml ↔ vm.lifecycle.yaml IP parity (shop VMs)
#  3) Coverage: vm.lifecycle shop VMs with ssh_target must exist in ssh.targets.yaml
#
# All checks read structured bindings only. No markdown parsing.
# Historical checks that cross-referenced DEVICE_IDENTITY_SSOT.md and
# SHOP_SERVER_SSOT.md were retired — those docs are no longer runtime authority.
#
# Exit:
#  0 PASS
#  1 FAIL (drift findings)
#  2 STOP (preconditions)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../../.." && pwd)}"

BINDING="$SPINE_ROOT/ops/bindings/ssh.targets.yaml"
VM_LIFECYCLE="$SPINE_ROOT/ops/bindings/vm.lifecycle.yaml"

stop(){ echo "STOP (2): $*" >&2; exit 2; }

command -v yq >/dev/null 2>&1 || stop "missing dependency: yq (brew install yq)"
[[ -f "$BINDING" ]] || stop "missing binding: $BINDING"
[[ -f "$VM_LIFECYCLE" ]] || stop "missing binding: $VM_LIFECYCLE"

tmpdir="$(mktemp -d /tmp/network-shop-audit.XXXXXX)"
cleanup(){ rm -rf "$tmpdir" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

findings=0

echo "network.shop.audit.status"
echo "binding: $BINDING"
echo "vm-lifecycle: $VM_LIFECYCLE"
echo

# ── Extract bindings: id -> host (IPv4 only) ───────────────────────────────
bindings_tsv="$tmpdir/bindings.tsv"
yq -r '.ssh.targets[] | [.id, (.host // "")] | @tsv' "$BINDING" \
  | awk -F'\t' 'NF>=2 && $1!="null" && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1 "\t" $2}' \
  > "$bindings_tsv"

# ── Extract shop VMs from vm.lifecycle.yaml: ssh_target -> lan_ip ──────────
vmlife_tsv="$tmpdir/vmlife.tsv"
yq -r '
  .vms[]
  | select(.proxmox_host == "pve")
  | select(.lan_ip != null)
  | select(.ssh_target != null)
  | [.ssh_target, (.lan_ip | tostring)] | @tsv
' "$VM_LIFECYCLE" \
  | awk -F'\t' 'NF>=2 && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1 "\t" $2}' \
  > "$vmlife_tsv"

echo -n "check 1: duplicate IPs in bindings... "
dup_report="$tmpdir/dup.txt"
awk -F'\t' '{print $2}' "$bindings_tsv" | sort | uniq -c | awk '$1>1 {print $2 "\t" $1}' > "$dup_report" || true
if [[ -s "$dup_report" ]]; then
  echo "FAIL"
  while IFS=$'\t' read -r ip count; do
    ids="$(awk -F'\t' -v ip="$ip" '$2==ip {print $1}' "$bindings_tsv" | tr '\n' ' ' | sed 's/ $//')"
    echo "  DRIFT: duplicate_ip ip=$ip count=$count ids=[$ids]"
  done < "$dup_report"
  findings=$((findings + $(wc -l <"$dup_report" | tr -d ' ')))
else
  echo "OK"
fi

echo -n "check 2: ssh.targets ↔ vm.lifecycle IP parity... "
par2="$tmpdir/par2.txt"
> "$par2"
while IFS=$'\t' read -r dev vip; do
  bip="$(awk -F'\t' -v d="$dev" '$1==d {print $2; exit}' "$bindings_tsv")"
  if [[ -n "$bip" && "$bip" != "$vip" ]]; then
    printf '%s\t%s\t%s\n' "$dev" "$bip" "$vip" >> "$par2"
  fi
done < "$vmlife_tsv"
if [[ -s "$par2" ]]; then
  echo "FAIL"
  while IFS=$'\t' read -r dev bip vip; do
    echo "  DRIFT: ${dev} ssh.targets=${bip} vm.lifecycle=${vip}"
    echo "    fix: $VM_LIFECYCLE or $BINDING"
  done < "$par2"
  findings=$((findings + $(wc -l <"$par2" | tr -d ' ')))
else
  echo "OK"
fi

echo -n "check 3: coverage (vm.lifecycle shop VMs → ssh.targets)... "
par3="$tmpdir/par3.txt"
> "$par3"
while IFS=$'\t' read -r dev _ip; do
  if ! awk -F'\t' -v d="$dev" '$1==d {found=1; exit} END {exit !found}' "$bindings_tsv" 2>/dev/null; then
    echo "$dev" >> "$par3"
  fi
done < "$vmlife_tsv"
if [[ -s "$par3" ]]; then
  echo "FAIL"
  while read -r dev; do
    echo "  DRIFT: missing_binding id=${dev}"
    echo "    fix: $BINDING (add ssh.targets entry for \`${dev}\`)"
  done < "$par3"
  findings=$((findings + $(wc -l <"$par3" | tr -d ' ')))
else
  echo "OK"
fi

echo
echo "DRIFT FINDINGS: $findings"
echo
if [[ "$findings" -eq 0 ]]; then
  echo "result: PASS"
  exit 0
fi
echo "result: FAIL (${findings} drift finding(s))"
exit 1
