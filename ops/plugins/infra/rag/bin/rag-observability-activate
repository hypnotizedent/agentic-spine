#!/usr/bin/env bash
# RAG Observability Activation
# Installs or checks the textfile collector cron job for RAG reindex metrics
# on ai-consolidation.
#
# Modes:
#   --dry-run   (default) Show what would be installed without doing anything
#   --status    Check if the cron is installed and .prom file is being updated
#   --install   SSH to ai-consolidation and install the cron + textfile directory
#
# Bindings consumed:
#   - rag.remote.runner.yaml (SSH target)
#   - rag.observability.contract.yaml (paths, intervals)
#
# Safety: read-only by default. --install is the only mutation flag.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
git_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "${git_root:-}" && "${git_root:-}" != "null" ]]; then
  SP="${SPINE_ROOT:-$git_root}"
else
  SP="${SPINE_ROOT:-$(cd "$script_dir/../../../../.." && pwd)}"
fi

RUNNER_BINDING="$SP/ops/bindings/domains/rag/rag.remote.runner.yaml"
OBS_CONTRACT="$SP/ops/bindings/domains/rag/rag.observability.contract.yaml"

fail() { echo "FAIL: $*" >&2; exit 1; }

for t in yq ssh; do
  command -v "$t" >/dev/null 2>&1 || fail "missing required tool: $t"
done
[[ -f "$RUNNER_BINDING" ]] || fail "runner binding not found: $RUNNER_BINDING"
[[ -f "$OBS_CONTRACT" ]] || fail "observability contract not found: $OBS_CONTRACT"

read_runner() { yq -r "$1 // \"\"" "$RUNNER_BINDING"; }
read_obs() { yq -r "$1 // \"\"" "$OBS_CONTRACT"; }

# --- Parse flags ---
MODE="dry-run"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) MODE="dry-run"; shift ;;
    --status)  MODE="status";  shift ;;
    --install) MODE="install"; shift ;;
    --) shift; break ;;
    *) fail "unknown flag: $1" ;;
  esac
done

# --- Read bindings ---
REMOTE_HOST="$(read_runner '.remote.host')"
REMOTE_USER="$(read_runner '.remote.user')"
REMOTE_PORT="$(read_runner '.remote.port')"
REMOTE_REPO="$(read_runner '.remote.repo_path')"

[[ -n "$REMOTE_HOST" ]] || fail ".remote.host missing in runner binding"
[[ -n "$REMOTE_USER" ]] || fail ".remote.user missing in runner binding"
[[ -n "$REMOTE_REPO" ]] || fail ".remote.repo_path missing in runner binding"

if [[ -z "$REMOTE_PORT" || "$REMOTE_PORT" == "null" ]]; then
  REMOTE_PORT="22"
fi

TEXTFILE_PATH="$(read_obs '.exporter.textfile_path_hint')"
INTERVAL_SEC="$(read_obs '.exporter.recommended_interval_sec')"

[[ -n "$TEXTFILE_PATH" ]] || fail "textfile_path_hint missing in observability contract"
[[ -n "$INTERVAL_SEC" ]] || fail "recommended_interval_sec missing in observability contract"

# Derive textfile directory and cron interval
TEXTFILE_DIR="$(dirname "$TEXTFILE_PATH")"
INTERVAL_MIN=$(( INTERVAL_SEC / 60 ))
if [[ "$INTERVAL_MIN" -lt 1 ]]; then
  INTERVAL_MIN=1
fi

# The exporter path on ai-consolidation (repo is rsynced there)
REMOTE_EXPORTER="${REMOTE_REPO}/ops/plugins/infra/rag/bin/rag-reindex-metrics-export"

TARGET="${REMOTE_USER}@${REMOTE_HOST}"
SSH_ARGS=(-o BatchMode=yes -o ConnectTimeout=10 -p "$REMOTE_PORT")

# Cron comment marker for identification
CRON_MARKER="# spine:rag-reindex-metrics"
CRON_LINE="*/${INTERVAL_MIN} * * * * ${REMOTE_EXPORTER} --local > ${TEXTFILE_PATH} 2>/dev/null ${CRON_MARKER}"

# --- Mode: dry-run ---
if [[ "$MODE" == "dry-run" ]]; then
  echo "mode=dry-run"
  echo "target=${TARGET}"
  echo "ssh_port=${REMOTE_PORT}"
  echo "textfile_dir=${TEXTFILE_DIR}"
  echo "textfile_path=${TEXTFILE_PATH}"
  echo "interval_min=${INTERVAL_MIN}"
  echo "exporter_path=${REMOTE_EXPORTER}"
  echo "cron_line=${CRON_LINE}"
  echo ""
  echo "Actions that --install would perform:"
  echo "  1. Check node_exporter with textfile collector is running"
  echo "  2. Create ${TEXTFILE_DIR} if it does not exist"
  echo "  3. Install cron job: ${CRON_LINE}"
  echo "  4. Run exporter once to seed initial .prom file"
  exit 0
fi

# --- Mode: status ---
if [[ "$MODE" == "status" ]]; then
  echo "target=${TARGET}"

  # Check SSH reachability
  if ! ssh "${SSH_ARGS[@]}" "$TARGET" "echo ok >/dev/null" 2>/dev/null; then
    echo "ssh_reachable=false"
    echo "status=unreachable"
    exit 1
  fi
  echo "ssh_reachable=true"

  # Check node_exporter running
  ne_running="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "pgrep -x node_exporter >/dev/null 2>&1 && echo true || echo false" 2>/dev/null || echo "unknown")"
  echo "node_exporter_running=${ne_running}"

  # Check textfile collector arg
  ne_textfile="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "ps aux 2>/dev/null | grep -o 'textfile.directory=[^ ]*' | head -1 || echo none" 2>/dev/null || echo "unknown")"
  echo "node_exporter_textfile_arg=${ne_textfile}"

  # Check textfile dir exists
  dir_exists="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "[ -d '$TEXTFILE_DIR' ] && echo true || echo false" 2>/dev/null || echo "unknown")"
  echo "textfile_dir_exists=${dir_exists}"

  # Check .prom file exists and age
  prom_info="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "if [ -f '$TEXTFILE_PATH' ]; then
       age=\$(( \$(date +%s) - \$(stat -c %Y '$TEXTFILE_PATH' 2>/dev/null || echo 0) ))
       echo \"exists=true age_seconds=\${age}\"
     else
       echo 'exists=false age_seconds=-1'
     fi" 2>/dev/null || echo "exists=unknown age_seconds=-1")"
  echo "prom_file=${prom_info}"

  # Check cron installed
  cron_installed="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "crontab -l 2>/dev/null | grep -q 'spine:rag-reindex-metrics' && echo true || echo false" 2>/dev/null || echo "unknown")"
  echo "cron_installed=${cron_installed}"

  # Overall status
  if [[ "$cron_installed" == "true" && "$dir_exists" == "true" ]]; then
    echo "status=active"
  elif [[ "$cron_installed" == "true" ]]; then
    echo "status=partial"
  else
    echo "status=not_installed"
  fi
  exit 0
fi

# --- Mode: install ---
if [[ "$MODE" == "install" ]]; then
  echo "mode=install"
  echo "target=${TARGET}"

  # 1. SSH reachability
  if ! ssh "${SSH_ARGS[@]}" "$TARGET" "echo ok >/dev/null" 2>/dev/null; then
    fail "cannot reach ${TARGET} via SSH"
  fi
  echo "ssh_reachable=true"

  # 2. Check node_exporter with textfile collector
  ne_running="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "pgrep -x node_exporter >/dev/null 2>&1 && echo true || echo false" 2>/dev/null)"
  echo "node_exporter_running=${ne_running}"
  if [[ "$ne_running" != "true" ]]; then
    echo "WARNING: node_exporter not detected; cron will still be installed but metrics won't be scraped until node_exporter is configured"
  fi

  ne_textfile="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "ps aux 2>/dev/null | grep -o 'textfile.directory=[^ ]*' | head -1 || echo none" 2>/dev/null)"
  echo "node_exporter_textfile_arg=${ne_textfile}"

  # 3. Create textfile directory if needed
  ssh "${SSH_ARGS[@]}" "$TARGET" "sudo mkdir -p '$TEXTFILE_DIR' && sudo chmod 755 '$TEXTFILE_DIR'" 2>/dev/null
  echo "textfile_dir_created=${TEXTFILE_DIR}"

  # 4. Ensure exporter is executable
  ssh "${SSH_ARGS[@]}" "$TARGET" "chmod +x '$REMOTE_EXPORTER' 2>/dev/null || true" 2>/dev/null

  # 5. Install cron job (idempotent — remove old entry first)
  ssh "${SSH_ARGS[@]}" "$TARGET" "
    ( crontab -l 2>/dev/null | grep -v 'spine:rag-reindex-metrics' ; echo '${CRON_LINE}' ) | crontab -
  " 2>/dev/null
  echo "cron_installed=true"
  echo "cron_line=${CRON_LINE}"

  # 6. Seed initial .prom file
  echo "seeding initial metrics collection..."
  ssh "${SSH_ARGS[@]}" "$TARGET" \
    "'${REMOTE_EXPORTER}' --local > '${TEXTFILE_PATH}' 2>/dev/null || true" 2>/dev/null
  seed_ok="$(ssh "${SSH_ARGS[@]}" "$TARGET" \
    "[ -f '$TEXTFILE_PATH' ] && echo true || echo false" 2>/dev/null)"
  echo "initial_seed=${seed_ok}"

  echo "status=installed"
  exit 0
fi
