#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import sys
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from urllib import error, request

import yaml


SCRIPT_PATH = Path(__file__).resolve()
SPINE_ROOT = SCRIPT_PATH.parents[5]
DEFAULT_STATE = Path("/Users/ronnyworks/code/.runtime/spine/state")
CONTRACT_PATH = SPINE_ROOT / "ops/bindings/domains/rag/rag.workspace.contract.yaml"
NAMESPACE = uuid.UUID("fe8207a1-8703-4fa5-939d-8f47a6aa8d12")


def load_yaml(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    return data if isinstance(data, dict) else {}


def state_root() -> Path:
    raw = os.environ.get("SPINE_STATE")
    if raw:
        return Path(raw).expanduser().resolve()
    return DEFAULT_STATE


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def expand_path(raw: str) -> Path:
    return Path(raw.replace("$SPINE_STATE", str(state_root()))).expanduser().resolve()


def contract() -> dict[str, Any]:
    return load_yaml(CONTRACT_PATH)


def embedding_config(doc: dict[str, Any]) -> dict[str, Any]:
    embedding = doc.get("embedding") if isinstance(doc.get("embedding"), dict) else {}
    policy = doc.get("index_policy") if isinstance(doc.get("index_policy"), dict) else {}
    sync_policy = doc.get("sync_policy") if isinstance(doc.get("sync_policy"), dict) else {}
    load_shaping = sync_policy.get("load_shaping") if isinstance(sync_policy.get("load_shaping"), dict) else {}
    return {
        "model": os.environ.get("RAG_EMBED_MODEL") or embedding.get("model") or "mxbai-embed-large:latest",
        "dimensions": int(embedding.get("expected_dimensions") or 1024),
        "ollama_url": os.environ.get("OLLAMA_URL") or embedding.get("ollama_url") or "http://100.98.70.70:11434",
        "qdrant_url": os.environ.get("QDRANT_URL") or embedding.get("qdrant_url") or "http://100.71.17.29:6333",
        "collection": os.environ.get("RAG_QDRANT_COLLECTION") or policy.get("collection") or "spine-runtime-authority",
        "embed_timeout_sec": int(
            os.environ.get("RAG_EMBED_TIMEOUT_SEC")
            or embedding.get("timeout_sec")
            or load_shaping.get("embedding_timeout_sec")
            or 30
        ),
    }


def http_json(method: str, url: str, payload: Any | None = None, timeout: int = 120) -> Any:
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = request.Request(url, data=data, headers=headers, method=method)
    try:
        with request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode("utf-8")
    except error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"{method} {url} failed HTTP {exc.code}: {detail}") from exc
    except error.URLError as exc:
        raise RuntimeError(f"{method} {url} failed: {exc}") from exc
    if not body:
        return {}
    return json.loads(body)


def ensure_collection(cfg: dict[str, Any]) -> None:
    url = f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}"
    try:
        http_json("GET", url, timeout=30)
        return
    except RuntimeError:
        pass
    payload = {
        "vectors": {
            "size": cfg["dimensions"],
            "distance": "Cosine",
        }
    }
    http_json("PUT", url, payload, timeout=60)


def reset_collection(cfg: dict[str, Any]) -> None:
    url = f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}"
    try:
        http_json("DELETE", url, timeout=60)
    except RuntimeError:
        pass
    ensure_collection(cfg)


def ollama_embed(cfg: dict[str, Any], text: str) -> list[float]:
    payload = {"model": cfg["model"], "prompt": text}
    data = http_json("POST", f"{cfg['ollama_url'].rstrip('/')}/api/embeddings", payload, timeout=int(cfg.get("embed_timeout_sec") or 30))
    vector = data.get("embedding")
    if not isinstance(vector, list) or not vector:
        raise RuntimeError("Ollama embedding response did not include an embedding vector")
    if len(vector) != cfg["dimensions"]:
        raise RuntimeError(f"Embedding dimension mismatch: got {len(vector)}, expected {cfg['dimensions']}")
    return [float(item) for item in vector]


def ollama_embed_many(cfg: dict[str, Any], texts: list[str]) -> list[list[float]]:
    if not texts:
        return []
    if len(texts) == 1:
        return [ollama_embed(cfg, texts[0])]
    payload = {"model": cfg["model"], "input": texts}
    try:
        batch_timeout = int(os.environ.get("RAG_EMBED_BATCH_TIMEOUT_SEC") or 20)
        data = http_json("POST", f"{cfg['ollama_url'].rstrip('/')}/api/embed", payload, timeout=batch_timeout)
        vectors = data.get("embeddings")
        if not isinstance(vectors, list) or len(vectors) != len(texts):
            raise RuntimeError("Ollama batch embedding response did not include one vector per input")
        normalized: list[list[float]] = []
        for vector in vectors:
            if not isinstance(vector, list) or not vector:
                raise RuntimeError("Ollama batch embedding response included an empty vector")
            if len(vector) != cfg["dimensions"]:
                raise RuntimeError(f"Embedding dimension mismatch: got {len(vector)}, expected {cfg['dimensions']}")
            normalized.append([float(item) for item in vector])
        return normalized
    except Exception as exc:
        print(f"rag.direct.index batch_embed_fallback reason={exc}", file=sys.stderr, flush=True)
        return [ollama_embed(cfg, text) for text in texts]


def ollama_generate(cfg: dict[str, Any], prompt: str) -> str:
    model = os.environ.get("RAG_QUERY_MODEL", "phi3:mini")
    payload = {"model": model, "prompt": prompt, "stream": False}
    data = http_json("POST", f"{cfg['ollama_url'].rstrip('/')}/api/generate", payload, timeout=60)
    return str(data.get("response") or "").strip()


def has_secret_material(text: str) -> bool:
    deny = [
        r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
        r"\bAKIA[0-9A-Z]{16}\b",
        r"\bASIA[0-9A-Z]{16}\b",
        r"\bghp_[A-Za-z0-9]{20,}\b",
        r"\bgithub_pat_[A-Za-z0-9_]{20,}\b",
        r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b",
        r"\bsk-[A-Za-z0-9]{20,}\b",
    ]
    joined = text
    for pattern in deny:
        if re.search(pattern, joined):
            return True
    for line in text.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if not re.search(r"(KEY|TOKEN|SECRET|PASS|PASSWORD)", key, re.IGNORECASE):
            continue
        value = value.strip().strip('"').strip("'")
        if len(value) >= 12 and value.lower() not in {"redacted", "changeme", "example"}:
            return True
    return False


def iter_manifest(doc: dict[str, Any]) -> list[dict[str, Any]]:
    policy = doc.get("index_policy") if isinstance(doc.get("index_policy"), dict) else {}
    rows = policy.get("runtime_allowlist") if isinstance(policy.get("runtime_allowlist"), list) else []
    files: dict[str, dict[str, Any]] = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        base = expand_path(str(row.get("path") or ""))
        if not base.exists():
            continue
        globs = row.get("include_globs") if isinstance(row.get("include_globs"), list) else []
        if not globs:
            continue
        candidates = [base] if base.is_file() else [p for p in base.rglob("*") if p.is_file()]
        matched: list[Path] = []
        for path in candidates:
            rel_to_base = path.relative_to(base).as_posix() if base.is_dir() else path.name
            if not any(fnmatch.fnmatch(rel_to_base, str(pattern)) or fnmatch.fnmatch(path.name, str(pattern)) for pattern in globs):
                continue
            if path.suffix.lower() not in {".md", ".yaml", ".yml", ".json", ".txt"}:
                continue
            matched.append(path)
        if str(row.get("selection") or "") == "newest_by_mtime":
            matched = sorted(matched, key=lambda p: p.stat().st_mtime, reverse=True)
        max_files = int(row.get("max_files") or 0)
        if max_files > 0:
            matched = matched[:max_files]
        for path in matched:
            key = str(path.resolve())
            files[key] = {
                "path": path.resolve(),
                "allowlist_id": row.get("id"),
                "authority_class": row.get("authority_class"),
                "lifecycle": row.get("lifecycle"),
            }
    return [files[key] for key in sorted(files)]


def read_source(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def source_updated_at(path: Path) -> str:
    return datetime.fromtimestamp(path.stat().st_mtime, tz=UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def content_hash(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def chunk_text(text: str, max_chars: int = 800, overlap: int = 80) -> list[str]:
    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    parts: list[str] = []
    if normalized.lstrip().startswith("#"):
        sections = re.split(r"(?m)(?=^#{1,6}\s+)", normalized)
    else:
        sections = re.split(r"\n\s*\n", normalized)
    current = ""
    for section in sections:
        section = section.strip()
        if not section:
            continue
        if len(section) > max_chars:
            if current:
                parts.append(current.strip())
                current = ""
            start = 0
            while start < len(section):
                parts.append(section[start : start + max_chars].strip())
                start += max_chars - overlap
            continue
        if len(current) + len(section) + 2 > max_chars:
            if current:
                parts.append(current.strip())
            current = section
        else:
            current = f"{current}\n\n{section}".strip()
    if current:
        parts.append(current.strip())
    return [part for part in parts if part]


def source_card(path: Path, item: dict[str, Any], text: str, max_chars: int, compact: bool = False) -> str:
    scan_text = text
    if compact and len(text) > 12000:
        scan_text = f"{text[:8000]}\n\n...[compact source-card scan boundary]...\n\n{text[-2000:]}"
    headings = re.findall(r"(?m)^#{1,6}\s+(.+)$", scan_text)
    heading_text = "; ".join(heading.strip()[:56] for heading in headings[:3])
    first_line = next((line.strip() for line in scan_text.splitlines() if line.strip()), "")
    frontmatter: dict[str, Any] = {}
    if scan_text.startswith("---"):
        match = re.match(r"(?s)^---\n(.*?)\n---", scan_text)
        if match:
            try:
                parsed = yaml.safe_load(match.group(1)) or {}
                frontmatter = parsed if isinstance(parsed, dict) else {}
            except Exception:
                frontmatter = {}
    identifier_keys = [
        "packet_id",
        "loop_id",
        "human_intent_id",
        "source_human_intent_id",
        "source_ref",
        "origin_packet",
        "concern",
        "operator_hint",
    ]
    identifiers = []
    for key in identifier_keys:
        value = frontmatter.get(key)
        if value:
            identifiers.append(f"{key}={value}")
    explicit_ids = re.findall(r"\b(?:PACKET|LOOP|OI|HI|IUR|CAP|RCAP)-[A-Z0-9][A-Z0-9_.:-]*", scan_text)
    if explicit_ids:
        identifiers.append("explicit_ids=" + ",".join(dict.fromkeys(explicit_ids[:12])))
    variant = "compact" if compact else "standard"
    card = (
        f"SOURCE_NAME: {path.name}\n"
        f"SOURCE_PATH: {path}\n"
        f"ALLOWLIST_ID: {item.get('allowlist_id')}\n"
        f"AUTHORITY_CLASS: {item.get('authority_class')}\n"
        f"LIFECYCLE: {item.get('lifecycle')}\n"
        f"SOURCE_CARD_VARIANT: {variant}\n"
        f"SOURCE_BYTES: {len(text.encode('utf-8', errors='replace'))}\n"
        f"IDENTIFIERS: {'; '.join(identifiers) if identifiers else 'none'}\n"
        f"HEADINGS: {heading_text or 'none'}\n"
        f"HINT: {first_line[:240]}"
    )
    return card[:max_chars]


def point_id(source_hash: str, chunk_index: int) -> str:
    return str(uuid.uuid5(NAMESPACE, f"{source_hash}:{chunk_index}"))


def upsert_points(cfg: dict[str, Any], points: list[dict[str, Any]]) -> None:
    if not points:
        return
    url = f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}/points?wait=true"
    http_json("PUT", url, {"points": points}, timeout=180)


def ledger_path() -> Path:
    path = state_root() / "rag-direct" / "index-ledger.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def load_ledger() -> dict[str, Any]:
    path = ledger_path()
    if not path.exists():
        return {"sources": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {"sources": {}}
    return data if isinstance(data, dict) else {"sources": {}}


def write_ledger(data: dict[str, Any]) -> None:
    path = ledger_path()
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def progress_path() -> Path:
    path = state_root() / "rag-direct" / "index-progress.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def failure_manifest_path() -> Path:
    path = state_root() / "rag-direct" / "index-failures.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def write_progress(data: dict[str, Any]) -> None:
    path = progress_path()
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def write_failure_manifest(data: dict[str, Any]) -> None:
    path = failure_manifest_path()
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def load_failure_manifest() -> dict[str, Any]:
    path = failure_manifest_path()
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def failed_source_paths() -> set[str]:
    data = load_failure_manifest()
    rows = data.get("failed") if isinstance(data.get("failed"), list) else []
    paths: set[str] = set()
    for row in rows:
        if not isinstance(row, dict):
            continue
        path = str(row.get("path") or "")
        if path:
            paths.add(path)
    return paths


def failed_source_keys() -> set[str]:
    keys: set[str] = set()
    for raw_path in failed_source_paths():
        keys.add(raw_path)
        name = Path(raw_path).name
        if name:
            keys.add(name)
    return keys


def emit_progress(progress: dict[str, Any], message: str) -> None:
    progress["updated_at"] = utc_now()
    progress["message"] = message
    write_progress(progress)
    print(f"rag.direct.index {message}", file=sys.stderr, flush=True)


def index_source_cards(
    args: argparse.Namespace,
    cfg: dict[str, Any],
    manifest: list[dict[str, Any]],
    source_card_max_chars: int,
) -> int:
    indexed_files = 0
    indexed_chunks = 0
    chunk_budget = int(args.max_chunks or 0)
    skipped_unchanged = 0
    skipped_secret = 0
    failed: list[dict[str, str]] = []
    ledger = {"sources": {}} if args.reset else load_ledger()
    sources = ledger.setdefault("sources", {})
    progress_every = max(1, int(args.progress_every or 1))
    compact_source_min_chars = int(getattr(args, "compact_source_min_chars", 0) or 12000)
    compact_card_max_chars = int(getattr(args, "compact_card_max_chars", 0) or min(source_card_max_chars, 900))
    progress: dict[str, Any] = {
        "status": "running",
        "mode": "source_card",
        "collection": cfg["collection"],
        "files_seen": len(manifest),
        "files_indexed": 0,
        "chunks_indexed": 0,
        "skipped_unchanged": 0,
        "skipped_secret": 0,
        "failed_count": 0,
        "ledger": str(ledger_path()),
    }
    emit_progress(progress, f"start mode=source_card files={len(manifest)} collection={cfg['collection']}")

    for item in manifest:
        path = item["path"]
        try:
            text = read_source(path)
            if has_secret_material(text):
                skipped_secret += 1
                progress["skipped_secret"] = skipped_secret
                emit_progress(progress, f"skip_secret file={path}")
                continue
            source_hash = content_hash(text)
            rel_path = str(path)
            previous = sources.get(rel_path) if isinstance(sources.get(rel_path), dict) else {}
            if args.changed_only and previous.get("content_hash") == source_hash and previous.get("chunk_count") == 1:
                skipped_unchanged += 1
                progress["skipped_unchanged"] = skipped_unchanged
                continue
            if chunk_budget and indexed_chunks >= chunk_budget:
                break
            compact = len(text) >= compact_source_min_chars
            card_max_chars = compact_card_max_chars if compact else source_card_max_chars
            card = source_card(path, item, text, card_max_chars, compact=compact)
            payload = {
                "source_path": rel_path,
                "source_name": path.name,
                "allowlist_id": item.get("allowlist_id"),
                "authority_class": item.get("authority_class"),
                "lifecycle": item.get("lifecycle"),
                "content_hash": source_hash,
                "chunk_index": 0,
                "chunk_count": 1,
                "indexed_at": utc_now(),
                "source_updated_at": source_updated_at(path),
                "staleness_state": "fresh",
                "disposition": "active",
                "source_card_variant": "compact" if compact else "standard",
                "source_bytes": len(text.encode("utf-8", errors="replace")),
                "text": card,
            }
            vector = ollama_embed(cfg, card)
            upsert_points(cfg, [{"id": point_id(source_hash, 0), "vector": vector, "payload": payload}])
            indexed_files += 1
            indexed_chunks += 1
            sources[rel_path] = {
                "content_hash": source_hash,
                "chunk_count": 1,
                "indexed_at": utc_now(),
                "source_updated_at": source_updated_at(path),
                "authority_class": item.get("authority_class"),
                "allowlist_id": item.get("allowlist_id"),
                "source_card_variant": "compact" if compact else "standard",
            }
            ledger["updated_at"] = utc_now()
            ledger["collection"] = cfg["collection"]
            write_ledger(ledger)
            progress["files_indexed"] = indexed_files
            progress["chunks_indexed"] = indexed_chunks
            if indexed_files % progress_every == 0 or chunk_budget:
                emit_progress(progress, f"files={indexed_files}/{len(manifest)} chunks={indexed_chunks} current={path}")
            if args.pace_sec:
                time.sleep(args.pace_sec)
            if chunk_budget and indexed_chunks >= chunk_budget:
                break
        except Exception as exc:
            failed.append({"path": str(path), "error": str(exc)})
            progress["failed_count"] = len(failed)
            emit_progress(progress, f"failed file={path} error={exc}")
    ledger["updated_at"] = utc_now()
    ledger["collection"] = cfg["collection"]
    write_ledger(ledger)
    failure_manifest = {
        "status": "clear" if not failed else "retry_pending",
        "mode": "source_card",
        "collection": cfg["collection"],
        "created_at": utc_now(),
        "source_run_status": "indexed" if not failed else "partial_success_with_failures",
        "files_seen": len(manifest),
        "files_indexed": indexed_files,
        "chunks_indexed": indexed_chunks,
        "failed_count": len(failed),
        "failed": failed,
    }
    write_failure_manifest(failure_manifest)
    status = "indexed" if not failed else "partial_success_with_failures"
    result = {
        "status": status,
        "mode": "source_card",
        "collection": cfg["collection"],
        "files_seen": len(manifest),
        "files_indexed": indexed_files,
        "chunks_indexed": indexed_chunks,
        "skipped_unchanged": skipped_unchanged,
        "skipped_secret": skipped_secret,
        "failed_count": len(failed),
        "failed": failed[:10],
        "failure_manifest": str(failure_manifest_path()),
        "ledger": str(ledger_path()),
    }
    progress.update(result)
    progress["status"] = status
    write_progress(progress)
    print(json.dumps(result, sort_keys=True))
    return 0 if indexed_files > 0 or not failed else 1


def index_sources(args: argparse.Namespace) -> int:
    doc = contract()
    cfg = embedding_config(doc)
    policy = doc.get("index_policy") if isinstance(doc.get("index_policy"), dict) else {}
    chunk_mode = args.chunk_mode if args.chunk_mode != "contract" else str(policy.get("granularity") or "source_card")
    source_card_max_chars = int(policy.get("source_card_max_chars") or 1800)
    if args.reset:
        reset_collection(cfg)
    else:
        ensure_collection(cfg)
    manifest = iter_manifest(doc)
    if getattr(args, "retry_failed", False):
        failed_keys = failed_source_keys()
        if failed_keys:
            manifest = [
                item
                for item in manifest
                if str(item["path"]) in failed_keys or item["path"].name in failed_keys
            ]
            if not manifest:
                print(
                    json.dumps(
                        {
                            "status": "retry_manifest_mismatch",
                            "files": 0,
                            "failure_manifest": str(failure_manifest_path()),
                            "failed_source_keys": len(failed_keys),
                            "reason": "failure_manifest_sources_do_not_match_current_allowlist",
                        },
                        sort_keys=True,
                    )
                )
                return 1
        else:
            manifest = []
    if args.limit:
        manifest = manifest[: args.limit]
    if args.dry_run:
        print(
            json.dumps(
                {
                    "status": "dry_run",
                    "files": len(manifest),
                    "collection": cfg["collection"],
                    "retry_failed": bool(getattr(args, "retry_failed", False)),
                    "failure_manifest": str(failure_manifest_path()) if getattr(args, "retry_failed", False) else None,
                },
                sort_keys=True,
            )
        )
        return 0
    if chunk_mode == "source_card":
        return index_source_cards(args, cfg, manifest, source_card_max_chars)

    indexed_files = 0
    indexed_chunks = 0
    chunk_budget = int(args.max_chunks or 0)
    skipped_unchanged = 0
    skipped_secret = 0
    failed: list[dict[str, str]] = []
    batch: list[dict[str, Any]] = []
    ledger = {"sources": {}} if args.reset else load_ledger()
    sources = ledger.setdefault("sources", {})
    batch_size = max(1, int(args.batch_size or 4))
    embed_batch_size = max(1, int(args.embed_batch_size or 8))
    progress_every = max(1, int(args.progress_every or 10))
    progress: dict[str, Any] = {
        "status": "running",
        "collection": cfg["collection"],
        "files_seen": len(manifest),
        "files_indexed": 0,
        "chunks_indexed": 0,
        "skipped_unchanged": 0,
        "skipped_secret": 0,
        "failed_count": 0,
        "ledger": str(ledger_path()),
    }
    emit_progress(progress, f"start files={len(manifest)} collection={cfg['collection']}")
    for item in manifest:
        path = item["path"]
        try:
            text = read_source(path)
            if has_secret_material(text):
                skipped_secret += 1
                progress["skipped_secret"] = skipped_secret
                emit_progress(progress, f"skip_secret file={path}")
                continue
            source_hash = content_hash(text)
            rel_path = str(path)
            if chunk_mode == "content_chunks":
                chunks = chunk_text(text)
            else:
                chunks = [source_card(path, item, text, source_card_max_chars)]
            previous = sources.get(rel_path) if isinstance(sources.get(rel_path), dict) else {}
            if args.changed_only and previous.get("content_hash") == source_hash and previous.get("chunk_count") == len(chunks):
                skipped_unchanged += 1
                progress["skipped_unchanged"] = skipped_unchanged
                continue
            idx = 0
            while idx < len(chunks):
                embed_group: list[tuple[int, str, str]] = []
                while idx < len(chunks) and len(embed_group) < embed_batch_size:
                    if chunk_budget and indexed_chunks + len(embed_group) >= chunk_budget:
                        break
                    chunk = chunks[idx]
                    decorated = f"SOURCE: {rel_path}\nAUTHORITY_CLASS: {item.get('authority_class')}\n\n{chunk}"
                    embed_group.append((idx, chunk, decorated))
                    idx += 1
                if not embed_group:
                    break
                vectors = ollama_embed_many(cfg, [row[2] for row in embed_group])
                for (chunk_index, chunk, _decorated), vector in zip(embed_group, vectors, strict=True):
                    payload = {
                        "source_path": rel_path,
                        "source_name": path.name,
                        "allowlist_id": item.get("allowlist_id"),
                        "authority_class": item.get("authority_class"),
                        "lifecycle": item.get("lifecycle"),
                        "content_hash": source_hash,
                        "chunk_index": chunk_index,
                        "chunk_count": len(chunks),
                        "indexed_at": utc_now(),
                        "source_updated_at": source_updated_at(path),
                        "staleness_state": "fresh",
                        "disposition": "active",
                        "text": chunk,
                    }
                    batch.append({"id": point_id(source_hash, chunk_index), "vector": vector, "payload": payload})
                    indexed_chunks += 1
                    progress["chunks_indexed"] = indexed_chunks
                if len(batch) >= batch_size:
                    upsert_points(cfg, batch)
                    batch = []
                if indexed_chunks % progress_every < embed_batch_size or chunk_budget:
                    emit_progress(progress, f"chunks={indexed_chunks} files={indexed_files} current={path}")
            indexed_files += 1
            sources[rel_path] = {
                "content_hash": source_hash,
                "chunk_count": len(chunks),
                "indexed_at": utc_now(),
                "source_updated_at": source_updated_at(path),
                "authority_class": item.get("authority_class"),
                "allowlist_id": item.get("allowlist_id"),
            }
            ledger["updated_at"] = utc_now()
            ledger["collection"] = cfg["collection"]
            write_ledger(ledger)
            progress["files_indexed"] = indexed_files
            if indexed_files % progress_every == 0 or chunk_budget:
                emit_progress(progress, f"files={indexed_files}/{len(manifest)} chunks={indexed_chunks} current={path}")
            if args.pace_sec:
                time.sleep(args.pace_sec)
            if chunk_budget and indexed_chunks >= chunk_budget:
                break
        except Exception as exc:  # keep one bad file from poisoning the full reindex
            failed.append({"path": str(path), "error": str(exc)})
            progress["failed_count"] = len(failed)
            emit_progress(progress, f"failed file={path} error={exc}")
    upsert_points(cfg, batch)
    result = {
        "status": "indexed",
        "collection": cfg["collection"],
        "files_seen": len(manifest),
        "files_indexed": indexed_files,
        "chunks_indexed": indexed_chunks,
        "skipped_unchanged": skipped_unchanged,
        "skipped_secret": skipped_secret,
        "failed_count": len(failed),
        "failed": failed[:10],
        "ledger": str(ledger_path()),
    }
    ledger["updated_at"] = utc_now()
    ledger["collection"] = cfg["collection"]
    write_ledger(ledger)
    progress.update(result)
    progress["status"] = "indexed" if not failed else "indexed_with_failures"
    write_progress(progress)
    print(json.dumps(result, sort_keys=True))
    return 0 if not failed else 1


def qdrant_search(cfg: dict[str, Any], query: str, limit: int) -> list[dict[str, Any]]:
    vector = ollama_embed(cfg, query)
    url = f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}/points/search"
    payload = {
        "vector": vector,
        "limit": limit,
        "with_payload": True,
        "with_vectors": False,
        "filter": {"must": [{"key": "disposition", "match": {"value": "active"}}]},
    }
    data = http_json("POST", url, payload, timeout=120)
    rows = data.get("result")
    return rows if isinstance(rows, list) else []


def qdrant_count(cfg: dict[str, Any]) -> int:
    try:
        data = http_json("GET", f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}", timeout=30)
    except Exception:
        return 0
    result = data.get("result") if isinstance(data.get("result"), dict) else {}
    return int(result.get("points_count") or 0)


def normalize_for_match(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()


def query_terms(query: str) -> list[str]:
    raw_terms = re.findall(r"[A-Za-z0-9][A-Za-z0-9_.:-]{2,}", query)
    terms: list[str] = []
    for term in raw_terms:
        terms.append(term.lower())
        normalized = normalize_for_match(term)
        if normalized and normalized != term.lower():
            terms.extend(part for part in normalized.split() if len(part) >= 3)
    return list(dict.fromkeys(terms))


def lexical_manifest_hits(doc: dict[str, Any], query: str, limit: int) -> list[dict[str, Any]]:
    terms = query_terms(query)
    phrase = normalize_for_match(query)
    hits: list[tuple[float, dict[str, Any]]] = []
    for item in iter_manifest(doc):
        path = item["path"]
        try:
            text = read_source(path)
        except Exception:
            continue
        if has_secret_material(text):
            continue
        source_hash = content_hash(text)
        card = source_card(path, item, text, max_chars=1800)
        haystack = normalize_for_match(f"{path.name} {path} {card} {text[:4000]}")
        score = 0.0
        if phrase and phrase in haystack:
            score += 20.0
        for term in terms:
            if term in haystack:
                score += 1.0
            normalized_term = normalize_for_match(term)
            if normalized_term and normalized_term in haystack:
                score += 1.0
        explicit_ids = re.findall(r"\b(?:PACKET|LOOP|OI|HI|IUR|CAP|RCAP)-[A-Z0-9][A-Z0-9_.:-]*", query, flags=re.IGNORECASE)
        for explicit_id in explicit_ids:
            if normalize_for_match(explicit_id) in haystack:
                score += 15.0
        if score <= 0:
            continue
        payload = {
            "source_path": str(path),
            "source_name": path.name,
            "allowlist_id": item.get("allowlist_id"),
            "authority_class": item.get("authority_class"),
            "lifecycle": item.get("lifecycle"),
            "content_hash": source_hash,
            "chunk_index": 0,
            "chunk_count": 1,
            "indexed_at": "live_manifest",
            "source_updated_at": source_updated_at(path),
            "staleness_state": "fresh",
            "disposition": "active",
            "retrieval_mode": "lexical_allowlist",
            "text": card,
        }
        hits.append((score, {"score": score, "payload": payload}))
    hits.sort(key=lambda row: row[0], reverse=True)
    return [row for _score, row in hits[:limit]]


def merge_results(vector_rows: list[dict[str, Any]], lexical_rows: list[dict[str, Any]], limit: int) -> list[dict[str, Any]]:
    merged: list[dict[str, Any]] = []
    seen: set[str] = set()
    for row in lexical_rows + vector_rows:
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        source_path = str(payload.get("source_path") or "")
        chunk_index = str(payload.get("chunk_index") or "0")
        key = f"{source_path}:{chunk_index}"
        if not source_path or key in seen:
            continue
        seen.add(key)
        merged.append(row)
        if len(merged) >= limit:
            break
    return merged


def retrieve(args: argparse.Namespace) -> int:
    doc = contract()
    cfg = embedding_config(doc)
    lexical_rows = lexical_manifest_hits(doc, args.query, args.limit)
    vector_rows = []
    if len(lexical_rows) < args.limit:
        try:
            vector_rows = qdrant_search(cfg, args.query, max(args.limit * 3, args.limit))
        except Exception as exc:
            print(f"rag.direct.retrieve vector_fallback_unavailable reason={exc}", file=sys.stderr, flush=True)
    rows = merge_results(vector_rows, lexical_rows, args.limit)
    if args.json:
        print(json.dumps({"query": args.query, "collection": cfg["collection"], "results": rows}, sort_keys=True))
        return 0
    print(f"rag.direct.retrieve collection={cfg['collection']} query={args.query!r}")
    for i, row in enumerate(rows, start=1):
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        text = str(payload.get("text") or "")
        excerpt = re.sub(r"\s+", " ", text).strip()[:700]
        print(f"\n[{i}] score={row.get('score')} source={payload.get('source_path')}")
        mode = payload.get("retrieval_mode") or "vector"
        print(f"authority_class={payload.get('authority_class')} staleness={payload.get('staleness_state')} indexed_at={payload.get('indexed_at')} mode={mode}")
        print(excerpt)
    return 0


def query(args: argparse.Namespace) -> int:
    doc = contract()
    cfg = embedding_config(doc)
    lexical_rows = lexical_manifest_hits(doc, args.question, args.limit)
    vector_rows = []
    if len(lexical_rows) < args.limit:
        try:
            vector_rows = qdrant_search(cfg, args.question, max(args.limit * 3, args.limit))
        except Exception as exc:
            print(f"rag.direct.query vector_fallback_unavailable reason={exc}", file=sys.stderr, flush=True)
    rows = merge_results(vector_rows, lexical_rows, args.limit)
    context_lines: list[str] = []
    for i, row in enumerate(rows, start=1):
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        text = str(payload.get("text") or "")
        context_lines.append(
            f"[{i}] source={payload.get('source_path')} authority={payload.get('authority_class')} "
            f"freshness={payload.get('staleness_state')}\n{text[:900]}"
        )
    prompt = (
        "You are a retrieval assistant for agents. Answer only from the provided context. "
        "Do not claim authority; cite source paths and say when the source should be read directly.\n\n"
        f"QUESTION:\n{args.question}\n\nCONTEXT:\n" + "\n\n".join(context_lines)
    )
    try:
        answer = ollama_generate(cfg, prompt)
    except Exception as exc:
        answer = (
            "Synthesis unavailable from Ollama within the bounded query timeout. "
            "Use these retrieved source refs directly; RAG is not authority.\n"
            f"error: {exc}"
        )
    print(answer)
    print("\nSources:")
    for i, row in enumerate(rows, start=1):
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        print(f"- [{i}] {payload.get('source_path')} ({payload.get('authority_class')}, {payload.get('staleness_state')})")
    return 0


def health(args: argparse.Namespace) -> int:
    cfg = embedding_config(contract())
    status: dict[str, Any] = {"collection": cfg["collection"], "qdrant": "unknown", "ollama": "unknown"}
    try:
        qdrant = http_json("GET", f"{cfg['qdrant_url'].rstrip('/')}/collections/{cfg['collection']}", timeout=30)
        status["qdrant"] = "ok"
        status["qdrant_collection"] = qdrant.get("result", {})
    except Exception as exc:
        status["qdrant"] = f"error: {exc}"
    try:
        vector = ollama_embed(cfg, "RAG health probe")
        status["ollama"] = "ok"
        status["embedding_dimensions"] = len(vector)
    except Exception as exc:
        status["ollama"] = f"error: {exc}"
    print(json.dumps(status, sort_keys=True) if args.json else "\n".join(f"{k}={v}" for k, v in status.items()))
    return 0 if status["qdrant"] == "ok" and status["ollama"] == "ok" else 1


def manifest(args: argparse.Namespace) -> int:
    rows = iter_manifest(contract())
    payload = [{"path": str(row["path"]), "allowlist_id": row.get("allowlist_id"), "authority_class": row.get("authority_class")} for row in rows]
    if args.summary:
        counts: dict[str, int] = {}
        for row in payload:
            key = str(row.get("allowlist_id") or "unknown")
            counts[key] = counts.get(key, 0) + 1
        print(json.dumps({"files": len(payload), "by_allowlist_id": counts}, sort_keys=True))
        return 0
    if args.json:
        print(json.dumps({"files": len(payload), "manifest": payload}, sort_keys=True))
    else:
        print(f"rag.direct.manifest files={len(payload)}")
        for row in payload[: args.limit or len(payload)]:
            print(f"{row['authority_class']}\t{row['allowlist_id']}\t{row['path']}")
    return 0


def progress(args: argparse.Namespace) -> int:
    path = progress_path()
    data: dict[str, Any] = {"status": "missing", "path": str(path)}
    if path.exists():
        try:
            loaded = json.loads(path.read_text(encoding="utf-8"))
            data = loaded if isinstance(loaded, dict) else data
        except Exception as exc:
            data = {"status": "unreadable", "path": str(path), "error": str(exc)}
    cfg = embedding_config(contract())
    data.setdefault("collection", cfg["collection"])
    data["points_count"] = qdrant_count(cfg)
    data["path"] = str(path)
    failures = load_failure_manifest()
    if failures:
        data["failure_manifest"] = str(failure_manifest_path())
        data["retry_failed_count"] = int(failures.get("failed_count") or 0)
        data["retry_status"] = failures.get("status")
    if args.json:
        print(json.dumps(data, sort_keys=True))
        return 0
    for key in ["status", "message", "files_seen", "files_indexed", "chunks_indexed", "failed_count", "skipped_unchanged", "skipped_secret", "points_count", "updated_at", "path"]:
        if key in data:
            print(f"{key}={data[key]}")
    return 0


def quality(args: argparse.Namespace) -> int:
    doc = contract()
    cfg = embedding_config(doc)
    policy = doc.get("quality_policy") if isinstance(doc.get("quality_policy"), dict) else {}
    smoke_queries = policy.get("smoke_queries") if isinstance(policy.get("smoke_queries"), list) else []
    if not smoke_queries:
        smoke_queries = [
            {"question": "Packet 64 RAG subtraction first replacement", "expected_source_pattern": "PACKET-64-RAG-SUBTRACTION-FIRST-REPLACEMENT"},
            {"question": "human intent Rag.md retrieval workload planes", "expected_source_pattern": "OI-20260429-023749-71e6"},
            {"question": "what is RAG not allowed to decide", "expected_source_pattern": "RAG"},
            {"question": "current RAG loop", "expected_source_pattern": "LOOP-RAG-DIRECT-RETRIEVAL-RECOVERY"},
            {"question": "Packet 63 allowlist only", "expected_source_pattern": "PACKET-64-RAG-SUBTRACTION-FIRST-REPLACEMENT"},
        ]
    checks: list[dict[str, Any]] = []
    for row in smoke_queries:
        if not isinstance(row, dict):
            continue
        question = str(row.get("question") or "")
        expected = str(row.get("expected_source_pattern") or "")
        lexical_rows = lexical_manifest_hits(doc, question, int(args.limit or 5))
        vector_rows: list[dict[str, Any]] = []
        if len(lexical_rows) < int(args.limit or 5):
            try:
                vector_rows = qdrant_search(cfg, question, max(int(args.limit or 5) * 3, int(args.limit or 5)))
            except Exception as exc:
                vector_rows = [{"score": 0, "payload": {"source_path": "", "retrieval_error": str(exc)}}]
        results = merge_results(vector_rows, lexical_rows, int(args.limit or 5))
        source_paths = [
            str((item.get("payload") if isinstance(item.get("payload"), dict) else {}).get("source_path") or "")
            for item in results
        ]
        source_cards = [
            str((item.get("payload") if isinstance(item.get("payload"), dict) else {}).get("text") or "")
            for item in results
        ]
        haystack = "\n".join(source_paths + source_cards)
        passed = bool(expected and re.search(re.escape(expected), haystack, flags=re.IGNORECASE))
        checks.append({
            "question": question,
            "expected_source_pattern": expected,
            "status": "pass" if passed else "fail",
            "sources": source_paths,
        })
    failed = [row for row in checks if row.get("status") != "pass"]
    payload = {
        "status": "pass" if not failed else "fail",
        "collection": cfg["collection"],
        "points_count": qdrant_count(cfg),
        "checks": checks,
    }
    if args.json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(f"rag.direct.quality status={payload['status']} collection={cfg['collection']} points_count={payload['points_count']}")
        for row in checks:
            print(f"{row['status']}\t{row['question']}\texpected={row['expected_source_pattern']}")
            for source in row["sources"][:3]:
                print(f"  source={source}")
    return 0 if not failed else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Direct Qdrant + Ollama RAG for governed spine/runtime authority retrieval.")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("health")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=health)
    p = sub.add_parser("manifest")
    p.add_argument("--json", action="store_true")
    p.add_argument("--summary", action="store_true")
    p.add_argument("--limit", type=int, default=0)
    p.set_defaults(func=manifest)
    p = sub.add_parser("progress")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=progress)
    p = sub.add_parser("quality")
    p.add_argument("--limit", type=int, default=5)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=quality)
    p = sub.add_parser("index")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--changed-only", action="store_true")
    p.add_argument("--reset", action="store_true", help="Delete and recreate only the new direct RAG collection before indexing.")
    p.add_argument("--limit", type=int, default=0)
    p.add_argument("--max-chunks", type=int, default=0, help="Test guard: stop after this many chunks.")
    p.add_argument("--pace-sec", type=float, default=0.0)
    p.add_argument("--batch-size", type=int, default=1)
    p.add_argument("--embed-batch-size", type=int, default=1)
    p.add_argument("--progress-every", type=int, default=1)
    p.add_argument("--chunk-mode", choices=["contract", "source_card", "content_chunks"], default="contract")
    p.add_argument("--retry-failed", action="store_true", help="Index only sources recorded in the last failure manifest.")
    p.add_argument("--compact-source-min-chars", type=int, default=12000, help="Use compact source cards when source text is at least this many characters.")
    p.add_argument("--compact-card-max-chars", type=int, default=900, help="Maximum compact source-card characters.")
    p.set_defaults(func=index_sources)
    p = sub.add_parser("retrieve")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=5)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=retrieve)
    p = sub.add_parser("query")
    p.add_argument("question")
    p.add_argument("--limit", type=int, default=5)
    p.set_defaults(func=query)
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
