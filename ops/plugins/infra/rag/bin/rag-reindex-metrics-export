#!/usr/bin/env bash
# RAG Reindex Metrics Exporter
# Outputs Prometheus text exposition format metrics for RAG reindex observability.
# Reads the same remote state as rag-reindex-remote-status, plus embedding probe
# latency from the active backend.
#
# Usage:
#   Direct: ./rag-reindex-metrics-export > /path/to/textfile-collector/rag_reindex.prom
#   HTTP:   Wrap with socat/ncat or node-exporter textfile collector
#
# Bindings consumed:
#   - rag.remote.runner.yaml (SSH target, log path, tmux session)
#   - rag.embedding.backend.yaml (Ollama URL, model, probe prompt)
#
# Safety: read-only — no mutation to reindex state or retrieval behavior
#
# Flags:
#   --local   Skip SSH; read reindex state from local filesystem (for cron on ai-consolidation)
set -euo pipefail

LOCAL_MODE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --local) LOCAL_MODE=1; shift ;;
    --) shift; break ;;
    *) shift ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
git_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "${git_root:-}" && "${git_root:-}" != "null" ]]; then
  SP="${SPINE_ROOT:-$git_root}"
else
  SP="${SPINE_ROOT:-$(cd "$script_dir/../../../../.." && pwd)}"
fi

RUNNER_BINDING="$SP/ops/bindings/domains/rag/rag.remote.runner.yaml"
BACKEND_BINDING="$SP/ops/bindings/domains/rag/rag.embedding.backend.yaml"
SERVICES_BINDING="$SP/ops/bindings/services.health.yaml"

fail() { echo "# FAIL: $*" >&2; exit 1; }

for t in yq ssh; do
  command -v "$t" >/dev/null 2>&1 || fail "missing required tool: $t"
done
[[ -f "$RUNNER_BINDING" ]] || fail "runner binding not found: $RUNNER_BINDING"

read_runner() { yq -r "$1 // \"\"" "$RUNNER_BINDING"; }

# --- Remote runner binding ---
REMOTE_HOST="$(read_runner '.remote.host')"
REMOTE_USER="$(read_runner '.remote.user')"
REMOTE_PORT="$(read_runner '.remote.port')"
REMOTE_LOG="$(read_runner '.remote.log_path')"
TMUX_SESSION="$(read_runner '.remote.tmux_session')"

[[ -n "$REMOTE_HOST" ]] || fail ".remote.host missing in runner binding"
[[ -n "$REMOTE_USER" ]] || fail ".remote.user missing in runner binding"
[[ -n "$REMOTE_LOG" ]] || fail ".remote.log_path missing in runner binding"
[[ -n "$TMUX_SESSION" ]] || fail ".remote.tmux_session missing in runner binding"

if [[ -z "$REMOTE_PORT" || "$REMOTE_PORT" == "null" ]]; then
  REMOTE_PORT="22"
fi

TARGET="${REMOTE_USER}@${REMOTE_HOST}"
SSH_ARGS=(-o BatchMode=yes -o ConnectTimeout=10 -p "$REMOTE_PORT")

# Helper: run a command locally or via SSH depending on mode
run_cmd() {
  if [[ "$LOCAL_MODE" -eq 1 ]]; then
    bash -c "$1"
  else
    ssh "${SSH_ARGS[@]}" "$TARGET" "$1"
  fi
}

# --- Resolve Ollama URL for embedding probe ---
OLLAMA_URL="${OLLAMA_URL:-${OLLAMA_BASE_URL:-}}"
if [[ -z "$OLLAMA_URL" && -f "$BACKEND_BINDING" ]]; then
  if [[ -f "$SERVICES_BINDING" ]]; then
    tags_url="$(yq -r '.endpoints[] | select(.id=="ollama") | .url' "$SERVICES_BINDING" 2>/dev/null || true)"
    if [[ -n "$tags_url" && "$tags_url" != "null" ]]; then
      OLLAMA_URL="${tags_url%/api/tags}"
    fi
  fi
fi
OLLAMA_URL="${OLLAMA_URL:-http://192.168.1.110:11434}"

EMBED_MODEL=""
EMBED_PROMPT=""
if [[ -f "$BACKEND_BINDING" ]]; then
  EMBED_MODEL="$(yq -r '.active.model // ""' "$BACKEND_BINDING")"
  EMBED_PROMPT="$(yq -r '.probe.test_prompt // "test"' "$BACKEND_BINDING")"
fi

# --- Collect metrics ---

# 1. Connectivity check — if remote and can't reach host, emit error metrics and exit
if [[ "$LOCAL_MODE" -eq 0 ]]; then
  if ! ssh "${SSH_ARGS[@]}" "$TARGET" "echo ok >/dev/null" 2>/dev/null; then
    echo "# HELP rag_reindex_exporter_up Whether the metrics exporter can reach the remote host."
    echo "# TYPE rag_reindex_exporter_up gauge"
    echo "rag_reindex_exporter_up 0"
    exit 0
  fi
fi

# 2. Session running (gauge: 1/0)
session_running=0
if run_cmd "tmux has-session -t '$TMUX_SESSION' 2>/dev/null" 2>/dev/null; then
  session_running=1
fi

# 3. Uploaded/failed counts from log, scoped to latest run
REMOTE_REPO="$(read_runner '.remote.repo_path')"
effective_log="$REMOTE_LOG"
if ! run_cmd "[ -f '$REMOTE_LOG' ]" 2>/dev/null; then
  fallback_log="$(run_cmd "ls -1t '$REMOTE_REPO'/mailroom/logs/rag-sync-*.log 2>/dev/null | head -n 1" 2>/dev/null || true)"
  if [[ -n "$fallback_log" ]]; then
    effective_log="$fallback_log"
  fi
fi

run_start_line="$(run_cmd \
  "if [ -f '$effective_log' ]; then awk '/START rag sync/{n=NR} END{print (n>0?n:1)}' '$effective_log'; else echo 1; fi" \
  2>/dev/null || echo 1)"

uploaded="$(run_cmd \
  "awk -v s='$run_start_line' 'NR>=s && /OK: Uploaded/{c++} END{print c+0}' '$effective_log'" \
  2>/dev/null || echo 0)"

failed="$(run_cmd \
  "awk -v s='$run_start_line' 'NR>=s && /ERROR: Upload failed/{c++} END{print c+0}' '$effective_log'" \
  2>/dev/null || echo 0)"

# 4. Stall detection — minutes since last log line modification
stall_minutes="$(run_cmd \
  "if [ -f '$effective_log' ]; then
     last_mod=\$(stat -c %Y '$effective_log' 2>/dev/null || stat -f %m '$effective_log' 2>/dev/null || echo 0)
     now=\$(date +%s)
     echo \$(( (now - last_mod) / 60 ))
   else
     echo 0
   fi" 2>/dev/null || echo 0)"

# 5. Embedding latency probe (single probe, not full health check)
embedding_latency_ms="-1"
if [[ -n "$EMBED_MODEL" && -n "$EMBED_PROMPT" ]]; then
  if command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    start_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
    http_code="$(curl -sS --max-time 10 \
      -o /dev/null -w "%{http_code}" \
      -H "Content-Type: application/json" \
      -d "$(python3 -c "import json; print(json.dumps({'model':'$EMBED_MODEL','prompt':'$EMBED_PROMPT'}))")" \
      "${OLLAMA_URL}/api/embeddings" 2>/dev/null || echo "000")"
    end_ms="$(python3 -c 'import time; print(int(time.time()*1000))')"
    if [[ "$http_code" == "200" ]]; then
      embedding_latency_ms=$((end_ms - start_ms))
    fi
  fi
fi

# --- Output Prometheus text exposition format ---
echo "# HELP rag_reindex_exporter_up Whether the metrics exporter can reach the remote host."
echo "# TYPE rag_reindex_exporter_up gauge"
echo "rag_reindex_exporter_up 1"
echo ""
echo "# HELP rag_reindex_docs_uploaded_total Total documents uploaded in the current reindex run."
echo "# TYPE rag_reindex_docs_uploaded_total gauge"
echo "rag_reindex_docs_uploaded_total $uploaded"
echo ""
echo "# HELP rag_reindex_docs_failed_total Total documents that failed upload in the current reindex run."
echo "# TYPE rag_reindex_docs_failed_total gauge"
echo "rag_reindex_docs_failed_total $failed"
echo ""
echo "# HELP rag_reindex_session_running Whether the reindex tmux session is active (1) or not (0)."
echo "# TYPE rag_reindex_session_running gauge"
echo "rag_reindex_session_running $session_running"
echo ""
echo "# HELP rag_reindex_stall_minutes Minutes since last log file modification. 0 if no log."
echo "# TYPE rag_reindex_stall_minutes gauge"
echo "rag_reindex_stall_minutes $stall_minutes"
echo ""
echo "# HELP rag_reindex_last_embedding_latency_ms Single embedding probe latency in milliseconds. -1 if probe failed."
echo "# TYPE rag_reindex_last_embedding_latency_ms gauge"
echo "rag_reindex_last_embedding_latency_ms $embedding_latency_ms"
