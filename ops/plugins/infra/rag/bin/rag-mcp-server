#!/usr/bin/env python3
"""
Spine RAG MCP Server — direct Qdrant + Ollama retrieval for agent tools.

MCP stdio transport: JSON-RPC 2.0 over stdin/stdout.
No external dependencies (stdlib only). No AnythingLLM API key required.

Authority: Packet 64 RAG subtraction-first replacement.
Location: ops/plugins/infra/rag/bin/rag-mcp-server
"""

import json
import os
import subprocess
import sys

SPINE_ROOT = os.environ.get(
    "SPINE_ROOT",
    os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    ))))
)

RAG_DIRECT = os.path.join(SPINE_ROOT, "ops/plugins/infra/rag/bin/rag-direct")

TOOLS = [
    {
        "name": "rag_query",
            "description": (
            "Ask the first-class spine/runtime retrieval index for a synthesized "
            "answer with source paths. RAG is retrieval assistance only, not "
            "authority; read cited loop scopes, packets, contracts, receipts, or "
            "capability readbacks directly before deciding or mutating."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "question": {
                    "type": "string",
                    "description": "The question to ask the RAG system"
                }
            },
            "required": ["question"]
        }
    },
    {
        "name": "rag_retrieve",
            "description": (
            "Retrieve raw chunks from the direct Qdrant spine/runtime retrieval "
            "index. Returns source paths, authority class, freshness, and text. "
            "Use for semantic discovery; use rg/direct file reads for exact known paths."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "The search query"
                },
                "limit": {
                    "type": "integer",
                    "description": "Maximum number of results (default 5)",
                    "default": 5
                }
            },
            "required": ["query"]
        }
    },
    {
        "name": "rag_health",
            "description": (
            "Check direct RAG health: Qdrant collection and Ollama embedding path. "
            "Does not use AnythingLLM."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {}
        }
    }
]


def read_message():
    """Read a JSON-RPC message from stdin (NDJSON: one JSON object per line)."""
    line = sys.stdin.readline()
    if not line:
        return None
    line = line.strip()
    if not line:
        return read_message()
    return json.loads(line)


def write_message(msg):
    """Write a JSON-RPC message to stdout."""
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def run_rag(subcommand, *args):
    """Run the direct RAG CLI and return stdout."""
    cmd = [RAG_DIRECT, subcommand, *args]
    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=120,
        cwd=SPINE_ROOT
    )
    # Filter out Infisical noise from stderr
    output = result.stdout
    if result.returncode != 0:
        err = result.stderr
        # Strip infisical version nag
        err_lines = [
            l for l in err.splitlines()
            if "new release of infisical" not in l.lower()
            and "brew update" not in l.lower()
            and "INF" not in l
        ]
        err_clean = "\n".join(err_lines).strip()
        raise RuntimeError(f"rag-direct {subcommand} failed (rc={result.returncode}): {err_clean}")
    return output.strip()


def handle_initialize(msg):
    return {
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {
                "name": "spine-rag",
                "version": "1.0.0"
            }
        }
    }


def handle_tools_list(msg):
    return {
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {"tools": TOOLS}
    }


def handle_tools_call(msg):
    name = msg["params"]["name"]
    args = msg["params"].get("arguments", {})

    try:
        if name == "rag_query":
            text = run_rag("query", args["question"])
        elif name == "rag_retrieve":
            cmd_args = [args["query"]]
            if args.get("limit"):
                cmd_args.extend(["--limit", str(args["limit"])])
            text = run_rag("retrieve", *cmd_args)
        elif name == "rag_health":
            text = run_rag("health")
        else:
            return {
                "jsonrpc": "2.0",
                "id": msg["id"],
                "error": {"code": -32601, "message": f"Unknown tool: {name}"}
            }

        return {
            "jsonrpc": "2.0",
            "id": msg["id"],
            "result": {
                "content": [{"type": "text", "text": text}]
            }
        }
    except Exception as e:
        return {
            "jsonrpc": "2.0",
            "id": msg["id"],
            "result": {
                "content": [{"type": "text", "text": f"Error: {e}"}],
                "isError": True
            }
        }


def main():
    while True:
        try:
            msg = read_message()
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue
        if msg is None:
            break

        method = msg.get("method", "")
        msg_id = msg.get("id")

        if method == "initialize":
            write_message(handle_initialize(msg))
        elif method == "notifications/initialized":
            pass  # notification, no response
        elif method == "tools/list":
            write_message(handle_tools_list(msg))
        elif method == "tools/call":
            write_message(handle_tools_call(msg))
        elif method == "ping":
            write_message({"jsonrpc": "2.0", "id": msg_id, "result": {}})
        elif msg_id is not None:
            write_message({
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {"code": -32601, "message": f"Method not found: {method}"}
            })


if __name__ == "__main__":
    main()
