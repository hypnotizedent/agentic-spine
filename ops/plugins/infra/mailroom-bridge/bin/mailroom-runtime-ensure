#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import plistlib
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
RUNTIME_CONTRACT = ROOT / "ops/bindings/mailroom.runtime.contract.yaml"
ENSURE_CONTRACT = Path(
    os.environ.get("MAILROOM_RUNTIME_ENSURE_CONTRACT", str(ROOT / "ops/bindings/mailroom.runtime.ensure.contract.yaml"))
)


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle)
    return default if data is None else data


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_timestamp(value: str | None) -> dt.datetime | None:
    raw = (value or "").strip()
    if not raw:
        return None
    if raw.endswith("Z"):
        raw = raw[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(raw)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def resolve_runtime_paths() -> dict[str, Path]:
    contract = load_yaml(RUNTIME_CONTRACT, {})
    runtime_root = Path(os.environ.get("SPINE_RUNTIME_ROOT") or contract.get("runtime_root") or (ROOT / ".runtime/spine"))
    state_root = Path(os.environ.get("SPINE_STATE") or contract.get("state_root") or (runtime_root / "state"))
    logs_root = Path(os.environ.get("SPINE_LOGS") or contract.get("logs_root") or (runtime_root / "logs"))
    mailroom_root = Path(os.environ.get("SPINE_MAILROOM_ROOT") or contract.get("mailroom_root") or (runtime_root / "mailroom"))
    inbox_root = Path(os.environ.get("SPINE_INBOX") or (mailroom_root / "inbox"))
    outbox_root = Path(os.environ.get("SPINE_OUTBOX") or (mailroom_root / "outbox"))
    return {
        "root": runtime_root,
        "state": state_root,
        "logs": logs_root,
        "mailroom": mailroom_root,
        "inbox": inbox_root,
        "outbox": outbox_root,
    }


def expand_path(raw: str, runtime_paths: dict[str, Path]) -> Path:
    mapping = {
        "SPINE_STATE": str(runtime_paths["state"]),
        "SPINE_LOGS": str(runtime_paths["logs"]),
        "SPINE_INBOX": str(runtime_paths["inbox"]),
        "SPINE_OUTBOX": str(runtime_paths["outbox"]),
        "SPINE_RUNTIME_ROOT": str(runtime_paths["root"]),
        "SPINE_MAILROOM_ROOT": str(runtime_paths["mailroom"]),
        "HOME": str(Path.home()),
    }
    expanded = raw
    for key, value in mapping.items():
        expanded = expanded.replace(f"${{{key}}}", value).replace(f"${key}", value)
    return Path(os.path.expandvars(os.path.expanduser(expanded)))


def command_path(env_key: str, relative_default: str) -> str:
    override = os.environ.get(env_key, "").strip()
    if override:
        return override
    return str(ROOT / relative_default)


def run_command(argv: list[str], *, timeout: int = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def launchctl_state(label: str, launchctl_bin: str, uid: str) -> dict[str, Any]:
    proc = run_command([launchctl_bin, "print", f"gui/{uid}/{label}"], timeout=10)
    if proc.returncode == 0:
        state = ""
        pid: int | None = None
        for raw in proc.stdout.splitlines():
            line = raw.strip()
            if not state and line.startswith("state ="):
                state = line.split("=", 1)[1].strip()
            if pid is None and line.startswith("pid ="):
                try:
                    pid = int(line.split("=", 1)[1].strip())
                except ValueError:
                    pid = None
        return {"loaded": True, "running": state == "running", "pid": pid, "stdout": proc.stdout, "stderr": proc.stderr}

    legacy = run_command([launchctl_bin, "list", label], timeout=10)
    if legacy.returncode != 0 or not legacy.stdout.strip():
        return {"loaded": False, "running": False, "pid": None, "stdout": proc.stdout, "stderr": proc.stderr}

    pid: int | None = None
    last_exit: int | None = None
    for raw in legacy.stdout.splitlines():
        line = raw.strip()
        if "\"PID\"" in line and "=" in line:
            try:
                pid = int(line.split("=", 1)[1].strip().strip(";"))
            except ValueError:
                pid = None
        if "\"LastExitStatus\"" in line and "=" in line:
            try:
                last_exit = int(line.split("=", 1)[1].strip().strip(";"))
            except ValueError:
                last_exit = None
    return {
        "loaded": True,
        "running": pid is not None,
        "pid": pid,
        "last_exit": last_exit,
        "stdout": legacy.stdout,
        "stderr": legacy.stderr,
    }


def pid_running(pid_file: Path) -> bool:
    if not pid_file.exists():
        return False
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
    except Exception:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def read_worker_status(status_file: Path) -> dict[str, Any]:
    if not status_file.exists():
        return {}
    try:
        payload = json.loads(status_file.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def ensure_mount(spec: dict[str, Any], launchctl_bin: str, uid: str, restart_bin: str, *, dry_run: bool) -> dict[str, Any]:
    label = str(spec.get("label", "")).strip()
    mountpoint = Path(str(spec.get("mountpoint", "")).strip()).expanduser()
    expected_entries = [str(x).strip() for x in spec.get("expected_entries", []) if str(x).strip()]
    state = launchctl_state(label, launchctl_bin, uid) if label else {"loaded": False, "running": False, "pid": None}
    try:
        entries = sorted(os.listdir(mountpoint))
        readable = True
    except Exception as exc:
        entries = []
        readable = False
        read_error = str(exc)
    else:
        read_error = ""
    expected_missing = [entry for entry in expected_entries if entry not in entries]

    result = {
        "id": str(spec.get("id", label or mountpoint.name)),
        "label": label,
        "mountpoint": str(mountpoint),
        "launchd_running": bool(state.get("running")),
        "readable": readable,
        "expected_missing": expected_missing,
        "status": "ok",
        "action": None,
    }
    if readable and not expected_missing and state.get("running"):
        return result

    result["status"] = "needs_restore"
    if read_error:
        result["read_error"] = read_error

    if dry_run:
        result["status"] = "dry-run"
        result["action"] = "restart_label"
        return result

    proc = run_command([restart_bin, "--label", label], timeout=90)
    result["action"] = "restart_label"
    result["restart_exit_code"] = proc.returncode
    if proc.returncode != 0:
        result["status"] = "blocked"
        result["stderr"] = proc.stderr.strip()
        result["stdout"] = proc.stdout.strip()
        return result

    time.sleep(1)
    try:
        entries = sorted(os.listdir(mountpoint))
        readable = True
    except Exception as exc:
        entries = []
        readable = False
        read_error = str(exc)
    else:
        read_error = ""
    expected_missing = [entry for entry in expected_entries if entry not in entries]
    result["launchd_running"] = launchctl_state(label, launchctl_bin, uid).get("running", False)
    result["readable"] = readable
    result["expected_missing"] = expected_missing
    if readable and not expected_missing:
        result["status"] = "restored"
    else:
        result["status"] = "blocked"
        if read_error:
            result["read_error"] = read_error
    return result


def ensure_watcher(spec: dict[str, Any], launchctl_bin: str, uid: str, *, dry_run: bool) -> dict[str, Any]:
    label = str(spec.get("label", "")).strip()
    restart_bin = command_path("MAILROOM_RUNTIME_ENSURE_AGENT_RESTART_BIN", str(spec.get("restart_bin", "")))
    state = launchctl_state(label, launchctl_bin, uid)
    result = {"label": label, "launchd_running": bool(state.get("running")), "status": "ok", "action": None}
    if state.get("running"):
        return result
    if dry_run:
        result["status"] = "dry-run"
        result["action"] = "restart_watcher"
        return result
    proc = run_command([restart_bin], timeout=90)
    result["action"] = "restart_watcher"
    result["restart_exit_code"] = proc.returncode
    if proc.returncode != 0:
        result["status"] = "blocked"
        result["stderr"] = proc.stderr.strip()
        result["stdout"] = proc.stdout.strip()
        return result
    state = launchctl_state(label, launchctl_bin, uid)
    result["launchd_running"] = bool(state.get("running"))
    result["status"] = "restored" if state.get("running") else "blocked"
    return result


def reconcile_tasks(task_cfg: dict[str, Any], *, dry_run: bool) -> dict[str, Any]:
    reconcile_bin = command_path("MAILROOM_RUNTIME_ENSURE_TASK_RECONCILE_BIN", str(task_cfg.get("reconcile_bin", "")))
    stale_seconds = max(1, int(task_cfg.get("running_stale_seconds", 300)))
    argv = [reconcile_bin, "--json", "--running-stale-seconds", str(stale_seconds)]
    if dry_run:
        argv.append("--dry-run")
    proc = run_command(argv, timeout=60)
    if proc.returncode != 0:
        return {
            "status": "blocked",
            "action": "reconcile_tasks",
            "exit_code": proc.returncode,
            "stdout": proc.stdout.strip(),
            "stderr": proc.stderr.strip(),
        }
    payload = json.loads(proc.stdout)
    data = payload.get("data", {}) if isinstance(payload, dict) else {}
    changed = len(data.get("actions", [])) if isinstance(data.get("actions"), list) else 0
    return {
        "status": "dry-run" if dry_run else ("reconciled" if changed else "ok"),
        "action": "reconcile_tasks" if changed else None,
        "data": data,
    }


def ensure_worker(worker_cfg: dict[str, Any], runtime_paths: dict[str, Path], *, dry_run: bool) -> dict[str, Any]:
    worker_bin = command_path("MAILROOM_RUNTIME_ENSURE_WORKER_BIN", str(worker_cfg.get("bin", "")))
    status_file = expand_path(str(worker_cfg.get("status_file", "${SPINE_STATE}/mailroom-task-worker.status.json")), runtime_paths)
    pid_file = expand_path(str(worker_cfg.get("pid_file", "${SPINE_STATE}/mailroom-task-worker.pid")), runtime_paths)
    stale_status_seconds = max(30, int(worker_cfg.get("stale_status_seconds", 900)))
    fresh_tick_timeout_seconds = max(5, int(worker_cfg.get("fresh_tick_timeout_seconds", 20)))
    status_payload = read_worker_status(status_file)
    generated_at = parse_timestamp(str(status_payload.get("generated_at", "")))
    now_dt = dt.datetime.now(dt.timezone.utc)
    age_seconds = int((now_dt - generated_at).total_seconds()) if generated_at is not None else None
    cycle_status = ""
    if isinstance(status_payload.get("data"), dict):
        cycle_status = str(status_payload["data"].get("cycle", {}).get("status", "")).strip()

    running = pid_running(pid_file)
    needs_restart = (not running) or generated_at is None or (age_seconds is not None and age_seconds > stale_status_seconds) or cycle_status in {"failed", "blocked"}

    result = {
        "pid_file": str(pid_file),
        "status_file": str(status_file),
        "running": running,
        "last_tick": generated_at.isoformat().replace("+00:00", "Z") if generated_at else None,
        "last_tick_age_seconds": age_seconds,
        "last_cycle_status": cycle_status or None,
        "status": "ok",
        "action": None,
    }
    if not needs_restart:
        return result

    result["status"] = "needs_restore"
    if dry_run:
        result["status"] = "dry-run"
        result["action"] = "restart_worker" if running else "start_worker"
        return result

    if running:
        run_command([worker_bin, "--stop"], timeout=45)
        time.sleep(1)
    start_reference = dt.datetime.now(dt.timezone.utc) - dt.timedelta(seconds=1)
    start_proc = run_command([worker_bin, "--daemon"], timeout=60)
    result["action"] = "restart_worker" if running else "start_worker"
    result["start_exit_code"] = start_proc.returncode
    if start_proc.returncode != 0:
        result["status"] = "blocked"
        result["stdout"] = start_proc.stdout.strip()
        result["stderr"] = start_proc.stderr.strip()
        return result

    deadline = time.monotonic() + fresh_tick_timeout_seconds
    while time.monotonic() < deadline:
        time.sleep(1)
        status_payload = read_worker_status(status_file)
        generated_at = parse_timestamp(str(status_payload.get("generated_at", "")))
        cycle_status = ""
        if isinstance(status_payload.get("data"), dict):
            cycle_status = str(status_payload["data"].get("cycle", {}).get("status", "")).strip()
        if generated_at is not None and generated_at >= start_reference:
            result["running"] = pid_running(pid_file)
            result["last_tick"] = generated_at.isoformat().replace("+00:00", "Z")
            result["last_cycle_status"] = cycle_status or None
            if cycle_status in {"failed", "blocked"}:
                result["status"] = "blocked"
            else:
                result["status"] = "restored"
            return result

    result["status"] = "blocked"
    result["reason"] = "fresh_tick_timeout"
    return result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Ensure canonical mailroom runtime is healthy after reboot")
    parser.add_argument("--json", action="store_true", help="Emit JSON payload")
    parser.add_argument("--dry-run", action="store_true", help="Report restore actions without mutating services or task files")
    parser.add_argument("--launchd-run", action="store_true", help="Launchd entrypoint mode (output still emitted, behavior unchanged)")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    runtime_paths = resolve_runtime_paths()
    ensure_contract = load_yaml(ENSURE_CONTRACT, {})
    uid = str(os.getuid())
    launchctl_bin = os.environ.get("MAILROOM_RUNTIME_ENSURE_LAUNCHCTL_BIN", str(ensure_contract.get("recovery", {}).get("launchctl_bin", "launchctl")))
    launchd_restart_bin = command_path(
        "MAILROOM_RUNTIME_ENSURE_RECOVERY_LAUNCHD_RESTART_BIN",
        str(ensure_contract.get("recovery", {}).get("launchd_restart_bin", "")),
    )

    mounts = [
        ensure_mount(spec, launchctl_bin, uid, launchd_restart_bin, dry_run=args.dry_run)
        for spec in ensure_contract.get("mounts", [])
    ]
    watcher = ensure_watcher(ensure_contract.get("watcher", {}), launchctl_bin, uid, dry_run=args.dry_run)
    task_reconcile = reconcile_tasks(ensure_contract.get("tasks", {}), dry_run=args.dry_run)
    worker = ensure_worker(ensure_contract.get("worker", {}), runtime_paths, dry_run=args.dry_run)

    blocked = [item for item in mounts if item.get("status") == "blocked"]
    if watcher.get("status") == "blocked":
        blocked.append({"id": "watcher"})
    if task_reconcile.get("status") == "blocked":
        blocked.append({"id": "task_reconcile"})
    if worker.get("status") == "blocked":
        blocked.append({"id": "worker"})

    restarted_count = sum(1 for item in mounts if item.get("status") == "restored")
    restarted_count += 1 if watcher.get("status") == "restored" else 0
    restarted_count += 1 if worker.get("status") == "restored" else 0

    payload = {
        "capability": "mailroom.runtime.ensure",
        "schema_version": "1.0",
        "generated_at": utc_now(),
        "status": "blocked" if blocked else ("dry-run" if args.dry_run else "ok"),
        "data": {
            "mounts": mounts,
            "watcher": watcher,
            "task_reconcile": task_reconcile,
            "worker": worker,
            "summary": {
                "blocked_count": len(blocked),
                "restored_count": restarted_count,
                "reconciled_count": 0
                if args.dry_run
                else len(task_reconcile.get("data", {}).get("actions", [])),
            },
        },
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("mailroom.runtime.ensure")
        for mount in mounts:
            suffix = ""
            if mount.get("expected_missing"):
                suffix = f" missing={','.join(mount['expected_missing'])}"
            print(f"mount {mount['id']}: {mount['status']}{suffix}")
        print(f"watcher: {watcher.get('status')}")
        print(
            "tasks: "
            f"{task_reconcile.get('status')} "
            f"requeued={task_reconcile.get('data', {}).get('requeued', 0)} "
            f"failed={task_reconcile.get('data', {}).get('failed', 0)}"
        )
        print(f"worker: {worker.get('status')}")
        print(f"status: {payload['status']}")
    return 1 if blocked else 0


if __name__ == "__main__":
    raise SystemExit(main())
