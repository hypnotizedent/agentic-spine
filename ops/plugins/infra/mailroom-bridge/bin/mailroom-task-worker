#!/usr/bin/env python3
"""mailroom-task-worker — bounded operational mailroom worker."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parents[5]
CONTRACT = ROOT / "ops" / "bindings" / "mailroom.task.worker.contract.yaml"
RUNTIME_BOOTSTRAP_CONTRACT = ROOT / "ops" / "bindings" / "runtime.bootstrap.contract.yaml"
SSH_RESOLVER = ROOT / "ops" / "lib" / "ssh-resolve.sh"
PROVIDERS_STATUS_BIN = ROOT / "ops" / "plugins" / "providers" / "bin" / "providers-status"
STATE_ROOT = os.environ.get("SPINE_STATE", "")
TASK_ROOT = Path(STATE_ROOT) / "agent-tasks" if STATE_ROOT else Path()
QUEUED_DIR = TASK_ROOT / "queued"
STATUS_PATH = TASK_ROOT / "mailroom-task-worker.status.json"
CANONICAL_TASK_ROOT_DEFAULT = "/md1400/spine/state/agent-tasks"
CANONICAL_STATE_ROOT_DEFAULT = "/md1400/spine/state"
PROMPT_CACHE_FENCE = (Path(STATE_ROOT) / "agent-bridge-prompt-cache") if STATE_ROOT else Path()
DISABLE_CANONICAL_QUEUE = os.environ.get("MAILROOM_WORKER_DISABLE_CANONICAL_QUEUE", "").strip() == "1"
DISABLE_PROVIDER_PLACEMENT = os.environ.get("MAILROOM_WORKER_DISABLE_PROVIDER_PLACEMENT", "").strip() == "1"
DISABLE_CANONICAL_PROMPT_FETCH = os.environ.get("MAILROOM_WORKER_DISABLE_CANONICAL_PROMPT_FETCH", "").strip() == "1"
RUN_KEY_RE = re.compile(r"Run Key:\s+(\S+)")
PROVIDER_RUN_RE = re.compile(r"PROVIDER_(REQUESTED|USED|MODEL)=(.+)")
USAGE_RE = re.compile(r"USAGE_(INPUT|OUTPUT|TOTAL)_TOKENS=(\d+)")
RESULT_RE = re.compile(r"RESULT=(.+)")


class WorkerError(RuntimeError):
    """Raised when worker setup or execution fails."""


def _load_contract() -> dict[str, Any]:
    try:
        payload = yaml.safe_load(CONTRACT.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as exc:
        raise WorkerError(f"cannot load worker contract: {exc}") from exc
    return payload if isinstance(payload, dict) else {}


def _task_execution_contract(contract: dict[str, Any]) -> dict[str, Any]:
    task_execution = contract.get("task_execution")
    return task_execution if isinstance(task_execution, dict) else {}


def _runtime_contract(contract: dict[str, Any]) -> dict[str, Any]:
    runtime = contract.get("runtime")
    return runtime if isinstance(runtime, dict) else {}


def _now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _write_status(payload: dict[str, Any]) -> None:
    STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATUS_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, STATUS_PATH)


def _task_doc(path: Path) -> dict[str, Any]:
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return {}
    return payload if isinstance(payload, dict) else {}


_AGENT_TOOL_REFUSAL = (
    "agent_tool route target requires bridge_allowed=true and a readable "
    "route_prompt_ref. Generic tool-using AI-agent autonomy remains unavailable."
)
V2_1_SCOPE = "tool_using_agent_v2_1_readonly_repo"
V2_2_SCOPE = "tool_using_agent_v2_2_readonly_capability_calls"
V2_3_SCOPE = "tool_using_agent_v2_3_fenced_artifact_write"
V2_4_SCOPE = "tool_using_agent_v2_4_patch_artifact"
V2_5_SCOPE = "tool_using_agent_v2_5_patch_apply_sandbox"


def _task_supported(doc: dict[str, Any], *, allowlist: set[str], supported_routes: set[str]) -> tuple[bool, str]:
    route_target = str(doc.get("route_target") or "").strip().lower()
    if route_target not in supported_routes:
        return False, f"unsupported route_target={route_target or 'unset'}"
    if route_target == "capability":
        capability = str(doc.get("route_capability") or "").strip()
        if not capability:
            payload = doc.get("payload")
            if isinstance(payload, str):
                try:
                    payload = json.loads(payload)
                except json.JSONDecodeError:
                    payload = {}
            if isinstance(payload, dict):
                capability = str(payload.get("route_capability") or "").strip()
        if not capability:
            return False, "capability route missing route_capability"
        if capability not in allowlist:
            return False, f"capability {capability} not allowlisted"
    elif route_target == "agent_tool":
        payload = _normalize_payload(doc)
        bridge_allowed = bool(doc.get("bridge_allowed") or payload.get("bridge_allowed"))
        prompt_ref = str(doc.get("route_prompt_ref") or payload.get("route_prompt_ref") or "").strip()
        if not bridge_allowed or not prompt_ref:
            return False, _AGENT_TOOL_REFUSAL
    return True, ""


def _route_via_cap_sh(cap_name: str, args: list[str]) -> subprocess.CompletedProcess:
    """Invoke a mutating mailroom.task.* cap through ./bin/ops cap run so
    cap.sh's db_authority routing handles canonical placement.

    On the storage_evidence_node (pve) cap.sh detects local hostname is in
    db_authority.authority_hostnames and runs the cap locally (no SSH hop).
    On non-authority hosts (ai-cons, macbook) cap.sh routes the cap to pve
    via SSH so the queue-state mutation lands on canonical. Either way the
    queue file the worker SSH-merge-fetched in this pass is the same file
    the routed cap reads on canonical.
    """
    return subprocess.run(
        [str(ROOT / "bin" / "ops"), "cap", "run", cap_name, "--", *args],
        capture_output=True,
        text=True,
        check=False,
        env=os.environ.copy(),
    )


def _route_via_cap_sh_extract_data(cap_name: str, args: list[str], task_id: str) -> dict[str, Any]:
    """Run a routed cap and parse its JSON `data` field tolerating cap.sh's
    surrounding receipt/header text. We scan stdout for the last JSON object
    that contains a `data` key, which works for both local and routed paths."""
    proc = _route_via_cap_sh(cap_name, args)
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"{cap_name} failed for {task_id}")
    text = proc.stdout
    decoder = json.JSONDecoder()
    idx = 0
    last_obj: dict[str, Any] = {}
    while True:
        start = text.find("{", idx)
        if start < 0:
            break
        try:
            obj, end = decoder.raw_decode(text, start)
        except json.JSONDecodeError:
            idx = start + 1
            continue
        if isinstance(obj, dict) and "data" in obj:
            last_obj = obj
        idx = end
    return last_obj.get("data") if isinstance(last_obj.get("data"), dict) else {}


def _claim_task(task_id: str, worker_id: str) -> dict[str, Any]:
    return _route_via_cap_sh_extract_data(
        "mailroom.task.claim",
        ["--task-id", task_id, "--worker", worker_id, "--json"],
        task_id,
    )


def _heartbeat_task(task_id: str, progress: str) -> None:
    proc = _route_via_cap_sh(
        "mailroom.task.heartbeat",
        ["--task-id", task_id, "--progress", progress, "--json"],
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.heartbeat failed for {task_id}")


def _complete_task(task_id: str, result: str) -> None:
    proc = _route_via_cap_sh(
        "mailroom.task.complete",
        ["--task-id", task_id, "--result", result, "--json"],
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.complete failed for {task_id}")


def _fail_task(task_id: str, reason: str) -> None:
    proc = _route_via_cap_sh(
        "mailroom.task.fail",
        ["--task-id", task_id, "--reason", reason, "--json"],
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.fail failed for {task_id}")


def _running_file(task_id: str) -> Path:
    return TASK_ROOT / "running" / f"{task_id}.yaml"


def _terminal_file(task_id: str, state: str) -> Path:
    return TASK_ROOT / state / f"{task_id}.yaml"


def _write_task_fields(path: Path, fields: dict[str, Any]) -> None:
    doc = _task_doc(path)
    if not doc:
        return
    doc.update(fields)
    tmp = path.with_suffix(".yaml.tmp")
    tmp.write_text(yaml.safe_dump(doc, sort_keys=False), encoding="utf-8")
    os.replace(tmp, path)


def _normalize_payload(doc: dict[str, Any]) -> dict[str, Any]:
    payload = doc.get("payload")
    if isinstance(payload, dict):
        return payload
    if isinstance(payload, str) and payload.strip():
        try:
            decoded = json.loads(payload)
        except json.JSONDecodeError:
            return {}
        return decoded if isinstance(decoded, dict) else {}
    return {}


def _payload_list(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(item).strip() for item in value if str(item).strip()]
    if isinstance(value, str) and value.strip():
        return [item.strip() for item in value.split(",") if item.strip()]
    return []


def _agent_bridge_contract() -> dict[str, Any]:
    return (_task_execution_contract(_load_contract()).get("agent_tool_bridge") or {})


def _repo_relative_path(path: Path) -> str:
    return str(path.relative_to(ROOT.resolve()))


def _bridge_section(name: str) -> dict[str, Any]:
    bridge = _agent_bridge_contract()
    section = bridge.get(name)
    return section if isinstance(section, dict) else {}


def _state_root() -> Path:
    if STATE_ROOT:
        return Path(STATE_ROOT)
    raise WorkerError("SPINE_STATE not set; fenced AI bridge artifact writes require governed runtime state")


def _resolve_artifact_root(raw: str, fallback: str) -> Path:
    value = raw or fallback
    value = value.replace("$SPINE_STATE", str(_state_root()))
    return Path(value).expanduser().resolve()


def _safe_artifact_name(task_id: str, raw_name: str, *, default_suffix: str, allowed_extensions: set[str]) -> str:
    name = str(raw_name or "").strip() or f"{task_id}{default_suffix}"
    name = name.replace("\\", "/").split("/")[-1]
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip(".-")
    if not name:
        name = f"{task_id}{default_suffix}"
    suffix = Path(name).suffix
    if suffix not in allowed_extensions:
        name = f"{Path(name).stem or task_id}{default_suffix}"
    return name


def _write_bounded_artifact(
    *,
    task_id: str,
    payload: dict[str, Any],
    result_text: str,
    section_name: str,
    root_key: str,
    fallback_root: str,
    max_bytes_key: str,
    default_max_bytes: int,
    allowed_extensions: set[str],
    default_suffix: str,
    name_keys: tuple[str, ...],
) -> tuple[Path, Path, int, bool]:
    section = _bridge_section(section_name)
    root = _resolve_artifact_root(str(section.get(root_key) or ""), fallback_root)
    root.mkdir(parents=True, exist_ok=True)
    raw_name = ""
    for key in name_keys:
        raw_name = str(payload.get(key) or "").strip()
        if raw_name:
            break
    name = _safe_artifact_name(task_id, raw_name, default_suffix=default_suffix, allowed_extensions=allowed_extensions)
    target = (root / task_id / name).resolve()
    try:
        target.relative_to(root)
    except ValueError as exc:
        raise WorkerError(f"artifact path outside governed fence: {target}") from exc
    target.parent.mkdir(parents=True, exist_ok=True)

    max_bytes = int(section.get(max_bytes_key) or default_max_bytes)
    if max_bytes < 1:
        raise WorkerError(f"{section_name} {max_bytes_key} must be positive")
    encoded = result_text.encode("utf-8", errors="replace")
    chunk = encoded[:max_bytes]
    target.write_bytes(chunk)
    return target, root, len(chunk), len(encoded) > len(chunk)


def _extract_patch_text(result_text: str) -> str:
    text = result_text.strip()
    fenced = re.search(r"```(?:diff|patch)?\s*\n(.*?)\n```", text, flags=re.DOTALL)
    if fenced:
        text = fenced.group(1).strip()
    start_markers = ("diff --git ", "--- ")
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if line.startswith(start_markers):
            return "\n".join(lines[index:]).strip() + "\n"
    return text + ("\n" if text else "")


def _patch_paths(patch_text: str) -> list[str]:
    paths: list[str] = []
    for line in patch_text.splitlines():
        if line.startswith("+++ b/"):
            paths.append(line.removeprefix("+++ b/").strip())
        elif line.startswith("--- a/"):
            paths.append(line.removeprefix("--- a/").strip())
        elif line.startswith("diff --git "):
            parts = line.split()
            if len(parts) >= 4 and parts[3].startswith("b/"):
                paths.append(parts[3].removeprefix("b/").strip())
    blocked = {"", "/dev/null"}
    return sorted(set(path for path in paths if path not in blocked and not path.startswith("../") and "/../" not in path))


def _status_paths(status_lines: list[str]) -> list[str]:
    paths: list[str] = []
    for line in status_lines:
        if not line.strip():
            continue
        path = line[3:] if len(line) > 3 else line.strip()
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        paths.append(path.strip())
    return sorted(set(paths))


def _write_sandbox_lease(worktree: Path, task_id: str, ttl_hours: int) -> Path:
    lease_path = worktree / ".spine-lane-lease.yaml"
    lease = {
        "status": "active",
        "owner": "mailroom.patch_apply_sandbox",
        "task_id": task_id,
        "created_at": _now(),
        "heartbeat_at": _now(),
        "ttl_hours": ttl_hours,
        "source_contract": "ops/bindings/worktree.lifecycle.contract.yaml",
        "cleanup": "remove worktree after task terminal receipt",
    }
    lease_path.write_text(yaml.safe_dump(lease, sort_keys=False), encoding="utf-8")
    return lease_path


def _sandbox_patch_apply(task_id: str, payload: dict[str, Any], patch_text: str) -> dict[str, Any]:
    v2 = _bridge_section("v2_5_patch_apply_sandbox")
    root = _resolve_artifact_root(str(v2.get("sandbox_root") or ""), "$SPINE_STATE/agent-worktrees/ai-bridge")
    root.mkdir(parents=True, exist_ok=True)
    worktree = (root / task_id).resolve()
    try:
        worktree.relative_to(root)
    except ValueError as exc:
        raise WorkerError(f"sandbox worktree outside governed fence: {worktree}") from exc
    if worktree.exists():
        raise WorkerError(f"sandbox worktree already exists: {worktree}")

    timeout = int(v2.get("apply_timeout_seconds") or 60)
    verify_command = payload.get("sandbox_verify_command") or v2.get("verify_command") or []
    if not isinstance(verify_command, list):
        verify_command = []
    verify_command = [str(item) for item in verify_command if str(item).strip()]
    if verify_command:
        allowed_verify = [str(item) for item in (v2.get("allowed_verify_commands") or []) if str(item).strip()]
        if verify_command not in [item.split(" ") for item in allowed_verify]:
            joined = " ".join(verify_command)
            if joined not in allowed_verify:
                raise WorkerError(f"sandbox verify command not allowlisted: {joined}")

    patch = _extract_patch_text(patch_text)
    if not patch.strip():
        raise WorkerError("patch_apply_sandbox requires non-empty patch text")
    expected_patch_files = _patch_paths(patch)
    if not expected_patch_files:
        raise WorkerError("patch_apply_sandbox requires parseable unified diff file paths")
    max_patch_bytes = int(v2.get("max_patch_bytes") or 48000)
    encoded = patch.encode("utf-8", errors="replace")
    if len(encoded) > max_patch_bytes:
        raise WorkerError(f"patch_apply_sandbox patch exceeds max_patch_bytes={max_patch_bytes}")

    patch_file = _resolve_artifact_root(
        str(v2.get("patch_artifact_root") or ""),
        "$SPINE_STATE/agent-artifacts/ai-bridge-patches",
    ) / task_id / "applied.patch"
    patch_file.parent.mkdir(parents=True, exist_ok=True)
    patch_file.write_bytes(encoded)

    added = False
    try:
        add_proc = subprocess.run(
            ["git", "worktree", "add", "--detach", str(worktree), "HEAD"],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
        )
        if add_proc.returncode != 0:
            raise WorkerError(add_proc.stderr.strip() or add_proc.stdout.strip() or "git worktree add failed")
        added = True
        lease_ttl_hours = int(v2.get("lease_ttl_hours") or 24)
        lease_path = _write_sandbox_lease(worktree, task_id, lease_ttl_hours)

        check_proc = subprocess.run(
            ["git", "apply", "--check", str(patch_file)],
            cwd=str(worktree),
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
        )
        if check_proc.returncode != 0:
            raise WorkerError(check_proc.stderr.strip() or check_proc.stdout.strip() or "git apply --check failed")

        apply_proc = subprocess.run(
            ["git", "apply", str(patch_file)],
            cwd=str(worktree),
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
        )
        if apply_proc.returncode != 0:
            raise WorkerError(apply_proc.stderr.strip() or apply_proc.stdout.strip() or "git apply failed")

        status_proc = subprocess.run(
            ["git", "status", "--short"],
            cwd=str(worktree),
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
        )
        if status_proc.returncode != 0:
            raise WorkerError(status_proc.stderr.strip() or status_proc.stdout.strip() or "git status failed")
        status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
        actual_files = [path for path in _status_paths(status_lines) if path != lease_path.name]
        side_effect_files = sorted(set(actual_files) - set(expected_patch_files))
        missing_files = sorted(set(expected_patch_files) - set(actual_files))
        if side_effect_files or missing_files:
            raise WorkerError(f"patch side-effect mismatch side_effects={side_effect_files} missing={missing_files}")

        verify_rc: int | None = None
        verify_stdout = ""
        verify_stderr = ""
        if verify_command:
            verify_proc = subprocess.run(
                verify_command,
                cwd=str(worktree),
                capture_output=True,
                text=True,
                check=False,
                timeout=timeout,
            )
            verify_rc = verify_proc.returncode
            verify_stdout = verify_proc.stdout[-2000:]
            verify_stderr = verify_proc.stderr[-2000:]
            if verify_proc.returncode != 0:
                raise WorkerError(f"sandbox verify command rc={verify_proc.returncode}: {(verify_proc.stderr or verify_proc.stdout).splitlines()[-1][:240] if (verify_proc.stderr or verify_proc.stdout).splitlines() else ''}")

        return {
            "patch_artifact_path": str(patch_file),
            "patch_bytes": len(encoded),
            "sandbox_root": str(root),
            "sandbox_worktree": task_id,
            "sandbox_worktree_retained": False,
            "sandbox_cleanup": "removed",
            "worktree_lifecycle_contract": "ops/bindings/worktree.lifecycle.contract.yaml",
            "lease_filename": lease_path.name,
            "lease_ttl_hours": lease_ttl_hours,
            "patch_apply_check": True,
            "patch_apply_status": "applied",
            "worktree_mutation": True,
            "worktree_mutation_scope": "leased_sandbox_only",
            "push_performed": False,
            "merge_performed": False,
            "worktree_status": status_lines,
            "expected_patch_files": expected_patch_files,
            "actual_patch_files": actual_files,
            "side_effect_files": side_effect_files,
            "verify_command": verify_command,
            "verify_rc": verify_rc,
            "verify_stdout_excerpt": verify_stdout,
            "verify_stderr_excerpt": verify_stderr,
        }
    finally:
        if added:
            subprocess.run(
                ["git", "worktree", "remove", "--force", str(worktree)],
                cwd=str(ROOT),
                capture_output=True,
                text=True,
                check=False,
                timeout=timeout,
            )
        if worktree.exists():
            shutil.rmtree(worktree, ignore_errors=True)


def _requested_readonly_capability(payload: dict[str, Any]) -> str:
    values: list[str] = []
    for key in (
        "read_only_capability",
        "readonly_capability",
        "route_capability",
        "capability",
    ):
        value = str(payload.get(key) or "").strip()
        if value:
            values.append(value)
    values.extend(_payload_list(payload.get("read_only_capabilities") or payload.get("capabilities")))

    unique = list(dict.fromkeys(values))
    if len(unique) != 1:
        raise WorkerError("read_only_capability tool_set requires exactly one requested capability")
    return unique[0]


def _run_readonly_capability_context(worker_id: str, payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    capability = _requested_readonly_capability(payload)
    v2 = _bridge_section("v2_2_read_only_capability_calls")
    allowlist = {str(item).strip() for item in (v2.get("capability_allowlist") or []) if str(item).strip()}
    if capability not in allowlist:
        raise WorkerError(f"read_only_capability {capability} not allowlisted")

    max_stdout_bytes = int(v2.get("max_stdout_bytes") or 12000)
    if max_stdout_bytes < 1:
        raise WorkerError("read_only_capability max_stdout_bytes must be positive")

    env = os.environ.copy()
    env["SPINE_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ROLE"] = worker_id
    env["SPINE_EXECUTION_CLASS"] = "worker"
    env["SPINE_RUNTIME_ROLE"] = "worker"
    env["SPINE_SESSION_POSTURE"] = "worker"

    proc = subprocess.run(
        [str(ROOT / "bin" / "ops"), "cap", "run", capability],
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    merged = "\n".join(part for part in [proc.stdout.strip(), proc.stderr.strip()] if part).strip()
    merged_bytes = merged.encode("utf-8", errors="replace")
    chunk = merged_bytes[:max_stdout_bytes]
    stdout_text = chunk.decode("utf-8", errors="replace")
    run_keys = list(dict.fromkeys(RUN_KEY_RE.findall(merged)))
    proof = {
        "tool_set": "read_only_capability_calls",
        "tool_access": "bounded_read_only_capability_context",
        "capabilities_called": [capability],
        "run_keys": run_keys,
        "stdout_bytes": len(chunk),
        "stdout_truncated": len(merged_bytes) > len(chunk),
        "tool_call_count": 1,
        "mutation_access": "none",
    }
    if proc.returncode != 0:
        reason = f"read_only_capability={capability} rc={proc.returncode}"
        if merged:
            reason = f"{reason} :: {merged.splitlines()[-1][:240]}"
        raise WorkerError(reason)
    return (
        "\n\nREAD_ONLY_CAPABILITY_CONTEXT:\n"
        "The following read-only capability was run by the mailroom worker before spawn. "
        "The provider receives only this bounded output and receives no shell, filesystem, git, or ops access.\n\n"
        f"--- CAPABILITY: {capability} ---\n"
        f"{stdout_text}\n"
        f"--- END CAPABILITY: {capability} ---\n",
        proof,
    )


def _build_readonly_repo_context(payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
    if tool_set in {"", "none"}:
        tool_set = "prompt_only"
    if tool_set == "prompt_only":
        return "", {
            "tool_set": "prompt_only",
            "tool_access": "none",
            "files_read": [],
            "tool_call_count": 0,
        }
    if tool_set != "read_only_repo":
        raise WorkerError(f"unsupported agent tool_set={tool_set}")

    paths = _payload_list(payload.get("repo_read_paths") or payload.get("read_only_paths"))
    if not paths:
        raise WorkerError("read_only_repo tool_set requires repo_read_paths")

    v2 = _bridge_section("v2_1_read_only_repo_inspection")
    max_files = int(v2.get("max_files") or 6)
    max_bytes_per_file = int(v2.get("max_bytes_per_file") or 6000)
    max_total_bytes = int(v2.get("max_total_bytes") or 18000)
    excluded_roots = {str(item).strip() for item in (v2.get("excluded_roots") or [".git", ".runtime"]) if str(item).strip()}

    root_resolved = ROOT.resolve()
    sections: list[str] = []
    files_read: list[dict[str, Any]] = []
    total_bytes = 0

    for raw in paths[:max_files]:
        candidate = (ROOT / raw).expanduser()
        try:
            resolved = candidate.resolve()
        except OSError as exc:
            raise WorkerError(f"repo_read_path cannot be resolved: {raw}") from exc
        try:
            relative = resolved.relative_to(root_resolved)
        except ValueError as exc:
            raise WorkerError(f"repo_read_path outside repo root: {resolved}") from exc
        if relative.parts and relative.parts[0] in excluded_roots:
            raise WorkerError(f"repo_read_path uses excluded root: {relative.parts[0]}")
        if not resolved.is_file():
            raise WorkerError(f"repo_read_path is not a file: {relative}")

        raw_bytes = resolved.read_bytes()
        truncated = len(raw_bytes) > max_bytes_per_file
        chunk = raw_bytes[:max_bytes_per_file]
        remaining = max_total_bytes - total_bytes
        if remaining <= 0:
            break
        if len(chunk) > remaining:
            chunk = chunk[:remaining]
            truncated = True
        total_bytes += len(chunk)
        text = chunk.decode("utf-8", errors="replace")
        rel_text = str(relative)
        sections.append(f"--- FILE: {rel_text} ---\n{text}\n--- END FILE: {rel_text} ---")
        files_read.append(
            {
                "path": rel_text,
                "bytes_read": len(chunk),
                "truncated": truncated,
            }
        )

    if not files_read:
        raise WorkerError("read_only_repo tool_set produced no admitted file reads")
    return (
        "\n\nREAD_ONLY_REPO_CONTEXT:\n"
        "The following files were read by the mailroom worker before spawn. "
        "They are the only repo context admitted for this task.\n\n"
        + "\n\n".join(sections)
        + "\n",
        {
            "tool_set": "read_only_repo",
            "tool_access": "bounded_read_only_repo_context",
            "repo_fence": str(root_resolved),
            "files_read": files_read,
            "tool_call_count": len(files_read),
        },
    )


def _is_under_canonical_state(value: str) -> bool:
    """True if value is an absolute path under the storage_evidence_node
    canonical state root (per root.authority.contract.yaml
    storage_evidence_node_canonical.primary_canonical_root)."""
    if not value or not value.startswith("/"):
        return False
    return value.startswith(CANONICAL_STATE_ROOT_DEFAULT + "/")


def _fetch_canonical_prompt(canonical_path: str, task_id: str) -> tuple[Path, dict[str, Any]] | None:
    """SSH-fetch a canonical controller-prompt to a fenced local runtime
    artifact under $SPINE_STATE/agent-bridge-prompt-cache/<task_id>/. Returns
    (local_path, fetch_proof) so bridge_proof can record both canonical and
    local refs. Returns None on any failure (caller falls through to the
    admitted-roots refusal). pve remains the controller-prompt authority;
    the local copy is runtime-artifact only."""
    if DISABLE_CANONICAL_PROMPT_FETCH:
        return None
    if not _is_under_canonical_state(canonical_path):
        return None
    if not SSH_RESOLVER.is_file():
        return None
    target, _root, reason = _canonical_queue_target()
    if reason != "fetch" or not target:
        return None
    if not str(PROMPT_CACHE_FENCE):
        return None
    fence = PROMPT_CACHE_FENCE / task_id
    try:
        fence.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    local_path = fence / Path(canonical_path).name
    script = f'''
set -euo pipefail
source {shlex.quote(str(SSH_RESOLVER))}
target={shlex.quote(target["host_ref"])}
src={shlex.quote(canonical_path)}
resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 3 | awk '{{print $1}}')"
user="$(ssh_resolve_user "$target" ubuntu)"
identity_opts="$(ssh_resolve_machine_identity_opts "$target" 2>/dev/null || true)"
ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null $identity_opts "$user@$resolved" "cat \\"$src\\""
'''
    try:
        proc = subprocess.run(["bash", "-lc", script], cwd=str(ROOT), capture_output=True, text=True, timeout=20, check=False)
    except Exception:
        return None
    if proc.returncode != 0 or not proc.stdout:
        return None
    try:
        local_path.write_text(proc.stdout, encoding="utf-8")
    except OSError:
        return None
    fetch_proof: dict[str, Any] = {
        "canonical_prompt_ref": canonical_path,
        "local_prompt_copy": str(local_path),
        "prompt_copy_fence": str(PROMPT_CACHE_FENCE),
        "prompt_fetch_via": "ssh_canonical_state_root",
        "prompt_authority_host": target["host_ref"],
    }
    return local_path, fetch_proof


def _resolve_prompt_ref(value: str, task_id: str = "") -> tuple[Path, dict[str, Any]]:
    """Resolve route_prompt_ref to a local readable file plus a (possibly
    empty) fetch_proof dict. If the ref is outside admitted local roots but
    points at a controller-prompt under storage_evidence_node canonical state
    root, SSH-fetch into a fenced local runtime artifact and admit that.
    Refusals (unsafe path, unreadable file, fetch failure) preserve the
    original 'outside admitted roots' shape so upstream auditors see the
    same failure_reason vocabulary."""
    prompt_ref = Path(value).expanduser()
    if not prompt_ref.is_absolute():
        prompt_ref = ROOT / prompt_ref
    try:
        resolved = prompt_ref.resolve(strict=False)
    except OSError as exc:
        raise WorkerError(f"route_prompt_ref cannot be resolved: {value}") from exc
    spine_state = Path(os.environ.get("SPINE_STATE", "")).expanduser()
    admitted_roots = [ROOT]
    if str(spine_state):
        admitted_roots.append(spine_state)
    if str(PROMPT_CACHE_FENCE):
        admitted_roots.append(PROMPT_CACHE_FENCE)

    def _within_admitted(p: Path) -> bool:
        return any(
            str(p).startswith(str(root.resolve(strict=False)))
            for root in admitted_roots
            if str(root)
        )

    fetch_proof: dict[str, Any] = {}
    if not _within_admitted(resolved):
        fetched = _fetch_canonical_prompt(str(resolved), task_id)
        if fetched is None:
            raise WorkerError(f"route_prompt_ref outside admitted roots: {resolved}")
        resolved, fetch_proof = fetched
        try:
            resolved = resolved.resolve(strict=False)
        except OSError as exc:
            raise WorkerError(f"fetched prompt cannot be resolved: {value}") from exc
        if not _within_admitted(resolved):
            raise WorkerError(f"fetched prompt outside admitted roots: {resolved}")
    if not resolved.is_file():
        raise WorkerError(f"route_prompt_ref not readable file: {resolved}")
    return resolved, fetch_proof


def _build_agent_context(doc: dict[str, Any], worker_id: str) -> tuple[str, dict[str, Any]]:
    payload = _normalize_payload(doc)
    tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
    if tool_set in {"read_only_capability", "read_only_capability_calls"}:
        return _run_readonly_capability_context(worker_id, payload)
    if tool_set in {"fenced_artifact_write", "patch_artifact", "patch_apply_sandbox"}:
        return "", {
            "tool_set": tool_set,
            "tool_access": "none",
            "tool_call_count": 0,
        }
    return _build_readonly_repo_context(payload)


def _build_agent_prompt(task_id: str, doc: dict[str, Any], worker_id: str) -> tuple[str, Path, dict[str, Any]]:
    payload = _normalize_payload(doc)
    prompt_ref = str(doc.get("route_prompt_ref") or payload.get("route_prompt_ref") or "").strip()
    prompt_path, prompt_fetch_proof = _resolve_prompt_ref(prompt_ref, task_id=task_id)
    prompt_text = prompt_path.read_text(encoding="utf-8")
    max_prompt_bytes = int((_agent_bridge_contract().get("max_prompt_bytes")) or 12000)
    encoded = prompt_text.encode("utf-8")
    if len(encoded) > max_prompt_bytes:
        prompt_text = encoded[:max_prompt_bytes].decode("utf-8", errors="ignore")
    summary = str(doc.get("summary") or task_id).strip()
    tool_context, tool_proof = _build_agent_context(doc, worker_id)
    if prompt_fetch_proof:
        # Surface canonical_prompt_ref + local_prompt_copy + prompt_copy_fence
        # in tool_proof so they reach bridge_proof at the join point in
        # _execute_agent_tool. Local copy is runtime-artifact only; pve
        # remains the controller-prompt authority.
        tool_proof.update(prompt_fetch_proof)
    return (
        "You are a bounded AI agent running under the spine mailroom execution "
        "pickup bridge. You must not claim to mutate files, run shell commands, "
        "use hidden context, or complete work outside this prompt. If a "
        "READ_ONLY_REPO_CONTEXT or READ_ONLY_CAPABILITY_CONTEXT block is present, "
        "treat it as the only admitted inspection context for this task. "
        "For artifact or patch tasks, return the artifact or patch text only; "
        "the worker writes it after you return. "
        "Return a concise result with three fields: OBSERVED, RESULT, LIMITS.\n\n"
        f"TASK_ID: {task_id}\n"
        f"SUMMARY: {summary}\n"
        f"PROMPT_REF: {prompt_path}\n\n"
        "PROMPT_BODY:\n"
        f"{prompt_text}\n"
        f"{tool_context}",
        prompt_path,
        tool_proof,
    )


def _parse_provider_output(output: str) -> dict[str, Any]:
    provider: dict[str, Any] = {"usage": {}}
    for line in output.splitlines():
        match = PROVIDER_RUN_RE.match(line.strip())
        if match:
            provider[match.group(1).lower()] = match.group(2).strip()
            continue
        match = USAGE_RE.match(line.strip())
        if match:
            provider["usage"][match.group(1).lower()] = int(match.group(2))
            continue
        match = RESULT_RE.match(line.strip())
        if match:
            provider["result_file"] = match.group(1).strip()
    return provider


def _execute_agent_tool(task_id: str, doc: dict[str, Any], worker_id: str) -> dict[str, Any]:
    payload = _normalize_payload(doc)
    bridge_allowed = bool(doc.get("bridge_allowed") or payload.get("bridge_allowed"))
    if not bridge_allowed:
        _fail_task(task_id, _AGENT_TOOL_REFUSAL)
        return {"task_id": task_id, "status": "failed", "error": _AGENT_TOOL_REFUSAL}

    try:
        prompt, prompt_path, tool_proof = _build_agent_prompt(task_id, doc, worker_id)
    except WorkerError as exc:
        payload_tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
        if payload_tool_set == "read_only_repo":
            scope = V2_1_SCOPE
        elif payload_tool_set in {"read_only_capability", "read_only_capability_calls"}:
            scope = V2_2_SCOPE
            payload_tool_set = "read_only_capability_calls"
        elif payload_tool_set == "fenced_artifact_write":
            scope = V2_3_SCOPE
        elif payload_tool_set == "patch_artifact":
            scope = V2_4_SCOPE
        elif payload_tool_set == "patch_apply_sandbox":
            scope = V2_5_SCOPE
        else:
            scope = "bounded_readonly_provider_agent"
        reason = str(exc)
        proof = {
            "scope": scope,
            "status": "failed",
            "failure_reason": reason,
            "tool_set": payload_tool_set or "prompt_only",
            "mutation_access": "none",
            "receipt": "task_envelope_bridge_proof",
        }
        if scope == V2_2_SCOPE:
            requested = reason.split("read_only_capability ", 1)[1].split(" ", 1)[0] if "read_only_capability " in reason else ""
            if requested:
                proof["denied_capabilities"] = [requested]
        _fail_task(task_id, reason)
        _write_task_fields(
            _terminal_file(task_id, "failed"),
            {"bridge_proof": proof},
        )
        return {"task_id": task_id, "status": "failed", "route_target": "agent_tool", "error": reason}
    run_id = f"{task_id}-agent"
    provider_runs = ROOT / "ops" / "plugins" / "providers" / "runs"
    run_dir = provider_runs / run_id
    run_dir.mkdir(parents=True, exist_ok=True)
    request_file = run_dir / "request.txt"
    request_file.write_text(prompt, encoding="utf-8")

    provider = str(payload.get("provider") or os.environ.get("SPINE_AGENT_BRIDGE_PROVIDER") or "zai")
    timeout_seconds = int(payload.get("timeout_seconds") or ((_agent_bridge_contract().get("timeout_seconds")) or 300))
    env = os.environ.copy()
    env.update(
        {
            "SPINE_ENGINE_PROVIDER": provider,
            "SPINE_ENGINE_MAX_TOKENS": str(payload.get("max_tokens") or "512"),
            "SPINE_TERMINAL_ID": worker_id,
            "OPS_TERMINAL_ID": worker_id,
            "OPS_TERMINAL_ROLE": worker_id,
            "SPINE_EXECUTION_CLASS": "worker",
            "SPINE_RUNTIME_ROLE": "worker",
            "SPINE_SESSION_POSTURE": "worker",
        }
    )

    runner = ROOT / "ops" / "plugins" / "providers" / "bin" / "run.sh"
    if not runner.is_file():
        raise WorkerError(f"provider runner missing: {runner}")

    _heartbeat_task(task_id, f"spawning bounded provider agent provider={provider}")
    proc = subprocess.Popen(
        [str(runner), run_id],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    started = time.time()
    heartbeats = 0
    timed_out = False
    while proc.poll() is None:
        if time.time() - started > timeout_seconds:
            timed_out = True
            proc.kill()
            break
        _heartbeat_task(task_id, f"agent_tool running provider={provider} elapsed={int(time.time() - started)}s")
        heartbeats += 1
        time.sleep(5)
    stdout, stderr = proc.communicate()
    merged = "\n".join(part for part in [stdout.strip(), stderr.strip()] if part).strip()
    provider_info = _parse_provider_output(merged)
    result_file = Path(str(provider_info.get("result_file") or run_dir / "result.txt"))
    result_text = ""
    if result_file.is_file():
        result_text = result_file.read_text(encoding="utf-8").strip()
    if not result_text and merged:
        result_text = merged.splitlines()[-1][:1000]

    if tool_proof.get("tool_set") == "read_only_repo":
        scope = V2_1_SCOPE
    elif tool_proof.get("tool_set") == "read_only_capability_calls":
        scope = V2_2_SCOPE
    elif tool_proof.get("tool_set") == "fenced_artifact_write":
        scope = V2_3_SCOPE
    elif tool_proof.get("tool_set") == "patch_artifact":
        scope = V2_4_SCOPE
    elif tool_proof.get("tool_set") == "patch_apply_sandbox":
        scope = V2_5_SCOPE
    else:
        scope = "bounded_readonly_provider_agent"
    base_proof = {
        "scope": scope,
        "provider_requested": provider,
        "provider_used": provider_info.get("used"),
        "model": provider_info.get("model"),
        "prompt_ref": str(prompt_path),
        "run_id": run_id,
        "provider_run_retained": os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") == "1",
        "spawn": "subprocess",
        "prompt_injection": "route_prompt_ref",
        "heartbeats_emitted": heartbeats,
        "tool_access": tool_proof.get("tool_access") or "none",
        "mutation_access": "none",
        "receipt": "task_envelope_bridge_proof",
        "usage": provider_info.get("usage") or {},
    }
    base_proof.update(tool_proof)
    if proc.returncode == 0 and not timed_out:
        if scope == V2_3_SCOPE:
            artifact_path, artifact_fence, artifact_bytes, artifact_truncated = _write_bounded_artifact(
                task_id=task_id,
                payload=payload,
                result_text=result_text,
                section_name="v2_3_fenced_artifact_write",
                root_key="artifact_root",
                fallback_root="$SPINE_STATE/agent-artifacts/ai-bridge",
                max_bytes_key="max_artifact_bytes",
                default_max_bytes=24000,
                allowed_extensions={".md", ".txt", ".json"},
                default_suffix=".md",
                name_keys=("artifact_name", "artifact_path"),
            )
            base_proof.update(
                {
                    "artifact_path": str(artifact_path),
                    "artifact_fence": str(artifact_fence),
                    "artifact_bytes": artifact_bytes,
                    "artifact_truncated": artifact_truncated,
                    "mutation_access": "fenced_runtime_artifact_only",
                }
            )
        elif scope == V2_4_SCOPE:
            patch_path, patch_fence, patch_bytes, patch_truncated = _write_bounded_artifact(
                task_id=task_id,
                payload=payload,
                result_text=result_text,
                section_name="v2_4_patch_artifact",
                root_key="patch_artifact_root",
                fallback_root="$SPINE_STATE/agent-artifacts/ai-bridge-patches",
                max_bytes_key="max_patch_bytes",
                default_max_bytes=48000,
                allowed_extensions={".patch", ".diff"},
                default_suffix=".patch",
                name_keys=("patch_artifact_name", "patch_artifact_path", "artifact_name"),
            )
            base_proof.update(
                {
                    "patch_artifact_path": str(patch_path),
                    "patch_artifact_fence": str(patch_fence),
                    "patch_bytes": patch_bytes,
                    "patch_truncated": patch_truncated,
                    "worktree_mutation": False,
                    "mutation_access": "patch_artifact_only",
                }
            )
        elif scope == V2_5_SCOPE:
            try:
                sandbox_proof = _sandbox_patch_apply(task_id, payload, result_text)
            except WorkerError as exc:
                reason = str(exc)
                base_proof.update(
                    {
                        "tool_set": "patch_apply_sandbox",
                        "status": "failed",
                        "failure_reason": reason,
                        "mutation_access": "leased_sandbox_worktree_only",
                        "worktree_mutation_scope": "leased_sandbox_only",
                        "push_performed": False,
                        "merge_performed": False,
                    }
                )
                _fail_task(task_id, reason)
                _write_task_fields(_terminal_file(task_id, "failed"), {"bridge_proof": base_proof})
                if os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") != "1":
                    shutil.rmtree(run_dir, ignore_errors=True)
                return {"task_id": task_id, "status": "failed", "route_target": "agent_tool", "error": reason}
            base_proof.update(
                sandbox_proof
                | {
                    "tool_set": "patch_apply_sandbox",
                    "tool_access": "none",
                    "mutation_access": "leased_sandbox_worktree_only",
                }
            )
    if base_proof["provider_run_retained"]:
        base_proof.update(
            {
                "run_dir": str(run_dir),
                "request_file": str(request_file),
                "result_file": str(result_file),
            }
        )
    if timed_out:
        reason = f"agent_tool provider={provider} timed out after {timeout_seconds}s"
        _fail_task(task_id, reason)
        _write_task_fields(_terminal_file(task_id, "failed"), {"bridge_proof": base_proof | {"status": "failed", "failure_reason": reason}})
        if os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") != "1":
            shutil.rmtree(run_dir, ignore_errors=True)
        return {"task_id": task_id, "status": "failed", "error": reason}
    if proc.returncode != 0:
        reason = f"agent_tool provider={provider} rc={proc.returncode}"
        if merged:
            reason = f"{reason} :: {merged.splitlines()[-1][:240]}"
        _fail_task(task_id, reason)
        _write_task_fields(_terminal_file(task_id, "failed"), {"bridge_proof": base_proof | {"status": "failed", "failure_reason": reason}})
        if os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") != "1":
            shutil.rmtree(run_dir, ignore_errors=True)
        return {"task_id": task_id, "status": "failed", "error": reason}

    summary = str(doc.get("summary") or task_id).strip()
    result = f"{summary} -> agent_tool provider={provider_info.get('used') or provider} model={provider_info.get('model') or 'unknown'} bridge_proof={scope}"
    _complete_task(task_id, result)
    _write_task_fields(
        _terminal_file(task_id, "done"),
        {
            "bridge_proof": base_proof | {
                "status": "completed",
                "result_excerpt": result_text[:1000],
            }
        },
    )
    if os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") != "1":
        shutil.rmtree(run_dir, ignore_errors=True)
    return {
        "task_id": task_id,
        "status": "completed",
        "route_target": "agent_tool",
        "provider": provider_info.get("used") or provider,
        "model": provider_info.get("model") or "",
        "result": result,
    }


def _execute_capability(task_id: str, doc: dict[str, Any], worker_id: str) -> dict[str, Any]:
    payload = _normalize_payload(doc)
    capability = str(doc.get("route_capability") or payload.get("route_capability") or "").strip()
    route_args = doc.get("route_args")
    if not isinstance(route_args, list):
        route_args = payload.get("route_args")
    route_args = [str(item) for item in route_args] if isinstance(route_args, list) else []
    summary = str(doc.get("summary") or task_id).strip()

    _heartbeat_task(task_id, f"executing capability {capability}")
    env = os.environ.copy()
    env["SPINE_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ROLE"] = worker_id
    env["SPINE_EXECUTION_CLASS"] = "worker"
    env["SPINE_RUNTIME_ROLE"] = "worker"
    env["SPINE_SESSION_POSTURE"] = "worker"

    cmd = [str(ROOT / "bin" / "ops"), "cap", "run", capability]
    if route_args:
        cmd.extend(["--", *route_args])
    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    merged = "\n".join(part for part in [proc.stdout.strip(), proc.stderr.strip()] if part).strip()
    run_key = ""
    match = RUN_KEY_RE.search(merged)
    if match:
        run_key = match.group(1)

    if proc.returncode == 0:
        result = f"{summary} -> capability={capability}"
        if run_key:
            result += f" run_key={run_key}"
        _complete_task(task_id, result)
        return {
            "task_id": task_id,
            "status": "completed",
            "capability": capability,
            "run_key": run_key,
            "result": result,
        }

    failure_reason = f"capability={capability} rc={proc.returncode}"
    if merged:
        failure_reason = f"{failure_reason} :: {merged.splitlines()[-1][:240]}"
    _fail_task(task_id, failure_reason)
    return {
        "task_id": task_id,
        "status": "failed",
        "capability": capability,
        "run_key": run_key,
        "error": failure_reason,
    }


def _db_authority_block() -> dict[str, Any]:
    if not RUNTIME_BOOTSTRAP_CONTRACT.is_file():
        return {}
    try:
        payload = yaml.safe_load(RUNTIME_BOOTSTRAP_CONTRACT.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return {}
    block = payload.get("db_authority") if isinstance(payload, dict) else None
    return block if isinstance(block, dict) else {}


def _local_hostname() -> str:
    try:
        proc = subprocess.run(["hostname", "-s"], capture_output=True, text=True, timeout=2, check=False)
        if proc.returncode == 0:
            return proc.stdout.strip()
    except Exception:
        pass
    try:
        return subprocess.check_output(["hostname"], text=True, timeout=2).strip()
    except Exception:
        return ""


def _canonical_queue_target() -> tuple[str, str, str]:
    """Return (host_ref, remote_root, reason).

    reason: 'fetch' (do canonical fetch), 'authority_local' (this host owns canonical),
    'disabled_env', 'disabled_contract', 'no_host'.
    """
    if DISABLE_CANONICAL_QUEUE:
        return "", "", "disabled_env"
    block = _db_authority_block()
    if not block or block.get("enabled") is not True:
        return "", "", "disabled_contract"
    authority_hostnames = block.get("authority_hostnames") or []
    if not isinstance(authority_hostnames, list):
        authority_hostnames = []
    if _local_hostname() in {str(h) for h in authority_hostnames}:
        return "", "", "authority_local"
    host_ref = str(block.get("host") or block.get("host_addr_lan") or "").strip()
    if not host_ref:
        return "", "", "no_host"
    return host_ref, CANONICAL_TASK_ROOT_DEFAULT, "fetch"


def _load_canonical_queued_docs(host_ref: str, remote_root: str) -> tuple[list[dict[str, Any]], str]:
    """SSH-fetch canonical queued/*.yaml. Returns (docs, status: 'ok'|'unreachable')."""
    if not SSH_RESOLVER.is_file():
        return [], "unreachable"
    remote_dir = f"{remote_root}/queued"
    script = f'''
set -euo pipefail
source {shlex.quote(str(SSH_RESOLVER))}
target={shlex.quote(host_ref)}
dir={shlex.quote(remote_dir)}
resolved="$(ssh_resolve_ssh_host_with_fallback "$target" 3 | awk '{{print $1}}')"
user="$(ssh_resolve_user "$target" ubuntu)"
identity_opts="$(ssh_resolve_machine_identity_opts "$target" 2>/dev/null || true)"
ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null $identity_opts "$user@$resolved" \
    "for f in \\"$dir\\"/TASK-*.yaml; do [ -f \\"\\$f\\" ] || continue; echo '---'; cat \\"\\$f\\"; done"
'''
    try:
        proc = subprocess.run(["bash", "-lc", script], cwd=str(ROOT), capture_output=True, text=True, timeout=20, check=False)
    except Exception:
        return [], "unreachable"
    if proc.returncode != 0:
        return [], "unreachable"
    text = proc.stdout
    if not text.strip():
        return [], "ok"
    try:
        docs = list(yaml.safe_load_all(text))
    except Exception:
        return [], "unreachable"
    return [d for d in docs if isinstance(d, dict)], "ok"


_PROVIDER_CACHE: dict[str, bool] = {}


def _provider_ready_locally(provider_id: str) -> tuple[bool, str]:
    """Run providers-status --provider <id> --json and return (ready, reason).

    Cached per worker pass to avoid re-spawning the status probe per task.
    Failure to invoke providers-status is treated as 'unknown' (allow claim) so
    we do not block work when the readiness probe itself is broken.
    """
    if DISABLE_PROVIDER_PLACEMENT or not provider_id:
        return True, "placement_check_disabled"
    if provider_id in _PROVIDER_CACHE:
        return _PROVIDER_CACHE[provider_id], "cached"
    if not PROVIDERS_STATUS_BIN.is_file():
        return True, "providers_status_missing"
    try:
        proc = subprocess.run(
            [str(PROVIDERS_STATUS_BIN), "--surface", "spine_engine", "--provider", provider_id, "--json"],
            capture_output=True, text=True, timeout=10, check=False,
        )
    except Exception:
        return True, "providers_status_error"
    if proc.returncode != 0:
        return True, f"providers_status_rc={proc.returncode}"
    try:
        payload = json.loads(proc.stdout)
    except Exception:
        return True, "providers_status_parse_error"
    candidates = payload.get("candidates") or []
    if not isinstance(candidates, list):
        return True, "providers_status_bad_shape"
    for cand in candidates:
        if not isinstance(cand, dict):
            continue
        if str(cand.get("id") or "") == provider_id:
            ready = bool(cand.get("ready"))
            _PROVIDER_CACHE[provider_id] = ready
            reason = "ready" if ready else str(cand.get("reason") or "not_ready")
            return ready, reason
    _PROVIDER_CACHE[provider_id] = False
    return False, "provider_not_in_candidates"


def _agent_tool_provider_for(doc: dict[str, Any]) -> str:
    payload = _normalize_payload(doc)
    return str(payload.get("provider") or os.environ.get("SPINE_AGENT_BRIDGE_PROVIDER") or "zai").strip()


def _process_once(*, worker_id: str, claim_limit: int, allowlist: set[str], supported_routes: set[str]) -> dict[str, Any]:
    QUEUED_DIR.mkdir(parents=True, exist_ok=True)
    _PROVIDER_CACHE.clear()
    canonical_host, canonical_root, canonical_reason = _canonical_queue_target()
    canonical_docs: list[dict[str, Any]] = []
    canonical_fetch_status = canonical_reason
    seen_task_ids: set[str] = set()
    queue_entries: list[tuple[str, dict[str, Any] | None, Path | None]] = []

    if canonical_reason == "fetch":
        canonical_docs, fetch_status = _load_canonical_queued_docs(canonical_host, canonical_root)
        canonical_fetch_status = "merged" if fetch_status == "ok" else "unreachable"
        for doc in canonical_docs:
            tid = str(doc.get("task_id") or "").strip()
            if not tid or tid in seen_task_ids:
                continue
            seen_task_ids.add(tid)
            queue_entries.append((tid, doc, None))

    local_paths = sorted(QUEUED_DIR.glob("TASK-*.yaml"))
    for path in local_paths:
        tid = path.stem
        if tid in seen_task_ids:
            continue
        seen_task_ids.add(tid)
        queue_entries.append((tid, None, path))

    queued = local_paths  # preserved for queued_seen accounting below
    claimed: list[dict[str, Any]] = []
    completed: list[dict[str, Any]] = []
    failed: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []

    for entry_task_id, entry_doc, entry_path in queue_entries:
        if len(claimed) >= claim_limit:
            break
        doc = entry_doc if entry_doc is not None else (_task_doc(entry_path) if entry_path else {})
        if not doc:
            skipped.append({"task_id": entry_task_id, "reason": "unreadable task envelope"})
            continue
        supported, reason = _task_supported(doc, allowlist=allowlist, supported_routes=supported_routes)
        task_id = str(doc.get("task_id") or entry_task_id).strip()
        if not supported:
            route_target = str(doc.get("route_target") or "").strip().lower()
            if route_target == "agent_tool":
                # Hard refusal: claim then fail so the operator sees an
                # explicit outcome rather than a silent skip that leaves the
                # task stuck in the queue forever.
                try:
                    _claim_task(task_id, worker_id)
                    _fail_task(task_id, reason)
                    failed.append({"task_id": task_id, "status": "failed", "error": reason})
                except WorkerError:
                    skipped.append({"task_id": task_id, "reason": f"deferred-refusal claim error: {reason}"})
            else:
                skipped.append({"task_id": task_id, "reason": reason})
            continue
        # Provider-placement honesty: for agent_tool tasks, check whether the
        # requested provider is ready on this host BEFORE claiming. If not, leave
        # the task queued for a host that can run it. This is a soft skip — no
        # claim, no mutation, no fail. The worker contract surfaces this in
        # canonical_queue_truth.provider_placement_check.
        route_target_check = str(doc.get("route_target") or "").strip().lower()
        if route_target_check == "agent_tool":
            provider_id = _agent_tool_provider_for(doc)
            ready, ready_reason = _provider_ready_locally(provider_id)
            if not ready:
                skipped.append({
                    "task_id": task_id,
                    "reason": (
                        f"placement_unsuitable: provider={provider_id} "
                        f"not ready on {_local_hostname() or 'this_host'} "
                        f"({ready_reason}); leaving queued for provider-ready host"
                    ),
                })
                continue
        claim_data = _claim_task(task_id, worker_id)
        claimed.append({"task_id": task_id, "state": "running", "worker": worker_id})
        # The post-claim envelope at $SPINE_STATE/agent-tasks/running/<task>.yaml
        # only resolves locally on the canonical authority host. From a non-
        # authority host (e.g. ai-consolidation) the envelope is on canonical
        # pve and not readable through this script. The body of the envelope is
        # invariant across the queued -> running transition, so we reuse the
        # doc we already fetched (canonical via SSH-merge, or local). If the
        # canonical authority host can read the running file directly, prefer
        # that for freshness; otherwise fall back to the merge-time doc.
        running_doc = doc
        if claim_data.get("file"):
            running_file = Path(str(claim_data.get("file")))
            if running_file.is_file():
                fresh = _task_doc(running_file)
                if fresh:
                    running_doc = fresh
        if str(running_doc.get("route_target") or "").strip().lower() == "agent_tool":
            result = _execute_agent_tool(task_id, running_doc, worker_id)
        else:
            result = _execute_capability(task_id, running_doc, worker_id)
        if result.get("status") == "completed":
            completed.append(result)
        else:
            failed.append(result)

    heartbeat_at = _now()
    payload = {
        "generated_at": heartbeat_at,
        "heartbeat_at": heartbeat_at,
        "worker_id": worker_id,
        "mode": "once",
        "queued_seen": len(queue_entries),
        "queued_seen_local": len(queued),
        "queued_seen_canonical": len(canonical_docs),
        "canonical_queue_status": canonical_fetch_status,
        "claimed": claimed,
        "completed": completed,
        "failed": failed,
        "skipped": skipped,
    }
    _write_status(payload)
    return payload


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="mailroom-task-worker",
        description="Run the operational mailroom worker once or in foreground mode.",
    )
    parser.add_argument("--once", action="store_true", help="Run one bounded worker pass and exit.")
    parser.add_argument("--foreground", action="store_true", help="Run as a long-lived polling worker.")
    parser.add_argument("--worker-id", default="", help="Canonical worker terminal identity.")
    parser.add_argument("--poll-seconds", type=int, default=0, help="Foreground poll interval override.")
    parser.add_argument("--claim-limit", type=int, default=0, help="Maximum claims per pass override.")
    parser.add_argument("--json", action="store_true", dest="json_output", help="Emit JSON output.")
    parser.add_argument("--self-check", action="store_true", help="Verify dependencies and exit.")

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            v2_2 = _bridge_section("v2_2_read_only_capability_calls")
            allowlist = {str(item).strip() for item in (v2_2.get("capability_allowlist") or []) if str(item).strip()}
            if not allowlist:
                raise WorkerError("v2_2_read_only_capability_calls capability_allowlist missing")
            if _requested_readonly_capability({"read_only_capability": sorted(allowlist)[0]}) not in allowlist:
                raise WorkerError("read_only_capability request parser failed")
            if _bridge_section("v2_3_fenced_artifact_write").get("scope") != V2_3_SCOPE:
                raise WorkerError("v2_3_fenced_artifact_write scope missing")
            if _bridge_section("v2_4_patch_artifact").get("scope") != V2_4_SCOPE:
                raise WorkerError("v2_4_patch_artifact scope missing")
            if _bridge_section("v2_5_patch_apply_sandbox").get("scope") != V2_5_SCOPE:
                raise WorkerError("v2_5_patch_apply_sandbox scope missing")
            print("mailroom.task.worker.once self-check PASS")
            return 0
        except (ImportError, WorkerError) as exc:
            print(f"mailroom.task.worker.once self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()
    if not STATE_ROOT:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"mailroom.task.worker FAIL: {msg}", file=sys.stderr)
        return 1

    contract = _load_contract()
    runtime_contract = _runtime_contract(contract)
    task_execution = _task_execution_contract(contract)
    worker_id = args.worker_id or str(task_execution.get("claim_policy", {}).get("worker_id") or "SPINE-EXECUTION-01")
    claim_limit = args.claim_limit or int(task_execution.get("max_claims_per_tick") or 1)
    poll_seconds = args.poll_seconds or int(runtime_contract.get("poll_seconds") or 90)
    supported_routes = {str(item).strip() for item in (task_execution.get("execute_route_targets") or []) if str(item).strip()}
    allowlist = {str(item).strip() for item in (task_execution.get("capability_allowlist") or []) if str(item).strip()}

    if "capability" not in supported_routes:
        raise WorkerError("mailroom worker contract must allow capability route_target for active operational execution")

    run_once = bool(args.once or not args.foreground)
    try:
        if args.foreground:
            while True:
                _process_once(worker_id=worker_id, claim_limit=claim_limit, allowlist=allowlist, supported_routes=supported_routes)
                time.sleep(max(poll_seconds, 1))
        if run_once:
            result = _process_once(worker_id=worker_id, claim_limit=claim_limit, allowlist=allowlist, supported_routes=supported_routes)
    except KeyboardInterrupt:
        return 130
    except WorkerError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"mailroom.task.worker FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"queued_seen: {result['queued_seen']}")
        print(f"claimed: {len(result['claimed'])}")
        print(f"completed: {len(result['completed'])}")
        print(f"failed: {len(result['failed'])}")
        print(f"skipped: {len(result['skipped'])}")
        for item in result["completed"]:
            detail = item.get("capability") or item.get("route_target") or item.get("provider") or "unknown"
            print(f"- completed {item['task_id']} route={detail} run_key={item.get('run_key', '')}")
        for item in result["failed"]:
            detail = item.get("capability") or item.get("route_target") or item.get("provider") or "unknown"
            print(f"- failed {item['task_id']} route={detail} error={item['error']}")
        for item in result["skipped"]:
            print(f"- skipped {item['task_id']} reason={item['reason']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
