#!/usr/bin/env python3
"""mailroom-task-worker

Governed autonomous worker lane:
- Runs `spine.control.cycle` on a bounded cadence.
- Consumes queued `mailroom.task.*` lifecycle tasks for supported route targets.
- Executes task actions only through governed capabilities (receipt-linked).
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[5]
RUNTIME_CONTRACT = ROOT / "ops/bindings/mailroom.runtime.contract.yaml"
WORKER_CONTRACT = Path(
    os.environ.get("MAILROOM_TASK_WORKER_CONTRACT", str(ROOT / "ops/bindings/mailroom.task.worker.contract.yaml"))
)
ROLE_RUNTIME_CONTRACT = ROOT / "ops/bindings/role.runtime.control.contract.yaml"

_SHUTDOWN = False
_CAP_APPROVALS: dict[str, str] | None = None


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_yaml(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    try:
        with path.open("r", encoding="utf-8") as fh:
            docs = list(yaml.safe_load_all(fh))
    except Exception:
        return default
    if not docs:
        return default
    if len(docs) == 1:
        data = docs[0]
    else:
        # Support front-matter + body contracts by merging mapping documents.
        merged: dict[str, Any] = {}
        for doc in docs:
            if isinstance(doc, dict):
                merged.update(doc)
        data = merged if merged else docs[-1]
    return default if data is None else data


def write_yaml(path: Path, payload: dict[str, Any]) -> None:
    path.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")


def resolve_runtime_paths() -> dict[str, Path]:
    contract = load_yaml(RUNTIME_CONTRACT, {})
    mailroom_root = str(contract.get("mailroom_root", "")).strip()
    state_root = str(contract.get("state_root", "")).strip()
    logs_root = str(contract.get("logs_root", "")).strip()

    inbox = os.environ.get("SPINE_INBOX")
    outbox = os.environ.get("SPINE_OUTBOX")
    state = os.environ.get("SPINE_STATE")
    logs = os.environ.get("SPINE_LOGS")

    if mailroom_root:
        inbox = inbox or f"{mailroom_root}/inbox"
        outbox = outbox or f"{mailroom_root}/outbox"
    if state_root:
        state = state or state_root
    if logs_root:
        logs = logs or logs_root

    inbox = inbox or str(ROOT / "mailroom/inbox")
    outbox = outbox or str(ROOT / "mailroom/outbox")
    state = state or str(ROOT / "mailroom/state")
    logs = logs or str(ROOT / "mailroom/logs")

    return {
        "inbox": Path(inbox),
        "outbox": Path(outbox),
        "state": Path(state),
        "logs": Path(logs),
    }


def resolve_path(base: Path, raw: str) -> Path:
    if not raw:
        return base
    p = Path(raw)
    if p.is_absolute():
        return p
    return base / p


def load_capability_approvals() -> dict[str, str]:
    global _CAP_APPROVALS
    if _CAP_APPROVALS is not None:
        return _CAP_APPROVALS
    caps = load_yaml(ROOT / "ops/capabilities.yaml", {}).get("capabilities", {})
    out: dict[str, str] = {}
    if isinstance(caps, dict):
        for name, body in caps.items():
            if not isinstance(body, dict):
                continue
            out[str(name)] = str(body.get("approval", "auto")).strip() or "auto"
    _CAP_APPROVALS = out
    return out


def is_delimiter(line: str) -> bool:
    s = (line or "").strip()
    if len(s) < 8:
        return False
    return all(ch in {"─", "-"} for ch in s)


def extract_cap_output(stdout: str) -> str:
    lines = stdout.splitlines()
    pre_ok_idx = -1
    for i, raw in enumerate(lines):
        if raw.strip() == "== PRECONDITIONS OK ==":
            pre_ok_idx = i

    executing_idx = -1
    for i, raw in enumerate(lines):
        if pre_ok_idx >= 0 and i <= pre_ok_idx:
            continue
        if raw.strip().lower() == "executing...":
            executing_idx = i
            break
    if executing_idx < 0:
        return stdout.strip()

    start_idx = -1
    for i in range(executing_idx + 1, len(lines)):
        if is_delimiter(lines[i]):
            start_idx = i + 1
            break
    if start_idx < 0:
        return stdout.strip()

    end_idx = len(lines)
    for i in range(start_idx, len(lines)):
        if is_delimiter(lines[i]):
            end_idx = i
            break
    return "\n".join(lines[start_idx:end_idx]).strip()


def parse_first_json(text: str) -> dict[str, Any] | None:
    if not text:
        return None
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", text):
        fragment = text[m.start() :]
        try:
            obj, _ = dec.raw_decode(fragment)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            return obj
    return None


def extract_run_key(text: str) -> str:
    for raw in (text or "").splitlines():
        s = raw.strip()
        if not s.startswith("Run Key:"):
            continue
        val = s.split("Run Key:", 1)[1].strip()
        if val:
            return val.split()[0]
    return ""


def extract_receipt_path(text: str) -> str:
    for raw in (text or "").splitlines():
        s = raw.strip()
        if not s.startswith("Receipt:"):
            continue
        val = s.split("Receipt:", 1)[1].strip()
        if val:
            return val.split()[0]
    return ""


def _ensure_text(value: Any) -> str:
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    if isinstance(value, bytearray):
        return bytes(value).decode("utf-8", errors="replace")
    return str(value or "")


def _run_captured_command(
    cmd: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    input_text: str | None = None,
    timeout: int = 900,
) -> dict[str, Any]:
    proc = subprocess.Popen(
        cmd,
        cwd=str(cwd or ROOT),
        env=env,
        stdin=subprocess.PIPE if input_text is not None else None,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    timed_out = False
    try:
        stdout, stderr = proc.communicate(input=input_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = proc.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = proc.communicate()
    return {
        "ok": proc.returncode == 0 and not timed_out,
        "exit_code": 124 if timed_out else proc.returncode,
        "stdout": _ensure_text(stdout),
        "stderr": _ensure_text(stderr),
        "command": cmd,
        "timed_out": timed_out,
    }


def run_ops_cap(capability: str, args: list[str], *, confirm: bool = False, timeout: int = 900) -> dict[str, Any]:
    cmd = [str(ROOT / "bin/ops"), "cap", "run", capability] + args
    stdin_text = "yes\n" if confirm else None
    result = _run_captured_command(cmd, cwd=ROOT, input_text=stdin_text, timeout=timeout)
    stdout = result["stdout"]
    stderr = result["stderr"]
    combined = f"{stdout}\n{stderr}".strip()
    out_block = extract_cap_output(stdout)
    payload = parse_first_json(out_block) if out_block else None
    return {
        "ok": result["ok"],
        "exit_code": result["exit_code"],
        "stdout": stdout,
        "stderr": stderr,
        "output": out_block,
        "payload": payload,
        "run_key": extract_run_key(combined),
        "receipt": extract_receipt_path(combined),
        "command": cmd,
        "timed_out": result["timed_out"],
    }


def run_command(
    cmd: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    timeout: int = 900,
) -> dict[str, Any]:
    return _run_captured_command(cmd, cwd=cwd, env=env, timeout=timeout)


def safe_reason(text: str, limit: int = 220) -> str:
    clean = re.sub(r"\s+", " ", (text or "").strip())
    if len(clean) <= limit:
        return clean
    return clean[: limit - 3] + "..."


def extract_blocker_reason(text: str) -> str:
    clean = re.sub(r"\s+", " ", (text or "").strip())
    if not clean:
        return ""
    patterns = (
        r"(main_branch_mutation_block:[^\s]+)",
        r"(role_policy_block:[^\s]+)",
        r"(route_not_matched:[^\s]+)",
        r"(unsupported_route_target:[^\s]+)",
        r"(agent_health_preflight_failed)",
        r"(strict agent health preflight failed)",
    )
    for pattern in patterns:
        match = re.search(pattern, clean)
        if match:
            return match.group(1)
    return ""


def parse_payload(raw: Any) -> dict[str, Any]:
    if isinstance(raw, dict):
        return raw
    if raw is None:
        return {}
    text = str(raw).strip()
    if not text:
        return {}
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError:
        return {}
    if isinstance(parsed, dict):
        return parsed
    return {}


def parse_scope_frontmatter(path: Path) -> dict[str, Any]:
    try:
        content = path.read_text(encoding="utf-8")
    except Exception:
        return {}
    if not content.startswith("---\n"):
        return {}
    end = content.find("\n---", 4)
    if end == -1:
        return {}
    raw = content[4:end]
    try:
        parsed = yaml.safe_load(raw) or {}
        if isinstance(parsed, dict):
            return parsed
    except Exception:
        pass

    # Fallback parser for loop scope frontmatter that is key:value per line but may
    # contain unquoted ":" in scalar values (common in existing objective fields).
    fallback: dict[str, str] = {}
    for line in raw.splitlines():
        text = line.strip()
        if not text or text.startswith("#") or ":" not in text:
            continue
        key, val = text.split(":", 1)
        key = key.strip()
        value = val.strip().strip('"').strip("'")
        if key:
            fallback[key] = value
    return fallback


def _first_non_empty(*values: Any) -> str:
    for value in values:
        text = str(value).strip() if value is not None else ""
        if text:
            return text
    return ""


def normalize_args(raw: Any) -> list[str]:
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(x) for x in raw]
    if isinstance(raw, str):
        return [raw] if raw.strip() else []
    return [str(raw)]


def pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


class TaskWorker:
    def __init__(self, *, worker_id: str | None = None, poll_override: int | None = None, max_claims_override: int | None = None) -> None:
        self.runtime_paths = resolve_runtime_paths()
        self.contract = load_yaml(WORKER_CONTRACT, {})
        self.role_runtime_contract = load_yaml(ROLE_RUNTIME_CONTRACT, {})
        self.runtime_cfg = self.contract.get("runtime", {}) if isinstance(self.contract, dict) else {}
        self.bootstrap_cfg = self.contract.get("bootstrap", {}) if isinstance(self.contract, dict) else {}
        self.cycle_cfg = self.contract.get("control_cycle", {}) if isinstance(self.contract, dict) else {}
        self.task_cfg = self.contract.get("task_execution", {}) if isinstance(self.contract, dict) else {}
        self.claim_cfg = self.task_cfg.get("claim_policy", {}) if isinstance(self.task_cfg, dict) else {}
        self.claim_failure_cfg = self.task_cfg.get("claim_failure_policy", {}) if isinstance(self.task_cfg, dict) else {}
        self.handoff_cfg = self.task_cfg.get("handoff_dispatch", {}) if isinstance(self.task_cfg, dict) else {}

        state_root = self.runtime_paths["state"]
        logs_root = self.runtime_paths["logs"]
        self.pid_file = resolve_path(state_root, str(self.runtime_cfg.get("pid_file", "mailroom-task-worker.pid")))
        self.log_file = resolve_path(logs_root, str(self.runtime_cfg.get("log_file", "mailroom-task-worker.log")))
        self.status_file = resolve_path(state_root, str(self.runtime_cfg.get("status_file", "mailroom-task-worker.status.json")))

        self.task_root = state_root / "agent-tasks"
        self.queued_dir = self.task_root / "queued"
        self.running_dir = self.task_root / "running"
        self.done_dir = self.task_root / "done"
        self.failed_dir = self.task_root / "failed"

        self.worker_id = worker_id or str(self.claim_cfg.get("worker_id", "spine-control-worker"))
        self.poll_seconds = int(poll_override if poll_override is not None else self.runtime_cfg.get("poll_seconds", 90))
        self.error_backoff_seconds = int(self.runtime_cfg.get("error_backoff_seconds", 20))
        self.max_claims_per_tick = int(max_claims_override if max_claims_override is not None else self.task_cfg.get("max_claims_per_tick", 3))
        self.claim_all = bool(self.claim_cfg.get("claim_all", True))
        self.claim_unassigned = bool(self.claim_cfg.get("claim_unassigned", True))
        self.allow_unhealthy_claims = bool(self.claim_cfg.get("allow_unhealthy_claims", False))
        self.claim_failure_quarantine_after = max(
            1,
            int(self.claim_failure_cfg.get("quarantine_after_failures", 5)),
        )
        self.execute_route_targets = {
            str(x).strip()
            for x in (self.task_cfg.get("execute_route_targets", []) if isinstance(self.task_cfg, dict) else [])
            if str(x).strip()
        } or {"capability"}
        self.capability_allowlist = {
            str(x).strip()
            for x in (self.task_cfg.get("capability_allowlist", []) if isinstance(self.task_cfg, dict) else [])
            if str(x).strip()
        }
        self.handoff_terminal_catalog = resolve_path(
            ROOT,
            str(self.handoff_cfg.get("terminal_catalog", "ops/bindings/terminal.worker.catalog.yaml")),
        )
        self.handoff_launch_role = str(self.handoff_cfg.get("launch_role", "solo")).strip() or "solo"
        self.handoff_default_tool = str(self.handoff_cfg.get("default_tool", "codex")).strip() or "codex"
        self.handoff_reconcile_capability = (
            str(self.handoff_cfg.get("reconcile_capability", "session.handoff.task_reconcile")).strip()
            or "session.handoff.task_reconcile"
        )
        self.handoff_launcher_command = self._normalize_command(
            self.handoff_cfg.get("launcher_command", [str(ROOT / "bin/ops"), "terminal", "launch"])
        )
        self.handoff_target_resolution_timeout_seconds = max(
            1,
            int(self.handoff_cfg.get("target_resolution_timeout_seconds", 120)),
        )
        self.handoff_launch_timeout_seconds = max(
            1,
            int(self.handoff_cfg.get("launch_timeout_seconds", 180)),
        )
        self.handoff_accept_timeout_seconds = max(
            1,
            int(self.handoff_cfg.get("accept_timeout_seconds", 45)),
        )
        self.handoff_accept_poll_interval_seconds = max(
            1,
            int(self.handoff_cfg.get("accept_poll_interval_seconds", 1)),
        )
        self.manual_caps_require_confirm = bool(self.task_cfg.get("manual_caps_require_confirm", True))
        auto_claim_cfg = (
            self.role_runtime_contract.get("horizon_auto_claim", {})
            if isinstance(self.role_runtime_contract, dict)
            else {}
        )
        self.horizon_enforce = bool(auto_claim_cfg.get("enforce_now_runnable_only", True))
        self.allowed_horizons = {
            str(x).strip() for x in auto_claim_cfg.get("allowed_horizon", ["now"]) if str(x).strip()
        } or {"now"}
        self.allowed_readiness = {
            str(x).strip() for x in auto_claim_cfg.get("allowed_readiness", ["runnable"]) if str(x).strip()
        } or {"runnable"}
        self.horizon_override_ref_field = str(auto_claim_cfg.get("override_ref_field", "horizon_override_ref"))
        self.horizon_override_reason_field = str(
            auto_claim_cfg.get("override_reason_field", "horizon_override_reason")
        )
        self.loop_scopes_dir = state_root / "loop-scopes"
        self.bootstrap_state = self._apply_bootstrap_env()
        self.last_blocker_reason = ""
        self.last_claim_failure_reason = ""
        self.last_claim_failure_task_id = ""

        self._ensure_dirs()

    def _bootstrap_entry(self, env_name: str, default: str, *, enabled: bool = True) -> dict[str, Any]:
        existing = str(os.environ.get(env_name, "")).strip()
        if existing:
            return {"env": env_name, "value": existing, "source": "env"}
        if enabled and default:
            os.environ[env_name] = default
            return {"env": env_name, "value": default, "source": "contract_default"}
        return {"env": env_name, "value": "", "source": "unset"}

    def _apply_bootstrap_env(self) -> dict[str, Any]:
        governed_main_override = bool(self.bootstrap_cfg.get("governed_main_override", True))
        terminal_role = str(self.bootstrap_cfg.get("terminal_role", "SPINE-CONTROL-01")).strip() or "SPINE-CONTROL-01"
        runtime_role = str(self.bootstrap_cfg.get("runtime_role", "worker")).strip() or "worker"

        data = {
            "governed_main_override": self._bootstrap_entry(
                "OPS_GOVERNED_MAIN_OVERRIDE",
                "1",
                enabled=governed_main_override,
            ),
            "terminal_role": self._bootstrap_entry("OPS_TERMINAL_ROLE", terminal_role),
            "terminal_name": self._bootstrap_entry("SPINE_TERMINAL_NAME", terminal_role),
            "runtime_role": self._bootstrap_entry("SPINE_RUNTIME_ROLE", runtime_role),
        }
        data["ready"] = all(
            str(entry.get("value", "")).strip()
            for entry in (
                data["governed_main_override"],
                data["terminal_role"],
                data["runtime_role"],
            )
        )
        return data

    def _ensure_dirs(self) -> None:
        self.pid_file.parent.mkdir(parents=True, exist_ok=True)
        self.log_file.parent.mkdir(parents=True, exist_ok=True)
        self.status_file.parent.mkdir(parents=True, exist_ok=True)
        self.queued_dir.mkdir(parents=True, exist_ok=True)
        self.running_dir.mkdir(parents=True, exist_ok=True)
        self.done_dir.mkdir(parents=True, exist_ok=True)
        self.failed_dir.mkdir(parents=True, exist_ok=True)

    def _normalize_command(self, raw: Any) -> list[str]:
        items: list[str]
        if isinstance(raw, list):
            items = [str(item).strip() for item in raw if str(item).strip()]
        elif isinstance(raw, str):
            items = [part for part in shlex.split(raw) if part]
        else:
            items = []

        if not items:
            items = [str(ROOT / "bin/ops"), "terminal", "launch"]

        first = items[0]
        if "/" in first and not Path(first).is_absolute():
            items[0] = str((ROOT / first).resolve())
        return items

    def log(self, msg: str) -> None:
        line = f"[{utc_now()}] {msg}"
        try:
            with self.log_file.open("a", encoding="utf-8") as fh:
                fh.write(line + "\n")
        except OSError:
            pass
        print(line, flush=True)

    def write_status(self, payload: dict[str, Any]) -> None:
        body = {
            "capability": "mailroom.task.worker.status",
            "schema_version": "1.0",
            "generated_at": utc_now(),
            "status": "ok",
            "data": payload,
        }
        self.status_file.write_text(json.dumps(body, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    def run_cycle_once(self) -> dict[str, Any]:
        if not bool(self.cycle_cfg.get("enabled", True)):
            return {"enabled": False, "status": "skipped"}

        args = [
            "--window-hours",
            str(int(self.cycle_cfg.get("window_hours", 24))),
            "--max-actions",
            str(int(self.cycle_cfg.get("max_actions", 3))),
            "--max-priority",
            str(self.cycle_cfg.get("max_priority", "P1")),
            "--json",
        ]
        if not bool(self.cycle_cfg.get("allow_agent_tools", True)):
            args.append("--no-agent-tools")
        if bool(self.cycle_cfg.get("allow_unhealthy_agents", False)):
            args.append("--allow-unhealthy-agents")
        if bool(self.cycle_cfg.get("confirm_manual", False)):
            args.append("--confirm-manual")

        cycle_timeout = int(self.cycle_cfg.get("timeout_seconds", 120))
        if cycle_timeout < 15:
            cycle_timeout = 15
        result = run_ops_cap("spine.control.cycle", args, confirm=True, timeout=cycle_timeout)
        blocker_reason = extract_blocker_reason(result.get("stderr") or "") or extract_blocker_reason(result.get("output") or "")
        cycle_status = "ok" if result["ok"] else ("blocked" if blocker_reason else "failed")
        if result["ok"]:
            self.last_blocker_reason = ""
            self.log(
                "cycle: ok"
                + (f" run_key={result['run_key']}" if result.get("run_key") else "")
                + (f" receipt={result['receipt']}" if result.get("receipt") else "")
            )
        else:
            self.last_blocker_reason = blocker_reason or safe_reason(result.get("stderr") or result.get("output") or "")
            self.log(f"cycle: failed rc={result['exit_code']} reason={safe_reason(result.get('stderr') or result.get('output') or '')}")

        return {
            "enabled": True,
            "status": cycle_status,
            "run_key": result.get("run_key", ""),
            "receipt": result.get("receipt", ""),
            "exit_code": result.get("exit_code", 1),
            "blocker_reason": blocker_reason or None,
        }

    def _record_claim_failure(self, task_id: str, path: Path, raw_reason: str) -> dict[str, Any]:
        task = load_yaml(path, {})
        if not isinstance(task, dict):
            task = {"task_id": task_id}
        now = utc_now()
        reason = extract_blocker_reason(raw_reason) or safe_reason(raw_reason)
        signature = hashlib.sha1(reason.encode("utf-8")).hexdigest()[:12]
        previous_signature = str(task.get("claim_failure_signature", "")).strip()
        previous_count = int(task.get("claim_failure_count", 0) or 0)
        failure_count = previous_count + 1 if previous_signature == signature else 1

        task["status"] = "queued"
        task["claim_failure_count"] = failure_count
        task["claim_failure_signature"] = signature
        task["last_claim_failure_reason"] = reason
        task["last_claim_failure_at"] = now
        task["updated_at"] = now

        self.last_claim_failure_reason = reason
        self.last_claim_failure_task_id = task_id
        blocker_reason = extract_blocker_reason(reason)
        if blocker_reason:
            self.last_blocker_reason = blocker_reason

        if failure_count >= self.claim_failure_quarantine_after:
            failed_path = self.failed_dir / path.name
            task["status"] = "failed"
            task["failure_reason"] = f"claim_quarantine:{reason}"
            task["failed_at"] = now
            if failed_path.exists():
                failed_path.unlink()
            path.replace(failed_path)
            write_yaml(failed_path, task)
            return {
                "reason": reason,
                "count": failure_count,
                "quarantined": True,
                "file": str(failed_path),
            }

        write_yaml(path, task)
        return {
            "reason": reason,
            "count": failure_count,
            "quarantined": False,
            "file": str(path),
        }

    def _task_required_agents(self, task: dict[str, Any]) -> list[str]:
        raw = task.get("required_agents", [])
        if isinstance(raw, list):
            return [str(x).strip() for x in raw if str(x).strip()]
        return []

    def _resolve_scope_file(self, loop_id: str) -> Path | None:
        if not loop_id:
            return None
        direct = self.loop_scopes_dir / f"{loop_id}.scope.md"
        if direct.is_file():
            return direct
        matches = sorted(self.loop_scopes_dir.glob(f"{loop_id}*.scope.md"))
        for candidate in matches:
            if candidate.is_file():
                return candidate
        return None

    def _horizon_context(self, task: dict[str, Any]) -> dict[str, str]:
        payload = parse_payload(task.get("payload"))
        route_payload = payload.get("route_target") if isinstance(payload.get("route_target"), dict) else {}
        route_resolution = payload.get("route_resolution") if isinstance(payload.get("route_resolution"), dict) else {}
        resolution_data = route_resolution.get("data") if isinstance(route_resolution.get("data"), dict) else {}

        loop_id = _first_non_empty(
            task.get("loop_id"),
            payload.get("loop_id"),
            route_payload.get("loop_id"),
            resolution_data.get("loop_id"),
        )
        horizon = _first_non_empty(
            task.get("horizon"),
            payload.get("horizon"),
            route_payload.get("horizon"),
            resolution_data.get("horizon"),
        )
        readiness = _first_non_empty(
            task.get("execution_readiness"),
            payload.get("execution_readiness"),
            route_payload.get("execution_readiness"),
            resolution_data.get("execution_readiness"),
        )
        override_ref = _first_non_empty(
            task.get(self.horizon_override_ref_field),
            payload.get(self.horizon_override_ref_field),
            route_payload.get(self.horizon_override_ref_field),
            os.environ.get("SPINE_HORIZON_OVERRIDE_REF"),
        )
        override_reason = _first_non_empty(
            task.get(self.horizon_override_reason_field),
            payload.get(self.horizon_override_reason_field),
            route_payload.get(self.horizon_override_reason_field),
            os.environ.get("SPINE_HORIZON_OVERRIDE_REASON"),
        )

        source = "task"
        if loop_id and (not horizon or not readiness):
            scope_path = self._resolve_scope_file(loop_id)
            if scope_path is not None:
                meta = parse_scope_frontmatter(scope_path)
                horizon = horizon or _first_non_empty(meta.get("horizon"))
                readiness = readiness or _first_non_empty(meta.get("execution_readiness"))
                source = f"scope:{scope_path.name}"

        return {
            "loop_id": loop_id,
            "horizon": horizon,
            "execution_readiness": readiness,
            "override_ref": override_ref,
            "override_reason": override_reason,
            "source": source,
        }

    def _eligible_for_claim(self, task: dict[str, Any]) -> tuple[bool, str]:
        route_target = str(task.get("route_target", "")).strip() or "capability"
        if route_target not in self.execute_route_targets:
            return False, f"unsupported route_target={route_target}"

        if self.horizon_enforce:
            horizon_ctx = self._horizon_context(task)
            horizon = horizon_ctx.get("horizon", "")
            readiness = horizon_ctx.get("execution_readiness", "")
            override_ref = horizon_ctx.get("override_ref", "")
            override_reason = horizon_ctx.get("override_reason", "")
            loop_id = horizon_ctx.get("loop_id", "")
            has_horizon_context = bool(loop_id or horizon or readiness)
            horizon_ok = horizon in self.allowed_horizons
            readiness_ok = readiness in self.allowed_readiness
            if has_horizon_context and not (horizon_ok and readiness_ok):
                if not override_ref:
                    return (
                        False,
                        "horizon_block:"
                        f"horizon={horizon or 'missing'} readiness={readiness or 'missing'} "
                        f"allowed_horizon={','.join(sorted(self.allowed_horizons))} "
                        f"allowed_readiness={','.join(sorted(self.allowed_readiness))} "
                        f"override_ref_field={self.horizon_override_ref_field}",
                    )
                if not override_reason:
                    return (
                        False,
                        "horizon_override_reason_missing:"
                        f"override_ref={override_ref} "
                        f"override_reason_field={self.horizon_override_reason_field}",
                    )

        required_agents = self._task_required_agents(task)
        if self.claim_all:
            return True, "claim_all=true"
        if required_agents:
            if self.worker_id in required_agents:
                return True, "required_agent_match"
            return False, f"required_agents={','.join(required_agents)} missing worker_id={self.worker_id}"
        if self.claim_unassigned:
            return True, "unassigned_allowed"
        return False, "task unassigned and claim_unassigned=false"

    def _extract_capability_request(self, task: dict[str, Any]) -> tuple[str, list[str], bool]:
        payload = parse_payload(task.get("payload"))
        route_payload = payload.get("route_target") if isinstance(payload.get("route_target"), dict) else {}

        cap = str(payload.get("capability", "")).strip() or str(route_payload.get("capability", "")).strip()
        args = normalize_args(payload.get("args", route_payload.get("args")))
        confirm = bool(payload.get("confirm", False))
        return cap, args, confirm

    def _extract_agent_tool_request(self, task: dict[str, Any]) -> tuple[str, str, dict[str, Any]]:
        payload = parse_payload(task.get("payload"))
        route_payload = payload.get("route_target") if isinstance(payload.get("route_target"), dict) else {}
        route_resolution = payload.get("route_resolution") if isinstance(payload.get("route_resolution"), dict) else {}

        tool = str(payload.get("tool", "")).strip() or str(route_payload.get("tool", "")).strip()
        route_input = str(payload.get("input", "")).strip() or str(route_payload.get("input", "")).strip()
        if not route_input:
            route_input = str(route_resolution.get("data", {}).get("input", "")).strip()
        return tool, route_input, route_resolution

    def _extract_handoff_request(self, task: dict[str, Any]) -> dict[str, str]:
        payload = parse_payload(task.get("payload"))
        dispatch = payload.get("dispatch") if isinstance(payload.get("dispatch"), dict) else {}
        payload_required_agents = payload.get("required_agents") if isinstance(payload.get("required_agents"), list) else []
        task_required_agents = self._task_required_agents(task)
        target_agent_id = _first_non_empty(
            dispatch.get("target_agent_id"),
            payload.get("target_agent_id"),
            payload_required_agents[0] if payload_required_agents else "",
            task_required_agents[0] if task_required_agents else "",
        )
        return {
            "handoff_id": str(payload.get("handoff_id", "")).strip(),
            "handoff_file": str(payload.get("handoff_file", "")).strip(),
            "target_agent_id": target_agent_id,
            "target_terminal_id": _first_non_empty(dispatch.get("target_terminal_id"), payload.get("target_terminal_id")),
            "target_tool": _first_non_empty(dispatch.get("target_tool"), payload.get("target_tool")),
        }

    def _canonicalize_agent_id(self, raw_agent_id: str, active_workers: dict[str, dict[str, Any]]) -> str:
        candidate = str(raw_agent_id).strip()
        if not candidate:
            return ""

        exact_matches = {str(body.get("agent_id", "")).strip() for body in active_workers.values() if isinstance(body, dict)}
        if candidate in exact_matches:
            return candidate

        lower_matches = {
            str(body.get("agent_id", "")).strip().lower(): str(body.get("agent_id", "")).strip()
            for body in active_workers.values()
            if isinstance(body, dict) and str(body.get("agent_id", "")).strip()
        }
        if candidate.lower() in lower_matches:
            return lower_matches[candidate.lower()]

        route_script = ROOT / "ops/plugins/core/agent/bin/agent-route"
        if not route_script.exists():
            return ""

        result = run_command(
            [str(route_script), "--json", candidate],
            cwd=ROOT,
            timeout=self.handoff_target_resolution_timeout_seconds,
        )
        if not result["ok"]:
            return ""
        payload = parse_first_json(result.get("stdout", ""))
        if not isinstance(payload, dict) or str(payload.get("status", "")).strip() != "matched":
            return ""
        return str(payload.get("data", {}).get("agent", {}).get("id", "")).strip()

    def _resolve_handoff_target(self, request: dict[str, str]) -> tuple[bool, dict[str, str]]:
        catalog = load_yaml(self.handoff_terminal_catalog, {})
        workers = catalog.get("workers", {}) if isinstance(catalog, dict) else {}
        active_workers = {
            terminal_id: body
            for terminal_id, body in workers.items()
            if isinstance(body, dict) and str(body.get("status", "")).strip() == "active"
        }

        target_terminal_id = request.get("target_terminal_id", "").strip()
        target_agent_hint = request.get("target_agent_id", "").strip()

        if target_terminal_id:
            terminal = active_workers.get(target_terminal_id)
            if not isinstance(terminal, dict):
                return False, {"reason": f"handoff_target_terminal_not_found:{target_terminal_id}"}
            target_agent_id = str(terminal.get("agent_id", "")).strip()
            canonical_hint = self._canonicalize_agent_id(target_agent_hint, active_workers) if target_agent_hint else ""
            if canonical_hint and target_agent_id and canonical_hint != target_agent_id:
                return False, {
                    "reason": (
                        f"handoff_target_mismatch:terminal={target_terminal_id} "
                        f"agent_id={target_agent_id} expected={canonical_hint}"
                    )
                }
        else:
            canonical_agent_id = self._canonicalize_agent_id(target_agent_hint, active_workers)
            if not canonical_agent_id:
                return False, {"reason": f"handoff_target_agent_not_resolved:{target_agent_hint or 'missing'}"}
            matches = [
                (terminal_id, body)
                for terminal_id, body in active_workers.items()
                if str(body.get("agent_id", "")).strip() == canonical_agent_id
            ]
            if not matches:
                return False, {"reason": f"handoff_target_terminal_not_found_for_agent:{canonical_agent_id}"}
            if len(matches) > 1:
                terminals = ",".join(sorted(terminal_id for terminal_id, _body in matches))
                return False, {"reason": f"handoff_target_terminal_ambiguous:{canonical_agent_id}:{terminals}"}
            target_terminal_id, terminal = matches[0]
            target_agent_id = canonical_agent_id

        target_tool = request.get("target_tool", "").strip() or str(terminal.get("default_tool", "")).strip() or self.handoff_default_tool
        allowed_tools = [
            str(item).strip()
            for item in (terminal.get("allowed_tools", []) if isinstance(terminal.get("allowed_tools"), list) else [])
            if str(item).strip()
        ]
        if allowed_tools and target_tool not in allowed_tools:
            return False, {
                "reason": (
                    f"handoff_target_tool_not_allowed:terminal={target_terminal_id} "
                    f"tool={target_tool} allowed={','.join(allowed_tools)}"
                )
            }

        return True, {
            "agent_id": target_agent_id,
            "terminal_id": target_terminal_id,
            "tool": target_tool,
        }

    def _handoff_file_path(self, request: dict[str, str]) -> Path | None:
        raw = request.get("handoff_file", "").strip()
        if not raw:
            return None
        path = Path(raw)
        if not path.is_absolute():
            path = ROOT / path
        return path

    def _load_handoff(self, request: dict[str, str]) -> tuple[Path | None, dict[str, Any] | None]:
        handoff_file = self._handoff_file_path(request)
        if handoff_file is None or not handoff_file.exists():
            return handoff_file, None
        handoff = load_yaml(handoff_file, {})
        if not isinstance(handoff, dict):
            return handoff_file, None
        return handoff_file, handoff

    def _update_handoff_dispatch(self, request: dict[str, str], *, status: str, detail: str, target: dict[str, str]) -> None:
        handoff_file, handoff = self._load_handoff(request)
        if handoff_file is None or handoff is None:
            return

        dispatch = handoff.get("dispatch")
        if not isinstance(dispatch, dict):
            dispatch = {}

        now = utc_now()
        prior_status = str(dispatch.get("status", "")).strip()
        dispatch["worker_id"] = self.worker_id
        dispatch["last_attempt_at_utc"] = now
        if target.get("agent_id"):
            dispatch["target_agent_id"] = target["agent_id"]
        if target.get("terminal_id"):
            dispatch["target_terminal_id"] = target["terminal_id"]
        if target.get("tool"):
            dispatch["target_tool"] = target["tool"]
        if status == "launched":
            if prior_status == "accepted":
                dispatch["status"] = "accepted"
            else:
                dispatch["status"] = "launched"
            dispatch.setdefault("dispatched_at_utc", now)
            dispatch.pop("failed_at_utc", None)
            dispatch.pop("last_error", None)
        elif status == "accepted":
            dispatch["status"] = "accepted"
            dispatch["accepted_at_utc"] = now
            dispatch.setdefault("dispatched_at_utc", now)
            dispatch.pop("failed_at_utc", None)
            dispatch.pop("last_error", None)
        else:
            dispatch["status"] = status
            dispatch["failed_at_utc"] = now
            dispatch["last_error"] = safe_reason(detail, limit=400)

        handoff["dispatch"] = dispatch
        write_yaml(handoff_file, handoff)

    def _reconcile_handoff(self, handoff_id: str) -> tuple[bool, str]:
        if not handoff_id:
            return False, "missing_handoff_id"
        run = run_ops_cap(self.handoff_reconcile_capability, ["--id", handoff_id, "--json"], confirm=False, timeout=180)
        if run["ok"]:
            return True, ""
        detail = run.get("stderr") or run.get("output") or f"handoff_reconcile_failed rc={run.get('exit_code', 1)}"
        return False, safe_reason(detail, limit=400)

    def _heartbeat(self, task_id: str, progress: str) -> None:
        run_ops_cap("mailroom.task.heartbeat", ["--task-id", task_id, "--progress", progress, "--json"], confirm=False, timeout=180)

    def _complete(self, task_id: str, result_text: str) -> None:
        run_ops_cap("mailroom.task.complete", ["--task-id", task_id, "--result", safe_reason(result_text), "--json"], confirm=False, timeout=180)

    def _fail(self, task_id: str, reason: str) -> None:
        run_ops_cap("mailroom.task.fail", ["--task-id", task_id, "--reason", safe_reason(reason), "--json"], confirm=False, timeout=180)

    def _wait_for_handoff_accept(
        self,
        task_id: str,
        request: dict[str, str],
        target: dict[str, str],
    ) -> tuple[bool, str]:
        handoff_id = request.get("handoff_id", "").strip()
        deadline = time.monotonic() + max(1, self.handoff_accept_timeout_seconds)
        last_status = "missing"
        last_error = ""
        heartbeat_deadline = 0.0
        target_terminal_id = target.get("terminal_id", "").strip()
        while time.monotonic() <= deadline:
            _handoff_path, handoff = self._load_handoff(request)
            if handoff is None:
                last_status = "handoff_file_missing"
            else:
                handoff_state = str(handoff.get("state", "")).strip()
                dispatch = handoff.get("dispatch") if isinstance(handoff.get("dispatch"), dict) else {}
                status = str(dispatch.get("status", "")).strip()
                if status:
                    last_status = status
                last_error = safe_reason(str(dispatch.get("last_error", "")).strip(), limit=400)
                if status == "accepted":
                    accepted_terminal_id = str(dispatch.get("accepted_by_terminal_id", "")).strip()
                    if accepted_terminal_id and target_terminal_id and accepted_terminal_id != target_terminal_id:
                        return (
                            False,
                            (
                                "handoff_accept_terminal_mismatch:"
                                f"expected={target_terminal_id} actual={accepted_terminal_id}"
                            ),
                        )
                    parts = [
                        f"handoff_id={handoff_id}",
                        f"target_agent_id={target['agent_id']}",
                        f"target_terminal_id={target_terminal_id}",
                        f"tool={target['tool']}",
                        f"accepted_status={status}",
                    ]
                    accepted_session_id = str(dispatch.get("accepted_by_session_id", "")).strip()
                    accepted_at = str(dispatch.get("accepted_at_utc", "")).strip()
                    if accepted_session_id:
                        parts.append(f"accepted_by_session_id={accepted_session_id}")
                    if accepted_at:
                        parts.append(f"accepted_at_utc={accepted_at}")
                    return True, " ".join(parts)
                if status == "failed":
                    detail = last_error or "handoff_dispatch_failed"
                    return False, f"handoff_dispatch_failed:{detail}"
                if handoff_state in {"closed", "expired"}:
                    return False, f"handoff_not_accepted_before_{handoff_state}"
            now_monotonic = time.monotonic()
            if now_monotonic >= deadline:
                break
            if now_monotonic >= heartbeat_deadline:
                self._heartbeat(task_id, f"waiting for handoff_accept handoff={handoff_id} terminal={target_terminal_id}")
                heartbeat_deadline = now_monotonic + 5.0
            time.sleep(self.handoff_accept_poll_interval_seconds)
        detail = f"handoff_accept_timeout:status={last_status}"
        if last_error:
            detail += f" error={last_error}"
        detail += f" waited={self.handoff_accept_timeout_seconds}s"
        return False, detail

    def _execute_capability_task(self, task_id: str, task: dict[str, Any]) -> tuple[bool, str]:
        capability, cap_args, payload_confirm = self._extract_capability_request(task)
        if not capability:
            return False, "task payload missing capability"

        if self.capability_allowlist and capability not in self.capability_allowlist:
            return False, f"capability_not_allowlisted:{capability}"

        approvals = load_capability_approvals()
        approval = approvals.get(capability, "auto")
        if approval == "manual" and self.manual_caps_require_confirm and not payload_confirm:
            return False, f"manual_confirmation_required:{capability}"

        self._heartbeat(task_id, f"executing capability={capability}")
        run = run_ops_cap(capability, cap_args, confirm=(approval == "manual" and payload_confirm), timeout=1200)
        if not run["ok"]:
            detail = run.get("stderr") or run.get("output") or f"capability failed rc={run.get('exit_code', 1)}"
            return False, detail

        run_key = run.get("run_key", "")
        receipt = run.get("receipt", "")
        parts = [f"capability={capability}"]
        if run_key:
            parts.append(f"run_key={run_key}")
        if receipt:
            parts.append(f"receipt={receipt}")
        return True, " ".join(parts)

    def _execute_agent_tool_task(self, task_id: str, task: dict[str, Any]) -> tuple[bool, str]:
        tool, route_input, route_resolution = self._extract_agent_tool_request(task)
        if not tool:
            return False, "task payload missing agent_tool"
        if tool != "route_resolve":
            return False, f"unsupported_agent_tool:{tool}"
        if not route_input:
            return False, "route_resolve_input_required"

        self._heartbeat(task_id, f"executing agent_tool={tool} input={route_input}")
        run = run_ops_cap("agent.route", ["--json", route_input], confirm=False, timeout=600)
        if not run["ok"]:
            detail = run.get("stderr") or run.get("output") or f"agent_tool failed rc={run.get('exit_code', 1)}"
            return False, detail

        payload = run.get("payload")
        if not isinstance(payload, dict):
            return False, "agent.route returned non-json payload"
        if str(payload.get("status", "")).strip() != "matched":
            return False, f"route_not_matched:{route_input}"

        matched_agent = str(payload.get("data", {}).get("agent", {}).get("id", "")).strip()
        expected_agent = str(route_resolution.get("data", {}).get("agent", {}).get("id", "")).strip()
        if expected_agent and matched_agent and expected_agent != matched_agent:
            return False, f"route_resolution_mismatch:expected={expected_agent} actual={matched_agent}"

        run_key = run.get("run_key", "")
        receipt = run.get("receipt", "")
        parts = [f"agent_tool={tool}", f"input={route_input}"]
        if matched_agent:
            parts.append(f"agent_id={matched_agent}")
        if run_key:
            parts.append(f"run_key={run_key}")
        if receipt:
            parts.append(f"receipt={receipt}")
        return True, " ".join(parts)

    def _execute_handoff_task(self, task_id: str, task: dict[str, Any]) -> tuple[bool, str]:
        request = self._extract_handoff_request(task)
        handoff_id = request.get("handoff_id", "")
        if not handoff_id:
            return False, "handoff_id_missing"

        ok_target, target = self._resolve_handoff_target(request)
        if not ok_target:
            reason = target.get("reason", "handoff_target_resolution_failed")
            self._update_handoff_dispatch(request, status="failed", detail=reason, target={})
            return False, reason

        self._heartbeat(
            task_id,
            f"dispatching handoff={handoff_id} terminal={target['terminal_id']} agent={target['agent_id']}",
        )
        env = os.environ.copy()
        env.update(
            {
                "SPINE_DISPATCH_HANDOFF_ID": handoff_id,
                "SPINE_DISPATCH_HANDOFF_FILE": request.get("handoff_file", ""),
                "SPINE_DISPATCH_TARGET_AGENT_ID": target["agent_id"],
                "SPINE_DISPATCH_TARGET_TERMINAL_ID": target["terminal_id"],
                "SPINE_DISPATCH_TARGET_TOOL": target["tool"],
                "SPINE_DISPATCH_WORKER_ID": self.worker_id,
            }
        )
        cmd = self.handoff_launcher_command + [
            "--role",
            self.handoff_launch_role,
            "--tool",
            target["tool"],
            "--terminal",
            target["terminal_id"],
            "--handoff-id",
            handoff_id,
            "--handoff-file",
            request.get("handoff_file", ""),
        ]
        launch = run_command(cmd, cwd=ROOT, env=env, timeout=self.handoff_launch_timeout_seconds)
        if not launch["ok"]:
            if launch.get("timed_out"):
                detail = f"handoff_launch_timeout:{self.handoff_launch_timeout_seconds}s"
            else:
                detail = safe_reason(
                    launch.get("stderr") or launch.get("stdout") or "handoff_launch_failed",
                    limit=400,
                )
            self._update_handoff_dispatch(request, status="failed", detail=detail, target=target)
            return False, f"handoff_launch_failed:{detail}"

        self._update_handoff_dispatch(request, status="launched", detail=launch.get("stdout", ""), target=target)
        accepted, detail = self._wait_for_handoff_accept(task_id, request, target)
        if not accepted:
            self._update_handoff_dispatch(request, status="failed", detail=detail, target=target)
            return False, detail
        return True, detail

    def consume_tasks_once(self) -> dict[str, Any]:
        if not bool(self.task_cfg.get("enabled", True)):
            return {"enabled": False, "claimed": 0, "completed": 0, "failed": 0, "skipped": 0}

        files = sorted(
            [p for p in self.queued_dir.glob("*.yaml") if p.is_file()],
            key=lambda p: p.stat().st_mtime,
        )

        claimed = 0
        completed = 0
        failed = 0
        skipped = 0
        quarantined = 0

        for path in files:
            if claimed >= max(1, self.max_claims_per_tick):
                break
            task = load_yaml(path, {})
            if not isinstance(task, dict):
                skipped += 1
                continue

            task_id = str(task.get("task_id", "")).strip() or path.stem
            ok, reason = self._eligible_for_claim(task)
            if not ok:
                skipped += 1
                continue

            claim_args = ["--task-id", task_id, "--worker", self.worker_id, "--json"]
            if self.allow_unhealthy_claims:
                claim_args.append("--allow-unhealthy")
            claim = run_ops_cap("mailroom.task.claim", claim_args, confirm=False, timeout=240)
            if not claim["ok"]:
                failed += 1
                claim_state = self._record_claim_failure(task_id, path, claim.get("stderr") or claim.get("output") or "")
                if claim_state["quarantined"]:
                    quarantined += 1
                    self.log(
                        f"task {task_id}: claim quarantined after {claim_state['count']} repeated failures "
                        f"reason={safe_reason(claim_state['reason'])}"
                    )
                else:
                    self.log(
                        f"task {task_id}: claim failed count={claim_state['count']} "
                        f"reason={safe_reason(claim_state['reason'])}"
                    )
                continue

            claimed += 1
            self._heartbeat(task_id, f"claimed by {self.worker_id}")
            route_target = str(task.get("route_target", "")).strip() or "capability"

            try:
                if route_target == "capability":
                    ok_exec, detail = self._execute_capability_task(task_id, task)
                elif route_target == "agent_tool":
                    ok_exec, detail = self._execute_agent_tool_task(task_id, task)
                elif route_target == "handoff":
                    ok_exec, detail = self._execute_handoff_task(task_id, task)
                else:
                    self._fail(task_id, f"unsupported_route_target:{route_target}")
                    failed += 1
                    self.log(f"task {task_id}: failed unsupported route_target={route_target}")
                    continue
            except Exception as exc:
                detail = f"task_execution_exception:{safe_reason(str(exc), limit=400)}"
                if route_target == "handoff":
                    request = self._extract_handoff_request(task)
                    self._update_handoff_dispatch(request, status="failed", detail=detail, target={})
                ok_exec = False

            if ok_exec:
                self._complete(task_id, detail)
                if route_target == "handoff":
                    handoff_id = self._extract_handoff_request(task).get("handoff_id", "")
                    reconciled, reconcile_detail = self._reconcile_handoff(handoff_id)
                    if not reconciled:
                        self.log(
                            f"task {task_id}: handoff reconcile warning "
                            f"handoff_id={handoff_id or 'missing'} reason={safe_reason(reconcile_detail)}"
                        )
                completed += 1
                self.log(f"task {task_id}: completed {detail}")
            else:
                self._fail(task_id, detail)
                if route_target == "handoff":
                    handoff_id = self._extract_handoff_request(task).get("handoff_id", "")
                    reconciled, reconcile_detail = self._reconcile_handoff(handoff_id)
                    if not reconciled:
                        self.log(
                            f"task {task_id}: handoff reconcile warning "
                            f"handoff_id={handoff_id or 'missing'} reason={safe_reason(reconcile_detail)}"
                        )
                failed += 1
                self.log(f"task {task_id}: failed {safe_reason(detail)}")

        return {
            "enabled": True,
            "claimed": claimed,
            "completed": completed,
            "failed": failed,
            "skipped": skipped,
            "quarantined": quarantined,
            "claim_failure_quarantine_after": self.claim_failure_quarantine_after,
            "last_claim_failure_reason": self.last_claim_failure_reason or None,
            "last_claim_failure_task_id": self.last_claim_failure_task_id or None,
            "max_claims_per_tick": self.max_claims_per_tick,
        }

    def run_once(self) -> dict[str, Any]:
        # Keep task-lifecycle responsiveness even when control-cycle calls are slow.
        try:
            tasks = self.consume_tasks_once()
        except Exception as exc:
            detail = safe_reason(str(exc), limit=400)
            self.log(f"tasks: failed {detail}")
            tasks = {
                "enabled": bool(self.task_cfg.get("enabled", True)),
                "status": "failed",
                "error": detail,
                "claimed": 0,
                "completed": 0,
                "failed": 1,
                "skipped": 0,
                "quarantined": 0,
                "claim_failure_quarantine_after": self.claim_failure_quarantine_after,
                "last_claim_failure_reason": self.last_claim_failure_reason or None,
                "last_claim_failure_task_id": self.last_claim_failure_task_id or None,
                "max_claims_per_tick": self.max_claims_per_tick,
            }
        try:
            cycle = self.run_cycle_once()
        except Exception as exc:
            cycle = {
                "enabled": bool(self.cycle_cfg.get("enabled", True)),
                "status": "failed",
                "run_key": "",
                "receipt": "",
                "exit_code": 124,
                "error": safe_reason(str(exc), limit=400),
            }
            self.log(f"cycle: exception reason={safe_reason(str(exc), limit=400)}")
        payload = {
            "worker_id": self.worker_id,
            "poll_seconds": self.poll_seconds,
            "bootstrap": self.bootstrap_state,
            "cycle": cycle,
            "tasks": tasks,
            "paths": {
                "queued": str(self.queued_dir),
                "running": str(self.running_dir),
                "done": str(self.done_dir),
                "failed": str(self.failed_dir),
                "pid_file": str(self.pid_file),
                "log_file": str(self.log_file),
                "status_file": str(self.status_file),
            },
            "last_blocker_reason": self.last_blocker_reason or None,
        }
        self.write_status(payload)
        return payload

    def run_forever(self) -> int:
        self._ensure_dirs()
        if self.pid_file.exists():
            try:
                prior = int(self.pid_file.read_text(encoding="utf-8").strip())
            except Exception:
                prior = 0
            if prior > 0 and pid_running(prior):
                self.log(f"worker already running pid={prior}")
                return 1

        self.pid_file.write_text(f"{os.getpid()}\n", encoding="utf-8")
        self.log("worker start")
        try:
            while not _SHUTDOWN:
                try:
                    self.run_once()
                except Exception as exc:
                    self.log(f"tick failed: {safe_reason(str(exc), limit=400)}")
                    time.sleep(max(1, self.error_backoff_seconds))
                    continue

                slept = 0
                while slept < max(1, self.poll_seconds):
                    if _SHUTDOWN:
                        break
                    time.sleep(1)
                    slept += 1
        finally:
            try:
                if self.pid_file.exists():
                    self.pid_file.unlink()
            except OSError:
                pass
            self.log("worker stop")
        return 0

    def status(self) -> int:
        pid = 0
        if self.pid_file.exists():
            try:
                pid = int(self.pid_file.read_text(encoding="utf-8").strip())
            except Exception:
                pid = 0
        running = pid > 0 and pid_running(pid)

        print("mailroom.task.worker")
        print(f"  contract: {WORKER_CONTRACT}")
        print(f"  runtime_contract: {RUNTIME_CONTRACT}")
        print(f"  worker_id: {self.worker_id}")
        print(f"  status: {'running' if running else 'stopped'}")
        print(f"  pid: {pid if pid > 0 else '-'}")
        print(f"  pid_file: {self.pid_file}")
        print(f"  log_file: {self.log_file}")
        print(f"  status_file: {self.status_file}")
        print(f"  queued_dir: {self.queued_dir}")
        bootstrap = self.bootstrap_state
        if self.status_file.exists():
            try:
                status_payload = json.loads(self.status_file.read_text(encoding="utf-8"))
                generated_at = status_payload.get("generated_at", "")
                data = status_payload.get("data", {})
                bootstrap = data.get("bootstrap", {}) or bootstrap
                tasks = data.get("tasks", {})
                cycle = data.get("cycle", {})
                print(f"  last_tick: {generated_at}")
                print(f"  last_cycle_status: {cycle.get('status', '-')}")
                if cycle.get("blocker_reason"):
                    print(f"  last_cycle_blocker_reason: {cycle.get('blocker_reason')}")
                print(
                    "  last_tasks: "
                    f"claimed={tasks.get('claimed', 0)} "
                    f"completed={tasks.get('completed', 0)} "
                    f"failed={tasks.get('failed', 0)} "
                    f"skipped={tasks.get('skipped', 0)} "
                    f"quarantined={tasks.get('quarantined', 0)}"
                )
                if tasks.get("last_claim_failure_reason"):
                    print(
                        "  last_claim_failure: "
                        f"{tasks.get('last_claim_failure_task_id', '-')} "
                        f"{tasks.get('last_claim_failure_reason')}"
                    )
            except Exception:
                print("  last_tick: unreadable")
        print(
            "  bootstrap: "
            f"override={bootstrap.get('governed_main_override', {}).get('value', '-')}"
            f"[{bootstrap.get('governed_main_override', {}).get('source', '-')}] "
            f"terminal={bootstrap.get('terminal_role', {}).get('value', '-')}"
            f"[{bootstrap.get('terminal_role', {}).get('source', '-')}] "
            f"runtime={bootstrap.get('runtime_role', {}).get('value', '-')}"
            f"[{bootstrap.get('runtime_role', {}).get('source', '-')}]"
        )
        return 0

    def stop(self) -> int:
        if not self.pid_file.exists():
            print("mailroom.task.worker: not running")
            return 0
        try:
            pid = int(self.pid_file.read_text(encoding="utf-8").strip())
        except Exception:
            pid = 0
        if pid <= 0 or not pid_running(pid):
            try:
                self.pid_file.unlink()
            except OSError:
                pass
            print("mailroom.task.worker: not running (stale pid file removed)")
            return 0

        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            if not pid_running(pid):
                break
            time.sleep(0.2)
        if pid_running(pid):
            os.kill(pid, signal.SIGKILL)
        try:
            if self.pid_file.exists():
                self.pid_file.unlink()
        except OSError:
            pass
        print(f"mailroom.task.worker: stopped pid={pid}")
        return 0


def on_signal(_signum: int, _frame: Any) -> None:
    global _SHUTDOWN
    _SHUTDOWN = True


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Governed autonomous worker lane for spine.control.cycle and mailroom tasks")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--daemon", action="store_true", help="Start background worker daemon")
    mode.add_argument("--foreground", action="store_true", help="Run worker loop in foreground")
    mode.add_argument("--once", action="store_true", help="Run a single tick (cycle + task consume)")
    mode.add_argument("--status", action="store_true", help="Show worker status")
    mode.add_argument("--stop", action="store_true", help="Stop worker daemon")
    p.add_argument("--worker-id", help="Override claim policy worker id")
    p.add_argument("--poll-seconds", type=int, help="Override poll interval in seconds")
    p.add_argument("--max-claims-per-tick", type=int, help="Override task max claims per tick")
    return p


def main() -> int:
    args = build_parser().parse_args()
    worker = TaskWorker(
        worker_id=args.worker_id,
        poll_override=args.poll_seconds,
        max_claims_override=args.max_claims_per_tick,
    )

    if args.status:
        return worker.status()
    if args.stop:
        return worker.stop()
    if args.once:
        payload = worker.run_once()
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    if args.daemon:
        if worker.pid_file.exists():
            try:
                pid = int(worker.pid_file.read_text(encoding="utf-8").strip())
            except Exception:
                pid = 0
            if pid > 0 and pid_running(pid):
                print(f"mailroom.task.worker: already running pid={pid}")
                return 0

        cmd = [sys.executable, str(Path(__file__).resolve()), "--foreground"]
        if args.worker_id:
            cmd.extend(["--worker-id", args.worker_id])
        if args.poll_seconds is not None:
            cmd.extend(["--poll-seconds", str(args.poll_seconds)])
        if args.max_claims_per_tick is not None:
            cmd.extend(["--max-claims-per-tick", str(args.max_claims_per_tick)])

        subprocess.Popen(
            cmd,
            cwd=str(ROOT),
            env=os.environ.copy(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline:
            if worker.pid_file.exists():
                try:
                    pid = int(worker.pid_file.read_text(encoding="utf-8").strip())
                except Exception:
                    pid = 0
                if pid > 0 and pid_running(pid):
                    break
            time.sleep(0.1)
        return worker.status()

    # default path
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    if args.foreground:
        return worker.run_forever()
    payload = worker.run_once()
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
