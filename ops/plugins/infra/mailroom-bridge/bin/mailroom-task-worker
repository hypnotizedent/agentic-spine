#!/usr/bin/env python3
"""mailroom-task-worker — bounded operational mailroom worker."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parents[5]
CONTRACT = ROOT / "ops" / "bindings" / "mailroom.task.worker.contract.yaml"
STATE_ROOT = os.environ.get("SPINE_STATE", "")
TASK_ROOT = Path(STATE_ROOT) / "agent-tasks" if STATE_ROOT else Path()
QUEUED_DIR = TASK_ROOT / "queued"
STATUS_PATH = TASK_ROOT / "mailroom-task-worker.status.json"
RUN_KEY_RE = re.compile(r"Run Key:\s+(\S+)")
PROVIDER_RUN_RE = re.compile(r"PROVIDER_(REQUESTED|USED|MODEL)=(.+)")
USAGE_RE = re.compile(r"USAGE_(INPUT|OUTPUT|TOTAL)_TOKENS=(\d+)")
RESULT_RE = re.compile(r"RESULT=(.+)")


class WorkerError(RuntimeError):
    """Raised when worker setup or execution fails."""


def _load_contract() -> dict[str, Any]:
    try:
        payload = yaml.safe_load(CONTRACT.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as exc:
        raise WorkerError(f"cannot load worker contract: {exc}") from exc
    return payload if isinstance(payload, dict) else {}


def _task_execution_contract(contract: dict[str, Any]) -> dict[str, Any]:
    task_execution = contract.get("task_execution")
    return task_execution if isinstance(task_execution, dict) else {}


def _runtime_contract(contract: dict[str, Any]) -> dict[str, Any]:
    runtime = contract.get("runtime")
    return runtime if isinstance(runtime, dict) else {}


def _now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _write_status(payload: dict[str, Any]) -> None:
    STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATUS_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, STATUS_PATH)


def _task_doc(path: Path) -> dict[str, Any]:
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return {}
    return payload if isinstance(payload, dict) else {}


_AGENT_TOOL_REFUSAL = (
    "agent_tool route target requires bridge_allowed=true and a readable "
    "route_prompt_ref. Generic tool-using AI-agent autonomy remains unavailable."
)
V2_1_SCOPE = "tool_using_agent_v2_1_readonly_repo"
V2_2_SCOPE = "tool_using_agent_v2_2_readonly_capability_calls"


def _task_supported(doc: dict[str, Any], *, allowlist: set[str], supported_routes: set[str]) -> tuple[bool, str]:
    route_target = str(doc.get("route_target") or "").strip().lower()
    if route_target not in supported_routes:
        return False, f"unsupported route_target={route_target or 'unset'}"
    if route_target == "capability":
        capability = str(doc.get("route_capability") or "").strip()
        if not capability:
            payload = doc.get("payload")
            if isinstance(payload, str):
                try:
                    payload = json.loads(payload)
                except json.JSONDecodeError:
                    payload = {}
            if isinstance(payload, dict):
                capability = str(payload.get("route_capability") or "").strip()
        if not capability:
            return False, "capability route missing route_capability"
        if capability not in allowlist:
            return False, f"capability {capability} not allowlisted"
    elif route_target == "agent_tool":
        payload = _normalize_payload(doc)
        bridge_allowed = bool(doc.get("bridge_allowed") or payload.get("bridge_allowed"))
        prompt_ref = str(doc.get("route_prompt_ref") or payload.get("route_prompt_ref") or "").strip()
        if not bridge_allowed or not prompt_ref:
            return False, _AGENT_TOOL_REFUSAL
    return True, ""


def _claim_task(task_id: str, worker_id: str) -> dict[str, Any]:
    proc = subprocess.run(
        [
            str(ROOT / "ops" / "plugins" / "infra" / "mailroom-bridge" / "bin" / "mailroom-task-claim"),
            "--task-id",
            task_id,
            "--worker",
            worker_id,
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
        env=os.environ.copy(),
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.claim failed for {task_id}")
    payload = json.loads(proc.stdout)
    return payload.get("data") if isinstance(payload.get("data"), dict) else {}


def _heartbeat_task(task_id: str, progress: str) -> None:
    proc = subprocess.run(
        [
            str(ROOT / "ops" / "plugins" / "infra" / "mailroom-bridge" / "bin" / "mailroom-task-heartbeat"),
            "--task-id",
            task_id,
            "--progress",
            progress,
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
        env=os.environ.copy(),
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.heartbeat failed for {task_id}")


def _complete_task(task_id: str, result: str) -> None:
    proc = subprocess.run(
        [
            str(ROOT / "ops" / "plugins" / "infra" / "mailroom-bridge" / "bin" / "mailroom-task-complete"),
            "--task-id",
            task_id,
            "--result",
            result,
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
        env=os.environ.copy(),
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.complete failed for {task_id}")


def _fail_task(task_id: str, reason: str) -> None:
    proc = subprocess.run(
        [
            str(ROOT / "ops" / "plugins" / "infra" / "mailroom-bridge" / "bin" / "mailroom-task-fail"),
            "--task-id",
            task_id,
            "--reason",
            reason,
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
        env=os.environ.copy(),
    )
    if proc.returncode != 0:
        raise WorkerError(proc.stderr.strip() or proc.stdout.strip() or f"mailroom.task.fail failed for {task_id}")


def _running_file(task_id: str) -> Path:
    return TASK_ROOT / "running" / f"{task_id}.yaml"


def _terminal_file(task_id: str, state: str) -> Path:
    return TASK_ROOT / state / f"{task_id}.yaml"


def _write_task_fields(path: Path, fields: dict[str, Any]) -> None:
    doc = _task_doc(path)
    if not doc:
        return
    doc.update(fields)
    tmp = path.with_suffix(".yaml.tmp")
    tmp.write_text(yaml.safe_dump(doc, sort_keys=False), encoding="utf-8")
    os.replace(tmp, path)


def _normalize_payload(doc: dict[str, Any]) -> dict[str, Any]:
    payload = doc.get("payload")
    if isinstance(payload, dict):
        return payload
    if isinstance(payload, str) and payload.strip():
        try:
            decoded = json.loads(payload)
        except json.JSONDecodeError:
            return {}
        return decoded if isinstance(decoded, dict) else {}
    return {}


def _payload_list(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(item).strip() for item in value if str(item).strip()]
    if isinstance(value, str) and value.strip():
        return [item.strip() for item in value.split(",") if item.strip()]
    return []


def _agent_bridge_contract() -> dict[str, Any]:
    return (_task_execution_contract(_load_contract()).get("agent_tool_bridge") or {})


def _repo_relative_path(path: Path) -> str:
    return str(path.relative_to(ROOT.resolve()))


def _bridge_section(name: str) -> dict[str, Any]:
    bridge = _agent_bridge_contract()
    section = bridge.get(name)
    return section if isinstance(section, dict) else {}


def _requested_readonly_capability(payload: dict[str, Any]) -> str:
    values: list[str] = []
    for key in (
        "read_only_capability",
        "readonly_capability",
        "route_capability",
        "capability",
    ):
        value = str(payload.get(key) or "").strip()
        if value:
            values.append(value)
    values.extend(_payload_list(payload.get("read_only_capabilities") or payload.get("capabilities")))

    unique = list(dict.fromkeys(values))
    if len(unique) != 1:
        raise WorkerError("read_only_capability tool_set requires exactly one requested capability")
    return unique[0]


def _run_readonly_capability_context(worker_id: str, payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    capability = _requested_readonly_capability(payload)
    v2 = _bridge_section("v2_2_read_only_capability_calls")
    allowlist = {str(item).strip() for item in (v2.get("capability_allowlist") or []) if str(item).strip()}
    if capability not in allowlist:
        raise WorkerError(f"read_only_capability {capability} not allowlisted")

    max_stdout_bytes = int(v2.get("max_stdout_bytes") or 12000)
    if max_stdout_bytes < 1:
        raise WorkerError("read_only_capability max_stdout_bytes must be positive")

    env = os.environ.copy()
    env["SPINE_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ROLE"] = worker_id
    env["SPINE_EXECUTION_CLASS"] = "worker"
    env["SPINE_RUNTIME_ROLE"] = "worker"
    env["SPINE_SESSION_POSTURE"] = "worker"

    proc = subprocess.run(
        [str(ROOT / "bin" / "ops"), "cap", "run", capability],
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    merged = "\n".join(part for part in [proc.stdout.strip(), proc.stderr.strip()] if part).strip()
    merged_bytes = merged.encode("utf-8", errors="replace")
    chunk = merged_bytes[:max_stdout_bytes]
    stdout_text = chunk.decode("utf-8", errors="replace")
    run_keys = list(dict.fromkeys(RUN_KEY_RE.findall(merged)))
    proof = {
        "tool_set": "read_only_capability_calls",
        "tool_access": "bounded_read_only_capability_context",
        "capabilities_called": [capability],
        "run_keys": run_keys,
        "stdout_bytes": len(chunk),
        "stdout_truncated": len(merged_bytes) > len(chunk),
        "tool_call_count": 1,
        "mutation_access": "none",
    }
    if proc.returncode != 0:
        reason = f"read_only_capability={capability} rc={proc.returncode}"
        if merged:
            reason = f"{reason} :: {merged.splitlines()[-1][:240]}"
        raise WorkerError(reason)
    return (
        "\n\nREAD_ONLY_CAPABILITY_CONTEXT:\n"
        "The following read-only capability was run by the mailroom worker before spawn. "
        "The provider receives only this bounded output and receives no shell, filesystem, git, or ops access.\n\n"
        f"--- CAPABILITY: {capability} ---\n"
        f"{stdout_text}\n"
        f"--- END CAPABILITY: {capability} ---\n",
        proof,
    )


def _build_readonly_repo_context(payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
    if tool_set in {"", "none"}:
        tool_set = "prompt_only"
    if tool_set == "prompt_only":
        return "", {
            "tool_set": "prompt_only",
            "tool_access": "none",
            "files_read": [],
            "tool_call_count": 0,
        }
    if tool_set != "read_only_repo":
        raise WorkerError(f"unsupported agent tool_set={tool_set}")

    paths = _payload_list(payload.get("repo_read_paths") or payload.get("read_only_paths"))
    if not paths:
        raise WorkerError("read_only_repo tool_set requires repo_read_paths")

    v2 = _bridge_section("v2_1_read_only_repo_inspection")
    max_files = int(v2.get("max_files") or 6)
    max_bytes_per_file = int(v2.get("max_bytes_per_file") or 6000)
    max_total_bytes = int(v2.get("max_total_bytes") or 18000)
    excluded_roots = {str(item).strip() for item in (v2.get("excluded_roots") or [".git", ".runtime"]) if str(item).strip()}

    root_resolved = ROOT.resolve()
    sections: list[str] = []
    files_read: list[dict[str, Any]] = []
    total_bytes = 0

    for raw in paths[:max_files]:
        candidate = (ROOT / raw).expanduser()
        try:
            resolved = candidate.resolve()
        except OSError as exc:
            raise WorkerError(f"repo_read_path cannot be resolved: {raw}") from exc
        try:
            relative = resolved.relative_to(root_resolved)
        except ValueError as exc:
            raise WorkerError(f"repo_read_path outside repo root: {resolved}") from exc
        if relative.parts and relative.parts[0] in excluded_roots:
            raise WorkerError(f"repo_read_path uses excluded root: {relative.parts[0]}")
        if not resolved.is_file():
            raise WorkerError(f"repo_read_path is not a file: {relative}")

        raw_bytes = resolved.read_bytes()
        truncated = len(raw_bytes) > max_bytes_per_file
        chunk = raw_bytes[:max_bytes_per_file]
        remaining = max_total_bytes - total_bytes
        if remaining <= 0:
            break
        if len(chunk) > remaining:
            chunk = chunk[:remaining]
            truncated = True
        total_bytes += len(chunk)
        text = chunk.decode("utf-8", errors="replace")
        rel_text = str(relative)
        sections.append(f"--- FILE: {rel_text} ---\n{text}\n--- END FILE: {rel_text} ---")
        files_read.append(
            {
                "path": rel_text,
                "bytes_read": len(chunk),
                "truncated": truncated,
            }
        )

    if not files_read:
        raise WorkerError("read_only_repo tool_set produced no admitted file reads")
    return (
        "\n\nREAD_ONLY_REPO_CONTEXT:\n"
        "The following files were read by the mailroom worker before spawn. "
        "They are the only repo context admitted for this task.\n\n"
        + "\n\n".join(sections)
        + "\n",
        {
            "tool_set": "read_only_repo",
            "tool_access": "bounded_read_only_repo_context",
            "repo_fence": str(root_resolved),
            "files_read": files_read,
            "tool_call_count": len(files_read),
        },
    )


def _resolve_prompt_ref(value: str) -> Path:
    prompt_ref = Path(value).expanduser()
    if not prompt_ref.is_absolute():
        prompt_ref = ROOT / prompt_ref
    try:
        resolved = prompt_ref.resolve()
    except OSError as exc:
        raise WorkerError(f"route_prompt_ref cannot be resolved: {value}") from exc
    allowed_roots = [
        ROOT,
        Path(os.environ.get("SPINE_STATE", "")).expanduser(),
    ]
    if not any(str(resolved).startswith(str(root.resolve())) for root in allowed_roots if str(root)):
        raise WorkerError(f"route_prompt_ref outside admitted roots: {resolved}")
    if not resolved.is_file():
        raise WorkerError(f"route_prompt_ref not readable file: {resolved}")
    return resolved


def _build_agent_context(doc: dict[str, Any], worker_id: str) -> tuple[str, dict[str, Any]]:
    payload = _normalize_payload(doc)
    tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
    if tool_set in {"read_only_capability", "read_only_capability_calls"}:
        return _run_readonly_capability_context(worker_id, payload)
    return _build_readonly_repo_context(payload)


def _build_agent_prompt(task_id: str, doc: dict[str, Any], worker_id: str) -> tuple[str, Path, dict[str, Any]]:
    payload = _normalize_payload(doc)
    prompt_ref = str(doc.get("route_prompt_ref") or payload.get("route_prompt_ref") or "").strip()
    prompt_path = _resolve_prompt_ref(prompt_ref)
    prompt_text = prompt_path.read_text(encoding="utf-8")
    max_prompt_bytes = int((_agent_bridge_contract().get("max_prompt_bytes")) or 12000)
    encoded = prompt_text.encode("utf-8")
    if len(encoded) > max_prompt_bytes:
        prompt_text = encoded[:max_prompt_bytes].decode("utf-8", errors="ignore")
    summary = str(doc.get("summary") or task_id).strip()
    tool_context, tool_proof = _build_agent_context(doc, worker_id)
    return (
        "You are a bounded AI agent running under the spine mailroom execution "
        "pickup bridge. You must not claim to mutate files, run shell commands, "
        "use hidden context, or complete work outside this prompt. If a "
        "READ_ONLY_REPO_CONTEXT or READ_ONLY_CAPABILITY_CONTEXT block is present, "
        "treat it as the only admitted inspection context for this task. "
        "Return a concise result with three fields: OBSERVED, RESULT, LIMITS.\n\n"
        f"TASK_ID: {task_id}\n"
        f"SUMMARY: {summary}\n"
        f"PROMPT_REF: {prompt_path}\n\n"
        "PROMPT_BODY:\n"
        f"{prompt_text}\n"
        f"{tool_context}",
        prompt_path,
        tool_proof,
    )


def _parse_provider_output(output: str) -> dict[str, Any]:
    provider: dict[str, Any] = {"usage": {}}
    for line in output.splitlines():
        match = PROVIDER_RUN_RE.match(line.strip())
        if match:
            provider[match.group(1).lower()] = match.group(2).strip()
            continue
        match = USAGE_RE.match(line.strip())
        if match:
            provider["usage"][match.group(1).lower()] = int(match.group(2))
            continue
        match = RESULT_RE.match(line.strip())
        if match:
            provider["result_file"] = match.group(1).strip()
    return provider


def _execute_agent_tool(task_id: str, doc: dict[str, Any], worker_id: str) -> dict[str, Any]:
    payload = _normalize_payload(doc)
    bridge_allowed = bool(doc.get("bridge_allowed") or payload.get("bridge_allowed"))
    if not bridge_allowed:
        _fail_task(task_id, _AGENT_TOOL_REFUSAL)
        return {"task_id": task_id, "status": "failed", "error": _AGENT_TOOL_REFUSAL}

    try:
        prompt, prompt_path, tool_proof = _build_agent_prompt(task_id, doc, worker_id)
    except WorkerError as exc:
        payload_tool_set = str(payload.get("tool_set") or payload.get("agent_tool_tool_set") or "prompt_only").strip()
        if payload_tool_set == "read_only_repo":
            scope = V2_1_SCOPE
        elif payload_tool_set in {"read_only_capability", "read_only_capability_calls"}:
            scope = V2_2_SCOPE
            payload_tool_set = "read_only_capability_calls"
        else:
            scope = "bounded_readonly_provider_agent"
        reason = str(exc)
        proof = {
            "scope": scope,
            "status": "failed",
            "failure_reason": reason,
            "tool_set": payload_tool_set or "prompt_only",
            "mutation_access": "none",
            "receipt": "task_envelope_bridge_proof",
        }
        if scope == V2_2_SCOPE:
            requested = reason.split("read_only_capability ", 1)[1].split(" ", 1)[0] if "read_only_capability " in reason else ""
            if requested:
                proof["denied_capabilities"] = [requested]
        _fail_task(task_id, reason)
        _write_task_fields(
            _terminal_file(task_id, "failed"),
            {"bridge_proof": proof},
        )
        return {"task_id": task_id, "status": "failed", "route_target": "agent_tool", "error": reason}
    run_id = f"{task_id}-agent"
    provider_runs = ROOT / "ops" / "plugins" / "providers" / "runs"
    run_dir = provider_runs / run_id
    run_dir.mkdir(parents=True, exist_ok=True)
    request_file = run_dir / "request.txt"
    request_file.write_text(prompt, encoding="utf-8")

    provider = str(payload.get("provider") or os.environ.get("SPINE_AGENT_BRIDGE_PROVIDER") or "zai")
    timeout_seconds = int(payload.get("timeout_seconds") or ((_agent_bridge_contract().get("timeout_seconds")) or 300))
    env = os.environ.copy()
    env.update(
        {
            "SPINE_ENGINE_PROVIDER": provider,
            "SPINE_ENGINE_MAX_TOKENS": str(payload.get("max_tokens") or "512"),
            "SPINE_TERMINAL_ID": worker_id,
            "OPS_TERMINAL_ID": worker_id,
            "OPS_TERMINAL_ROLE": worker_id,
            "SPINE_EXECUTION_CLASS": "worker",
            "SPINE_RUNTIME_ROLE": "worker",
            "SPINE_SESSION_POSTURE": "worker",
        }
    )

    runner = ROOT / "ops" / "plugins" / "providers" / "bin" / "run.sh"
    if not runner.is_file():
        raise WorkerError(f"provider runner missing: {runner}")

    _heartbeat_task(task_id, f"spawning bounded provider agent provider={provider}")
    proc = subprocess.Popen(
        [str(runner), run_id],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    started = time.time()
    heartbeats = 0
    timed_out = False
    while proc.poll() is None:
        if time.time() - started > timeout_seconds:
            timed_out = True
            proc.kill()
            break
        _heartbeat_task(task_id, f"agent_tool running provider={provider} elapsed={int(time.time() - started)}s")
        heartbeats += 1
        time.sleep(5)
    stdout, stderr = proc.communicate()
    merged = "\n".join(part for part in [stdout.strip(), stderr.strip()] if part).strip()
    provider_info = _parse_provider_output(merged)
    result_file = Path(str(provider_info.get("result_file") or run_dir / "result.txt"))
    result_text = ""
    if result_file.is_file():
        result_text = result_file.read_text(encoding="utf-8").strip()
    if not result_text and merged:
        result_text = merged.splitlines()[-1][:1000]

    if tool_proof.get("tool_set") == "read_only_repo":
        scope = V2_1_SCOPE
    elif tool_proof.get("tool_set") == "read_only_capability_calls":
        scope = V2_2_SCOPE
    else:
        scope = "bounded_readonly_provider_agent"
    base_proof = {
        "scope": scope,
        "provider_requested": provider,
        "provider_used": provider_info.get("used"),
        "model": provider_info.get("model"),
        "prompt_ref": str(prompt_path),
        "run_id": run_id,
        "provider_run_retained": os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") == "1",
        "spawn": "subprocess",
        "prompt_injection": "route_prompt_ref",
        "heartbeats_emitted": heartbeats,
        "tool_access": tool_proof.get("tool_access") or "none",
        "mutation_access": "none",
        "receipt": "task_envelope_bridge_proof",
        "usage": provider_info.get("usage") or {},
    }
    base_proof.update(tool_proof)
    if base_proof["provider_run_retained"]:
        base_proof.update(
            {
                "run_dir": str(run_dir),
                "request_file": str(request_file),
                "result_file": str(result_file),
            }
        )
    if timed_out:
        reason = f"agent_tool provider={provider} timed out after {timeout_seconds}s"
        _fail_task(task_id, reason)
        _write_task_fields(_terminal_file(task_id, "failed"), {"bridge_proof": base_proof | {"status": "failed", "failure_reason": reason}})
        return {"task_id": task_id, "status": "failed", "error": reason}
    if proc.returncode != 0:
        reason = f"agent_tool provider={provider} rc={proc.returncode}"
        if merged:
            reason = f"{reason} :: {merged.splitlines()[-1][:240]}"
        _fail_task(task_id, reason)
        _write_task_fields(_terminal_file(task_id, "failed"), {"bridge_proof": base_proof | {"status": "failed", "failure_reason": reason}})
        return {"task_id": task_id, "status": "failed", "error": reason}

    summary = str(doc.get("summary") or task_id).strip()
    result = f"{summary} -> agent_tool provider={provider_info.get('used') or provider} model={provider_info.get('model') or 'unknown'} bridge_proof={scope}"
    _complete_task(task_id, result)
    _write_task_fields(
        _terminal_file(task_id, "done"),
        {
            "bridge_proof": base_proof | {
                "status": "completed",
                "result_excerpt": result_text[:1000],
            }
        },
    )
    if os.environ.get("SPINE_AGENT_BRIDGE_KEEP_RUNS", "0") != "1":
        shutil.rmtree(run_dir, ignore_errors=True)
    return {
        "task_id": task_id,
        "status": "completed",
        "route_target": "agent_tool",
        "provider": provider_info.get("used") or provider,
        "model": provider_info.get("model") or "",
        "result": result,
    }


def _execute_capability(task_id: str, doc: dict[str, Any], worker_id: str) -> dict[str, Any]:
    payload = _normalize_payload(doc)
    capability = str(doc.get("route_capability") or payload.get("route_capability") or "").strip()
    route_args = doc.get("route_args")
    if not isinstance(route_args, list):
        route_args = payload.get("route_args")
    route_args = [str(item) for item in route_args] if isinstance(route_args, list) else []
    summary = str(doc.get("summary") or task_id).strip()

    _heartbeat_task(task_id, f"executing capability {capability}")
    env = os.environ.copy()
    env["SPINE_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ID"] = worker_id
    env["OPS_TERMINAL_ROLE"] = worker_id
    env["SPINE_EXECUTION_CLASS"] = "worker"
    env["SPINE_RUNTIME_ROLE"] = "worker"
    env["SPINE_SESSION_POSTURE"] = "worker"

    cmd = [str(ROOT / "bin" / "ops"), "cap", "run", capability]
    if route_args:
        cmd.extend(["--", *route_args])
    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    merged = "\n".join(part for part in [proc.stdout.strip(), proc.stderr.strip()] if part).strip()
    run_key = ""
    match = RUN_KEY_RE.search(merged)
    if match:
        run_key = match.group(1)

    if proc.returncode == 0:
        result = f"{summary} -> capability={capability}"
        if run_key:
            result += f" run_key={run_key}"
        _complete_task(task_id, result)
        return {
            "task_id": task_id,
            "status": "completed",
            "capability": capability,
            "run_key": run_key,
            "result": result,
        }

    failure_reason = f"capability={capability} rc={proc.returncode}"
    if merged:
        failure_reason = f"{failure_reason} :: {merged.splitlines()[-1][:240]}"
    _fail_task(task_id, failure_reason)
    return {
        "task_id": task_id,
        "status": "failed",
        "capability": capability,
        "run_key": run_key,
        "error": failure_reason,
    }


def _process_once(*, worker_id: str, claim_limit: int, allowlist: set[str], supported_routes: set[str]) -> dict[str, Any]:
    QUEUED_DIR.mkdir(parents=True, exist_ok=True)
    queued = sorted(QUEUED_DIR.glob("TASK-*.yaml"))
    claimed: list[dict[str, Any]] = []
    completed: list[dict[str, Any]] = []
    failed: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []

    for path in queued:
        if len(claimed) >= claim_limit:
            break
        doc = _task_doc(path)
        if not doc:
            skipped.append({"task_id": path.stem, "reason": "unreadable task envelope"})
            continue
        supported, reason = _task_supported(doc, allowlist=allowlist, supported_routes=supported_routes)
        task_id = str(doc.get("task_id") or path.stem).strip()
        if not supported:
            route_target = str(doc.get("route_target") or "").strip().lower()
            if route_target == "agent_tool":
                # Hard refusal: claim then fail so the operator sees an
                # explicit outcome rather than a silent skip that leaves the
                # task stuck in the queue forever.
                try:
                    _claim_task(task_id, worker_id)
                    _fail_task(task_id, reason)
                    failed.append({"task_id": task_id, "status": "failed", "error": reason})
                except WorkerError:
                    skipped.append({"task_id": task_id, "reason": f"deferred-refusal claim error: {reason}"})
            else:
                skipped.append({"task_id": task_id, "reason": reason})
            continue
        claim_data = _claim_task(task_id, worker_id)
        claimed.append({"task_id": task_id, "state": "running", "worker": worker_id})
        running_file = Path(str(claim_data.get("file") or TASK_ROOT / "running" / f"{task_id}.yaml"))
        running_doc = _task_doc(running_file)
        if str(running_doc.get("route_target") or "").strip().lower() == "agent_tool":
            result = _execute_agent_tool(task_id, running_doc, worker_id)
        else:
            result = _execute_capability(task_id, running_doc, worker_id)
        if result.get("status") == "completed":
            completed.append(result)
        else:
            failed.append(result)

    heartbeat_at = _now()
    payload = {
        "generated_at": heartbeat_at,
        "heartbeat_at": heartbeat_at,
        "worker_id": worker_id,
        "mode": "once",
        "queued_seen": len(queued),
        "claimed": claimed,
        "completed": completed,
        "failed": failed,
        "skipped": skipped,
    }
    _write_status(payload)
    return payload


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="mailroom-task-worker",
        description="Run the operational mailroom worker once or in foreground mode.",
    )
    parser.add_argument("--once", action="store_true", help="Run one bounded worker pass and exit.")
    parser.add_argument("--foreground", action="store_true", help="Run as a long-lived polling worker.")
    parser.add_argument("--worker-id", default="", help="Canonical worker terminal identity.")
    parser.add_argument("--poll-seconds", type=int, default=0, help="Foreground poll interval override.")
    parser.add_argument("--claim-limit", type=int, default=0, help="Maximum claims per pass override.")
    parser.add_argument("--json", action="store_true", dest="json_output", help="Emit JSON output.")
    parser.add_argument("--self-check", action="store_true", help="Verify dependencies and exit.")

    if "--self-check" in sys.argv:
        try:
            import yaml  # noqa: F401
            v2_2 = _bridge_section("v2_2_read_only_capability_calls")
            allowlist = {str(item).strip() for item in (v2_2.get("capability_allowlist") or []) if str(item).strip()}
            if not allowlist:
                raise WorkerError("v2_2_read_only_capability_calls capability_allowlist missing")
            if _requested_readonly_capability({"read_only_capability": sorted(allowlist)[0]}) not in allowlist:
                raise WorkerError("read_only_capability request parser failed")
            print("mailroom.task.worker.once self-check PASS")
            return 0
        except (ImportError, WorkerError) as exc:
            print(f"mailroom.task.worker.once self-check FAIL: {exc}", file=sys.stderr)
            return 1

    args = parser.parse_args()
    if not STATE_ROOT:
        msg = "SPINE_STATE not set; call spine_runtime_resolve_paths first"
        if args.json_output:
            print(json.dumps({"status": "error", "error": msg}, indent=2))
        else:
            print(f"mailroom.task.worker FAIL: {msg}", file=sys.stderr)
        return 1

    contract = _load_contract()
    runtime_contract = _runtime_contract(contract)
    task_execution = _task_execution_contract(contract)
    worker_id = args.worker_id or str(task_execution.get("claim_policy", {}).get("worker_id") or "SPINE-EXECUTION-01")
    claim_limit = args.claim_limit or int(task_execution.get("max_claims_per_tick") or 1)
    poll_seconds = args.poll_seconds or int(runtime_contract.get("poll_seconds") or 90)
    supported_routes = {str(item).strip() for item in (task_execution.get("execute_route_targets") or []) if str(item).strip()}
    allowlist = {str(item).strip() for item in (task_execution.get("capability_allowlist") or []) if str(item).strip()}

    if "capability" not in supported_routes:
        raise WorkerError("mailroom worker contract must allow capability route_target for active operational execution")

    run_once = bool(args.once or not args.foreground)
    try:
        if args.foreground:
            while True:
                _process_once(worker_id=worker_id, claim_limit=claim_limit, allowlist=allowlist, supported_routes=supported_routes)
                time.sleep(max(poll_seconds, 1))
        if run_once:
            result = _process_once(worker_id=worker_id, claim_limit=claim_limit, allowlist=allowlist, supported_routes=supported_routes)
    except KeyboardInterrupt:
        return 130
    except WorkerError as exc:
        if args.json_output:
            print(json.dumps({"status": "error", "error": str(exc)}, indent=2))
        else:
            print(f"mailroom.task.worker FAIL: {exc}", file=sys.stderr)
        return 1

    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        print(f"queued_seen: {result['queued_seen']}")
        print(f"claimed: {len(result['claimed'])}")
        print(f"completed: {len(result['completed'])}")
        print(f"failed: {len(result['failed'])}")
        print(f"skipped: {len(result['skipped'])}")
        for item in result["completed"]:
            detail = item.get("capability") or item.get("route_target") or item.get("provider") or "unknown"
            print(f"- completed {item['task_id']} route={detail} run_key={item.get('run_key', '')}")
        for item in result["failed"]:
            detail = item.get("capability") or item.get("route_target") or item.get("provider") or "unknown"
            print(f"- failed {item['task_id']} route={detail} error={item['error']}")
        for item in result["skipped"]:
            print(f"- skipped {item['task_id']} reason={item['reason']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
