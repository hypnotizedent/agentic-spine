    task_id = f"TASK-{run_id}-v2-cap-denied"
    prompt = f"/home/ubuntu/code/.runtime/spine/state/domain-state/recovery-drills/execution-pickup/{run_id}-v2-cap-denied.md"
    payload = ssh(
        remote_prelude()
        + f"""
        sudo systemctl stop {UNIT}
        mkdir -p "$(dirname {prompt})"
        printf '%s\\n' 'Return OBSERVED/RESULT/LIMITS. This fixture must fail before provider execution because verify.infra.run is not in the V2.2 read-only capability-call allowlist.' > {prompt}
        ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-enqueue --task-id {task_id} --summary 'Recovery drill V2.2 denied read-only capability proof' --route-target agent_tool --bridge-allowed --route-prompt-ref {prompt} --payload '{{"provider":"zai","tool_set":"read_only_capability_calls","read_only_capability":"verify.infra.run","timeout_seconds":60}}' --json >/dev/null
        SPINE_AGENT_BRIDGE_KEEP_RUNS=1 python3 ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-worker --once --worker-id SPINE-RECOVERY-DRILL --json >/tmp/{task_id}.json || true
        sudo systemctl start {UNIT}
        cat /tmp/{task_id}.json
        """,
        timeout=120,
    )
    terminal = wait_task(task_id, timeout_seconds=30)
    proof = terminal.get("bridge_proof") if isinstance(terminal.get("bridge_proof"), dict) else {}
    reason = str(terminal.get("failure_reason") or proof.get("failure_reason") or "")
    denied = proof.get("denied_capabilities")
    passed = (
        terminal.get("state") == "failed"
        and proof.get("scope") == "tool_using_agent_v2_2_readonly_capability_calls"
        and proof.get("tool_set") == "read_only_capability_calls"
        and proof.get("mutation_access") == "none"
        and (
            (isinstance(denied, list) and "verify.infra.run" in denied)
            or ("unallowlisted" in reason and "verify.infra.run" in reason)
        )
    )
    return {"fixture": "v2_2_readonly_capability_denied_unallowlisted", "worker_once": payload, "terminal": terminal, "passed": passed}


def fixture_v2_3_fenced_artifact_denied_outside_fence(run_id: str) -> dict[str, Any]:
    task_id = f"TASK-{run_id}-v23-artifact-fence"
    prompt = f"/home/ubuntu/code/.runtime/spine/state/domain-state/recovery-drills/execution-pickup/{run_id}-v23-artifact-fence.md"
    payload = ssh(
        remote_prelude()
        + f"""
        sudo systemctl stop {UNIT}
        mkdir -p "$(dirname {prompt})"
        printf '%s\\n' 'Return OBSERVED/RESULT/LIMITS. Produce a short governed artifact body. Do not claim filesystem access.' > {prompt}
        ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-enqueue --task-id {task_id} --summary 'Recovery drill V2.3 fenced artifact proof' --route-target agent_tool --bridge-allowed --route-prompt-ref {prompt} --payload '{{"provider":"zai","tool_set":"fenced_artifact_write","artifact_name":"../../outside.md","timeout_seconds":90,"max_tokens":256}}' --json >/dev/null
        SPINE_AGENT_BRIDGE_KEEP_RUNS=1 python3 ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-worker --once --worker-id SPINE-RECOVERY-DRILL --json >/tmp/{task_id}.json || true
        sudo systemctl start {UNIT}
        cat /tmp/{task_id}.json
        """,
        timeout=180,
    )
    terminal = wait_task(task_id, timeout_seconds=60)
    proof = terminal.get("bridge_proof") if isinstance(terminal.get("bridge_proof"), dict) else {}
    artifact_path = str(proof.get("artifact_path") or "")
    artifact_fence = str(proof.get("artifact_fence") or "")
    passed = (
        terminal.get("state") == "done"
        and proof.get("scope") == "tool_using_agent_v2_3_fenced_artifact_write"
        and proof.get("tool_set") == "fenced_artifact_write"
        and proof.get("mutation_access") == "fenced_runtime_artifact_only"
        and artifact_path.startswith(artifact_fence)
        and "/../" not in artifact_path
        and int(proof.get("artifact_bytes") or 0) > 0
    )
    return {"fixture": "v2_3_fenced_artifact_denied_outside_fence", "worker_once": payload, "terminal": terminal, "passed": passed}


def fixture_v2_4_patch_artifact_no_worktree_mutation(run_id: str) -> dict[str, Any]:
    task_id = f"TASK-{run_id}-v24-patch-artifact"
    prompt = f"/home/ubuntu/code/.runtime/spine/state/domain-state/recovery-drills/execution-pickup/{run_id}-v24-patch-artifact.md"
    payload = ssh(
        remote_prelude()
        + f"""
        sudo systemctl stop {UNIT}
        mkdir -p "$(dirname {prompt})"
        printf '%s\\n' 'Return a tiny unified diff touching no real file; this is a patch artifact proof only. Do not claim it was applied.' > {prompt}
        before="$(git status --porcelain=v1 | sha256sum | awk '{{print $1}}')"
        ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-enqueue --task-id {task_id} --summary 'Recovery drill V2.4 patch artifact proof' --route-target agent_tool --bridge-allowed --route-prompt-ref {prompt} --payload '{{"provider":"zai","tool_set":"patch_artifact","patch_artifact_name":"proof.patch","timeout_seconds":90,"max_tokens":256}}' --json >/dev/null
        SPINE_AGENT_BRIDGE_KEEP_RUNS=1 python3 ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-worker --once --worker-id SPINE-RECOVERY-DRILL --json >/tmp/{task_id}.json || true
        after="$(git status --porcelain=v1 | sha256sum | awk '{{print $1}}')"
        sudo systemctl start {UNIT}
        python3 - <<PY
import json
payload=json.loads(open('/tmp/{task_id}.json').read())
payload['git_status_same'] = ("$before" == "$after")
print(json.dumps(payload))
PY
        """,
        timeout=180,
    )
    terminal = wait_task(task_id, timeout_seconds=60)
    proof = terminal.get("bridge_proof") if isinstance(terminal.get("bridge_proof"), dict) else {}
    patch_path = str(proof.get("patch_artifact_path") or "")
    patch_fence = str(proof.get("patch_artifact_fence") or "")
    passed = (
        terminal.get("state") == "done"
        and proof.get("scope") == "tool_using_agent_v2_4_patch_artifact"
        and proof.get("tool_set") == "patch_artifact"
        and proof.get("mutation_access") == "patch_artifact_only"
        and proof.get("worktree_mutation") is False
        and patch_path.startswith(patch_fence)
        and int(proof.get("patch_bytes") or 0) > 0
        and payload.get("git_status_same") is True
    )
    return {"fixture": "v2_4_patch_artifact_no_worktree_mutation", "worker_once": payload, "terminal": terminal, "passed": passed}


def fixture_v2_5_patch_apply_sandbox_no_push_merge(run_id: str) -> dict[str, Any]:
    task_id = f"TASK-{run_id}-v25-patch-apply-sandbox"
    prompt = f"/home/ubuntu/code/.runtime/spine/state/domain-state/recovery-drills/execution-pickup/{run_id}-v25-patch-apply-sandbox.md"
    payload = ssh(
        remote_prelude()
        + f"""
        sudo systemctl stop {UNIT}
        mkdir -p "$(dirname {prompt})"
        cat > {prompt} <<'PROMPT'
Return only this unified diff. Do not claim shell, git, filesystem, push, or merge access.

diff --git a/docs/reference/AI_BRIDGE_V25_SANDBOX_PROOF.md b/docs/reference/AI_BRIDGE_V25_SANDBOX_PROOF.md
new file mode 100644
--- /dev/null
+++ b/docs/reference/AI_BRIDGE_V25_SANDBOX_PROOF.md
@@ -0,0 +1 @@
+V2.5 sandbox apply proof.
PROMPT
        before="$(git status --porcelain=v1 | sha256sum | awk '{{print $1}}')"
        ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-enqueue --task-id {task_id} --summary 'Recovery drill V2.5 patch apply sandbox proof' --route-target agent_tool --bridge-allowed --route-prompt-ref {prompt} --payload '{{"provider":"zai","tool_set":"patch_apply_sandbox","timeout_seconds":90,"max_tokens":256}}' --json >/dev/null
        SPINE_AGENT_BRIDGE_KEEP_RUNS=1 python3 ./ops/plugins/infra/mailroom-bridge/bin/mailroom-task-worker --once --worker-id SPINE-RECOVERY-DRILL --json >/tmp/{task_id}.json || true
        after="$(git status --porcelain=v1 | sha256sum | awk '{{print $1}}')"
        sudo systemctl start {UNIT}
        python3 - <<PY
import json
payload=json.loads(open('/tmp/{task_id}.json').read())
payload['git_status_same'] = ("$before" == "$after")
print(json.dumps(payload))
PY
        """,
        timeout=180,
    )
    terminal = wait_task(task_id, timeout_seconds=60)
    proof = terminal.get("bridge_proof") if isinstance(terminal.get("bridge_proof"), dict) else {}
    passed = (
        terminal.get("state") == "done"
        and proof.get("scope") == "tool_using_agent_v2_5_patch_apply_sandbox"
        and proof.get("tool_set") == "patch_apply_sandbox"
        and proof.get("mutation_access") == "leased_sandbox_worktree_only"
        and proof.get("worktree_mutation_scope") == "leased_sandbox_only"
        and proof.get("patch_apply_status") == "applied"
        and proof.get("sandbox_cleanup") == "removed"
        and proof.get("sandbox_worktree_retained") is False
        and proof.get("push_performed") is False
        and proof.get("merge_performed") is False
        and int(proof.get("patch_bytes") or 0) > 0
        and payload.get("git_status_same") is True
    )
    return {"fixture": "v2_5_patch_apply_sandbox_no_push_merge", "worker_once": payload, "terminal": terminal, "passed": passed}


def write_receipt(payload: dict[str, Any]) -> Path:
    RECEIPT_ROOT.mkdir(parents=True, exist_ok=True)
    path = RECEIPT_ROOT / f"recovery_drill.execution_pickup.{payload['run_id']}.yaml"
    tmp = path.with_suffix(".yaml.tmp")
    tmp.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
    os.replace(tmp, path)
    latest = RECEIPT_ROOT / "latest.yaml"
    latest_tmp = latest.with_suffix(".yaml.tmp")
    latest_tmp.write_text(yaml.safe_dump(payload, sort_keys=False), encoding="utf-8")
    os.replace(latest_tmp, latest)
    return path


def run_drill() -> tuple[dict[str, Any], Path]:
    run_id = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    fixtures = [
        fixture_idle_restart(),
        fixture_queued_restart(run_id),
        fixture_provider_failure(run_id),
        fixture_timeout(run_id),
        fixture_stale_heartbeat(run_id),
        fixture_v2_1_readonly_repo_denied_path(run_id),
        fixture_v2_2_readonly_capability_denied_unallowlisted(run_id),
        fixture_v2_3_fenced_artifact_denied_outside_fence(run_id),
        fixture_v2_4_patch_artifact_no_worktree_mutation(run_id),
        fixture_v2_5_patch_apply_sandbox_no_push_merge(run_id),
    ]
    final = service_active()
    payload = {
        "receipt_class": "recovery_drill",
        "drill_id": "disaster.drill.execution_pickup",
        "run_id": run_id,
        "generated_at": now_utc(),
        "target_host": "ai-consolidation",
        "service_unit": UNIT,
        "fixtures": fixtures,
        "summary": {
            "total": len(fixtures),
            "passed": sum(1 for item in fixtures if item.get("passed")),
            "failed": sum(1 for item in fixtures if not item.get("passed")),
            "service_active_after": final.get("service_active"),
            "worker_fresh_after": final.get("worker_fresh"),
        },
        "freshness_window_hours": 168,
    }
    payload["status"] = "pass" if payload["summary"]["failed"] == 0 and final.get("service_active") == "active" else "fail"
    path = write_receipt(payload)
    return payload, path


def main() -> int:
    parser = argparse.ArgumentParser(description="Run the execution pickup recovery drill.")
    parser.add_argument("--record", action="store_true", help="Run live fixtures and write receipt.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-check", action="store_true")
    args = parser.parse_args()

    if args.self_check:
        missing = [name for name in ("ssh", "python3") if shutil.which(name) is None]
        if missing:
            print(f"disaster.drill.execution_pickup self-check FAIL: missing {', '.join(missing)}")
            return 1
        print("disaster.drill.execution_pickup self-check PASS")
        return 0

    if not args.record:
        payload = {
            "capability": "disaster.drill.execution_pickup",
            "mode": "dry-run",
            "would_target": "ai-consolidation",
            "would_restart_unit": UNIT,
            "fixtures": FIXTURES,
            "receipt_root": str(RECEIPT_ROOT),
        }
        print(json.dumps(payload, indent=2) if args.json else yaml.safe_dump(payload, sort_keys=False))
        return 0

    payload, path = run_drill()
    payload["receipt_path"] = str(path)
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("disaster.drill.execution_pickup")
        print(f"status: {payload['status']}")
        print(f"receipt: {path}")
        for item in payload["fixtures"]:
            print(f"- {item['fixture']}: {'pass' if item.get('passed') else 'fail'}")
    return 0 if payload["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
