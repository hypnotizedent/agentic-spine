#!/usr/bin/env python3
"""Build the generated service endpoint catalog from topology closure truth."""

from __future__ import annotations

import argparse
import hashlib
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

SCRIPT_PATH = Path(__file__).resolve()
DEFAULT_ROOT = SCRIPT_PATH.parents[4]


def _canonicalize_repoish(raw: str) -> Path:
    expanded = Path(raw).expanduser()
    try:
        result = subprocess.run(
            ["git", "-C", str(expanded), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
        return Path(result.stdout.strip()).resolve()
    except subprocess.CalledProcessError:
        if expanded.exists():
            return expanded.resolve()
        return expanded


def _resolve_root(explicit_root: str | None) -> Path:
    if explicit_root:
        return _canonicalize_repoish(explicit_root)

    explicit_target = os.environ.get("SPINE_TARGET_REPO")
    if explicit_target:
        candidate = _canonicalize_repoish(explicit_target)
        if (candidate / "ops/bindings/topology.closure.graph.yaml").exists():
            return candidate

    try:
        result = subprocess.run(
            ["git", "-C", str(Path.cwd()), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
        candidate = Path(result.stdout.strip()).resolve()
        if (candidate / "ops/bindings/topology.closure.graph.yaml").exists():
            return candidate
    except subprocess.CalledProcessError:
        pass

    for key in ("SPINE_REPO", "SPINE_ROOT", "SPINE_CODE"):
        value = os.environ.get(key)
        if value:
            candidate = _canonicalize_repoish(value)
            if (candidate / "ops/bindings/topology.closure.graph.yaml").exists():
                return candidate

    return DEFAULT_ROOT


def _load_yaml(path: Path) -> dict[str, Any]:
    if not path.exists():
        raise FileNotFoundError(f"missing required input: {path}")
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def _base_url(protocol: str, address: str, port: int | str) -> str:
    return f"{protocol}://{address}:{port}"


def _health_url(base_url: str, health_path: str) -> str:
    return f"{base_url}{health_path}"


def _resolve_operator_transport(target_row: dict[str, Any], endpoint_row: dict[str, Any]) -> str:
    address_source = str(endpoint_row.get("address_source") or "").strip()
    access_policy = str(target_row.get("access_policy") or "").strip()
    if address_source == "tailscale_ip":
        return "tailscale"
    if access_policy == "tailscale_required" and target_row.get("tailscale_ip"):
        return "tailscale"
    if target_row.get("tailscale_ip"):
        return "tailscale"
    return "lan"


def _sha256_for_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _build_catalog(graph: dict[str, Any], ssh_targets: dict[str, Any]) -> dict[str, Any]:
    target_rows = {
        str(row.get("id") or "").strip(): row
        for row in ssh_targets.get("ssh", {}).get("targets", [])
        if isinstance(row, dict) and str(row.get("id") or "").strip()
    }
    services: dict[str, Any] = {}

    service_endpoints = graph.get("service_endpoints") or {}
    for service_id, raw_endpoint in service_endpoints.items():
        endpoint = raw_endpoint or {}
        host_ref = str(endpoint.get("host_ref") or "").strip()
        target_row = target_rows.get(host_ref, {})
        protocol = str(endpoint.get("protocol") or "http").strip()
        port = endpoint.get("port")
        health_path = str(endpoint.get("health_path") or "").strip()
        public_url = str(endpoint.get("public_url") or "").strip()
        lan_host = str(target_row.get("host") or "").strip()
        tailscale_host = str(target_row.get("tailscale_ip") or "").strip()
        preferred_transport = _resolve_operator_transport(target_row, endpoint)

        endpoints: dict[str, Any] = {}
        if lan_host and port is not None:
            lan_base = _base_url(protocol, lan_host, port)
            endpoints["lan_base_url"] = lan_base
            if health_path:
                endpoints["lan_health_url"] = _health_url(lan_base, health_path)
        if tailscale_host and port is not None:
            tailscale_base = _base_url(protocol, tailscale_host, port)
            endpoints["tailscale_base_url"] = tailscale_base
            if health_path:
                endpoints["tailscale_health_url"] = _health_url(tailscale_base, health_path)
        if public_url:
            endpoints["public_base_url"] = public_url
            if health_path:
                endpoints["public_health_url"] = _health_url(public_url.rstrip("/"), health_path)

        operator_base_key = f"{preferred_transport}_base_url"
        operator_health_key = f"{preferred_transport}_health_url"
        if endpoints.get(operator_base_key):
            endpoints["operator_base_url"] = endpoints[operator_base_key]
        if endpoints.get(operator_health_key):
            endpoints["operator_health_url"] = endpoints[operator_health_key]
        if endpoints.get("operator_base_url"):
            endpoints["agent_base_url"] = endpoints["operator_base_url"]
        if endpoints.get("operator_health_url"):
            endpoints["agent_health_url"] = endpoints["operator_health_url"]

        services[str(service_id)] = {
            "host_ref": host_ref,
            "protocol": protocol,
            "port": port,
            "health_path": health_path,
            "health_expect": endpoint.get("health_expect", 200),
            "preferred_transport": preferred_transport,
            "address_source": str(endpoint.get("address_source") or "").strip() or None,
            "transport_identities": {
                "lan_host": lan_host or None,
                "tailscale_host": tailscale_host or None,
            },
            "endpoints": {key: value for key, value in endpoints.items() if value},
        }

    return {
        "status": "generated",
        "owner": "@ronny",
        "last_verified": str(graph.get("updated_at") or ""),
        "scope": "service-endpoint-catalog",
        "projection_of": "ops/bindings/topology.closure.graph.yaml",
        "generated_by": "ops/plugins/infra/bin/service-endpoint-catalog-build",
        "generated_from": [
            "ops/bindings/topology.closure.graph.yaml",
            "ops/bindings/ssh.targets.yaml",
        ],
        "services": services,
    }


def _dump_yaml(payload: dict[str, Any]) -> str:
    return yaml.safe_dump(payload, sort_keys=False, allow_unicode=False)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    root = _resolve_root(args.root)
    graph_path = Path(os.environ.get("SPINE_ENDPOINT_GRAPH", root / "ops/bindings/topology.closure.graph.yaml"))
    ssh_targets_path = Path(os.environ.get("SPINE_SSH_TARGETS", root / "ops/bindings/ssh.targets.yaml"))
    output_path = Path(
        os.environ.get(
            "SPINE_SERVICE_ENDPOINT_CATALOG_OUTPUT",
            root / "ops/bindings/service.endpoint.catalog.yaml",
        )
    )

    graph = _load_yaml(graph_path)
    ssh_targets = _load_yaml(ssh_targets_path)
    payload = _build_catalog(graph, ssh_targets)
    payload["source_sha256"] = _sha256_for_file(graph_path)
    rendered = _dump_yaml(payload)

    if args.check:
        existing = output_path.read_text(encoding="utf-8") if output_path.exists() else ""
        if existing == rendered:
            print("service.endpoint.catalog.build VERIFY PASS")
            return 0
        print(
            "service.endpoint.catalog.build VERIFY FAIL: projection drift "
            f"({output_path})",
            file=sys.stderr,
        )
        return 1

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(rendered, encoding="utf-8")
    print("service.endpoint.catalog.build")
    print(f"projected: {output_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
