#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[4]
REGISTRY = ROOT / "ops/bindings/scheduled.task.registry.yaml"


def load_yaml(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    return data if isinstance(data, dict) else {}


def count_source(import_row: dict[str, Any], registry: dict[str, Any]) -> tuple[int, str]:
    source = str(import_row.get("source_path") or "")
    selector = str(import_row.get("source_selector") or "")
    if source.startswith("appliance:"):
        if selector == "read_only_discovered":
            discovery = registry.get("dsm_read_only_discovery") if isinstance(registry.get("dsm_read_only_discovery"), dict) else {}
            rows = discovery.get("discovered_tasks") if isinstance(discovery.get("discovered_tasks"), list) else []
            return len(rows), "read_only_discovered"
        return 0, "discovery_pending"
    path = ROOT / source
    if not path.exists():
        return 0, "missing_source"
    doc = load_yaml(path)
    if selector == "labels[*]":
        rows = doc.get("labels") if isinstance(doc.get("labels"), list) else []
        return len(rows), "ok"
    if selector == "jobs[*]":
        rows = doc.get("jobs") if isinstance(doc.get("jobs"), list) else []
        return len(rows), "ok"
    if selector == "scheduler":
        return (1 if doc.get("scheduler") else 0), "ok"
    return 0, "unknown_selector"


def jsonable(value: Any) -> Any:
    if isinstance(value, dict):
        return {str(key): jsonable(item) for key, item in value.items()}
    if isinstance(value, list):
        return [jsonable(item) for item in value]
    if isinstance(value, (str, int, float, bool)) or value is None:
        return value
    return str(value)


def normalized_hash(doc: Any) -> str:
    payload = json.dumps(jsonable(doc), sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def launchd_roundtrip(registry: dict[str, Any]) -> dict[str, Any]:
    imports = registry.get("source_imports") if isinstance(registry.get("source_imports"), list) else []
    source_row = next(
        (
            row
            for row in imports
            if isinstance(row, dict)
            and row.get("import_id") == "launchd_scheduler_registry"
            and row.get("source_selector") == "labels[*]"
        ),
        None,
    )
    if not source_row:
        return {
            "status": "fail",
            "reason": "launchd_scheduler_registry import missing from scheduled.task.registry.yaml",
        }

    source_path = ROOT / str(source_row.get("source_path") or "")
    if not source_path.exists():
        return {
            "status": "fail",
            "reason": f"source missing: {source_path}",
            "source_path": str(source_path),
        }

    source = load_yaml(source_path)
    projected = {
        "status": source.get("status"),
        "owner": source.get("owner"),
        "last_verified": source.get("last_verified"),
        "scope": source.get("scope"),
        "updated_at": source.get("updated_at"),
        "schedule_timezone": source.get("schedule_timezone"),
        "subordinate_to": source.get("subordinate_to"),
        "paths": source.get("paths"),
        "labels": source.get("labels") if isinstance(source.get("labels"), list) else [],
    }
    actual = {
        "status": source.get("status"),
        "owner": source.get("owner"),
        "last_verified": source.get("last_verified"),
        "scope": source.get("scope"),
        "updated_at": source.get("updated_at"),
        "schedule_timezone": source.get("schedule_timezone"),
        "subordinate_to": source.get("subordinate_to"),
        "paths": source.get("paths"),
        "labels": source.get("labels") if isinstance(source.get("labels"), list) else [],
    }
    projected_hash = normalized_hash(projected)
    actual_hash = normalized_hash(actual)
    projected_labels = [row.get("label") for row in projected["labels"] if isinstance(row, dict)]
    actual_labels = [row.get("label") for row in actual["labels"] if isinstance(row, dict)]
    missing_from_projection = sorted(set(actual_labels) - set(projected_labels))
    extra_in_projection = sorted(set(projected_labels) - set(actual_labels))
    return {
        "status": "pass" if projected_hash == actual_hash and not missing_from_projection and not extra_in_projection else "fail",
        "source_path": str(source_path),
        "projection_mode": "compatibility_import_roundtrip",
        "target_path": "ops/bindings/launchd.scheduler.registry.yaml",
        "label_count": len(projected_labels),
        "projected_hash": projected_hash,
        "actual_hash": actual_hash,
        "missing_from_projection": missing_from_projection,
        "extra_in_projection": extra_in_projection,
        "hot_gates_remain_on": (registry.get("authority_model") or {}).get("current_hot_gates_remain_on")
        if isinstance(registry.get("authority_model"), dict)
        else None,
        "subtraction_allowed": (registry.get("migration_stage") or {}).get("subtraction_allowed_in_this_slice")
        if isinstance(registry.get("migration_stage"), dict)
        else None,
    }


def build_status() -> dict[str, Any]:
    if not REGISTRY.exists():
        return {
            "status": "fail",
            "registry": str(REGISTRY),
            "error": "scheduled.task.registry.yaml missing",
            "imports": [],
        }
    registry = load_yaml(REGISTRY)
    imports = registry.get("source_imports") if isinstance(registry.get("source_imports"), list) else []
    rows: list[dict[str, Any]] = []
    failures: list[str] = []
    for row in imports:
        if not isinstance(row, dict):
            continue
        actual, state = count_source(row, registry)
        expected_raw = (
            row.get("discovered_count")
            if row.get("discovered_count") is not None
            else row.get("imported_count_at_birth")
        )
        expected = int(expected_raw or 0)
        ok = actual == expected and state in {"ok", "discovery_pending", "read_only_discovered"}
        if not ok:
            failures.append(f"{row.get('import_id')}: expected={expected} actual={actual} state={state}")
        rows.append(
            {
                "import_id": row.get("import_id"),
                "plane": row.get("plane"),
                "source_path": row.get("source_path"),
                "expected_count": expected,
                "actual_count": actual,
                "state": state,
                "parity": "pass" if ok else "fail",
                "governance_level": row.get("governance_level"),
                "final_disposition": row.get("final_disposition"),
            }
        )
    return {
        "status": "pass" if not failures else "fail",
        "registry": str(REGISTRY),
        "registry_status": registry.get("status"),
        "phase": (registry.get("migration_stage") or {}).get("phase") if isinstance(registry.get("migration_stage"), dict) else None,
        "imports": rows,
        "placement_authority_boundary": registry.get("placement_authority_boundary") or {},
        "residue_demotions": registry.get("residue_demotions") or [],
        "subtraction_checklist": registry.get("subtraction_checklist") or [],
        "failure_count": len(failures),
        "failures": failures,
        "live_scheduler_mutation_allowed": (registry.get("migration_stage") or {}).get("live_scheduler_mutation_allowed")
        if isinstance(registry.get("migration_stage"), dict)
        else None,
        "subtraction_allowed_in_this_slice": (registry.get("migration_stage") or {}).get("subtraction_allowed_in_this_slice")
        if isinstance(registry.get("migration_stage"), dict)
        else None,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only cross-plane scheduled task registry birth/parity status.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--launchd-roundtrip", action="store_true", help="Prove the hot launchd scheduler registry can round-trip through the parent registry import.")
    args = parser.parse_args()
    status = build_status()
    if args.launchd_roundtrip:
        registry = load_yaml(REGISTRY) if REGISTRY.exists() else {}
        status["launchd_roundtrip"] = launchd_roundtrip(registry)
        if status["launchd_roundtrip"].get("status") != "pass":
            status["status"] = "fail"
            status["failure_count"] = int(status.get("failure_count") or 0) + 1
            failures = status.setdefault("failures", [])
            if isinstance(failures, list):
                failures.append("launchd scheduler roundtrip parity failed")
    if args.json:
        print(json.dumps(status, indent=2, sort_keys=True))
    else:
        print("scheduled.task.registry.status")
        print(f"registry: {status['registry']}")
        print(f"status: {status['status']}")
        print(f"phase: {status.get('phase')}")
        print(f"registry_status: {status.get('registry_status')}")
        print(f"live_scheduler_mutation_allowed: {status.get('live_scheduler_mutation_allowed')}")
        print(f"subtraction_allowed_in_this_slice: {status.get('subtraction_allowed_in_this_slice')}")
        for row in status["imports"]:
            print(
                f"- {row['import_id']}: parity={row['parity']} plane={row['plane']} "
                f"count={row['actual_count']}/{row['expected_count']} state={row['state']}"
            )
        demotions = status.get("residue_demotions") if isinstance(status.get("residue_demotions"), list) else []
        if demotions:
            print("residue_demotions:")
            for row in demotions:
                if isinstance(row, dict):
                    print(f"- {row.get('ref')}: {row.get('demoted_from')} -> {row.get('demoted_to')}; runtime_change={row.get('live_runtime_change')}")
        checklist = status.get("subtraction_checklist") if isinstance(status.get("subtraction_checklist"), list) else []
        if checklist:
            print("subtraction_checklist:")
            for row in checklist:
                if isinstance(row, dict):
                    print(f"- {row.get('id')}: {row.get('status')} -> {row.get('target_state')}")
        if args.launchd_roundtrip:
            rt = status.get("launchd_roundtrip") if isinstance(status.get("launchd_roundtrip"), dict) else {}
            print(
                "launchd_roundtrip: "
                f"status={rt.get('status')} mode={rt.get('projection_mode')} "
                f"labels={rt.get('label_count')} projected_hash={rt.get('projected_hash')} actual_hash={rt.get('actual_hash')}"
            )
        for failure in status["failures"]:
            print(f"FAIL: {failure}")
    return 0 if status["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
