def load_yaml(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    return data if isinstance(data, dict) else {}


# PACKET-1115: load site.profile.contract.yaml and emit a top-level
# site_profiles block plus per-row profile_ref. Profiles are NOT embedded
# per-row; profile_ref is a foreign-key string into site_profiles.
def load_site_profiles() -> dict[str, dict[str, Any]]:
    """Return mapping of site_id -> profile dict from site.profile.contract.yaml.

    Returns an empty dict if the contract is missing — D448 enforces presence,
    so consumers downstream do not need to defend against this case in normal
    operation; the empty dict keeps the cap tolerant during the contract's
    own creation slice.
    """
    path = PATHS["site_profile"]
    if not path.exists():
        return {}
    doc = load_yaml(path)
    profiles: dict[str, dict[str, Any]] = {}
    for entry in (doc.get("sites") or []):
        if not isinstance(entry, dict):
            continue
        sid = entry.get("site_id")
        if isinstance(sid, str) and sid:
            profiles[sid] = entry
    return profiles


def resolve_profile_ref(row_site: str, profiles: dict[str, dict[str, Any]]) -> str:
    """Map a presence row's site label to a profile_ref foreign-key.

    Returns the contract's site_id when one matches; falls back to the
    sentinel "unknown" only when no profile matches AND the contract carries
    an "unknown" sentinel row. D448 (assertion l) enforces that profile_ref
    "unknown" appears ONLY when row.site == "unknown".
    """
    site = (row_site or "").strip()
    if site in profiles:
        return site
    if "unknown" in profiles:
        return "unknown"
    return ""


def run_node_admission() -> dict[str, Any]:
    proc = subprocess.run([str(NODE_ADMISSION), "--json"], text=True, capture_output=True)
    if proc.returncode != 0:
        raise SystemExit(proc.stderr.strip() or proc.stdout.strip() or "node.admission.status failed")
    return json.loads(proc.stdout)


def run_payload_custody() -> dict[str, Any]:
    proc = subprocess.run([str(PAYLOAD_CUSTODY), "--json"], text=True, capture_output=True)
    if proc.returncode != 0:
        raise SystemExit(proc.stderr.strip() or proc.stdout.strip() or "payload.custody.status failed")
    return json.loads(proc.stdout)


def run_backup_estate() -> dict[str, Any]:
    proc = subprocess.run([str(BACKUP_ESTATE), "--json"], text=True, capture_output=True)
    if proc.returncode != 0:
        raise SystemExit(proc.stderr.strip() or proc.stdout.strip() or "backup.estate.readback.status failed")
    return json.loads(proc.stdout)


def norm(value: Any) -> str:
    return str(value or "").strip().lower()


def ip_site(ip: str, sites: list[dict[str, Any]]) -> str:
    if not ip:
        return "unknown"
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return "unknown"
    for site in sites:
        cidr = site.get("lan_cidr")
        if not cidr:
            continue
        try:
            if addr in ipaddress.ip_network(str(cidr), strict=False):
                return str(site.get("id") or "unknown")
        except ValueError:
            continue
    return "unknown"


def key_set(*values: Any) -> set[str]:
    keys: set[str] = set()
    for value in values:
        if isinstance(value, list):
            keys.update(norm(item) for item in value if norm(item))
        elif norm(value):
            keys.add(norm(value))
    return keys


def item_keys(item: dict[str, Any] | None) -> set[str]:
    if not isinstance(item, dict):
        return set()
    identifiers = item.get("durable_identifiers") or {}
    access = item.get("access_path") or {}
    physical = item.get("physical_identity") or {}
    return key_set(
        item.get("id"),
        item.get("node_id"),
        item.get("name"),
        item.get("hostname"),
        item.get("host"),
        item.get("ip"),
        item.get("tailscale_ip"),
        item.get("mac"),
        identifiers.get("machine_id"),
        identifiers.get("device_id"),
        identifiers.get("appliance_id"),
        identifiers.get("hostname"),
        identifiers.get("ssh_target_id"),
        identifiers.get("lan_ip"),
        identifiers.get("tailscale_ip"),
        physical.get("declared_hostname"),
        physical.get("serial"),
        access.get("host"),
        access.get("lan_ip"),
        access.get("tailscale_ip"),
    )


def ip_like(value: Any) -> str:
    text = str(value or "").strip()
    if not text:
        return ""
    try:
        ipaddress.ip_address(text)
    except ValueError:
        return ""
    return text


def freshness_from_surface(surface: dict[str, Any], field: str = "generated_at") -> dict[str, Any]:
    # PACKET-1317: surfaces declare freshness_policy.max_age_hours; resolve
    # actual fresh/stale state from generated_at vs that policy instead of
    # hardcoding stale. Honesty rule: only stamp "stale" when the snapshot is
    # past its declared max age; missing policy/timestamp falls back to
    # "policy_missing" — never silently stale.
    policy = surface.get("freshness_policy") or {}
    policy_field = str(policy.get("freshness_field") or field)
    max_age_hours = policy.get("max_age_hours")
    value = (
        surface.get(policy_field)
        or surface.get(field)
        or surface.get("updated_at")
        or surface.get("last_verified")
    )
    state = "policy_missing"
    if max_age_hours and value:
        try:
            ts = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
            now = datetime.now(UTC)
            if ts.tzinfo is None:
                ts = ts.replace(tzinfo=UTC)
            age_hours = (now - ts).total_seconds() / 3600.0
            state = "stale" if age_hours > float(max_age_hours) else "fresh"
        except (TypeError, ValueError):
            state = "policy_missing"
    return {
        "state": state,
        "basis": "freshness_policy_resolved" if state in {"fresh", "stale"} else "legacy_surface_timestamp",
        "max_age": f"{max_age_hours}h" if max_age_hours else None,
        "last_observed_at": value,
    }


def subject_kind(admission: dict[str, Any] | None, declared: dict[str, Any] | None, observed: dict[str, Any] | None) -> str:
    if admission:
        return "admitted_node" if admission.get("admission_state") == "admitted" else "candidate_node"
    if declared:
        category = declared.get("category")
        if category == "infrastructure":
            return "declared_device"
        if category:
            return f"{category}_device"
        return "declared_device"
    if observed:
        return "unknown_observed"
    return "unknown"


def build_indexes(rows: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    index: dict[str, dict[str, Any]] = {}
    for row in rows:
        identifiers = row.get("durable_identifiers") or {}
        access = row.get("access_path") or {}
        keys = key_set(
            row.get("node_id"),
            identifiers.get("machine_id"),
            identifiers.get("device_id"),
            identifiers.get("appliance_id"),
            identifiers.get("hostname"),
            identifiers.get("ssh_target_id"),
            identifiers.get("lan_ip"),
            identifiers.get("tailscale_ip"),
            access.get("host"),
            access.get("lan_ip"),
            access.get("tailscale_ip"),
        )
        for key in keys:
            index.setdefault(key, row)
    return index


def find_match(item: dict[str, Any], index: dict[str, dict[str, Any]]) -> dict[str, Any] | None:
    for key in item_keys(item):
        if key in index:
            return index[key]
    return None


def load_ssh_targets() -> list[dict[str, Any]]:
    doc = load_yaml(PATHS["ssh_targets"])
    rows = ((doc.get("ssh") or {}).get("targets") or [])
    return [row for row in rows if isinstance(row, dict)]


def build_ssh_index(rows: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    index: dict[str, dict[str, Any]] = {}
    for row in rows:
        for key in key_set(row.get("id"), row.get("host"), row.get("tailscale_ip"), row.get("aliases")):
            index.setdefault(key, row)
    return index


def enum_token(value: Any, default: str = "unknown") -> str:
    text = norm(value).replace("-", "_").replace(" ", "_")
    text = "".join(ch if ch.isalnum() or ch == "_" else "_" for ch in text)
    return text.strip("_") or default


def identity_state(admission: dict[str, Any] | None, declared: dict[str, Any] | None, ssh_target: dict[str, Any] | None) -> str:
    if admission:
        state = str(admission.get("admission_state") or "")
        if state == "admitted":
            return "admitted"
        if state == "excluded":
            return "excluded"
        return "candidate"
    if ssh_target:
        return "ssh_target"
    if declared:
        return "declared"
    return "unknown"


def hardware_class(admission: dict[str, Any] | None) -> str:
    if not admission:
        return "unknown"
    physical = admission.get("physical_identity") or {}
    return enum_token(admission.get("object_kind") or physical.get("object_kind"))


def bootstrap_state(admission: dict[str, Any] | None) -> str:
    if not admission:
        return "unknown"
    boot = admission.get("boot_identity") or {}
    claim = str(boot.get("claim_state") or "")
    lifecycle = str(admission.get("lifecycle_state") or "")
    first_touch = str(admission.get("first_touch_state") or "")
    if claim.startswith("admitted_stable") or lifecycle == "admitted_runtime_present":
        return "bootstrapped"
    if first_touch in {"FT-SSH", "FT-BMC", "appliance-readback"}:
        return "first_touch_claimed"
    if first_touch == "none":
        return "unprovisioned"
    return enum_token(first_touch)


def network_visibility_proof(declared: dict[str, Any] | None, observed: dict[str, Any] | None, freshness: dict[str, Any]) -> str:
    if observed:
        return "unifi_snapshot_stale" if freshness.get("state") == "stale" else "udr_observed"
    if declared:
        return "declared_only"
    return "none"


def build_storage_index(rows: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
    index: dict[str, list[dict[str, Any]]] = {}
    for row in rows:
        surface_ref = row.get("surface_ref") or {}
        keys = key_set(
            row.get("owner_node_id"),
            surface_ref.get("device"),
            (str(row.get("presence_proof_ref") or "").split(":", 1)[1:] or [""])[0],
        )
        for key in keys:
            index.setdefault(key, []).append(row)
    return index


def storage_score(row: dict[str, Any]) -> tuple[int, str]:
    canonicality = str(row.get("canonicality") or "")
    state = str(row.get("custody_state") or "")
    canonicality_score = {
        "canonical": 6,
        "secondary": 5,
        "mixed": 4,
        "noncanonical": 3,
        "unknown": 2,
        "drained": 1,
    }.get(canonicality, 0)
    state_score = 2 if state == "canonical_live" else 1 if state in {"declared_secondary_copy", "controlled_stage"} else 0
    return (canonicality_score + state_score, str(row.get("custody_id") or ""))


def find_storage_match(
    index: dict[str, list[dict[str, Any]]],
    *items: dict[str, Any] | None,
) -> dict[str, Any] | None:
    matches: dict[str, dict[str, Any]] = {}
    for item in items:
        for key in item_keys(item):
            for row in index.get(key, []):
                matches[str(row.get("custody_id") or id(row))] = row
    if not matches:
        return None
    return max(matches.values(), key=storage_score)


def build_backup_index(rows: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    index: dict[str, dict[str, Any]] = {}
    for row in rows:
        keys = key_set(row.get("name"), row.get("backup_target"), row.get("vmid"))
        for key in keys:
            index.setdefault(key, row)
    return index


def find_backup_match(index: dict[str, dict[str, Any]], *items: dict[str, Any] | None) -> dict[str, Any] | None:
    for item in items:
        for key in item_keys(item):
            if key in index:
                return index[key]
    return None


def make_row(
    site: str,
    sites: list[dict[str, Any]],
    admission: dict[str, Any] | None,
    declared: dict[str, Any] | None,
    observed: dict[str, Any] | None,
    ssh_target: dict[str, Any] | None,
    storage_row: dict[str, Any] | None,
    backup_row: dict[str, Any] | None,
    source_roles: list[dict[str, str]],
    freshness: dict[str, Any],
) -> dict[str, Any]:
    declared_id = (declared or {}).get("id")
    observed_id = (observed or {}).get("id")
    subject_id = (admission or {}).get("node_id") or declared_id or observed_id or "unknown"
    declared_ip = (declared or {}).get("ip")
    observed_ip = (observed or {}).get("ip")
    admission_access = (admission or {}).get("access_path") or {}
    admission_identifiers = (admission or {}).get("durable_identifiers") or {}
    admission_host_ip = ip_like(admission_access.get("host"))
    ip = observed_ip or declared_ip or admission_access.get("lan_ip") or admission_host_ip
    if site == "unknown":
        site = ip_site(str(ip or ""), sites)
    site_row = next((row for row in sites if row.get("id") == site), {})
    declared_present = declared is not None or admission is not None
    observed_present = observed is not None
    if admission and observed_present:
        presence_state = "present"
        match_state = "admitted_node_matched"
    elif declared_present and observed_present:
        presence_state = "present"
        match_state = "declared_and_observed"
    elif declared_present:
        presence_state = "declared_only"
        match_state = "declared_only"
    elif observed_present:
        presence_state = "observed_only"
        match_state = "observed_only_unknown_identity"
    else:
        presence_state = "unknown"
        match_state = "unknown"

    lifecycle = "active"
    if (declared or {}).get("status") in {"decommissioned", "retired"}:
        lifecycle = str((declared or {}).get("status"))
        presence_state = lifecycle
    elif not observed_present and declared_present:
        lifecycle = "declared"
    elif observed_present and not declared_present:
        lifecycle = "observed_only"

    proof_channels = []
    for role in source_roles:
        channel = role.get("role", "evidence")
        proof_channels.append(
            {
                "channel": channel,
                "capability": role.get("capability"),
                "surface": role.get("path"),
                "proof_ref": role.get("proof_ref"),
                "observed_at": role.get("observed_at"),
                "freshness_state": freshness.get("state", "unknown"),
            }
        )

    return {
        "presence_id": f"site:{site}:{subject_id}",
        "site": site,
        "network_scope": {
            "scope_id": f"{site}-lan" if site != "unknown" else "unknown",
            "cidr": site_row.get("lan_cidr"),
            "attachment_kind": "lan" if ip_site(str(ip or ""), sites) == site else "declared",
        },
        "subject": {
            "subject_id": subject_id,
            "subject_kind": subject_kind(admission, declared, observed),
            "node_admission_state": (admission or {}).get("admission_state", "not_node"),
            "lifecycle_state": lifecycle,
        },
        "identity": {
            "declared_id": declared_id,
            "observed_id": observed_id,
            "hostname": (observed or {}).get("hostname")
            or (declared or {}).get("name")
            or admission_identifiers.get("hostname")
            or subject_id,
            "aliases": admission_identifiers.get("aliases", []),
            "mac": (observed or {}).get("mac") or (declared or {}).get("mac"),
            "ip": ip,
            "tailscale_ip": (declared or {}).get("tailscale_ip")
            or admission_access.get("tailscale_ip")
            or admission_identifiers.get("tailscale_ip"),
        },
        "network_visibility_proof": network_visibility_proof(declared, observed, freshness),
        "identity_state": identity_state(admission, declared, ssh_target),
        "hardware_class": hardware_class(admission),
        "bootstrap_state": bootstrap_state(admission),
        "storage_tier": (storage_row or {}).get("payload_class", "unknown"),
        "storage_scaffold_class": (storage_row or {}).get("scaffold_class", "unknown"),
        "storage_custody_state": (storage_row or {}).get("custody_state", "unknown"),
        "storage_evidence_ref": (storage_row or {}).get("custody_id", ""),
        "backup_posture": (backup_row or {}).get("status", "unknown"),
        "presence_state": presence_state,
        "match_state": match_state,
        "proof_channels": proof_channels,
        "freshness": freshness,
        "source_surfaces": [{"path": role.get("path"), "role": role.get("role")} for role in source_roles],
        "actions_allowed": {
            "may_inform_operator": True,
            "may_create_node": False,
            "may_admit_node": False,
            "may_bootstrap_subject": False,
            "may_provision_subject": False,
            "may_mutate_network": False,
            "may_refresh_legacy_snapshot": False,
        },
        "subtraction_caption": (
            "legacy network/device registries are folded source inputs inside first-class Site Intelligence; "
            "site.presence.status is the public readback, and node.admission.status owns admission/bootstrap/provisioning truth."
        ),
    }


def build_rows(site_filter: str | None) -> list[dict[str, Any]]:
    topology = load_yaml(PATHS["topology_sites"])
    sites = [row for row in topology.get("sites", []) if isinstance(row, dict)]
    home_device = load_yaml(PATHS["home_device"])
    unifi_home = load_yaml(PATHS["unifi_home"])
    unifi_shop = load_yaml(PATHS["unifi_shop"])
    node_admission = run_node_admission()
    payload_custody = run_payload_custody()
    backup_estate = run_backup_estate()
    admission_rows = [row for row in node_admission.get("rows", []) if isinstance(row, dict)]
    admission_index = build_indexes(admission_rows)
    ssh_index = build_ssh_index(load_ssh_targets())
    storage_index = build_storage_index([row for row in payload_custody.get("rows", []) if isinstance(row, dict)])
    backup_index = build_backup_index([row for row in backup_estate.get("subjects", []) if isinstance(row, dict)])

    declared_rows = [row for row in home_device.get("devices", []) if isinstance(row, dict)]
    observed_sources = [
        (unifi_home, PATHS["unifi_home"], "network.home.unifi.clients.snapshot"),
        (unifi_shop, PATHS["unifi_shop"], "network.unifi.clients.snapshot"),
    ]
    rows: list[dict[str, Any]] = []
    used_observed: set[tuple[str, str]] = set()

    for declared in declared_rows:
        observed_match = None
        observed_path = None
        observed_cap = None
        for surface, path, capability in observed_sources:
            for observed in surface.get("devices", []) or []:
                if not isinstance(observed, dict):
                    continue
                if key_set(declared.get("id"), declared.get("ip"), declared.get("mac")) & key_set(
                    observed.get("id"), observed.get("ip"), observed.get("mac")
                ):
                    observed_match = observed
                    observed_path = path
                    observed_cap = capability
                    used_observed.add((str(path), str(observed.get("id"))))
                    break
            if observed_match:
                break
        admission = find_match(declared, admission_index)
        site = str(declared.get("site") or (admission or {}).get("site") or "home")
        if site_filter and site != site_filter:
            continue
        source_roles = [
            {"path": str(PATHS["home_device"].relative_to(ROOT)), "role": "folded_declared_device_input", "proof_ref": "updated_at"},
        ]
        freshness = {
            "state": "declared_only",
            "basis": "declared_surface",
            "max_age": "168h",
            "last_observed_at": home_device.get("updated_at"),
        }
        if observed_match and observed_path:
            surface = unifi_home if observed_path == PATHS["unifi_home"] else unifi_shop
            source_roles.append(
                {
                    "path": str(observed_path.relative_to(ROOT)),
                    "role": "folded_unifi_observation_input",
                    "capability": observed_cap,
                    "proof_ref": "generated_at",
                    "observed_at": surface.get("generated_at"),
                }
            )
            freshness = freshness_from_surface(surface)
        if admission:
            source_roles.append({"path": "node.admission.status", "role": "node_admission", "proof_ref": "capability"})
        ssh_target = find_match(admission, ssh_index) if admission else find_match(declared, ssh_index)
        storage_row = find_storage_match(storage_index, admission, declared, observed_match)
        backup_row = find_backup_match(backup_index, admission, declared, observed_match)
        if ssh_target:
            source_roles.append({"path": str(PATHS["ssh_targets"].relative_to(ROOT)), "role": "ssh_access_projection", "proof_ref": "binding"})
        if storage_row:
            source_roles.append({"path": "payload.custody.status", "role": "payload_custody", "proof_ref": "capability"})
        if backup_row:
            source_roles.append({"path": "backup.estate.readback.status", "role": "backup_estate", "proof_ref": "capability"})
        rows.append(make_row(site, sites, admission, declared, observed_match, ssh_target, storage_row, backup_row, source_roles, freshness))

    for surface, path, capability in observed_sources:
        for observed in surface.get("devices", []) or []:
            if not isinstance(observed, dict):
                continue
            marker = (str(path), str(observed.get("id")))
            if marker in used_observed:
                continue
            admission = find_match(observed, admission_index)
            site = str(observed.get("site") or (admission or {}).get("site") or "unknown")
            if site_filter and site != site_filter:
                continue
            ssh_target = find_match(admission, ssh_index) if admission else find_match(observed, ssh_index)
            storage_row = find_storage_match(storage_index, admission, observed)
            backup_row = find_backup_match(backup_index, admission, observed)
            source_roles = [
                {
                    "path": str(path.relative_to(ROOT)),
                    "role": "folded_unifi_observation_input",
                    "capability": capability,
                    "proof_ref": "generated_at",
                    "observed_at": surface.get("generated_at"),
                }
            ]
            if admission:
                source_roles.append({"path": "node.admission.status", "role": "node_admission", "proof_ref": "capability"})
            if ssh_target:
                source_roles.append({"path": str(PATHS["ssh_targets"].relative_to(ROOT)), "role": "ssh_access_projection", "proof_ref": "binding"})
            if storage_row:
                source_roles.append({"path": "payload.custody.status", "role": "payload_custody", "proof_ref": "capability"})
            if backup_row:
                source_roles.append({"path": "backup.estate.readback.status", "role": "backup_estate", "proof_ref": "capability"})
            rows.append(
                make_row(
                    site,
                    sites,
                    admission,
                    None,
                    observed,
                    ssh_target,
                    storage_row,
                    backup_row,
                    source_roles,
                    freshness_from_surface(surface),
                )
            )

    for admission in admission_rows:
        subject_id = admission.get("node_id")
        if any(row["subject"]["subject_id"] == subject_id for row in rows):
            continue
        site = str(admission.get("site") or "unknown")
        if site_filter and site != site_filter:
            continue
        ssh_target = find_match(admission, ssh_index)
        storage_row = find_storage_match(storage_index, admission)
        backup_row = find_backup_match(backup_index, admission)
        source_roles = [{"path": "node.admission.status", "role": "node_admission", "proof_ref": "capability"}]
        if ssh_target:
            source_roles.append({"path": str(PATHS["ssh_targets"].relative_to(ROOT)), "role": "ssh_access_projection", "proof_ref": "binding"})
        if storage_row:
            source_roles.append({"path": "payload.custody.status", "role": "payload_custody", "proof_ref": "capability"})
        if backup_row:
            source_roles.append({"path": "backup.estate.readback.status", "role": "backup_estate", "proof_ref": "capability"})
        rows.append(
            make_row(
                site,
                sites,
                admission,
                None,
                None,
                ssh_target,
                storage_row,
                backup_row,
                source_roles,
                {"state": "declared_only", "basis": "node_admission", "max_age": None, "last_observed_at": None},
            )
        )

    # PACKET-1115: enrich each row with profile_ref (foreign-key into the
    # top-level site_profiles block emitted by main()). Profiles are NOT
    # embedded per-row.
    profiles = load_site_profiles()
    for row in rows:
        row["profile_ref"] = resolve_profile_ref(row.get("site", ""), profiles)

    return rows


def summarize(rows: list[dict[str, Any]]) -> dict[str, int]:
    states = ["present", "declared_only", "observed_only", "missing", "stale", "conflict"]
    summary = {"sites": len({row.get("site") for row in rows}), **{state: 0 for state in states}}
    for row in rows:
        state = row.get("presence_state")
        if state in summary:
            summary[state] += 1
    return summary


def summarize_freshness(rows: list[dict[str, Any]]) -> dict[str, int]:
    # PACKET-1317: always emit the canonical state keys (fresh, stale,
    # policy_missing, declared_only) so downstream readers and D448 see
    # honest zero-counts after a refresh instead of disappearing keys.
    summary: dict[str, int] = {
        "fresh": 0,
        "stale": 0,
        "policy_missing": 0,
        "declared_only": 0,
    }
    for row in rows:
        state = str((row.get("freshness") or {}).get("state") or "unknown")
        summary[state] = summary.get(state, 0) + 1
    return summary


def summarize_profiles(profiles: dict[str, dict[str, Any]]) -> dict[str, Any]:
    unverified: dict[str, list[str]] = {}
    for site_id, profile in profiles.items():
        fields = [str(field) for field in (profile.get("unverified_fields") or [])]
        if fields:
            unverified[site_id] = fields
    return {
        "profile_count": len(profiles),
        "unverified_sites": sorted(unverified),
        "unverified_field_count": sum(len(fields) for fields in unverified.values()),
        "unverified_fields_by_site": unverified,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description="Canonical site presence readback")
    parser.add_argument("--site", help="Limit to a site id")
    parser.add_argument("--json", action="store_true", help="Emit JSON")
    args = parser.parse_args()

    rows = build_rows(args.site)
    # PACKET-1115: emit top-level site_profiles block sourced from
    # site.profile.contract.yaml. Profiles live ONCE here; per-row
    # profile_ref is the foreign-key into this mapping.
    site_profiles = load_site_profiles()
    payload = {
        "canonical_authority": "site.presence.status",
        "capability": "site.presence.status",
        "status": "ok",
        "generated_at": datetime.now(UTC).isoformat(),
        "rows": rows,
        "site_profiles": site_profiles,
        "summary": summarize(rows),
        "freshness_summary": summarize_freshness(rows),
        "profile_summary": summarize_profiles(site_profiles),
        "first_class_system": {
            "name": "first_class_site_intelligence",
            "public_readback": "site.presence.status",
            "admission_readback": "node.admission.status",
            "lifecycle": FIRST_CLASS_LIFECYCLE,
            "legacy_input_policy": "folded_source_inputs_not_operator_surfaces",
        },
        "folded_legacy_inputs": FOLDED_LEGACY_INPUTS,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print("site.presence.status")
    print(f"rows: {len(rows)}")
    print(f"summary: {json.dumps(payload['summary'], sort_keys=True)}")
    print(f"freshness: {json.dumps(payload['freshness_summary'], sort_keys=True)}")
    print(f"profile_gaps: {json.dumps(payload['profile_summary'], sort_keys=True)}")
    print("")
    print("First-Class Site Intelligence Lifecycle:")
    for stage in FIRST_CLASS_LIFECYCLE:
        caps = stage.get("transition_caps") or []
        suffix = f" caps={','.join(caps)}" if caps else ""
        print(f"  {stage['stage']:<14} {stage['authority']}{suffix}")
        print(f"    boundary: {stage['boundary']}")
    print("")
    print("Folded legacy inputs (not operator-facing subsystems):")
    for item in FOLDED_LEGACY_INPUTS:
        print(f"  {item['path']} -> {item['folded_into']} [{item['subtraction_state']}]")
    # PACKET-1115: human readback teaches Site Profiles before per-row presence.
    print("")
    print("Site Profiles:")
    if site_profiles:
        for sid in sorted(site_profiles.keys()):
            prof = site_profiles[sid]
            unverified = prof.get("unverified_fields") or []
            unv_note = f" unverified={','.join(unverified)}" if unverified else ""
            print(
                f"  {sid:10} role={prof.get('site_role')} "
                f"network={prof.get('network_profile')} power={prof.get('power_profile')} "
                f"priority={prof.get('operational_priority')} "
                f"origin={prof.get('topology_origin')}{unv_note}"
            )
    else:
        print("  (site.profile.contract.yaml absent — profiles not loaded)")
    print("")
    for row in rows:
        print(
            f"- {row['presence_id']} {row['presence_state']} "
            f"{row['subject']['subject_kind']} identity={row.get('identity_state')} "
            f"hardware={row.get('hardware_class')} bootstrap={row.get('bootstrap_state')} "
            f"storage={row.get('storage_custody_state')} backup={row.get('backup_posture')} "
            f"network={row.get('network_visibility_proof')} ip={row['identity'].get('ip') or ''} "
            f"profile_ref={row.get('profile_ref','')}"
        )


if __name__ == "__main__":
    main()
