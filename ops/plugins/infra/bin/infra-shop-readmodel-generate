#!/usr/bin/env bash
set -euo pipefail

# infra.shop.readmodel.generate
# Generate shop server read model from structured authority bindings.
# Sources: vm.lifecycle.yaml, ssh.targets.yaml, hardware.inventory.yaml,
#          shop.storage.map.yaml, shop.ingress.map.yaml, backup.inventory.yaml
# Output:  $SPINE_STATE/domain-state/infra.shop.readmodel.md (runtime only)

VM_LIFECYCLE="${VM_LIFECYCLE:-ops/bindings/vm.lifecycle.yaml}"
SSH_TARGETS="${SSH_TARGETS:-ops/bindings/ssh.targets.yaml}"
HARDWARE_INV="${HARDWARE_INV:-ops/bindings/hardware.inventory.yaml}"
STORAGE_MAP="${STORAGE_MAP:-ops/bindings/shop.storage.map.yaml}"
INGRESS_MAP="${INGRESS_MAP:-ops/bindings/shop.ingress.map.yaml}"
BACKUP_INV="${BACKUP_INV:-ops/bindings/domains/backup/backup.inventory.yaml}"

_need() { command -v "$1" >/dev/null 2>&1 || { echo "STOP: missing dependency: $1" >&2; exit 2; }; }
_need yq
_need date

for f in "$VM_LIFECYCLE" "$SSH_TARGETS" "$HARDWARE_INV" "$BACKUP_INV"; do
  [[ -f "$f" ]] || { echo "STOP: missing binding: $f" >&2; exit 2; }
done

SPINE_STATE="${SPINE_STATE:-$HOME/code/.runtime/spine/state}"
OUTPUT_DIR="$SPINE_STATE/domain-state"
OUTPUT_FILE="$OUTPUT_DIR/infra.shop.readmodel.md"
NOW="$(TZ=UTC date '+%Y-%m-%dT%H:%M:%SZ')"

mkdir -p "$OUTPUT_DIR"

# --- Extract shop VMs from vm.lifecycle.yaml ---
SHOP_VMS="$(yq -r '
  .vms[]
  | select(.proxmox_host == "pve")
  | [
      (.id | tostring),
      .hostname,
      (.status // "unknown"),
      (.role // "-"),
      (.lan_ip // "-"),
      (.tailscale_ip // "-"),
      (.vm_type // "vm"),
      ((.services // []) | join(", ") // "-")
    ] | @tsv
' "$VM_LIFECYCLE")"

# --- Extract shop SSH targets (LAN devices + VMs) ---
SHOP_SSH="$(yq -r '
  .ssh.targets[]
  | select(
      (.site == "shop") or
      (.host // "" | test("^192\\.168\\.1\\."))
    )
  | select(.id != null)
  | [
      .id,
      (.host // "-"),
      (.tailscale_ip // "-"),
      (.access_policy // "-"),
      (.description // "-")
    ] | @tsv
' "$SSH_TARGETS")"

# --- Extract shop hardware summary ---
SHOP_HW="$(yq -r '
  .machines[]
  | select(.site == "shop")
  | [
      .machine_id,
      .model,
      (.cpu // "-"),
      (.ram // "-"),
      (.active_vm_count // 0 | tostring),
      (.last_verified // "-")
    ] | @tsv
' "$HARDWARE_INV")"

# --- Extract shop backup targets ---
SHOP_BACKUPS="$(yq -r '
  .targets[]
  | select((.enabled // false) == true)
  | select(
      (.host == "pve") or
      (.name | test("shop|pve"))
    )
  | [
      .name,
      (.host // "-"),
      (.schedule_class // "-"),
      (.data_class // "-")
    ] | @tsv
' "$BACKUP_INV" 2>/dev/null || true)"

# --- Extract tombstone VMs ---
TOMBSTONES="$(yq -r '
  .vms[]
  | select(.proxmox_host == "pve")
  | select(.status == "tombstone" or .status == "decommissioned" or .closure_class != null)
  | [
      (.id | tostring),
      .hostname,
      (.status // "unknown"),
      (.closure_class // "-"),
      (.decommissioned_at // "-")
    ] | @tsv
' "$VM_LIFECYCLE")"

# --- Ingress summary (counts by lifecycle class) ---
if [[ -f "$INGRESS_MAP" ]]; then
  INGRESS_LIVE="$(yq '[.public_routes[] | select(.lifecycle_class == "live")] | length' "$INGRESS_MAP")"
  INGRESS_COMPAT="$(yq '[.public_routes[] | select(.lifecycle_class == "compatibility_hold")] | length' "$INGRESS_MAP")"
  INGRESS_GHOST="$(yq '[.public_routes[] | select(.lifecycle_class == "ghost")] | length' "$INGRESS_MAP")"
else
  INGRESS_LIVE="-"; INGRESS_COMPAT="-"; INGRESS_GHOST="-"
fi

# --- Storage pools summary ---
if [[ -f "$STORAGE_MAP" ]]; then
  STORAGE_POOLS="$(yq -r '
    .storage_scaffold_status[]
    | select(.authority_state == "canonical_live")
    | select(.retention_state == "active")
    | [.device, .path, .scaffold_class, .canonicality] | @tsv
  ' "$STORAGE_MAP" 2>/dev/null || true)"
else
  STORAGE_POOLS=""
fi

# --- Generate markdown ---
{
cat <<HEADER
# Shop Server Read Model (Generated)

Generated: $NOW
Sources: vm.lifecycle.yaml, ssh.targets.yaml, hardware.inventory.yaml, shop.storage.map.yaml, shop.ingress.map.yaml, backup.inventory.yaml
Regenerate: \`./bin/ops cap run infra.shop.readmodel.generate\`

---

## Shop Hardware

| Machine | Model | CPU | RAM | Active VMs | Last Verified |
|---------|-------|-----|-----|------------|---------------|
HEADER

if [[ -n "$SHOP_HW" ]]; then
  while IFS=$'\t' read -r mid model cpu ram vmcount verified; do
    echo "| \`$mid\` | $model | $cpu | $ram | $vmcount | $verified |"
  done <<< "$SHOP_HW"
fi

cat <<'HDR'

## Shop VMs (pve)

| VMID | Hostname | Type | Status | Role | LAN IP | Tailscale IP | Services |
|------|----------|------|--------|------|--------|-------------|----------|
HDR

if [[ -n "$SHOP_VMS" ]]; then
  while IFS=$'\t' read -r vmid hostname status role lan_ip ts_ip vmtype services; do
    echo "| $vmid | \`$hostname\` | $vmtype | $status | $role | $lan_ip | $ts_ip | $services |"
  done <<< "$SHOP_VMS"
fi

cat <<'HDR'

## Shop SSH Targets

| ID | Host | Tailscale IP | Access Policy | Description |
|----|------|-------------|---------------|-------------|
HDR

if [[ -n "$SHOP_SSH" ]]; then
  while IFS=$'\t' read -r id host ts_ip policy desc; do
    echo "| \`$id\` | $host | $ts_ip | $policy | $desc |"
  done <<< "$SHOP_SSH"
fi

cat <<HDR

## Ingress Summary

| Class | Count |
|-------|-------|
| Live public routes | $INGRESS_LIVE |
| Compatibility holds | $INGRESS_COMPAT |
| Ghost (DNS-only) | $INGRESS_GHOST |

HDR

if [[ -n "${STORAGE_POOLS:-}" ]]; then
cat <<'HDR'
## Storage Scaffold (Active)

| Device | Path | Class | Canonicality |
|--------|------|-------|-------------|
HDR
  while IFS=$'\t' read -r dev path sclass canon; do
    echo "| \`$dev\` | $path | $sclass | $canon |"
  done <<< "$STORAGE_POOLS"
  echo
fi

cat <<'HDR'
## Backup Targets (Shop)

| Target | Host | Schedule | Data Class |
|--------|------|----------|------------|
HDR

if [[ -n "${SHOP_BACKUPS:-}" ]]; then
  while IFS=$'\t' read -r name host sched dclass; do
    echo "| \`$name\` | $host | $sched | $dclass |"
  done <<< "$SHOP_BACKUPS"
else
  echo "| *(none enabled with shop filter)* | - | - | - |"
fi

if [[ -n "${TOMBSTONES:-}" ]]; then
cat <<'HDR'

## Tombstones

| VMID | Hostname | Status | Closure Class | Decommissioned |
|------|----------|--------|--------------|----------------|
HDR
  while IFS=$'\t' read -r vmid hostname status closure decom; do
    echo "| $vmid | \`$hostname\` | $status | $closure | $decom |"
  done <<< "$TOMBSTONES"
fi

cat <<'FOOTER'

## Authority Pointers

- **Canonical identity and network naming:** `docs/governance/DEVICE_IDENTITY_SSOT.md`
- **VM lifecycle authority:** `ops/bindings/vm.lifecycle.yaml`
- **SSH target authority:** `ops/bindings/ssh.targets.yaml`
- **Hardware inventory:** `ops/bindings/hardware.inventory.yaml`
- **Storage authority:** `ops/bindings/shop.storage.map.yaml`
- **Ingress authority:** `ops/bindings/shop.ingress.map.yaml`
- **Backup authority:** `ops/bindings/domains/backup/backup.inventory.yaml`
- **Detailed shop hardware/runbooks:** `~/code/workbench/docs/infrastructure/domains/shop/SHOP_SERVER_SSOT.md`
FOOTER

} > "$OUTPUT_FILE"

echo "Generated: $OUTPUT_FILE"
echo ""
cat "$OUTPUT_FILE"
