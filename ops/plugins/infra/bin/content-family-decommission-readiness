#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[4]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.infra.lib.content_family_decommission_readiness import (
    build_projection,
    source_paths,
    validate_projection,
)
from ops.plugins.infra.lib.content_family_placement import (
    load_yaml,
    source_sha,
    source_stamp,
)


def expand(raw: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(raw)))).resolve()


DEFAULT_ROOT = expand(ROOT)


def git_top_level(start: Path) -> Path | None:
    probe = start if start.is_dir() else start.parent
    proc = subprocess.run(
        ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    stdout = proc.stdout.strip()
    return Path(stdout).resolve() if stdout else None


def resolve_target_root(explicit: str | None = None) -> Path:
    if explicit:
        return expand(explicit)
    cwd_root = git_top_level(Path.cwd())
    if cwd_root is not None:
        return cwd_root
    script_root = git_top_level(Path(__file__).resolve())
    if script_root is not None:
        return script_root
    for env_name in ("SPINE_TARGET_REPO", "SPINE_ROOT", "SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(env_name)
        if value:
            return expand(value)
    return DEFAULT_ROOT


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="content-family-decommission-readiness")
    parser.add_argument("--root", help="Target checkout root.")
    parser.add_argument("--brief", action="store_true", help="Print one-line summary.")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when any authority error exists.")
    parser.add_argument("--format", choices=("text", "json", "yaml"), default="text")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    root = resolve_target_root(args.root)
    policy_path = Path(os.environ.get("CONTENT_FAMILY_PLACEMENT_POLICY", Path("/Users/ronnyworks/code/projects/media/bindings/content.family.placement.policy.yaml")))
    projection_path = Path(os.environ.get("CONTENT_FAMILY_DECOMMISSION_READINESS_PROJECTION", Path("/Users/ronnyworks/code/projects/media/bindings/content.family.decommission.readiness.projected.yaml")))

    policy = load_yaml(policy_path)
    projection_on_disk = load_yaml(projection_path) if projection_path.exists() else {}
    expected_projection = build_projection(
        root,
        policy,
        source_sha256=source_sha(root, source_paths(root)),
        generated_at_utc=source_stamp(root, source_paths(root)),
    )
    issues = validate_projection(policy, projection_on_disk, expected_projection)
    errors = [issue.message for issue in issues if issue.severity == "error"]
    warnings = [issue.message for issue in issues if issue.severity == "warning"]
    rows = expected_projection.get("candidate_planes") or []
    ready_count = len([row for row in rows if ensure_bool(row.get("safe_to_retire"))])
    blocked_count = len([row for row in rows if str(row.get("readiness_status") or "").strip() != "ready_to_retire"])
    status = "PASS" if not errors else "FAIL"

    operator_warnings: list[str] = []
    for raw_row in rows:
        plane_id = str(raw_row.get("plane_id") or "").strip()
        safe_to_retire = ensure_bool(raw_row.get("safe_to_retire"))
        if plane_id and not safe_to_retire:
            operator_warnings.append(f"{plane_id}: not ready to retire")

    candidate_rows = []
    for raw_row in rows:
        row = dict(raw_row)
        row["status"] = row.pop("readiness_status", "")
        candidate_rows.append(row)

    payload = {
        "capability": "content.family.decommission.readiness.status",
        "status": status,
        "issues": len(errors),
        "warnings": len(warnings) + len(operator_warnings),
        "candidate_count": len(rows),
        "ready_count": ready_count,
        "blocked_count": blocked_count,
        "candidates": candidate_rows,
        "messages": {
            "errors": errors,
            "warnings": warnings + operator_warnings,
        },
    }

    if args.brief:
        print(
            f"{status} issues={len(errors)} warnings={len(warnings) + len(operator_warnings)} "
            f"candidates={len(rows)} safe={ready_count}"
        )
    elif args.format == "json":
        print(json.dumps(payload, indent=2))
    elif args.format == "yaml":
        print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=False), end="")
    else:
        print(f"status: {status}")
        print(f"issues: {len(errors)}")
        print(f"warnings: {len(warnings) + len(operator_warnings)}")
        print(f"candidate_count: {len(rows)}")
        print(f"ready_count: {ready_count}")
        for row in candidate_rows:
            plane_id = str(row.get("plane_id") or "").strip()
            safe = "yes" if ensure_bool(row.get("safe_to_retire")) else "no"
            print(f"plane: {plane_id} safe_to_retire={safe} status={row.get('status')}")
        for item in errors:
            print(f"error: {item}")
        for item in warnings + operator_warnings:
            print(f"warning: {item}")

    if args.strict and errors:
        raise SystemExit(1)


def ensure_bool(value: object) -> bool:
    return bool(value)


if __name__ == "__main__":
    main()
