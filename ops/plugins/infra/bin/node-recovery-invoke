#!/usr/bin/env bash
set -euo pipefail

# node-recovery-invoke — First-class bounded recovery invoke surface.
#
# Refusal-first. Allowed modes are derived from node.recovery.status so machine
# control follows governed identity/network/power/console truth instead of a
# hand-maintained per-machine allowlist.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../.." && pwd)}"
STATUS_SCRIPT="$SPINE_ROOT/ops/plugins/infra/bin/node-recovery-status"
POWER_CONTROL="$SPINE_ROOT/ops/plugins/infra/bin/infra-proxmox-power-control"
HOST_CONTROL="$SPINE_ROOT/ops/plugins/infra/bin/infra-proxmox-host-control"

usage() {
  cat <<'EOF'
node-recovery-invoke — Bounded recovery invoke

Usage:
  node-recovery-invoke --node <id> --mode <mode> [--execute] [--json]
  node-recovery-invoke --node <id> --list-modes [--json]
  node-recovery-invoke --list-nodes

Options:
  --node <id>      Target node/appliance/device ID.
  --mode <mode>    Recovery mode from node.recovery.status control_modes.invoke.
  --execute        Actually perform the action (dry-run without this).
  --json           Machine-readable JSON output.
  --list-modes     Show modes currently admitted for the selected node.
  --list-nodes     Show known node IDs from node.recovery.status.

Explicit non-goals:
  - No generic identity reset
  - No generic console launch
  - No generic network repair
  - No multi-node orchestration
  - No mutation where node.recovery.status refuses safe control
EOF
}

fail() { echo "REFUSED: $*" >&2; exit 1; }

NODE_ID=""
MODE=""
EXECUTE=false
JSON_MODE=false
LIST_MODES=false
LIST_NODES=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --node) NODE_ID="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --execute) EXECUTE=true; shift ;;
    --json) JSON_MODE=true; shift ;;
    --list-modes) LIST_MODES=true; shift ;;
    --list-nodes) LIST_NODES=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *) fail "unknown argument: $1" ;;
  esac
done

[[ -x "$STATUS_SCRIPT" ]] || fail "node-recovery-status not found at $STATUS_SCRIPT"
command -v jq >/dev/null 2>&1 || fail "missing dependency: jq"

if $LIST_NODES; then
  bash "$STATUS_SCRIPT" --list
  exit 0
fi

[[ -n "$NODE_ID" ]] || { usage >&2; fail "R0: --node is required"; }

recovery_json="$(bash "$STATUS_SCRIPT" --node "$NODE_ID" --json 2>/dev/null || true)"
if [[ -z "$recovery_json" || "$recovery_json" == "null" ]]; then
  fail "R0: node.recovery.status returned no data for '$NODE_ID'"
fi

allowed_modes_json="$(jq -c '.control_modes.invoke // []' <<<"$recovery_json")"
manual_limits_json="$(jq -c '.control_modes.manual_limits // []' <<<"$recovery_json")"

if $LIST_MODES; then
  if $JSON_MODE; then
    jq -n \
      --arg node "$NODE_ID" \
      --argjson modes "$allowed_modes_json" \
      --argjson manual_limits "$manual_limits_json" \
      '{node:$node, admitted_modes:$modes, manual_limits:$manual_limits}'
  else
    echo "node.recovery.invoke — admitted modes for $NODE_ID"
    if [[ "$(jq 'length' <<<"$allowed_modes_json")" -gt 0 ]]; then
      jq -r '.[] | "  - \(.mode) [\(.capability)] — \(.description)"' <<<"$allowed_modes_json"
    else
      echo "  none"
    fi
    if [[ "$(jq 'length' <<<"$manual_limits_json")" -gt 0 ]]; then
      echo ""
      echo "manual limits:"
      jq -r '.[] | "  - \(.id): \(.description)"' <<<"$manual_limits_json"
    fi
  fi
  exit 0
fi

[[ -n "$MODE" ]] || { usage >&2; fail "R0: --mode is required"; }

mode_json="$(jq -c --arg mode "$MODE" '.control_modes.invoke[]? | select(.mode == $mode)' <<<"$recovery_json" | head -n1)"
if [[ -z "$mode_json" || "$mode_json" == "null" ]]; then
  if $JSON_MODE; then
    jq -n \
      --arg node "$NODE_ID" \
      --arg mode "$MODE" \
      --arg rule "R2" \
      --argjson admitted_modes "$allowed_modes_json" \
      --argjson manual_limits "$manual_limits_json" \
      '{node:$node, mode:$mode, decision:"refused", rule:$rule, reason:"mode is not admitted by node.recovery.status", admitted_modes:$admitted_modes, manual_limits:$manual_limits}'
  else
    echo "R2: Mode '$MODE' is not admitted for node '$NODE_ID' by node.recovery.status."
    echo "Admitted modes:"
    if [[ "$(jq 'length' <<<"$allowed_modes_json")" -gt 0 ]]; then
      jq -r '.[] | "  - \(.mode)"' <<<"$allowed_modes_json"
    else
      echo "  none"
    fi
    if [[ "$(jq 'length' <<<"$manual_limits_json")" -gt 0 ]]; then
      echo "Manual limits:"
      jq -r '.[] | "  - \(.id): \(.description)"' <<<"$manual_limits_json"
    fi
  fi
  exit 1
fi

safe_to_mutate="$(jq -r '.control_plane_truth.safe_to_mutate // "false"' <<<"$recovery_json")"
recoverable_truth="$(jq -r '.control_plane_truth.recoverable // "unknown"' <<<"$recovery_json")"
physical_action="$(jq -r '.recovery_links.physical_action_required // ""' <<<"$recovery_json")"
underlying_capability="$(jq -r '.capability' <<<"$mode_json")"

underlying_action=""
underlying_script=""
underlying_args=""

case "$MODE" in
  power_status)
    underlying_action="status"
    underlying_script="$POWER_CONTROL"
    underlying_args=(status --host-id "$NODE_ID")
    ;;
  power_on)
    underlying_action="on"
    underlying_script="$POWER_CONTROL"
    underlying_args=(on --host-id "$NODE_ID")
    $EXECUTE && underlying_args+=(--execute)
    ;;
  power_off)
    underlying_action="off"
    underlying_script="$POWER_CONTROL"
    underlying_args=(off --host-id "$NODE_ID")
    $EXECUTE && underlying_args+=(--execute)
    ;;
  power_cycle)
    underlying_action="cycle"
    underlying_script="$POWER_CONTROL"
    underlying_args=(cycle --host-id "$NODE_ID")
    $EXECUTE && underlying_args+=(--execute)
    ;;
  host_shutdown)
    underlying_action="shutdown"
    underlying_script="$HOST_CONTROL"
    underlying_args=(shutdown --host-id "$NODE_ID")
    $EXECUTE && underlying_args+=(--execute)
    ;;
  host_startup)
    underlying_action="startup"
    underlying_script="$HOST_CONTROL"
    underlying_args=(startup --host-id "$NODE_ID")
    $EXECUTE && underlying_args+=(--execute)
    ;;
  *)
    fail "mode '$MODE' is admitted but no underlying primitive mapping exists"
    ;;
esac

dry_run=true
executed=false
if [[ "$MODE" == "power_status" ]]; then
  dry_run=false
  executed=true
elif $EXECUTE; then
  dry_run=false
  executed=true
fi

if $JSON_MODE; then
  result="$(jq -n \
    --arg node "$NODE_ID" \
    --arg mode "$MODE" \
    --arg decision "admitted" \
    --arg underlying_capability "$underlying_capability" \
    --arg underlying_action "$underlying_action" \
    --arg recoverable_truth "$recoverable_truth" \
    --arg safe_to_mutate "$safe_to_mutate" \
    --arg physical_action "$physical_action" \
    --argjson dry_run "$dry_run" \
    --argjson executed "$executed" \
    '{
      node:$node,
      mode:$mode,
      decision:$decision,
      underlying_capability:$underlying_capability,
      underlying_action:$underlying_action,
      recovery_truth:{
        recoverable:$recoverable_truth,
        safe_to_mutate:$safe_to_mutate,
        physical_action_required:$physical_action
      },
      dry_run:$dry_run,
      executed:$executed
    }')"
  if $dry_run; then
    result="$(jq --arg note "DRY-RUN: No mutation performed. Re-run with --execute to proceed." '. + {note:$note}' <<<"$result")"
  fi
  printf '%s\n' "$result"
else
  echo "============================================================"
  echo "  node.recovery.invoke"
  echo "============================================================"
  echo ""
  echo "REQUEST"
  echo "  node:        $NODE_ID"
  echo "  mode:        $MODE"
  echo "  decision:    admitted by node.recovery.status"
  echo ""
  echo "RECOVERY CONTEXT"
  echo "  capability:  $underlying_capability"
  echo "  action:      $underlying_action"
  echo "  recoverable: $recoverable_truth"
  echo "  safe_to_mutate: $safe_to_mutate"
  [[ -n "$physical_action" ]] && echo "  physical_action_required: $physical_action"
  echo ""
fi

if $dry_run; then
  if ! $JSON_MODE; then
    echo "------------------------------------------------------------"
    echo "  DRY-RUN: No mutation performed."
    echo "  Would execute: $underlying_capability $underlying_action"
    echo "------------------------------------------------------------"
    echo ""
    echo "--- dry-run output from underlying primitive ---"
    bash "$underlying_script" "${underlying_args[@]}" 2>&1 || true
  fi
  exit 0
fi

if ! $JSON_MODE; then
  echo "--- executing underlying primitive ---"
fi
bash "$underlying_script" "${underlying_args[@]}"
