#!/usr/bin/env bash
set -euo pipefail

# infra-proxmox-power-status — Out-of-band power and hardware health
# Read-only. Wraps iDRAC Redfish/IPMI health probe via PVE jump host.
#
# Delegates to the existing idrac-health-status script.

SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
IDRAC_SCRIPT="$SPINE_ROOT/ops/plugins/infra/observability/bin/idrac-health-status"

if [[ ! -x "$IDRAC_SCRIPT" ]]; then
    echo "FAIL: idrac-health-status script not found at $IDRAC_SCRIPT" >&2
    exit 1
fi

exec "$IDRAC_SCRIPT" "$@"
