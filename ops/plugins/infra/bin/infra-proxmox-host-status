#!/usr/bin/env bash
set -euo pipefail

# infra-proxmox-host-status — Canonical PVE host summary
# Read-only. The single command for "what is the state of pve right now?"
#
# Reports: reachability, boot, EFI, LVM, ZFS, guest counts, anomalies.

SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

HOST_ID="${1:-pve}"
shift || true

SSH_HOST="$(ssh_resolve_ssh_host_with_fallback "$HOST_ID" 2>/dev/null | awk '{print $1}')"
SSH_USER="$(ssh_resolve_user "$HOST_ID")"

if [[ -z "$SSH_HOST" || "$SSH_HOST" == "unreachable" ]]; then
    echo "=== PVE HOST STATUS ($HOST_ID) ==="
    echo "Reachability: UNREACHABLE"
    echo ""
    echo "FAIL: cannot reach $HOST_ID via SSH"
    exit 1
fi

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)

remote() {
    ssh "${SSH_OPTS[@]}" "${SSH_USER}@${SSH_HOST}" "$@"
}

echo "=== PVE HOST STATUS ($HOST_ID) ==="
echo "Reachability: OK (${SSH_USER}@${SSH_HOST})"
echo ""

# Boot info
echo "-- Boot --"
remote 'bash -s' <<'REMOTE'
set -euo pipefail
echo "Uptime: $(uptime -p 2>/dev/null || uptime)"
efi_current="$(efibootmgr 2>/dev/null | grep '^BootCurrent:' || echo 'BootCurrent: unknown')"
efi_order="$(efibootmgr 2>/dev/null | grep '^BootOrder:' || echo 'BootOrder: unknown')"
echo "$efi_current"
echo "$efi_order"
efi_mount="$(mount | grep '/boot/efi' | awk '{print $1, "on", $3, "type", $5}' || echo '/boot/efi: not mounted')"
echo "EFI mount: $efi_mount"
REMOTE
echo ""

# LVM summary
echo "-- LVM (VG pve) --"
remote 'pvs --noheadings -o pv_name,pv_size,pv_free,pv_used 2>/dev/null; echo "---"; vgs --noheadings -o vg_name,vg_size,vg_free 2>/dev/null' || echo "  (LVM query failed)"
echo ""

# ZFS pools
echo "-- ZFS Pools --"
remote 'bash -s' <<'REMOTE'
set -euo pipefail
for pool in $(zpool list -H -o name 2>/dev/null); do
    state="$(zpool list -H -o health "$pool" 2>/dev/null || echo 'UNKNOWN')"
    size="$(zpool list -H -o size "$pool" 2>/dev/null || echo '?')"
    used="$(zpool list -H -o alloc "$pool" 2>/dev/null || echo '?')"
    scan="$(zpool status "$pool" 2>/dev/null | grep 'scan:' | sed 's/^[[:space:]]*//' || echo 'scan: unknown')"
    printf "  %-12s %s  size=%s used=%s  %s\n" "$pool" "$state" "$size" "$used" "$scan"
done
REMOTE
echo ""

# Guest summary
echo "-- Guests --"
remote 'bash -s' <<'REMOTE'
set -uo pipefail
vm_running=0; vm_stopped=0; ct_running=0; ct_stopped=0
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*[0-9] ]] || continue
    status=$(echo "$line" | awk '{print $3}')
    case "$status" in running) vm_running=$((vm_running + 1));; *) vm_stopped=$((vm_stopped + 1));; esac
done < <(qm list 2>/dev/null | tail -n+2)
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*[0-9] ]] || continue
    status=$(echo "$line" | awk '{print $2}')
    case "$status" in running) ct_running=$((ct_running + 1));; *) ct_stopped=$((ct_stopped + 1));; esac
done < <(pct list 2>/dev/null | tail -n+2)
echo "  VMs:        ${vm_running} running, ${vm_stopped} stopped"
echo "  Containers: ${ct_running} running, ${ct_stopped} stopped"
REMOTE
echo ""

# Anomalies
echo "-- Anomalies --"
remote 'bash -s' <<'REMOTE'
set -uo pipefail
anomalies=0

# Check for 0B drives (dead/unresponsive)
while IFS= read -r line; do
    name="$(echo "$line" | awk '{print $1}')"
    size="$(echo "$line" | awk '{print $2}')"
    model="$(echo "$line" | awk '{print $3}')"
    serial="$(echo "$line" | awk '{print $4}')"
    if [[ "$size" == "0B" || "$size" == "0" ]]; then
        echo "  ANOMALY: /dev/$name shows ${size} (model=$model serial=$serial) — dead or unresponsive"
        anomalies=$((anomalies + 1))
    fi
done < <(lsblk -dn -o NAME,SIZE,MODEL,SERIAL 2>/dev/null | grep -E '^sd')

# Check for degraded ZFS
for pool in $(zpool list -H -o name 2>/dev/null); do
    health="$(zpool list -H -o health "$pool" 2>/dev/null)"
    if [[ "$health" != "ONLINE" ]]; then
        echo "  ANOMALY: ZFS pool $pool is $health"
        anomalies=$((anomalies + 1))
    fi
done

# Check for VG issues
vg_missing="$(pvs --noheadings -o pv_name,vg_name 2>/dev/null | grep -c '\[unknown\]' || true)"
if [[ "$vg_missing" -gt 0 ]]; then
    echo "  ANOMALY: $vg_missing PV(s) with unknown VG"
    anomalies=$((anomalies + 1))
fi

if [[ "$anomalies" -eq 0 ]]; then
    echo "  None detected"
fi
REMOTE
echo ""
echo "=== END HOST STATUS ==="
