#!/usr/bin/env bash
# infra-infisical-restore-drill — governed scratch restore proof for Infisical
# Domain: infra
# Safety: mutating
# Approval: auto
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
BACKUP_CONTRACT="$ROOT/ops/bindings/infisical.backup.contract.yaml"
BACKUP_SCHEDULE="$ROOT/ops/bindings/backup.schedule.yaml"
BACKUP_INVENTORY="$ROOT/ops/bindings/backup.inventory.yaml"
CONTRACT="$ROOT/ops/bindings/infra.core.baseline.contract.yaml"
SSH_BINDING="$ROOT/ops/bindings/ssh.targets.yaml"
RECEIPT_DIR="$ROOT/mailroom/outbox/reports/restore-drills"
TARGET_ID=""
KEEP_ARTIFACTS=0

fail() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

need yq
need jq
need ssh
[[ -f "$BACKUP_CONTRACT" ]] || fail "missing backup contract: $BACKUP_CONTRACT"
[[ -f "$BACKUP_SCHEDULE" ]] || fail "missing backup schedule: $BACKUP_SCHEDULE"
[[ -f "$BACKUP_INVENTORY" ]] || fail "missing backup inventory: $BACKUP_INVENTORY"
[[ -f "$CONTRACT" ]] || fail "missing infra contract: $CONTRACT"
[[ -f "$SSH_BINDING" ]] || fail "missing ssh binding: $SSH_BINDING"

usage() {
  cat <<'EOF'
Usage: infra-infisical-restore-drill [--target <ssh-target>] [--keep-artifacts]

Runs a scratch restore of the latest canonical Infisical artifact from cold storage,
validates the restored database against expected metrics, and writes a single YAML
receipt under mailroom/outbox/reports/restore-drills/.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift ;;
    --target|--ssh-id) TARGET_ID="${2:?--target requires a value}"; shift 2 ;;
    --keep-artifacts) KEEP_ARTIFACTS=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

if [[ -z "$TARGET_ID" ]]; then
  TARGET_ID="$(yq e -r '.infisical.runtime_location // ""' "$CONTRACT" | sed 's/VM [0-9]* //' | sed 's/(\(.*\))/\1/')"
  if [[ -z "$TARGET_ID" || "$TARGET_ID" == "null" ]]; then
    TARGET_ID="infra-core"
  fi
fi
[[ -n "$TARGET_ID" && "$TARGET_ID" != "null" ]] || fail "target id not found"

DEF_USER="$(yq e -r '.ssh.defaults.user // "root"' "$SSH_BINDING")"
DEF_PORT="$(yq e -r '.ssh.defaults.port // 22' "$SSH_BINDING")"
DEF_TO="$(yq e -r '.ssh.defaults.connect_timeout_sec // 5' "$SSH_BINDING")"

TARGET_HOST="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .host // \"\"" "$SSH_BINDING")"
TARGET_USER="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .user // \"$DEF_USER\"" "$SSH_BINDING")"
TARGET_PORT="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .port // $DEF_PORT" "$SSH_BINDING")"
TARGET_TAILSCALE="$(yq e -r ".ssh.targets[] | select(.id == \"$TARGET_ID\") | .tailscale_ip // \"\"" "$SSH_BINDING")"
[[ -n "$TARGET_HOST" && "$TARGET_HOST" != "null" ]] || fail "ssh target '$TARGET_ID' missing host"
SSH_OPTS="-p $TARGET_PORT -o ConnectTimeout=${DEF_TO} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

PVE_TARGET_ID="$(yq e -r '.model.destination_lanes."r730xd-shop-backups".host // "pve"' "$BACKUP_INVENTORY")"
PVE_TARGET_HOST="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .host // \"\"" "$SSH_BINDING")"
PVE_TARGET_USER="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .user // \"$DEF_USER\"" "$SSH_BINDING")"
PVE_TARGET_PORT="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .port // $DEF_PORT" "$SSH_BINDING")"
PVE_TARGET_TAILSCALE="$(yq e -r ".ssh.targets[] | select(.id == \"$PVE_TARGET_ID\") | .tailscale_ip // \"\"" "$SSH_BINDING")"
[[ -n "$PVE_TARGET_HOST" && "$PVE_TARGET_HOST" != "null" ]] || fail "ssh target '$PVE_TARGET_ID' missing host"
PVE_SSH_OPTS="-p $PVE_TARGET_PORT -o ConnectTimeout=${DEF_TO} -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
OFFSITE_BASE="/md1400/backup-cold/apps/infra-core/infisical"

resolve_ssh_ref() {
  local id="$1"
  local user="$2"
  local host="$3"
  local tailscale="$4"
  local opts="$5"
  local -a candidates=("${id}" "${user}@${host}")
  if [[ -n "$tailscale" && "$tailscale" != "null" && "$tailscale" != "$host" ]]; then
    candidates+=("${user}@${tailscale}")
  fi
  local candidate
  for candidate in "${candidates[@]}"; do
    if ssh $opts "$candidate" "true" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  echo "${user}@${host}"
}

infra_ssh_ref="$(resolve_ssh_ref "$TARGET_ID" "$TARGET_USER" "$TARGET_HOST" "$TARGET_TAILSCALE" "$SSH_OPTS")"
pve_ssh_ref="$(resolve_ssh_ref "$PVE_TARGET_ID" "$PVE_TARGET_USER" "$PVE_TARGET_HOST" "$PVE_TARGET_TAILSCALE" "$PVE_SSH_OPTS")"

infra_ssh() { ssh $SSH_OPTS "$infra_ssh_ref" "$@"; }
pve_ssh() { ssh $PVE_SSH_OPTS "$pve_ssh_ref" "$@"; }

yaml_quote() {
  python3 - <<'PY' "$1"
import json, sys
print(json.dumps(sys.argv[1]))
PY
}

# Find latest artifact from cold storage
LATEST_OFFSITE_DB="$(pve_ssh "ls -1t '$OFFSITE_BASE'/*.sql.gz 2>/dev/null | head -1" || echo "")"
[[ -n "$LATEST_OFFSITE_DB" ]] || fail "no Infisical dump artifact found in $OFFSITE_BASE"

ARTIFACT_BASENAME="$(basename "$LATEST_OFFSITE_DB")"
ARTIFACT_TS="${ARTIFACT_BASENAME#infisical-db-}"
ARTIFACT_TS="${ARTIFACT_TS%.sql.gz}"

RUN_TS="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DAY="$(date -u +%Y%m%d)"
DRILL_DB="infisical_drill"
TEMP_DUMP_REMOTE="/tmp/infisical-drill-restore.sql.gz"
TEMP_DUMP_LOCAL="$(mktemp /tmp/infisical-drill-XXXXXX.sql.gz)"
mkdir -p "$RECEIPT_DIR"
RECEIPT_PATH="$RECEIPT_DIR/infra-infisical-restore-drill-${RUN_DAY}.yaml"

REMOTE_OUTPUT_FILE="$(mktemp)"
REMOTE_ERROR_FILE="$(mktemp)"
cleanup_local() {
  rm -f "$REMOTE_OUTPUT_FILE" "$REMOTE_ERROR_FILE" "$TEMP_DUMP_LOCAL"
}
trap cleanup_local EXIT

# Copy dump from pve to local machine, then to infra-core
echo "Copying dump from pve to local..." >&2
pve_ssh "cat '$LATEST_OFFSITE_DB'" > "$TEMP_DUMP_LOCAL" || fail "failed to copy dump from pve"
echo "Copying dump from local to infra-core..." >&2
cat "$TEMP_DUMP_LOCAL" | infra_ssh "cat > '$TEMP_DUMP_REMOTE'" || fail "failed to copy dump to infra-core"

set +e
infra_ssh "bash -s -- '$TEMP_DUMP_REMOTE' '$DRILL_DB' '$KEEP_ARTIFACTS'" <<'REMOTE' >"$REMOTE_OUTPUT_FILE" 2>"$REMOTE_ERROR_FILE"
set -euo pipefail
temp_dump="$1"
drill_db="$2"
keep_artifacts="${3:-0}"

cleanup() {
  if [[ "$keep_artifacts" != "1" ]]; then
    docker exec infisical-db psql -U infisical -d postgres -c "DROP DATABASE IF EXISTS $drill_db" >/dev/null 2>&1 || true
    rm -f "$temp_dump"
  fi
}
trap cleanup EXIT

# Source .env for POSTGRES_PASSWORD (needs sudo since root-owned)
POSTGRES_PASSWORD="$(sudo grep '^POSTGRES_PASSWORD=' /opt/stacks/secrets/.env | cut -d= -f2-)"
export POSTGRES_PASSWORD

# Drop and create scratch DB (separate commands to avoid transaction block error)
docker exec -e PGPASSWORD="$POSTGRES_PASSWORD" infisical-db \
  psql -U infisical -d postgres -c "DROP DATABASE IF EXISTS $drill_db" >/dev/null 2>&1
docker exec -e PGPASSWORD="$POSTGRES_PASSWORD" infisical-db \
  psql -U infisical -d postgres -c "CREATE DATABASE $drill_db OWNER infisical" >/dev/null 2>&1

# Restore dump into scratch DB
gunzip -c "$temp_dump" | docker exec -i -e PGPASSWORD="$POSTGRES_PASSWORD" infisical-db \
  psql -U infisical -d "$drill_db" -v ON_ERROR_STOP=1 >/dev/null 2>&1

# Query metrics
docker exec -i -e PGPASSWORD="$POSTGRES_PASSWORD" infisical-db \
  psql -U infisical -d "$drill_db" -v ON_ERROR_STOP=1 -F $'\t' -At <<'SQL'
SELECT 'table_count', COUNT(*)::bigint::text
FROM information_schema.tables
WHERE table_schema = 'public'
UNION ALL
SELECT 'project_count', COUNT(*)::bigint::text
FROM projects
UNION ALL
SELECT 'folder_count', COUNT(*)::bigint::text
FROM secret_folders;
SQL
REMOTE
restore_rc=$?
set -e

restore_error=""
declare -A ACTUAL=()
if [[ $restore_rc -eq 0 ]]; then
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] || continue
    ACTUAL["$key"]="$value"
  done <"$REMOTE_OUTPUT_FILE"
else
  restore_error="$(tr '\n' ' ' <"$REMOTE_ERROR_FILE" | sed 's/[[:space:]]\+/ /g' | sed 's/^ //; s/ $//')"
fi

# Expected values from manual proof (2026-03-09)
EXPECTED_TABLE_COUNT=216
EXPECTED_PROJECT_COUNT=9
EXPECTED_FOLDER_COUNT=55

all_match=true
if [[ $restore_rc -eq 0 ]]; then
  [[ "${ACTUAL[table_count]:-0}" -eq "$EXPECTED_TABLE_COUNT" ]] || all_match=false
  [[ "${ACTUAL[project_count]:-0}" -eq "$EXPECTED_PROJECT_COUNT" ]] || all_match=false
  [[ "${ACTUAL[folder_count]:-0}" -eq "$EXPECTED_FOLDER_COUNT" ]] || all_match=false
else
  all_match=false
fi

RESULT="FAIL"
if [[ $restore_rc -eq 0 && "$all_match" == "true" ]]; then
  RESULT="PASS"
fi

{
  echo "kind: infra_infisical_restore_drill"
  echo "version: 1"
  echo "generated_at: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  echo "result: $RESULT"
  echo "target:"
  echo "  ssh_target: $TARGET_ID"
  echo "  ssh_ref: $(yaml_quote "$infra_ssh_ref")"
  echo "offsite_target:"
  echo "  ssh_target: $PVE_TARGET_ID"
  echo "  ssh_ref: $(yaml_quote "$pve_ssh_ref")"
  echo "artifacts:"
  echo "  offsite_db: $(yaml_quote "$LATEST_OFFSITE_DB")"
  echo "  artifact_timestamp: $(yaml_quote "$ARTIFACT_TS")"
  echo "restore:"
  echo "  mode: scratch_nonprod"
  echo "  database: $(yaml_quote "$DRILL_DB")"
  echo "  temp_dump_path: $(yaml_quote "$TEMP_DUMP_REMOTE")"
  echo "  keep_artifacts: $([[ "$KEEP_ARTIFACTS" -eq 1 ]] && echo true || echo false)"
  echo "comparison:"
  echo "  table_count:"
  echo "    expected: $EXPECTED_TABLE_COUNT"
  echo "    actual: ${ACTUAL[table_count]:-0}"
  if [[ "${ACTUAL[table_count]:-0}" -eq "$EXPECTED_TABLE_COUNT" ]]; then
    echo "    match: true"
  else
    echo "    match: false"
  fi
  echo "  project_count:"
  echo "    expected: $EXPECTED_PROJECT_COUNT"
  echo "    actual: ${ACTUAL[project_count]:-0}"
  if [[ "${ACTUAL[project_count]:-0}" -eq "$EXPECTED_PROJECT_COUNT" ]]; then
    echo "    match: true"
  else
    echo "    match: false"
  fi
  echo "  folder_count:"
  echo "    expected: $EXPECTED_FOLDER_COUNT"
  echo "    actual: ${ACTUAL[folder_count]:-0}"
  if [[ "${ACTUAL[folder_count]:-0}" -eq "$EXPECTED_FOLDER_COUNT" ]]; then
    echo "    match: true"
  else
    echo "    match: false"
  fi
  if [[ -n "$restore_error" ]]; then
    echo "error: $(yaml_quote "$restore_error")"
  else
    echo "error: null"
  fi
} >"$RECEIPT_PATH"

echo "=== Infisical Restore Drill ==="
echo "target: $TARGET_ID ($infra_ssh_ref)"
echo "receipt: $RECEIPT_PATH"
echo "result: $RESULT"
if [[ -n "$restore_error" ]]; then
  echo "error: $restore_error"
fi
echo "  table_count expected=$EXPECTED_TABLE_COUNT actual=${ACTUAL[table_count]:-missing}"
echo "  project_count expected=$EXPECTED_PROJECT_COUNT actual=${ACTUAL[project_count]:-missing}"
echo "  folder_count expected=$EXPECTED_FOLDER_COUNT actual=${ACTUAL[folder_count]:-missing}"

if [[ "$RESULT" != "PASS" ]]; then
  exit 1
fi
