#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[4]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from ops.plugins.infra.lib.content_family_placement import (
    build_projection,
    load_yaml,
    source_sha,
    source_stamp,
    validate_cross_surface_policy,
    validate_policy,
)


def expand(raw: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(raw)))).resolve()


DEFAULT_ROOT = expand(ROOT)


def git_top_level(start: Path) -> Path | None:
    probe = start if start.is_dir() else start.parent
    proc = subprocess.run(
        ["git", "-C", str(probe), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        return None
    stdout = proc.stdout.strip()
    return Path(stdout).resolve() if stdout else None


def resolve_target_root(explicit: str | None = None) -> Path:
    if explicit:
        return expand(explicit)
    cwd_root = git_top_level(Path.cwd())
    if cwd_root is not None:
        return cwd_root
    script_root = git_top_level(Path(__file__).resolve())
    if script_root is not None:
        return script_root
    for env_name in ("SPINE_TARGET_REPO", "SPINE_ROOT", "SPINE_REPO", "SPINE_CODE"):
        value = os.environ.get(env_name)
        if value:
            return expand(value)
    return DEFAULT_ROOT


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="content-family-placement-audit")
    parser.add_argument("--root", help="Target checkout root.")
    parser.add_argument("--brief", action="store_true", help="Print one-line summary.")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when any error exists.")
    parser.add_argument("--format", choices=("text", "json", "yaml"), default="text")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    root = resolve_target_root(args.root)
    policy_path = root / "ops/bindings/content.family.placement.policy.yaml"
    projection_path = root / "ops/bindings/content.family.placement.projected.yaml"
    policy = load_yaml(policy_path)
    projection_on_disk = load_yaml(projection_path) if projection_path.exists() else {}
    expected_projection = build_projection(
        policy,
        source_sha256=source_sha(root, [policy_path]),
        generated_at_utc=source_stamp([policy_path]),
    )
    issues = validate_policy(policy, projection_on_disk=projection_on_disk, expected_projection=expected_projection)
    issues.extend(validate_cross_surface_policy(root, policy))

    errors = [issue.message for issue in issues if issue.severity == "error"]
    warnings = [issue.message for issue in issues if issue.severity == "warning"]
    status = "PASS" if not errors else "FAIL"
    payload = {
        "status": status,
        "issues": len(errors),
        "warnings": len(warnings),
        "checked_families": len((policy.get("families") or {}).keys()),
        "required_families": 5,
        "messages": {
            "errors": errors,
            "warnings": warnings,
        },
    }

    if args.brief:
        print(f"{status} issues={len(errors)} warnings={len(warnings)} families={payload['checked_families']}")
    elif args.format == "json":
        print(json.dumps(payload, indent=2))
    elif args.format == "yaml":
        print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=False), end="")
    else:
        print(f"status: {status}")
        print(f"issues: {len(errors)}")
        print(f"warnings: {len(warnings)}")
        for item in errors:
            print(f"error: {item}")
        for item in warnings:
            print(f"warning: {item}")

    if args.strict and errors:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
