#!/usr/bin/env bash
set -euo pipefail

# node-recovery-status
#
# First-class control-plane recovery truth for a node.
# Read-only. Derives recovery posture from governed surfaces and
# exposes the existing status/control primitives that can operate on
# the node without pretending those primitives are themselves the
# recovery truth surface.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPINE_ROOT="${SPINE_ROOT:-$(cd "$SCRIPT_DIR/../../../.." && pwd)}"
SSH_BINDING="$SPINE_ROOT/ops/bindings/ssh.targets.yaml"
HW_BINDING="$SPINE_ROOT/ops/bindings/hardware.inventory.yaml"
OP_HW_BINDING="$SPINE_ROOT/ops/bindings/operator.hardware.inventory.yaml"
APPLIANCE_BINDING="$SPINE_ROOT/ops/bindings/appliance.identity.contract.yaml"
FLEET_ADMISSION_BINDING="$SPINE_ROOT/ops/bindings/fleet.admission.classification.yaml"
PLACEMENT_BINDING="$SPINE_ROOT/ops/bindings/infra.placement.policy.yaml"
# PACKET-1379: shop.device.registry.yaml deleted. Path retained as a label
# so the yq lookups below silently return empty when 2>/dev/null fires.
SHOP_DEVICE_BINDING="$SPINE_ROOT/ops/bindings/shop.device.registry.yaml"
SESSION_POSTURE_LIB="$SPINE_ROOT/ops/plugins/core/lifecycle/lib/session_posture.sh"

usage() {
  cat <<'EOF'
node-recovery-status - First-class recovery truth for a node

Usage:
  node-recovery-status --node <id> [--json]
  node-recovery-status --list

Options:
  --node <id>   Node/carrier ID from ssh.targets, hardware.inventory, or
                operator.hardware.inventory
  --json        Machine-readable JSON output
  --list        List known candidate node IDs

This capability is READ-ONLY.
It reports recovery truth and underlying primitives; it does not invoke recovery.
EOF
}

fail() { echo "FAIL: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

NODE_ID=""
JSON_MODE=false
LIST_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --node) NODE_ID="${2:-}"; shift 2 ;;
    --json) JSON_MODE=true; shift ;;
    --list) LIST_MODE=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift ;;
    *) fail "unknown argument: $1" ;;
  esac
done

need yq
need jq

# PACKET-1379: shop.device.registry.yaml deleted — drop from required-surface
# guard. Devices that lived there were L3 function categorization without
# branch authority; node recovery now sources its IDs from the surviving
# bindings only.
for f in "$SSH_BINDING" "$HW_BINDING" "$OP_HW_BINDING" "$APPLIANCE_BINDING" "$FLEET_ADMISSION_BINDING" "$PLACEMENT_BINDING" "$SESSION_POSTURE_LIB"; do
  [[ -f "$f" ]] || fail "missing required surface: $f"
done

if $LIST_MODE; then
  {
    yq -r '.ssh.targets[].id' "$SSH_BINDING" 2>/dev/null || true
    yq -r '.machines[].machine_id' "$HW_BINDING" 2>/dev/null || true
    yq -r '.machines[].device_id' "$OP_HW_BINDING" 2>/dev/null || true
    yq -r '.appliances[].appliance_id' "$APPLIANCE_BINDING" 2>/dev/null || true
    yq -r '.devices[].id' "$SHOP_DEVICE_BINDING" 2>/dev/null || true
  } | awk 'NF' | sort -u
  exit 0
fi

[[ -n "$NODE_ID" ]] || fail "--node is required"

# shellcheck disable=SC1090
source "$SESSION_POSTURE_LIB"
session_recovery_posture_resolve

admission_binding_json="$(yq e -o=json '.' "$FLEET_ADMISSION_BINDING" 2>/dev/null || true)"
placement_binding_json="$(yq e -o=json '.' "$PLACEMENT_BINDING" 2>/dev/null || true)"
ssh_json="$(yq e -o=json ".ssh.targets[] | select(.id == \"$NODE_ID\")" "$SSH_BINDING" 2>/dev/null || true)"
hw_json="$(yq e -o=json ".machines[] | select(.machine_id == \"$NODE_ID\")" "$HW_BINDING" 2>/dev/null || true)"
op_hw_json="$(yq e -o=json ".machines[] | select(.device_id == \"$NODE_ID\")" "$OP_HW_BINDING" 2>/dev/null || true)"
appliance_json="$(yq e -o=json ".appliances[] | select(.appliance_id == \"$NODE_ID\")" "$APPLIANCE_BINDING" 2>/dev/null || true)"
# PACKET-1379: shop.device.registry.yaml deleted as a hand-maintained Site
# Intelligence carrier. yq returns empty silently because the file is
# absent; downstream conditionals on shop_device_json fall back to fleet
# admission classification when the machine is registered there.
shop_device_json="$(yq e -o=json ".devices[] | select(.id == \"$NODE_ID\")" "$SHOP_DEVICE_BINDING" 2>/dev/null || true)"
fleet_machine_json="$(yq e -o=json ".fleet.\"$NODE_ID\"" "$FLEET_ADMISSION_BINDING" 2>/dev/null || true)"
[[ -n "$fleet_machine_json" && "$fleet_machine_json" != "null" ]] || fleet_machine_json='{}'

[[ -n "$admission_binding_json" && "$admission_binding_json" != "null" ]] || admission_binding_json='{}'
[[ -n "$placement_binding_json" && "$placement_binding_json" != "null" ]] || placement_binding_json='{}'
[[ -n "$ssh_json" && "$ssh_json" != "null" ]] || ssh_json='{}'
[[ -n "$hw_json" && "$hw_json" != "null" ]] || hw_json='{}'
[[ -n "$op_hw_json" && "$op_hw_json" != "null" ]] || op_hw_json='{}'
[[ -n "$appliance_json" && "$appliance_json" != "null" ]] || appliance_json='{}'
[[ -n "$shop_device_json" && "$shop_device_json" != "null" ]] || shop_device_json='{}'

# PACKET-1379: when the deleted shop registry leaves shop_device_json empty
# but the machine is in fleet admission with site=shop, fall back to the
# fleet entry so downstream conditionals (recovery_status defaults,
# physical_presence_required, primary_description) keep their shop-shape
# behavior. Physical-presence required is the conservative default for an
# admitted/excluded shop physical machine without a proved remote power
# plane.
if [[ "$shop_device_json" == "{}" && "$fleet_machine_json" != "{}" ]]; then
  fleet_site="$(jq -r '.site // empty' <<<"$fleet_machine_json")"
  if [[ "$fleet_site" == "shop" ]]; then
    shop_device_json="$fleet_machine_json"
  fi
fi

if [[ "$ssh_json" == "{}" && "$hw_json" == "{}" && "$op_hw_json" == "{}" && "$appliance_json" == "{}" && "$shop_device_json" == "{}" ]]; then
  fail "node not found in governed recovery surfaces: $NODE_ID"
fi

node_kind="ssh_target_only"
if [[ "$appliance_json" != "{}" ]]; then
  node_kind="appliance"
elif [[ "$hw_json" != "{}" ]]; then
  node_kind="infra_machine"
elif [[ "$op_hw_json" != "{}" ]]; then
  node_kind="operator_hardware"
elif [[ "$shop_device_json" != "{}" ]]; then
  node_kind="shop_physical_machine"
fi

node_site="$(jq -r '.site // empty' <<<"$hw_json")"
[[ -n "$node_site" ]] || node_site="$(jq -r '.site // empty' <<<"$appliance_json")"
[[ -n "$node_site" ]] || node_site="$(jq -r '.site // empty' <<<"$op_hw_json")"
[[ -n "$node_site" ]] || node_site="$(jq -r '.site // empty' <<<"$ssh_json")"
if [[ -z "$node_site" && "$shop_device_json" != "{}" ]]; then
  node_site="shop"
fi
[[ -n "$node_site" ]] || node_site="unknown"

admission_json="$(jq -c --arg node "$NODE_ID" '.fleet[$node] // {}' <<<"$admission_binding_json")"
if [[ "$admission_json" == "{}" && "$appliance_json" != "{}" ]]; then
  admission_json="$(jq -c '{
    appliance_id,
    admission_status,
    first_touch_state,
    promotion_stage,
    notes: ("Appliance-class subject admitted through appliance.identity.contract.yaml with readback-first mutation boundary.")
  }' <<<"$appliance_json")"
fi
placement_host_json="$(jq -c --arg node "$NODE_ID" '.hosts[$node] // {}' <<<"$placement_binding_json")"
required_vm_targets_json="$(jq -c --arg node "$NODE_ID" '
  (.vm_target_requirements // {})
  | to_entries
  | map(select(.value.required_proxmox_host == $node) | .key)
' <<<"$placement_binding_json")"

admission_state="$(jq -r '.admission_status // "unclassified"' <<<"$admission_json")"
first_touch_state="$(jq -r '.first_touch_state // "unknown"' <<<"$admission_json")"
host_policy_kind="$(jq -r '.kind // empty' <<<"$placement_host_json")"
[[ -n "$host_policy_kind" ]] || host_policy_kind="unknown"
active_vm_count="$(jq -r '.active_vm_count // empty' <<<"$hw_json")"
[[ -n "$active_vm_count" ]] || active_vm_count="0"
required_vm_target_count="$(jq 'length' <<<"$required_vm_targets_json")"

primary_host="$(jq -r '.host // empty' <<<"$ssh_json")"
primary_user="$(jq -r '.user // empty' <<<"$ssh_json")"
primary_access_policy="$(jq -r '.access_policy // empty' <<<"$ssh_json")"
primary_access_method="$(jq -r '.access_method // "ssh"' <<<"$ssh_json")"
primary_tailscale_ip="$(jq -r '.tailscale_ip // empty' <<<"$ssh_json")"
primary_lan_ip="$(jq -r '.lan_ip // empty' <<<"$ssh_json")"
primary_description="$(jq -r '.description // empty' <<<"$ssh_json")"
if [[ -z "$primary_description" && "$shop_device_json" != "{}" ]]; then
  primary_description="$(jq -r '.notes // .role // .name // empty' <<<"$shop_device_json")"
fi

if [[ -z "$primary_host" && "$op_hw_json" != "{}" ]]; then
  primary_host="$(jq -r '.tailscale_ip // empty' <<<"$op_hw_json")"
  primary_tailscale_ip="$primary_host"
  primary_user="$(jq -r '.default_user // empty' <<<"$op_hw_json")"
  if [[ -n "$primary_host" ]]; then
    primary_access_policy="tailscale_declared_if_admin_enabled"
  else
    primary_access_policy=""
  fi
  primary_access_method="operator_hardware_inventory"
  primary_description="$(jq -r '.notes // empty' <<<"$op_hw_json")"
fi

if [[ -z "$primary_host" && "$appliance_json" != "{}" ]]; then
  primary_host="$(jq -r '.network_identities.tailscale_ip // .backed_by.tailscale_ip // empty' <<<"$appliance_json")"
  primary_tailscale_ip="$primary_host"
  primary_lan_ip="$(jq -r '.network_identities.lan_ip // .backed_by.lan_ip // empty' <<<"$appliance_json")"
  primary_user="$(jq -r '.access_methods[0].user // empty' <<<"$appliance_json")"
  primary_access_policy="appliance_declared_access"
  primary_access_method="$(jq -r '.access_methods[0].method // "appliance_readback"' <<<"$appliance_json")"
  primary_description="$(jq -r '.notes // .class // empty' <<<"$appliance_json")"
fi

recovery_target_id="$(jq -r '.recovery_target_id // empty' <<<"$ssh_json")"
recovery_target_json='{}'
if [[ -n "$recovery_target_id" ]]; then
  recovery_target_json="$(yq e -o=json ".ssh.targets[] | select(.id == \"$recovery_target_id\")" "$SSH_BINDING" 2>/dev/null || true)"
  [[ -n "$recovery_target_json" && "$recovery_target_json" != "null" ]] || recovery_target_json='{}'
fi

recovery_status="$(jq -r '.recovery_status // empty' <<<"$recovery_target_json")"
[[ -n "$recovery_status" ]] || recovery_status="$(jq -r '.recovery_substrate.status // empty' <<<"$hw_json")"
[[ -n "$recovery_status" ]] || recovery_status="$(jq -r '.recovery_status // empty' <<<"$appliance_json")"
[[ -n "$recovery_status" ]] || recovery_status="$(jq -r '.recovery_control.power // empty' <<<"$op_hw_json")"
if [[ -z "$recovery_status" && "$shop_device_json" != "{}" ]]; then
  recovery_status="physical_presence_required"
fi
if [[ -z "$recovery_status" && "$op_hw_json" != "{}" ]]; then
  if jq -e '.known_constraints[]? | test("power-loss recovery unproved|No remote admin plane|manual|physical"; "i")' <<<"$op_hw_json" >/dev/null 2>&1; then
    recovery_status="physical_presence_required"
  fi
fi
[[ -n "$recovery_status" ]] || recovery_status="unproven"

physical_action_required="$(jq -r '.physical_action_required // empty' <<<"$recovery_target_json")"
[[ -n "$physical_action_required" ]] || physical_action_required="$(jq -r '.recovery_substrate.blocker // empty' <<<"$hw_json")"
[[ -n "$physical_action_required" ]] || physical_action_required="$(jq -r '.recovery_control.manual_action // empty' <<<"$op_hw_json")"
if [[ -z "$physical_action_required" && "$shop_device_json" != "{}" ]]; then
  physical_action_required="Shop production physical machine; remote power/control path is not admitted. Operator physical presence or vendor console is required for power recovery."
fi
if [[ -z "$physical_action_required" && "$op_hw_json" != "{}" ]]; then
  physical_action_required="$(jq -r '[.known_constraints[]? | select(test("power-loss recovery unproved|No remote admin plane|manual|physical"; "i"))] | first // empty' <<<"$op_hw_json")"
fi
if [[ -z "$physical_action_required" && "$appliance_json" != "{}" && "$recovery_status" == "physical_presence_required" ]]; then
  physical_action_required="operator physical presence required for power or console recovery"
fi

cross_site_recovery="$(jq -r '.recovery_substrate.cross_site_recovery // empty' <<<"$hw_json")"
[[ -n "$cross_site_recovery" ]] || cross_site_recovery="false"
hardware_os="$(jq -r '.os // empty' <<<"$hw_json")"
appliance_os="$(jq -r '.appliance_os // empty' <<<"$appliance_json")"
estate_cluster_membership="$(jq -r '.estate_truth.cluster_membership // empty' <<<"$hw_json")"
estate_placement_status="$(jq -r '.estate_truth.placement_status // empty' <<<"$hw_json")"
estate_assignment_required="$(jq -r '.estate_truth.assignment_required // empty' <<<"$hw_json")"
estate_note="$(jq -r '.estate_truth.note // empty' <<<"$hw_json")"

power_plane="missing"
console_plane="missing"
network_plane="missing"
identity_plane="unproven"

if [[ -n "$primary_host" ]]; then
  case "$primary_access_method" in
    lan_only) network_plane="lan_only_declared" ;;
    operator_hardware_inventory) network_plane="tailscale_device_visible" ;;
    appliance_readback) network_plane="appliance_path_declared" ;;
    *) network_plane="ssh_path_declared" ;;
  esac
fi

if [[ "$recovery_target_json" != "{}" || "$(jq -r '.recovery_substrate.type // empty' <<<"$hw_json")" != "" ]]; then
  power_plane="$recovery_status"
  console_plane="$recovery_status"
elif [[ "$op_hw_json" != "{}" && "$(jq -r '.recovery_control.power // empty' <<<"$op_hw_json")" != "" ]]; then
  power_plane="$(jq -r '.recovery_control.power' <<<"$op_hw_json")"
  console_plane="$(jq -r '.recovery_control.console // .recovery_control.power' <<<"$op_hw_json")"
elif [[ "$shop_device_json" != "{}" ]]; then
  power_plane="physical_presence_required"
  console_plane="local_physical_or_vendor_ui"
elif [[ "$recovery_status" == "physical_presence_required" || "$recovery_status" == "readback_only" ]]; then
  power_plane="$recovery_status"
  console_plane="$recovery_status"
fi

operator_identity="$(jq -r '.recovery_control.identity // empty' <<<"$op_hw_json")"

if [[ -n "$primary_host" && -n "$primary_user" && "$primary_user" != "unknown" && "$primary_access_method" == "ssh" ]]; then
  identity_plane="ssh_identity_declared"
elif [[ -n "$operator_identity" ]]; then
  identity_plane="$operator_identity"
elif [[ "$appliance_json" != "{}" && -n "$primary_host" ]]; then
  identity_plane="appliance_identity_declared"
fi

reachable_truth="declared_path_only"
if [[ "$network_plane" == "missing" ]]; then
  reachable_truth="unknown"
fi

recoverable_truth="$recovery_status"
object_os_state="unknown"
if [[ "$hw_json" != "{}" && -n "$hardware_os" ]]; then
  object_os_state="installed"
elif [[ "$appliance_json" != "{}" && -n "$appliance_os" ]]; then
  object_os_state="appliance_os:$appliance_os"
elif [[ "$op_hw_json" != "{}" ]]; then
  object_os_state="operator_managed"
fi

if [[ -z "$estate_placement_status" ]]; then
  if [[ "$required_vm_target_count" -gt 0 ]]; then
    estate_placement_status="admitted_runtime_host"
  elif [[ "$node_kind" == "appliance" && "$host_policy_kind" != "unknown" ]]; then
    estate_placement_status="inventory_known"
  elif [[ "$node_kind" == "infra_machine" && "$host_policy_kind" == "proxmox" ]]; then
    if [[ "$active_vm_count" =~ ^[0-9]+$ && "$active_vm_count" -gt 0 ]]; then
      estate_placement_status="runtime_present"
    else
      estate_placement_status="unassigned"
    fi
  elif [[ "$node_kind" == "infra_machine" && "$host_policy_kind" != "unknown" ]]; then
    estate_placement_status="inventory_known"
  else
    estate_placement_status="unknown"
  fi
fi

if [[ -z "$estate_assignment_required" ]]; then
  if [[ "$required_vm_target_count" -gt 0 ]]; then
    estate_assignment_required="true"
  elif [[ "$node_kind" == "appliance" ]]; then
    estate_assignment_required="false"
  elif [[ "$node_kind" == "infra_machine" && "$host_policy_kind" == "proxmox" ]]; then
    estate_assignment_required="false"
  else
    estate_assignment_required="unknown"
  fi
fi

if [[ -z "$estate_note" ]]; then
  if [[ "$estate_placement_status" == "unassigned" && "$estate_assignment_required" == "false" ]]; then
    estate_note="No workload placement is selected. This is a non-activation posture, not an incompleteness signal."
  else
    estate_note="$(jq -r '.notes // empty' <<<"$admission_json")"
  fi
fi

site_mutation_posture="false"
site_mutation_basis=""
if [[ "$appliance_json" != "{}" && "$(jq -r '.spine_mutation_allowed // false' <<<"$appliance_json")" != "true" ]]; then
  site_mutation_posture="false"
  site_mutation_basis="appliance_mutation_boundary_forbids_spine_mutation"
elif [[ "$__SP_OPERATOR_SITE" == "$node_site" ]]; then
  if [[ "$recoverable_truth" == "known_and_reachable" || "$recoverable_truth" == "proved" ]]; then
    site_mutation_posture="true"
    site_mutation_basis="same_site_plus_recovery_proved"
  else
    site_mutation_posture="site_local_only"
    site_mutation_basis="same_site_but_recovery_not_fully_proved"
  fi
elif [[ "$cross_site_recovery" == "true" && ("$recoverable_truth" == "known_and_reachable" || "$recoverable_truth" == "proved") ]]; then
  site_mutation_posture="true"
  site_mutation_basis="cross_site_recovery_proved"
else
  site_mutation_posture="false"
  site_mutation_basis="cross_site_recovery_missing_or_unproven"
fi

status_primitives='[]'
invoke_primitives='[]'
invoke_modes='[]'
manual_limits='[]'

append_json_item() {
  local base="$1"
  local cap="$2"
  local mode="$3"
  jq -cn --argjson base "$base" --arg capability "$cap" --arg mode "$mode" \
    '$base + [{capability:$capability, mode:$mode}]'
}

append_mode() {
  local base="$1"
  local mode="$2"
  local capability="$3"
  local description="$4"
  jq -cn --argjson base "$base" --arg mode "$mode" --arg capability "$capability" --arg description "$description" \
    '$base + [{mode:$mode, capability:$capability, description:$description}]'
}

append_limit() {
  local base="$1"
  local id="$2"
  local description="$3"
  jq -cn --argjson base "$base" --arg id "$id" --arg description "$description" \
    '$base + [{id:$id, description:$description}]'
}

if [[ "$NODE_ID" == "pve" ]]; then
  status_primitives="$(append_json_item "$status_primitives" "ssh.target.status" "reachability")"
  status_primitives="$(append_json_item "$status_primitives" "infra.proxmox.host.status" "host_state")"
  status_primitives="$(append_json_item "$status_primitives" "infra.proxmox.power.status" "oob_power_console")"
  invoke_primitives="$(append_json_item "$invoke_primitives" "infra.proxmox.host.control" "graceful_host_shutdown_startup")"
  invoke_primitives="$(append_json_item "$invoke_primitives" "infra.proxmox.power.control" "oob_power_control")"
elif [[ "$node_kind" == "infra_machine" && "$hardware_os" == Proxmox* ]]; then
  if [[ "$ssh_json" != "{}" ]]; then
    status_primitives="$(append_json_item "$status_primitives" "ssh.target.status" "reachability")"
  fi
  status_primitives="$(append_json_item "$status_primitives" "infra.proxmox.host.status" "host_state")"
  if [[ -n "$recovery_target_id" ]]; then
    invoke_primitives="$(append_json_item "$invoke_primitives" "infra.proxmox.power.control" "oob_power_control")"
  fi
elif [[ "$node_kind" == "operator_hardware" ]]; then
  if [[ "$ssh_json" != "{}" ]]; then
    status_primitives="$(append_json_item "$status_primitives" "ssh.target.status" "reachability")"
  fi
  status_primitives="$(append_json_item "$status_primitives" "host.operator-hardware.readiness" "readiness")"
  status_primitives="$(append_json_item "$status_primitives" "host.operator-hardware.bootstrap-prereq" "bootstrap_prereq")"
elif [[ "$primary_access_method" == "lan_only" ]]; then
  status_primitives="$(append_json_item "$status_primitives" "network.lan.device.status" "lan_reachability")"
elif [[ "$node_kind" == "appliance" ]]; then
  if [[ "$ssh_json" != "{}" ]]; then
    status_primitives="$(append_json_item "$status_primitives" "ssh.target.status" "reachability")"
  fi
  status_primitives="$(append_json_item "$status_primitives" "appliance.health.status" "appliance_health")"
else
  status_primitives="$(append_json_item "$status_primitives" "ssh.target.status" "reachability")"
fi

if [[ "$node_kind" == "infra_machine" && "$hardware_os" == Proxmox* && "$ssh_json" != "{}" ]]; then
  status_primitives="$(append_json_item "$status_primitives" "infra.proxmox.host.status" "host_state")"
  if [[ "$site_mutation_posture" == "true" || "$site_mutation_posture" == "site_local_only" ]]; then
    invoke_modes="$(append_mode "$invoke_modes" "host_startup" "infra.proxmox.host.control" "Start admitted Proxmox guests on an already reachable host over SSH.")"
  fi
fi

if [[ "$power_plane" == "proved" || "$power_plane" == "known_and_reachable" ]]; then
  if [[ "$site_mutation_posture" == "true" ]]; then
    invoke_modes="$(append_mode "$invoke_modes" "power_status" "infra.proxmox.power.control" "Read out-of-band power state through the declared recovery target.")"
    invoke_modes="$(append_mode "$invoke_modes" "power_on" "infra.proxmox.power.control" "Power on through proved out-of-band recovery.")"
    invoke_modes="$(append_mode "$invoke_modes" "power_off" "infra.proxmox.power.control" "Hard power off through proved out-of-band recovery; use only when graceful control is insufficient.")"
    invoke_modes="$(append_mode "$invoke_modes" "power_cycle" "infra.proxmox.power.control" "Power cycle through proved out-of-band recovery.")"
    if [[ "$node_kind" == "infra_machine" && "$hardware_os" == Proxmox* && "$ssh_json" != "{}" ]]; then
      invoke_modes="$(append_mode "$invoke_modes" "host_shutdown" "infra.proxmox.host.control" "Gracefully shut down guests and host; safe because a proved power-on path exists.")"
    fi
  else
    manual_limits="$(append_limit "$manual_limits" "oob_site_limit" "Out-of-band power or console exists but is not safely invokable from the current operator site/posture.")"
  fi
elif [[ "$power_plane" == "physical_presence_required" ]]; then
  manual_limits="$(append_limit "$manual_limits" "manual_power_required" "No governed remote power path is declared; operator physical presence is required for power recovery.")"
elif [[ "$power_plane" == "readback_only" ]]; then
  manual_limits="$(append_limit "$manual_limits" "vendor_owned_control" "Spine has readback access only; vendor/appliance control plane owns mutation.")"
else
  manual_limits="$(append_limit "$manual_limits" "remote_power_unproved" "No proved remote power or console path is declared.")"
fi

if [[ "$identity_plane" != "ssh_identity_declared" ]]; then
  manual_limits="$(append_limit "$manual_limits" "admin_plane_unproved" "No governed SSH/admin identity is declared for agent control.")"
fi

status_primitives="$(jq -c 'unique_by((.capability // "") + ":" + (.mode // ""))' <<<"$status_primitives")"
invoke_primitives="$(jq -c 'unique_by((.capability // "") + ":" + (.mode // ""))' <<<"$invoke_primitives")"
invoke_modes="$(jq -c 'unique_by((.mode // ""))' <<<"$invoke_modes")"
manual_limits="$(jq -c 'unique_by((.id // ""))' <<<"$manual_limits")"

result_json="$(jq -n \
  --arg node_id "$NODE_ID" \
  --arg node_kind "$node_kind" \
  --arg node_site "$node_site" \
  --arg operator_site "${__SP_OPERATOR_SITE:-unknown}" \
  --arg recovery_posture "${__SP_RECOVERY_POSTURE:-unknown}" \
  --arg recovery_ready_global "${__SP_RECOVERY_READY:-false}" \
  --arg site_detection_basis "${__SP_SITE_DETECTION_BASIS:-unavailable}" \
  --arg primary_host "$primary_host" \
  --arg primary_user "$primary_user" \
  --arg primary_access_policy "$primary_access_policy" \
  --arg primary_access_method "$primary_access_method" \
  --arg primary_tailscale_ip "$primary_tailscale_ip" \
  --arg primary_lan_ip "$primary_lan_ip" \
  --arg primary_description "$primary_description" \
  --arg recovery_target_id "$recovery_target_id" \
  --arg admission_state "$admission_state" \
  --arg first_touch_state "$first_touch_state" \
  --arg object_os_state "$object_os_state" \
  --arg host_policy_kind "$host_policy_kind" \
  --arg estate_cluster_membership "$estate_cluster_membership" \
  --arg estate_placement_status "$estate_placement_status" \
  --arg estate_assignment_required "$estate_assignment_required" \
  --arg estate_note "$estate_note" \
  --arg active_vm_count "$active_vm_count" \
  --arg reachable_truth "$reachable_truth" \
  --arg recoverable_truth "$recoverable_truth" \
  --arg node_safe_to_mutate "$site_mutation_posture" \
  --arg node_safe_to_mutate_basis "$site_mutation_basis" \
  --arg identity_plane "$identity_plane" \
  --arg power_plane "$power_plane" \
  --arg console_plane "$console_plane" \
  --arg network_plane "$network_plane" \
  --arg physical_action_required "$physical_action_required" \
  --argjson ssh_target "$ssh_json" \
  --argjson recovery_target "$recovery_target_json" \
  --argjson hardware_machine "$hw_json" \
  --argjson operator_hardware "$op_hw_json" \
  --argjson appliance_identity "$appliance_json" \
  --argjson shop_device "$shop_device_json" \
  --argjson admission_record "$admission_json" \
  --argjson placement_host "$placement_host_json" \
  --argjson required_vm_targets "$required_vm_targets_json" \
  --argjson status_primitives "$status_primitives" \
  --argjson invoke_primitives "$invoke_primitives" \
  --argjson invoke_modes "$invoke_modes" \
  --argjson manual_limits "$manual_limits" \
  '{
    node_id:$node_id,
    node_kind:$node_kind,
    node_site:$node_site,
    operator_context:{
      operator_site:$operator_site,
      recovery_posture:$recovery_posture,
      recovery_ready_global:$recovery_ready_global,
      site_detection_basis:$site_detection_basis
    },
    control_plane_truth:{
      reachable:$reachable_truth,
      recoverable:$recoverable_truth,
      safe_to_mutate:$node_safe_to_mutate,
      safe_to_mutate_basis:$node_safe_to_mutate_basis
    },
    object_truth:{
      os_state:$object_os_state,
      admission_state:$admission_state,
      first_touch_state:$first_touch_state,
      recovery_state:$recoverable_truth
    },
    estate_truth:{
      host_kind:$host_policy_kind,
      cluster_membership:(if $estate_cluster_membership == "" then null else $estate_cluster_membership end),
      placement_status:$estate_placement_status,
      assignment_required:$estate_assignment_required,
      active_vm_count:$active_vm_count,
      required_vm_targets:$required_vm_targets,
      note:$estate_note
    },
    recovery_planes:{
      identity:$identity_plane,
      network:$network_plane,
      power:$power_plane,
      console:$console_plane
    },
    primary_access:{
      host:$primary_host,
      user:$primary_user,
      access_policy:$primary_access_policy,
      access_method:$primary_access_method,
      tailscale_ip:$primary_tailscale_ip,
      lan_ip:$primary_lan_ip,
      description:$primary_description
    },
    recovery_links:{
      recovery_target_id:$recovery_target_id,
      physical_action_required:$physical_action_required
    },
    control_modes:{
      status:$status_primitives,
      invoke:$invoke_modes,
      manual_limits:$manual_limits
    },
    source_surfaces:{
      admission_record:$admission_record,
      placement_host:$placement_host,
      ssh_target:$ssh_target,
      recovery_target:$recovery_target,
      hardware_machine:$hardware_machine,
      operator_hardware:$operator_hardware,
      appliance_identity:$appliance_identity,
      shop_device:$shop_device
    },
    status_primitives:$status_primitives,
    invoke_primitives:$invoke_primitives,
    note:"First-class recovery truth surface. Separates object truth from estate/placement truth so non-activation posture does not read as machine incompleteness."
  }')"

if $JSON_MODE; then
  printf '%s\n' "$result_json"
  exit 0
fi

echo "============================================================"
echo "  node.recovery.status"
echo "============================================================"
echo ""
echo "NODE"
echo "  node_id:      $NODE_ID"
echo "  node_kind:    $node_kind"
echo "  node_site:    $node_site"
[[ -n "$primary_description" ]] && echo "  description:  $primary_description"
echo ""
echo "OPERATOR CONTEXT"
echo "  operator_site:         ${__SP_OPERATOR_SITE:-unknown}"
echo "  recovery_posture:      ${__SP_RECOVERY_POSTURE:-unknown}"
echo "  recovery_ready_global: ${__SP_RECOVERY_READY:-false}"
echo "  site_detection_basis:  ${__SP_SITE_DETECTION_BASIS:-unavailable}"
echo ""
echo "CONTROL PLANE TRUTH"
echo "  reachable:             $reachable_truth"
echo "  recoverable:           $recoverable_truth"
echo "  safe_to_mutate:        $site_mutation_posture"
echo "  safe_to_mutate_basis:  $site_mutation_basis"
echo ""
echo "OBJECT TRUTH"
echo "  os_state:              $object_os_state"
echo "  admission_state:       $admission_state"
echo "  first_touch_state:     $first_touch_state"
echo "  recovery_state:        $recoverable_truth"
echo ""
echo "ESTATE TRUTH"
echo "  host_kind:             $host_policy_kind"
[[ -n "$estate_cluster_membership" ]] && echo "  cluster_membership:    $estate_cluster_membership"
echo "  placement_status:      $estate_placement_status"
echo "  assignment_required:   $estate_assignment_required"
echo "  active_vm_count:       $active_vm_count"
if [[ "$required_vm_target_count" -gt 0 ]]; then
  echo "  required_vm_targets:"
  jq -r '.[] | "    - \(.)"' <<<"$required_vm_targets_json"
else
  echo "  required_vm_targets:   none"
fi
[[ -n "$estate_note" ]] && echo "  note:                  $estate_note"
echo ""
echo "RECOVERY PLANES"
echo "  identity:   $identity_plane"
echo "  network:    $network_plane"
echo "  power:      $power_plane"
echo "  console:    $console_plane"
echo ""
echo "PRIMARY ACCESS"
echo "  host:           ${primary_host:-none}"
echo "  user:           ${primary_user:-none}"
echo "  access_policy:  ${primary_access_policy:-none}"
echo "  access_method:  ${primary_access_method:-none}"
[[ -n "$primary_tailscale_ip" ]] && echo "  tailscale_ip:   $primary_tailscale_ip"
[[ -n "$primary_lan_ip" ]] && echo "  lan_ip:         $primary_lan_ip"
echo ""
echo "RECOVERY LINKS"
echo "  recovery_target_id:        ${recovery_target_id:-none}"
echo "  physical_action_required:  ${physical_action_required:-none}"
echo ""
echo "AVAILABLE PRIMITIVES"
echo "  status:"
jq -r '.[] | "    - \(.capability) [\(.mode)]"' <<<"$status_primitives"
echo "  invoke:"
jq -r '.[] | "    - \(.capability) [\(.mode)]"' <<<"$invoke_primitives"
echo ""
echo "CONTROL MODES"
echo "  invoke:"
if [[ "$(jq 'length' <<<"$invoke_modes")" -gt 0 ]]; then
  jq -r '.[] | "    - \(.mode): \(.description) [\(.capability)]"' <<<"$invoke_modes"
else
  echo "    none"
fi
echo "  manual_limits:"
if [[ "$(jq 'length' <<<"$manual_limits")" -gt 0 ]]; then
  jq -r '.[] | "    - \(.id): \(.description)"' <<<"$manual_limits"
else
  echo "    none"
fi
echo ""
echo "------------------------------------------------------------"
# Summary verdict
if [[ "$site_mutation_posture" == "true" ]]; then
  echo "  VERDICT: Recovery is AVAILABLE for $NODE_ID"
elif [[ "$site_mutation_posture" == "site_local_only" ]]; then
  echo "  VERDICT: Recovery is PARTIAL for $NODE_ID (same-site only, recovery not fully proved)"
elif [[ "$recoverable_truth" == "unproven" ]]; then
  echo "  VERDICT: Recovery is UNPROVEN for $NODE_ID — recovery path has not been tested"
else
  echo "  VERDICT: Recovery is UNAVAILABLE for $NODE_ID"
fi
echo "------------------------------------------------------------"
echo ""
echo "NEXT STEPS"
if [[ "$site_mutation_posture" == "true" ]]; then
  echo "  Use node-recovery-invoke --node $NODE_ID --mode <mode> to take action"
  echo "  Available modes: node-recovery-invoke --list-modes"
elif [[ "$site_mutation_posture" == "site_local_only" ]]; then
  echo "  Limited recovery available from same site."
  echo "  Use node-recovery-invoke --node $NODE_ID --mode <mode> (OOB modes only from same site)"
elif [[ "$recoverable_truth" == "unproven" ]]; then
  echo "  Recovery substrate needs proving before invoke is safe."
  echo "  Check iDRAC/IPMI reachability and test power-status read-only first."
else
  echo "  No recovery path available. Check recovery_planes above for gaps."
fi
