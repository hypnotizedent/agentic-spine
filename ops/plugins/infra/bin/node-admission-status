#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[4]
NODE_RECOVERY_STATUS = ROOT / "ops/plugins/infra/bin/node-recovery-status"
LAUNCHD_SCHEDULER_REGISTRY = ROOT / "ops/bindings/launchd.scheduler.registry.yaml"
NODE_ROLE_CONTRACT = ROOT / "ops/bindings/node.role.contract.yaml"
ALERTING_RULES = ROOT / "ops/bindings/alerting.rules.yaml"
OPERATOR_HARDWARE_INVENTORY = ROOT / "ops/bindings/operator.hardware.inventory.yaml"
APPLIANCE_IDENTITY_CONTRACT = ROOT / "ops/bindings/appliance.identity.contract.yaml"
RUNTIME_BOOTSTRAP_CONTRACT = ROOT / "ops/bindings/runtime.bootstrap.contract.yaml"


def fail(message: str, code: int = 1) -> None:
    print(f"FAIL: {message}", file=sys.stderr)
    raise SystemExit(code)


def run_json(args: list[str]) -> Any:
    env = {**os.environ, "SPINE_ROOT": str(ROOT)}
    proc = subprocess.run(args, text=True, capture_output=True, env=env)
    if proc.returncode != 0:
        fail(proc.stderr.strip() or proc.stdout.strip() or f"command failed: {' '.join(args)}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON from {' '.join(args)}: {exc}")


def run_lines(args: list[str]) -> list[str]:
    env = {**os.environ, "SPINE_ROOT": str(ROOT)}
    proc = subprocess.run(args, text=True, capture_output=True, env=env)
    if proc.returncode != 0:
        fail(proc.stderr.strip() or proc.stdout.strip() or f"command failed: {' '.join(args)}")
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def load_yaml(path: Path) -> dict[str, Any]:
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict):
        return {}
    return data


def first_present(*values: Any, default: Any = None) -> Any:
    for value in values:
        if value not in (None, "", [], {}):
            return value
    return default


def as_list(value: Any) -> list[Any]:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]


def operator_role_candidacy_values() -> set[str]:
    data = load_yaml(OPERATOR_HARDWARE_INVENTORY)
    return {str(value) for value in as_list(data.get("role_candidacy_values")) if str(value)}


def appliance_class_values() -> set[str]:
    data = load_yaml(APPLIANCE_IDENTITY_CONTRACT)
    values: set[str] = set()
    for appliance in data.get("appliances") or []:
        if not isinstance(appliance, dict):
            continue
        appliance_class = str(appliance.get("class") or "").strip()
        if appliance_class:
            values.add(appliance_class)
    return values


def validate_operator_role_candidacy(node_id: str, operator: dict[str, Any]) -> None:
    if not operator:
        return
    candidacy = [str(value) for value in as_list(operator.get("role_candidacy")) if str(value)]
    if not candidacy:
        return

    allowed = operator_role_candidacy_values()
    if not allowed:
        fail("operator.hardware.inventory.yaml role_candidacy_values is empty")

    appliance_classes = appliance_class_values()
    collisions = sorted(value for value in candidacy if value in appliance_classes)
    if collisions:
        fail(
            f"{node_id}: operator role_candidacy contains appliance class name(s), "
            f"not node-role candidacy values: {', '.join(collisions)}"
        )

    invalid = sorted(value for value in candidacy if value not in allowed)
    if invalid:
        fail(
            f"{node_id}: operator role_candidacy contains value(s) outside "
            f"operator.hardware.inventory.yaml role_candidacy_values: {', '.join(invalid)}"
        )


def source_ref(path: str, role: str) -> dict[str, str]:
    return {"path": path, "role": role}


def compact_dict(data: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in data.items() if value not in (None, "", [], {})}


def load_json_file(path: str | None) -> dict[str, Any]:
    if not path:
        return {}
    try:
        data = json.loads(Path(path).expanduser().read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def latest_execution_pickup_recovery_drill() -> dict[str, Any]:
    state_root = Path(os.environ.get("SPINE_STATE") or ROOT.parent / ".runtime" / "spine" / "state")
    path = state_root / "domain-state" / "recovery-drills" / "execution-pickup" / "latest.yaml"
    data = load_yaml(path)
    if data:
        data["__path"] = str(path)
    return data


def durable_identifiers(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    hardware = sources.get("hardware_machine") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    shop = sources.get("shop_device") or {}
    ssh = sources.get("ssh_target") or {}

    return compact_dict(
        {
            "machine_id": first_present(hardware.get("machine_id"), operator.get("device_id"), shop.get("id")),
            "device_id": operator.get("device_id"),
            "appliance_id": appliance.get("appliance_id"),
            "hostname": first_present(hardware.get("hostname"), appliance.get("hostname"), shop.get("hostname"), ssh.get("id")),
            "model": first_present(hardware.get("model"), operator.get("model"), appliance.get("model"), shop.get("model")),
            "service_tag": hardware.get("service_tag"),
            "vendor": shop.get("vendor"),
            "platform": first_present(operator.get("platform"), "windows" if str(shop.get("os") or "").lower().startswith("windows") else None),
            "os": first_present(hardware.get("os"), appliance.get("appliance_os"), shop.get("os")),
            "lan_ip": declared_lan_ip(hardware, ssh, shop, appliance),
            "tailscale_ip": first_present(
                hardware.get("tailscale_ip"),
                operator.get("tailscale_ip"),
                (appliance.get("network_identities") or {}).get("tailscale_ip"),
                ssh.get("tailscale_ip"),
                shop.get("tailscale_ip"),
            ),
            "mac": first_present(ssh.get("mac"), shop.get("mac")),
            "ssh_target_id": ssh.get("id"),
            "shop_device_id": shop.get("id"),
        }
    )


def looks_like_lan_ip(value: Any) -> bool:
    text = str(value or "").strip()
    if text.startswith("10.") or text.startswith("192.168."):
        return True
    if not text.startswith("172."):
        return False
    parts = text.split(".")
    if len(parts) < 2:
        return False
    try:
        second = int(parts[1])
    except ValueError:
        return False
    return 16 <= second <= 31


def declared_lan_ip(
    hardware: dict[str, Any],
    ssh: dict[str, Any],
    shop: dict[str, Any],
    appliance: dict[str, Any],
) -> Any:
    network = appliance.get("network_identities") or {}
    backed_by = appliance.get("backed_by") or {}
    ssh_host = ssh.get("host") if looks_like_lan_ip(ssh.get("host")) else None
    return first_present(
        hardware.get("lan_ip"),
        ssh.get("lan_ip"),
        shop.get("ip"),
        network.get("lan_ip"),
        backed_by.get("lan_ip"),
        ssh_host,
    )


def physical_identity_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    hardware = sources.get("hardware_machine") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    shop = sources.get("shop_device") or {}
    ssh = sources.get("ssh_target") or {}

    if hardware:
        source_surface = "ops/bindings/hardware.inventory.yaml"
        source_role = "infrastructure_hardware_inventory"
    elif operator:
        source_surface = "ops/bindings/operator.hardware.inventory.yaml"
        source_role = "operator_hardware_inventory"
    elif appliance:
        source_surface = "ops/bindings/appliance.identity.contract.yaml"
        source_role = "appliance_identity_inventory"
    elif shop:
        source_surface = "ops/bindings/shop.device.registry.yaml"
        source_role = "shop_function_projection"
    elif ssh:
        source_surface = "ops/bindings/ssh.targets.yaml"
        source_role = "access_path_only"
    else:
        source_surface = "node.recovery.status"
        source_role = "recovery_evidence"

    return compact_dict(
        {
            "physical_id": first_present(
                hardware.get("machine_id"),
                operator.get("device_id"),
                appliance.get("appliance_id"),
                shop.get("id"),
                ssh.get("id"),
                recovery.get("node_id"),
            ),
            "source_surface": source_surface,
            "source_role": source_role,
            "object_kind": recovery.get("node_kind"),
            "site": recovery.get("node_site"),
            "model": first_present(hardware.get("model"), operator.get("model"), appliance.get("model"), shop.get("model")),
            "service_tag": hardware.get("service_tag"),
            "vendor": shop.get("vendor"),
            "inventory_known": bool(hardware or operator or appliance or shop),
        }
    )


def boot_identity_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    hardware = sources.get("hardware_machine") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    shop = sources.get("shop_device") or {}
    ssh = sources.get("ssh_target") or {}
    admission = sources.get("admission_record") or {}
    object_truth = recovery.get("object_truth") or {}
    proof = admission.get("proof") or {}
    claim = load_json_file(proof.get("proof_ref"))
    claim_facts = claim.get("machine_facts") if isinstance(claim.get("machine_facts"), dict) else {}
    operator_facts = operator.get("machine_facts") if isinstance(operator.get("machine_facts"), dict) else {}
    hardware_facts = hardware.get("machine_facts") if isinstance(hardware.get("machine_facts"), dict) else {}
    appliance_facts = appliance.get("machine_facts") if isinstance(appliance.get("machine_facts"), dict) else {}

    admission_state = object_truth.get("admission_state")
    first_touch_state = object_truth.get("first_touch_state")
    stable_os_identity_claimed = admission_state == "admitted" and first_touch_state not in (None, "", "unknown")
    if proof and proof.get("identity_enrolled") is False:
        stable_os_identity_claimed = False
    if claim.get("stable_os_identity_claimed") is False:
        stable_os_identity_claimed = False
    boot_identity = claim.get("boot_identity") if isinstance(claim.get("boot_identity"), dict) else {}
    if boot_identity.get("stable_os_identity_claimed") is False:
        stable_os_identity_claimed = False

    return compact_dict(
        {
            "hostname": first_present(claim.get("hostname"), hardware.get("hostname"), appliance.get("hostname"), shop.get("hostname"), ssh.get("id")),
            "os": first_present(
                claim_facts.get("os_pretty"),
                operator_facts.get("os_pretty"),
                hardware_facts.get("os_pretty"),
                appliance_facts.get("os_pretty"),
                hardware.get("os"),
                appliance.get("appliance_os"),
                shop.get("os"),
            ),
            "kernel": first_present(claim_facts.get("kernel"), operator_facts.get("kernel"), hardware_facts.get("kernel"), appliance_facts.get("kernel")),
            "first_touch_state": first_touch_state,
            "stable_os_identity_claimed": stable_os_identity_claimed,
            "claim_state": "admitted_stable_os_identity" if stable_os_identity_claimed else "inventory_or_access_evidence_only",
            "bootstrap_claim": proof.get("proof_ref"),
            "boot_medium": first_present(claim.get("boot_medium"), boot_identity.get("boot_medium")),
        }
    )


def access_identity_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    primary_access = recovery.get("primary_access") or {}
    recovery_planes = recovery.get("recovery_planes") or {}
    ssh = sources.get("ssh_target") or {}
    hardware = sources.get("hardware_machine") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    shop = sources.get("shop_device") or {}

    user = primary_access.get("user")
    admin_identity_declared = bool(
        primary_access.get("host")
        and user not in (None, "", "unknown")
        and recovery_planes.get("identity") == "ssh_identity_declared"
    )
    if ssh:
        source_surface = "ops/bindings/ssh.targets.yaml"
    elif operator and operator.get("tailscale_ip"):
        source_surface = "ops/bindings/operator.hardware.inventory.yaml"
    elif appliance:
        source_surface = "ops/bindings/appliance.identity.contract.yaml"
    else:
        source_surface = "none"

    return compact_dict(
        {
            "host": primary_access.get("host"),
            "user": None if user == "unknown" else user,
            "access_method": primary_access.get("access_method"),
            "access_policy": primary_access.get("access_policy"),
            "lan_ip": first_present(primary_access.get("lan_ip"), declared_lan_ip(hardware, ssh, shop, appliance)),
            "tailscale_ip": first_present(
                primary_access.get("tailscale_ip"),
                hardware.get("tailscale_ip"),
                operator.get("tailscale_ip"),
                (appliance.get("network_identities") or {}).get("tailscale_ip"),
                shop.get("tailscale_ip"),
            ),
            "identity_plane": recovery_planes.get("identity"),
            "network_plane": recovery_planes.get("network"),
            "admin_identity_declared": admin_identity_declared,
            "source_surface": source_surface,
        }
    )


def admission_identity_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    admission = sources.get("admission_record") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    proof = admission.get("proof") or {}
    object_truth = recovery.get("object_truth") or {}

    if admission:
        source_surface = "ops/bindings/fleet.admission.classification.yaml"
    elif appliance:
        source_surface = "ops/bindings/appliance.identity.contract.yaml"
    elif operator:
        source_surface = "ops/bindings/operator.hardware.inventory.yaml"
    else:
        source_surface = "none"

    return compact_dict(
        {
            "admission_state": object_truth.get("admission_state"),
            "first_touch_state": object_truth.get("first_touch_state"),
            "admitted_machine_id": first_present(admission.get("machine_id"), admission.get("appliance_id")),
            "promotion_stage": first_present(operator.get("promotion_stage"), appliance.get("promotion_stage"), admission.get("promotion_stage")),
            "proof_ref": proof.get("proof_ref"),
            "proof": compact_dict(
                {
                    "ssh_access_proved": proof.get("ssh_access_proved"),
                    "bmc_reachable": proof.get("bmc_reachable"),
                    "identity_enrolled": proof.get("identity_enrolled"),
                    "first_boot_claim": proof.get("first_boot_claim"),
                }
            ),
            "source_surface": source_surface,
            "role_promotion": "none",
        }
    )


def source_surfaces_for_row(recovery: dict[str, Any]) -> list[dict[str, str]]:
    sources = recovery.get("source_surfaces") or {}
    refs: list[dict[str, str]] = []
    if sources.get("admission_record"):
        refs.append(source_ref("ops/bindings/fleet.admission.classification.yaml", "admission_state"))
    if sources.get("hardware_machine"):
        refs.append(source_ref("ops/bindings/hardware.inventory.yaml", "infra_identity_evidence"))
    if sources.get("operator_hardware"):
        refs.append(source_ref("ops/bindings/operator.hardware.inventory.yaml", "operator_hardware_candidacy_evidence"))
    if sources.get("appliance_identity"):
        refs.append(source_ref("ops/bindings/appliance.identity.contract.yaml", "appliance_identity_evidence"))
    if sources.get("shop_device"):
        refs.append(source_ref("ops/bindings/shop.device.registry.yaml", "l3_shop_function_projection_evidence"))
    if sources.get("ssh_target"):
        refs.append(source_ref("ops/bindings/ssh.targets.yaml", "access_path_evidence"))
    if sources.get("placement_host") or sources.get("required_vm_targets"):
        refs.append(source_ref("ops/bindings/infra.placement.policy.yaml", "placement_truth"))
    runtime_truth = recovery.get("__runtime_role_truth") or {}
    source_paths = runtime_truth.get("source_paths") or []
    if "ops/bindings/launchd.scheduler.registry.yaml" in source_paths:
        refs.append(source_ref("ops/bindings/launchd.scheduler.registry.yaml", "active_role_runtime"))
    if "ops/bindings/node.role.contract.yaml" in source_paths:
        refs.append(source_ref("ops/bindings/node.role.contract.yaml", "role_authority_runtime"))
    if "ops/bindings/alerting.rules.yaml" in source_paths:
        refs.append(source_ref("ops/bindings/alerting.rules.yaml", "escalation_origin_runtime"))
    refs.append(source_ref("node.recovery.status", "recovery_evidence_not_promotion_authority"))
    return refs


def subtraction_caption(recovery: dict[str, Any]) -> str:
    kind = recovery.get("node_kind")
    sources = recovery.get("source_surfaces") or {}
    if sources.get("operator_hardware"):
        return (
            "operator.hardware.inventory identifies/candidates the subject; "
            "node admission readback decides current node truth."
        )
    if sources.get("hardware_machine"):
        return (
            "hardware.inventory identifies infrastructure hardware; "
            "home.hardware.inventory and internet.asset.registry are not node admission authority."
        )
    if sources.get("appliance_identity"):
        return (
            "appliance identity supplies read-only appliance evidence; "
            "appliance presence is not a general node promotion."
        )
    if sources.get("shop_device"):
        return (
            "shop.device.registry supplies L3 shop function evidence only; "
            "physical-machine truth resolves through node admission."
        )
    if kind == "ssh_target_only":
        return "ssh.targets supplies access evidence only; reachability is not node admission."
    return "legacy inventory evidence is subordinate to canonical node admission readback."


def lifecycle_state(recovery: dict[str, Any]) -> str:
    object_truth = recovery.get("object_truth") or {}
    estate_truth = recovery.get("estate_truth") or {}
    runtime_truth = recovery.get("__runtime_role_truth") or {}
    admission_state = object_truth.get("admission_state")
    placement_status = estate_truth.get("placement_status")
    if admission_state == "admitted" and runtime_truth.get("active"):
        return "admitted_runtime_present"
    if admission_state == "admitted" and placement_status in {"runtime_present", "admitted_runtime_host"}:
        return "admitted_runtime_present"
    if admission_state == "admitted":
        return "admitted_not_activated"
    if admission_state and admission_state != "unclassified":
        return str(admission_state)
    return "candidate_or_access_evidence_only"


def runtime_role_truth_for(node_id: str) -> dict[str, Any]:
    roles: list[str] = []
    labels: list[dict[str, Any]] = []
    source_paths: set[str] = set()

    scheduler = load_yaml(LAUNCHD_SCHEDULER_REGISTRY)
    for item in scheduler.get("labels") or []:
        if not isinstance(item, dict):
            continue
        if item.get("state") != "active":
            continue
        if item.get("active_runtime_host") != node_id:
            continue
        role = str(item.get("intended_node_role") or "").strip()
        if role:
            roles.append(role)
        labels.append(
            compact_dict(
                {
                    "label": item.get("label"),
                    "role": role,
                    "unit": item.get("active_runtime_unit"),
                    "proof": item.get("runtime_transfer_proof"),
                    "transferred_at": item.get("runtime_transferred_at"),
                }
            )
        )
        source_paths.add("ops/bindings/launchd.scheduler.registry.yaml")

    node_role = load_yaml(NODE_ROLE_CONTRACT)
    external_observation = node_role.get("external_observation") or {}
    if external_observation.get("separation_runtime") == node_id:
        roles.append("watcher_node")
        evidence = external_observation.get("separation_evidence") or {}
        labels.append(
            compact_dict(
                {
                    "label": "external_observation.separation_runtime",
                    "role": "watcher_node",
                    "unit": evidence.get("systemd_unit"),
                    "proof": evidence.get("dispatch_result") or evidence.get("interrupt_origin"),
                    "transferred_at": external_observation.get("separation_realized_at"),
                }
            )
        )
        source_paths.add("ops/bindings/node.role.contract.yaml")

    alerting = load_yaml(ALERTING_RULES)
    escalation = ((alerting.get("operator_interrupt") or {}).get("escalation_authority") or {})
    if escalation.get("active_origin") == node_id:
        role = str(escalation.get("active_origin_role") or "").strip()
        if role:
            roles.append(role)
        labels.append(
            compact_dict(
                {
                    "label": "operator_critical_interrupt.escalation_authority",
                    "role": role,
                    "proof": escalation.get("active_origin_proof"),
                    "transferred_at": escalation.get("active_origin_proved_at"),
                }
            )
        )
        source_paths.add("ops/bindings/alerting.rules.yaml")

    deduped_roles = []
    for role in roles:
        if role and role not in deduped_roles:
            deduped_roles.append(role)

    return {
        "active": bool(deduped_roles or labels),
        "roles": deduped_roles,
        "labels": labels,
        "source_paths": sorted(source_paths),
    }


def execution_host_promotion_standard_for(node_id: str, runtime_truth: dict[str, Any]) -> dict[str, Any]:
    node_role = load_yaml(NODE_ROLE_CONTRACT)
    execution_host = ((node_role.get("node_types") or {}).get("execution_host") or {})
    standard = execution_host.get("promotion_standard") or {}
    required = standard.get("required_proofs") or {}
    labels = [
        item for item in runtime_truth.get("labels") or []
        if item.get("role") == "execution_host"
    ]
    placement_refs = [item for item in labels if item.get("proof")]
    runtime_placement = {
        "status": "present" if placement_refs else "missing",
        "source": ((required.get("runtime_placement_proof") or {}).get("source") or "ops/bindings/launchd.scheduler.registry.yaml"),
        "evidence": placement_refs,
    }

    scheduler = load_yaml(LAUNCHD_SCHEDULER_REGISTRY)
    runtime_bootstrap = load_yaml(RUNTIME_BOOTSTRAP_CONTRACT)
    env_file = str(((scheduler.get("paths") or {}).get("linux_execution_host_env_file")) or "")
    linux_bootstrap = ((runtime_bootstrap.get("path_roots") or {}).get("linux_execution_host") or {})
    current_delivered_host = str(standard.get("current_delivered_host") or "")
    path_resolution_present = (
        bool(env_file)
        and str(linux_bootstrap.get("source") or "") == env_file
        and node_id == current_delivered_host
    )
    path_resolution = {
        "status": "present" if path_resolution_present else "missing",
        "source": env_file or "/etc/spine/execution-host.env",
        "proof_ref": ((required.get("path_resolution_proof") or {}).get("proof_ref")),
    }

    recovery = latest_execution_pickup_recovery_drill()
    recovery_summary = recovery.get("summary") if isinstance(recovery.get("summary"), dict) else {}
    recovery_present = (
        recovery.get("status") == "pass"
        and recovery.get("target_host") == node_id
        and int(recovery_summary.get("failed", 1)) == 0
    )
    recovery_drill = {
        "status": "present" if recovery_present else "missing",
        "source": ((required.get("recovery_drill_proof") or {}).get("source") or "ops/bindings/disaster.drill.execution_pickup.contract.yaml"),
        "receipt": recovery.get("__path") or ((required.get("recovery_drill_proof") or {}).get("proof_ref")),
        "generated_at": recovery.get("generated_at"),
    }

    proofs = {
        "runtime_placement_proof": runtime_placement,
        "path_resolution_proof": path_resolution,
        "recovery_drill_proof": recovery_drill,
    }
    missing = [name for name, proof in proofs.items() if proof.get("status") != "present"]
    return {
        "role": "execution_host",
        "state": "delivered" if not missing else "incomplete",
        "standard_source": "ops/bindings/node.role.contract.yaml",
        "proofs": proofs,
        "missing_proofs": missing,
        "candidate_gaps": (standard.get("candidate_gaps") or {}).get(node_id, missing),
        "subtraction_note": "active_runtime_host is observation; delivered execution_host requires the three proof classes here",
    }


def row_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    operator = sources.get("operator_hardware") or {}
    appliance = sources.get("appliance_identity") or {}
    admission = sources.get("admission_record") or {}
    object_truth = recovery.get("object_truth") or {}
    estate_truth = recovery.get("estate_truth") or {}
    control = recovery.get("control_plane_truth") or {}
    primary_access = recovery.get("primary_access") or {}
    runtime_truth = runtime_role_truth_for(str(recovery.get("node_id") or ""))
    recovery["__runtime_role_truth"] = runtime_truth
    execution_host_standard = execution_host_promotion_standard_for(str(recovery.get("node_id") or ""), runtime_truth)

    validate_operator_role_candidacy(str(recovery.get("node_id") or "unknown"), operator)
    role_candidacy = as_list(operator.get("role_candidacy"))
    if not role_candidacy:
        role_candidacy = as_list(appliance.get("class"))
    if runtime_truth.get("roles"):
        role_candidacy = runtime_truth["roles"]
    if not role_candidacy:
        role_candidacy = ["none"]

    promotion_stage = first_present(
        operator.get("promotion_stage"),
        appliance.get("promotion_stage"),
        admission.get("promotion_stage"),
        default="taxonomy",
    )
    if runtime_truth.get("active"):
        promotion_stage = "delivered"

    placement_truth = dict(estate_truth)
    if runtime_truth.get("active"):
        placement_truth["role_runtime_status"] = "active"
        placement_truth["active_runtime_roles"] = runtime_truth.get("roles") or []
        placement_truth["active_runtime_count"] = len(runtime_truth.get("labels") or [])
        if placement_truth.get("placement_status") in {None, "", "unknown", "unassigned"}:
            placement_truth["placement_status"] = "role_runtime_present"
        note = placement_truth.get("note") or ""
        if "runtime role" not in str(note):
            placement_truth["note"] = (
                f"{note} Active runtime role truth is declared by scheduler/role surfaces."
            ).strip()

    proof_channels = []
    for primitive in recovery.get("status_primitives") or []:
        if isinstance(primitive, dict):
            proof_channels.append(compact_dict({"capability": primitive.get("capability"), "mode": primitive.get("mode")}))
    proof_channels.append({"capability": "node.recovery.status", "mode": "recovery_evidence"})

    freshness_state = "fresh"
    if control.get("reachable") in {"unknown", None, ""}:
        freshness_state = "unknown"
    elif control.get("reachable") == "declared_path_only":
        freshness_state = "declared"

    return {
        "node_id": recovery.get("node_id"),
        "object_kind": recovery.get("node_kind"),
        "site": recovery.get("node_site"),
        "lifecycle_state": lifecycle_state(recovery),
        "durable_identifiers": durable_identifiers(recovery),
        "role_candidacy": role_candidacy,
        "promotion_stage": promotion_stage,
        "eligibility_state": first_present(operator.get("eligibility_state"), default="not_applicable"),
        "admission_state": object_truth.get("admission_state"),
        "first_touch_state": object_truth.get("first_touch_state"),
        "physical_identity": physical_identity_from_recovery(recovery),
        "boot_identity": boot_identity_from_recovery(recovery),
        "access_identity": access_identity_from_recovery(recovery),
        "admission_identity": admission_identity_from_recovery(recovery),
        "access_path": compact_dict(
            {
                "host": primary_access.get("host"),
                "access_method": primary_access.get("access_method"),
                "access_policy": primary_access.get("access_policy"),
                "lan_ip": primary_access.get("lan_ip"),
                "tailscale_ip": primary_access.get("tailscale_ip"),
            }
        ),
        "placement_truth": placement_truth,
        "runtime_obligations": {
            "assignment_required": placement_truth.get("assignment_required"),
            "required_vm_targets": placement_truth.get("required_vm_targets") or [],
            "active_runtime_roles": runtime_truth.get("roles") or [],
            "active_runtime_labels": runtime_truth.get("labels") or [],
            "note": placement_truth.get("note"),
        },
        "role_delivery_proofs": {
            "execution_host": execution_host_standard,
        },
        "recovery_planes": recovery.get("recovery_planes") or {},
        "proof_channels": proof_channels,
        "freshness": {
            "state": freshness_state,
            "basis": "read_only_composition_from_governed_surfaces",
        },
        "source_surfaces": source_surfaces_for_row(recovery),
        "subtraction_caption": subtraction_caption(recovery),
    }


def machine_facts_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    sources = recovery.get("source_surfaces") or {}
    operator = sources.get("operator_hardware") or {}
    hardware = sources.get("hardware_machine") or {}
    appliance = sources.get("appliance_identity") or {}
    shop = sources.get("shop_device") or {}
    admission = sources.get("admission_record") or {}
    ssh = sources.get("ssh_target") or {}
    proof = admission.get("proof") or {}
    claim_path = proof.get("proof_ref")
    claim = load_json_file(claim_path)
    claim_facts = claim.get("machine_facts") if isinstance(claim.get("machine_facts"), dict) else {}
    operator_facts = operator.get("machine_facts") if isinstance(operator.get("machine_facts"), dict) else {}
    hardware_facts = hardware.get("machine_facts") if isinstance(hardware.get("machine_facts"), dict) else {}
    appliance_facts = appliance.get("machine_facts") if isinstance(appliance.get("machine_facts"), dict) else {}
    shop_facts = {
        "product_name": first_present(shop.get("model"), shop.get("name")),
        "sys_vendor": shop.get("vendor"),
        "os_pretty": shop.get("os"),
        "nic_summary": first_present(
            (shop.get("network_config") or {}).get("wifi_interface"),
            "shop registry network evidence",
        ),
    } if shop else {}
    inventory_facts = {**appliance_facts, **hardware_facts, **operator_facts, **shop_facts}

    known = compact_dict(
        {
            "device_id": first_present(operator.get("device_id"), admission.get("machine_id"), shop.get("id"), claim.get("device_id")),
            "machine_id": first_present(hardware.get("machine_id"), admission.get("machine_id"), shop.get("id")),
            "appliance_id": appliance.get("appliance_id"),
            "hostname": first_present(claim.get("hostname"), hardware.get("hostname"), appliance.get("hostname"), shop.get("hostname"), ssh.get("id")),
            "model": first_present(claim_facts.get("product_name"), inventory_facts.get("product_name"), hardware.get("model"), operator.get("model"), appliance.get("model"), admission.get("model")),
            "vendor": first_present(claim_facts.get("sys_vendor"), inventory_facts.get("sys_vendor")),
            "serial": first_present(claim_facts.get("serial"), inventory_facts.get("serial"), hardware.get("service_tag")),
            "platform": first_present(operator.get("platform"), claim.get("target_platform_truth"), "windows" if str(shop.get("os") or "").lower().startswith("windows") else None),
            "site": first_present(operator.get("site"), hardware.get("site"), appliance.get("site"), admission.get("site"), ssh.get("site"), "shop" if shop else None),
            "os": first_present(claim_facts.get("os_pretty"), inventory_facts.get("os_pretty"), hardware.get("os"), appliance.get("appliance_os")),
            "kernel": first_present(claim_facts.get("kernel"), inventory_facts.get("kernel")),
            "arch": first_present(claim_facts.get("arch"), inventory_facts.get("arch")),
            "cpu_model": first_present(claim_facts.get("cpu_model"), inventory_facts.get("cpu_model")),
            "cpu_threads": first_present(claim_facts.get("cpu_threads"), inventory_facts.get("cpu_threads")),
            "memory_bytes": first_present(claim_facts.get("memory_bytes"), inventory_facts.get("memory_bytes")),
            "storage_summary": first_present(claim_facts.get("storage_summary"), inventory_facts.get("storage_summary")),
            "nic_summary": first_present(claim_facts.get("nic_summary"), inventory_facts.get("nic_summary")),
            "bios_version": first_present(claim_facts.get("bios_version"), inventory_facts.get("bios_version")),
            "lan_ip": declared_lan_ip(hardware, ssh, shop, appliance),
            "tailscale_ip": first_present(claim.get("tailscale_ip"), operator.get("tailscale_ip"), hardware.get("tailscale_ip"), ssh.get("tailscale_ip"), shop.get("tailscale_ip")),
            "mac": first_present(ssh.get("mac"), shop.get("mac")),
            "l3_role": shop.get("role"),
            "bootstrap_claim": claim_path,
        }
    )
    required_fact_fields = [
        "cpu_model",
        "cpu_threads",
        "memory_bytes",
        "storage_summary",
        "nic_summary",
    ]
    missing_fields = [field for field in required_fact_fields if known.get(field) in (None, "", [], {})]
    source_ownership = {
        "machine_facts": "firstboot claim machine_facts when present; otherwise canonical inventory fact fields",
        "admission_proof": "ops/bindings/fleet.admission.classification.yaml",
        "operator_inventory": "ops/bindings/operator.hardware.inventory.yaml",
        "hardware_inventory": "ops/bindings/hardware.inventory.yaml",
        "appliance_identity": "ops/bindings/appliance.identity.contract.yaml",
        "access_path": "ops/bindings/ssh.targets.yaml",
        "shop_function_projection": "ops/bindings/shop.device.registry.yaml",
    }
    if claim_path:
        source_ownership["firstboot_claim"] = claim_path

    return {
        "known": known,
        "missing_fields": missing_fields,
        "source_ownership": source_ownership,
        "claim_loaded": bool(claim),
    }


def machine_spec_row_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    row = row_from_recovery(recovery)
    sources = recovery.get("source_surfaces") or {}
    admission = sources.get("admission_record") or {}
    operator = sources.get("operator_hardware") or {}
    proof = admission.get("proof") or {}
    row["machine_spec"] = machine_facts_from_recovery(recovery)
    row["setup_correctness"] = {
        "admission_proof": compact_dict(
            {
                "ssh_access_proved": proof.get("ssh_access_proved"),
                "bootstrap_completed": proof.get("bootstrap_completed"),
                "identity_enrolled": proof.get("identity_enrolled"),
                "runtime_posture_verified": proof.get("runtime_posture_verified"),
                "first_boot_claim": proof.get("first_boot_claim"),
                "proof_ref": proof.get("proof_ref"),
            }
        ),
        "activation_statement": "machine facts are admission evidence only; no role promotion, runtime duty, or placement assignment is implied",
    }
    row["role_suitability"] = {
        "candidate_roles": as_list(operator.get("role_candidacy")) or row.get("role_candidacy") or ["none"],
        "eligibility_state": row.get("eligibility_state"),
        "known_constraints": as_list(operator.get("known_constraints")),
        "assignment_made": False,
        "suitability_basis": "node admission composes evidence; role delivery still follows node promotion ladder",
    }
    return row


def golden_path_row_from_recovery(recovery: dict[str, Any]) -> dict[str, Any]:
    row = machine_spec_row_from_recovery(recovery)
    spec = row.get("machine_spec") or {}
    known = spec.get("known") or {}
    missing = spec.get("missing_fields") or []
    placement = row.get("placement_truth") or {}
    runtime = row.get("runtime_obligations") or {}
    proof = ((row.get("setup_correctness") or {}).get("admission_proof") or {})
    stages = [
        {
            "stage": "first_touch",
            "state": row.get("first_touch_state") or "unknown",
            "proof": first_present(proof.get("first_boot_claim"), proof.get("proof_ref"), default="missing"),
        },
        {
            "stage": "machine_facts",
            "state": "complete" if not missing else "missing_fields",
            "known_fields": sorted(known.keys()),
            "missing_fields": missing,
        },
        {
            "stage": "node_admission",
            "state": row.get("admission_state") or "unknown",
            "proof": first_present(proof.get("proof_ref"), default="node.recovery.status composition"),
        },
        {
            "stage": "placement",
            "state": first_present(placement.get("placement_status"), default="unknown"),
            "required_vm_targets": placement.get("required_vm_targets") or [],
        },
        {
            "stage": "runtime",
            "state": "active" if runtime.get("active_runtime_roles") else row.get("lifecycle_state"),
            "active_runtime_roles": runtime.get("active_runtime_roles") or [],
        },
        {
            "stage": "receipts",
            "state": "present" if proof.get("proof_ref") or proof.get("first_boot_claim") else "readback_only",
            "refs": [ref for ref in [proof.get("proof_ref"), proof.get("first_boot_claim")] if ref],
        },
    ]
    blockers = []
    if missing:
        blockers.append("machine_facts_missing")
    if row.get("admission_state") not in {"admitted", "candidate"}:
        blockers.append("admission_not_complete")
    if (placement.get("placement_status") or "unknown") in {"", "unknown", "unassigned"}:
        blockers.append("placement_not_declared")
    row["golden_path"] = {
        "packet": "PACKET-534-NODE-PROVISIONING-RUNTIME-GOLDEN-PATH",
        "definition": "first_touch -> machine_facts -> node_admission -> placement -> runtime -> receipts",
        "stages": stages,
        "state": "ready" if not blockers else "incomplete",
        "blockers": blockers,
        "stop_line": "read-only proof path; does not promote, place, or mutate the node",
    }
    return row


def all_node_ids() -> list[str]:
    return run_lines([str(NODE_RECOVERY_STATUS), "--list"])


def recovery_for(node_id: str) -> dict[str, Any]:
    return run_json([str(NODE_RECOVERY_STATUS), "--node", node_id, "--json"])


def build_rows(node_id: str | None, machine_spec: bool = False, golden_path: bool = False) -> list[dict[str, Any]]:
    ids = [node_id] if node_id else all_node_ids()
    rows: list[dict[str, Any]] = []
    for item in ids:
        recovery = recovery_for(item)
        if golden_path:
            rows.append(golden_path_row_from_recovery(recovery))
        elif machine_spec:
            rows.append(machine_spec_row_from_recovery(recovery))
        else:
            rows.append(row_from_recovery(recovery))
    return rows


def emit_human(rows: list[dict[str, Any]], machine_spec: bool = False, golden_path: bool = False) -> None:
    print("============================================================")
    print("  node.admission.status")
    print("============================================================")
    print("")
    print("Canonical node admission readback. Inventory identifies subjects;")
    print("admission/promotion proof decides node truth.")
    print("")
    for row in rows:
        print(f"- {row['node_id']}")
        print(f"  kind:       {row['object_kind']}")
        print(f"  site:       {row['site']}")
        print(f"  lifecycle:  {row['lifecycle_state']}")
        print(f"  admission:  {row['admission_state']} / {row['first_touch_state']}")
        print(f"  candidacy:  {', '.join(str(v) for v in row['role_candidacy'])}")
        print(f"  promotion:  {row['promotion_stage']}")
        print(f"  access:     {(row.get('access_path') or {}).get('host', 'none')}")
        print(f"  recovery:   {json.dumps(row.get('recovery_planes') or {}, sort_keys=True)}")
        if machine_spec:
            spec = row.get("machine_spec") or {}
            print(f"  spec_known: {json.dumps(spec.get('known') or {}, sort_keys=True)}")
            print(f"  spec_missing_fields: {', '.join(spec.get('missing_fields') or []) or 'none'}")
            print("  role_assignment: none")
        if golden_path:
            path = row.get("golden_path") or {}
            print(f"  golden_path: {path.get('state')}")
            print(f"  blockers:    {', '.join(path.get('blockers') or []) or 'none'}")
            for stage in path.get("stages") or []:
                print(f"    - {stage.get('stage')}: {stage.get('state')}")
        print(f"  subtracts:  {row['subtraction_caption']}")
        print("")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Canonical node admission readback. Read-only; does not promote nodes."
    )
    parser.add_argument("--node", help="Limit readback to one governed subject")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    parser.add_argument("--list", action="store_true", help="List governed subject IDs")
    parser.add_argument("--machine-spec", action="store_true", help="Include machine facts from bootstrap claim and canonical inventories")
    parser.add_argument("--golden-path", action="store_true", help="Include first-touch -> runtime proof path for Packet 534")
    args = parser.parse_args()

    if args.list:
        for node_id in all_node_ids():
            print(node_id)
        return

    rows = build_rows(args.node, machine_spec=args.machine_spec, golden_path=args.golden_path)
    payload = {
        "capability": "node.admission.status",
        "status": "ok",
        "mode": "golden_path" if args.golden_path else "machine_spec" if args.machine_spec else "admission",
        "canonical_authority": "node.admission.status",
        "recovery_evidence": "node.recovery.status",
        "subtracted_peer_authority": [
            "ops/bindings/home.hardware.inventory.yaml",
            "ops/bindings/internet.asset.registry.yaml",
            "ops/bindings/operator.hardware.inventory.yaml",
            "ops/bindings/fleet.admission.classification.yaml",
            "ops/bindings/ssh.targets.yaml",
            "ops/bindings/shop.device.registry.yaml",
        ],
        "rows": rows,
    }

    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        emit_human(rows, machine_spec=args.machine_spec, golden_path=args.golden_path)


if __name__ == "__main__":
    main()
