#!/usr/bin/env bash
set -euo pipefail

# infra-proxmox-power-control — Out-of-band power control via iDRAC
# Mutating. Power on/off/cycle the physical host via IPMI.
#
# Usage:
#   infra-proxmox-power-control on [--execute]
#   infra-proxmox-power-control off [--execute]
#   infra-proxmox-power-control cycle [--execute]
#   infra-proxmox-power-control status
#
# Dry-run by default. Pass --execute to actually send the IPMI command.

SPINE_ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
source "$SPINE_ROOT/ops/lib/ssh-resolve.sh"

SSH_BINDING="${SPINE_ROOT}/ops/bindings/ssh.targets.yaml"
IDRAC_IP="$(yq -r '.ssh.targets[] | select(.id == "idrac-shop") | .host // "192.168.1.250"' "$SSH_BINDING" 2>/dev/null | head -n1)"
JUMP_HOST_ID="$(yq -r '.ssh.targets[] | select(.id == "idrac-shop") | .probe_via // ""' "$SSH_BINDING" 2>/dev/null | head -n1)"
RECOVERY_ACCESS="$(yq -r '.ssh.targets[] | select(.id == "idrac-shop") | .recovery_access // "direct_lan_only"' "$SSH_BINDING" 2>/dev/null | head -n1)"

usage() {
    cat <<'EOF'
infra-proxmox-power-control — iDRAC power control

Usage:
  infra-proxmox-power-control status
  infra-proxmox-power-control on [--execute]
  infra-proxmox-power-control off [--execute]
  infra-proxmox-power-control cycle [--execute]

Dry-run by default. Pass --execute to send the IPMI command.
Recovery access is direct LAN only (192.168.1.250).
When on shop LAN, uses direct IPMI. When off-LAN and hypervisor
is up, falls back to probe_via jump host for convenience.
EOF
}

ACTION="${1:-}"
shift || true
EXECUTE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --execute) EXECUTE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) shift ;;
    esac
done

[[ -n "$ACTION" ]] || { usage >&2; exit 2; }

case "$ACTION" in
    on|off|cycle|status) ;;
    *) echo "FAIL: unknown action '$ACTION' (expected on|off|cycle|status)" >&2; exit 2 ;;
esac

# Resolve credentials
CREDS_SCRIPT="$SPINE_ROOT/ops/lib/infisical-agent.sh"
IDRAC_USER=""
IDRAC_PASS=""

if [[ -f "$CREDS_SCRIPT" ]]; then
    source "$CREDS_SCRIPT" 2>/dev/null || true
    IDRAC_USER="${IDRAC_ADMIN_USER:-}"
    IDRAC_PASS="${IDRAC_ADMIN_PASSWORD:-}"
fi

if [[ -z "$IDRAC_USER" || -z "$IDRAC_PASS" ]]; then
    echo "WARN: iDRAC credentials not available from Infisical. Trying environment." >&2
    IDRAC_USER="${IDRAC_USER:-${IDRAC_ADMIN_USER:-root}}"
    IDRAC_PASS="${IDRAC_PASS:-${IDRAC_ADMIN_PASSWORD:-}}"
fi

if [[ -z "$IDRAC_PASS" ]]; then
    echo "FAIL: iDRAC password not available. Set IDRAC_ADMIN_PASSWORD or configure Infisical." >&2
    exit 1
fi

# Resolve access path: direct LAN first (recovery path), jump host fallback (convenience)
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)

USE_DIRECT=false
SSH_HOST=""
SSH_USER=""
ACCESS_PATH=""

# Try direct LAN first (the truthful recovery path)
if ping -c 1 -W 2 "$IDRAC_IP" >/dev/null 2>&1; then
    USE_DIRECT=true
    ACCESS_PATH="direct_lan"
elif [[ -n "$JUMP_HOST_ID" && "$JUMP_HOST_ID" != "null" ]]; then
    SSH_HOST="$(ssh_resolve_ssh_host_with_fallback "$JUMP_HOST_ID" 2>/dev/null | awk '{print $1}' || true)"
    SSH_USER="$(ssh_resolve_user "$JUMP_HOST_ID" 2>/dev/null || echo root)"
    if [[ -n "$SSH_HOST" && "$SSH_HOST" != "unreachable" ]]; then
        ACCESS_PATH="jump_via_${JUMP_HOST_ID}"
    else
        ACCESS_PATH="unreachable"
    fi
else
    ACCESS_PATH="unreachable"
fi

run_ipmi() {
    local ipmi_cmd="$1"
    if $USE_DIRECT; then
        # Direct LAN (recovery path)
        ipmitool -I lanplus -H "$IDRAC_IP" -U "$IDRAC_USER" -P "$IDRAC_PASS" $ipmi_cmd 2>&1
    elif [[ -n "$SSH_HOST" && "$SSH_HOST" != "unreachable" ]]; then
        # Via jump host (convenience path)
        ssh "${SSH_OPTS[@]}" "${SSH_USER}@${SSH_HOST}" \
            "ipmitool -I lanplus -H $IDRAC_IP -U $(printf '%q' "$IDRAC_USER") -P $(printf '%q' "$IDRAC_PASS") $ipmi_cmd" 2>&1
    else
        echo "FAIL: iDRAC unreachable — direct LAN failed, no jump host available" >&2
        return 1
    fi
}

echo "=== PVE POWER CONTROL ==="
echo "iDRAC: $IDRAC_IP"
echo "access_path: ${ACCESS_PATH}"
echo "recovery_access: ${RECOVERY_ACCESS}"
echo ""

case "$ACTION" in
    status)
        echo "-- Power Status --"
        run_ipmi "power status" || echo "FAIL: IPMI unreachable"
        ;;
    on)
        if [[ "$EXECUTE" -eq 0 ]]; then
            echo "DRY RUN: would send 'power on' via IPMI"
            echo "Pass --execute to actually power on."
        else
            echo "Sending power on..."
            run_ipmi "power on"
        fi
        ;;
    off)
        if [[ "$EXECUTE" -eq 0 ]]; then
            echo "DRY RUN: would send 'power off' via IPMI"
            echo "Pass --execute to actually power off."
            echo "WARNING: This is a hard power off. Use host.control for graceful shutdown."
        else
            echo "Sending power off..."
            run_ipmi "power off"
        fi
        ;;
    cycle)
        if [[ "$EXECUTE" -eq 0 ]]; then
            echo "DRY RUN: would send 'power cycle' via IPMI"
            echo "Pass --execute to actually power cycle."
        else
            echo "Sending power cycle..."
            run_ipmi "power cycle"
        fi
        ;;
esac
