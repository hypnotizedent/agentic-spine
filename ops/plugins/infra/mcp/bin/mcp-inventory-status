#!/usr/bin/env bash
set -euo pipefail

SPINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$SPINE_ROOT/ops/plugins/infra/lib/workbench-paths.sh"
WORKBENCH="$(workbench_repo_root)"
CHECK="$WORKBENCH/scripts/root/mcp/mcp-inventory-check.sh"

if [[ ! -x "$CHECK" ]]; then
  echo "STOP: missing or non-executable MCP inventory check: $CHECK" >&2
  exit 2
fi

exec "$CHECK"
