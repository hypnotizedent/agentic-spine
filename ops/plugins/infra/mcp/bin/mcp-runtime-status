#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml


ROOT = Path(__file__).resolve().parents[5]
CONTRACT = ROOT / "ops" / "bindings" / "mcp.runtime.contract.yaml"
WORKTREE_CONTRACT = ROOT / "ops" / "bindings" / "worktree.lifecycle.contract.yaml"


def fail(message: str) -> "NoReturn":
    print(f"mcp.runtime.status FAIL: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_contract() -> dict:
    if not CONTRACT.is_file():
        fail(f"missing contract: {CONTRACT}")
    data = yaml.safe_load(CONTRACT.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        fail(f"invalid contract shape: {CONTRACT}")
    return data


def load_worktree_policy() -> dict:
    if not WORKTREE_CONTRACT.is_file():
        return {}
    data = yaml.safe_load(WORKTREE_CONTRACT.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        return {}
    policy = data.get("policy", {}) or {}
    return policy if isinstance(policy, dict) else {}


WORKTREE_POLICY = load_worktree_policy()
CONTROL_ROOT = Path(str(WORKTREE_POLICY.get("launcher_control_worktree_path", ROOT))).expanduser()


def resolve_surface_path(surface: str, raw: str) -> Path:
    path = Path(str(raw)).expanduser()
    if surface != "codex":
        return path
    try:
        relative = path.relative_to(CONTROL_ROOT)
    except ValueError:
        return path
    return ROOT / relative


def load_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        fail(f"invalid JSON in {path}: {exc}")
    return data if isinstance(data, dict) else {}


def collect_codex(path: Path) -> dict[str, bool]:
    data = load_json(path)
    servers = data.get("mcpServers", {})
    if not isinstance(servers, dict):
        return {}
    return {name: True for name in servers}


def collect_opencode(path: Path) -> dict[str, bool]:
    data = load_json(path)
    servers = data.get("mcp", {})
    if not isinstance(servers, dict):
        return {}
    result: dict[str, bool] = {}
    for name, config in servers.items():
        enabled = True
        if isinstance(config, dict):
            enabled = bool(config.get("enabled", True))
        result[str(name)] = enabled
    return result


def read_opencode_debug_config(pure: bool = False) -> tuple[dict | None, str | None]:
    command = ["opencode"]
    if pure:
        command.append("--pure")
    command.extend(["debug", "config"])
    try:
        with tempfile.NamedTemporaryFile(mode="w+", encoding="utf-8") as handle:
            proc = subprocess.run(
                command,
                cwd=ROOT,
                stdout=handle,
                stderr=subprocess.PIPE,
                text=True,
                timeout=30,
                check=False,
            )
            handle.seek(0)
            stdout = handle.read()
    except FileNotFoundError:
        return None, "opencode binary not found"
    except subprocess.TimeoutExpired:
        mode = "pure" if pure else "resolved"
        return None, f"opencode debug config ({mode}) timed out"

    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        mode = "pure" if pure else "resolved"
        return None, f"opencode debug config ({mode}) failed: {detail or f'exit {proc.returncode}'}"

    try:
        data = json.loads(stdout)
    except json.JSONDecodeError as exc:
        mode = "pure" if pure else "resolved"
        return None, f"opencode debug config ({mode}) returned invalid JSON: {exc}"

    if not isinstance(data, dict):
        mode = "pure" if pure else "resolved"
        return None, f"opencode debug config ({mode}) did not return a JSON object"
    return data, None


def extract_opencode_runtime(config: dict | None) -> dict[str, bool]:
    if not isinstance(config, dict):
        return {}
    mcp = config.get("mcp", {})
    if not isinstance(mcp, dict):
        return {}
    result: dict[str, bool] = {}
    for name, entry in mcp.items():
        enabled = True
        if isinstance(entry, dict):
            enabled = bool(entry.get("enabled", True))
        result[str(name)] = enabled
    return result


def config_count(config: dict | None, key: str) -> int | None:
    if not isinstance(config, dict):
        return None
    value = config.get(key)
    if not isinstance(value, dict):
        return None
    return len(value)


def collect_effective_opencode_runtime() -> tuple[dict[str, bool], dict[str, bool], dict[str, int | None], list[str]]:
    warnings: list[str] = []

    resolved_cfg, resolved_warning = read_opencode_debug_config(pure=False)
    if resolved_warning:
        warnings.append(resolved_warning)
    pure_cfg, pure_warning = read_opencode_debug_config(pure=True)
    if pure_warning:
        warnings.append(pure_warning)

    return (
        extract_opencode_runtime(resolved_cfg),
        extract_opencode_runtime(pure_cfg),
        {
            "resolved_command_count": config_count(resolved_cfg, "command"),
            "resolved_agent_count": config_count(resolved_cfg, "agent"),
            "pure_command_count": config_count(pure_cfg, "command"),
            "pure_agent_count": config_count(pure_cfg, "agent"),
        },
        warnings,
    )


def collect_claude_desktop(config_path: Path, runtime_path: Path, project_path: str) -> dict[str, bool]:
    result: dict[str, bool] = {}

    config = load_json(config_path)
    static_servers = config.get("mcpServers", {})
    if isinstance(static_servers, dict):
        for name in static_servers:
            result[str(name)] = True

    runtime = load_json(runtime_path)
    runtime_servers = runtime.get("mcpServers", {})
    if isinstance(runtime_servers, dict):
        for name in runtime_servers:
            result[str(name)] = True

    projects = runtime.get("projects", {})
    if isinstance(projects, dict):
        project = projects.get(project_path, {})
        if isinstance(project, dict):
            project_servers = project.get("mcpServers", {})
            if isinstance(project_servers, dict):
                for name in project_servers:
                    result[str(name)] = True
            enabled_mcpjson = project.get("enabledMcpjsonServers", [])
            if isinstance(enabled_mcpjson, list):
                for name in enabled_mcpjson:
                    result[str(name)] = True

    return result


def main() -> int:
    contract = load_contract()
    aliases = contract.get("aliases", {}) or {}
    required_by_surface = contract.get("required_servers_by_surface", {}) or {}
    surface_paths = contract.get("surface_paths", {}) or {}
    claude_project = str(contract.get("claude_project_path", Path.home()))

    errors = 0
    warnings = 0

    print("mcp.runtime.status")
    print(f"contract: {CONTRACT}")
    print("")

    for surface in required_by_surface:
        config_path_value = surface_paths.get(surface)
        if not config_path_value:
            print(f"[{surface}] WARN: no surface path configured")
            warnings += 1
            print("")
            continue

        config_path = resolve_surface_path(surface, str(config_path_value))
        print(f"[{surface}]")
        print(f"  config: {config_path}")

        discovered: dict[str, bool]
        if surface == "codex":
            discovered = collect_codex(config_path)
        elif surface == "opencode":
            discovered = collect_opencode(config_path)
        elif surface == "claude_desktop":
            runtime_path = Path(str(surface_paths.get("claude_desktop_runtime_state", ""))).expanduser()
            print(f"  runtime_state: {runtime_path}")
            if not runtime_path.is_file():
                print(f"  WARN: runtime state file missing ({runtime_path})")
                warnings += 1
            discovered = collect_claude_desktop(config_path, runtime_path, claude_project)
        else:
            discovered = {}

        if not config_path.is_file():
            print("  FAIL: config file missing")
            errors += 1
            print("")
            continue

        if discovered:
            print("  discovered:")
            for name, enabled in sorted(discovered.items()):
                print(f"    - {name} (enabled={str(enabled).lower()})")
        else:
            print("  WARN: no MCP servers discovered")
            warnings += 1

        for required in required_by_surface.get(surface, []):
            candidates = [required, *list(aliases.get(required, []) or [])]
            matches = [(name, enabled) for name, enabled in discovered.items() if name in candidates]
            if not matches:
                print(f"  FAIL: required server '{required}' not registered")
                errors += 1
                continue
            if not any(enabled for _, enabled in matches):
                print(f"  FAIL: required server '{required}' found but disabled")
                errors += 1
                continue
            match_name = next(name for name, enabled in matches if enabled)
            if match_name == required:
                print(f"  PASS: required '{required}' registered+enabled")
            else:
                print(f"  PASS: required '{required}' resolved via alias '{match_name}'")

        if surface == "opencode":
            resolved_runtime, pure_runtime, runtime_counts, runtime_warnings = collect_effective_opencode_runtime()
            if runtime_warnings:
                warnings += len(runtime_warnings)
                for warning in runtime_warnings:
                    print(f"  WARN: {warning}")
            if resolved_runtime:
                print("  resolved_runtime:")
                for name, enabled in sorted(resolved_runtime.items()):
                    print(f"    - {name} (enabled={str(enabled).lower()})")
            if pure_runtime:
                print("  pure_runtime:")
                for name, enabled in sorted(pure_runtime.items()):
                    print(f"    - {name} (enabled={str(enabled).lower()})")
            extra_over_managed = sorted(name for name in resolved_runtime if name not in discovered)
            extra_over_pure = sorted(name for name in resolved_runtime if name not in pure_runtime)
            if extra_over_managed:
                warnings += 1
                print(f"  WARN: extra resolved servers beyond managed config: {', '.join(extra_over_managed)}")
            if extra_over_pure:
                print(f"  plugin/runtime-added servers: {', '.join(extra_over_pure)}")
            resolved_command_count = runtime_counts.get("resolved_command_count")
            resolved_agent_count = runtime_counts.get("resolved_agent_count")
            pure_command_count = runtime_counts.get("pure_command_count")
            pure_agent_count = runtime_counts.get("pure_agent_count")
            if resolved_command_count is not None or resolved_agent_count is not None:
                print(
                    "  resolved_registry:"
                    f" commands={resolved_command_count if resolved_command_count is not None else 'n/a'}"
                    f" agents={resolved_agent_count if resolved_agent_count is not None else 'n/a'}"
                )
            if pure_command_count is not None or pure_agent_count is not None:
                print(
                    "  pure_registry:"
                    f" commands={pure_command_count if pure_command_count is not None else 'n/a'}"
                    f" agents={pure_agent_count if pure_agent_count is not None else 'n/a'}"
                )

        print("")

    print(f"summary: errors={errors} warnings={warnings}")
    return 0 if errors == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
