[Unit]
Description=Spine execution_host workload: com.ronny.rag-direct-incremental-daily
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/code/agentic-spine/ops/plugins/core/bin/rag-direct-incremental-daily.sh
WorkingDirectory=/home/ubuntu/code/agentic-spine
Environment="SPINE_ROOT=/home/ubuntu/code/agentic-spine"
Environment="SPINE_STATE=/home/ubuntu/code/.runtime/spine/state"
Environment="SPINE_OPERATOR_TZ=America/New_York"
Environment="TZ=America/New_York"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin"

[Install]
WantedBy=multi-user.target
