[Unit]
Description=Spine execution_host workload: com.ronny.human-intent-artifact-trigger
# Source label: com.ronny.human-intent-artifact-trigger
# Note: uses the rsync'd state root so heartbeat/snapshot live beside OI YAML.
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/code/agentic-spine/ops/plugins/core/lifecycle/bin/human-intent-artifact-trigger-once --include-default-roots
WorkingDirectory=/home/ubuntu/code/agentic-spine
Environment="SPINE_ROOT=/home/ubuntu/code/agentic-spine"
Environment="SPINE_STATE=/home/ubuntu/code/.runtime/spine/state"
# Override HUMAN_INTENT_ARTIFACT_ROOTS when admitted roots are synced to execution_host.
Environment="SPINE_OPERATOR_TZ=America/New_York"
Environment="TZ=America/New_York"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin"

[Install]
WantedBy=multi-user.target
