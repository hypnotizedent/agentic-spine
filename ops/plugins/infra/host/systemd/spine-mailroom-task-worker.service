[Unit]
Description=Spine execution_host workload: com.ronny.mailroom-task-worker
After=network-online.target tailscaled.service
Wants=tailscaled.service
# Secrets dependency: this unit does not bootstrap INFISICAL_* env. Worker-spawned
# capability subprocesses resolve provider secrets via
# ops/plugins/providers/bin/infisical-agent.sh, which sources
# ~/.config/infisical/credentials when env vars are unset. This host MUST
# satisfy ops/bindings/secrets.credentials.parity.yaml (ai-consolidation
# entry, required:true) and the secrets_credentials_present_proof named in
# ops/bindings/node.role.contract.yaml#execution_host.required_proofs. Verify
# with: ./bin/ops cap run secrets.credentials.parity

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do ip link show tailscale0 >/dev/null 2>&1 && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/python3 /home/ubuntu/code/agentic-spine/ops/plugins/infra/mailroom-bridge/bin/mailroom-task-worker --foreground --worker-id SPINE-MAILROOM-EXECUTION-HOST --poll-seconds 90 --claim-limit 3
WorkingDirectory=/home/ubuntu/code/agentic-spine
Environment="HOME=/home/ubuntu"
Environment="SPINE_ROOT=/home/ubuntu/code/agentic-spine"
Environment="SPINE_REPO=/home/ubuntu/code/agentic-spine"
Environment="SPINE_CODE=/home/ubuntu/code/agentic-spine"
Environment="SPINE_WORKSPACE_ROOT=/home/ubuntu/code"
Environment="SPINE_RUNTIME_ROOT=/home/ubuntu/code/.runtime/spine"
Environment="SPINE_STATE=/home/ubuntu/code/.runtime/spine/state"
Environment="SPINE_EVIDENCE_ROOT=/home/ubuntu/code/.evidence/spine"
Environment="SPINE_LOGS=/home/ubuntu/code/.runtime/spine/logs"
Environment="SPINE_RUNTIME_PATH_TEST_OVERRIDE=1"
Environment="SPINE_ROLE_POLICY_OVERRIDE_REF=com.ronny.mailroom-task-worker"
Environment="SPINE_ROLE_POLICY_OVERRIDE_REASON=declared active standing_program in launchd.scheduler.registry.yaml for execution_host mailroom runtime"
Environment="SPINE_OPERATOR_TZ=America/New_York"
Environment="TZ=America/New_York"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
