[Unit]
Description=Spine execution_host workload: com.ronny.operator-ingress-auto-metabolizer
# Source label: com.ronny.operator-ingress-auto-metabolizer
# Plist source: com.ronny.operator-ingress-auto-metabolizer.plist
# Note: does NOT use shared execution-host.env because SPINE_STATE must point to
# the rsync'd state root (where operator-surface-server writes OI files), not /opt/spine-state.
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/code/agentic-spine/ops/plugins/core/lifecycle/bin/operator-ingress-auto-metabolizer --foreground --worker-id operator-ingress-auto-metabolizer --poll-seconds 60 --batch-limit 10
WorkingDirectory=/home/ubuntu/code/agentic-spine
Environment="SPINE_ROOT=/home/ubuntu/code/agentic-spine"
Environment="SPINE_STATE=/home/ubuntu/code/.runtime/spine/state"
Environment="SPINE_OPERATOR_TZ=America/New_York"
Environment="TZ=America/New_York"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/snap/bin"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
