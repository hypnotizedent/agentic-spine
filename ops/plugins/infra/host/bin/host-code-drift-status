#!/usr/bin/env python3
"""infra.host.code.drift.status — read-only host code drift readback.

Reports per-host from ops/bindings/runtime.checkout.placement.yaml:
- checkout HEAD vs origin/main HEAD
- dirty worktree state
- reachability
- update class for infra.host.code.deploy.update

NO mutation. NO automatic pull. NO rsync. NO host modification.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

try:
    import yaml
except ImportError as exc:  # pragma: no cover - verifier hosts have PyYAML.
    print(f"PyYAML required: {exc}", file=sys.stderr)
    sys.exit(2)


CONNECT_TIMEOUT_SECONDS = 3


def _run(cmd: list[str], timeout: int = 30) -> tuple[int, str, str]:
    """Run a command and return (rc, stdout, stderr)."""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, proc.stdout, proc.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"command timed out after {timeout}s"
    except FileNotFoundError as exc:
        return 127, "", str(exc)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[5]


def load_placement() -> dict[str, Any]:
    placement = repo_root() / "ops" / "bindings" / "runtime.checkout.placement.yaml"
    with placement.open("r", encoding="utf-8") as fh:
        return yaml.safe_load(fh) or {}


def _ssh_cmd(host: dict[str, Any], target: str) -> list[str]:
    cmd = [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={CONNECT_TIMEOUT_SECONDS}",
    ]
    if host.get("ssh_key"):
        cmd.extend(["-i", os.path.expanduser(str(host["ssh_key"]))])
    cmd.append(target)
    return cmd


def _normalize_host(checkout: dict[str, Any]) -> dict[str, Any]:
    return {
        "name": checkout.get("host_id"),
        "role": checkout.get("role"),
        "reach": checkout.get("reach"),
        "checkout": checkout.get("path"),
        "ssh_targets": checkout.get("ssh_targets") or [],
        "ssh_key": checkout.get("ssh_key"),
        "managed": bool(checkout.get("managed")),
        "exclusion_reason": checkout.get("exclusion_reason"),
    }


def probe_host(host: dict[str, Any], origin_head: str) -> dict[str, Any]:
    """Return a dict describing the host's drift state."""
    result: dict[str, Any] = {
        "name": host["name"],
        "role": host["role"],
        "checkout": host["checkout"],
        "reach": host["reach"],
        "head": None,
        "dirty": None,
        "status": "unknown",
        "note": None,
        "next_action": None,
    }

    if not host.get("managed"):
        result["status"] = "unmanaged_checkout"
        result["note"] = host.get("exclusion_reason") or "placement contract marks this checkout unmanaged"
        result["next_action"] = "none"
        return result

    head_cmd_remote = f"git -C {host['checkout']} rev-parse HEAD 2>/dev/null"
    dirty_cmd_remote = f"git -C {host['checkout']} status --porcelain 2>/dev/null"

    if host["reach"] == "local":
        rc_h, out_h, err_h = _run(["git", "-C", host["checkout"], "rev-parse", "HEAD"])
        rc_d, out_d, err_d = _run(["git", "-C", host["checkout"], "status", "--porcelain"])
    else:
        rc_h, out_h, err_h = 1, "", "no ssh targets declared"
        rc_d, out_d, err_d = 1, "", "no ssh targets declared"
        for target in host.get("ssh_targets") or []:
            ssh_base = _ssh_cmd(host, target)
            rc_h, out_h, err_h = _run(ssh_base + [head_cmd_remote], timeout=CONNECT_TIMEOUT_SECONDS + 5)
            if rc_h != 0:
                continue
            rc_d, out_d, err_d = _run(ssh_base + [dirty_cmd_remote], timeout=CONNECT_TIMEOUT_SECONDS + 5)
            result["reach_target"] = target
            break

    if rc_h != 0:
        result["status"] = "unreachable"
        result["note"] = f"head probe failed: {err_h.strip()[:200] or out_h.strip()[:200] or 'unknown'}"
        result["next_action"] = "restore reachability before infra.host.code.deploy.update"
        return result

    head_sha = out_h.strip()
    result["head"] = head_sha

    is_dirty = bool(out_d.strip()) if rc_d == 0 else None
    result["dirty"] = is_dirty

    if is_dirty is True:
        result["status"] = "dirty_blocked"
        result["note"] = "checkout has uncommitted local changes"
        result["next_action"] = "clean or commit local changes before infra.host.code.deploy.update"
    elif head_sha != origin_head:
        result["status"] = "behind_fixable"
        result["note"] = f"checkout HEAD {head_sha[:8]} != origin/main {origin_head[:8]}"
        result["next_action"] = "run infra.host.code.deploy.update"
    elif rc_d != 0:
        result["status"] = "attention"
        result["note"] = f"dirty probe failed: {err_d.strip()[:200] or 'unknown'}"
        result["next_action"] = "inspect checkout manually; dirty probe failed"
    else:
        result["status"] = "ok"
        result["next_action"] = "none"

    return result


def resolve_origin_head() -> tuple[str | None, str | None]:
    """Get origin/main HEAD from local repo (origin = canonical Gitea)."""
    rc, out, err = _run(["git", "-C", str(repo_root()), "rev-parse", "origin/main"])
    if rc != 0:
        return None, f"failed to resolve origin/main: {err.strip()[:200]}"
    return out.strip(), None


def main() -> int:
    parser = argparse.ArgumentParser(prog="infra.host.code.drift.status")
    parser.add_argument("--json", action="store_true", help="emit JSON only (default: human-readable)")
    parser.add_argument("--self-check", action="store_true", help="emit self-check pass and exit")
    args = parser.parse_args()

    placement = load_placement()
    if args.self_check:
        policy = placement.get("policy") or {}
        if policy.get("canonical_update_capability") != "infra.host.code.deploy.update":
            print("runtime.checkout.placement.yaml missing infra.host.code.deploy.update policy", file=sys.stderr)
            return 1
        print("infra.host.code.drift.status self-check PASS")
        return 0

    origin_head, err = resolve_origin_head()
    if origin_head is None:
        payload = {
            "capability": "infra.host.code.drift.status",
            "status": "fail",
            "error": err,
        }
        print(json.dumps(payload, indent=2))
        return 1

    hosts = [_normalize_host(c) for c in placement.get("checkouts") or []]
    hosts_result = [probe_host(h, origin_head) for h in hosts]

    statuses = {h["status"] for h in hosts_result}
    attention_statuses = {
        "dirty_blocked",
        "behind_fixable",
        "ahead_or_diverged_blocked",
        "unreachable",
        "attention",
    }
    if statuses & attention_statuses:
        overall = "attention"
    elif statuses <= {"ok", "unmanaged_checkout"}:
        overall = "ok"
    else:
        overall = "unknown"

    payload = {
        "capability": "infra.host.code.drift.status",
        "origin_main_head": origin_head,
        "overall_status": overall,
        "hosts": hosts_result,
        "placement_contract": "ops/bindings/runtime.checkout.placement.yaml",
        "canonical_update_capability": "infra.host.code.deploy.update",
        "scope_note": "PACKET-616 read-only drift readback; placement contract is source of truth. No mutation, no automatic pull, no rsync.",
    }

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("infra.host.code.drift.status")
        print(f"origin/main: {origin_head}")
        print(f"overall:     {overall}")
        for h in hosts_result:
            label = f"{h['name']:<22} ({h['role']})"
            line = f"  {label} {h['status']}"
            if h["status"] != "ok":
                line += f" — {h.get('note', '')}"
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
