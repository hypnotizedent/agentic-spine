#!/usr/bin/env python3
"""clerk.symptom.classify.and.file — friction clerk Phase 1.

PACKET-592 Phase 1 (under PACKET-588 plan): the clerk reads existing readbacks,
classifies symptoms, and files governed friction records so Ronny stops being
the manual bug router.

Reads (read-only):
- ops status --brief             (overall state class summary)
- verify.engine.run              (engine smoke result)
- runtime.checkout.drift.status  (per-host runtime checkout drift)
- infra.host.authority.reachability.status (LAN/Tailscale class per host)
- wave.residue                  (wave-owned residue / ambiguous cleanup state)
- ops loops list / scope state   (terminal proxy for watcher inputs)

Writes (mutating, via existing friction.ingest):
- One friction record per classified symptom
- friction.ingest does dedupe internally (5 matched of 1206 in current queue)

8-field record (encoded into existing friction schema):
| Field           | Where in friction.ingest                            |
|-----------------|-----------------------------------------------------|
| symptom         | --actual                                            |
| source receipt  | implicit (cap run key recorded by friction.ingest)  |
| affected auth   | embedded in --expected as "<authority> should ..."  |
| classification  | --capability prefix (e.g., authority_reachability)  |
| canonical home  | embedded in --expected                              |
| severity        | --severity                                          |
| allowed autonomy| embedded in --actual as "[autonomy: <class>]"       |
| next action     | embedded in --actual as "[next: <action>]"          |

Modes:
- default: dry-run JSON of would-be filings (read-only diagnosis)
- --file: actually invoke friction.ingest for each classified symptom

NO mutation in default mode. NO host modification. NO direct DB writes.
The clerk only writes via the existing governed friction.ingest cap.

Operator-mandated stop lines per PACKET-592 Phase 1 approval:
- No watcher move
- No host mutation except installing/enabling the clerk if shape is proven first
- No Forgejo, no forge runtime changes, no new VM
- No full spine.verify per terminal closeout
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

CANONICAL_PLANE_ACCESS_BINDING = (
    "ops/bindings/node.role.contract.yaml#canonical_plane_access.by_role"
)


def _local_hostname() -> str:
    try:
        return socket.gethostname().split(".")[0].lower()
    except Exception:
        return ""


def clerk_plane_access_role() -> str:
    """Clerk runs as a consumer of state/runtime symptoms; canonical filing
    happens via friction.ingest (routed to storage_evidence_node when
    db_authority is enabled)."""
    host = _local_hostname()
    if host == "pve":
        return "storage_evidence_node"
    if host.startswith("ai-cons") or "ai-consolidation" in host:
        return "execution_host"
    return "operator_console"


CONNECT_TIMEOUT = 8
SUBPROCESS_TIMEOUT = 30
ENTRY_POLICY_FRESH_WINDOW_MINUTES = 120

REPO_ROOT = Path(__file__).resolve().parents[5]


def _run(cmd: list[str], timeout: int = SUBPROCESS_TIMEOUT) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, proc.stdout, proc.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout}s"
    except FileNotFoundError as exc:
        return 127, "", str(exc)


def _extract_first_json_object(text: str) -> dict[str, Any] | None:
    decoder = json.JSONDecoder()
    for idx, ch in enumerate(text):
        if ch != "{":
            continue
        try:
            obj, _end = decoder.raw_decode(text[idx:])
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            return obj
    return None


def read_brief() -> dict[str, Any]:
    """Run ops status --brief and parse pipe-separated fields."""
    rc, out, err = _run([str(REPO_ROOT / "bin" / "ops"), "status", "--brief"])
    if rc != 0:
        return {"_error": err.strip()[:200] or "ops status --brief failed"}
    text = out.strip().splitlines()[0] if out.strip() else ""
    fields: dict[str, str] = {}
    for chunk in text.split("|"):
        chunk = chunk.strip()
        if ":" in chunk:
            k, _, v = chunk.partition(":")
            fields[k.strip()] = v.strip()
    return fields


def read_drift() -> dict[str, Any]:
    rc, out, err = _run([
        str(REPO_ROOT / "ops" / "plugins" / "infra" / "host" / "bin" / "host-code-drift-status"),
        "--json",
    ])
    if rc != 0:
        return {"_error": err.strip()[:200] or "drift readback failed"}
    try:
        return json.loads(out)
    except json.JSONDecodeError as exc:
        return {"_error": f"drift JSON parse: {exc}"}


def read_reachability() -> dict[str, Any]:
    rc, out, err = _run([
        str(REPO_ROOT / "ops" / "plugins" / "infra" / "host" / "bin" / "host-authority-reachability-status"),
        "--json",
    ])
    if rc != 0:
        return {"_error": err.strip()[:200] or "reachability readback failed"}
    try:
        return json.loads(out)
    except json.JSONDecodeError as exc:
        return {"_error": f"reachability JSON parse: {exc}"}


def read_wave_residue() -> dict[str, Any]:
    rc, out, err = _run([
        str(REPO_ROOT / "bin" / "ops"),
        "cap",
        "run",
        "wave.residue",
        "--",
        "--json",
    ])
    if rc != 0:
        return {"_error": err.strip()[:200] or "wave residue readback failed"}
    payload = _extract_first_json_object(out)
    if payload is None:
        return {"_error": "wave residue JSON parse: no JSON object in cap output"}
    return payload


def read_engine_smoke_status(brief: dict[str, str]) -> str:
    return brief.get("Engine", "unknown")


def read_spine_verify_status(brief: dict[str, str]) -> str:
    return brief.get("Spine", "unknown")


def _resolve_state_root() -> Path:
    configured = os.environ.get("SPINE_STATE", "").strip()
    if configured:
        return Path(configured).expanduser()
    return Path.home() / "code" / ".runtime" / "spine" / "state"


def _parse_simple_yaml(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return data
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or ":" not in stripped:
            continue
        key, _, value = stripped.partition(":")
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def _parse_utc(value: str) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def _is_fresh_heartbeat(record: dict[str, str], now: datetime) -> bool:
    expires_at = _parse_utc(record.get("expires_at", ""))
    if expires_at is not None:
        return expires_at > now
    heartbeat_at = _parse_utc(record.get("heartbeat_at", "") or record.get("last_heartbeat_utc", ""))
    if heartbeat_at is None:
        return False
    return now - heartbeat_at <= timedelta(minutes=ENTRY_POLICY_FRESH_WINDOW_MINUTES)


def read_entry_policy_signals() -> dict[str, Any]:
    """Read local signals that indicate agent-entry policy bypass risk.

    This is intentionally diagnostic only. The clerk does not decide the task
    class; it files potential bypass symptoms when existing telemetry shows
    work happening outside loop/packet/lane readback.
    """
    state_root = _resolve_state_root()
    now = datetime.now(timezone.utc)
    signals: dict[str, Any] = {
        "state_root": str(state_root),
        "fresh_unbound_root_terminals": [],
        "visible_worker_without_lane": [],
        "recent_commits_without_work_ref": [],
    }

    heartbeat_dirs = [
        state_root / "terminal-heartbeats",
        state_root / "terminals",
    ]
    for directory in heartbeat_dirs:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*")):
            if not path.is_file():
                continue
            record = _parse_simple_yaml(path)
            if not record or not _is_fresh_heartbeat(record, now):
                continue
            terminal_id = record.get("terminal_id", path.stem)
            role = record.get("role", "")
            loop_id = record.get("loop_id", "")
            branch = record.get("branch", "")
            lane_type = record.get("lane_type", "")
            checkout_root = record.get("checkout_root", "")
            is_unbound = (
                not loop_id
                or terminal_id.startswith("adhoc-")
                or terminal_id.startswith("attach-unset-")
            )
            is_root_main = lane_type == "root_main_integration" or (
                branch == "main" and checkout_root == str(REPO_ROOT)
            )
            if is_unbound and is_root_main:
                signals["fresh_unbound_root_terminals"].append({
                    "terminal_id": terminal_id,
                    "role": role or "unknown",
                    "branch": branch or "unknown",
                    "lane_type": lane_type or "unknown",
                    "heartbeat_path": str(path),
                })

            role_text = str(role or "").lower()
            terminal_text = str(terminal_id or "").lower()
            is_worker = "worker" in role_text or "worker" in terminal_text
            has_lane_telemetry = bool(loop_id or record.get("wave_id") or record.get("active_wave_id"))
            if is_worker and not has_lane_telemetry:
                signals["visible_worker_without_lane"].append({
                    "terminal_id": terminal_id,
                    "role": role or "unknown",
                    "heartbeat_path": str(path),
                })

    rc, out, _err = _run([
        "git",
        "-C",
        str(REPO_ROOT),
        "log",
        "--since=24 hours ago",
        "--max-count=20",
        "--format=%H%x1f%s",
    ])
    work_ref_re = re.compile(r"\b(PACKET-[0-9]+|LOOP-[A-Z0-9._-]+|WAVE-[A-Z0-9._-]+|EXEC_RECEIPT)\b")
    if rc == 0:
        for line in out.splitlines():
            if "\x1f" not in line:
                continue
            sha, subject = line.split("\x1f", 1)
            if work_ref_re.search(subject):
                continue
            frc, fout, _ferr = _run([
                "git",
                "-C",
                str(REPO_ROOT),
                "show",
                "--name-only",
                "--format=",
                sha,
            ])
            if frc != 0:
                continue
            files = [f.strip() for f in fout.splitlines() if f.strip()]
            top_levels = {f.split("/", 1)[0] for f in files}
            policy_paths = [
                f for f in files
                if f == "AGENTS.md"
                or f.startswith("docs/governance/")
                or f.startswith("ops/bindings/")
                or f.startswith("ops/commands/")
                or f.startswith("ops/plugins/core/")
            ]
            if len(top_levels) <= 1 and len(files) <= 1 and not policy_paths:
                continue
            signals["recent_commits_without_work_ref"].append({
                "sha": sha[:12],
                "subject": subject,
                "changed_files": len(files),
                "top_levels": sorted(top_levels),
                "policy_paths": policy_paths[:8],
            })

    return signals


# ─────────────────────────────────────────────────────────────────────────────
# Classification rules
# ─────────────────────────────────────────────────────────────────────────────

def classify_authority_reachability(reach: dict[str, Any]) -> list[dict[str, Any]]:
    """One symptom per host with non-ok class."""
    out: list[dict[str, Any]] = []
    if "_error" in reach:
        out.append({
            "dedupe_key": "authority_reachability:meta:read_failed",
            "classification": "authority_reachability",
            "capability": "infra.host.authority.reachability.status",
            "expected": "reachability classifier readable from operator console",
            "actual": f"reachability readback failed: {reach['_error']}",
            "severity": "high",
            "owner": "operator_console",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "investigate readback failure on operator console",
        })
        return out

    overall = reach.get("overall_status", "unknown")
    client_net = (reach.get("client_local_network") or {}).get("local_network", "unknown")

    if overall == "ok":
        return out

    for host in reach.get("hosts", []):
        cls = host.get("classification")
        if cls in (None, "ok"):
            continue
        name = host.get("name", "unknown")
        role = host.get("role", "unknown")
        sev = "high" if cls == "fully_unreachable" else "medium"
        if cls == "tailscale_only" and client_net == "off_lan_via_tailscale":
            # Operator off-LAN, Tailscale ok — truthful posture, not a real fault.
            sev = "low"
            next_action = "no action; off-LAN posture is honest. cap.sh failover handles routing automatically (commits 839672f5+769308ff)"
            autonomy = "informational_only"
        elif cls == "tailscale_only":
            next_action = "investigate LAN reachability to {} ({})".format(name, host.get("lan_addr", ""))
            autonomy = "read_only_diagnosis_auto"
        elif cls == "lan_only":
            next_action = "investigate Tailscale reachability to {} ({})".format(name, host.get("tailscale_addr", ""))
            autonomy = "read_only_diagnosis_auto"
        else:  # fully_unreachable
            next_action = "investigate full unreachability to {} (LAN: {}; TS: {})".format(
                name, host.get("lan_failure_reason", "?"), host.get("tailscale_failure_reason", "?"))
            autonomy = "stop_and_ask"

        out.append({
            "dedupe_key": f"authority_reachability:{name}:{cls}",
            "classification": "authority_reachability",
            "capability": "infra.host.authority.reachability.status",
            "expected": f"{role} {name} reachable on both LAN and Tailscale (canonical home: ops/bindings/runtime.bootstrap.contract.yaml#db_authority + ssh.targets.yaml)",
            "actual": f"{role} {name} class={cls}; lan_reachable={host.get('lan_reachable')}; tailscale_reachable={host.get('tailscale_reachable')} [autonomy: {autonomy}] [next: {next_action}]",
            "severity": sev,
            "owner": role,
            "autonomy": autonomy,
            "next_action": next_action,
        })
    return out


def classify_code_drift(drift: dict[str, Any]) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    if "_error" in drift:
        out.append({
            "dedupe_key": "code_drift:meta:read_failed",
            "classification": "code_drift",
            "capability": "runtime.checkout.drift.status",
            "expected": "code drift readback queryable from operator console",
            "actual": f"drift readback failed: {drift['_error']}",
            "severity": "medium",
            "owner": "operator_console",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "investigate drift readback failure",
        })
        return out

    overall = drift.get("overall_status", "unknown")
    if overall == "ok":
        return out

    for host in drift.get("hosts", []):
        st = host.get("status")
        if st in (None, "ok"):
            continue
        name = host.get("name", "unknown")
        role = host.get("role", "unknown")
        head = host.get("head") or "unknown"
        sev = "high" if st in ("drift", "dirty") else "medium"
        if st == "drift":
            next_action = f"sync {name} checkout to origin/main HEAD (rsync from operator console for pve, git pull --ff-only for ai-cons)"
        elif st == "dirty":
            next_action = f"investigate uncommitted changes on {name} checkout; clean or commit per HOST_DRIFT_POLICY"
        elif st == "unreachable":
            next_action = f"investigate {name} reachability before assessing drift"
            sev = "medium"
        else:
            next_action = f"investigate {st} on {name}"
        out.append({
            "dedupe_key": f"code_drift:{name}:{st}",
            "classification": "code_drift",
            "capability": "runtime.checkout.drift.status",
            "expected": f"{role} {name} HEAD == origin/main (canonical home: docs/governance/HOST_DRIFT_POLICY.md)",
            "actual": f"{role} {name} status={st}; head={head}; note={host.get('note', '')} [next: {next_action}]",
            "severity": sev,
            "owner": role,
            "autonomy": "read_only_diagnosis_auto",
            "next_action": next_action,
        })
    return out


def classify_wave_residue(wave_residue: dict[str, Any]) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    if "_error" in wave_residue:
        out.append({
            "dedupe_key": "wave_residue:meta:read_failed",
            "classification": "wave_residue",
            "capability": "wave.residue",
            "expected": "wave residue readback is queryable (canonical home: wave.residue + worktree.lifecycle.cleanup)",
            "actual": f"wave.residue readback failed: {wave_residue['_error']} [autonomy: read_only_diagnosis_auto] [next: investigate wave.residue readback before cleanup]",
            "severity": "medium",
            "owner": "orchestration_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "investigate wave.residue readback before cleanup",
        })
        return out

    report = wave_residue.get("report", {}) if isinstance(wave_residue, dict) else {}
    items = report.get("items", []) if isinstance(report, dict) else []
    for item in items:
        if not isinstance(item, dict):
            continue
        if bool(item.get("safe_to_sweep")):
            continue
        cls = str(item.get("class") or "unknown").strip()
        wave_id = str(item.get("wave_id") or "unknown").strip()
        identity = str(item.get("identity") or item.get("path") or item.get("branch") or "unknown").strip()
        wave_status = str(item.get("wave_status") or "unknown").strip()
        reason = str(item.get("ambiguous_reason") or f"wave_status={wave_status}").strip()
        severity = "high" if wave_status == "unknown" else "medium"
        next_action = (
            "route to owning wave lifecycle if the wave exists; if wave authority is missing, "
            "use governed lifecycle reconciliation/recovery. Do not delete the leaf worktree/branch/lease directly."
        )
        out.append({
            "dedupe_key": f"wave_residue:{wave_id}:{cls}:{identity}",
            "classification": "wave_residue",
            "capability": "wave.residue",
            "expected": "wave-owned worktree/branch residue is either active under wave authority, safely sweepable after close, or repaired through governed lifecycle reconciliation",
            "actual": f"{identity}; class={cls}; wave={wave_id}; wave_status={wave_status}; reason={reason} [autonomy: read_only_diagnosis_auto] [next: {next_action}]",
            "severity": severity,
            "owner": "orchestration_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": next_action,
        })
    return out


def classify_brief_failures(brief: dict[str, str]) -> list[dict[str, Any]]:
    """Symptoms surfaced by ops status --brief that aren't covered by drift/reach."""
    out: list[dict[str, Any]] = []
    spine = brief.get("Spine", "")
    secondary = brief.get("Secondary", "")
    coherence = brief.get("Coherence", "")
    anomalies = brief.get("Anomalies", "")

    if spine == "failed":
        out.append({
            "dedupe_key": "verify:spine.verify:failed",
            "classification": "verify_failure",
            "capability": "spine.verify",
            "expected": "spine.verify passes (canonical home: surfaces/verify/d*.sh + ops/bindings/gate.registry.yaml)",
            "actual": f"spine.verify status=failed (composite — needs sub-classification by D-gate name) [autonomy: read_only_diagnosis_auto] [next: route spine.verify to authority host and capture failing D-gates; classify each as workbench/admission/storage/etc]",
            "severity": "medium",
            "owner": "verify_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "route spine.verify to authority host; classify failing D-gates per role-aware policy (workbench D153/D397 likely; D447 ai-cons promotion separate)",
        })

    if secondary == "failed":
        out.append({
            "dedupe_key": "verify:secondary:failed",
            "classification": "verify_failure",
            "capability": "secondary_verifies",
            "expected": "secondary verifies pass",
            "actual": f"secondary status=failed [autonomy: read_only_diagnosis_auto] [next: enumerate secondary verify lane and identify failing surfaces]",
            "severity": "low",
            "owner": "verify_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "enumerate secondary verify lane; identify which surface(s) fail",
        })

    if coherence and coherence != "ok":
        out.append({
            "dedupe_key": f"coherence:state_summary:{coherence}",
            "classification": "coherence",
            "capability": "ops.status.brief",
            "expected": "Coherence: ok",
            "actual": f"Coherence: {coherence} (composite signal from joined_state) [autonomy: read_only_diagnosis_auto] [next: inspect joined_state_summary for active_waves/orphaned_waves/verify status fragments]",
            "severity": "low",
            "owner": "engine_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "inspect joined_state_summary for active_waves/orphaned_waves/verify status fragments",
        })

    return out


def classify_entry_policy(signals: dict[str, Any]) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []

    for item in signals.get("fresh_unbound_root_terminals", []):
        terminal_id = item.get("terminal_id", "unknown")
        out.append({
            "dedupe_key": f"agent_entry_policy:unbound_root_terminal:{terminal_id}",
            "classification": "agent_entry_policy",
            "capability": "session.v3.attach",
            "expected": (
                "non-trivial mutation enters through governed loop/packet/lane "
                "(canonical home: AGENTS.md + docs/governance/SESSION_PROTOCOL.md work-intake router policy)"
            ),
            "actual": (
                f"fresh unbound root-main terminal {terminal_id}; role={item.get('role')}; "
                f"lane_type={item.get('lane_type')} [autonomy: read_only_diagnosis_auto] "
                "[next: if this terminal is doing more than read-only report or direct tiny patch, "
                "attach/open governed work before mutation]"
            ),
            "severity": "medium",
            "owner": "operator_console",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "attach/open governed work for any non-trivial mutation; otherwise record direct-mode reason",
        })

    for item in signals.get("visible_worker_without_lane", []):
        terminal_id = item.get("terminal_id", "unknown")
        out.append({
            "dedupe_key": f"agent_entry_policy:visible_worker_without_lane:{terminal_id}",
            "classification": "agent_entry_policy",
            "capability": "ops.terminal.launch",
            "expected": (
                "visible worker terminals are exceptional and carry lane telemetry "
                "(canonical home: docs/governance/SESSION_PROTOCOL.md work-intake router policy)"
            ),
            "actual": (
                f"fresh worker-shaped terminal {terminal_id} has no loop/wave telemetry "
                "[autonomy: read_only_diagnosis_auto] "
                "[next: prefer headless/background engine lane, or relaunch with an operator-interaction reason]"
            ),
            "severity": "medium",
            "owner": "operator_console",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "move worker execution behind lane telemetry or justify visible operator-interaction terminal",
        })

    for item in signals.get("recent_commits_without_work_ref", []):
        sha = item.get("sha", "unknown")
        policy_paths = item.get("policy_paths") or []
        severity = "high" if policy_paths else "medium"
        out.append({
            "dedupe_key": f"agent_entry_policy:commit_without_work_ref:{sha}",
            "classification": "agent_entry_policy",
            "capability": "git.commit",
            "expected": (
                "cross-surface or policy-runtime commits carry packet/loop/wave provenance "
                "(canonical home: SESSION_PROTOCOL work-intake router)"
            ),
            "actual": (
                f"recent commit {sha} lacks PACKET/LOOP/WAVE/EXEC_RECEIPT marker; "
                f"subject={item.get('subject')!r}; changed_files={item.get('changed_files')} "
                f"[autonomy: read_only_diagnosis_auto] "
                "[next: inspect whether this was read-only/direct-tiny work or an engine-lane bypass]"
            ),
            "severity": severity,
            "owner": "engine_authority",
            "autonomy": "read_only_diagnosis_auto",
            "next_action": "inspect commit provenance and file/attach governed work if it bypassed required engine lane",
        })

    return out


# ─────────────────────────────────────────────────────────────────────────────
# V2.1 Slice 1B — agent terminal closeout source mode
#
# Classifies free-text closeout prose from the spine-terminal-session-runner
# into a fixed set of agent-semantic friction classes. Calls friction.ingest
# with source-metadata flags so friction.queue.status --source-drilldown can
# trace each row back to its closeout origin via the existing event payload
# column. NO new authority plane, NO new index, NO new directory.
#
# Fingerprint design: (capability, expected, actual) is stable per
# (class, tool, loop_id) so same agent in same loop emitting paraphrases
# of the same root issue dedups (hit_count++). Source ref + excerpt hash
# live in event payload, NOT in fingerprint, so anchors don't fragment dedup.
# ─────────────────────────────────────────────────────────────────────────────

# (class_name, regex, severity, expected_string)
TERMINAL_CLOSEOUT_PATTERNS: list[tuple[str, re.Pattern[str], str, str]] = [
    (
        "agent_reported_lifecycle_stall",
        re.compile(
            r"stamps?\s+stay\s+executing"
            r"|delegation\s+stuck\s+on\s+picked[_\s-]?up"
            r"|loop\s+closeout\s+defers"
            r"|worker\s+lease\s+(?:didn'?t|did\s+not|never)\s+release"
            r"|stuck\s+on\s+executing",
            re.IGNORECASE,
        ),
        "medium",
        "lifecycle stamps transition out of executing within lease lifecycle",
    ),
    (
        "agent_reported_recurring_failure",
        re.compile(
            r"kept\s+hitting"
            r"|hit\s+this\s+again"
            r"|this\s+keeps?\s+breaking"
            r"|keeps?\s+failing",
            re.IGNORECASE,
        ),
        "medium",
        "agent calls friction.ingest in-session for recurring failure, not in closing prose",
    ),
    (
        "agent_reported_packetization_request",
        re.compile(
            r"worth\s+packetizing"
            r"|should\s+(?:be|need\s+to\s+be)\s+a\s+packet"
            r"|needs?\s+governed\s+work"
            r"|needs?\s+a\s+packet",
            re.IGNORECASE,
        ),
        "low",
        "agent calls controller_prompt.create directly when work is governed-packet-shaped",
    ),
    (
        "agent_reported_worker_state_drift",
        re.compile(
            r"worker\s+thinks\s+it'?s\s+executing\s+but\s+isn'?t"
            r"|claim\s*/\s*result\s+divergence"
            r"|worker\s+state\s+drift",
            re.IGNORECASE,
        ),
        "high",
        "worker claim and result states converge under canonical lifecycle reads",
    ),
    (
        "agent_reported_split_brain",
        re.compile(
            r"two\s+truths"
            r"|projection\s+disagrees\s+with\s+authority"
            r"|readback\s+doesn'?t\s+match\s+state"
            r"|split[\s-]?brain",
            re.IGNORECASE,
        ),
        "high",
        "shared_authority.db is the single source; projections converge",
    ),
]

TERMINAL_CLOSEOUT_CATCHALL_KW = re.compile(
    r"\b(?:bug|broken|wrong|stuck|crashes?|crashing|hangs?|hanging)\b",
    re.IGNORECASE,
)


def _sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _build_source_ref(
    *,
    tool: str,
    session_id: str,
    terminal_id: str,
    explicit: str,
) -> str:
    """Build a deterministic source_ref string from runner metadata. Avoids
    mutating user input; just joins fields. Stored in friction event payload.
    """
    if explicit:
        return explicit
    parts: list[str] = []
    if tool:
        parts.append(f"tool={tool}")
    if session_id:
        parts.append(f"session={session_id}")
    if terminal_id:
        parts.append(f"terminal={terminal_id}")
    return ";".join(parts) if parts else "(unspecified)"


def read_agent_terminal_closeout(
    *,
    prose: str,
    tool: str,
    session_id: str,
    terminal_id: str,
    loop_id: str,
    source_ref: str,
) -> dict[str, Any]:
    return {
        "prose": prose or "",
        "tool": tool or "",
        "session_id": session_id or "",
        "terminal_id": terminal_id or "",
        "loop_id": loop_id or "",
        "source_ref": _build_source_ref(
            tool=tool,
            session_id=session_id,
            terminal_id=terminal_id,
            explicit=source_ref,
        ),
        "excerpt_hash": _sha256_text(prose or ""),
    }


def _terminal_closeout_record(
    *,
    sig_class: str,
    severity: str,
    expected: str,
    parsed: dict[str, Any],
) -> dict[str, Any]:
    """Emit one classified record. Fingerprint is stable per (class, tool,
    loop_id) — anchors and excerpt live in event payload, not fingerprint.
    """
    tool = parsed.get("tool") or ""
    loop_id = parsed.get("loop_id") or ""
    actual = (
        f"{sig_class}: detected in agent closeout prose; "
        f"tool={tool or '-'}; loop={loop_id or '-'}"
    )
    return {
        "dedupe_key": f"agent_terminal_closeout:{sig_class}:{loop_id or '-'}",
        "classification": "agent_terminal_closeout",
        "capability": sig_class,
        "expected": expected,
        "actual": actual,
        "severity": severity,
        "owner": "agent_actor",
        "autonomy": "read_only_diagnosis_auto",
        "next_action": (
            "reconcile via friction.reconcile --friction-id <id> "
            "(routed by mailroom in V2.1 Slice 2)"
        ),
        # Source metadata — written to friction event payload by file_via_friction_ingest.
        "source_kind": "agent_terminal_closeout",
        "source_ref": parsed.get("source_ref") or "",
        "excerpt_hash": parsed.get("excerpt_hash") or "",
        "class": sig_class,
        # Loop id surfaced as a top-level record field so file_via_friction_ingest
        # can forward it to friction.ingest --loop-id; this populates the
        # canonical friction.sources[] array so loop-scoped readback (entry
        # context in V2.1 Slice 3) can find these rows structurally.
        "loop_id": loop_id,
    }


def classify_agent_terminal_closeout(parsed: dict[str, Any]) -> list[dict[str, Any]]:
    """Match prose against the fixed pattern table; emit one record per
    matched class. If no specific class matched but strong-concern keywords
    are present, emit a single agent_reported_unknown_spine_bug catch-all.
    """
    out: list[dict[str, Any]] = []
    prose = parsed.get("prose") or ""
    if not prose.strip():
        return out
    matched_classes: set[str] = set()
    for sig_class, pattern, severity, expected in TERMINAL_CLOSEOUT_PATTERNS:
        if pattern.search(prose):
            matched_classes.add(sig_class)
            out.append(_terminal_closeout_record(
                sig_class=sig_class,
                severity=severity,
                expected=expected,
                parsed=parsed,
            ))
    if not matched_classes and TERMINAL_CLOSEOUT_CATCHALL_KW.search(prose):
        out.append(_terminal_closeout_record(
            sig_class="agent_reported_unknown_spine_bug",
            severity="low",
            expected=(
                "agent describes spine-internal concern using a recognized class; "
                "catch-all means class taxonomy needs widening or the prose was unclear"
            ),
            parsed=parsed,
        ))
    return out


# ─────────────────────────────────────────────────────────────────────────────
# Filing
# ─────────────────────────────────────────────────────────────────────────────

def file_via_friction_ingest(record: dict[str, Any]) -> dict[str, Any]:
    """Invoke ./bin/ops cap run friction.ingest with the record's fields.

    Sets SPINE_ROLE_POLICY_OVERRIDE_REF to identify the clerk as the caller.
    Forwards V2.1 Slice 1B source-metadata flags when the record carries them
    (only agent-terminal-closeout records today; existing classifiers omit).
    """
    env = os.environ.copy()
    env["SPINE_ROLE_POLICY_OVERRIDE_REF"] = "PACKET-592-CLERK-FRICTION-RAIL"
    env["SPINE_ROLE_POLICY_OVERRIDE_REASON"] = (
        "clerk.symptom.classify.and.file — read-only diagnosis + governed filing only "
        "(per PACKET-592 Phase 1 approval). Dedupe key: " + record["dedupe_key"]
    )
    cmd = [
        str(REPO_ROOT / "bin" / "ops"), "cap", "run", "friction.ingest", "--",
        "--capability", record["capability"],
        "--expected", record["expected"],
        "--actual", record["actual"],
        "--severity", record["severity"],
    ]
    if record.get("source_kind"):
        cmd += ["--source-kind", record["source_kind"]]
    if record.get("source_ref"):
        cmd += ["--source-ref", record["source_ref"]]
    if record.get("excerpt_hash"):
        cmd += ["--excerpt-hash", record["excerpt_hash"]]
    if record.get("class"):
        cmd += ["--class", record["class"]]
    # Forward loop_id so friction.ingest populates friction.sources[];
    # required for loop-scoped readback / entry context (V2.1 Slice 3 input).
    if record.get("loop_id"):
        cmd += ["--loop-id", record["loop_id"]]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT, env=env)
        parsed = _extract_first_json_object(proc.stdout)
        item = parsed.get("item") if isinstance(parsed, dict) and isinstance(parsed.get("item"), dict) else {}
        result = {
            "filed": proc.returncode == 0,
            "exit_code": proc.returncode,
            "friction_id": str(item.get("friction_id") or "").strip(),
            "dedup": bool(item.get("dedup")),
            "stdout_tail": proc.stdout.strip().splitlines()[-3:] if proc.stdout else [],
            "stderr_tail": proc.stderr.strip().splitlines()[-3:] if proc.stderr else [],
        }
        # Classify common failure modes so the clerk's own output is actionable.
        if proc.returncode == 3:
            combined = (proc.stdout + proc.stderr).lower()
            if "execution class policy blocked" in combined or "bound terminal identity" in combined:
                result["failure_class"] = "admission_gate_refused"
                result["failure_hint"] = (
                    "friction.ingest is mutating and routes to authority host. cap.sh SSH dispatch "
                    "does not propagate SPINE_ROLE_POLICY_OVERRIDE_* env vars. Run the clerk "
                    "directly on the authority host (pve) where no routing occurs, OR teach cap.sh "
                    "to forward override env vars across SSH (separate slice)."
                )
        return result
    except subprocess.TimeoutExpired:
        return {"filed": False, "exit_code": 124, "error": "friction.ingest timed out"}


def _extract_first_json_object(text: str) -> dict[str, Any] | None:
    decoder = json.JSONDecoder()
    for idx, char in enumerate(text or ""):
        if char != "{":
            continue
        try:
            obj, _ = decoder.raw_decode(text[idx:])
        except json.JSONDecodeError:
            continue
        return obj if isinstance(obj, dict) else None
    return None


def _enqueued_task_id(friction_id: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", friction_id)
    return f"TASK-FRICTION-RECONCILE-{safe}"


def enqueue_friction_reconcile(record: dict[str, Any], ingest_result: dict[str, Any]) -> dict[str, Any]:
    """Queue one bounded mailroom reconcile task for a newly filed
    agent-terminal-closeout friction row. Duplicate closeout hits only bump
    hit_count; they do not enqueue worker-task spam.
    """
    parsed = _extract_first_json_object("\n".join(ingest_result.get("stdout_all", [])))
    if parsed is None:
        parsed = _extract_first_json_object("\n".join(ingest_result.get("stdout_tail", [])))
    item = parsed.get("item") if isinstance(parsed, dict) and isinstance(parsed.get("item"), dict) else {}
    friction_id = str(item.get("friction_id") or ingest_result.get("friction_id") or "").strip()
    if not friction_id:
        return {"enqueued": False, "reason": "missing_friction_id"}
    if bool(item.get("dedup")) or bool(ingest_result.get("dedup")):
        return {"enqueued": False, "friction_id": friction_id, "reason": "dedup_hit_no_duplicate_task"}
    sig_class = str(record.get("class") or record.get("capability") or "").strip()
    if not sig_class.startswith("agent_reported_"):
        return {"enqueued": False, "friction_id": friction_id, "reason": "not_agent_reported_class"}

    env = os.environ.copy()
    env["SPINE_ROLE_POLICY_OVERRIDE_REF"] = "terminal-closeout-friction-reconcile-routing"
    env["SPINE_ROLE_POLICY_OVERRIDE_REASON"] = (
        "V2.1 Slice 2: agent-terminal-closeout friction routes to bounded "
        "mailroom-owned friction.reconcile --friction-id; no dispose without evidence."
    )
    cmd = [
        str(REPO_ROOT / "bin" / "ops"), "cap", "run", "mailroom.task.enqueue", "--",
        "--task-id", _enqueued_task_id(friction_id),
        "--summary", f"Reconcile terminal closeout friction {friction_id} ({sig_class})",
        "--route-target", "capability",
        "--route-capability", "friction.reconcile",
        "--route-arg", "--friction-id",
        "--route-arg", friction_id,
        "--execution-lane-id", "terminal_closeout_friction_capture",
        "--json",
    ]
    if record.get("loop_id"):
        cmd += ["--loop-id", str(record["loop_id"])]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT, env=env)
    except subprocess.TimeoutExpired:
        return {"enqueued": False, "friction_id": friction_id, "exit_code": 124, "error": "mailroom.task.enqueue timed out"}
    payload = _extract_first_json_object(proc.stdout)
    task_id = ""
    if isinstance(payload, dict):
        data = payload.get("data") if isinstance(payload.get("data"), dict) else {}
        task_id = str(data.get("task_id") or "").strip()
    return {
        "enqueued": proc.returncode == 0,
        "friction_id": friction_id,
        "task_id": task_id,
        "exit_code": proc.returncode,
        "stdout_tail": proc.stdout.strip().splitlines()[-3:] if proc.stdout else [],
        "stderr_tail": proc.stderr.strip().splitlines()[-3:] if proc.stderr else [],
    }


# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(prog="clerk.symptom.classify.and.file")
    parser.add_argument("--file", action="store_true",
                        help="Actually file friction records via friction.ingest "
                             "(default: dry-run JSON only)")
    parser.add_argument("--json", action="store_true", help="JSON output")
    parser.add_argument("--self-check", action="store_true", help="self-check pass")
    # V2.1 Slice 1B: dispatch to agent-terminal-closeout mode (reads stdin
    # closeout prose; runs only the closeout classifier; skips all
    # structured-signal probes). Default mode runs all existing classifiers.
    parser.add_argument(
        "--source",
        choices=["all", "agent-terminal-closeout"],
        default="all",
        help=(
            "Symptom source. 'all' (default) runs the existing structured-signal "
            "classifiers. 'agent-terminal-closeout' reads closeout prose from stdin "
            "and classifies into agent_reported_* friction classes."
        ),
    )
    parser.add_argument("--session-id", default="", help="Closeout session id (V2.1 1B).")
    parser.add_argument("--tool", default="", help="Closeout tool name (V2.1 1B).")
    parser.add_argument("--terminal-id", default="", help="Closeout terminal id (V2.1 1B).")
    parser.add_argument("--loop-id", default="", help="Closeout loop id (V2.1 1B).")
    parser.add_argument(
        "--source-ref",
        default="",
        help="Optional explicit source_ref override (V2.1 1B). Falls back to tool/session/terminal join.",
    )
    args = parser.parse_args()

    if args.self_check:
        print("clerk.symptom.classify.and.file self-check PASS")
        return 0

    # V2.1 Slice 1B: agent-terminal-closeout mode reads stdin and runs ONLY
    # the closeout classifier. Skips structured-signal reads/classifiers.
    if args.source == "agent-terminal-closeout":
        prose = sys.stdin.read() if not sys.stdin.isatty() else ""
        parsed = read_agent_terminal_closeout(
            prose=prose,
            tool=args.tool,
            session_id=args.session_id,
            terminal_id=args.terminal_id,
            loop_id=args.loop_id,
            source_ref=args.source_ref,
        )
        classified = classify_agent_terminal_closeout(parsed)
        filings: list[dict[str, Any]] = []
        reconcile_tasks: list[dict[str, Any]] = []
        if args.file:
            for record in classified:
                result = file_via_friction_ingest(record)
                filings.append({"dedupe_key": record["dedupe_key"], "result": result})
                if result.get("filed"):
                    reconcile_tasks.append({
                        "dedupe_key": record["dedupe_key"],
                        "result": enqueue_friction_reconcile(record, result),
                    })
        payload = {
            "capability": "clerk.symptom.classify.and.file",
            "generated_at_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "mode": "file" if args.file else "dry_run",
            "source": "agent-terminal-closeout",
            "input_summary": {
                "tool": parsed["tool"],
                "session_id": parsed["session_id"],
                "terminal_id": parsed["terminal_id"],
                "loop_id": parsed["loop_id"],
                "source_ref": parsed["source_ref"],
                "excerpt_hash": parsed["excerpt_hash"],
                "prose_chars": len(parsed["prose"]),
            },
            "classified_count": len(classified),
            "classified": classified,
            "filings": filings if args.file else None,
            "reconcile_tasks": reconcile_tasks if args.file else None,
            "scope_note": (
                "V2.1 Slice 1B agent-terminal-closeout source mode. "
                "Reads stdin closeout prose; classifies into agent_reported_* friction classes; "
                "files via existing friction.ingest with source-metadata flags. "
                "V2.1 Slice 2 routes newly filed agent_reported_* rows to "
                "mailroom-owned friction.reconcile --friction-id; duplicate hits do not enqueue worker spam."
            ),
        }
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print(f"clerk.symptom.classify.and.file --source agent-terminal-closeout (mode: {payload['mode']})")
            print(f"tool: {parsed['tool'] or '-'}; session: {parsed['session_id'] or '-'}; "
                  f"terminal: {parsed['terminal_id'] or '-'}; loop: {parsed['loop_id'] or '-'}")
            print(f"source_ref: {parsed['source_ref']}")
            print(f"excerpt_hash: {parsed['excerpt_hash']}")
            print(f"classified: {len(classified)} record(s)")
            for record in classified:
                print(f"  [{record['severity']:>6}] {record['classification']:<26} {record['dedupe_key']}")
                print(f"          class:  {record['class']}")
                print(f"          next:   {record['next_action']}")
            if args.file:
                filed_count = sum(1 for f in filings if f.get("result", {}).get("filed"))
                enqueued_count = sum(1 for f in reconcile_tasks if f.get("result", {}).get("enqueued"))
                print(f"\nfiled: {filed_count} / {len(filings)}")
                print(f"reconcile queued: {enqueued_count} / {len(reconcile_tasks)}")
                for f in filings:
                    rc = f.get("result", {}).get("exit_code", "?")
                    ok = f.get("result", {}).get("filed")
                    marker = "✓" if ok else "✗"
                    print(f"  {marker} ({rc}) {f['dedupe_key']}")
                for f in reconcile_tasks:
                    rc = f.get("result", {}).get("exit_code", "?")
                    ok = f.get("result", {}).get("enqueued")
                    marker = "✓" if ok else "✗"
                    task_id = f.get("result", {}).get("task_id") or ""
                    print(f"  reconcile {marker} ({rc}) {f['dedupe_key']} {task_id}")
            else:
                print("\n(dry-run; pass --file to invoke friction.ingest for each record)")
        return 0

    # PACKET-592 Phase 2: when status.sh --brief invokes the clerk for its
    # rollup line, brief can pass brief-derived symptoms AND already-collected
    # drift/reach payloads via env vars so the clerk classifies without
    # re-running ops status --brief or re-probing SSH (which would be ~30s).
    # CLERK_SKIP_BRIEF_READ enables the env-pass mode.
    skip_brief = bool(os.environ.get("CLERK_SKIP_BRIEF_READ"))
    if skip_brief:
        brief = {}
        for key, env_name in (
            ("Spine", "CLERK_BRIEF_SPINE"),
            ("Secondary", "CLERK_BRIEF_SECONDARY"),
            ("Coherence", "CLERK_BRIEF_COHERENCE"),
            ("Engine", "CLERK_BRIEF_ENGINE"),
        ):
            val = os.environ.get(env_name, "").strip()
            if val:
                brief[key] = val
        _drift_json = os.environ.get("CLERK_DRIFT_JSON", "").strip()
        try:
            drift = json.loads(_drift_json) if _drift_json else read_drift()
        except json.JSONDecodeError:
            drift = read_drift()
        _reach_json = os.environ.get("CLERK_REACH_JSON", "").strip()
        try:
            reach = json.loads(_reach_json) if _reach_json else read_reachability()
        except json.JSONDecodeError:
            reach = read_reachability()
        _wave_residue_json = os.environ.get("CLERK_WAVE_RESIDUE_JSON", "").strip()
        try:
            wave_residue = json.loads(_wave_residue_json) if _wave_residue_json else read_wave_residue()
        except json.JSONDecodeError:
            wave_residue = read_wave_residue()
    else:
        brief = read_brief()
        drift = read_drift()
        reach = read_reachability()
        wave_residue = read_wave_residue()
    entry_policy_signals = read_entry_policy_signals()

    classified: list[dict[str, Any]] = []
    classified.extend(classify_authority_reachability(reach))
    classified.extend(classify_code_drift(drift))
    classified.extend(classify_wave_residue(wave_residue))
    classified.extend(classify_brief_failures(brief))
    classified.extend(classify_entry_policy(entry_policy_signals))

    filings: list[dict[str, Any]] = []
    if args.file:
        for record in classified:
            result = file_via_friction_ingest(record)
            filings.append({"dedupe_key": record["dedupe_key"], "result": result})

    role = clerk_plane_access_role()
    payload = {
        "capability": "clerk.symptom.classify.and.file",
        "generated_at_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "mode": "file" if args.file else "dry_run",
        "canonical_plane_access_role": role,
        "plane_access_source": f"{CANONICAL_PLANE_ACCESS_BINDING}.{role}",
        "output_disposition": "local_diagnostic_not_canonical_friction_state",
        "canonical_filing_path": "friction.ingest -> shared_authority.db (storage_evidence_node)",
        "input_summary": {
            "brief_fields": list(brief.keys()),
            "drift_overall": drift.get("overall_status"),
            "reach_overall": reach.get("overall_status"),
            "wave_residue_total": ((wave_residue.get("report") or {}).get("counts") or {}).get("total") if isinstance(wave_residue, dict) else None,
            "entry_policy": {
                "fresh_unbound_root_terminals": len(entry_policy_signals.get("fresh_unbound_root_terminals", [])),
                "visible_worker_without_lane": len(entry_policy_signals.get("visible_worker_without_lane", [])),
                "recent_commits_without_work_ref": len(entry_policy_signals.get("recent_commits_without_work_ref", [])),
            },
        },
        "classified_count": len(classified),
        "classified": classified,
        "filings": filings if args.file else None,
        "scope_note": "PACKET-592 Phase 1 friction clerk. Read-only diagnosis + governed filing via existing friction.ingest. NO direct DB writes, NO host mutation, NO autonomous fix attempts.",
    }

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"clerk.symptom.classify.and.file (mode: {payload['mode']})")
        print(f"plane access role: {payload['canonical_plane_access_role']}")
        print(f"plane access source: {payload['plane_access_source']}")
        print(f"output disposition: {payload['output_disposition']}")
        print(f"canonical filing path: {payload['canonical_filing_path']}")
        print(f"classified: {payload['classified_count']} symptom(s)")
        for record in classified:
            print(f"  [{record['severity']:>6}] {record['classification']:<25} {record['dedupe_key']}")
            print(f"          owner: {record['owner']}; autonomy: {record['autonomy']}")
            print(f"          next:  {record['next_action']}")
        if args.file:
            filed_count = sum(1 for f in filings if f.get("result", {}).get("filed"))
            print(f"\nfiled: {filed_count} / {len(filings)}")
            for f in filings:
                rc = f.get("result", {}).get("exit_code", "?")
                ok = f.get("result", {}).get("filed")
                marker = "✓" if ok else "✗"
                print(f"  {marker} ({rc}) {f['dedupe_key']}")
        else:
            print(f"\n(dry-run; pass --file to actually invoke friction.ingest for each record)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
