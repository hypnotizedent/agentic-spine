#!/usr/bin/env bash
set -euo pipefail

# host-operator-hardware-bootstrap-shelf-publish
# Publish Stage 0 bootstrap artifacts from runtime staging to the canonical
# shop-server/nas-primary-backed bootstrap shelf. Dry-run by default.

SPINE_REPO="${SPINE_REPO:-$HOME/code/agentic-spine}"
SPINE_STATE="${SPINE_STATE:-$HOME/code/.runtime/spine/state}"
SHELF_CONTRACT="${SPINE_REPO}/ops/bindings/operator.hardware.bootstrap.artifact.shelf.yaml"
INVENTORY="${SPINE_REPO}/ops/bindings/operator.hardware.inventory.yaml"
SSH_TARGETS="${SPINE_REPO}/ops/bindings/ssh.targets.yaml"

usage() {
    cat <<'EOF'
host-operator-hardware-bootstrap-shelf-publish - Publish Stage 0 artifacts to canonical shelf

Usage:
  host-operator-hardware-bootstrap-shelf-publish --device <device_id> [options] [--json]

Options:
  --device <device_id>        Device ID from operator.hardware.inventory.yaml
  --source-dir <dir>          Runtime staging directory (default: generated bootstrap dir)
  --manifest <path>           Bootstrap kit manifest path override
  --apply                     Perform remote publish to canonical shelf (default: dry-run)
  --json                      Machine-readable JSON output

This capability is dry-run by default. `--apply` mutates the canonical artifact shelf only.
It does not mutate any target device.
EOF
}

fail() { echo "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"; }

sha256_file() {
    local target="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$target" | awk '{print $1}'
        return 0
    fi
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$target" | awk '{print $1}'
        return 0
    fi
    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$target" | awk '{print $NF}'
        return 0
    fi
    fail "missing checksum tool (need sha256sum, shasum, or openssl)"
}

DEVICE=""
SOURCE_DIR=""
MANIFEST_OVERRIDE=""
APPLY=false
JSON_MODE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --device) DEVICE="${2:-}"; shift 2 ;;
        --source-dir) SOURCE_DIR="${2:-}"; shift 2 ;;
        --manifest) MANIFEST_OVERRIDE="${2:-}"; shift 2 ;;
        --apply) APPLY=true; shift ;;
        --json) JSON_MODE=true; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[[ -n "$DEVICE" ]] || fail "--device is required"

need yq
need jq
need rsync
need ssh

[[ -f "$SHELF_CONTRACT" ]] || fail "shelf contract not found: $SHELF_CONTRACT"
[[ -f "$INVENTORY" ]] || fail "inventory not found: $INVENTORY"
[[ -f "$SSH_TARGETS" ]] || fail "ssh targets not found: $SSH_TARGETS"

device_json=$(yq e -o=json ".machines[] | select(.device_id == \"$DEVICE\")" "$INVENTORY" 2>/dev/null)
[[ -n "$device_json" && "$device_json" != "null" ]] || fail "device not found in inventory: $DEVICE"

if [[ -z "$SOURCE_DIR" ]]; then
    SOURCE_DIR="${SPINE_STATE}/domain-state/generated/operator_hardware/bootstrap/${DEVICE}"
fi
[[ -d "$SOURCE_DIR" ]] || fail "source directory not found: $SOURCE_DIR"

if [[ -z "$MANIFEST_OVERRIDE" ]]; then
    MANIFEST_OVERRIDE="${SOURCE_DIR}/bootstrap-kit.${DEVICE}.json"
fi
[[ -f "$MANIFEST_OVERRIDE" ]] || fail "bootstrap kit manifest not found: $MANIFEST_OVERRIDE"

canonical_root=$(yq e -r '.artifact_shelf.canonical_root' "$SHELF_CONTRACT")
custody_host_ref=$(yq e -r '.artifact_shelf.custody_host_ref' "$SHELF_CONTRACT")
serving_host_ref=$(yq e -r '.artifact_shelf.serving_host_ref' "$SHELF_CONTRACT")
iso_library_ref=$(yq e -r '.artifact_shelf.iso_library_ref // ""' "$SHELF_CONTRACT")

source_platform=$(echo "$device_json" | jq -r '.platform')
target_platform=$(jq -r '.target_platform // .target_platform_truth // "linux"' "$MANIFEST_OVERRIDE")
bootstrap_method=$(jq -r '.bootstrap_method // "unknown"' "$MANIFEST_OVERRIDE")
target_distro=$(jq -r '.target_distro // "unknown"' "$MANIFEST_OVERRIDE")
target_distro_version=$(jq -r '.target_distro_version // "unknown"' "$MANIFEST_OVERRIDE")
rendered_at=$(jq -r '.provenance.rendered_at // .bootstrap_completed_at // empty' "$MANIFEST_OVERRIDE")

publish_mode="dry_run"
$APPLY && publish_mode="apply"

dest_base="${canonical_root}/kits/${DEVICE}"
dest_manifest_dir="${canonical_root}/manifests/${DEVICE}"
dest_receipts_dir="${canonical_root}/receipts/${DEVICE}"

inventory_hostname=$(echo "$device_json" | jq -r '.tailscale_identity // empty')
[[ -n "$inventory_hostname" ]] || inventory_hostname="$DEVICE"

manifest_out="${SOURCE_DIR}/shelf-publish-manifest.${DEVICE}.json"
receipt_out="${SOURCE_DIR}/shelf-publish-receipt.${DEVICE}.json"

declare -a rel_files=()
while IFS= read -r path; do
    rel="${path#${SOURCE_DIR}/}"
    rel_files+=("$rel")
done < <(find "$SOURCE_DIR" -type f ! -name 'shelf-publish-manifest.*' ! -name 'shelf-publish-receipt.*' | sort)

artifacts_json="["
for idx in "${!rel_files[@]}"; do
    rel="${rel_files[$idx]}"
    abs="${SOURCE_DIR}/${rel}"
    checksum="$(sha256_file "$abs")"
    case "$rel" in
        firstboot-claim.*)
            dest_path="${canonical_root}/claims/${DEVICE}/${rel}"
            kind="claim"
            ;;
        autoinstall/*)
            dest_path="${canonical_root}/autoinstall/${DEVICE}/${rel#autoinstall/}"
            kind="autoinstall"
            ;;
        bootstrap-kit.*)
            dest_path="${canonical_root}/kits/${DEVICE}/${rel}"
            kind="kit"
            ;;
        *)
            dest_path="${dest_base}/${rel}"
            kind="kit"
            ;;
    esac
    if [[ "$idx" -gt 0 ]]; then
        artifacts_json+=","
    fi
    artifacts_json+="$(jq -nc \
        --arg kind "$kind" \
        --arg rel "$rel" \
        --arg src "$abs" \
        --arg dest "$dest_path" \
        --arg sha "$checksum" \
        '{kind:$kind, relative_path:$rel, source_path:$src, shelf_path:$dest, checksum_sha256:$sha}')"
done
artifacts_json+="]"

jq -n \
    --arg device_id "$DEVICE" \
    --arg source_platform "$source_platform" \
    --arg target_platform "$target_platform" \
    --arg bootstrap_method "$bootstrap_method" \
    --arg target_distro "$target_distro" \
    --arg target_distro_version "$target_distro_version" \
    --arg rendered_at "$rendered_at" \
    --arg canonical_root "$canonical_root" \
    --arg custody_host_ref "$custody_host_ref" \
    --arg serving_host_ref "$serving_host_ref" \
    --arg shelf_publish_mode "$publish_mode" \
    --arg source_dir "$SOURCE_DIR" \
    --arg manifest_source "$MANIFEST_OVERRIDE" \
    --arg iso_library_ref "$iso_library_ref" \
    --arg generated_at "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
    --argjson artifacts "$artifacts_json" \
    '{
        device_id: $device_id,
        source_platform: $source_platform,
        target_platform: $target_platform,
        bootstrap_method: $bootstrap_method,
        target_distro: $target_distro,
        target_distro_version: $target_distro_version,
        rendered_at: $rendered_at,
        source_dir: $source_dir,
        manifest_source: $manifest_source,
        iso_library_ref: (if $iso_library_ref == "" then null else $iso_library_ref end),
        canonical_root: $canonical_root,
        custody_host_ref: $custody_host_ref,
        serving_host_ref: $serving_host_ref,
        shelf_publish_mode: $shelf_publish_mode,
        generated_at: $generated_at,
        artifacts: $artifacts
    }' >"$manifest_out"

source "${SPINE_REPO}/ops/lib/ssh-resolve.sh"
dest_host="$(ssh_resolve_ssh_host_with_fallback "$custody_host_ref" 3 | awk '{print $1}')"
dest_user="$(ssh_resolve_user "$custody_host_ref")"
resolved_ref="${dest_user}@${dest_host}"

publish_commands_json=$(jq -n \
    --arg mkdir1 "ssh ${resolved_ref} 'mkdir -p ${canonical_root}/kits/${DEVICE} ${canonical_root}/autoinstall/${DEVICE} ${canonical_root}/claims/${DEVICE} ${dest_manifest_dir} ${dest_receipts_dir}'" \
    --arg kit_cmd "rsync -az '${SOURCE_DIR}/bootstrap-kit.${DEVICE}.json' '${SOURCE_DIR}/bootstrap-kit.${DEVICE}.summary.txt' '${resolved_ref}:${canonical_root}/kits/${DEVICE}/'" \
    --arg autoinstall_cmd "rsync -az '${SOURCE_DIR}/autoinstall/' '${resolved_ref}:${canonical_root}/autoinstall/${DEVICE}/'" \
    --arg claim_cmd "rsync -az '${SOURCE_DIR}/firstboot-claim.${DEVICE}.json' '${resolved_ref}:${canonical_root}/claims/${DEVICE}/'" \
    --arg manifest_cmd "rsync -az '${manifest_out}' '${resolved_ref}:${dest_manifest_dir}/'" \
    --arg receipt_cmd "rsync -az '${receipt_out}' '${resolved_ref}:${dest_receipts_dir}/'" \
    '[$mkdir1, $kit_cmd, $autoinstall_cmd, $claim_cmd, $manifest_cmd, $receipt_cmd]')

publish_performed=false
if $APPLY; then
    ssh "$resolved_ref" "mkdir -p '${canonical_root}/kits/${DEVICE}' '${canonical_root}/autoinstall/${DEVICE}' '${canonical_root}/claims/${DEVICE}' '$dest_manifest_dir' '$dest_receipts_dir'"
    rsync -az "${SOURCE_DIR}/bootstrap-kit.${DEVICE}.json" "${SOURCE_DIR}/bootstrap-kit.${DEVICE}.summary.txt" "${resolved_ref}:${canonical_root}/kits/${DEVICE}/"
    if [[ -d "${SOURCE_DIR}/autoinstall" ]]; then
        rsync -az "${SOURCE_DIR}/autoinstall/" "${resolved_ref}:${canonical_root}/autoinstall/${DEVICE}/"
    fi
    if [[ -f "${SOURCE_DIR}/firstboot-claim.${DEVICE}.json" ]]; then
        rsync -az "${SOURCE_DIR}/firstboot-claim.${DEVICE}.json" "${resolved_ref}:${canonical_root}/claims/${DEVICE}/"
    fi
    rsync -az "$manifest_out" "${resolved_ref}:${dest_manifest_dir}/"
    rsync -az "$receipt_out" "${resolved_ref}:${dest_receipts_dir}/"
    publish_performed=true
fi

jq -n \
    --arg device_id "$DEVICE" \
    --arg publish_mode "$publish_mode" \
    --arg canonical_root "$canonical_root" \
    --arg custody_host_ref "$custody_host_ref" \
    --arg serving_host_ref "$serving_host_ref" \
    --arg resolved_ref "$resolved_ref" \
    --argjson publish_commands "$publish_commands_json" \
    --argjson publish_performed "$publish_performed" \
    '{
        device_id: $device_id,
        publish_mode: $publish_mode,
        canonical_root: $canonical_root,
        custody_host_ref: $custody_host_ref,
        serving_host_ref: $serving_host_ref,
        resolved_ref: $resolved_ref,
        publish_performed: $publish_performed,
        publish_commands: $publish_commands
    }' >"$receipt_out"

if $JSON_MODE; then
    jq -n \
        --arg capability "host.operator-hardware.bootstrap-shelf.publish" \
        --arg device "$DEVICE" \
        --arg source_dir "$SOURCE_DIR" \
        --arg canonical_root "$canonical_root" \
        --arg custody_host_ref "$custody_host_ref" \
        --arg serving_host_ref "$serving_host_ref" \
        --arg iso_library_ref "$iso_library_ref" \
        --arg publish_mode "$publish_mode" \
        --arg manifest_path "$manifest_out" \
        --arg receipt_path "$receipt_out" \
        --arg resolved_ref "$resolved_ref" \
        --argjson publish_performed "$publish_performed" \
        --argjson artifacts "$artifacts_json" \
        '{
            capability: $capability,
            device: $device,
            source_dir: $source_dir,
            canonical_root: $canonical_root,
            custody_host_ref: $custody_host_ref,
            serving_host_ref: $serving_host_ref,
            iso_library_ref: (if $iso_library_ref == "" then null else $iso_library_ref end),
            resolved_ref: $resolved_ref,
            publish_mode: $publish_mode,
            publish_performed: $publish_performed,
            artifacts: $artifacts,
            generated_manifest: $manifest_path,
            generated_receipt: $receipt_path,
            note: "Artifact shelf publish only. No device mutation performed."
        }'
else
    echo "host.operator-hardware.bootstrap-shelf.publish"
    echo "============================================"
    echo "device:            $DEVICE"
    echo "source dir:        $SOURCE_DIR"
    echo "canonical root:    $canonical_root"
    echo "custody host:      $custody_host_ref"
    echo "serving host:      $serving_host_ref"
    echo "mode:              $publish_mode"
    echo "manifest:          $manifest_out"
    echo "receipt:           $receipt_out"
    echo
    echo "NOTE: Artifact shelf publish only. No device mutation performed."
fi
