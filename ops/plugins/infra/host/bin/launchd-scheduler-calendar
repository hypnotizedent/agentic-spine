#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
source "$ROOT/ops/lib/runtime-paths.sh"
spine_runtime_resolve_paths
STATUS_SCRIPT="$ROOT/ops/plugins/infra/host/bin/launchd-scheduler-health-status"
OUT_REL="${1:-$SPINE_OUTBOX/operations/launchd-schedule-calendar.md}"

if [[ ! -x "$STATUS_SCRIPT" ]]; then
  echo "FAIL: missing scheduler status script: $STATUS_SCRIPT" >&2
  exit 1
fi

"$STATUS_SCRIPT" --calendar-markdown "$OUT_REL" --json | jq -r '.calendar_markdown // ""'
