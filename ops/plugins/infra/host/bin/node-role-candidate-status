#!/usr/bin/env python3
"""node.role.candidate.status — three-plane candidate readback.

PACKET-591 implementation under PACKET-588 phased order Phase 3. Reconciles
runtime truth, intent/planning truth, and repo/contract truth for a named
architecture candidate (e.g., forge_node) so Ronny or a future agent can
ask one canonical thing and get a complete, current picture instead of
relying on memory or scattered evidence.

Estate-truth reconciliation rule (from AGENTS.md / SESSION_PROTOCOL.md
landed in commit 98282bef): "Estate truth must not split into three
disconnected planes. When planning or changing L1/L2 estate shape,
reconcile runtime truth, intent/planning truth, and repo/contract truth
before choosing the next slice."

For each candidate, output:
- aliases: declared synonyms (so a query for any alias surfaces the canonical)
- runtime body: declared runtime substrate (host, addresses, services)
- intent packets: numbered packet IDs + paths + status
- contract status: bindings that already declare or reference the candidate
- domain-state artifacts: existing spec / evidence / candidate YAMLs
- missing: gaps between desired and observed
- next first-class action: name the next packet/slice to advance

NO mutation. NO host modification. NO new authority surfaces.
This is a read-only reconciliation surface.

v1 scope: forge_node populated. Future candidates (safe_node, runner_node,
control_node, archive_node, etc.) extend the CANDIDATES table.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any

try:
    import yaml  # type: ignore
except ImportError:
    yaml = None  # type: ignore

REPO_ROOT = Path(__file__).resolve().parents[5]
SPINE_STATE = Path(os.environ.get("SPINE_STATE", str(Path.home() / "code/.runtime/spine/state")))
NODE_ROLE_CONTRACT = REPO_ROOT / "ops/bindings/node.role.contract.yaml"


# Candidate registry — declarative source of truth for what this surface knows about.
# Adding a new candidate means adding an entry here, not building a parallel surface.
CANDIDATES: dict[str, dict[str, Any]] = {
    "forge_node": {
        "purpose": "Source-of-code-truth and CI execution surface (Gitea + Forgejo runner / GitOps pattern)",
        "aliases": [
            "courthouse",        # operator's canonical L2 framing
            "source_node",       # node-role naming convention
            "Gitea",             # current implementation
            "Forgejo",           # potential future swap
            "dev-tools",         # ssh.targets id
            "git runner",        # CI surface
            "GitOps",            # operating model
        ],
        "runtime_body": {
            "ssh_targets_id": "dev-tools",
            "host_descriptor": "Dev tools VM 206 (Gitea + PostgreSQL + Gitea Actions runner)",
            "expected_addresses": {
                "lan": "192.168.1.206",
                "tailscale": "100.90.167.39",
            },
            "services": ["gitea", "gitea-postgresql", "gitea-actions-runner"],
            "code_truth_role": "origin/main of agentic-spine + workbench + projects",
        },
        "intent_packet_ids": [514, 515, 516, 556, 591],
        "domain_state_artifact_globs": [
            "domain-state/spine/FORGE-COURTHOUSE-NODE-*.{md,yaml}",
            "domain-state/spine/L2-COURTHOUSE-SAFE-*.{md,yaml}",
            "domain-state/spine/GITEA-SECRETS-*.{md,yaml}",
            "domain-state/spine/L2-FIRST-CLASS-FOUNDATION-*.md",
        ],
        "contract_grep_terms": [
            "forge_node", "forge-node", "courthouse", "source_node", "dev-tools", "gitea",
        ],
        "expected_contract_homes": [
            "ops/bindings/node.role.contract.yaml",
            "ops/bindings/ssh.targets.yaml",
            "ops/bindings/hardware.inventory.yaml",
            "ops/bindings/fleet.admission.classification.yaml",
        ],
    },
    # Future candidates: safe_node, runner_node, control_node, archive_node
    # Add their entries here when the operator approves their first slice.
}


def list_intent_packets(candidate: dict[str, Any]) -> list[dict[str, Any]]:
    """Resolve numbered intent packets to their actual filesystem paths + status."""
    out: list[dict[str, Any]] = []
    prompts_dir = SPINE_STATE / "controller-prompts"
    bodies_dir = SPINE_STATE / "packet-bodies"
    for pid in candidate.get("intent_packet_ids", []):
        entry: dict[str, Any] = {"packet_id": pid, "found": False, "paths": []}
        for d in (prompts_dir, bodies_dir):
            if not d.is_dir():
                continue
            for path in d.glob(f"*PACKET-{pid}-*.md"):
                entry["found"] = True
                entry["paths"].append(str(path))
        out.append(entry)
    return out


def list_domain_state_artifacts(candidate: dict[str, Any]) -> list[str]:
    """Glob for existing domain-state artifacts named for this candidate."""
    out: list[str] = []
    for pattern in candidate.get("domain_state_artifact_globs", []):
        # Manually expand {md,yaml} alternation since pathlib glob doesn't.
        if "{md,yaml}" in pattern:
            for ext in ("md", "yaml"):
                expanded = pattern.replace("{md,yaml}", ext)
                out.extend(str(p) for p in SPINE_STATE.glob(expanded))
        else:
            out.extend(str(p) for p in SPINE_STATE.glob(pattern))
    return sorted(set(out))


def grep_contracts(candidate: dict[str, Any]) -> dict[str, list[str]]:
    """Grep ops/bindings for each contract grep term; return terms→files."""
    bindings_dir = REPO_ROOT / "ops" / "bindings"
    out: dict[str, list[str]] = {}
    if not bindings_dir.is_dir():
        return out
    files = list(bindings_dir.rglob("*.yaml")) + list(bindings_dir.rglob("*.yml"))
    for term in candidate.get("contract_grep_terms", []):
        hits: list[str] = []
        for f in files:
            try:
                if term in f.read_text(encoding="utf-8"):
                    hits.append(str(f.relative_to(REPO_ROOT)))
            except (OSError, UnicodeDecodeError):
                continue
        if hits:
            out[term] = sorted(set(hits))
    return out


def check_expected_contract_homes(candidate: dict[str, Any]) -> dict[str, bool]:
    """Confirm each expected contract home exists; doesn't validate content."""
    out: dict[str, bool] = {}
    for rel in candidate.get("expected_contract_homes", []):
        out[rel] = (REPO_ROOT / rel).is_file()
    return out


def read_node_type_entry(candidate_name: str) -> dict[str, Any] | None:
    """Read the candidate's node_type block from node.role.contract.yaml.

    Returns the parsed block (with promotion_standard and required_proofs)
    when the candidate is declared as a node_type, or None when only the
    candidate-readback surface knows about it. The presence of a block here
    is what flips the readback from candidate-only to contracted.
    """
    if yaml is None or not NODE_ROLE_CONTRACT.is_file():
        return None
    try:
        contract = yaml.safe_load(NODE_ROLE_CONTRACT.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return None
    if not isinstance(contract, dict):
        return None
    node_types = contract.get("node_types") or {}
    block = node_types.get(candidate_name)
    if isinstance(block, dict):
        return block
    return None


def _resolve_proof_ref(raw: str) -> Path:
    """Expand $SPINE_STATE in a proof_ref into the host's actual path.

    Falls back to the SPINE_STATE module constant when the env var is
    unset (so the readback resolves consistently from any session,
    including non-cap-shell invocations)."""
    if "$SPINE_STATE" in raw and not os.environ.get("SPINE_STATE"):
        raw = raw.replace("$SPINE_STATE", str(SPINE_STATE))
    return Path(os.path.expandvars(raw))


def _check_proof_ref_freshness(required_proofs: dict[str, Any]) -> dict[str, dict[str, Any]]:
    """For each proof that declares a proof_ref, check whether the artifact
    is present on disk. Returns name -> {proof_ref, expanded, present}.

    Freshness here means "artifact exists at the declared host-relative
    path" — content-level validation belongs in proof-specific gates.
    """
    out: dict[str, dict[str, Any]] = {}
    for name, body in (required_proofs or {}).items():
        if not isinstance(body, dict):
            continue
        ref = body.get("proof_ref")
        if not ref:
            continue
        expanded = _resolve_proof_ref(str(ref))
        out[name] = {
            "proof_ref": str(ref),
            "expanded": str(expanded),
            "present": expanded.is_file(),
        }
    return out


def _extract_stage_2_state(required_proofs: dict[str, Any]) -> tuple[dict[str, dict[str, Any]], dict[str, int]]:
    """For each required proof, extract Stage 2 state from its
    staged_delivery block. PACKET-609: prevents the readback from
    flattening Stage 1 + Stage 2 progress into "5/5 + delivered:false"
    — operators need to see Stage 2 enforcement state per proof.

    Returns (state_by_proof, summary).

    state_by_proof shape:
      {
        proof_name: {
          "declared": bool,
          "stage_2_key": str | None  (e.g., "stage_2_drill", "stage_2_enforcement"),
          "stage_2_status": str | None  (e.g., "delivered", "future"),
          "stage_2_proof_ref": str | None,
          "stage_2_packet": str | None,
        }
      }

    summary: {declared, delivered, future, not_declared} counts.
    """
    state: dict[str, dict[str, Any]] = {}
    summary = {"declared": 0, "delivered": 0, "future": 0, "not_declared": 0}
    for name, body in (required_proofs or {}).items():
        if not isinstance(body, dict):
            continue
        staged = body.get("staged_delivery")
        if not isinstance(staged, dict):
            state[name] = {
                "declared": False,
                "stage_2_key": None,
                "stage_2_status": None,
                "stage_2_proof_ref": None,
                "stage_2_packet": None,
            }
            summary["not_declared"] += 1
            continue
        # Find the first key that starts with "stage_2_" and is not a
        # metadata field like "stage_2_blocked_until" or "stage_2_*_proof_ref"
        # or "stage_2_*_packet" or "stage_2_*_scope_note". The "primary"
        # Stage 2 key is the one whose value names the state directly.
        primary_key: str | None = None
        primary_status: str | None = None
        for key, value in staged.items():
            if not key.startswith("stage_2_"):
                continue
            # Skip subordinate metadata fields
            if key in {"stage_2_blocked_until"} or key.endswith("_proof_ref") or key.endswith("_packet") or key.endswith("_scope_note"):
                continue
            primary_key = key
            primary_status = str(value) if value is not None else None
            break
        # Locate the matching proof_ref/packet (e.g., stage_2_drill →
        # stage_2_drill_proof_ref + stage_2_drill_packet)
        ref_field = f"{primary_key}_proof_ref" if primary_key else None
        packet_field = f"{primary_key}_packet" if primary_key else None
        state[name] = {
            "declared": primary_key is not None,
            "stage_2_key": primary_key,
            "stage_2_status": primary_status,
            "stage_2_proof_ref": staged.get(ref_field) if ref_field else None,
            "stage_2_packet": staged.get(packet_field) if packet_field else None,
        }
        if primary_key is None:
            summary["not_declared"] += 1
        else:
            summary["declared"] += 1
            if primary_status == "delivered":
                summary["delivered"] += 1
            elif primary_status == "future":
                summary["future"] += 1
    return state, summary


def derive_contract_status(node_type_block: dict[str, Any] | None) -> dict[str, Any]:
    """Compute the contracted/delivered status from the node_type block.

    Returns a dict with:
      - declared: bool — node_type entry exists
      - delivered: bool — promotion_standard.delivered is true OR
        proofs_present has the host listed
      - required_proofs: list[str] — names of required proofs (empty when
        no promotion_standard)
      - proofs_present: list[str] — proofs already met for the candidate's
        runtime body
      - proofs_pending: list[str] — proofs still required
      - status_label: one of candidate_only | contracted_not_delivered |
        delivered (the human-readable summary)
    """
    if not node_type_block:
        return {
            "declared": False,
            "delivered": False,
            "required_proofs": [],
            "proofs_present": [],
            "proofs_pending": [],
            "proof_ref_freshness": {},
            "stage_2_state_by_proof": {},
            "stage_2_summary": {"declared": 0, "delivered": 0, "future": 0, "not_declared": 0},
            "status_label": "candidate_only",
        }
    promotion = node_type_block.get("promotion_standard") or {}
    required_block = promotion.get("required_proofs") or {}
    required = list(required_block.keys())
    explicit_delivered = promotion.get("delivered")
    runtime_body = promotion.get("current_runtime_body") or {}
    candidate_host = runtime_body.get("ssh_targets_id")
    proofs_present_block = promotion.get("proofs_present") or {}
    proofs_present = []
    if isinstance(proofs_present_block, dict) and candidate_host:
        proofs_present = list(proofs_present_block.get(candidate_host) or [])
    candidate_gaps = promotion.get("candidate_gaps") or {}
    pending: list[str] = []
    if isinstance(candidate_gaps, dict) and candidate_host:
        pending = list(candidate_gaps.get(candidate_host) or [])
    if not pending and required:
        pending = [p for p in required if p not in proofs_present]
    # Honor an explicit `delivered:` field over derivation. PACKET-605
    # surfaced this: forge_node has all 5 Stage 1 proofs present but the
    # contract keeps `delivered: false` because Stage 2 enforcement is
    # outstanding. Operator's instruction: "do not immediately claim
    # forge is 'done' in the human sense" — so an explicit `false` must
    # NOT be overridden by proof-coverage derivation.
    if explicit_delivered is True:
        delivered = True
    elif explicit_delivered is False:
        delivered = False
    else:
        delivered = (
            bool(required) and not pending and len(proofs_present) >= len(required)
        )
    if delivered:
        status_label = "delivered"
    else:
        status_label = "contracted_not_delivered"
    stage_2_state, stage_2_summary = _extract_stage_2_state(required_block)
    return {
        "declared": True,
        "delivered": delivered,
        "required_proofs": required,
        "proofs_present": proofs_present,
        "proofs_pending": pending,
        "proof_ref_freshness": _check_proof_ref_freshness(required_block),
        "stage_2_state_by_proof": stage_2_state,
        "stage_2_summary": stage_2_summary,
        "status_label": status_label,
    }


def list_handoffs(candidate: dict[str, Any]) -> list[dict[str, Any]]:
    """Find handoff files mentioning the candidate's aliases."""
    out: list[dict[str, Any]] = []
    handoffs_dir = SPINE_STATE / "handoffs"
    if not handoffs_dir.is_dir():
        return out
    aliases_lower = [a.lower() for a in candidate.get("aliases", [])]
    aliases_lower.extend([candidate.get("runtime_body", {}).get("ssh_targets_id", "").lower()])
    for path in sorted(handoffs_dir.glob("HO-*.md")):
        try:
            text = path.read_text(encoding="utf-8").lower()
        except (OSError, UnicodeDecodeError):
            continue
        if any(a and a in text for a in aliases_lower):
            out.append({"path": str(path), "id": path.stem})
    return out


def compute_missing(
    candidate_name: str,
    candidate: dict[str, Any],
    intent_packets: list[dict[str, Any]],
    contract_hits: dict[str, list[str]],
    expected_homes: dict[str, bool],
    contract_status: dict[str, Any],
) -> list[str]:
    missing: list[str] = []
    # 1. Intent packets that the table claims exist but don't
    for ip in intent_packets:
        if not ip.get("found"):
            missing.append(f"declared intent PACKET-{ip['packet_id']} not found at expected paths")
    # 2. node.role.contract.yaml declaration as a node_type. The candidate
    # is "candidate-only" until this entry exists; once it exists it moves
    # to "contracted/not-delivered" and the proof ladder takes over.
    if not contract_status.get("declared"):
        missing.append(f"node.role.contract.yaml does not declare '{candidate_name}' as a node_type (current state: candidate-only on this readback surface)")
    # 3. expected_contract_homes that don't exist
    for home, exists in expected_homes.items():
        if not exists:
            missing.append(f"expected contract home missing: {home}")
    # 4. fleet.admission has the runtime ssh_targets_id?
    fleet_path = REPO_ROOT / "ops/bindings/fleet.admission.classification.yaml"
    runtime_id = (candidate.get("runtime_body") or {}).get("ssh_targets_id")
    if runtime_id and fleet_path.is_file():
        try:
            if runtime_id not in fleet_path.read_text(encoding="utf-8"):
                missing.append(f"fleet.admission.classification.yaml does not list runtime body '{runtime_id}'")
        except OSError:
            pass
    # 5. Once declared, surface unmet proofs as missing pieces. This makes
    # the proof ladder load-bearing: each missing proof is a separately
    # nameable next-slice candidate.
    for proof in contract_status.get("proofs_pending", []):
        missing.append(f"required proof not yet materialized: {proof}")
    return missing


def compute_next_action(
    candidate_name: str,
    candidate: dict[str, Any],
    missing: list[str],
    intent_packets: list[dict[str, Any]],
    contract_status: dict[str, Any],
) -> str:
    """Heuristic: name the next first-class slice to advance the candidate."""
    if not contract_status.get("declared"):
        return (
            f"Add '{candidate_name}' as a declared node_type or candidate in "
            f"ops/bindings/node.role.contract.yaml with required_proofs sketch "
            "(no implementation, just the contract slot). Boring first move; no "
            "runtime change, no installs, no DNS/secrets/branch protection."
        )
    if contract_status.get("delivered"):
        return (
            f"All required proofs present for {candidate_name}. The role is "
            "delivered; subsequent work is normal-mode operation, not promotion."
        )
    pending = contract_status.get("proofs_pending") or []
    required = contract_status.get("required_proofs") or []
    present = contract_status.get("proofs_present") or []
    if pending:
        # Pick the read-only proof first (status / readback) before
        # mutating proofs (restore drill, agent boundary). Heuristic: any
        # *_status_proof or *_readback_proof first; else first in list.
        readonly_first = [p for p in pending if "status_proof" in p or "readback_proof" in p]
        first = (readonly_first or pending)[0]
        return (
            f"{candidate_name} is contracted, not delivered. Proof ladder: "
            f"{len(present)}/{len(required)} met. "
            f"Next slice: materialize '{first}' as a read-only governed cap with a fresh receipt. "
            "Boring first proof; no runtime mutation."
        )
    # All required proofs present but contract still says delivered: false.
    # This is the "Stage 1 ladder closed" state — Stage 2 enforcement work
    # is the natural next move.
    if required and len(present) >= len(required):
        return (
            f"{candidate_name} Stage 1 ladder closed ({len(present)}/{len(required)} read-only proofs "
            f"present) but contract keeps `delivered: false`. Next slice: pick a Stage 2 enforcement "
            "step from the staged_delivery blocks (e.g., real backup/restore drill, structural agent-"
            "boundary enforcement, branch-protection tightening, runner clean-room demonstration). "
            "Stage 2 is mutating — operator decides which Stage 2 to run first."
        )
    found_packets = [ip for ip in intent_packets if ip.get("found")]
    if not found_packets:
        return f"Author the first intent packet for {candidate_name} per the operator-approved scope."
    return (
        f"{candidate_name} declared; all intent packets present; no required proofs declared. "
        f"Next slice: pick one packet from the intent list and execute its scope, "
        "or close one of the open handoffs against this candidate."
    )


def status_for_candidate(candidate_name: str) -> dict[str, Any]:
    candidate = CANDIDATES[candidate_name]
    intent_packets = list_intent_packets(candidate)
    contract_hits = grep_contracts(candidate)
    expected_homes = check_expected_contract_homes(candidate)
    domain_artifacts = list_domain_state_artifacts(candidate)
    handoffs = list_handoffs(candidate)
    node_type_block = read_node_type_entry(candidate_name)
    contract_status = derive_contract_status(node_type_block)
    missing = compute_missing(candidate_name, candidate, intent_packets, contract_hits, expected_homes, contract_status)
    next_action = compute_next_action(candidate_name, candidate, missing, intent_packets, contract_status)

    return {
        "capability": "node.role.candidate.status",
        "candidate": candidate_name,
        "purpose": candidate.get("purpose", ""),
        "aliases": candidate.get("aliases", []),
        "runtime_body": candidate.get("runtime_body", {}),
        "intent_packets": intent_packets,
        "domain_state_artifacts": domain_artifacts,
        "handoffs": handoffs,
        "contract_hits": contract_hits,
        "expected_contract_homes": expected_homes,
        "contract_status": contract_status,
        "missing": missing,
        "next_action": next_action,
        "scope_note": "PACKET-591 + PACKET-588 Phase 4 readback. Reconciles runtime / intent / contract truth and surfaces contracted/delivered state without mutation.",
    }


def main() -> int:
    parser = argparse.ArgumentParser(prog="node.role.candidate.status")
    parser.add_argument("--candidate", help="candidate name (e.g., forge_node). If omitted, lists all known candidates.")
    parser.add_argument("--json", action="store_true", help="emit JSON only")
    parser.add_argument("--self-check", action="store_true", help="self-check pass")
    args = parser.parse_args()

    if args.self_check:
        print("node.role.candidate.status self-check PASS")
        return 0

    if not args.candidate:
        # List known candidates
        out = {
            "capability": "node.role.candidate.status",
            "known_candidates": sorted(CANDIDATES.keys()),
            "note": "Pass --candidate <name> for a full reconciliation readback.",
        }
        if args.json:
            print(json.dumps(out, indent=2))
        else:
            print("known candidates:")
            for c in sorted(CANDIDATES.keys()):
                print(f"  {c} — {CANDIDATES[c].get('purpose', '')}")
            print("\nUsage: node.role.candidate.status --candidate <name>")
        return 0

    if args.candidate not in CANDIDATES:
        print(f"unknown candidate: {args.candidate}", file=sys.stderr)
        print(f"known: {', '.join(sorted(CANDIDATES.keys()))}", file=sys.stderr)
        return 2

    payload = status_for_candidate(args.candidate)

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"node.role.candidate.status — {payload['candidate']}")
        print(f"purpose: {payload['purpose']}")
        print(f"aliases: {', '.join(payload['aliases'])}")
        rb = payload['runtime_body']
        print(f"runtime body:")
        print(f"  ssh_targets_id: {rb.get('ssh_targets_id', '?')}")
        print(f"  host:           {rb.get('host_descriptor', '?')}")
        addrs = rb.get('expected_addresses', {})
        if addrs:
            print(f"  addresses:      lan={addrs.get('lan', '?')}  tailscale={addrs.get('tailscale', '?')}")
        services = rb.get('services', [])
        if services:
            print(f"  services:       {', '.join(services)}")
        print(f"intent packets ({len([ip for ip in payload['intent_packets'] if ip['found']])}/{len(payload['intent_packets'])} found):")
        for ip in payload['intent_packets']:
            marker = "✓" if ip['found'] else "✗"
            print(f"  {marker} PACKET-{ip['packet_id']}")
        if payload['domain_state_artifacts']:
            print(f"domain-state artifacts ({len(payload['domain_state_artifacts'])}):")
            for a in payload['domain_state_artifacts'][:6]:
                print(f"  {Path(a).name}")
            if len(payload['domain_state_artifacts']) > 6:
                print(f"  ... +{len(payload['domain_state_artifacts']) - 6} more")
        if payload['handoffs']:
            print(f"handoffs ({len(payload['handoffs'])}):")
            for h in payload['handoffs'][:5]:
                print(f"  {h['id']}")
        if payload['contract_hits']:
            total_files = len({f for files in payload['contract_hits'].values() for f in files})
            print(f"contract hits: {total_files} binding file(s) reference {len(payload['contract_hits'])} alias term(s)")
        cs = payload.get('contract_status') or {}
        status_label = cs.get('status_label', 'candidate_only')
        freshness = cs.get('proof_ref_freshness') or {}
        stage_2_state = cs.get('stage_2_state_by_proof') or {}
        stage_2_summary = cs.get('stage_2_summary') or {}
        if status_label == "candidate_only":
            print(f"\ncontract status: candidate-only (not declared in node.role.contract.yaml)")
        elif status_label == "contracted_not_delivered":
            present_n = len(cs.get('proofs_present') or [])
            required_n = len(cs.get('required_proofs') or [])
            print(f"\ncontract status: contracted, not delivered ({present_n}/{required_n} Stage 1 proofs met)")
            # PACKET-609: Stage 2 progress header — teaches that Stage 1
            # ladder closure ≠ role delivered.
            s2_decl = stage_2_summary.get("declared", 0)
            s2_done = stage_2_summary.get("delivered", 0)
            s2_future = stage_2_summary.get("future", 0)
            s2_undecl = stage_2_summary.get("not_declared", 0)
            if s2_decl or s2_undecl:
                undeclared_note = f" ({s2_undecl} proof(s) without Stage 2 declaration)" if s2_undecl else ""
                print(f"Stage 2 progress: {s2_done}/{s2_decl} declared delivered, {s2_future} future{undeclared_note}")
            for proof in cs.get('required_proofs') or []:
                marker = "✓" if proof in (cs.get('proofs_present') or []) else "·"
                fresh = freshness.get(proof)
                ref_note = ""
                if fresh:
                    ref_note = " [proof_ref present]" if fresh.get('present') else " [proof_ref MISSING]"
                # PACKET-609: per-proof Stage 2 trailer
                s2 = stage_2_state.get(proof) or {}
                if s2.get("declared"):
                    key = (s2.get("stage_2_key") or "stage_2").replace("stage_2_", "")
                    status = (s2.get("stage_2_status") or "").upper()
                    pkt_suffix = f" → {s2.get('stage_2_packet')}" if s2.get("stage_2_packet") else ""
                    s2_trailer = f"  · Stage 2 ({key}): {status}{pkt_suffix}"
                else:
                    s2_trailer = "  · Stage 2: not declared"
                print(f"  {marker} {proof}{ref_note}{s2_trailer}")
        elif status_label == "delivered":
            print(f"\ncontract status: delivered ({len(cs.get('proofs_present') or [])}/{len(cs.get('required_proofs') or [])} proofs met)")
        if payload['missing']:
            print(f"\nmissing ({len(payload['missing'])}):")
            for m in payload['missing']:
                print(f"  - {m}")
        else:
            print(f"\nno missing pieces detected")
        print(f"\nnext action:\n  {payload['next_action']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
