<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ronny.operator-ingress-auto-metabolizer</string>

    <key>ProgramArguments</key>
    <array>
      <string>$SPINE_ROOT/ops/plugins/core/lifecycle/bin/operator-ingress-auto-metabolizer</string>
      <string>--foreground</string>
      <string>--worker-id</string>
      <string>operator-ingress-auto-metabolizer</string>
      <string>--poll-seconds</string>
      <string>60</string>
      <string>--batch-limit</string>
      <string>10</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$SPINE_ROOT</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
      <key>SPINE_ROOT</key>
      <string>$SPINE_ROOT</string>
      <key>SPINE_OPERATOR_TZ</key>
      <string>America/New_York</string>
      <key>TZ</key>
      <string>America/New_York</string>
      <key>PATH</key>
      <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>$SPINE_RUNTIME/spine/logs/operator-ingress-auto-metabolizer.out</string>
    <key>StandardErrorPath</key>
    <string>$SPINE_RUNTIME/spine/logs/operator-ingress-auto-metabolizer.err</string>
</dict>
</plist>
