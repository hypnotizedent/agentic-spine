<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ronny.finance-backup-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$WORKBENCH_ROOT/agents/finance/spine-plugin-finance/bin/finance-backup-run</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>$SPINE_RUNTIME/spine/logs/finance-backup-weekly.out</string>
    <key>StandardErrorPath</key>
    <string>$SPINE_RUNTIME/spine/logs/finance-backup-weekly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SPINE_ROOT</key>
        <string>$SPINE_ROOT</string>
        <key>SPINE_OPERATOR_TZ</key>
        <string>America/New_York</string>
        <key>TZ</key>
        <string>America/New_York</string>
        <key>PATH</key>
        <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>$WORKBENCH_ROOT</string>
</dict>
</plist>
