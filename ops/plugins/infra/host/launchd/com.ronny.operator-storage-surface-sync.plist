<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ronny.operator-storage-surface-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/spine-ops</string>
    <string>cap</string>
    <string>run</string>
    <string>operator.storage.surface.sync</string>
    <string>--</string>
    <string>run-once</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>OPS_GOVERNED_MAIN_OVERRIDE</key>
    <string>1</string>
    <key>SPINE_SESSION_ID</key>
    <string>launchd-operator-storage-surface-sync</string>
    <key>SPINE_TERMINAL_ID</key>
    <string>HOST-OPERATOR-STORAGE-SYNC</string>
    <key>PATH</key>
    <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>WorkingDirectory</key>
  <string>$SPINE_ROOT</string>

  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/operator-storage-surface-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/operator-storage-surface-sync.err.log</string>
</dict>
</plist>
