#!/usr/bin/env bash
# TRIAGE: artie.mockup.asset.promote
# Promote supplier product image into mockup registry with full provenance tracking.
#
# Usage:
#   mockup-asset-promote --supplier-code sanmar --supplier-sku PC54 --view front [--approval-state approved|review] [--force]
#
# Capability: artie.mockup.asset.promote
# Safety: mutating
# Arg Protocol: named

set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"

# Parse args (after -- separator if present)
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
args+=("$@")

# Execute Python implementation
exec python3 "$ROOT/ops/plugins/artie/lib/mockup_asset_promote.py" "${args[@]}"
