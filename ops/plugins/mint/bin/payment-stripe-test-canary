#!/usr/bin/env bash
#
# Stripe test-mode payment canary (wrapper with Infisical secrets)
#
# Executes an end-to-end Stripe test payment flow:
# 1. Creates a test checkout session
# 2. Forwards webhooks via Stripe CLI
# 3. Verifies payment persistence
# 4. Proves finance null-sink (no Firefly pollution)
#
# Prerequisites:
# - Stripe CLI installed and authenticated
# - payment-test service running on mint-apps:4001
# - finance-adapter configured for test_mode null-sink

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Execute inner script with Infisical secrets loaded
exec infisical run \
  --projectId infrastructure \
  --env prod \
  --path /spine/services/payment-test \
  -- "$SCRIPT_DIR/payment-stripe-test-canary-inner" "$@"
