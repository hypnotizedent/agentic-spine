#!/usr/bin/env bash
# auth-deploy-infisical - superseded proof-of-concept deploy helper
#
# Superseded by:
#   ./bin/ops cap run mint.auth.deploy
#
# The canonical durable path uses mint-auth-secrets-sync + mint-auth-deploy.
# This helper intentionally refuses execution so agents do not rediscover the
# old one-shot SSH export workflow.

set -euo pipefail

echo "STOP (2): auth-deploy-infisical is superseded." >&2
echo "Use: ./bin/ops cap run mint.auth.deploy" >&2
exit 2
