#!/usr/bin/env bash
# mint-auth-deploy - Durable auth/files-api deployment with Infisical-backed secrets
#
# This script provides the canonical governed path for deploying auth and files-api
# services on mint-apps with secrets sourced from Infisical.
#
# Process:
# 1. Sync auth secrets from Infisical to /opt/stacks/mint-apps/.env.auth-secrets
# 2. Deploy services using layered env files (.env + .env.auth-secrets)
# 3. Verify health
#
# Usage:
#   mint-auth-deploy [--services auth,files-api] [--skip-sync] [--skip-health-check]

set -euo pipefail

SPINE_ROOT="${SPINE_ROOT:-$HOME/code/agentic-spine}"
SERVICES="auth,files-api"
SKIP_SYNC=0
SKIP_HEALTH=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --services)
      SERVICES="${2:-auth,files-api}"
      shift 2
      ;;
    --skip-sync)
      SKIP_SYNC=1
      shift
      ;;
    --skip-health-check)
      SKIP_HEALTH=1
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Usage: mint-auth-deploy [--services auth,files-api] [--skip-sync] [--skip-health-check]" >&2
      exit 1
      ;;
  esac
done

# Convert CSV to array
IFS=',' read -ra SERVICE_ARRAY <<< "$SERVICES"

echo "mint.auth.deploy"
echo "services: ${SERVICES}"
echo "target: mint-apps (100.79.183.14)"
echo ""

# Step 1: Sync auth secrets from Infisical (unless skipped)
if [[ "$SKIP_SYNC" -eq 0 ]]; then
  echo "[1/3] Syncing auth secrets from Infisical..."
  "$SPINE_ROOT/ops/plugins/mint/bin/mint-auth-secrets-sync"
  echo ""
else
  echo "[1/3] Skipping auth secrets sync (--skip-sync)"
  echo ""
fi

# Step 2: Deploy services with layered env files
echo "[2/3] Deploying services..."
for service in "${SERVICE_ARRAY[@]}"; do
  echo "  Deploying: $service"
  ssh mint-apps "cd /opt/stacks/mint-apps && \
    docker compose --env-file .env --env-file .env.auth-secrets up -d --no-deps $service"
done
echo ""

# Step 3: Health checks (unless skipped)
if [[ "$SKIP_HEALTH" -eq 0 ]]; then
  echo "[3/3] Checking service health..."

  for service in "${SERVICE_ARRAY[@]}"; do
    case "$service" in
      auth)
        echo "  auth: Waiting for startup..."
        sleep 3
        HEALTH=$(ssh mint-apps "curl -sf http://localhost:4300/health" || echo '{"status":"error"}')
        STATUS=$(echo "$HEALTH" | jq -r '.status // "error"')
        if [[ "$STATUS" == "ok" ]]; then
          echo "  auth: ✅ HEALTHY"
        else
          echo "  auth: ❌ UNHEALTHY - $HEALTH"
          exit 1
        fi
        ;;
      files-api)
        echo "  files-api: Waiting for startup..."
        sleep 3
        HEALTH=$(ssh mint-apps "curl -sf http://localhost:3500/health" || echo '{"status":"error"}')
        STATUS=$(echo "$HEALTH" | jq -r '.status // "error"')
        if [[ "$STATUS" == "ok" ]]; then
          echo "  files-api: ✅ HEALTHY"
        else
          echo "  files-api: ❌ UNHEALTHY - $HEALTH"
          exit 1
        fi
        ;;
    esac
  done
else
  echo "[3/3] Skipping health checks (--skip-health-check)"
fi

echo ""
echo "✅ Deployment complete"
echo "   Services: ${SERVICES}"
echo "   Secret source: Infisical (infrastructure/prod /spine/services/auth)"
echo "   Env files: .env + .env.auth-secrets (layered)"
