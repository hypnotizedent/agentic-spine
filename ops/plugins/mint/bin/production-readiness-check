#!/usr/bin/env bash
# production-readiness-check - Governed Mint production readiness gate

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
RUNTIME="$SCRIPT_DIR/../lib/production_readiness_check.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$RUNTIME" ]]; then
  echo "STOP (2): runtime not found: $RUNTIME" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$RUNTIME" "$@"
