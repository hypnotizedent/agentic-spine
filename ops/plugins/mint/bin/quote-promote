#!/usr/bin/env bash
# quote-promote - Governed quote_packet promotion runtime

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
PROMOTER="$SCRIPT_DIR/../lib/quote_packet_promote.py"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "STOP (2): missing dependency: $PYTHON_BIN" >&2
  exit 2
fi

if [[ ! -f "$PROMOTER" ]]; then
  echo "STOP (2): promoter not found: $PROMOTER" >&2
  exit 2
fi

exec "$PYTHON_BIN" "$PROMOTER" "$@"
