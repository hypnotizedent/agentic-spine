#!/usr/bin/env bash
#
# Stripe test-mode payment canary (inner script with secrets loaded)
#
# This script expects all PAYMENT_TEST_* env vars to be loaded

set -e

# Verify required secrets are loaded
if [[ -z "$PAYMENT_TEST_API_KEY" ]] || [[ -z "$PAYMENT_TEST_STRIPE_SECRET_KEY" ]]; then
  echo "ERROR: Required secrets not loaded" >&2
  echo "  PAYMENT_TEST_API_KEY: ${PAYMENT_TEST_API_KEY:+SET}" >&2
  echo "  PAYMENT_TEST_STRIPE_SECRET_KEY: ${PAYMENT_TEST_STRIPE_SECRET_KEY:+SET}" >&2
  exit 1
fi

# Configuration
PAYMENT_TEST_URL="http://100.79.183.14:4001"
STRIPE_TEST_KEY="$PAYMENT_TEST_STRIPE_SECRET_KEY"
PAYMENT_API_KEY="$PAYMENT_TEST_API_KEY"

# Verify Stripe CLI is available
if ! command -v stripe &> /dev/null; then
  echo "ERROR: Stripe CLI not installed. Run: brew install stripe/stripe-cli/stripe" >&2
  exit 1
fi

# Verify Stripe CLI is authenticated
if ! stripe config --list &> /dev/null; then
  echo "ERROR: Stripe CLI not authenticated. Run: stripe login" >&2
  exit 1
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Stripe Test Payment Canary"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Phase 1: Verify payment-test health
echo "Phase 1: Verifying payment-test service..."
HEALTH=$(curl -sf "$PAYMENT_TEST_URL/health" || echo "UNREACHABLE")
if [[ "$HEALTH" != *"ok"* ]]; then
  echo "ERROR: payment-test service unhealthy or unreachable" >&2
  echo "Response: $HEALTH" >&2
  exit 1
fi
echo "✓ payment-test healthy at $PAYMENT_TEST_URL"
echo ""

# Phase 2: Create test checkout session
echo "Phase 2: Creating test checkout session..."
SESSION_RESPONSE=$(curl -sf -X POST "$PAYMENT_TEST_URL/api/v1/payments/checkout-session" \
  -H "Content-Type: application/json" \
  -H "X-API-Key: $PAYMENT_API_KEY" \
  -d '{
    "order_id": "test-order-'$(date +%s)'",
    "amount_cents": 1000,
    "currency": "usd",
    "description": "Stripe test canary payment"
  }' || echo "FAILED")

if [[ "$SESSION_RESPONSE" == "FAILED" ]] || [[ ! "$SESSION_RESPONSE" =~ "id" ]]; then
  echo "ERROR: Failed to create checkout session" >&2
  echo "Response: $SESSION_RESPONSE" >&2
  exit 1
fi

SESSION_ID=$(echo "$SESSION_RESPONSE" | jq -r '.id')
CHECKOUT_URL=$(echo "$SESSION_RESPONSE" | jq -r '.url')

if [[ -z "$SESSION_ID" ]] || [[ "$SESSION_ID" == "null" ]]; then
  echo "ERROR: No session ID in response" >&2
  echo "Response: $SESSION_RESPONSE" >&2
  exit 1
fi

echo "✓ Checkout session created: $SESSION_ID"
echo "  Checkout URL: $CHECKOUT_URL"
echo ""

# Phase 3: Start Stripe webhook forwarding
echo "Phase 3: Starting Stripe webhook forwarding..."
echo "  This will forward test webhooks to payment-test"
echo "  Press Ctrl+C when ready to stop"
echo ""

# Start webhook forwarding in background
WEBHOOK_LOG=$(mktemp)
stripe listen --forward-to "$PAYMENT_TEST_URL/api/v1/payments/webhooks/stripe" \
  --api-key "$STRIPE_TEST_KEY" \
  > "$WEBHOOK_LOG" 2>&1 &
WEBHOOK_PID=$!

# Wait for webhook listener to be ready
sleep 3

if ! ps -p $WEBHOOK_PID > /dev/null; then
  echo "ERROR: Stripe webhook listener failed to start" >&2
  cat "$WEBHOOK_LOG" >&2
  rm -f "$WEBHOOK_LOG"
  exit 1
fi

echo "✓ Webhook forwarding active (PID: $WEBHOOK_PID)"
echo ""

# Cleanup function
cleanup() {
  if [[ -n "$WEBHOOK_PID" ]] && ps -p $WEBHOOK_PID > /dev/null; then
    echo ""
    echo "Stopping webhook forwarding..."
    kill $WEBHOOK_PID 2>/dev/null || true
    wait $WEBHOOK_PID 2>/dev/null || true
  fi
  [[ -f "$WEBHOOK_LOG" ]] && rm -f "$WEBHOOK_LOG"
}
trap cleanup EXIT

# Phase 4: Trigger test payment
echo "Phase 4: Test Payment Execution"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "MANUAL STEP REQUIRED:"
echo "1. Open the checkout URL in your browser:"
echo "   $CHECKOUT_URL"
echo ""
echo "2. Complete the test payment using Stripe test card:"
echo "   Card: 4242 4242 4242 4242"
echo "   Expiry: Any future date (e.g., 12/34)"
echo "   CVC: Any 3 digits (e.g., 123)"
echo "   ZIP: Any 5 digits (e.g., 12345)"
echo ""
echo "3. After payment succeeds, return here and press Enter to verify results"
echo ""

# Open URL in browser
if command -v open &> /dev/null; then
  open "$CHECKOUT_URL"
fi

read -p "Press Enter after completing the test payment..."

# Phase 5: Verify results
echo ""
echo "Phase 5: Verifying canary results..."
echo ""

# Give webhooks time to process
sleep 5

# Check webhook log for events
echo "Webhook events received:"
grep -E "(checkout.session.completed|payment_intent.succeeded)" "$WEBHOOK_LOG" || echo "  (none found)"
echo ""

# Verify payment-test persistence (would need an API endpoint)
echo "✓ Test payment flow complete"
echo ""

# Phase 6: Finance null-sink verification
echo "Phase 6: Finance null-sink verification"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Manual verification required:"
echo "1. SSH to finance-adapter and check event_map table:"
echo "   ssh ubuntu@100.79.183.14"
echo "   docker exec -it finance-adapter psql -U postgres -d finance"
echo "   SELECT event_type, mint_ref_id, status FROM finance_event_map WHERE mint_ref_id LIKE '%$SESSION_ID%';"
echo ""
echo "2. Expected: status = 'test_skipped' (not 'synced')"
echo "3. Verify NO new Firefly transaction was created"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Stripe Test Canary Complete"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Summary:"
echo "  Session ID: $SESSION_ID"
echo "  Payment Test: Complete (manual verification)"
echo "  Finance Null-Sink: Requires manual DB check"
echo ""
echo "IMPORTANT: Verify that:"
echo "  - payment-test recorded the payment"
echo "  - finance-adapter has test_skipped status"
echo "  - NO live Firefly transaction was created"
