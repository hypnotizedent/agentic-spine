#!/usr/bin/env bash
# finance-backup-status - Read finance backup state (local staging + NAS + last-good)
set -euo pipefail

ROOT="${SPINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
# shellcheck source=ops/lib/ssh-resolve.sh
source "$ROOT/ops/lib/ssh-resolve.sh"

TARGET="finance-stack"
NAS_USER="ronadmin"
NAS_HOST="100.102.199.111"
NAS_BASE="/volume1/backups/apps"

# Resolve targets
FINANCE_HOST=$(ssh_resolve_host "$TARGET")
if [[ "$FINANCE_HOST" == "UNRESOLVED" ]]; then
  echo "ERROR: Cannot resolve finance-stack" >&2
  exit 1
fi

echo "=== finance.backup.status ==="
echo "target: $TARGET"
echo "finance_host: $FINANCE_HOST"
echo "nas_host: $NAS_HOST"
echo ""

# Check local staging artifacts
echo "## Local staging (/mnt/backups/finance/staging on $TARGET)"
if ssh "$FINANCE_HOST" "test -d /mnt/backups/finance/staging && ls -lh /mnt/backups/finance/staging/ 2>/dev/null" 2>/dev/null; then
  ssh "$FINANCE_HOST" "ls -lh /mnt/backups/finance/staging/ | tail -10" 2>/dev/null || echo "  (empty or inaccessible)"
else
  echo "  (no staging artifacts)"
fi
echo ""

# Check local last-good archive
echo "## Local last-good (/mnt/backups/finance/last-good on $TARGET)"
if ssh "$FINANCE_HOST" "test -d /mnt/backups/finance/last-good && ls -lh /mnt/backups/finance/last-good/ 2>/dev/null" 2>/dev/null; then
  ssh "$FINANCE_HOST" "ls -lh /mnt/backups/finance/last-good/ | tail -10" 2>/dev/null || echo "  (empty or inaccessible)"
else
  echo "  (no last-good archive)"
fi
echo ""

# Check NAS state
echo "## NAS offsite backups ($NAS_HOST:$NAS_BASE)"
for subdir in finance ghostfolio paperless; do
  echo "### $subdir/"
  if ssh "$FINANCE_HOST" "ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 $NAS_USER@$NAS_HOST 'ls -lht $NAS_BASE/$subdir/ | head -5' 2>/dev/null" 2>/dev/null; then
    :  # output already printed
  else
    echo "  (unreachable or empty)"
  fi
  echo ""
done

echo "status: OK"
echo "note: Use backup.status for freshness compliance against backup.inventory.yaml"
